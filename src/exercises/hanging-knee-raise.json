  "exercise": {
    "id": "hanging-knee-raise",
    "name": "Hanging Knee Raise",
    "aliases": [
      "Hanging knee tuck",
      "Hanging bent-knee raise",
      "Hanging knee-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "21522",
      "title": "Hanging Knee Raise",
      "url": "https://gymvisual.com/videos/21522-hanging-knee-raise-male.html",
      "listing": "Video (movement reference; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Forearms (grip)",
      "Back (lats)"
    ],
    "equipment": [
      "Pull-up bar"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip and knee flexion with posterior pelvic tilt, hanging)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "lats_r",
        "lats_l",
        "serratus_r",
        "serratus_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the knees rise, in on the way down.",
      "cadence": "About 1.4 s up, 1.9 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-15",
      "tempo": "About 1.5 s up, brief hold, 2 s down",
      "load": "Body weight",
      "frequency": "2-3 times a week",
      "progression": "Higher knees (toward the chest), slower lowering, then hanging straight-leg raise"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hang from the bar, hands about shoulder width or a little wider, legs together."
      },
      {
        "id": "c2",
        "phase": "set",
        "text": "Pull the shoulders down from the ears and brace."
      },
      {
        "id": "c3",
        "phase": "raise",
        "text": "Bend the knees and draw them up past the hips; finish by curling the pelvis up."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Hold a moment with the knees high and no swing."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Lower slowly to the hang without letting the body rock."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging to get the knees up",
        "fix": "Start each rep still; lower slowly."
      },
      {
        "id": "m2",
        "mistake": "Stopping with the thighs level (hip flexors only)",
        "fix": "Finish with a small pelvic curl."
      },
      {
        "id": "m3",
        "mistake": "Shrugging into the ears",
        "fix": "Keep the shoulder blades set down."
      },
      {
        "id": "m4",
        "mistake": "Dropping on the way down",
        "fix": "Lower in about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈3° in the dead hang",
        "peak": "≈112° (knees 29 cm above the hip joints)",
        "norm": "From about neutral to about 100-120 degrees, knees above the hips (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knees",
        "setup": "≈8°",
        "peak": "≈104°",
        "norm": "Bent about 90-110 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "Neutral in the hang",
        "peak": "Small curl: about 27° of spinal flexion (low back 15°)",
        "norm": "A small posterior pelvic tilt at the top raises the abdominal demand (Axler and McGill 1997)",
        "sources": [
          "axler1997"
        ]
      },
      {
        "measure": "Body swing",
        "setup": "Body hangs under the hands",
        "peak": "Centre of mass within 0.4 cm of the hands",
        "norm": "Minimal: the trunk leans back only as much as the knees come forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s, set 0.3 s",
        "peak": "1.1 s up, 0.4 s hold, 2.4 s down",
        "norm": "About 1.5 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 21522, Hanging Knee Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/21522-hanging-knee-raise-male.html"
      },
      {
        "id": "axler1997",
        "title": "Axler and McGill 1997, low-back loads over a variety of abdominal exercises: searching for the safest abdominal challenge (Med Sci Sports Exerc 29(6):804-811)",
        "url": "https://acnpsearch.tweb-dev.unibo.it/singlejournalindex/7588015"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises (Phys Ther 86(5):656-671)",
        "url": "https://scholars.csus.edu/esploro/outputs/journalArticle/Electromyographic-Analysis-of-Traditional-and-Nontraditional/99257847129401671"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the bar is secure and can take your weight before hanging from it.",
        "Shoulder pain in the hang: shorten the set or use arm straps.",
        "Low back pain: keep the range small and avoid swinging."
      ],
      "modify": [
        "Grip gives out first: use arm straps.",
        "Smaller range (thighs to level)."
      ],
      "regressions": [
        "Lying knee raise.",
        "Reverse crunch."
      ],
      "progressions": [
        "Hanging straight-leg raise.",
        "Hanging oblique knee raise.",
        "Toes to bar."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas and rectus femoris lift the legs from the hang.",
      "hip_flexors_l": "Iliopsoas and rectus femoris lift the legs from the hang.",
      "core": "Rectus abdominis curls the pelvis toward the ribs at the top and stops the body swinging; hanging raises rank among the hardest abdominal exercises (Axler and McGill 1997).",
      "obliques_r": "Brace the trunk with the rectus abdominis.",
      "obliques_l": "Brace the trunk with the rectus abdominis.",
      "forearm_flexors_r": "Grip the bar for the whole set.",
      "forearm_flexors_l": "Grip the bar for the whole set.",
      "lats_r": "Keep the shoulders set and the arms pulling slightly down on the bar.",
      "lats_l": "Keep the shoulders set and the arms pulling slightly down on the bar.",
      "serratus_r": "Steady the shoulder blade in the overhead hang.",
      "serratus_l": "Steady the shoulder blade in the overhead hang.",
      "rhomboids_midtrap_r": "Hold the shoulder blades set.",
      "rhomboids_midtrap_l": "Hold the shoulder blades set.",
      "quads_r": "Rectus femoris helps flex the hip.",
      "quads_l": "Rectus femoris helps flex the hip."
    }
