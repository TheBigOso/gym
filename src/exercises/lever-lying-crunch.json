    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Obliques"
    ],
    "equipment": [
      "Lying crunch machine (flat bench, chest pad and handles on a lever)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl up, breathe in as you lower.",
      "cadence": "About 1.3 s up, short hold, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "45-75 s",
      "frequency": "1-2 times a week",
      "tempo": "1.3-0.5-2-0.5 (curl-hold-lower-pause, seconds)",
      "load": "Load is user-chosen: curl the ribs toward the pelvis without pulling with the arms.",
      "progression": "Add reps, then load; longer hold at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the bench with the knees bent and the feet flat; the lever pad on the upper chest, hands on the handles beside it."
      },
      {
        "id": "c2",
        "phase": "work",
        "text": "Breathe out and curl the head, shoulders and upper back off the bench, ribs toward the pelvis."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold the crunch with the low back still on the bench."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and uncurl slowly back to the bench."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with light tension; keep the chin tucked."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling with the arms",
        "fix": "Let the abdominals curl the trunk; the hands only hold the handles."
      },
      {
        "id": "m2",
        "mistake": "Low back lifting off",
        "fix": "Curl the upper back only; the pelvis stays down."
      },
      {
        "id": "m3",
        "mistake": "Neck cranked forward",
        "fix": "Keep a fist of space under the chin."
      },
      {
        "id": "m4",
        "mistake": "Dropping back down",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk flexion",
        "setup": "Flat on the bench",
        "peak": "Upper trunk curled ≈31°; shoulder blades off the bench",
        "norm": "From flat on the bench to the shoulder blades off the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "On the bench, feet flat",
        "peak": "Unchanged",
        "norm": "Pelvis and low back stay on the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lever",
        "setup": "Pivot 33.6 cm from the chest pad, level with the lower back",
        "peak": "Lever turns 47.8°; pad within 0.08 cm of the sternum",
        "norm": "The chest pad rides an arc about a pivot level with the lower back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Abdominal EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Crunch variations activate the rectus abdominis well; machine and loaded crunches allow progressive load (Escamilla 2006; Sarti 1996)",
        "sources": [
          "escamilla2006",
          "sarti1996"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s flat",
        "peak": "1.3 s up, 0.5 s hold, 2 s down",
        "norm": "About 1.3 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
