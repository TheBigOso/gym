      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lats) and arms (biceps)",
    "secondaryBodyParts": [
      "Arms (biceps, brachialis, forearms)",
      "Mid-back",
      "Chest (lower pecs)",
      "Core"
    ],
    "equipment": [
      "Pull-up bar"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder extension, scapular depression, elbow flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l",
        "biceps_r",
