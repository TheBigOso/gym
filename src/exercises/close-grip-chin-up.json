        "serratus_l",
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull up, breathe in on the way down.",
      "cadence": "About 1 s up, 2 s down"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "3-10 (or as many as you can with full range)",
      "tempo": "About 1 s up, brief hold, 2 s down",
      "load": "Body weight; add weight or use assistance to stay in the rep range",
      "frequency": "2-3 times a week",
      "progression": "More reps, then added weight (belt or vest)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hang from the bar, palms facing you, hands close together (a fist or two apart), arms straight."
      },
      {
        "id": "c2",
        "phase": "set",
        "text": "Pull the shoulder blades down before the elbows bend."
      },
      {
        "id": "c3",
        "phase": "pull",
        "text": "Drive the elbows down and in front of the ribs; bring the chest up to the hands."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Chin over the bar, neck long, legs quiet."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Lower under control all the way to straight arms."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Full hang, then the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Half reps",
        "fix": "Start each rep from straight arms and finish with the chin over the bar."
      },
      {
        "id": "m2",
        "mistake": "Kicking or swinging the legs",
        "fix": "Brace the trunk, keep the legs still with a slight knee bend."
      },
      {
        "id": "m3",
        "mistake": "Craning the chin over the bar",
        "fix": "Pull the chest up; keep the neck long."
      },
      {
        "id": "m4",
        "mistake": "Wrists bent back hard with the close grip",
        "fix": "Keep the wrists straight; widen the grip a little if they ache."
      },
      {
        "id": "m5",
        "mistake": "Dropping into the hang",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈11° in the dead hang",
        "peak": "≈130° at the top",
        "norm": "Nearly straight in the hang to well over 90 degrees at the top; chin-ups use a larger elbow range than pull-ups (Youdas 2010)",
        "sources": [
          "youdas2010"
        ]
      },
      {
        "measure": "Grip width",
        "setup": "Underhand, grip points 16 cm apart (shoulder joints 39 cm): about 41% of shoulder width",
        "peak": "Unchanged (hands planted on the bar)",
        "norm": "Underhand, hands closer than shoulder width (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Chin height",
        "setup": "Chin 52 cm below the bar in the dead hang",
        "peak": "Chin 2.2 cm above the bar at the top; body rises 50 cm",
        "norm": "Chin clears the bar at the top (common standard for a full rep)",
        "sources": []
      },
      {
        "measure": "Shoulder blades",
        "setup": "Elevated (26) in the hang",
        "peak": "Depressed and retracted (elevate -10, protract -16) at the top",
        "norm": "Elevated in the hang, depressed as the body rises (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s, set the shoulders 0.3 s",
        "peak": "About 1.1 s up, 0.4 s hold, 2 s down",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
