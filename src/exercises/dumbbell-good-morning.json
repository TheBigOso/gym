      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: use a light load and a short range; seek advice if pain persists."
      ],
      "modify": [
        "Tight hamstrings: stop higher and bend the knees a little more."
      ],
      "regressions": [
        "Bodyweight good morning (hands across the chest).",
        "Shorter range."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Pause at the bottom.",
        "Barbell good morning."
      ]
    },
    "muscleNotes": {
      "hamstrings_r": "Lengthen and then extend the hips; medial and lateral hamstring activity rose with load in the barbell good morning (Vigotsky 2015).",
      "hamstrings_l": "Lengthen and then extend the hips; medial and lateral hamstring activity rose with load in the barbell good morning (Vigotsky 2015).",
      "glute_max_r": "Extends the hips on the way up.",
      "glute_max_l": "Extends the hips on the way up.",
      "spinal_extensors_r": "Hold the back flat against the long lever of the trunk; thoracic and lumbar erector spinae reached about 46-71% MVIC in the barbell good morning (Vigotsky 2015).",
      "spinal_extensors_l": "Hold the back flat against the long lever of the trunk; thoracic and lumbar erector spinae reached about 46-71% MVIC in the barbell good morning (Vigotsky 2015).",
      "adductors_r": "Adductor magnus assists hip extension.",
      "adductors_l": "Adductor magnus assists hip extension.",
      "core": "Brace the trunk.",
      "biceps_r": "Hold the dumbbell against the chest.",
      "biceps_l": "Hold the dumbbell against the chest.",
      "forearm_flexors_r": "Cup the dumbbell.",
      "forearm_flexors_l": "Cup the dumbbell."
    }
