    "bodyPart": "Thighs (hamstrings) and lower back",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Core"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip hinge)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hamstrings_r",
        "hamstrings_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "core",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the top, lower with the brace, breathe out as you stand.",
      "cadence": "About 2.2 s down, short pause, 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "tempo": "2-1-1-1",
      "load": "User-chosen dumbbell, light to moderate; stop about 2-3 reps short of failure (RIR 2-3)",
      "frequency": "1-2 times a week",
      "progression": "Add load, then a pause at the bottom"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, one dumbbell held upright against the chest, elbows down, knees soft."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Push the hips back and tip the chest forward with a flat back, the dumbbell staying on the chest."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop when the trunk is about level or the hamstrings are stretched."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the hips forward and lift the chest to stand tall."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall without leaning back; breathe and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back",
        "fix": "Stop where the back is still flat; think chest proud."
      },
      {
        "id": "m2",
        "mistake": "Bending the knees into a squat",
        "fix": "Keep the small knee bend steady and push the hips back."
      },
      {
        "id": "m3",
        "mistake": "Letting the dumbbell drift off the chest",
        "fix": "Hug it to the sternum the whole rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈1°",
        "peak": "≈103° (joint channel), trunk ≈23° above horizontal",
        "norm": "About 75 degrees of hip flexion in the barbell good morning, unchanged by load (Vigotsky 2015)",
        "sources": [
          "vigotsky2015"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈20°",
        "norm": "About 17-25 degrees, rising with heavier loads (Vigotsky 2015)",
        "sources": [
          "vigotsky2015"
        ]
      },
      {
        "measure": "Lumbar motion",
        "setup": "Neutral",
        "peak": "Spine channels -4°/-1°/1° (L5/T12/T6): neutral",
        "norm": "Aim for a neutral spine; trained lifters showed about 25-28 degrees of lumbar flexion at the bottom of a barbell good morning (Vigotsky 2015)",
        "sources": [
          "vigotsky2015"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.2 s down, 0.3 s pause, 1.3 s up, 1.4 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
