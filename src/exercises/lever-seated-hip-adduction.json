    "bodyPart": "Thighs (adductors)",
    "secondaryBodyParts": [],
    "equipment": [
      "Seated hip adduction machine (two lever arms on vertical axles, pads inside the knees)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip adduction)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
