        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the knees come together, breathe in as they open.",
      "cadence": "About 1.2 s in, short squeeze, about 2.3 s out"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "45-75 s",
      "frequency": "1-2 times a week",
      "tempo": "1.2-0.6-2.3-0.4 (in-hold-out-pause, seconds)",
      "load": "Stack load is user-chosen: close fully without rocking the trunk.",
      "progression": "Add reps, then load; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with the back on the pad, knees bent about 90 degrees and the pads against the insides of the knees, legs open; hold the side handles."
      },
      {
        "id": "c2",
        "phase": "work",
        "text": "Breathe out and squeeze the knees together, moving the pads in on their arcs."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold with the knees nearly together."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the legs open slowly to the start."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause open, feeling the inner thighs stretch, without letting the stack rest."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Starting wider than comfortable",
        "fix": "Set the start so the stretch is mild."
      },
      {
        "id": "m2",
        "mistake": "Rocking the trunk",
        "fix": "Keep the back on the pad; lighten the stack."
      },
      {
        "id": "m3",
        "mistake": "Letting the legs fly open",
        "fix": "Take about 2 s to open."
      },
      {
        "id": "m4",
        "mistake": "Feet sliding off the rests",
        "fix": "Keep the feet on the footrests."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "≈35° each side, knees 67.4 cm apart",
        "peak": "≈4° each side, knees 26.5 cm apart",
        "norm": "From about 35 degrees each side to nearly together (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
