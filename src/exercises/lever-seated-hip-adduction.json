        "norm": "Each pad turns about a vertical axle under the hip joint, so it does not slide on the knee (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Muscles",
        "setup": "–",
        "peak": "Adductors working hardest near the closed position (illustrative)",
        "norm": "Adductor group working hardest near the closed position (illustrative, clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s open",
