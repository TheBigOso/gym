{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "circles-arm",
    "name": "Circles Arm",
    "aliases": [
      "Arm circles",
      "Standing arm circles",
      "Shoulder circles with straight arms"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9277",
      "title": "Circles Arm",
      "url": "https://gymvisual.com/videos/9277-circles-arm-male.html",
      "listing": "Video (movement reference; page could not be read at authoring time, movement taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (middle deltoids)",
    "secondaryBodyParts": [
      "Shoulders (front and rear deltoids)",
      "Upper back"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (sustained shoulder abduction with small circumduction)",
    "plane": "Multiplanar",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "stabilizer": [
        "serratus_r",
        "serratus_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily; do not hold the breath.",
      "cadence": "About one circle every 0.8 s"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "20-30 s each direction",
      "tempo": "Small, steady circles",
      "frequency": "Daily as a warm-up, or 2-3 times a week as shoulder endurance work",
      "progression": "Longer sets, then bigger circles, then very light weights in the hands"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "raise",
        "text": "Stand tall, feet hip width; raise the straight arms out to shoulder height, palms down."
      },
      {
        "id": "c2",
        "phase": "forward",
        "text": "Draw small forward circles with the hands, about a hand span across."
      },
      {
        "id": "c3",
        "phase": "backward",
        "text": "Reverse into small backward circles; shoulders stay down away from the ears."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the arms to the sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the neck long and the shoulders down."
      },
      {
        "id": "m2",
        "mistake": "Arms drifting below shoulder height",
        "fix": "Keep the hands level with the shoulders."
      },
      {
        "id": "m3",
        "mistake": "Leaning back or arching",
        "fix": "Brace lightly; ribs stacked over the hips."
      },
      {
        "id": "m4",
        "mistake": "Circles getting large and sloppy",
        "fix": "Keep them small and even."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "Arms by the sides",
        "peak": "Elevation 80-96° (shoulder height), plane 0 to 16°",
        "norm": "Arms held at about 90 degrees (shoulder height) (clinical opinion; Reinold 2007 for deltoid load in abduction)",
        "sources": [
          "reinold2007"
        ]
      },
      {
        "measure": "Circle size",
        "setup": "–",
        "peak": "Wrist circle about 14 cm across (wrist -3.6 to +10.3 cm about shoulder height)",
        "norm": "Small circles, about a hand span across (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbows",
        "setup": "≈4°",
        "peak": "≈4°",
        "norm": "Straight or nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈5° from vertical",
        "peak": "Unchanged",
        "norm": "Upright and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms up 0.8 s",
        "peak": "4 forward and 4 backward circles, 0.8 s each; arms down 0.8 s",
        "norm": "About one circle every 0.8 s (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #9277, Circles Arm, video (movement reference)",
        "url": "https://gymvisual.com/videos/9277-circles-arm-male.html"
      },
      {
        "id": "reinold2007",
        "title": "Reinold et al. 2007, electromyographic analysis of the supraspinatus and deltoid muscles during 3 common rehabilitation exercises (J Athl Train 42(4):464-469)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2140071/"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "botton2013",
        "title": "Botton, Wilhelm, Ughini, Pinto and Lima 2013, electromyographical analysis of the deltoid between different strength training exercises (Medicina Sportiva 17(2):67-71)",
        "url": "https://www.bisp-surf.de/Record/PU201312008451"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Shoulder pain or impingement symptoms: lower the arms a little below shoulder height or stop."
      ],
      "modify": [
        "Arms a little lower.",
        "One arm at a time."
      ],
      "regressions": [
        "Arm raises without circles."
      ],
      "progressions": [
        "Longer sets.",
        "Light weights in the hands."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Holds the arm out at shoulder height for the whole set; the middle deltoid is the main abductor (Reinold 2007; Coratella 2020).",
      "lat_deltoid_l": "Same on the left.",
      "ant_deltoid_r": "Leads the front part of each circle.",
      "ant_deltoid_l": "Same on the left.",
      "post_deltoid_r": "Leads the back part of each circle (Botton 2013 for deltoid portions).",
      "post_deltoid_l": "Same on the left.",
      "upper_traps_r": "Help hold the shoulder girdle as the arm stays raised.",
      "upper_traps_l": "Same on the left.",
      "serratus_r": "Rotates the shoulder blade upward under the raised arm.",
      "serratus_l": "Same on the left.",
      "infraspinatus_r": "Steadies the humeral head.",
      "infraspinatus_l": "Steadies the humeral head.",
      "core": "Keeps the trunk still."
    }
  },
