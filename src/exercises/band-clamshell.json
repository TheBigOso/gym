{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "band-clamshell",
    "name": "Band Clamshell",
    "aliases": [
      "Banded clamshell",
      "Mini-band clam",
      "Side-lying clam with band"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "487012",
      "title": "Hip Clam Shell",
      "url": "https://gymvisual.com/videos/11019-hip-clam-shell.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Body-weight clamshell; the mini band above the knees is the standard progression. Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus medius)",
    "secondaryBodyParts": [
      "Glutes"
    ],
    "equipment": [
      "Mini band (loop)",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip abduction and external rotation)",
    "plane": "Transverse",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_med_r"
      ],
      "synergist": [
        "glute_max_r"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "core"
      ],
      "lengthened": [
        "adductors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the knee opens, inhale as it closes.",
      "cadence": "About 1.2 s open, 0.6 s hold, 1.7 s close"
    },
    "prescription": {
      "sets": "2-3 per side",
      "reps": "12-20",
      "tempo": "1-0.5-2-0",
      "frequency": "3-5 times a week (rehab and warm-up)",
      "progression": "Stronger band, then a longer pause at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Band just above the knees. Lie on your left side, head on the left arm, hips bent about 45 degrees, knees bent about 90, knees and feet stacked."
      },
      {
        "id": "c2",
        "phase": "open",
        "text": "Breathe out and open the top knee against the band; the feet stay together."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause with the pelvis still stacked; do not roll back."
      },
      {
        "id": "c4",
        "phase": "close",
        "text": "Breathe in and close slowly, keeping tension in the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch the knees lightly and repeat; then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rolling the pelvis back to open further",
        "fix": "Keep the hips stacked; open only as far as the pelvis stays still."
      },
      {
        "id": "m2",
        "mistake": "Feet coming apart",
        "fix": "Press the heels together; the movement is a rotation, not a leg lift."
      },
      {
        "id": "m3",
        "mistake": "Snapping the knee shut",
        "fix": "Close against the band slowly."
      },
      {
        "id": "m4",
        "mistake": "Band slipping onto the shins",
        "fix": "Set it on the thighs just above the knees."
      }
    ],
    "kinematics": [
      {
        "measure": "Top hip (clam)",
        "setup": "Knees together, feet stacked",
        "peak": "Top knee opens 40° about the hip-ankle axis (hip abd 8.7°, rot -33.7°)",
        "norm": "Knee opens about 30-45 degrees with the pelvis stacked (clinical opinion); the clam excites the gluteus medius moderately (Distefano 2009; Boren 2011)",
        "sources": [
          "distefano2009",
          "boren2011"
        ]
      },
      {
        "measure": "Knees and feet",
        "setup": "Hips ≈45°, knees ≈90°",
        "peak": "Feet stay together (drift 0.2 cm)",
        "norm": "Hips about 45 degrees, knees about 90, feet together (common protocol, Distefano 2009)",
        "sources": [
          "distefano2009"
        ]
      },
      {
        "measure": "Band",
        "setup": "Around both thighs just above the knees (legs 13 cm apart)",
        "peak": "Stretched to 30 cm between the thighs",
        "norm": "Loop band just above the knees adds resistance as the knee opens (standard progression)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.2 s open, 0.6 s hold, 1.7 s close",
        "norm": "Slow and controlled, slower closing (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #487012, Hip Clam Shell, video (movement reference)",
        "url": "https://gymvisual.com/videos/11019-hip-clam-shell.html"
      },
      {
        "id": "distefano2009",
        "title": "Distefano et al. 2009, gluteal muscle activation during common therapeutic exercises (J Orthop Sports Phys Ther 39(7):532-540)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19574661/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Hip pressure on the floor: lie on a mat or a folded towel.",
        "Neck strain: put a small pillow under the head."
      ],
      "regressions": [
        "Clamshell without a band.",
        "Smaller opening."
      ],
      "progressions": [
        "Stronger band.",
        "Side-plank clamshell.",
        "Side-lying hip abduction with a band."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Abducts and externally rotates the top hip; Distefano 2009 measured about 40% MVIC (gluteus medius) in the clam without a band.",
      "glute_max_r": "Assists external rotation (Distefano 2009; Boren 2011).",
      "obliques_r": "Keep the pelvis stacked (clinical opinion).",
      "obliques_l": "Keep the pelvis stacked (clinical opinion).",
      "core": "Holds the trunk still (clinical opinion).",
      "adductors_r": "Lengthen as the knee opens (clinical opinion)."
    }
  },
