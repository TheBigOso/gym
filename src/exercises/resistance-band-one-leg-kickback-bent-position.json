  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "resistance-band-one-leg-kickback-bent-position",
    "name": "Resistance Band One Leg Kickback (Bent Position)",
    "aliases": [
      "Bent-over band kickback",
      "Hinged mini band glute kickback"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9141",
      "title": "Resistance Band One Leg Kickback (Bent Position)",
      "url": "https://gymvisual.com/videos/9141-resistance-band-one-leg-kickback-bent-position-male.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus maximus)",
    "secondaryBodyParts": [
      "Hamstrings",
      "Lower back"
    ],
    "equipment": [
      "Resistance band (mini loop around the ankles)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (hip extension)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r"
      ],
      "synergist": [
        "hamstrings_r"
      ],
      "stabilizer": [
        "hamstrings_l",
        "glute_med_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core"
      ],
      "lengthened": [
        "hip_flexors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg kicks back, inhale as it returns.",
      "cadence": "About 1.2 s back, 0.5 s squeeze, 1.8 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Stronger band, or a pause at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Band around the ankles; hinge forward with a flat back on a soft left knee, hands on the hips."
      },
      {
        "id": "c2",
        "phase": "back",
        "text": "Breathe out and drive the right heel back and up until the leg lines up with the trunk."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the glute; keep the hips square to the floor."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and lower the leg slowly under the hip."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hinge and the band tension; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back",
        "fix": "Keep the chest long and the back flat in the hinge."
      },
      {
        "id": "m2",
        "mistake": "Kicking above the trunk line",
        "fix": "Stop when the leg lines up with the trunk; higher only arches the low back."
      },
      {
        "id": "m3",
        "mistake": "Opening the hip to the side",
        "fix": "Keep both hip bones facing the floor."
      },
      {
        "id": "m4",
        "mistake": "Bouncing",
        "fix": "Pause at the top, slow down."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip extension",
        "setup": "Hip ≈59° flexion (leg under the hip)",
        "peak": "≈18° past neutral (channel); leg 28° off the trunk line",
        "norm": "From about 50 degrees of flexion to 10-20 degrees past neutral (clinical opinion); hip extension excites the gluteus maximus (Macadam 2019; Neto 2020)",
        "sources": [
          "macadam2019",
          "neto2020"
        ]
      },
      {
        "measure": "Trunk hinge",
        "setup": "≈40° forward, stance knee ≈15°",
        "peak": "Held",
        "norm": "About 40-50 degrees forward, flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Around both ankles (27 cm apart)",
        "peak": "Stretched to 87 cm",
        "norm": "Mini loop around both ankles (elastic resistance, Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hinge 0.8 s",
        "peak": "1.2 s up, 0.5 s squeeze, 1.8 s down",
        "norm": "Controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #9141, Resistance Band One Leg Kickback (Bent Position), video (movement reference)",
        "url": "https://gymvisual.com/videos/9141-resistance-band-one-leg-kickback-bent-position-male.html"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      },
      {
        "id": "neto2020",
        "title": "Krause Neto, Soares, Vieira et al. 2020, gluteus maximus activation during common strength and hypertrophy exercises: a systematic review (J Sports Sci Med 19(1):195-203)",
        "url": "https://www.jssm.org/jssm-19-195.xml-abst"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjørnlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Andersen+2010+muscle+activation+perceived+loading+dumbbells+elastic+resistance"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the band for nicks before use."
      ],
      "modify": [
        "Poor balance: hold a support in front.",
        "Low-back discomfort: hinge less and shorten the range."
      ],
      "regressions": [
        "Resistance band leg kickback (upright, hands on a wall)."
      ],
      "progressions": [
        "Heavier band.",
        "Cable donkey kickback."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Extends the hip against the band; the hinged trunk lets the hip work through more range (Macadam 2019).",
      "hamstrings_r": "Assist hip extension (clinical opinion).",
      "hamstrings_l": "Hold the hinge on the stance leg (clinical opinion).",
      "glute_med_l": "Keeps the pelvis level (Boren 2011).",
      "spinal_extensors_r": "Hold the flat back (clinical opinion).",
      "spinal_extensors_l": "Hold the flat back (clinical opinion).",
      "core": "Stops the low back arching (clinical opinion).",
      "hip_flexors_r": "Lengthen at the top (clinical opinion)."
    }
