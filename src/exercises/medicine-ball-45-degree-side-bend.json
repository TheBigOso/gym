  "exercise": {
    "id": "medicine-ball-45-degree-side-bend",
    "name": "Medicine Ball 45 degree Side Bend",
    "aliases": [
      "45-degree side hyperextension with medicine ball",
      "Roman chair side bend",
      "Lateral hyperextension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "22089",
      "title": "Medicine Ball 45 degree Side Bend",
      "url": "https://gymvisual.com/videos/22089-medicine-ball-45-degree-side-bend.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Lower back",
      "Hips"
    ],
    "equipment": [
      "Hyperextension bench (45 degrees)",
      "Medicine ball"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (trunk lateral flexion)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r"
      ],
      "synergist": [
        "spinal_extensors_r",
        "core"
      ],
      "stabilizer": [
        "glute_med_r",
        "adductors_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "lengthened": [
        "obliques_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you bend down, exhale as you lift.",
      "cadence": "About 1.8 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 per side",
      "tempo": "2-0-1-1",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Heavier ball, or hold it further from the chest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your side on the 45-degree bench, hip on the pad, feet scissored under the roller, ball hugged to the chest."
      },
      {
        "id": "c2",
        "phase": "down",
        "text": "Breathe in and bend sideways down toward the floor, slow and controlled."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Short pause at the bottom; no bounce."
      },
      {
        "id": "c4",
        "phase": "up",
        "text": "Breathe out and lift the trunk sideways up through the line, a little past it."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Settle back to the straight line; repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting the trunk",
        "fix": "Stay stacked: shoulders and hips face the same way."
      },
      {
        "id": "m2",
        "mistake": "Swinging up past the line",
        "fix": "Lift only a little past straight."
      },
      {
        "id": "m3",
        "mistake": "Pad too high",
        "fix": "The pad top sits below the hip so the trunk can bend over it."
      },
      {
        "id": "m4",
        "mistake": "Holding the ball out",
        "fix": "Hug it to the chest (harder: further out)."
      }
    ],
    "kinematics": [
      {
        "measure": "Lateral flexion",
        "setup": "Body in one line along the bench",
        "peak": "Trunk 19° down to 17° up from the leg line (spine plus pelvis tip)",
        "norm": "About 30-45 degrees down and 10-20 degrees up past the line (clinical opinion); side-lying trunk lifts load the obliques (Konrad 2001)",
        "sources": [
          "konrad2001"
        ]
      },
      {
        "measure": "Pelvis on the pad",
        "setup": "Pad top 15 cm below the left hip joint",
        "peak": "Body-pad clearance ≥ 0.42 cm (thigh_l)",
        "norm": "Pelvis tips over the pad top below the hip (standard setup)",
        "sources": []
      },
      {
        "measure": "Bench",
        "setup": "45-degree bench, feet scissored 18 cm",
        "peak": "Feet stay under the roller",
        "norm": "45-degree hyperextension bench, side on the pad (standard setup)",
        "sources": []
      },
      {
        "measure": "Ball",
        "setup": "Hugged to the chest (hands 25 cm apart)",
        "peak": "Moves with the thorax",
        "norm": "Hugged to the chest (standard technique)",
        "sources": [
          "escamilla2006"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Line 0.8 s",
        "peak": "1.6 s down, 0.3 s pause, 1.3 s up, 1 s back",
        "norm": "Slow down, controlled up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #22089, Medicine Ball 45 degree Side Bend, video (movement reference)",
