      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Lock the feet under the roller before leaning out.",
        "Low-back or hip pain: reduce the range."
      ],
      "modify": [
        "No ball until the movement is smooth."
      ],
      "regressions": [
        "Side-lying lateral raise on the floor.",
        "Dumbbell side bend."
      ],
      "progressions": [
        "Heavier ball.",
        "Ball held overhead."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Top-side obliques lift the trunk against gravity and the ball; side-lying lifts and side bridges are strong oblique exercises (Konrad 2001; Escamilla 2006).",
      "spinal_extensors_r": "Top-side quadratus lumborum and erectors assist lateral flexion (clinical opinion).",
      "core": "Rectus abdominis braces the trunk (Konrad 2001).",
      "glute_med_r": "Holds the top leg and pelvis (clinical opinion).",
      "adductors_l": "Bottom leg presses into the foot plate (clinical opinion).",
      "ant_deltoid_r": "Hug the ball to the chest (clinical opinion).",
      "ant_deltoid_l": "Hug the ball to the chest (clinical opinion).",
      "obliques_l": "Lengthen as the trunk lifts (clinical opinion)."
    }
