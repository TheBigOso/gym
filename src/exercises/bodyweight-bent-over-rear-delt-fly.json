  "exercise": {
    "id": "bodyweight-bent-over-rear-delt-fly",
    "name": "Bodyweight Bent Over Rear Delt Fly",
    "aliases": [
      "Bent-over reverse fly (no weight)",
      "Bodyweight rear delt raise",
      "Bent-over T raise",
      "Bodyweight reverse fly"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14318",
      "title": "Bodyweight Bent Over Rear Delt Fly",
      "url": "https://gymvisual.com/videos/14318-bodyweight-bent-over-rear-delt-fly.html",
      "listing": "Video (movement reference only; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (posterior deltoid)",
    "secondaryBodyParts": [
      "Upper back (rhomboids, mid trapezius)",
      "Low back (holding the hinge)"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder horizontal abduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "hamstrings_r",
        "hamstrings_l",
        "glute_max_r",
        "glute_max_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise the arms, breathe in as you lower; keep the trunk braced.",
      "cadence": "About 1.5 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "15-25",
      "tempo": "2-0.5-1.5-0 (down-squeeze-up-pause, seconds)",
      "load": "Body weight (arms only); add light dumbbells or a band when it gets easy",
      "frequency": "2-4 times a week (also as a warm-up)",
      "progression": "More reps and longer squeezes, then dumbbell or band reverse flies"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet hip width, knees soft, hinge at the hips until the trunk is nearly parallel to the floor with a flat back. Arms hang under the shoulders, palms facing each other."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and sweep the arms out to the sides with soft elbows, leading with the backs of the hands."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms about level with the back; squeeze the shoulder blades together and hold briefly."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly back under the shoulders; keep the trunk still."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the hinge, reset and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back",
        "fix": "Push the hips back, keep the chest long; stand a little more upright if needed."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbows and pulling back (rowing)",
        "fix": "Keep the elbow bend fixed and move the arms out to the sides."
      },
      {
        "id": "m3",
        "mistake": "Bouncing the trunk",
        "fix": "Keep the trunk still; slow the arms down."
      },
      {
        "id": "m4",
        "mistake": "Shrugging toward the ears",
        "fix": "Draw the shoulder blades back and down."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk inclination",
        "setup": "≈17° above horizontal (≈73° from vertical)",
        "peak": "unchanged",
        "norm": "Nearly parallel to the floor, flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Horizontal abduction",
        "setup": "arms hanging (upper arm ≈11° from vertical)",
        "peak": "upper arm ≈106° from vertical, about level with the back",
        "norm": "From arms hanging to about level with the back; prone horizontal abduction tested at about 100 degrees of abduction (Reinold 2007)",
        "sources": [
          "reinold2007"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈16°",
        "peak": "≈20°",
        "norm": "Slight, fixed bend (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "neutral, palms facing each other",
        "peak": "palms down, thumbs toward the head",
        "norm": "Palms facing each other at the bottom; a neutral hand position gave more posterior deltoid activity than pronated on a reverse fly (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈24°",
        "peak": "unchanged",
        "norm": "Soft knees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold the hinge 0.8 s",
        "peak": "1.5 s up, 0.5 s squeeze, 2.0 s down",
        "norm": "Controlled, no swing (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 14318, Bodyweight Bent Over Rear Delt Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/14318-bodyweight-bent-over-rear-delt-fly.html"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "reinold2007",
        "title": "Reinold et al. 2007, electromyographic analysis of the supraspinatus and deltoid muscles during 3 common rehabilitation exercises (J Athl Train 42(4):464-469)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2140071/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The bent-over position loads the low back even without weights: keep the back flat and take breaks if it tires."
      ],
      "modify": [
        "Low-back discomfort: do it lying face down on a bench or the floor (prone T raise), or seated bent over the knees.",
        "Hamstring tightness: bend the knees more."
      ],
      "regressions": [
        "Prone T raise on the floor.",
        "Seated bent-over rear delt fly."
      ],
      "progressions": [
        "Slower 3 s lowering with a 2 s squeeze.",
        "Light dumbbells (dumbbell rear delt fly).",
        "Band reverse fly."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover: sweep the arms out to the sides (horizontal abduction).",
      "post_deltoid_l": "Prime mover: sweep the arms out to the sides (horizontal abduction).",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together at the top.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together at the top.",
      "infraspinatus_r": "Works with the rear deltoid to turn and hold the arm.",
      "infraspinatus_l": "Works with the rear deltoid to turn and hold the arm.",
      "lat_deltoid_r": "Helps lift the arm out to the side.",
      "lat_deltoid_l": "Helps lift the arm out to the side.",
      "spinal_extensors_r": "Hold the flat back in the hip hinge for the whole set.",
      "spinal_extensors_l": "Hold the flat back in the hip hinge for the whole set.",
      "hamstrings_r": "Hold the hinge at the hips with the knees soft.",
      "hamstrings_l": "Hold the hinge at the hips with the knees soft.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Keeps the trunk still so the arms do the work."
    }
  },
