  "exercise": {
    "id": "band-incline-y-raise",
    "name": "Band Incline Y Raise",
    "aliases": [
      "Band prone incline Y raise",
      "Chest-supported band Y raise",
      "Incline bench Y raise with band"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "16987",
      "title": "Band Incline Y Raise",
      "url": "https://gymvisual.com/videos/16987-band-incline-y-raise.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (the proxy refused gymvisual.com), so the movement follows the name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper back and shoulders (lower and middle trapezius, deltoids)",
    "secondaryBodyParts": [
      "Shoulders (serratus anterior, rotator cuff)"
    ],
    "equipment": [
      "Resistance band"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder elevation with upward rotation of the shoulder blade)",
    "plane": "Multiplanar",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "lat_deltoid_r",
        "lat_deltoid_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "synergist": [
        "serratus_r",
        "serratus_l",
        "upper_traps_r",
        "upper_traps_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "forearm_extensors_r",
        "forearm_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short hold, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "effort": "Stop 2-3 reps short of failure (RIR 2-3); form first",
      "tempo": "2-0.5-2-0.5 (up-hold-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen; light: the lower trapezius is a small muscle and the long lever makes this hard",
      "progression": "More reps or a longer hold, then a stronger band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop the band low round a rack upright in front of the bench. Set the pad to about 45 degrees and lie chest-down, chin over the top, feet planted behind; hold the strands with the arms hanging, thumbs forward."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the straight arms forward and up into a Y, thumbs leading."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms in line with the back, thumbs up; draw the shoulder blades back and down. Hold briefly."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms hanging, chest still on the pad; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the chest off the pad or arching the back",
        "fix": "Keep the chest on the pad; move only the arms."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders toward the ears",
        "fix": "Shoulder blades back and down; use a lighter band."
      },
      {
        "id": "m3",
        "mistake": "Bending the elbows to shorten the lever",
        "fix": "Keep the arms long, elbows soft."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the arms down",
        "fix": "Lower over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "45° back pad (80 cm), seat 45 cm",
        "peak": "Trunk ≈42° above horizontal, along the pad",
        "norm": "About 30-45 degrees, chest on the pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation",
        "setup": "≈45° from the trunk line (arms hanging)",
        "peak": "≈129° (arms ≈45° out from the line of the trunk, in a Y)",
        "norm": "From hanging to the arms in line with the trunk in a Y (about 45 degrees out from the trunk line), in line with the lower trapezius fibres; the overhead raise in that line gave the highest lower trapezius activity among the exercises tested (Ekstrom 2003, prone)",
        "sources": [
          "ekstrom2003"
        ]
      },
      {
        "measure": "Chest on the pad",
        "setup": "Chest on the pad; head 4.6 cm past the top edge",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "The chest stays on the pad through the rep (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack upright 10 cm off the floor, 46 cm in front of the hanging hands; strands 59.5 cm",
        "peak": "Strands 137.1 cm with the arms in the Y",
        "norm": "Elastic tension rises as the band stretches, so the load is highest where the band is longest; at matched effort, elastic tubing and dumbbells gave similar muscle activity in upper-body exercises (Andersen 2010); anchored low in front, the band pulls the hands down and forward, so it is tightest with the arms in the Y",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.6 s",
        "peak": "2.0 s up, 0.4 s hold, 2.2 s down",
        "norm": "Slow, about 2 s up and 2 s down, short hold at the top (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #16987, Band Incline Y Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/16987-band-incline-y-raise.html"
      },
      {
        "id": "ekstrom2003",
        "title": "Ekstrom, Donatelli & Soderberg 2003, surface electromyographic analysis of exercises for the trapezius and serratus anterior muscles (J Orthop Sports Phys Ther 33(5):247-258)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/12774999/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling at the top of the shoulder, numbness or tingling occurs.",
        "Check the band for nicks or tears and loop it securely round the upright, low down, so it cannot slide up.",
        "Band tension is user-chosen: pick a light band you can control with straight arms.",
        "Check the bench pin is locked at the chosen angle before lying on it.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder pinch near the top: raise a little less high, or narrow the Y toward a T.",
        "Neck strain: keep the head in line with the trunk, eyes on the floor ahead."
      ],
      "regressions": [
        "No band (bodyweight Y on the bench).",
        "Lighter band, smaller range."
      ],
      "progressions": [
        "Longer hold at the top.",
        "Stronger band.",
        "Prone Y raise on the floor with light dumbbells."
      ]
    },
    "muscleNotes": {
      "rhomboids_midtrap_r": "Middle and lower trapezius (mapped to this region; the lower trapezius is not a separate id on this rig): with the arm raised overhead in line with its fibres the lower trapezius worked hardest of the exercises tested (Ekstrom 2003, prone).",
      "rhomboids_midtrap_l": "Middle and lower trapezius (mapped to this region; the lower trapezius is not a separate id on this rig): with the arm raised overhead in line with its fibres the lower trapezius worked hardest of the exercises tested (Ekstrom 2003, prone).",
      "lat_deltoid_r": "Raises the arm through the middle of the range.",
      "lat_deltoid_l": "Raises the arm through the middle of the range.",
      "ant_deltoid_r": "Raises the arm forward from hanging.",
      "ant_deltoid_l": "Raises the arm forward from hanging.",
      "serratus_r": "Turns the shoulder blade up so the arm can rise in line with the trunk.",
      "serratus_l": "Turns the shoulder blade up so the arm can rise in line with the trunk.",
      "upper_traps_r": "Turns the shoulder blade up with the serratus; shrugging overloads it.",
      "upper_traps_l": "Turns the shoulder blade up with the serratus; shrugging overloads it.",
      "post_deltoid_r": "Helps lift and hold the arm in line with the back.",
      "post_deltoid_l": "Helps lift and hold the arm in line with the back.",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred with the thumbs up.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred with the thumbs up.",
      "spinal_extensors_r": "Hold the trunk still on the pad.",
      "spinal_extensors_l": "Hold the trunk still on the pad.",
      "forearm_extensors_r": "Hold the wrists straight against the band.",
      "forearm_extensors_l": "Hold the wrists straight against the band."
    }
