    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The forward lean loads the low back: keep it long and the dumbbells light."
      ],
      "modify": [
        "Low-back discomfort: do one arm at a time with the other hand on the knee, or use the bench-supported kickback.",
        "Shoulder discomfort at the back: let the upper arms sit a little lower."
      ],
      "regressions": [
        "One-arm kickback with a hand and knee on the bench.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Two-second squeeze at full extension.",
        "Slower 3 s lowering."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Prime mover: straightens the elbow against the dumbbell, hardest near full extension; kickbacks gave some of the highest triceps EMG in the ACE comparison (Boehler 2011).",
      "triceps_l": "Prime mover: straightens the elbow against the dumbbell, hardest near full extension; kickbacks gave some of the highest triceps EMG in the ACE comparison (Boehler 2011).",
