      "post_deltoid_l": "Holds the upper arm back along the trunk.",
      "lats_r": "Helps hold the arm back.",
      "lats_l": "Helps hold the arm back.",
      "rhomboids_midtrap_r": "Keep the shoulder blades set.",
      "rhomboids_midtrap_l": "Keep the shoulder blades set.",
      "forearm_flexors_r": "Grip the handles.",
      "forearm_flexors_l": "Grip the handles.",
      "spinal_extensors_r": "Hold the long-back forward lean.",
      "spinal_extensors_l": "Hold the long-back forward lean.",
      "core": "Braces the trunk in the lean."
