    },
    "breathing": {
      "pattern": "Breathe out as you straighten the arms back, breathe in as the forearms swing down.",
      "cadence": "About 1 s out, short squeeze, about 2 s back"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1-0.5-2-0 (out-squeeze-back-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen light dumbbells; kickbacks need much less weight than presses",
      "progression": "More reps, a longer squeeze, then heavier dumbbells"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the end of a bench, feet flat. Lean forward from the hips with a long back; upper arms along the sides of the trunk, elbows bent about 90 degrees, dumbbells hanging below the elbows, palms facing in."
      },
      {
        "id": "c2",
        "phase": "extend",
        "text": "Breathe out and straighten both elbows, pushing the dumbbells back until the arms are straight."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the backs of the arms; the upper arms stay where they are."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the forearms swing slowly back to hanging."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the lean and the upper arms still; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the upper arms to move the dumbbells",
        "fix": "Pin the upper arms beside the trunk; only the elbows move."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back to lean forward",
        "fix": "Hinge at the hips with a long spine and the chest open."
      },
      {
        "id": "m3",
        "mistake": "Letting the upper arms drop as the arms tire",
        "fix": "Keep the elbows up at back level; use lighter dumbbells."
      },
      {
        "id": "m4",
        "mistake": "Rushing back down",
        "fix": "Take about two seconds to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈92° (forearm hanging)",
        "peak": "≈4° (arms straight back)",
        "norm": "From about 90 degrees (forearm hanging) to straight (clinical opinion); kickbacks scored high for triceps EMG in the ACE study (Boehler 2011)",
        "sources": [
          "boehler2011",
          "ace2011"
        ]
      },
      {
        "measure": "Upper arm to trunk",
        "setup": "≈25° from the trunk line, elbows at back level",
        "peak": "Unchanged (shoulder channels constant)",
        "norm": "Upper arm held back along the trunk, at low shoulder elevation (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Trunk lean",
        "setup": "≈61° forward from vertical (pelvis to C7), hips ≈131°",
        "peak": "Unchanged",
        "norm": "Leaning well forward from the hips, back long (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell clearance",
        "setup": "Dumbbells under the elbows",
        "peak": "1.6 cm from the body at the closest (rig shapes), 2 cm from the bench",
        "norm": "The dumbbells pass beside the hips and above the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Elbows bent 0.6 s",
        "peak": "1.0 s out, 0.5 s squeeze, 1.8 s back, 0.7 s reset",
        "norm": "Slow, with a pause at full extension (clinical opinion)",
        "sources": []
      }
    ],
