  "exercise": {
    "id": "kneeling-pulse",
    "name": "Kneeling Pulse",
    "aliases": [
      "Kneeling squat pulse",
      "Kneeling hip pulse",
      "Tall-kneeling glute pulse",
      "Kneeling sit-back pulse"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "10803",
      "title": "Kneeling Pulse",
      "url": "https://gymvisual.com/videos/10803-kneeling-pulse.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps) and glutes",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (knee and hip, short range)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "core"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "adductors_r",
        "adductors_l"
      ],
      "lengthened": [
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily; exhale on the rise back to tall kneeling.",
      "cadence": "About one breath per two pulses"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20 pulses",
      "tempo": "Small pulses, about 0.4 s each way",
      "frequency": "2-3 times a week",
      "progression": "Deeper sit-back, longer sets, then a band or a held weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel tall on a mat, knees hip width, toes tucked, hands on the hips."
      },
      {
        "id": "c2",
        "phase": "sit",
        "text": "Sit the hips back toward the heels with a straight back, leaning forward a little."
      },
      {
        "id": "c3",
        "phase": "pulse",
        "text": "Pulse up and down a few centimetres, squeezing the glutes on each pulse."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the hips forward and come back up to tall kneeling."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back",
        "fix": "Chest proud, back long."
      },
      {
        "id": "m2",
        "mistake": "Sitting all the way onto the heels",
        "fix": "Stay off the heels; keep the tension."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back at the top",
        "fix": "Squeeze the glutes and keep the ribs down."
      },
      {
        "id": "m4",
        "mistake": "Knees caving in",
        "fix": "Knees in line with the hips."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈113° (tall kneeling)",
        "peak": "≈137° at the bottom; buttocks 15 cm above the heels",
        "norm": "From tall kneeling (about 90 degrees) to a sit-back short of the heels (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pulse",
        "setup": "–",
        "peak": "≈128° to ≈137° (hips move 6 cm)",
        "norm": "Small up-down range near the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk lean",
        "setup": "≈5° (upright)",
        "peak": "≈16° forward at the bottom",
        "norm": "Leans forward to balance as the hips go back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Tall 0.6 s",
        "peak": "1 s sit back, 7 pulses of 0.4 s, 0.8 s rise",
        "norm": "Brisk, controlled pulses (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #10803, Kneeling Pulse, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/10803-kneeling-pulse.html"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a soft mat or a cushion under the knees.",
        "Knee pain when kneeling: use a thicker pad or switch to a standing squat pulse."
      ],
      "modify": [
        "Thicker padding under the knees.",
        "Smaller sit-back."
      ],
      "regressions": [
        "Tall kneeling hold with glute squeezes.",
        "Smaller range."
      ],
      "progressions": [
        "Deeper sit-back.",
        "Hold a light dumbbell at the chest.",
        "Band around the thighs (when available)."
      ]
    },
    "muscleNotes": {
      "quads_r": "The quadriceps hold the body as the hips sit back toward the heels (the knee bends under load) and drive each small pulse up (clinical opinion).",
      "quads_l": "The quadriceps hold the body as the hips sit back toward the heels (the knee bends under load) and drive each small pulse up (clinical opinion).",
      "glute_max_r": "Gluteus maximus pushes the hips forward and up on each pulse (clinical opinion; body-weight hip extension drills, Macadam and Feser 2019).",
      "glute_max_l": "Gluteus maximus pushes the hips forward and up on each pulse (clinical opinion; body-weight hip extension drills, Macadam and Feser 2019).",
      "hamstrings_r": "Help extend the hips (clinical opinion).",
      "hamstrings_l": "Help extend the hips (clinical opinion).",
      "core": "Keeps the ribs over the pelvis as the trunk leans (clinical opinion).",
      "spinal_extensors_r": "Hold the back straight in the forward lean (clinical opinion).",
      "spinal_extensors_l": "Hold the back straight in the forward lean (clinical opinion).",
      "adductors_r": "Keep the knees in line (clinical opinion).",
      "adductors_l": "Keep the knees in line (clinical opinion)."
    }
  },
