{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "resistance-band-standing-hip-abduction",
    "name": "Resistance Band Standing Hip Abduction",
    "aliases": [
      "Mini band standing hip abduction",
      "Banded standing side leg raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14470",
      "title": "Resistance Band Standing Hip Abduction",
      "url": "https://gymvisual.com/videos/14470-resistance-band-standing-hip-abduction.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus medius)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Resistance band (mini loop around the ankles)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip abduction)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_med_r"
      ],
      "synergist": [
        "glute_max_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "core",
        "obliques_l",
        "calves_l"
      ],
      "lengthened": [
        "adductors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg moves out, inhale as it returns.",
      "cadence": "About 1.2 s out, 0.5 s hold, 1.8 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Stronger band, or move the band from above the knees to the ankles"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop the band around both ankles, stand tall on the left leg and put the hands on the hips."
      },
      {
        "id": "c2",
        "phase": "out",
        "text": "Breathe out and push the straight right leg out to the side, toes forward."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at about 30 degrees with the pelvis level."
      },
      {
        "id": "c4",
        "phase": "back",
        "text": "Breathe in and let the band draw the leg back slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep a little tension before the feet meet; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning over the stance leg",
        "fix": "Stay tall; the hips do the work, not a side bend."
      },
      {
        "id": "m2",
        "mistake": "Turning the toes up",
        "fix": "Keep the toes forward so the hip does not rotate out."
      },
      {
        "id": "m3",
        "mistake": "Letting the band snap back",
        "fix": "Control the return; slower back than out."
      },
      {
        "id": "m4",
        "mistake": "Hitching the hip",
        "fix": "Keep the pelvis level; make the arc smaller if it tips."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "≈4° (feet almost together)",
        "peak": "≈30° (joint channel); leg 32° from vertical",
        "norm": "About 25-35 degrees against a band (clinical opinion); standing abduction excites the gluteus medius well (Distefano 2009; Boren 2011)",
        "sources": [
          "distefano2009",
          "boren2011"
        ]
      },
      {
        "measure": "Pelvis and trunk",
        "setup": "Tall, pelvis level over the stance foot",
        "peak": "≈6° lean (small)",
        "norm": "Pelvis level, trunk upright (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Around both ankles (legs 22 cm apart)",
        "peak": "Stretched to 59 cm between the ankles",
        "norm": "Mini loop around both ankles; tension grows as the feet separate (elastic resistance, Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.2 s out, 0.5 s hold, 1.8 s back",
        "norm": "Slow and controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #14470, Resistance Band Standing Hip Abduction, video (movement reference)",
        "url": "https://gymvisual.com/videos/14470-resistance-band-standing-hip-abduction.html"
      },
      {
        "id": "distefano2009",
        "title": "Distefano et al. 2009, gluteal muscle activation during common therapeutic exercises (J Orthop Sports Phys Ther 39(7):532-540)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19574661/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjørnlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Andersen+2010+muscle+activation+perceived+loading+dumbbells+elastic+resistance"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the band for nicks before use; a snapping band can sting."
      ],
      "modify": [
        "Poor balance: hold a wall with one hand.",
        "Hip pinching: make the arc smaller."
      ],
      "regressions": [
        "Band above the knees.",
        "Side-lying hip abduction."
      ],
      "progressions": [
        "Heavier band.",
        "Longer pause at the top."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Prime mover of hip abduction; standing and side-lying abduction rank high for gluteus medius (Distefano 2009; Boren 2011).",
      "glute_max_r": "Upper fibres assist abduction (Selkowitz 2013).",
      "glute_med_l": "Holds the pelvis level over the stance leg, also working against the band (clinical opinion).",
      "core": "Keeps the trunk tall (clinical opinion).",
      "obliques_l": "Resists leaning away from the band (clinical opinion).",
      "calves_l": "Balance on the stance foot (clinical opinion).",
      "adductors_r": "Lengthen as the leg moves out (clinical opinion)."
    }
  },
