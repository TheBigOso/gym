      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Biceps",
    "secondaryBodyParts": [
      "Forearms (brachioradialis)"
    ],
    "equipment": [
      "Resistance band (two)",
      "Adjustable bench",
      "Rack (band anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "core"
      ],
      "lengthened": [
        "biceps_r",
        "biceps_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl up, breathe in as you lower.",
      "cadence": "About 1 s up, short squeeze, about 2.5 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "3-1-1-0 (2.5 s down, pause in the stretch, 1 s up)",
      "progression": "More reps, a slower lowering, a stronger band."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit back on a bench set to about 55 degrees, back and head supported, feet flat. A rack stands behind the bench with a band looped low round each upright; hold a band end in each hand, arms hanging straight down behind the trunk line, palms facing in (thumbs forward)."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl both hands up, thumbs leading, keeping the upper arms back and still."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze at the top, where the band is most stretched; palms still facing each other."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly against the band to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the arms hanging straight behind the trunk line, then curl again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arms swinging forward to finish the curl",
        "fix": "Keep the elbows back; let the forearms do the moving."
      },
      {
        "id": "m2",
        "mistake": "Lifting the back off the pad",
        "fix": "Keep the back and head on the pad."
      },
      {
        "id": "m3",
        "mistake": "Turning the palms up (it becomes a regular curl)",
        "fix": "Keep the thumbs up and palms facing in throughout."
      },
      {
        "id": "m4",
        "mistake": "Cutting the stretch short",
        "fix": "Straighten the arms fully at the bottom."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈5° (arm straight)",
        "peak": "≈130° at the top (range ≈125°)",
        "norm": "From straight to about 125-135 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm rotation",
        "setup": "90° (neutral, thumb up)",
        "peak": "90° (neutral, thumb up)",
        "norm": "Neutral (thumbs up) throughout; the hammer grip shifts work to the brachioradialis (Coratella 2023; Marcolin 2018).",
        "sources": [
          "coratella2023",
          "marcolin2018"
        ]
      },
      {
        "measure": "Upper arm",
        "setup": "≈-43°",
        "peak": "≈-33° (elbow behind the trunk line)",
        "norm": "Hangs behind the trunk line, as in the incline curl, which stretches the biceps long head (Oliveira 2009).",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Band",
        "setup": "One band per hand, looped round the rack uprights behind the bench, 12 cm off the floor and 120 cm apart; strands 56.4 cm with the arms hanging",
        "peak": "Strand 108.1 cm at the top of the curl",
        "norm": "Looped low round the rack uprights behind the bench, so it resists the whole curl as gravity does with a dumbbell (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.8 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.5 s down, 1.2 s pause in the stretch",
        "norm": "About 1.2 s up and 2.5 s down (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Back pad angle",
        "setup": "55° from the floor (trunk line ≈40° back from vertical)",
        "peak": "Unchanged (the trunk stays on the pad)",
        "norm": "About 45-60 degrees (Oliveira 2009 tested shoulder positions in dumbbell curls).",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
