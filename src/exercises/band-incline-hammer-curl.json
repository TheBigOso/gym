    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Shoulder pain in the stretched start position: raise the back pad (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: raise the back pad toward upright."
      ],
      "regressions": [
        "Lighter band.",
        "Seated or standing band hammer curl."
      ],
      "progressions": [
        "Stronger band.",
        "Pause 2 s at the top.",
        "Incline dumbbell hammer curl."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Bends the elbow from a stretched position (arms behind the trunk), as in the incline curl (Oliveira 2009); the neutral grip lowers biceps activity a little compared with palms up (Coratella 2023).",
      "biceps_l": "Bends the elbow from a stretched position (arms behind the trunk), as in the incline curl (Oliveira 2009); the neutral grip lowers biceps activity a little compared with palms up (Coratella 2023).",
      "forearm_flexors_r": "Brachioradialis is strongly involved with the hammer grip (Coratella 2023; Marcolin 2018), and the hand grips the band.",
      "forearm_flexors_l": "Brachioradialis is strongly involved with the hammer grip (Coratella 2023; Marcolin 2018), and the hand grips the band.",
      "forearm_extensors_r": "Steady the wrist in neutral.",
      "forearm_extensors_l": "Steady the wrist in neutral.",
      "ant_deltoid_r": "Holds the upper arm back and still.",
      "ant_deltoid_l": "Holds the upper arm back and still.",
      "core": "Keeps the trunk on the pad."
    }
