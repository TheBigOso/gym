    "breathing": {
      "pattern": "Breathe in as the arms open, breathe out as you hug them back together over the chest.",
      "cadence": "About 2.2 s down, short stretch, about 1.5 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2-0.4-1.5-0.6 (down-stretch-up-squeeze, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can control through the whole arc with the elbow bend unchanged.",
      "progression": "Add reps, then one plate on each stack; slower opening"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie head-down on a bench set at a slight decline (about 15 degrees) between two low pulleys, feet planted; a D-handle in each hand, hands together over the lower chest, palms facing, elbows softly bent."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the cables draw the arms open in a wide arc, elbow bend fixed, shoulder blades back on the bench."
      },
      {
        "id": "c3",
        "phase": "stretch",
        "text": "Stop when the upper arms are about level with the bench and the chest is stretched; palms face the ceiling."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and hug the handles back up along the same arc to over the lower chest."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze with the hands just apart over the lower chest; keep the elbow bend."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Turning the fly into a press",
        "fix": "Keep the same soft elbow bend all the way down and up."
      },
      {
        "id": "m2",
        "mistake": "Lowering too far",
        "fix": "Stop with the upper arms about level with the bench; the stretched shoulder is the vulnerable position."
      },
      {
        "id": "m3",
        "mistake": "Too steep a decline",
        "fix": "A slight decline is enough; a steep one sends blood to the head and makes it hard to get up."
      },
      {
        "id": "m4",
        "mistake": "Lifting the head and shoulders off the bench",
        "fix": "Keep the upper back and head on the pad, chin neutral."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "15° decline (head 20.7 cm below the hips' end of the pad)",
        "peak": "Upper back and buttocks on the pad (0.5 / 0.06 cm), back of the head 1.93 cm over the low seat",
        "norm": "Slight decline, head lower than the hips (clinical opinion); decline pressing angles shift work toward the lower chest (Rodríguez-Ridao 2020 compared inclines from 0 to 60 degrees)",
        "sources": [
          "rodriguez2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈20° (soft, fixed)",
        "peak": "≈20° at the bottom; 20-20.1° through the loop",
        "norm": "Fixed soft bend of about 20-30 degrees, as in the dumbbell fly protocol of Solstad 2020",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Arm opening",
        "setup": "Upper arm ≈20° from perpendicular to the trunk (toward the hips), hands 18.7 cm apart over the lower chest, -10.4 cm from the shoulders",
        "peak": "≈94° at the bottom (≈4° below the back plane, 18° toward the hips)",
        "norm": "From over the lower chest to about level with the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral, palms facing each other",
        "peak": "Palms up at the bottom",
        "norm": "Neutral: palms facing each other at the top, the ceiling at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Low pulleys 12 cm high beside the chest, 190 cm apart",
        "peak": "Both cables clear of the body by at least 9.79 cm",
        "norm": "One cable per hand from its own low pulley beside the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈90°, feet 44 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor (or hooked under the leg rollers of a decline bench) (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Squeeze 0.6 s over the chest",
        "peak": "2.2 s down, 0.4 s stretch, 1.5 s up",
        "norm": "Controlled, about 2 s down and 1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Decline Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/11183-cable-decline-fly.html"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      },
      {
        "id": "rodriguez2020",
        "title": "Rodríguez-Ridao, Antequera-Vique, Martín-Fuentes and Muyor 2020, effect of five bench inclinations on the electromyographic activity of the pectoralis major, anterior deltoid and triceps brachii during the bench press exercise (Int J Environ Res Public Health 17(19):7339; PMC7579505)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7579505/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Head-down positions raise pressure in the head and eyes: avoid them with uncontrolled high blood pressure, glaucoma or recent eye surgery, and sit up slowly at the end of the set (clinical opinion).",
        "The cable load is user-chosen: pick a weight you can control without the elbows bending more.",
        "Take the handles before lying back (or have a partner pass them) and bring the hands together over the chest before letting go.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorten the arc so the upper arms stop above the bench line.",
        "Dizziness or head pressure: use a flat bench (cable fly on a flat bench)."
      ],
      "regressions": [
        "Flat-bench cable fly.",
        "Lighter stacks.",
        "Dumbbell fly on a flat bench."
      ],
      "progressions": [
        "Slower lowering with a 1 s pause in the stretch.",
        "Heavier stacks."
      ]
    },
    "muscleNotes": {
      "pec_r": "Prime mover: draws the arm across the body (horizontal adduction); with the body declined the arms work closer to the line of the lower (sternal) fibres (clinical opinion). Flyes and the bench press activated the pectoralis similarly in trained men (Solstad 2020).",
      "pec_l": "Prime mover: draws the arm across the body (horizontal adduction); with the body declined the arms work closer to the line of the lower (sternal) fibres (clinical opinion). Flyes and the bench press activated the pectoralis similarly in trained men (Solstad 2020).",
      "ant_deltoid_r": "Assists the horizontal adduction.",
      "ant_deltoid_l": "Assists the horizontal adduction.",
      "biceps_r": "Holds the soft elbow bend against the cable.",
      "biceps_l": "Holds the soft elbow bend against the cable.",
      "serratus_r": "Steadies the shoulder blade on the ribcage.",
      "serratus_l": "Steadies the shoulder blade on the ribcage.",
      "triceps_r": "Keeps the elbow from bending further.",
      "triceps_l": "Keeps the elbow from bending further.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "infraspinatus_r": "Centres the head of the humerus in the stretch.",
      "infraspinatus_l": "Centres the head of the humerus in the stretch.",
      "core": "Keeps the trunk and pelvis still on the decline."
    }
  },
