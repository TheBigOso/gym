  },
  "exercise": {
    "id": "lying-alternate-toe-touch-floor",
    "name": "Lying Alternate Toe Touch Floor",
    "aliases": [
      "Alternating toe touch (lying)",
      "Single-leg V-up, alternating",
      "Opposite hand to foot crunch",
      "Alternating toe reach"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11780",
      "title": "Lying Alternate Toe Touch Floor",
      "url": "https://gymvisual.com/videos/11780-lying-alternate-toe-touch-floor.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Obliques",
      "Hip flexors"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk flexion and rotation with hip flexion)",
    "plane": "Multiplanar",
    "laterality": "Alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you lift and reach; inhale as you lower.",
      "cadence": "About 3 s per touch"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per side",
      "tempo": "1 s up, short squeeze, 1 s down",
      "frequency": "2-3 times a week",
      "progression": "Reach higher up the leg, then add a pause, then full V-ups"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, legs long, arms overhead on the mat."
      },
      {
        "id": "c2",
        "phase": "reach",
        "text": "Lift the straight right leg as you curl the shoulders up and reach the left hand toward the right foot."
      },
      {
        "id": "c3",
        "phase": "reach",
        "text": "Turn the shoulder toward the leg; touch the shin or the toes, wherever you reach with control."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the leg and the trunk back to the mat with control."
      },
      {
        "id": "c5",
        "phase": "reach",
        "text": "Repeat with the left leg and the right hand."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Yanking with the arm and neck",
        "fix": "Lead with the chest and the shoulder; the arm just follows."
      },
      {
        "id": "m2",
        "mistake": "Bending the lifted knee to reach the foot",
        "fix": "Keep the leg straight and touch the shin if the foot is out of reach."
      },
      {
        "id": "m3",
        "mistake": "Dropping back to the mat",
        "fix": "Lower under control."
      },
      {
        "id": "m4",
        "mistake": "The resting leg lifting",
        "fix": "Press the resting heel into the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk curl",
        "setup": "Lying (upper trunk ≈-1°)",
        "peak": "Upper trunk ≈33° from the floor; shoulder blades 9 cm off the mat",
        "norm": "Shoulder blades off the mat with a turn toward the lifted leg (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk rotation",
        "setup": "0°",
        "peak": "≈21° toward the lifted leg (thoracic and lumbar segments)",
        "norm": "Opposite shoulder turns toward the leg (Crommert 2021: twisting curl-up)",
        "sources": [
          "crommert2021"
        ]
      },
      {
        "measure": "Lifted leg",
        "setup": "On the mat",
        "peak": "Hip ≈79°, knee straight",
        "norm": "Straight leg raised toward vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hand reach",
        "setup": "Overhead on the mat",
        "peak": "Hand to the shin, 40% of the way from the knee to the ankle (gap 3.5 cm)",
        "norm": "Hand reaches the shin or the foot (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.6 s",
        "peak": "1 s up, 0.4 s squeeze, 1 s down, 0.4 s rest; then the other side",
        "norm": "About 1 s up and 1 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11780, Lying Alternate Toe Touch Floor, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/11780-lying-alternate-toe-touch-floor.html"
      },
      {
        "id": "crommert2021",
        "title": "Crommert, Bjerkefors, Tarassova and Ekblom 2021, abdominal muscle activation during common modifications of the trunk curl-up exercise (J Strength Cond Res 35(2):428-435; PMID 29319600)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29319600/"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises: implications for rehabilitation and training (Phys Ther 86(5):656-671; PubMed 16649890)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/16649890/"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Repeated loaded spinal flexion is a concern for some backs (Axler and McGill 1997 on spine loads in sit-ups and curl-ups); keep the curl moderate."
      ],
      "modify": [
        "Knee of the resting leg bent, foot flat.",
        "Reach to the knee instead of the foot.",
        "Pregnancy, postpartum or diastasis recti: get cleared first, and avoid long supine work later in pregnancy."
      ],
      "regressions": [
        "Bend the lifted knee a little.",
        "Crunch with a reach to the knee."
      ],
      "progressions": [
        "Reach to the toes.",
        "Pause at the top.",
        "V-ups."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the head and shoulder blades off the mat for each reach; curl-ups with a twist keep rectus abdominis busy while adding oblique work (Crommert 2021; Escamilla 2006).",
      "obliques_r": "The right external oblique with the left internal oblique turn the left shoulder toward the right foot; the other side takes over on the next rep (Crommert 2021: twisting curl-ups raise oblique activity).",
      "obliques_l": "The left external oblique with the right internal oblique turn the right shoulder toward the left foot (Crommert 2021).",
      "hip_flexors_r": "Lift the straight right leg toward vertical (clinical opinion; Andersson 1997 on hip flexor work in leg raises).",
      "hip_flexors_l": "Lift the straight left leg toward vertical (clinical opinion; Andersson 1997).",
      "quads_r": "Keep the knees straight and the legs long (clinical opinion).",
      "quads_l": "Keep the knees straight and the legs long (clinical opinion).",
      "ant_deltoid_r": "Reaches the arm up toward the foot (clinical opinion).",
      "ant_deltoid_l": "Reaches the arm up toward the foot (clinical opinion).",
      "hamstrings_r": "The back of the lifted leg lengthens as the straight leg rises (clinical opinion).",
      "hamstrings_l": "The back of the lifted leg lengthens as the straight leg rises (clinical opinion)."
    }
  },
