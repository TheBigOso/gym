    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (adductors)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip extension with the hips abducted and externally rotated)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "glute_med_r",
        "glute_med_l",
        "hamstrings_r",
        "hamstrings_l"
      ],
      "stabilizer": [
        "adductors_r",
        "adductors_l",
        "core",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you drive the hips up, inhale as you lower.",
      "cadence": "About 1.2 s up, 0.8 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "15-25",
      "tempo": "1-1-2-0",
      "frequency": "2-4 times a week",
      "progression": "Longer squeeze, then a dumbbell or plate on the hips"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Shoulder blades on the bench edge, arms along the bench. Soles together close to the hips, knees wide."
      },
      {
        "id": "c2",
        "phase": "drive",
        "text": "Breathe out, press the outer edges of the feet down and drive the hips up."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Hips up to about level with the shoulders, pelvis tucked, knees open, chin tucked. Squeeze the glutes."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the hips under control, knees staying wide."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay on the bench and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back at the top",
        "fix": "Stop when the trunk is level; ribs down, chin tucked."
      },
      {
        "id": "m2",
        "mistake": "Knees closing as the hips rise",
        "fix": "Keep the thighs open and the soles pressed together."
      },
      {
        "id": "m3",
        "mistake": "Feet too far from the hips",
        "fix": "Heels close to the buttocks; the feet rest on their outer edges."
      },
      {
        "id": "m4",
        "mistake": "Back sliding on the bench",
        "fix": "Pivot on the shoulder blades; the bench edge stays under the same spot."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench height",
        "setup": "45 cm bench across the upper back",
        "peak": "Upper back pivots on the bench edge",
        "norm": "Knee-height bench, about 40-45 cm (common setup; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈82° at the bottom",
        "peak": "≈-9° (pelvis tucked; shoulder-to-hip line about 10° short of level, inside the rig's hip extension and rotation limits)",
        "norm": "Hips reach neutral at the top, trunk level (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip abduction and external rotation",
        "setup": "Thighs ≈38° out from the pelvis midline (channels abd 37.7°, rot -44.3°)",
        "peak": "≈31° out (abd 30.4°, rot -41.6°); soles together, feet on their outer edges",
        "norm": "Thighs open and turned out, soles together (defines the frog position; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈102°",
        "peak": "≈93°",
        "norm": "Deeply bent with the heels near the hips; more knee bend shifts work from the hamstrings to the glutes in bridges (Lehecka 2017)",
        "sources": [
          "lehecka2017"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈61° (hips below the shoulders)",
        "peak": "Shoulder-to-hip line ≈-10° from level (+ = hips higher), pelvis tucked 6°",
        "norm": "About level at the top with the pelvis tucked; the trunk pivots on the shoulder blades (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hips down 0.8 s",
        "peak": "1.2 s up, 0.8 s squeeze, 2.0 s down, 1.2 s reset",
        "norm": "About 1 s up, a short squeeze, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #646412, Bodyweight Frog Hip Thrust (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/16205-bodyweight-frog-hip-thrust-male.html"
      },
      {
        "id": "contreras2015",
        "title": "Contreras, Vigotsky, Schoenfeld, Beardsley & Cronin 2015, a comparison of gluteus maximus, biceps femoris and vastus lateralis EMG in the back squat and barbell hip thrust (J Appl Biomech 31(6):452-458)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26214739/"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      },
      {
        "id": "lehecka2017",
        "title": "Lehecka et al. 2017, building a better gluteal bridge: EMG of hip muscles during modified single-leg bridges (Int J Sports Phys Ther 12(4):543-549; PMC5534144)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5534144/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Set the bench against a wall so it cannot slide."
      ],
      "modify": [
        "Groin or hip discomfort: narrower knees, feet a little apart.",
        "Low back discomfort: lift less high and brace first."
      ],
      "regressions": [
        "Frog glute bridge on the floor.",
        "Two-leg hip thrust with feet flat."
      ],
      "progressions": [
        "Longer squeeze at the top.",
        "Dumbbell or plate on the hips.",
        "Banded frog thrust."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Hip extensor and external rotator: the frog position keeps the hips turned out through the whole thrust. The barbell hip thrust gave about twice the mean gluteus maximus activity of the back squat (Contreras 2015); no EMG study of the frog version was found, so the turned-out bias is clinical opinion.",
      "glute_max_l": "Hip extensor and external rotator: the frog position keeps the hips turned out through the whole thrust. The barbell hip thrust gave about twice the mean gluteus maximus activity of the back squat (Contreras 2015); no EMG study of the frog version was found, so the turned-out bias is clinical opinion.",
      "glute_med_r": "Helps hold the thighs open (abduction and external rotation; clinical opinion).",
      "glute_med_l": "Helps hold the thighs open (abduction and external rotation; clinical opinion).",
      "hamstrings_r": "Assist hip extension; the soles-together position with deeply bent knees shortens them, so they help less than in a feet-flat thrust (clinical opinion based on Lehecka 2017, where more knee bend lowered hamstring activity in bridges).",
      "hamstrings_l": "Assist hip extension; the soles-together position with deeply bent knees shortens them, so they help less than in a feet-flat thrust (clinical opinion based on Lehecka 2017, where more knee bend lowered hamstring activity in bridges).",
      "adductors_r": "Lengthened on the open thighs; they steady the knees (clinical opinion).",
      "adductors_l": "Lengthened on the open thighs; they steady the knees (clinical opinion).",
      "core": "Ribs down so the hips, not the low back, lift the pelvis.",
      "quads_r": "Little knee work in this position (clinical opinion).",
      "quads_l": "Little knee work in this position (clinical opinion)."
    }
  },
