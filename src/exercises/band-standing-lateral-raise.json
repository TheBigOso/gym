        "forearm_extensors_r",
        "forearm_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 0-3 reps short of failure (RIR 0-3)",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen; the band is hardest at the top, where it is stretched most",
      "progression": "More reps, a slower lowering, a stronger band, or the feet wider on the band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the middle of the band, feet hip width; hold one end in each hand beside the thighs, palms in, elbows slightly bent."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the arms out to the sides, a little in front of the body, leading with the elbows."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at about shoulder height, thumbs forward, shoulders down away from the ears; the band is tightest here."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s against the band; do not let it pull the arms down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause beside the thighs with a little tension left in the band, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging up with the hips and back",
        "fix": "Stand still, brace the trunk and use a lighter band."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders toward the ears as the band gets tight",
        "fix": "Keep the shoulders down; raise only to about shoulder height."
      },
      {
        "id": "m3",
        "mistake": "Turning the thumbs up and raising in front (a front raise)",
        "fix": "Keep the thumbs forward and the arms out to the sides, just in front of the body."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the arms down",
        "fix": "Control the lowering, about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction (peak)",
        "setup": "≈10° (hands just outside the thighs)",
        "peak": "≈88° (elbow 1 cm vs the shoulder joint)",
        "norm": "Up to about 90 degrees (Coratella 2020 range)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈32° in front of the frontal plane",
        "peak": "≈34°",
        "norm": "Scapular plane, about 30-40 degrees in front of the frontal plane (40 degrees in Tsuruike 2019); Coratella 2020 tested the frontal plane",
        "sources": [
          "tsuruike2019",
          "coratella2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈18°",
        "norm": "Slight, constant bend; a 90-degree elbow bend lowered medial deltoid activity (Coratella 2020)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Band",
        "setup": "Under the balls of the feet; strand 78.8 cm",
        "peak": "Strand 147.8 cm at the top (most stretch, most tension)",
        "norm": "Elastic tension rises as the band stretches, so the load is highest near the top; at matched effort, elastic tubing and dumbbells gave similar deltoid activity in a lateral raise (Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the sides",
        "peak": "1.8 s up, 0.4 s at the top, 2.0 s down",
        "norm": "About 2 s up, 0.5 s pause, 2 s down (Coratella 2020 used this tempo with dumbbells)",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
