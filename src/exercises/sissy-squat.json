        "obliques_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as you lower, breathe out as you come back up.",
      "cadence": "About 2 s down, short pause, about 1.4 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-12",
      "tempo": "2-1-1-0",
      "frequency": "1-2 times a week",
      "progression": "Deeper range, slower lowering, then hold a light dumbbell or plate at the chest with the free hand."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall on the balls of the feet, feet hip width, left hand resting on a wall beside you."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and drive the knees forward and down while the body leans back in one straight line from knees to shoulders."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Go only as deep as the knees allow comfortably; hips stay straight, heels stay up."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and pull the knees back under you to stand tall."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall on the balls of the feet and reset."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending at the hips (turning it into a squat)",
        "fix": "Squeeze the glutes and keep the hips straight; lean back instead."
      },
      {
        "id": "m2",
        "mistake": "Pulling hard on the support",
        "fix": "Use the hand for balance only."
      },
      {
        "id": "m3",
        "mistake": "Going deeper than the knees tolerate",
        "fix": "Start with a short range and build depth over weeks."
      },
      {
        "id": "m4",
        "mistake": "Heels dropping",
        "fix": "Stay up on the balls of the feet the whole set."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance",
        "setup": "20 cm between ankle centres, heels up 35° on the balls of the feet",
        "peak": "Unchanged",
        "norm": "Feet about hip width, on the balls of the feet (reference movement; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈100°",
        "norm": "About 90 degrees or more at the bottom as tolerated (clinical opinion); Lee 2022 used about 90 degrees for an upright, knee-dominant squat",
        "sources": [
          "lee2022"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈7° (joint channel)",
        "peak": "≈8° (joint channel); thigh-to-trunk line 4° from straight",
        "norm": "Hips stay extended (about 0 degrees or slight extension), unlike a normal squat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈-2° back",
        "peak": "≈36° back from vertical",
        "norm": "Leaning back in line with the thighs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee travel",
        "setup": "knee -3.6 cm from the toes",
        "peak": "knee joint 30.4 cm in front of the toe joint",
        "norm": "Knees travel well in front of the toes; restricting this changes hip and knee demand (Fry 2003)",
        "sources": [
          "fry2003"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.2 s down, 0.4 s pause, 1.4 s up, 1.2 s reset",
        "norm": "About 2 s down, 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #148912, Sissy Squat Bodyweight, video (movement reference)",
        "url": "https://gymvisual.com/videos/11245-sissy-squat-bodyweight.html"
      },
      {
        "id": "lee2022",
        "title": "Lee, Kim, Heo, Park & Chang 2022, differences in the muscle activities of the quadriceps femoris and hamstrings while performing various squat exercises (BMC Sports Sci Med Rehabil 14:12)",
