    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Core",
      "Calves"
    ],
    "equipment": [
      "Wall or sturdy support for one hand"
    ],
    "difficulty": "Advanced",
    "mechanics": "Isolation-like (knee dominant; hips stay extended)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l"
      ],
      "synergist": [
        "calves_r",
