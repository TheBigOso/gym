      },
      {
        "id": "fry2003",
        "title": "Fry, Smith & Schilling 2003, effect of knee position on hip and knee torques during the barbell squat (J Strength Cond Res 17(4):629-633)",
        "url": "https://oasis.library.unlv.edu/kns_fac_articles/69"
      },
      {
        "id": "straub2024",
        "title": "Straub and Powers 2024, a biomechanical review of the squat exercise: implications for clinical practice (Int J Sports Phys Ther)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10987311/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Work in a range you can control; add load only once the bodyweight version is smooth.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Knee-dominant: skip it with current knee pain; build depth gradually."
      ],
      "modify": [
        "Knee discomfort: shorter range.",
        "Balance: hold the support with both hands."
      ],
      "regressions": [
        "Partial-range sissy squat.",
        "Spanish squat with a band behind the knees."
      ],
      "progressions": [
        "Full range.",
        "Slower lowering.",
        "Hold a light plate at the chest."
      ]
    },
    "muscleNotes": {
      "quads_r": "Knee extensors take almost all the load because the hips stay straight and the knees travel far forward. In a squat that kept the trunk and shins upright with the knee at about 90 degrees (Spanish squat), rectus femoris activity was much higher than in a general or wall squat (Lee 2022). Letting the knees travel forward shifts the demand toward the knee (Fry 2003 studied restricted vs unrestricted knee travel).",
      "quads_l": "Knee extensors take almost all the load because the hips stay straight and the knees travel far forward. In a squat that kept the trunk and shins upright with the knee at about 90 degrees (Spanish squat), rectus femoris activity was much higher than in a general or wall squat (Lee 2022). Letting the knees travel forward shifts the demand toward the knee (Fry 2003 studied restricted vs unrestricted knee travel).",
      "calves_r": "Hold the heels up and steady the ankles on the balls of the feet (clinical opinion).",
      "calves_l": "Hold the heels up and steady the ankles on the balls of the feet (clinical opinion).",
      "hip_flexors_r": "Rectus femoris crosses the hip and works hard with the hip held extended (clinical opinion).",
      "hip_flexors_l": "Rectus femoris crosses the hip and works hard with the hip held extended (clinical opinion).",
      "core": "Keeps a straight line from the knees to the shoulders as the body leans back (clinical opinion).",
      "glute_max_r": "Holds the hips extended so the body does not fold at the hips (clinical opinion).",
      "glute_max_l": "Holds the hips extended so the body does not fold at the hips (clinical opinion).",
      "spinal_extensors_r": "Keep the trunk long while leaning back (clinical opinion).",
      "spinal_extensors_l": "Keep the trunk long while leaning back (clinical opinion).",
      "obliques_r": "Steady the trunk against the one-hand support (clinical opinion).",
      "obliques_l": "Steady the trunk against the one-hand support (clinical opinion).",
      "forearm_flexors_r": "The hand on the wall only balances; it does not pull (clinical opinion).",
      "forearm_flexors_l": "The hand on the wall only balances; it does not pull (clinical opinion)."
    }
  },
