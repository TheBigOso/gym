        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the rope comes back behind the head, breathe out as you extend the arms.",
      "cadence": "About 2 s back, short pause, about 1.4 s extending"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2.2-0.3-1.4-0.5 (back-pause-extend-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can extend with the upper arms still and the trunk braced.",
      "progression": "Add reps, then one plate on the stack; slower return"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel tall facing away from a high pulley, knees hip width, and lean forward about 25 degrees from the knees; hold the rope ends overhead, palms facing, upper arms beside the head and pointing forward and up, elbows about shoulder width."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows, letting the rope draw the hands back behind the head."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop with the hands behind the head and a stretch in the back of the arms; upper arms still."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbows, driving the hands forward and up in line with the upper arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the arms long, ribs down, glutes tight."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows drifting forward and down (turning it into a pullover)",
        "fix": "Fix the upper arms beside the head and move only the forearms."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring wide",
        "fix": "Keep the elbows about shoulder width."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back or sitting back on the heels",
        "fix": "Brace the trunk, squeeze the glutes and keep the forward lean from the knees."
      },
      {
        "id": "m4",
        "mistake": "Rushing the return",
        "fix": "Control the stack back behind the head."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈10° (arms long, not locked)",
        "peak": "≈115° with the hands behind the head",
        "norm": "Straight but not locked in front; bend until the hands are behind the head, about 100-120 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation (upper arm)",
        "setup": "Upper arm ≈155° from the trunk line, ≈45° forward of vertical",
        "peak": "Unchanged (elbows move 0.00 cm over the loop)",
        "norm": "Upper arm overhead beside the head and still: the long head works lengthened, which gave more triceps growth than training with the arm at the side (PubMed 35819335)",
        "sources": [
          "overhead2022"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Neutral, hands 36.4 cm apart on the rope ends",
        "peak": "Unchanged (36.36-36.46 cm)",
        "norm": "Neutral on the rope ends, palms facing (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "High pulley 190 cm high, 70 cm behind the hips",
        "peak": "Cable clear by at least 13.56 cm, rope strands by 11.25 cm (knot behind the head)",
        "norm": "High pulley behind the athlete; the rope knot stays behind the head (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Tall kneeling, ≈20° forward of vertical (hips flexed ≈21°), knees 20.8 cm apart",
        "peak": "Unchanged",
        "norm": "Tall kneeling with a forward lean from the knees, braced and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s with the arms extended",
        "peak": "2.2 s back, 0.3 s pause, 1.4 s extending, 0.5 s pause",
        "norm": "Controlled, about 2 s back and 1-1.5 s extending (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Kneeling Triceps Extension, video (movement reference)",
        "url": "https://gymvisual.com/videos/5014-cable-kneeling-triceps-extension.html"
      },
      {
        "id": "kholinne2018",
        "title": "The different role of each head of the triceps brachii muscle in elbow extension (Acta Orthop Traumatol Turc 2018;52(3):201-205; PubMed 29503079; EMG plus OpenSim at 0-180 degrees of shoulder elevation)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29503079/"
      },
      {
        "id": "overhead2022",
        "title": "Triceps brachii hypertrophy is substantially greater after elbow extension training performed in the overhead versus neutral arm position (Eur J Sport Sci 2022, DOI 10.1080/17461391.2022.2100279; PubMed 35819335; 21 adults, 12 weeks, cable)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/35819335/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain in the elbow or shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can control behind the head without the elbows flaring.",
        "Kneel on a mat or pad to protect the knees.",
        "Take the rope from the pulley before kneeling (or have the pulley low enough to reach), and stand up only after the hands are back in front.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: keep the upper arms lower (less overhead) and shorten the range behind the head.",
        "Knee discomfort: do the standing version with a staggered stance."
      ],
      "regressions": [
        "Lighter load.",
        "Cable pushdown.",
        "Seated dumbbell overhead triceps extension."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Single-arm overhead cable extension.",
        "Heavier stack."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Prime mover: straightens the elbow with the arm overhead, where the long head is lengthened; overhead extensions gave more triceps growth than pushdowns in a 12-week study (PubMed 35819335).",
      "triceps_l": "Prime mover: straightens the elbow with the arm overhead, where the long head is lengthened; overhead extensions gave more triceps growth than pushdowns in a 12-week study (PubMed 35819335).",
      "lats_r": "Lengthened with the arm overhead; resist the cable pulling the upper arm back.",
      "lats_l": "Lengthened with the arm overhead; resist the cable pulling the upper arm back.",
      "ant_deltoid_r": "Holds the upper arm up and forward.",
      "ant_deltoid_l": "Holds the upper arm up and forward.",
      "serratus_r": "Holds the shoulder blade rotated up under the raised arm.",
      "serratus_l": "Holds the shoulder blade rotated up under the raised arm.",
      "forearm_flexors_r": "Grip the rope.",
      "forearm_flexors_l": "Grip the rope.",
      "core": "Braces the forward-leaning trunk against the cable.",
      "glute_max_r": "Keeps the hips extended in tall kneeling.",
      "glute_max_l": "Keeps the hips extended in tall kneeling."
    }
