    "breathing": {
      "pattern": "Breathe in as the handle comes back, breathe out as you press.",
      "cadence": "About 2 s back, short pause, about 1.3 s press"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15 each side",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "tempo": "2-0.3-1.3-0.5 (back-pause-press-pause, seconds)",
      "load": "Plate load is user-chosen: start with light plates on the horns and press with the back on the pad.",
      "progression": "Add reps, then a small plate; slower return"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with the back on the pad and both feet flat; right hand on the right handle, left hand resting on the left thigh; arm extended, palm down."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the handle come back beside the chest on its arc, elbow about 45-60 degrees from the trunk."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with the hand beside the chest; keep both shoulders on the pad and the hips square."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the handle forward until the arm is long; do not let the trunk twist toward the handle."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the chest with the arm long; switch sides after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Trunk twisting toward the working side",
        "fix": "Keep both shoulder blades on the pad; lighten the load."
      },
      {
        "id": "m2",
        "mistake": "Elbow flaring straight out",
        "fix": "Keep the elbow about 45-60 degrees from the trunk."
      },
      {
        "id": "m3",
        "mistake": "Shoulder rolling forward at the end",
        "fix": "Stop with the arm long and the shoulder blade on the pad."
      },
      {
        "id": "m4",
        "mistake": "Rushing the return",
        "fix": "Take about 2 s to bring the handle back."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈42° with the arms extended",
        "peak": "≈134° with the hand beside the chest",
        "norm": "From well bent with the hands beside the chest to nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare",
        "setup": "–",
        "peak": "≈50° from the trunk",
        "norm": "About 45-60 degrees from the trunk at the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Right palm down on the handle; left hand on the left thigh",
        "peak": "Unchanged",
        "norm": "Pronated: palm down on a horizontal handle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lever",
        "setup": "Pivot 175.3 cm high, 31.1 cm ahead of the shoulders",
        "peak": "Lever swings 19.2°; hands within 24.76 cm of the arc",
        "norm": "The right handle rides its own lever arc; only the working lever is shown (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Back on the 10° pad",
        "peak": "Unchanged",
        "norm": "Back on the pad, little trunk work compared with free-weight or standing presses (Saeterbakken and Fimland 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Anti-rotation",
        "setup": "Both shoulder blades on the pad",
        "peak": "Trunk square, hips level",
        "norm": "Unilateral pressing asks more of the trunk muscles than bilateral pressing (Saeterbakken and Fimland 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s at the start",
        "peak": "2 s back, 0.3 s pause, 1.3 s press",
        "norm": "Controlled, about 2 s back and 1-1.5 s press (clinical opinion)",
        "sources": []
      }
