  "exercise": {
    "id": "band-twist-up-down",
    "name": "Band Twist (Up-Down)",
    "aliases": [
      "Band wood chop (high to low)",
      "Band high-to-low chop",
      "Band downward twist"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9028",
      "title": "Band twist (up-down)",
      "url": "https://gymvisual.com/videos/9028-band-twist-up-down.html",
      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read; the movement follows the exercise name and standard coaching: a high-to-low chop)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Abdominals",
      "Shoulders",
      "Hips"
    ],
    "equipment": [
      "Resistance band",
      "Squat rack upright (band anchor)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk rotation with a diagonal arm pull)",
    "plane": "Multiplanar",
    "laterality": "Unilateral (band pulls from one side)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l",
        "core"
      ],
      "synergist": [
        "lats_r",
        "lats_l",
        "triceps_r",
        "triceps_l",
        "glute_med_r",
        "glute_med_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull the band down and across, breathe in as the arms return up to the anchor.",
      "cadence": "About 1 s down, 1.5 s back up"
    },
    "prescription": {
      "sets": "2-3 per side",
      "reps": "8-12 per side",
      "effort": "Stop 2-3 reps short of losing control of the return (clinical opinion)",
      "tempo": "1-0.3-1.5-0.5 (down-pause-up-pause, seconds)",
      "rest": "45-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: step farther from the anchor for more tension",
      "progression": "Stronger band, slower return, half-kneeling version for more trunk control"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand side-on to the anchor, band tied high on the upright. Feet a little wider than the hips, knees soft. Turn toward the anchor and reach up to it with both hands on the handle, arms long."
      },
      {
        "id": "c2",
        "phase": "chop",
        "text": "Breathe out and pull the band down and across the body to the outside of the far hip, turning the ribs and hips together, arms long."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Brief pause low; chest up, knees soft, feet planted."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Let the arms rise back up to the anchor slowly, turning back as one piece."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Reach tall toward the anchor, then chop again. Turn around to train the other side."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling with the arms only",
        "fix": "Turn the ribs and hips together; the arms stay long and guide the band."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back at the bottom",
        "fix": "Soften the knees and hips a little; chest stays up."
      },
      {
        "id": "m3",
        "mistake": "Letting the band yank the arms back up",
        "fix": "Control the return; take 1-2 s."
      },
      {
        "id": "m4",
        "mistake": "Feet spinning or sliding",
        "fix": "Keep both feet planted; the hips turn over them."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk rotation",
        "setup": "Turned ≈62° toward the anchor (pelvis ≈24°, spine ≈38°)",
        "peak": "Turned ≈54° away (pelvis ≈18°, spine ≈36°)",
        "norm": "Ribs and hips turn together from facing the anchor to facing away; mostly thoracic and hip rotation (clinical opinion; end-range twisting under flexion is the concern, Marshall and McGill 2010)",
        "sources": [
          "marshall2010"
        ]
      },
      {
        "measure": "Hand path",
        "setup": "Hands up by the anchor at 162 cm, band tied 198 cm high, 72 cm to the side",
        "peak": "Outside the left hip at 89 cm, 24 cm left of the midline",
        "norm": "Diagonal from above the near shoulder to outside the far hip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈7°",
        "peak": "≈17°",
        "norm": "Soft knees, a little more bend low (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈103°",
        "peak": "≈0°",
        "norm": "Arms long, elbows soft (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Reach 0.6 s",
        "peak": "1 s down, 0.3 s pause, 1.5 s up, 0.5 s reach",
        "norm": "Controlled pull, slower return (clinical opinion)",
        "sources": []
      }
    ],
