    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Check the band and the anchor before each set: a band that slips or snaps can hit you, and it passes near the face at the top.",
        "Keep the range comfortable and turn the hips with the ribs; avoid a forceful end-range twist with a rounded back (Marshall and McGill 2010).",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low back discomfort: smaller turn, more knee bend, or a half-kneeling chop.",
        "Shoulder discomfort: start lower on the upright (chest height)."
      ],
      "regressions": [
        "Lighter band or stand closer to the anchor.",
        "Half-kneeling chop.",
        "Pallof press (anti-rotation hold)."
      ],
      "progressions": [
        "Stronger band.",
        "Slower return.",
        "Narrower stance."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Turn the trunk down and across against the band (oblique pair across the trunk). In elastic-band torso twists the external oblique reached about 54-77% MVC (Scientifica 2015).",
      "obliques_l": "Turn the trunk down and across against the band (Scientifica 2015).",
      "core": "Rectus abdominis helps pull the ribs down toward the far hip; transversus braces (clinical opinion).",
      "lats_r": "Pull the long arms down from overhead (clinical opinion).",
      "lats_l": "Pull the long arms down from overhead (clinical opinion).",
      "triceps_r": "Keep the elbows long; the long head helps pull the arm down (clinical opinion).",
      "triceps_l": "Keep the elbows long; the long head helps pull the arm down (clinical opinion).",
      "glute_med_r": "Turn and steady the pelvis over the planted feet (clinical opinion).",
      "glute_med_l": "Turn and steady the pelvis over the planted feet (clinical opinion).",
      "spinal_extensors_r": "Keep the chest up as the hands go low (erector spinae about 32-50% MVC in torso twists, Scientifica 2015).",
      "spinal_extensors_l": "Keep the chest up as the hands go low (Scientifica 2015).",
      "glute_max_r": "Steady the hips (clinical opinion).",
      "glute_max_l": "Steady the hips (clinical opinion).",
      "quads_r": "Hold the soft knee bend (clinical opinion).",
      "quads_l": "Hold the soft knee bend (clinical opinion).",
      "post_deltoid_r": "Help the arm sweep down and across (clinical opinion).",
      "post_deltoid_l": "Help the arm sweep down and across (clinical opinion)."
    }
