    "id": "cable-reverse-preacher-curl",
    "name": "Cable Reverse Preacher Curl",
    "aliases": [
      "Overhand cable preacher curl",
      "Reverse-grip cable scott curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "014619",
      "title": "Cable Reverse Preacher Curl",
      "url": "https://gymvisual.com/videos/14619-cable-reverse-preacher-curl.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper arms (biceps)",
    "secondaryBodyParts": [
      "Forearms"
    ],
    "equipment": [
      "Preacher bench",
      "Cable machine (low pulley)",
      "Straight bar attachment"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "forearm_extensors_r",
        "forearm_extensors_l",
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "core"
      ],
      "lengthened": [
        "biceps_r",
        "biceps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl, inhale as you lower.",
      "cadence": "About 1.2 s up, a short squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "1 s up, brief squeeze, 2-3 s down",
      "frequency": "2 times a week",
      "progression": "Add load in small steps; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit at the preacher bench facing a low pulley, upper arms flat on the pad; overhand grip on the straight bar about shoulder width."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the bar up with the palms down, elbows on the pad, wrists straight."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze with the forearms about vertical."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the arm is nearly straight; keep the elbow on the pad."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stop just short of locking out; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Wrists dropping into flexion",
        "fix": "Keep the knuckles in line with the forearms."
      },
      {
        "id": "m2",
        "mistake": "Lifting the elbows off the pad",
        "fix": "Keep the upper arms on the pad."
      },
      {
        "id": "m3",
        "mistake": "Too heavy a load",
        "fix": "Use about half your underhand load."
      },
      {
        "id": "m4",
        "mistake": "Letting the bar snap down",
        "fix": "Lower in 2-3 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈21° (arm straight)",
        "peak": "≈134° at the top (range ≈113°)",
        "norm": "Full range from nearly straight arms to about 120-130 degrees; mean elbow range was about 117-123 degrees across standing barbell, EZ-bar and dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "-134.9° (palm forward/up)",
        "peak": "-179.8° (palm forward/up)",
        "norm": "Pronated grip: brachioradialis activity rises and biceps activity falls compared with a supinated grip (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈64°",
        "peak": "≈64° (elbow forward)",
        "norm": "Shoulder flexed with the upper arm on the pad: preacher curls load the elbow flexors at short muscle lengths compared with shoulder-extended curls (Attarieh 2025)",
        "sources": [
          "attarieh2025"
        ]
      },
      {
        "measure": "Upper arm on the pad (rig shapes)",
        "setup": "Pad 45° (top edge 78.3 cm high); elbow 4.8 cm off the pad surface (upper-arm radius)",
        "peak": "Elbow stays on the pad (drift ≤0 cm)",
        "norm": "Upper arm and elbow stay on the pad throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arm nearly straight on the pad 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #014619, Cable Reverse Preacher Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/14619-cable-reverse-preacher-curl.html"
      },
      {
        "id": "attarieh2025",
        "title": "Attarieh, Nunes, Khani, Negahdar, Goli, Nazarirad, Nazarirad, Mojtahedi, Nosaka and Soori 2025, shoulder flexed versus extended elbow-flexion training: preacher versus Bayesian cable curls, regional hypertrophy and strength (Eur J Sport Sci 25(4):e12279; PMC11906226)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11906226/"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow: the bottom of a preacher curl stretches the biceps and the front of the elbow under load; lower slowly and stop short of locking out (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lighter load and a shorter range at the bottom."
      ],
      "regressions": [
        "Lighter weight.",
        "Shorter range: stop the lowering at about 30 degrees of elbow bend."
      ],
      "progressions": [
        "Slower lowering (3-4 s).",
        "Pause just above the bottom."
      ]
    },
    "muscleNotes": {
      "forearm_extensors": "Brachioradialis and the wrist extensors work hard with the palms down (Coratella 2023).",
      "biceps": "Biceps still flex the elbow but less than with an underhand grip (Coratella 2023)."
    }
