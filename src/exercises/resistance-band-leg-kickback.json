{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "resistance-band-leg-kickback",
    "name": "Resistance Band Leg Kickback",
    "aliases": [
      "Mini band standing kickback",
      "Banded straight-leg kickback"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14182",
      "title": "Resistance Band Leg Kickback",
      "url": "https://gymvisual.com/videos/14182-resistance-band-leg-kickback.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus maximus)",
    "secondaryBodyParts": [
      "Hamstrings"
    ],
    "equipment": [
      "Resistance band (mini loop around the ankles)",
      "Wall for balance"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip extension)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r"
      ],
      "synergist": [
        "hamstrings_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "core",
        "calves_l"
      ],
      "lengthened": [
        "hip_flexors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg kicks back, inhale as it returns.",
      "cadence": "About 1.2 s back, 0.5 s squeeze, 1.8 s forward"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Stronger band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Band around both ankles; stand tall, hands lightly on the wall, weight on the left leg."
      },
      {
        "id": "c2",
        "phase": "back",
        "text": "Breathe out and push the straight right leg back against the band."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the glute; ribs stay down."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and bring the leg forward slowly, foot just off the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep tension in the band; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back",
        "fix": "The range is small: stop when the hip is open."
      },
      {
        "id": "m2",
        "mistake": "Leaning far forward",
        "fix": "Stay tall; only a slight tip is fine."
      },
      {
        "id": "m3",
        "mistake": "Bending the knee to kick higher",
        "fix": "Keep the knee long so the glute does the work."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the leg forward",
        "fix": "Control the return."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip extension",
        "setup": "Hip ≈12° flexion",
        "peak": "≈18° extension (channel); leg 26° behind vertical",
        "norm": "About 15-20 degrees past neutral (clinical opinion); hip extension excites the gluteus maximus (Macadam 2019)",
        "sources": [
          "macadam2019"
        ]
      },
      {
        "measure": "Trunk",
        "setup": "Tall",
        "peak": "≈5° forward tip with the pelvis",
        "norm": "Tall, slight forward tip, no lumbar extension (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Around both ankles (25 cm apart)",
        "peak": "Stretched to 43 cm",
        "norm": "Mini loop around both ankles (elastic resistance, Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.2 s back, 0.5 s squeeze, 1.8 s forward",
        "norm": "Controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #14182, Resistance Band Leg Kickback, video (movement reference)",
        "url": "https://gymvisual.com/videos/14182-resistance-band-leg-kickback.html"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjørnlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Andersen+2010+muscle+activation+perceived+loading+dumbbells+elastic+resistance"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the band for nicks before use."
      ],
      "modify": [
        "Low-back discomfort: smaller range."
      ],
      "regressions": [
        "Standing hip extension without a band."
      ],
      "progressions": [
        "Heavier band.",
        "Cable kickback with an ankle strap."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor against the band (Macadam 2019).",
      "hamstrings_r": "Assist hip extension with the knee straight (clinical opinion).",
      "glute_med_l": "Keeps the pelvis level (Boren 2011).",
      "core": "Stops the low back arching (clinical opinion).",
      "calves_l": "Balance on the stance foot (clinical opinion).",
      "hip_flexors_r": "Lengthen as the leg goes back (clinical opinion)."
    }
  },
