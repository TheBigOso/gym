      "title": "Cambered Bar Lying Row",
      "url": "https://gymvisual.com/videos/970-cambered-bar-lying-row.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lats, mid-back)",
    "secondaryBodyParts": [
      "Rear shoulders",
      "Biceps"
    ],
    "equipment": [
      "Cambered row bar",
      "High flat bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "upper_traps_r",
        "upper_traps_l",
        "core"
      ],
      "lengthened": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row the bar up, breathe in as you lower it.",
      "cadence": "About 1.2 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "1-1-2-0",
      "load": "A load you can row to the bench with 1-3 reps in reserve (RIR 1-3, clinical opinion)",
      "frequency": "2 times a week",
      "progression": "Add load in small steps"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down on a high bench, chest at the end of the pad; hold the cambered bar overhand a little wider than the shoulders, arms long, plates off the floor."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and row the bar up; the bend lets the hands come up beside the pad."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the shoulder blades together, elbows past the trunk."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower to long arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Chest stays on the pad; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the chest off the pad",
        "fix": "Keep the chest down; the bench takes the lower back out of it."
      },
      {
        "id": "m2",
        "mistake": "Jerking the bar",
        "fix": "Pull smoothly from long arms."
      },
      {
        "id": "m3",
        "mistake": "Short reps",
        "fix": "Lower to long arms each time."
      },
      {
        "id": "m4",
        "mistake": "Shrugging",
        "fix": "Draw the shoulder blades back and down."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench",
        "setup": "Prone on a 98 cm bench, chest on the pad, chin past the front end",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "Chest supported on a high bench: lower-back load is small compared with bent-over rows (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈21° (arms long)",
        "peak": "≈116° at the top, elbows above the back",
        "norm": "From nearly straight to about 90-110 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar path",
        "setup": "Overhand, 58 cm between the grip points; plates 33.1 cm or more off the floor",
        "peak": "Hands up to the pad; the 18 cm camber passes under it (at least 5 cm clear)",
        "norm": "The cambered middle passes under the pad so the hands rise above its underside (geometry)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s",
        "peak": "1.2 s up, 0.4 s squeeze, 2 s down",
        "norm": "About 1 s up, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #970, Cambered Bar Lying Row, video (movement reference)",
        "url": "https://gymvisual.com/videos/970-cambered-bar-lying-row.html"
      },
      {
        "id": "fenwick2009",
        "title": "Fenwick, Brown & McGill 2009, comparison of different rowing exercises: trunk muscle activation and lumbar spine motion, load and stiffness (J Strength Cond Res 23(2):350-358)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19197209/"
      },
      {
        "id": "lehman2004",
        "title": "Lehman et al. 2004, variations in muscle activation levels during traditional latissimus dorsi weight training exercises (Dynamic Medicine 3:4)",
        "url": "https://link.springer.com/article/10.1186/1476-5918-3-4"
      }
    ],
    "safety": {
      "cautions": [
        "Set the bench high enough that the plates clear the floor with long arms, and step off carefully.",
        "Shoulder pain: shorten the range (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Straight bar or dumbbells on the same bench."
      ],
      "regressions": [
        "Chest-supported dumbbell row."
      ],
      "progressions": [
        "Heavier load.",
        "Pause at the top."
      ]
    },
    "muscleNotes": {
      "lats_r": "Pulls the upper arm down and back toward the trunk.",
      "lats_l": "Pulls the upper arm down and back toward the trunk.",
      "rhomboids_midtrap_r": "Draws the shoulder blade back at the finish.",
      "rhomboids_midtrap_l": "Draws the shoulder blade back at the finish.",
      "post_deltoid_r": "Pulls the upper arm back and out.",
      "post_deltoid_l": "Pulls the upper arm back and out.",
      "biceps_r": "Bends the elbow.",
      "biceps_l": "Bends the elbow.",
      "forearm_flexors_r": "Grip.",
      "forearm_flexors_l": "Grip.",
      "infraspinatus_r": "Turns the upper arm out and steadies the shoulder.",
      "infraspinatus_l": "Turns the upper arm out and steadies the shoulder.",
      "spinal_extensors_r": "Hold the spine long.",
      "spinal_extensors_l": "Hold the spine long.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
      "upper_traps_l": "Steadies the shoulder girdle; should not shrug.",
      "core": "Braces the trunk so the body stays in one line."
    }
