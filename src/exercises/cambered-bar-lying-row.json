    "id": "cambered-bar-lying-row",
    "name": "Cambered Bar Lying Row",
    "aliases": [
      "Cambered bar bench row",
      "Prone cambered bar row",
      "Seal row with cambered bar"
    ],
    "reference": {
      "source": "GymVisual",
