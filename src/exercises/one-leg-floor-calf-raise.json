  "exercise": {
    "id": "one-leg-floor-calf-raise",
    "name": "One Leg Floor Calf Raise",
    "aliases": [
      "Single-leg calf raise",
      "One-leg heel raise",
      "Single-leg standing heel raise (floor)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9005",
      "title": "One Leg Floor Calf Raise",
      "url": "https://gymvisual.com/videos/9005-one-leg-floor-calf-raise.html",
      "listing": "Page could not be read (blocked by the network proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Calves",
    "secondaryBodyParts": [],
    "equipment": [
      "Body weight",
      "Wall (light hand support)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (ankle plantarflexion on one leg)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "calves_r"
      ],
      "synergist": [],
      "stabilizer": [
        "glute_med_r",
        "core",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the heel rises, inhale as it lowers.",
      "cadence": "About 1 s up, 0.8 s pause, 1.8 s down"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "10-25",
      "tempo": "1-1-2-0",
      "frequency": "2-4 times a week",
      "load": "Body weight only; no external load.",
      "progression": "More reps up to about 25 full-height rises, then hold a dumbbell or stand on a step for a deeper range"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the right foot on flat floor, both hands lightly on the wall at chest height, left foot lifted behind."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Breathe out and rise as high as you can onto the ball of the right foot."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the top; stand tall, ankle straight, weight over the big toe."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the heel slowly to the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch down lightly and repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pushing up with the hands",
        "fix": "The hands only steady you; the calf lifts the body."
      },
      {
        "id": "m2",
        "mistake": "Ankle rolling out",
        "fix": "Keep the pressure through the big and second toes."
      },
      {
        "id": "m3",
        "mistake": "Bending the knee to bounce",
        "fix": "Knee straight but soft; slow lowering, pause at the top."
      },
      {
        "id": "m4",
        "mistake": "Half-height reps",
        "fix": "Rise to full height every rep; stop the set when the height drops."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle plantarflexion",
        "setup": "≈-2° (foot flat)",
        "peak": "≈29° (foot 33° heel-up)",
        "norm": "Full range to as high as possible (clinical opinion); the heel-rise test counts only full-height rises (Hébert-Losier 2017)",
        "sources": [
          "heberlosier2017"
        ]
      },
      {
        "measure": "Heel height",
        "setup": "0 cm (heel down)",
        "peak": "≈10.3 cm",
        "norm": "As high as possible each rep (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "Standing knee ≈4°, free knee ≈75°",
        "peak": "Standing knee ≈4°",
        "norm": "Straight but not locked (clinical opinion); knee angle did not change triceps surae fatigue in single-leg heel raises at 0 vs 45 degrees (Hébert-Losier 2012)",
        "sources": [
          "heberlosier2012"
        ]
      },
      {
        "measure": "Support",
        "setup": "Both hands lightly on the wall",
        "peak": "Unchanged; the wall hands stay planted",
        "norm": "Light support with both hands on a wall for balance (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.0 s up, 0.8 s pause, 1.8 s down, 0.6 s reset",
        "norm": "About 1 s up, a short pause, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #9005, One Leg Floor Calf Raise, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/9005-one-leg-floor-calf-raise.html"
      },
      {
        "id": "heberlosier2017",
        "title": "Hébert-Losier, Wessman, Alricsson & Svantesson 2017, updated reliability and normative values for the standing heel-rise test in healthy adults (Physiotherapy; doi 10.1016/j.physio.2017.03.002; PubMed 28886865)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/28886865/"
      },
      {
        "id": "heberlosier2012",
        "title": "Hébert-Losier, Schneiders, García, Sullivan & Simoneau 2012, influence of knee flexion angle and age on triceps surae muscle fatigue during heel raises (J Strength Cond Res 26(11))",
        "url": "https://epublications.marquette.edu/phys_therapy_fac/29"
      },
      {
        "id": "kinoshita2023",
        "title": "Kinoshita, Maeo et al. 2023, triceps surae muscle hypertrophy is greater after standing versus seated calf-raise training (Front Physiol 14:1272106)",
        "url": "https://www.frontiersin.org/articles/10.3389/fphys.2023.1272106/full"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Achilles pain: two-leg raise, smaller range, slower tempo.",
        "Poor balance: stand closer to the wall."
      ],
      "regressions": [
        "Two-leg standing calf raise."
      ],
      "progressions": [
        "Single-leg calf raise holding a dumbbell.",
        "Ball of the foot on a step for a deeper range."
      ]
    },
    "muscleNotes": {
      "calves_r": "Whole triceps surae with the knee straight; one leg lifts the whole body weight. Healthy adults managed a median 24 (men) and 21 (women) single-leg heel rises to fatigue (Hébert-Losier 2017).",
      "glute_med_r": "Keeps the pelvis level on one leg (clinical opinion).",
      "core": "Holds the trunk tall over the standing foot (clinical opinion).",
      "hamstrings_l": "Hold the free knee bent behind (clinical opinion)."
    }
  },
