        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the handles come back to the chest, breathe out as you press.",
      "cadence": "About 2 s back, short pause, about 1.3 s press"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2-0.3-1.3-0.5 (back-pause-press-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Stack load is user-chosen: pick a weight you can press with the back on the pad and the shoulders down.",
      "progression": "Add reps, then one plate on the stack; slower return"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with the back on the pad and the feet flat; set the seat so the handles are level with the middle of the chest; arms extended in front, palms down on the handles."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the handles come back toward the chest on their arc, elbows travelling back and out at about 45-60 degrees."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with the hands beside the chest and a light stretch across the chest; shoulders down and back on the pad."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the handles forward along the lever arc until the arms are long, elbows soft."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the chest with the arms long; keep the shoulder blades on the pad."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Seat too low or too high",
        "fix": "Set the seat so the handles line up with the middle of the chest."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring straight out to the sides",
        "fix": "Keep the elbows about 45-60 degrees from the trunk."
      },
      {
        "id": "m3",
        "mistake": "Back leaving the pad to push",
        "fix": "Keep the back and head on the pad; lighten the stack."
      },
      {
        "id": "m4",
        "mistake": "Shoulders rolling forward at the end",
        "fix": "Stop with the arms long and the shoulder blades still on the pad."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈15° with the arms extended",
        "peak": "≈133° with the hands beside the chest",
        "norm": "From well bent with the hands beside the chest to nearly straight in front (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare",
        "setup": "–",
        "peak": "≈50° from the trunk at the chest",
        "norm": "About 45-60 degrees from the trunk at the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Palms down, handles 50.2 cm apart (fixed by the machine)",
        "peak": "Unchanged",
        "norm": "Pronated: palms down on horizontal handles (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lever",
        "setup": "Pivot 174.3 cm high, 33.8 cm ahead of the shoulders; arm 90 cm",
        "peak": "Lever swings 21.8°; hands within 0.45 cm of the handle arc",
        "norm": "The handles ride on the lever arc about the machine pivot; the hands follow it (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Back on the 10° pad",
        "peak": "Unchanged",
        "norm": "Back on the pad, little trunk work compared with free-weight or standing presses (Saeterbakken and Fimland 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Seat",
        "setup": "Seat 46 cm, knees ≈73°, feet flat",
        "peak": "Unchanged",
        "norm": "Seat set so the handles are at mid-chest height, feet flat, knees about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the arms extended",
        "peak": "2 s back, 0.3 s pause, 1.3 s press",
        "norm": "Controlled, about 2 s back and 1-1.5 s press (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Lever Chest Press, video (movement reference)",
