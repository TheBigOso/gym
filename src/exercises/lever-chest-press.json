      },
      {
        "id": "saeterbakken2011",
        "title": "Saeterbakken, van den Tillaar and Fimland 2011, a comparison of muscle activity and 1-RM strength of three chest-press exercises with different stability requirements (J Sports Sci 29(5):533-538; PubMed 21225489)",
        "url": "https://read.qxmd.com/read/21225489/a-comparison-of-muscle-activity-and-1-rm-strength-of-three-chest-press-exercises-with-different-stability-requirements"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "The stack load is user-chosen: start light and press without the back leaving the pad.",
        "At the end of the set let the handles come back under control before letting go.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorten the range so the hands stop in front of the chest.",
        "Low back discomfort: keep both feet flat and the back on the pad."
      ],
      "regressions": [
        "Lighter stack.",
        "Band chest press.",
        "Push-up on an incline."
      ],
      "progressions": [
        "Heavier stack.",
        "Slower return with a pause at the chest.",
        "Dumbbell bench press (more stabiliser demand)."
      ]
    },
    "muscleNotes": {
      "pec_r": "Prime mover: pushes the arm forward and across. Unstable presses activated the pectoralis about as much as the barbell press in one study (Saeterbakken 2011); the machine needs the least balance.",
      "pec_l": "Prime mover: pushes the arm forward and across. Unstable presses activated the pectoralis about as much as the barbell press in one study (Saeterbakken 2011); the machine needs the least balance.",
      "ant_deltoid_r": "Flexes the shoulder with the chest.",
      "ant_deltoid_l": "Flexes the shoulder with the chest.",
      "triceps_r": "Straightens the elbow.",
      "triceps_l": "Straightens the elbow.",
      "serratus_r": "Moves the shoulder blade forward at the end of the press.",
      "serratus_l": "Moves the shoulder blade forward at the end of the press.",
      "core": "Little demand with the back on the pad (Saeterbakken and Fimland 2012).",
      "forearm_flexors_r": "Grip the handles.",
      "forearm_flexors_l": "Grip the handles.",
      "biceps_r": "Controls the elbow on the return.",
      "biceps_l": "Controls the elbow on the return."
    }
