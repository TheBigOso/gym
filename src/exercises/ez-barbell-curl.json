    "id": "ez-barbell-curl",
    "name": "EZ Barbell Curl",
    "aliases": [
      "EZ-bar curl",
      "EZ curl",
      "Cambered bar curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "1948",
      "title": "EZ Barbell Curl",
      "url": "https://gymvisual.com/animated-gifs/1948-ez-barbell-curl.html",
      "listing": "Animated GIF (title from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper arms (biceps)",
    "secondaryBodyParts": [
      "Forearms"
    ],
    "equipment": [
      "EZ curl bar"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "load": "Load is user-chosen: pick a bar you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion).",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Add reps, then weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width; take an underhand grip on the outer bends of the EZ bar, hands about shoulder width, the bar resting against the thighs."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the bar up, elbows by your sides."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze with the bar at chest height; shoulders down, wrists straight."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, 2-3 s, until the bar touches the thighs."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms long, chest up; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the hips or leaning back to heave the bar",
        "fix": "Lighter bar; stand tall with the glutes and abs braced."
      },
      {
        "id": "m2",
        "mistake": "Elbows drifting forward at the top",
        "fix": "Elbows stay by the sides; stop the curl when they want to move forward."
      },
      {
        "id": "m3",
        "mistake": "Wrists curling back or bending down",
        "fix": "Keep the wrists straight, in line with the forearms."
      },
      {
        "id": "m4",
        "mistake": "Dropping the bar on the way down",
        "fix": "Take 2-3 s to lower to the thighs."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈5° (arm straight)",
        "peak": "≈115° at the top (range ≈110°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "42.5° (semi-supinated)",
        "peak": "18° (palm forward/up)",
        "norm": "The EZ bar's cambers turn the forearms part way from palms-up toward neutral; across barbell, EZ-bar and dumbbell curls biceps activity was similar, with grip mainly shifting the brachioradialis share (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈1°",
        "peak": "≈8° (elbow forward)",
        "norm": "Elbows stay near the sides; a small forward drift at the top is normal (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar clearance",
        "setup": "EZ bar 0.8 cm or more off the body; outer cambers, 44 cm between the grip points, hands turned 22° toward neutral",
        "peak": "Grip width steady within 0.6 cm; nearest the bar comes: quad_r",
        "norm": "The bar starts just off the front of the thighs and stays clear of the body; the hands stay on the outer cambers (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bar on the thighs 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #1948, EZ Barbell Curl, animated GIF (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/1948-ez-barbell-curl.html"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or wrist pain: lighten the bar and shorten the range; stop if pain is sharp (clinical opinion).",
        "The cambers ease the forearm rotation of a straight bar; if the wrists still complain, try the hammer curl (clinical opinion).",
        "Lift the bar from a rack or the floor with a flat back and bent knees, and set it down the same way.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Inner cambers for a closer grip.",
        "Straight barbell if no EZ bar is available."
      ],
      "regressions": [
        "Empty EZ bar.",
        "Dumbbell biceps curl."
      ],
      "progressions": [
        "Slower lowering (3-4 s).",
        "Pause at the top.",
        "Heavier bar for fewer reps."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor; the cambers turn the forearm part way from palms-up, and biceps activity stayed similar to the straight-bar curl (Marcolin 2018).",
      "biceps_l": "Main elbow flexor; the cambers turn the forearm part way from palms-up, and biceps activity stayed similar to the straight-bar curl (Marcolin 2018).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) helps flex the elbow, more so as the grip turns toward neutral (Marcolin 2018).",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) helps flex the elbow, more so as the grip turns toward neutral (Marcolin 2018).",
      "forearm_flexors_r": "Wrist and finger flexors hold the bar and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the bar and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder; keep the elbows by the sides so it does not lift the bar (clinical opinion).",
      "ant_deltoid_l": "Steadies the shoulder; keep the elbows by the sides so it does not lift the bar (clinical opinion).",
      "core": "Keeps the trunk upright, no swing.",
      "upper_traps_r": "Holds the shoulders level; no shrugging.",
      "upper_traps_l": "Holds the shoulders level; no shrugging."
    }
  },
