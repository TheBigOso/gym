    "breathing": {
      "pattern": "Breathe in as the handles come back to the chest, breathe out as you press.",
      "cadence": "About 2 s back, short pause, about 1.3 s press"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2-0.3-1.3-0.5 (back-pause-press-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can press while sitting tall without leaning back.",
      "progression": "Add reps, then one plate on each stack; slower return"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench between two towers, facing away from the pulleys set about shoulder height, feet flat; a D-handle in each hand, arms extended in front of the chest, palms down."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the handles come back to the sides of the chest, elbows travelling back and out at about 45-60 degrees."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with the hands beside the chest and a light stretch across the chest; shoulders down."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the handles forward and slightly together until the arms are long, elbows soft."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the chest with the hands in front; stay tall without leaning back into the cables."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding forward or leaning back off the bench",
        "fix": "Sit tall with the chest up; lighten the stacks if the cables pull you back."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring straight out to the sides",
        "fix": "Keep the elbows about 45-60 degrees from the trunk."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back to push",
        "fix": "Ribs down, glutes tight, move only the arms."
      },
      {
        "id": "m4",
        "mistake": "Shrugging as you press",
        "fix": "Keep the shoulders down and back throughout."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈24° with the arms extended",
        "peak": "≈131° with the hands beside the chest",
        "norm": "From well bent with the hands beside the chest to nearly straight in front (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare",
        "setup": "–",
        "peak": "≈50° from the trunk at the chest",
        "norm": "About 45-60 degrees from the trunk at the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Palms down, hands 20 cm apart in front",
        "peak": "Hands 60.1 cm apart beside the chest",
        "norm": "Pronated: palms down, handles across the body (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Pulleys 102.2 cm high, 40 cm behind the shoulders, 168 cm apart",
        "peak": "Both cables clear of the body by at least 5.86 cm and pass either side of the bench",
        "norm": "One cable per hand from its own pulley behind the athlete at about shoulder height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Sitting tall, no back support",
        "peak": "Unchanged",
        "norm": "Sitting tall, no back support; seated presses need less trunk muscle work than standing ones (Saeterbakken and Fimland 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Seat",
        "setup": "Flat bench 45 cm, knees ≈79°",
        "peak": "Unchanged (buttocks -0.8 cm from the seat top, feet planted)",
        "norm": "Flat bench about knee height, feet flat, knees about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the arms extended",
        "peak": "2 s back, 0.3 s pause, 1.3 s press",
        "norm": "Controlled, about 2 s back and 1-1.5 s press (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Seated Chest Press, video (movement reference)",
