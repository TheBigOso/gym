      },
      {
        "id": "saeterbakken2011",
        "title": "Saeterbakken, van den Tillaar and Fimland 2011, a comparison of muscle activity and 1-RM strength of three chest-press exercises with different stability requirements (J Sports Sci 29(5):533-538; PubMed 21225489)",
        "url": "https://read.qxmd.com/read/21225489/a-comparison-of-muscle-activity-and-1-rm-strength-of-three-chest-press-exercises-with-different-stability-requirements"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can press without being pulled backward.",
        "Sit down with the handles one at a time (or have the stacks set so you can reach them from the bench); at the end of the set bring the hands back to the chest before letting the handles go.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low back discomfort: sit with the back against an upright bench pad and the cables passing beside it.",
        "Shoulder discomfort: shorten the range so the hands stop in front of the chest."
      ],
      "regressions": [
        "Lighter stacks.",
        "Machine chest press.",
        "Band chest press."
      ],
      "progressions": [
        "Standing cable chest press (more trunk demand).",
        "Slower return with a pause at the chest.",
        "Heavier stacks."
      ]
    },
    "muscleNotes": {
      "pec_r": "Prime mover: pushes the arm forward and across. The unstable dumbbell press activated the pectoralis about as much as the barbell press in one study (Saeterbakken 2011); seated, more of the effort goes to the chest and arms than to balance.",
      "pec_l": "Prime mover: pushes the arm forward and across. The unstable dumbbell press activated the pectoralis about as much as the barbell press in one study (Saeterbakken 2011); seated, more of the effort goes to the chest and arms than to balance.",
      "ant_deltoid_r": "Flexes the shoulder with the chest.",
      "ant_deltoid_l": "Flexes the shoulder with the chest.",
      "triceps_r": "Straightens the elbow.",
      "triceps_l": "Straightens the elbow.",
      "serratus_r": "Moves the shoulder blade forward at the end of the press.",
      "serratus_l": "Moves the shoulder blade forward at the end of the press.",
      "core": "Keeps the trunk tall on the bench against the cables pulling backward; less demand than standing (Saeterbakken and Fimland 2012).",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "biceps_r": "Controls the elbow on the return.",
      "biceps_l": "Controls the elbow on the return."
    }
