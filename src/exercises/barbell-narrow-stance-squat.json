    "safety": {
      "cautions": [
        "Squat inside a rack with the safety arms set just below your bottom position, or with a spotter; the rack drawn here shows only the J-hooks.",
        "The narrow stance asks a lot of the ankles and knees: build depth gradually.",
        "Keep the bar on the muscle of the upper back, never on the neck.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Limited ankle mobility: small heel lift, or widen the stance a little.",
        "Knee pain: reduce depth to a pain-free range."
      ],
      "regressions": [
        "Goblet squat with the feet close together.",
        "Bodyweight narrow squat.",
        "Barbell full squat with a normal stance."
      ],
      "progressions": [
        "Heavier bar in small steps.",
        "Pause at the bottom.",
        "Front squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Main movers: a narrow stance with the knees well forward loads the knee extensors heavily (Paoli 2009; McCaw 1999).",
      "quads_l": "Main movers: a narrow stance with the knees well forward loads the knee extensors heavily (Paoli 2009; McCaw 1999).",
      "glute_max_r": "Extends the hip out of the bottom; less adductor and glute share than a wide stance (Paoli 2009).",
      "glute_max_l": "Extends the hip out of the bottom; less adductor and glute share than a wide stance (Paoli 2009).",
      "adductors_r": "Help extend the hip; less active than in wide stances (Paoli 2009; McCaw 1999).",
      "adductors_l": "Help extend the hip; less active than in wide stances (Paoli 2009; McCaw 1999).",
      "hamstrings_r": "Assist hip extension; length changes little.",
      "hamstrings_l": "Assist hip extension; length changes little.",
      "spinal_extensors_r": "Hold the back flat under the bar.",
      "spinal_extensors_l": "Hold the back flat under the bar.",
      "calves_r": "Control the forward travel of the knees over the planted feet.",
      "calves_l": "Control the forward travel of the knees over the planted feet.",
      "core": "Bracing stiffens the trunk under the bar.",
      "obliques_r": "Part of the brace.",
      "obliques_l": "Part of the brace.",
      "glute_med_r": "Keeps the knees tracking over the feet.",
      "glute_med_l": "Keeps the knees tracking over the feet.",
      "upper_traps_r": "The muscle shelf the bar rests on.",
      "upper_traps_l": "The muscle shelf the bar rests on.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together so the upper back forms a tight shelf.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together so the upper back forms a tight shelf.",
      "lats_r": "Pull the bar down into the back and keep the upper back tight.",
      "lats_l": "Pull the bar down into the back and keep the upper back tight.",
      "forearm_flexors_r": "Grip the bar to hold it in place on the back.",
      "forearm_flexors_l": "Grip the bar to hold it in place on the back."
