    "breathing": {
      "pattern": "Big breath in and brace at the top, hold it on the way down and through the bottom, breathe out as you pass the hardest part of the rise or at the top.",
      "cadence": "About 2 s down, a short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-10",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "load": "Lighter than your normal back squat; leave 2-3 reps in reserve.",
      "rest": "2-3 minutes",
      "progression": "Add 2.5 kg when every rep reaches your depth with heels down."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar on the upper traps, hands just outside the shoulders, elbows down, shoulder blades squeezed. Step back from the rack and set the feet about hip width apart, toes pointing nearly straight ahead."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Big breath, brace, then sit straight down: knees travel well forward over the toes, chest stays up, bar stays over the middle of the foot."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Go down until the thighs are about parallel or as deep as you can keep the heels flat and the back flat; no bounce."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive up through the whole foot, chest and hips rising together. Breathe out as you pass the hardest part."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, take a new breath and brace before the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Heels lifting as the knees travel forward",
        "fix": "Stop at the depth your ankles allow with the heels down, or use a small heel lift or lifting shoes."
      },
      {
        "id": "m2",
        "mistake": "Knees caving in toward each other",
        "fix": "Keep the knees in line with the toes; a narrow stance leaves little room, so lighten the load until they track."
      },
      {
        "id": "m3",
        "mistake": "Losing balance backward at the bottom",
        "fix": "Keep the bar over mid-foot and let the knees go forward instead of pushing the hips back."
      },
      {
        "id": "m4",
        "mistake": "Rounding the lower back to get deeper",
        "fix": "Stop just above the depth where the pelvis tucks under."
      },
      {
        "id": "m5",
        "mistake": "Bar resting on the neck",
        "fix": "Squeeze the shoulder blades to build a shelf on the upper traps."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "20 cm between the ankle centres (≈0.5x the rig's 40 cm shoulder width), toes out 8°",
        "peak": "Unchanged (feet planted)",
        "norm": "Narrower than the usual hip-to-shoulder-width stance; narrow stances shifted demand toward the knee and raised quadriceps share relative to the hip and adductors in some studies (Paoli 2009; McCaw 1999), and foot angle is usually small (Lorenzetti 2018)",
        "sources": [
          "paoli2009",
          "mccaw1999",
          "lorenzetti2018"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈3°",
        "peak": "≈110°; hip joints 3.9 cm above the knee joints, knees 6.3 cm past the toe tips, ankle dorsiflexion ≈30° past neutral",
        "norm": "To about thighs parallel; ankle dorsiflexion limits depth more in a narrow stance (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈-7°",
        "peak": "≈122° (joint channel)",
        "norm": "Large hip flexion at depth; stance width changes hip and knee demand (Larsen 2021)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈44° forward of vertical",
        "norm": "Similar to a high-bar squat at the same depth (Larsen 2021)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Bar position",
        "setup": "High bar: on the upper traps just below C7, 80 cm grip (handle centres)",
        "peak": "Bar -3.2 cm from mid-foot at the top, 2.6 cm at the bottom (bar + body centre of mass 2.1 → -1.1 cm)",
        "norm": "High bar on the upper trapezius, combined centre of mass over mid-foot (common coaching; Larsen 2021)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
