  },
  "exercise": {
    "id": "band-assisted-dip",
    "name": "Band Assisted Dip",
    "aliases": [
      "Resistance band assisted dip",
      "Banded dip on parallel bars"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "011222",
      "title": "Band Assisted Dip",
      "url": "https://gymvisual.com/videos/11222-band-assisted-dip.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest and upper arms (triceps, chest, front shoulders)",
    "secondaryBodyParts": [
      "Triceps",
      "Chest",
      "Shoulders"
    ],
    "equipment": [
      "Dip station (parallel bars)",
      "Resistance band"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (elbow extension, shoulder flexion from extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ],
      "lengthened": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale on the way down, exhale as you press up.",
      "cadence": "About 2 s down, a short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-12",
      "tempo": "2 s down, brief pause, 1-1.5 s up",
      "frequency": "2-3 times a week",
      "progression": "Lighter bands as you get stronger, then unassisted dips"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stretch a band across the two bars, step up, kneel the shins on the band with the knees bent, arms straight on the bars."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower by bending the elbows, trunk nearly upright; the band stretches under the shins."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop with the upper arms about parallel."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Press back up, breathing out; the band helps most at the bottom."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked, shoulders down; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bouncing out of the bottom on the band",
        "fix": "Pause at the bottom and press up under control."
      },
      {
        "id": "m2",
        "mistake": "Letting the knees slide off the band",
        "fix": "Keep the shins square on the band, knees together."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulders to the ears",
        "fix": "Keep the shoulders down and back."
      },
      {
        "id": "m4",
        "mistake": "Dropping too deep",
        "fix": "Stop at about parallel upper arms."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈4° (straight, not locked)",
        "peak": "≈98° at the bottom",
        "norm": "Arms straight but not locked at the top; elbow flexion at the bottom of a bar dip was larger than in a bench dip (McKenzie 2022); upper arms about parallel is a common limit (clinical opinion)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Trunk lean",
        "setup": "≈4° forward of vertical",
        "peak": "≈12° at the bottom",
        "norm": "Nearly upright, as in the triceps dip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm angle to the floor",
        "setup": "≈82° (arms straight down to the bars)",
        "peak": "≈0° at the bottom",
        "norm": "Stop with the upper arms about parallel to the floor (clinical opinion); bar dips reached about 95% of the maximal shoulder extension range in the study group (McKenzie 2022)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Body travel",
        "setup": "Shoulders 50 cm above the wrists",
        "peak": "27 cm down; feet stay 69.8 cm or more off the floor",
        "norm": "The body moves down and up between the bars; the feet stay off the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Band strands from the bars to the shins below the knees",
        "peak": "Stretches as the body lowers",
        "norm": "The band runs from bar to bar under the shins and stretches as the body lowers (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #011222, Band Assisted Dip, video (movement reference)",
        "url": "https://gymvisual.com/videos/11222-band-assisted-dip.html"
      },
      {
        "id": "mckenzie2022",
        "title": "McKenzie, Crowley-McHattan, Meir, Whitting and Volschenk 2022, bench, bar, and ring dips: do kinematics and muscle activity differ? (Int J Environ Res Public Health 19(20):13211; PMC9603242)",
        "url": "https://www.mdpi.com/1660-4601/19/20/13211"
      }
    ],
    "safety": {
      "cautions": [
        "Shoulder: dips take the shoulder far into extension under body weight, which loads the front of the shoulder (McKenzie 2022); keep the range to upper arms about parallel and stop if the front of the shoulder hurts.",
        "Check the band for tears and anchor it securely; step off carefully so it does not snap back.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorter range (stop with the elbows at about 60 degrees)."
      ],
      "regressions": [
        "Bench dip with the knees bent.",
        "Negative-only dips."
      ],
      "progressions": [
        "Slower lowering (3 s).",
        "Pause at the bottom."
      ]
    },
    "muscleNotes": {
      "triceps": "Same movement as the bar dip; the band takes part of the body weight, most at the bottom where it is stretched furthest (clinical opinion)."
    }
  },
