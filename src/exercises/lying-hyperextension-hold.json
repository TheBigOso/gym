    "id": "lying-hyperextension-hold",
    "name": "Lying Hyperextension Hold",
    "aliases": [
      "Prone back extension hold",
      "Isometric floor back extension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "015153",
      "title": "Lying Hyperextension Hold",
      "url": "https://gymvisual.com/videos/15153-lying-hyperextension-hold-male.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lower back)",
    "secondaryBodyParts": [
      "Glutes",
      "Upper back"
    ],
    "equipment": [
      "Mat",
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isometric (spinal extension hold)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "stabilizer": [
        "hamstrings_r",
        "hamstrings_l",
        "core",
        "post_deltoid_r",
        "post_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily through the hold.",
      "cadence": "Lift in 1 s, hold about 6 s here (10-20 s in training), lower in 1 s"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "3-5 holds of 10-20 s",
      "tempo": "Lift, hold steadily, lower",
      "frequency": "2-4 times a week",
      "progression": "Longer holds"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down on a mat, legs straight, fingertips behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Lift the head and chest a few centimetres off the mat."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold the position and keep breathing; the neck stays long."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Relax on the mat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Craning the neck up",
        "fix": "Keep the eyes on the mat and the neck long."
      },
      {
        "id": "m2",
        "mistake": "Lifting too high",
        "fix": "Lift only a few centimetres; no forced arching."
      },
      {
        "id": "m3",
        "mistake": "Lifting the legs too (turns it into a superman)",
        "fix": "Keep the legs and hips on the mat."
      },
      {
        "id": "m4",
        "mistake": "Holding the breath",
        "fix": "Breathe steadily."
      }
    ],
    "kinematics": [
      {
        "measure": "Chest lift",
        "setup": "Chest on the mat",
        "peak": "5 cm off the mat",
        "norm": "Chest a few centimetres off the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Spine extension",
        "setup": "0° added",
        "peak": "≈26° (lumbar 10°, thoracic 16°)",
        "norm": "Moderate lumbar and thoracic extension; avoid forcing end range (McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Legs",
        "setup": "Legs straight on the mat",
        "peak": "Legs stay down; the pelvis is the pivot",
        "norm": "Legs and pelvis stay on the mat (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #015153, Lying Hyperextension Hold, video (movement reference)",
        "url": "https://gymvisual.com/videos/15153-lying-hyperextension-hold-male.html"
      },
      {
        "id": "kelly2016",
        "title": "Kelly et al. 2016, lumbar iliocostalis and lumbar multifidus EMG during stabilization exercises in prone, quadruped and sitting positions (J Phys Ther Sci 28(10):2950-2954)",
