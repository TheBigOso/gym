      },
      {
        "id": "callaghan1998",
        "title": "Callaghan, Gunning and McGill 1998, the relationship between lumbar spine load and muscle activity during extensor exercises (Phys Ther 78(1):8-18)",
        "url": "https://doi.org/10.1093/ptj/78.1.8"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Low-back pain that worsens with arching: keep the lift small or skip it (clinical opinion).",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Hands under the forehead, smaller lift."
      ],
      "regressions": [
        "Prone lying with a pillow under the hips."
      ],
      "progressions": [
        "Longer hold.",
        "Arms overhead."
      ]
    },
    "muscleNotes": {
      "spinal_extensors": "Erector spinae lift the chest off the mat; prone extensions activate the lumbar extensors with modest spine loads (Kelly 2016; Callaghan 1998).",
      "glute_max": "Glutes hold the pelvis and legs down."
    }
  },
