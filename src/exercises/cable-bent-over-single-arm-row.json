        "obliques_r"
      ],
      "lengthened": [
        "lats_r",
        "rhomboids_midtrap_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row the handle to the hip, breathe in as the arm reaches forward.",
      "cadence": "About 1.2 s pull, short squeeze, about 2 s return"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12 each side",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
      "rest": "60-120 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can row without turning the chest open or lifting the trunk.",
      "progression": "Add reps, then one plate; then pause 1 s at the hip"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing a low pulley, feet hip width, knees soft; hinge at the hips until the trunk is well forward with a flat back; left hand on the left thigh, right hand holding the handle with the arm long toward the pulley."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out; draw the right shoulder blade back and row the handle toward the hip, elbow close to the body."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Elbow just past the trunk, shoulder blade drawn back; chest stays square to the floor."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the arm reach forward and down toward the pulley under control, shoulder blade sliding forward."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief stretch with the arm long and the back flat, then row again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rotating the chest open to finish the rep",
        "fix": "Keep both shoulders level; lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Rounding the lower back",
        "fix": "Hinge from the hips and keep the back flat; bend the knees a little more."
      },
      {
        "id": "m3",
        "mistake": "Standing up as you pull",
        "fix": "Keep the hinge angle fixed."
      },
      {
        "id": "m4",
        "mistake": "Shrugging toward the ear",
        "fix": "Pull the elbow toward the hip, shoulder down."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk lean",
        "setup": "≈35° above level (hip hinge, flat back), knees ≈25°",
        "peak": "Unchanged (trunk still)",
        "norm": "Hinged forward with a neutral spine and still; free-standing bent-over rows load the lumbar spine more than supported rows, so the hinge must be braced (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12° (arm long)",
        "peak": "≈119°",
        "norm": "From nearly straight to about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder extension",
        "setup": "Upper arm ≈105° from the trunk line, reaching toward the pulley",
        "peak": "Elbow driven up and back beside the trunk, 17 cm above the shoulder joint; handle beside the waist",
        "norm": "Upper arm from reaching forward to beside the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blade",
        "setup": "Protracted (reaching forward)",
        "peak": "Retracted",
        "norm": "Protracted at the reach, retracted at the finish (Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Bracing arm",
        "setup": "Left hand on the left thigh above the knee (0.05 cm from the target)",
        "peak": "Unchanged",
        "norm": "Left hand on the left thigh supports the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stretch 0.5 s at full reach",
        "peak": "1.2 s pull, 0.4 s squeeze, 2 s return",
        "norm": "Controlled, about 1 s pull and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
