    },
    "type": "Strength",
    "bodyPart": "Back (lats and mid-back)",
    "secondaryBodyParts": [
      "Shoulders (rear deltoid)",
      "Upper arms (biceps)",
      "Core"
    ],
    "equipment": [
      "Cable machine (low pulley)",
      "D-handle"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder extension, scapular retraction, elbow flexion)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "lats_r",
        "rhomboids_midtrap_r"
      ],
      "synergist": [
        "post_deltoid_r",
        "biceps_r",
        "forearm_flexors_r"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
