    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can move with the trunk still and the shoulders down.",
        "Brace the trunk on the free hand; stand up only after the handle is back at the stack.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low-back discomfort: stand more upright (less hinge) or use a seated one-arm row (clinical opinion).",
        "Shoulder discomfort at the reach: shorten the reach."
      ],
      "regressions": [
        "Lighter load.",
        "Seated one-arm cable row.",
        "One-arm dumbbell row on a bench."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Pause 1 s at the hip.",
        "Staggered stance, free hand off the thigh."
      ]
