        "glute_med_r",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row, breathe in as the arm reaches forward.",
      "cadence": "About 1 s row, short squeeze, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 each side",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1",
      "progression": "More reps, a longer squeeze, a step farther from the rack, then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Staggered stance facing a rack, left foot forward, knees soft, trunk tall. The band is looped round the upright at about waist-to-chest height; hold it in the right hand, arm straight toward the upright, palm facing in. Left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and drive the elbow back close to the side until the hand reaches the lower ribs."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the shoulder blade toward the spine; hips and shoulders square to the rack."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the arm reach forward under control, the shoulder blade gliding forward at the end."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the band taut, then row again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rotating the trunk to finish the row",
        "fix": "Keep the shoulders square; brace against the twist."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulder",
        "fix": "Pull the elbow back and down."
      },
      {
        "id": "m3",
        "mistake": "Elbow flaring out wide",
        "fix": "Keep the elbow close to the side."
      },
      {
        "id": "m4",
        "mistake": "Leaning back as the band tightens",
        "fix": "Stand tall over the front foot."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow path",
        "setup": "Arm reaching toward the upright (≈67° from the trunk)",
        "peak": "Elbow 10.5 cm behind the shoulder, 26.8 cm out from the spine line",
        "norm": "Elbow travels straight back close to the side (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈11°",
        "peak": "≈118°",
        "norm": "Nearly straight in front to about 100-120 degrees at the ribs, the forearm staying in line with the band (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blade",
        "setup": "Protracted (clavicle 8°)",
        "peak": "Retracted (clavicle -14°)",
        "norm": "Protracted at the reach, retracted at the end of the row (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance",
        "setup": "Staggered: left foot 24 cm forward, right foot 22 cm back, knees soft, trunk ≈5° from vertical, left hand on the hip",
        "peak": "Unchanged (hips and shoulders square)",
        "norm": "Staggered, opposite foot forward; standing one-arm pulls raise trunk muscle activity (Saeterbakken and Fimland 2012; Fenwick 2009).",
        "sources": [
          "saeterbakken2012",
          "fenwick2009"
        ]
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack upright in line with the right shoulder, 111.9 cm up, 101 cm in front of the shoulder; strand 43.7 cm",
        "peak": "Strand 83.7 cm at the ribs",
        "norm": "Elastic resistance can give muscle activity comparable to free weights at a matched effort (Andersen 2010).",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s with the arm long",
        "peak": "1.1 s row, 0.4 s squeeze, 1.8 s back, 0.4 s pause",
        "norm": "About 1 s row and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Standing Single Arm Row, animated GIF (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/12298-band-standing-single-arm-row.html"
      },
      {
        "id": "fenwick2009",
        "title": "Fenwick, Brown & McGill 2009, comparison of different rowing exercises: trunk muscle activation and lumbar spine motion, load and stiffness (J Strength Cond Res 23(2):350-358)",
