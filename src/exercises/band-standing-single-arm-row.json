      },
      {
        "id": "saeterbakken2012",
        "title": "Saeterbakken & Fimland 2012, muscle activity of the core during bilateral, unilateral, seated and standing resistance exercise (Eur J Appl Physiol 112:1671-1678)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21877146/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Low back: keep the trunk tall rather than leaning back against the band (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Balance: square stance with the feet hip width."
      ],
      "regressions": [
        "Lighter band or step closer to the rack.",
        "Both arms together."
      ],
      "progressions": [
        "Stronger band or step farther away.",
        "Pause 2 s at the ribs.",
        "One-arm dumbbell row or one-arm cable row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Extend the shoulder as the elbow drives back (Lehman 2004).",
      "rhomboids_midtrap_r": "Retract the shoulder blade at the end of the row.",
      "post_deltoid_r": "Extends the arm behind the body.",
      "biceps_r": "Bends the elbow.",
      "infraspinatus_r": "Steadies the shoulder.",
      "forearm_flexors_r": "Grip the band.",
      "upper_traps_r": "Steady the shoulder blade.",
      "core": "Braces the trunk.",
      "obliques_r": "Resist the one-arm pull twisting the trunk (Saeterbakken and Fimland 2012 found more trunk activity with unilateral and standing exercises).",
      "obliques_l": "Resist the one-arm pull twisting the trunk (Saeterbakken and Fimland 2012 found more trunk activity with unilateral and standing exercises).",
      "glute_med_r": "Steadies the pelvis in the staggered stance.",
      "glute_med_l": "Steadies the pelvis in the staggered stance."
    }
