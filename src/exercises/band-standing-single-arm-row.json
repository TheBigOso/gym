    },
    "type": "Strength",
    "bodyPart": "Back (lats, middle trapezius, rhomboids)",
    "secondaryBodyParts": [
      "Rear of the shoulder",
      "Biceps",
      "Core (anti-rotation)"
    ],
    "equipment": [
      "Resistance band",
      "Rack (band anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Transverse",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "lats_r",
        "rhomboids_midtrap_r"
      ],
      "synergist": [
        "post_deltoid_r",
        "biceps_r",
        "infraspinatus_r"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "upper_traps_r",
        "core",
        "obliques_r",
