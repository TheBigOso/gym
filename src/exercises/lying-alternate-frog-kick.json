  "exercise": {
    "id": "lying-alternate-frog-kick",
    "name": "Lying Alternate Frog Kick",
    "aliases": [
      "Alternating supine frog kicks",
      "Single-leg frog kick (lying)",
      "Lying alternate frog leg press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15158",
      "title": "Lying Alternate Frog Kick",
      "url": "https://gymvisual.com/videos/15158-lying-alternate-frog-kick-male.html",
      "listing": "Video (movement reference; page could not be read at authoring time, movement taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals) and hips (hip flexors)",
    "secondaryBodyParts": [
      "Thighs (adductors, quadriceps)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip and knee flexion with the hips turned out, then extension; trunk held)",
    "plane": "Sagittal",
    "laterality": "Unilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "quads_r",
        "quads_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "glute_med_r",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the knees come in, exhale as the legs kick out long.",
      "cadence": "About 1 s in, 0.8 s out"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per leg",
      "tempo": "1-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Lower the extended legs closer to the floor, then add a head and shoulder lift"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, arms by your sides palms down, legs long."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Brace and lift the legs a little off the mat; low back stays down."
      },
      {
        "id": "c3",
        "phase": "tuckR",
        "text": "Draw one knee in toward the chest, knee turned out, heel toward the other leg."
      },
      {
        "id": "c4",
        "phase": "kickR",
        "text": "Push the heel out until the leg is long beside the other one; switch legs."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Lower the legs to the mat and rest."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching as the legs extend",
        "fix": "Kick out higher (legs at a steeper angle) or bend the knees a little more."
      },
      {
        "id": "m2",
        "mistake": "Legs dropping to the mat between reps",
        "fix": "Keep the heels hovering through the set."
      },
      {
        "id": "m3",
        "mistake": "Knees collapsing together in the tuck",
        "fix": "Turn the knees out, heels in."
      },
      {
        "id": "m4",
        "mistake": "Neck straining",
        "fix": "Rest the head on the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Legs from the floor (extended)",
        "setup": "Legs resting on the mat",
        "peak": "≈14° (heels about 13 cm off the mat); the other leg keeps hovering",
        "norm": "Legs hover a little off the floor at full extension (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈17° (legs long)",
        "peak": "≈95° in the tuck",
        "norm": "From near straight to beyond 90 degrees in the tuck (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈2°",
        "peak": "≈120°",
        "norm": "From straight to deeply bent in the tuck (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip turn-out in the tuck",
        "setup": "Legs together",
        "peak": "Hip abduction 30°, external rotation 25.7°; heel 6 cm from the midline",
        "norm": "Knees apart, heels close together (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Pelvis stays on the mat (clinical opinion; McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.6 s, lift 0.6 s",
        "peak": "Each leg 1 s in, 0.8 s out; lower 0.8 s",
        "norm": "About 1 s in and 0.8 s out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15158, Lying Alternate Frog Kick, video (movement reference)",
        "url": "https://gymvisual.com/videos/15158-lying-alternate-frog-kick-male.html"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises: implications for rehabilitation and training (Phys Ther 86(5):656-671; PubMed 16649890)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/16649890/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Straight-leg and legs-off-the-floor work loads the low back through the hip flexors (McGill 1998). If the low back arches off the mat, bend the knees or shorten the range.",
        "Low-back pain or disc problems: prefer dead bugs or bent-knee alternatives.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion or legs-off-the-floor work."
      ],
      "modify": [
        "Kick the legs out higher.",
        "Hands under the hips.",
        "Keep the resting leg bent with the foot on the mat."
      ],
      "regressions": [
        "Dead bug legs only.",
        "Bent-knee marches."
      ],
      "progressions": [
        "Lying frog kick (both legs).",
        "Lower extension."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis and transversus hold the pelvis down while the legs are off the floor; bilateral leg work needs more abdominal effort than unilateral (Andersson 1997).",
      "hip_flexors_r": "Iliopsoas holds the leg up and pulls the knee in (clinical opinion; Andersson 1997).",
      "hip_flexors_l": "Iliopsoas holds the leg up and pulls the knee in (clinical opinion; Andersson 1997).",
      "quads_r": "Straighten the knee on the kick.",
      "quads_l": "Straighten the knee on the kick.",
      "adductors_r": "Bring the legs back together as they extend.",
      "adductors_l": "Bring the legs back together as they extend.",
      "obliques_r": "Brace the trunk against the moving legs.",
      "obliques_l": "Brace the trunk against the moving legs.",
      "glute_med_r": "Turn the thigh out in the tuck (clinical opinion).",
      "glute_med_l": "Turn the thigh out in the tuck (clinical opinion)."
    }
  },
