    "breathing": {
      "pattern": "Breathe in and brace at the top, hold it through the short dip, breathe out as you stand.",
      "cadence": "About 1.2 s down, a short pause, about 1 s up"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "5-8",
      "tempo": "1-0-1-0",
      "frequency": "1-2 times a week",
      "load": "Barbell load is user-chosen: the short range lets you handle more than your full-squat weight, so build up in small steps and leave about 2-3 reps in reserve (RPE 7-8).",
      "rest": "2-3 minutes between sets",
      "progression": "Add 2.5-5 kg when every rep reaches the same depth with a flat back."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar on the upper traps just below the bony bump at the base of the neck, hands just outside the shoulders, elbows down, shoulder blades squeezed together. Step back from the rack, feet about hip to shoulder width, toes turned out a little."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Brace, then bend the hips and knees together and sink only about a quarter of the way down: knees about 60 degrees, chest up."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop at the same depth every rep; no bounce."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the floor away and stand tall, hips and knees straightening together. Breathe out at the top."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, re-brace before the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Depth creeping shallower as the set goes on",
        "fix": "Pick a depth (a box or a pin just under you helps) and touch the same point every rep."
      },
      {
        "id": "m2",
        "mistake": "Leaning forward so the hips do all the work",
        "fix": "Keep the chest up and the bar over mid-foot; bend the knees as much as the hips."
      },
      {
        "id": "m3",
        "mistake": "Locking the knees hard at the top",
        "fix": "Stand tall with the knees straight but not snapped back."
      },
      {
        "id": "m4",
        "mistake": "Loading far beyond what the back can hold",
        "fix": "Add weight in small steps; the trunk has to support the bar however short the range."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width",
        "setup": "40 cm between the ankle centres, toes out 20°",
        "peak": "Unchanged (feet planted)",
        "norm": "About hip to shoulder width, toes out about 10-30 degrees (Lorenzetti 2018)",
        "sources": [
          "lorenzetti2018"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈60° (hips 32.9 cm above the knees)",
        "norm": "A quarter squat stops at about 40-70 degrees of knee flexion; a full squat goes past 110 (clinical opinion; Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈-6°",
        "peak": "≈44° (joint channel)",
        "norm": "Hips and knees bend together (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈16° forward of vertical; bar 3.3 cm from mid-foot",
        "norm": "Small forward lean in a shallow high-bar squat (Larsen 2021)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.2 s down, 0.3 s pause, 1.0 s up, 1.2 s reset",
        "norm": "Controlled dip, strong drive up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
