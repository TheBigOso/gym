    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain or flexion intolerance: start with a posterior pelvic tilt or the dead bug.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before trunk-flexion work."
      ],
      "modify": [
        "Hamstring tightness: bend the knees a little.",
        "Neck tension: relax the head on the mat."
      ],
      "regressions": [
        "Reverse crunch.",
        "Posterior pelvic tilt with feet on the floor."
      ],
      "progressions": [
        "Slow 3 s lowering.",
        "Lying leg hip raise on the floor."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the pelvis toward the ribs to lift the hips; pelvic-curl movements raised lower rectus activity (Clark 2003, Sarti 1996).",
      "obliques_r": "Help curl the pelvis and keep it square (clinical opinion).",
      "obliques_l": "Help curl the pelvis and keep it square (clinical opinion).",
      "hip_flexors_r": "Hold the legs up at vertical (clinical opinion).",
      "hip_flexors_l": "Hold the legs up at vertical (clinical opinion).",
      "quads_r": "Keep the knees straight (clinical opinion).",
      "quads_l": "Keep the knees straight (clinical opinion).",
      "lats_r": "Press the arms into the mat to steady the trunk (clinical opinion).",
      "lats_l": "Press the arms into the mat to steady the trunk (clinical opinion).",
      "triceps_r": "Keep the elbows straight as the hands press down (clinical opinion).",
      "triceps_l": "Keep the elbows straight as the hands press down (clinical opinion).",
      "adductors_r": "Hold the legs together (clinical opinion).",
      "adductors_l": "Hold the legs together (clinical opinion)."
    }
