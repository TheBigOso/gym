  "exercise": {
    "id": "lying-flat-hip-raise",
    "name": "Lying Flat Hip Raise",
    "aliases": [
      "Vertical hip raise",
      "Lying hip lift (legs vertical)",
      "Floor hip thrust-up",
      "Toes-to-ceiling hip raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "18101",
      "title": "Lying Flat Hip Raise (male)",
      "url": "https://gymvisual.com/videos/18101-lying-flat-hip-raise-male.html",
      "listing": "Video (movement reference; the page could not be read at authoring time: gymvisual.com is blocked by the proxy, so the movement comes from the name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hips (hip flexors)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (posterior pelvic tilt and lumbar flexion, legs held vertical)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "lats_r",
        "lats_l",
        "triceps_r",
        "triceps_l",
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the hips curl up, breathe in as you lower.",
      "cadence": "About 1.2 s up, short pause, 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "About 1 s up, brief pause, 2 s down; no kicking",
      "frequency": "2-3 times a week",
      "progression": "Longer pause at the top, then the full lying leg hip raise."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms by your sides palms down, legs straight up over the hips."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the hips off the mat, pressing the feet straight up toward the ceiling."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause with the low back peeled off the mat; shoulders and head stay relaxed."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Roll the pelvis down slowly, keeping the legs vertical."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Let the pelvis settle, legs still up."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Kicking the legs to throw the hips up",
        "fix": "Lift with the abdominals; the feet travel straight up, not toward the head."
      },
      {
        "id": "m2",
        "mistake": "Letting the legs drop toward the face",
        "fix": "Keep the legs about vertical so the pelvis does the work."
      },
      {
        "id": "m3",
        "mistake": "Pushing through the neck and hands",
        "fix": "Hands only steady you; keep the head relaxed on the mat."
      },
      {
        "id": "m4",
        "mistake": "Dropping fast on the way down",
        "fix": "Take about 2 s to roll down."
      }
    ],
    "kinematics": [
      {
        "measure": "Legs",
        "setup": "≈90° from the floor (vertical), knees ≈6°",
        "peak": "≈93°; the feet rise 5.6 cm",
        "norm": "About vertical throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis roll",
        "setup": "Pelvis resting",
        "peak": "≈32° posterior tilt; buttocks 7.5 cm off the mat",
        "norm": "The pelvis curls until the buttocks clear the mat; this curl brings in the lower abdominals (Clark 2003)",
        "sources": [
          "clark2003"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈95°",
        "peak": "≈66°",
        "norm": "About 90 degrees held; the angle eases as the pelvis curls (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper back",
        "setup": "On the mat",
        "peak": "Stays down (T6 moves 0.1 cm)",
        "norm": "Shoulders and head stay on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Legs up 0.7 s",
        "peak": "1.2 s up, 0.5 s pause, 2.0 s down, 1.0 s reset",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
