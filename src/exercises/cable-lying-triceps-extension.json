      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain in the elbow or shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can lower under control; the bar travels above the face.",
        "Get into position holding the bar on the chest (or have a partner pass it), and at the end of the set return it to the chest before sitting up so the stack lowers gently.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Elbow pain: use a rope or an angled bar and a shorter range (clinical opinion).",
        "Shoulder discomfort: keep the upper arms vertical rather than angled back."
      ],
      "regressions": [
        "Lighter load.",
        "Cable pushdown.",
        "Dumbbell skull crusher with light dumbbells."
      ],
      "progressions": [
        "Slower 3 s lowering.",
        "Overhead cable triceps extension (more triceps growth than the arm-at-the-side position in a 12-week study, PubMed 35819335).",
        "Heavier stack."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Prime mover: straightens the elbow against the cable. With the shoulder flexed past 90 degrees the long head works from a lengthened position (Kholinne 2018 measured head roles across shoulder elevation).",
      "triceps_l": "Prime mover: straightens the elbow against the cable. With the shoulder flexed past 90 degrees the long head works from a lengthened position (Kholinne 2018 measured head roles across shoulder elevation).",
      "lats_r": "Hold the upper arm angled back as the cable pulls it toward the head.",
      "lats_l": "Hold the upper arm angled back as the cable pulls it toward the head.",
      "post_deltoid_r": "Steadies the upper arm.",
      "post_deltoid_l": "Steadies the upper arm.",
      "pec_r": "Steadies the upper arm against the cable's pull toward the head.",
      "pec_l": "Steadies the upper arm against the cable's pull toward the head.",
      "forearm_flexors_r": "Grip the bar.",
      "forearm_flexors_l": "Grip the bar.",
      "core": "Keeps the back flat on the bench."
    }
