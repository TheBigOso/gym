    "breathing": {
      "pattern": "Breathe in as the bar lowers toward the head, breathe out as you straighten the arms.",
      "cadence": "About 2 s down, short pause, about 1.4 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2.2-0.3-1.4-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can lower with the upper arms still and the bar under control above the head.",
      "progression": "Add reps, then one plate on the stack; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench with the head toward a low pulley, feet flat; hold the straight bar overhand about shoulder width, arms straight over the upper chest and angled slightly back toward the head."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend only the elbows, lowering the bar in an arc toward the top of the head."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop with the bar just above and behind the forehead, elbows pointing up and not flaring."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbows back to the start; the upper arms stay still."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the arms straight but not locked hard; keep tension on the cable."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arms swinging toward the feet (turning it into a pullover-press)",
        "fix": "Fix the upper arms slightly back toward the head and move only the forearms."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows about shoulder width, pointing up."
      },
      {
        "id": "m3",
        "mistake": "Lowering the bar onto the face",
        "fix": "Aim for just above and behind the forehead; control the stack."
      },
      {
        "id": "m4",
        "mistake": "Arching off the bench",
        "fix": "Keep the head, upper back and buttocks on the pad, feet planted."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈8° (straight, not locked)",
        "peak": "≈105° at the bottom",
        "norm": "From nearly straight to about 100-120 degrees with the bar behind the forehead (clinical opinion); activation and relative force were matched across the three heads at 90 degrees of flexion or more (PLoS ONE 2021)",
        "sources": [
          "plos2021"
        ]
      },
      {
        "measure": "Upper arm angle",
        "setup": "≈15° past vertical toward the head",
        "peak": "Unchanged (elbows move 0.00 cm over the loop)",
        "norm": "Slightly past vertical toward the head and still; at 90 degrees of shoulder flexion and above the medial head carried the most force (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Overhand, 40.4 cm between the hands on a 50 cm bar",
        "peak": "Unchanged (40.37-40.37 cm)",
        "norm": "Overhand about shoulder width on a straight bar (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Low pulley 40 cm high, 60 cm behind the head",
        "peak": "Cable clear of the head and body by at least 3.21 cm; bar 2.2 cm from the head at the closest",
        "norm": "Low pulley behind the head so the cable pulls along the forearms through the range (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Back on the bench",
        "setup": "Bench 42 cm; buttocks, upper back and head on the pad",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "Head, upper back and buttocks on the bench, feet flat on the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s with the arms straight",
        "peak": "2.2 s down, 0.3 s pause, 1.4 s up, 0.5 s at the top",
        "norm": "Controlled, about 2 s lowering and 1-1.5 s pressing (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Lying Triceps Extension, video (movement reference)",
        "url": "https://gymvisual.com/videos/11393-cable-lying-triceps-extension.html"
      },
      {
        "id": "boehler2011",
