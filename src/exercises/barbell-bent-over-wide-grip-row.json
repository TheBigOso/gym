    "breathing": {
      "pattern": "Brace in the hinge, breathe out as the bar comes up, in as it lowers.",
      "cadence": "About 1.1 s up, 0.4 s squeeze, 2 s down"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "2-3 minutes between sets",
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "1 s up, short squeeze, 2 s down",
      "load": "Barbell load is user-chosen: lighter than a close-grip row; the trunk stays still, about 2 reps in reserve.",
      "progression": "Add 2.5 kg when every rep reaches the lower chest without the trunk rising."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Overhand grip well outside the shoulders, knees soft, hinge until the trunk is about 30-40 degrees above the floor, back flat, arms long."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Lead with the elbows out to the sides and pull the bar to the lower chest."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the shoulder blades together for a moment; the trunk stays still."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the bar slowly to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hinge and the brace; start the next rep without standing up."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Standing up and heaving the bar",
        "fix": "Fix the trunk angle; lighten the load until it stays still."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders to the ears",
        "fix": "Pull the shoulder blades back and down, not up."
      },
      {
        "id": "m3",
        "mistake": "Bar drifting to the belly",
        "fix": "With the wide grip, aim for the lower chest with the elbows out at about 60-75 degrees from the trunk."
      },
      {
        "id": "m4",
        "mistake": "Rounding the back",
        "fix": "Chest proud, brace, hinge only as far as a flat back allows."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk angle",
        "setup": "≈36° above level (hip channel ≈86°), spine neutral",
        "peak": "Unchanged (held)",
        "norm": "Bent-over rows load the lumbar spine and extensors; the trunk is held still (Fenwick 2009); about 30-45 degrees above horizontal is common",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈22°",
        "peak": "Unchanged",
        "norm": "Soft knees, about 15-25 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈4°, overhand 72 cm grip (handle centres)",
        "peak": "≈121°, elbows 20.7 cm out from the shoulders, bar at the lower chest; shoulder blades retracted (clavicle protraction 6° to -14°)",
        "norm": "Wide grip with flared elbows shifts work toward the rear deltoid and mid back (Schoenfeld 2013 on hand position and posterior shoulder EMG)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.1 s up, 0.4 s squeeze, 2 s down, 1.2 s reset",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Hold the brace and the hinge for the whole set; set the bar down if the back starts to round.",
        "Low-back pain: use a chest-supported row instead.",
        "Shoulder pain with the flared elbows: narrow the grip and bring the elbows in.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower back tires: more upright trunk or chest-supported row.",
        "Shoulders: shoulder-width grip."
      ],
      "regressions": [
        "Chest-supported dumbbell rear delt row.",
        "Band pull-apart.",
        "Seated cable row with a wide bar."
      ],
      "progressions": [
        "Pause at the chest.",
        "Dead-stop rows from the floor.",
        "Heavier bar in small steps."
      ]
    },
    "muscleNotes": {
      "rhomboids_midtrap_r": "Pull the shoulder blades together as the bar reaches the lower chest.",
      "rhomboids_midtrap_l": "Pull the shoulder blades together as the bar reaches the lower chest.",
      "post_deltoid_r": "The wide grip and flared elbows put the rear shoulders to work (horizontal abduction).",
      "post_deltoid_l": "The wide grip and flared elbows put the rear shoulders to work (horizontal abduction).",
      "lats_r": "Extends the shoulder; less than in a close, elbows-in row.",
      "lats_l": "Extends the shoulder; less than in a close, elbows-in row.",
      "biceps_r": "Bends the elbows; the overhand grip keeps it a helper.",
      "biceps_l": "Bends the elbows; the overhand grip keeps it a helper.",
      "infraspinatus_r": "Holds the upper arm turned out as the elbows flare.",
      "infraspinatus_l": "Holds the upper arm turned out as the elbows flare.",
      "upper_traps_r": "Steadies the shoulder blades; do not shrug.",
      "upper_traps_l": "Steadies the shoulder blades; do not shrug.",
      "forearm_flexors_r": "Hold the bar.",
      "forearm_flexors_l": "Hold the bar.",
      "spinal_extensors_r": "Hold the hinged back flat (Fenwick 2009).",
      "spinal_extensors_l": "Hold the hinged back flat (Fenwick 2009).",
      "hamstrings_r": "Hold the hips in the hinge.",
      "hamstrings_l": "Hold the hips in the hinge.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Bracing keeps the trunk still while the arms move."
    },
