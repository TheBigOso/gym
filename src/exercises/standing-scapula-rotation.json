{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "standing-scapula-rotation",
    "name": "Standing Scapula Rotation",
    "aliases": [
      "Shoulder blade circles",
      "Scapular circles",
      "Standing shoulder rolls"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "17583",
      "title": "Standing Scapula Rotation (male)",
      "url": "https://gymvisual.com/videos/17583-standing-scapula-rotation-male.html",
      "listing": "GymVisual page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching knowledge",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Mobility / activation",
    "bodyPart": "Back (scapular muscles)",
    "secondaryBodyParts": [
      "Shoulders",
      "Neck (upper trapezius)"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (scapular elevation, retraction, depression, protraction)",
    "plane": "Multiplanar",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "upper_traps_r",
        "upper_traps_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "serratus_r",
        "serratus_l",
        "lats_r",
        "lats_l",
        "pec_r",
        "pec_l"
      ],
      "stabilizer": [
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the shoulders lift and draw back, breathe out as they lower and come forward.",
      "cadence": "About 2.8 s per circle"
    },
    "prescription": {
      "sets": "1-2",
      "reps": "8-10 circles each direction",
      "tempo": "Slow and smooth, about 3 s per circle",
      "frequency": "Daily or as a warm-up before upper-body training",
      "progression": "Larger circles, then add a light band or hold light dumbbells"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, arms hanging relaxed by the sides."
      },
      {
        "id": "c2",
        "phase": "circle1",
        "text": "Lift the shoulders toward the ears, squeeze the shoulder blades back and together, press them down, then let them glide forward: one smooth circle."
      },
      {
        "id": "c3",
        "phase": "circle2",
        "text": "Again, as big and as slow as is comfortable; the arms stay relaxed and the head still."
      },
      {
        "id": "c4",
        "phase": "reset",
        "text": "Settle the shoulders in neutral; repeat, or reverse the direction."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Moving the head and neck",
        "fix": "Keep the chin level; only the shoulder blades move."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbows or swinging the arms",
        "fix": "Let the arms hang; they ride along with the shoulder blades."
      },
      {
        "id": "m3",
        "mistake": "Rushing through small circles",
        "fix": "Slow, full circles: up, back, down, forward."
      },
      {
        "id": "m4",
        "mistake": "Arching the low back to squeeze back",
        "fix": "Ribs down; the movement is at the shoulder blades."
      }
    ],
    "kinematics": [
      {
        "measure": "Scapular elevation and depression",
        "setup": "Neutral (clavicle elevation 0°)",
        "peak": "+24° up (shoulder joint 7.6 cm higher) to -8° down (-2.5 cm)",
        "norm": "Shoulders rise toward the ears and press down below neutral (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Scapular retraction and protraction",
        "setup": "Neutral",
        "peak": "-18° back (shoulder 5.9 cm back) to +18° forward (5.9 cm forward)",
        "norm": "Blades squeeze back and together, then glide forward; retraction exercises move the clavicle back by about 15-18 degrees (Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Arms",
        "setup": "Hanging, elbows soft",
        "peak": "Ride along with the shoulder blades",
        "norm": "Hang relaxed, elbows soft (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk and head",
        "setup": "Tall",
        "peak": "Unchanged apart from a slight upper-back extension in the squeeze",
        "norm": "Still and tall (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "Two circles of about 2.6 s",
        "norm": "About 3 s per circle (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #17583, Standing Scapula Rotation (male), video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/17583-standing-scapula-rotation-male.html"
      },
      {
        "id": "oyama2010",
        "title": "Oyama, Myers, Wassinger and Lephart 2010, three-dimensional scapular and clavicular kinematics and scapular muscle activity during retraction exercises (J Orthop Sports Phys Ther 40(3):169-179)",
        "url": "https://chs.uky.edu/sites/default/files/2023-12/Oyama_2010_Three-Dimensional%20Scapular%20and%20Clavicular%20Kinematics.pdf"
      },
      {
        "id": "ekstrom2003",
        "title": "Ekstrom, Donatelli and Soderberg 2003, surface electromyographic analysis of exercises for the trapezius and serratus anterior muscles (J Orthop Sports Phys Ther 33(5):247-258)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/12774999/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp pain, clicking with pain, or tingling down the arm.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "A mobility and warm-up drill: low load, not a strength builder on its own."
      ],
      "modify": [
        "Neck discomfort: smaller lift toward the ears, focus on back and down.",
        "Seated version if standing balance is a problem."
      ],
      "regressions": [
        "Seated shoulder blade squeezes.",
        "Shoulder shrugs only."
      ],
      "progressions": [
        "Light dumbbells in the hands.",
        "Scapular push-ups."
      ]
    },
    "muscleNotes": {
      "upper_traps_r": "Upper trapezius and levator scapulae lift the shoulders toward the ears (clinical opinion; shrug-type elevation strongly activates the upper trapezius, Ekstrom 2003).",
      "upper_traps_l": "Upper trapezius and levator scapulae lift the shoulders toward the ears (clinical opinion; shrug-type elevation strongly activates the upper trapezius, Ekstrom 2003).",
      "rhomboids_midtrap_r": "Rhomboids and middle trapezius draw the blades back and together; retraction drills activate them (Oyama 2010).",
      "rhomboids_midtrap_l": "Rhomboids and middle trapezius draw the blades back and together; retraction drills activate them (Oyama 2010).",
      "serratus_r": "Serratus anterior glides the blades forward around the ribcage (clinical opinion).",
      "serratus_l": "Serratus anterior glides the blades forward around the ribcage (clinical opinion).",
      "lats_r": "Lats and lower trapezius pull the blades down (clinical opinion).",
      "lats_l": "Lats and lower trapezius pull the blades down (clinical opinion)."
    }
  },
