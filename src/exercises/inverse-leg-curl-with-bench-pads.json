    "safety": {
      "cautions": [
        "Hamstring strain risk: build up the volume slowly and stop at any sharp pain at the back of the thigh.",
        "Knee pain on the pad: use a thicker pad.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
