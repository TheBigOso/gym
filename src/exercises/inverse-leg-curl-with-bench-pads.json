    "id": "inverse-leg-curl-with-bench-pads",
    "name": "Inverse Leg Curl with Bench Pads",
    "aliases": [
      "Bench Nordic curl",
      "Nordic curl on a bench"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "016055",
