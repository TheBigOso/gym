    "id": "box-squat",
    "name": "Box Squat",
    "aliases": [
      "Bodyweight box squat",
      "Squat to box",
      "Sit-to-stand squat"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "1016812",
      "title": "Bodyweight Box Squat",
      "url": "https://gymvisual.com/videos/22218-bodyweight-box-squat.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, box, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (quadriceps, hamstrings)",
      "Core"
    ],
    "equipment": [
      "Box or bench (about 40-45 cm)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip, knee and ankle)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "adductors_r",
        "adductors_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_med_r",
        "glute_med_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace, sit back to the box; stay braced on the box; breathe out as you stand.",
      "cadence": "About 2 s down, about 0.6 s on the box, about 1.2 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "2-1-1-0 (1 s on the box)",
      "frequency": "2-3 times a week",
      "progression": "Lower box, then hold a dumbbell (goblet box squat), then a free squat to the same depth."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand just in front of the box, feet a little wider than the shoulders, toes slightly out, arms reaching forward."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, brace and push the hips back; shins stay close to vertical, knees out."
      },
      {
        "id": "c3",
        "phase": "box",
        "text": "Sit lightly on the box for a moment, back flat, staying braced."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Lean the chest forward a touch and drive the feet into the floor to stand; breathe out."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall and reset."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping onto the box",
        "fix": "Control the lowering all the way; touch the box, do not crash onto it."
      },
      {
        "id": "m2",
        "mistake": "Relaxing and rounding the back on the box",
        "fix": "Stay braced with a flat back while seated."
      },
      {
        "id": "m3",
        "mistake": "Rocking back and swinging up",
        "fix": "Pause still, then stand by driving through the feet."
      },
      {
        "id": "m4",
        "mistake": "Knees caving inward on the way up",
        "fix": "Push the knees out over the toes."
      }
    ],
    "kinematics": [
      {
        "measure": "Box height",
        "setup": "46.2 cm box, front edge 16 cm behind the ankles",
        "peak": "Buttocks touch the box top (measured on the skinned mesh)",
        "norm": "About knee height or thighs parallel; 40-45 cm is common (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance width (ankle centres)",
        "setup": "46 cm (≈1.1x shoulder width), toes out 18°",
        "peak": "Unchanged",
        "norm": "Wider than in the traditional squat (Swinton 2012: about 92 cm in powerlifters vs 48 cm for the traditional squat); bodyweight versions use a little wider than the shoulders (clinical opinion)",
        "sources": [
          "swinton2012"
        ]
      },
      {
        "measure": "Shin angle (forward of vertical)",
        "setup": "≈2°",
        "peak": "≈14° forward of vertical on the box",
        "norm": "Close to vertical: the box squat kept the shins more vertical and moved the centre of mass back (Swinton 2012)",
        "sources": [
          "swinton2012"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈4°",
        "peak": "≈97°",
        "norm": "About 90-100 degrees on a box at about parallel (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈31° forward (hip 120°)",
        "norm": "More forward lean than the traditional squat to balance the hips sitting back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.6 s on the box, 1.2 s up, 1.8 s reset",
        "norm": "Controlled 2 s down, short pause on the box, about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #1016812, Bodyweight Box Squat, video (movement reference)",
        "url": "https://gymvisual.com/videos/22218-bodyweight-box-squat.html"
      },
      {
        "id": "swinton2012",
        "title": "Swinton, Lloyd, Keogh, Agouris & Stewart 2012, a biomechanical comparison of the traditional squat, powerlifting squat and box squat (J Strength Cond Res 26(7):1805-1816)",
        "url": "https://rgu-repository.worktribe.com/output/248374/a-biomechanical-comparison-of-the-traditional-squat-powerlifting-squat-and-box-squat"
      },
      {
        "id": "boxsquat2010",
        "title": "Comparison of kinetic variables and muscle activity during a squat vs. a box squat (J Strength Cond Res 24(12):3195-3199, 2010; PubMed 21132859)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21132859/"
      },
      {
        "id": "straub2024",
        "title": "Straub and Powers 2024, a biomechanical review of the squat exercise: implications for clinical practice (Int J Sports Phys Ther)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10987311/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Work in a range you can control; add load only once the bodyweight version is smooth.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a stable box or bench that cannot slide or tip; check it is behind you before sitting."
      ],
      "modify": [
        "Knee or hip pain: a higher box.",
        "Balance concerns: hold the arms forward or a light counterweight."
      ],
      "regressions": [
        "Higher box.",
        "Sit-to-stand from a chair."
      ],
      "progressions": [
        "Lower box.",
        "Goblet box squat with a dumbbell.",
        "Free bodyweight squat to the same depth."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Hip extensor; sitting back to the box with vertical shins puts more of the work at the hip (Swinton 2012 found the box squat kept the shins more vertical than the traditional squat).",
      "glute_max_l": "Hip extensor; sitting back to the box with vertical shins puts more of the work at the hip (Swinton 2012 found the box squat kept the shins more vertical than the traditional squat).",
      "quads_r": "Knee extensors stand you up from the box; muscle activity was generally a little lower in the box squat than in the squat (box squat vs squat, 2010).",
      "quads_l": "Knee extensors stand you up from the box; muscle activity was generally a little lower in the box squat than in the squat (box squat vs squat, 2010).",
      "hamstrings_r": "Assist hip extension from the seated bottom position (the 2010 study measured biceps femoris in both lifts).",
      "hamstrings_l": "Assist hip extension from the seated bottom position (the 2010 study measured biceps femoris in both lifts).",
      "adductors_r": "Adductor magnus assists hip extension with the wider stance (clinical opinion).",
      "adductors_l": "Adductor magnus assists hip extension with the wider stance (clinical opinion).",
      "calves_r": "Steady the shins (clinical opinion).",
      "calves_l": "Steady the shins (clinical opinion).",
      "core": "Stays braced while sitting on the box; do not relax onto it (clinical opinion).",
      "spinal_extensors_r": "Hold a flat back with the trunk leaning forward (the 2010 study measured the longissimus).",
      "spinal_extensors_l": "Hold a flat back with the trunk leaning forward (the 2010 study measured the longissimus).",
      "glute_med_r": "Keeps the knees out over the toes (clinical opinion).",
      "glute_med_l": "Keeps the knees out over the toes (clinical opinion).",
      "ant_deltoid_r": "Hold the arms forward as a counterbalance (clinical opinion).",
      "ant_deltoid_l": "Hold the arms forward as a counterbalance (clinical opinion)."
    }
  },
