    "bodyPart": "Upper back",
    "secondaryBodyParts": [
      "Lats",
      "Rear shoulders",
      "Biceps"
    ],
    "equipment": [
      "Barbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder, elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the bar comes up to the bench, in as it lowers.",
      "cadence": "About 1.1 s up, 0.4 s squeeze, 2 s down"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "2 minutes between sets",
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "1 s up, short squeeze, 2 s down",
      "load": "Barbell load is user-chosen: the chest stays on the pad and the bar touches the bench each rep.",
      "progression": "Add 2.5 kg when every rep touches the bench with a pause."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down on a high flat bench inside a rack, chin past the end; bar on the safety pins below, overhand grip about shoulder width."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Drive the elbows back toward the hips and pull the bar up to the bench under the lower chest."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Touch the bench and squeeze the shoulder blades together."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Set the bar on the pins for a moment; stay flat on the bench."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the chest off the bench",
        "fix": "Keep the chest and hips on the pad; lighten the bar."
      },
      {
        "id": "m2",
        "mistake": "Short reps",
        "fix": "Touch the bench every rep and straighten the arms at the bottom."
      },
      {
        "id": "m3",
        "mistake": "Shrugging",
        "fix": "Pull the shoulder blades back, not up."
      },
      {
        "id": "m4",
        "mistake": "Dropping the bar onto the pins",
        "fix": "Lower under control and set it down quietly."
      }
    ],
    "kinematics": [
      {
        "measure": "Body on the bench",
        "setup": "Face down on a 88 cm flat bench: chest and thighs on the pad (lowest front point 88 cm, thighs 88.01 cm), chin past the end",
        "peak": "Unchanged (only the arms and shoulder blades move)",
        "norm": "Chest-supported rows remove most of the lower-back load of a bent-over row (Fenwick 2009 compared rowing exercises)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈8°, 54 cm grip (handle centres); bar 44 cm high, resting on the safety pins",
        "peak": "≈122°, elbows 10.3 cm out from the shoulders, bar against the pad underside 11.4 cm behind the shoulders",
        "norm": "Shoulder-width grip with the elbows close works the lats and mid back (Lehman 2004)",
        "sources": [
          "lehman2004"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s",
        "peak": "1.1 s up, 0.4 s squeeze, 2 s down, 1.2 s reset",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Set up the bench so it cannot tip, and the safety pins so the bar is easy to reach and to set down.",
        "Climb on and off the high bench carefully; have the bar on the pins while you get set.",
        "Shoulder pain: narrow the grip and keep the elbows closer to the body.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower bench and lighter plates if the arms cannot hang."
      ],
      "regressions": [
        "Chest-supported dumbbell row.",
        "Seated cable row."
      ],
      "progressions": [
        "Pause with the bar on the bench.",
        "Heavier bar in small steps."
      ]
    },
    "muscleNotes": {
      "lats_r": "Drives the elbows back toward the hips.",
      "lats_l": "Drives the elbows back toward the hips.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together as the bar meets the bench.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together as the bar meets the bench.",
      "post_deltoid_r": "Extends the shoulder behind the trunk.",
      "post_deltoid_l": "Extends the shoulder behind the trunk.",
      "biceps_r": "Bends the elbows.",
      "biceps_l": "Bends the elbows.",
      "infraspinatus_r": "Holds the upper arm turned out.",
      "infraspinatus_l": "Holds the upper arm turned out.",
      "upper_traps_r": "Steadies the shoulder blades; no shrug.",
      "upper_traps_l": "Steadies the shoulder blades; no shrug.",
      "forearm_flexors_r": "Hold the bar.",
      "forearm_flexors_l": "Hold the bar.",
      "core": "Keeps the body flat on the bench.",
      "spinal_extensors_r": "Hold the trunk long; the bench takes the load off the lower back.",
      "spinal_extensors_l": "Hold the trunk long; the bench takes the load off the lower back."
    },
