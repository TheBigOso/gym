      ]
    },
    "breathing": {
      "pattern": "Inhale as the bar lowers toward the forehead, exhale as the elbows straighten.",
      "cadence": "About 2.2 s down, short pause, about 1.4 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "load": "Barbell load is user-chosen: pick a weight you can control for every rep with 1-3 reps in reserve (RPE 7-9).",
      "rest": "60-120 s",
      "progression": "More reps in the range, then 1-2.5 kg more, then a slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench, feet flat on the floor. Hold the bar overhand, hands about shoulder width or a little narrower, arms straight up over the shoulders."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend only the elbows: the bar travels in an arc down toward the forehead."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Bar just above the forehead, upper arms still, elbows pointing at the ceiling and about shoulder width apart."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbows, moving only the forearms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked over the shoulders; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arms swinging back and forth (turning it into a pullover)",
        "fix": "Keep the elbows pointing at the ceiling; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out wide",
        "fix": "Keep the elbows about shoulder width apart."
      },
      {
        "id": "m3",
        "mistake": "Dropping the bar onto the head",
        "fix": "Lower under control and stop just above the forehead; use a lighter bar if control slips."
      },
      {
        "id": "m4",
        "mistake": "Lower back arching off the bench",
        "fix": "Brace, keep the feet planted and the ribs down."
      },
      {
        "id": "m5",
        "mistake": "Wrists bending back under the bar",
        "fix": "Keep the wrists straight; an EZ bar can be easier on the wrists."
      }
    ],
    "kinematics": [
      {
        "measure": "Grip width",
        "setup": "34 cm between the handle centres (shoulder joints 39.9 cm apart)",
        "peak": "Constant (33.9-34.09 cm over the loop)",
        "norm": "About shoulder width or a little narrower (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12° (straight, not locked)",
        "peak": "≈100° at the bottom",
        "norm": "Straight but not locked at the top; lower until the bar is just above the forehead, about 100-120 degrees of elbow flexion (clinical opinion). Activation and relative force were matched across the three heads at 90 degrees of flexion or more (PLoS ONE 2021)",
        "sources": [
          "plos2021"
        ]
      },
      {
        "measure": "Upper arm angle",
        "setup": "≈8° from vertical, tilted back toward the head",
        "peak": "Held: at most 0.2° of drift over the loop",
        "norm": "Upper arms about vertical (about 90 degrees of shoulder flexion) and still; at 90 degrees and above the medial head carries the most force (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Bar clearance",
        "setup": "Bar over the shoulders, 61.3 cm above the bench",
        "peak": "2.99 cm above the nose at the bottom (rig shapes); bar 32.5 cm toward the head from the shoulder joints",
        "norm": "The bar stops just above the forehead and never touches the face (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.2 s down, 0.3 s pause, 1.4 s up, 0.5 s at the top",
        "norm": "Controlled, about 2 s lowering and 1-1.5 s pressing (clinical opinion); the EMG comparison used sets of 7 reps at 70% of 1RM (Boehler 2011)",
        "sources": [
          "boehler2011"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Barbell Lying Triceps Extension Skull Crusher, video (movement reference)",
