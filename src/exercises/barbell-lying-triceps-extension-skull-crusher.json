      }
    ],
    "safety": {
      "cautions": [
        "The bar travels toward the face: start light, lower slowly, and use a spotter for heavy sets (clinical opinion).",
        "Elbow pain: shorten the range or switch to dumbbells or an EZ bar (clinical opinion).",
        "Take the bar from a spotter or press it up from the chest; never swing it over the face.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrist discomfort: an EZ bar or dumbbells (neutral grip).",
        "Elbow discomfort: lower to the top of the head instead (less elbow bend)."
      ],
      "regressions": [
        "Dumbbell skull crusher.",
        "Cable or band pushdown."
      ],
      "progressions": [
        "Heavier bar in small steps.",
        "JM press.",
        "Pause just above the forehead (1 s)."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Does all of the work: lowers the bar under control and straightens the elbows. In the lying barbell triceps extension the long and lateral heads differed in activity (Boehler 2011). With the upper arm vertical the medial head produced the most force in a model and EMG study (Kholinne 2018).",
      "triceps_l": "Does all of the work: lowers the bar under control and straightens the elbows. In the lying barbell triceps extension the long and lateral heads differed in activity (Boehler 2011). With the upper arm vertical the medial head produced the most force in a model and EMG study (Kholinne 2018).",
      "lats_r": "Hold the upper arms vertical as the bar travels toward the head (clinical opinion).",
      "lats_l": "Hold the upper arms vertical as the bar travels toward the head (clinical opinion).",
      "post_deltoid_r": "Helps the lats keep the elbows pointing at the ceiling (clinical opinion).",
      "post_deltoid_l": "Helps the lats keep the elbows pointing at the ceiling (clinical opinion).",
      "forearm_flexors_r": "Grip the bar and keep the wrists straight.",
      "forearm_flexors_l": "Grip the bar and keep the wrists straight.",
      "core": "Keeps the ribs down and the lower back from arching off the bench."
    }
