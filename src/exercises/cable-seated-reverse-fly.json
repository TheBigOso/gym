      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7706677/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain at the front or top of the shoulder, numbness or tingling occurs.",
        "The cable loads are user-chosen: rear-deltoid work needs light loads to keep the elbows soft and the shoulders down.",
        "At the end of the set bring the hands together in front and let the cables back to the stacks slowly.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: open only to about 45 degrees short of the T, or lower the pulleys a little below shoulder height (clinical opinion).",
        "No crossover machine: band pull-apart or a seated dumbbell reverse fly."
      ],
      "regressions": [
        "Lighter load.",
        "Band pull-apart.",
        "One arm at a time."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Hold 1-2 s at the T.",
        "Standing cable reverse fly."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover: sweeps the arm out and back (horizontal abduction).",
      "post_deltoid_l": "Prime mover: sweeps the arm out and back (horizontal abduction).",
      "rhomboids_midtrap_r": "Draw the shoulder blades together as the arms reach the T.",
      "rhomboids_midtrap_l": "Draw the shoulder blades together as the arms reach the T.",
      "infraspinatus_r": "Helps move the arm back and steadies the shoulder.",
      "infraspinatus_l": "Helps move the arm back and steadies the shoulder.",
      "lat_deltoid_r": "Holds the arm up at shoulder height.",
      "lat_deltoid_l": "Holds the arm up at shoulder height.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
      "upper_traps_l": "Steadies the shoulder girdle; should not shrug.",
      "spinal_extensors_r": "Keep the trunk tall.",
      "spinal_extensors_l": "Keep the trunk tall.",
      "core": "Keeps the trunk still.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle."
    }
