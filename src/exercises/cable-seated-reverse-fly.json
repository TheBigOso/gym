    "name": "Cable Seated Reverse Fly",
    "aliases": [
      "Seated cable rear delt fly",
      "Seated cable reverse flye",
      "Seated crossover rear delt fly",
      "Cable rear delt fly, seated"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "21841",
      "title": "Cable Seated Reverse Fly (male)",
      "url": "https://gymvisual.com/videos/21841-cable-seated-reverse-fly-male.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment, so the movement was taken from the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (rear deltoid)",
    "secondaryBodyParts": [
      "Back (mid-back)"
    ],
    "equipment": [
      "Cable crossover (two pulleys at shoulder height)",
      "Two D-handles",
      "Box or bench seat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder horizontal abduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "upper_traps_r",
        "upper_traps_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "post_deltoid_r",
        "post_deltoid_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the arms open out to the sides, breathe in as they come back together.",
      "cadence": "About 1.2 s out, short pause, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.4-2-0.5 (open-hold-close-pause, seconds)",
      "rest": "45-90 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack loads are user-chosen and light: pick a weight you can open with soft, unchanging elbows and no shrug.",
      "progression": "Add reps, then a plate on each stack; add a 1 s hold out wide"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the seat between two pulleys set at shoulder height; hold the left cable in the right hand and the right cable in the left, arms long in front at shoulder height, thumbs up, elbows soft."
      },
      {
        "id": "c2",
        "phase": "open",
        "text": "Breathe out and sweep the arms out to the sides in a wide arc, keeping the elbows softly bent and the hands at shoulder height."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Arms in a T, in line with the shoulders; shoulders down, chest tall."
      },
      {
        "id": "c4",
        "phase": "close",
        "text": "Breathe in and let the arms come back together in front under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the hands in front, then open again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending and straightening the elbows (turning it into a row)",
        "fix": "Lock the elbows at a soft bend; the movement is only at the shoulders."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the shoulders down and away from the ears; lighten the load."
      },
      {
        "id": "m3",
        "mistake": "Swinging the arms back past the body",
        "fix": "Stop when the arms are in line with the shoulders."
      },
      {
        "id": "m4",
        "mistake": "Leaning back to move the weight",
        "fix": "Sit tall and keep the trunk still."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder horizontal abduction",
        "setup": "Upper arm ≈-6° from straight ahead (hands 28 cm apart in front)",
        "peak": "≈92° from straight ahead (arms in a T)",
        "norm": "From arms in front to arms in line with the shoulders (clinical opinion); in a horizontal abduction exercise the posterior deltoid was highly active and hand position changed its activity (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Shoulder elevation",
        "setup": "≈78° from the trunk",
        "peak": "≈79°",
        "norm": "Arms near shoulder height throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°-14° over the loop",
        "peak": "Unchanged",
        "norm": "Soft and unchanged, about 10-20 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈-1° forward of upright, seated tall",
        "peak": "Unchanged",
        "norm": "Upright and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the hands in front",
        "peak": "1.2 s out, 0.4 s hold, 2 s back",
        "norm": "Controlled, about 1 s out and 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Seated Reverse Fly (male), video (movement reference)",
