      "listing": "Animated GIF (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper Arms",
    "secondaryBodyParts": [
      "Chest",
      "Shoulders"
    ],
    "equipment": [
      "Body weight",
      "Dip station (parallel bars)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press up.",
      "cadence": "About 2 s down, short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "5-12 (stop 1-3 reps before form breaks)",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "progression": "More reps, then a dip belt with added load; build up from bench dips or assisted dips if a full rep is not yet possible"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Jump or step up to straight arms on the bars, hands under the shoulders, palms in; shoulders down away from the ears, knees bent, trunk nearly upright."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows straight back, lowering under control with the trunk upright."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop when the upper arms are about parallel to the floor; shoulders stay down, chest open."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and push the bars away to straighten the arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked, shoulders pressed down; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Sinking too deep",
        "fix": "Stop at upper arms about parallel to the floor; dips take the shoulder far into extension (McKenzie 2022)."
      },
      {
        "id": "m2",
        "mistake": "Shoulders shrugging up toward the ears at the bottom",
        "fix": "Keep pressing the shoulders down; shorten the range if they rise."
      },
      {
        "id": "m3",
        "mistake": "Elbows flaring out",
        "fix": "Bend the elbows straight back, close to the body."
      },
      {
        "id": "m4",
        "mistake": "Swinging the legs to get up",
        "fix": "Keep the knees bent and still; press with the arms."
      },
      {
        "id": "m5",
        "mistake": "Leaning far forward when the goal is the triceps",
        "fix": "Stay nearly upright; a strong forward lean turns it into a chest dip."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈4° (straight, not locked)",
        "peak": "≈98° at the bottom",
        "norm": "Arms straight but not locked at the top; elbow flexion at the bottom of a bar dip was larger than in a bench dip (McKenzie 2022); upper arms about parallel is a common limit (clinical opinion)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Trunk lean",
        "setup": "≈4° forward of vertical",
        "peak": "≈12° at the bottom (upright: triceps emphasis)",
        "norm": "Nearly upright for the triceps version; a forward lean shifts the work toward the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm angle to the floor",
        "setup": "≈82° (arms hanging straight down to the bars)",
        "peak": "≈0° (parallel)",
        "norm": "Stop with the upper arms about parallel to the floor (clinical opinion); bar dips reached about 95% of the maximal shoulder extension range in the study group (McKenzie 2022)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Body travel",
        "setup": "Shoulders 50 cm above the wrists",
        "peak": "27 cm down; feet stay 52.2 cm or more off the floor",
        "norm": "The body moves straight down and up between the bars; the feet stay off the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.0 s down, 0.3 s pause, 1.3 s up, 0.8 s at the top",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #081413, Triceps Dip, animated GIF (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/2296-triceps-dip.html"
      },
      {
        "id": "mckenzie2022",
        "title": "McKenzie, Crowley-McHattan, Meir, Whitting and Volschenk 2022, bench, bar, and ring dips: do kinematics and muscle activity differ? (Int J Environ Res Public Health 19(20):13211; PMC9603242)",
        "url": "https://www.mdpi.com/1660-4601/19/20/13211"
      },
      {
        "id": "boehler2011",
        "title": "Boehler 2011, electromyographic analysis of the triceps brachii muscle during a variety of triceps exercises (MS thesis, University of Wisconsin-La Crosse, ACE-sponsored; 15 women, 8 exercises at 70% 1RM)",
        "url": "https://minds.wisc.edu/items/4876923b-3a14-47c3-9a69-decf731bd027"
      }
    ],
    "safety": {
      "cautions": [
        "Shoulder: dips take the shoulder far into extension under body weight, which loads the front of the shoulder (McKenzie 2022); keep the range to upper arms about parallel and stop if the front of the shoulder hurts.",
        "Skip it with a history of shoulder instability or pain at the front of the shoulder.",
        "Use a stable station; step down, do not drop, from the bars.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorter range (stop with the elbows at about 60 degrees).",
        "Assisted dip machine or a band looped under the knees."
      ],
      "regressions": [
        "Bench dip with the knees bent.",
        "Negative-only dips: step up to the top, lower slowly, step down."
      ],
      "progressions": [
        "Slower lowering (3 s).",
        "Dip belt with added load.",
        "Pause at the bottom."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Main mover: straightens the elbow against body weight; triceps activity in the bar dip was high and similar to the other dip variants (McKenzie 2022).",
      "pec_r": "Lower chest helps press the body up from the bottom, more so with a forward lean (clinical opinion).",
      "ant_deltoid_r": "Front deltoid works with the chest as the shoulder comes out of extension (clinical opinion).",
      "lats_r": "Help hold the shoulders down and the body steady between the bars (clinical opinion).",
      "rhomboids_midtrap_r": "Keep the shoulder blades set (clinical opinion).",
      "forearm_flexors_r": "Grip the bars.",
      "triceps_l": "Main mover: straightens the elbow against body weight; triceps activity in the bar dip was high and similar to the other dip variants (McKenzie 2022).",
      "pec_l": "Lower chest helps press the body up from the bottom, more so with a forward lean (clinical opinion).",
      "ant_deltoid_l": "Front deltoid works with the chest as the shoulder comes out of extension (clinical opinion).",
      "lats_l": "Help hold the shoulders down and the body steady between the bars (clinical opinion).",
      "rhomboids_midtrap_l": "Keep the shoulder blades set (clinical opinion).",
      "forearm_flexors_l": "Grip the bars.",
      "core": "Keeps the trunk upright and the legs still."
    }
