    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [],
    "equipment": [
      "Plate-loaded leg extension machine (lever on the knee axis, shin roller, plates on the horn)",
      "Weight plates"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (knee extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l"
      ],
      "synergist": [],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe out as the legs straighten, breathe in as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.3 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "tempo": "1.2-0.6-2.3-0.4 (lift-hold-lower-pause, seconds)",
      "load": "Plate load is user-chosen: straighten fully without the hips lifting off the seat.",
      "progression": "Add reps, then load; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with the back on the pad, knees lined up with the lever axis and the roller on the front of the lower shins; hold the side handles."
      },
      {
        "id": "c2",
        "phase": "work",
        "text": "Breathe out and straighten both knees, lifting the roller in a smooth arc."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the quadriceps with the legs nearly straight."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and lower under control until the knees are back at about 90 degrees."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause briefly without letting the plates rest."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Knees not lined up with the lever axis",
        "fix": "Set the back pad so the knee joints sit on the pivot line."
      },
      {
        "id": "m2",
        "mistake": "Hips lifting off the seat",
        "fix": "Hold the handles and keep the buttocks down; lighten the plates."
      },
      {
        "id": "m3",
        "mistake": "Kicking the weight up",
        "fix": "Lift smoothly; pause at the top."
      },
      {
        "id": "m4",
        "mistake": "Dropping the weight",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈90° at the bottom",
        "peak": "≈8° at the top",
        "norm": "From about 90 degrees to nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee axis",
        "setup": "Lever pivot on the knee joint (21.9, 56.1 cm)",
        "peak": "Knee joint still; roller within 0.04 cm of its arc",
        "norm": "Lever pivot lined up with the knee joint so the roller does not slide on the shin (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Roller",
        "setup": "On the front of the shins, 80% of the way from knee to ankle",
        "peak": "Lever 81.8° up at the top",
        "norm": "On the front of the lower shins above the ankles (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip",
        "setup": "Seated, back on the 10° pad, hips ≈82°",
        "peak": "Unchanged",
        "norm": "Seated, back on the pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee load",
        "setup": "–",
        "peak": "Highest near straight legs (open chain)",
        "norm": "Open-chain knee extension loads the knee most near full extension (Escamilla 1998)",
        "sources": [
          "escamilla1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the knees bent",
        "peak": "1.2 s up, 0.6 s squeeze, 2.3 s down",
        "norm": "About 1.2 s up and 2.3 s down (clinical opinion)",
        "sources": []
      }
    ],
