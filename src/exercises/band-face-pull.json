    "id": "band-face-pull",
    "name": "Band Face Pull",
    "aliases": [
      "Resistance band face pull",
      "Banded face pull",
      "Band face pull with external rotation"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "7013",
      "title": "Band Face Pull",
      "url": "https://gymvisual.com/videos/7013-band-face-pull.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment, so the data sheet was not read)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (posterior deltoid)",
    "secondaryBodyParts": [
      "Upper back (middle and lower trapezius, rhomboids)",
      "Rotator cuff (infraspinatus, teres minor)"
    ],
    "equipment": [
      "Resistance band",
      "Power rack (anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder, elbow)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l",
        "biceps_r",
        "biceps_l"
      ],
      "stabilizer": [
        "upper_traps_r",
        "upper_traps_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull to the face, breathe in as the arms go back out.",
      "cadence": "About 1 s pull, short hold, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 2-3 reps short of failure (clinical opinion); often used as a warm-up or shoulder-health accessory",
      "tempo": "1-0.5-2-0.5 (pull-hold-return-pause, seconds)",
      "rest": "45-75 s",
      "frequency": "2-4 times a week",
      "load": "Band tension is user-chosen: light enough to finish with the hands beside the ears and the elbows high",
      "progression": "More reps, a longer hold, a step further back from the rack, or a stronger band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop the band round a rack upright at about face height. Face it, feet hip width, a strand in each hand, overhand, arms reaching toward the upright."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and pull the hands toward the face, elbows high and wide, about level with the shoulders."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Finish with the hands beside the ears and the knuckles turned up and back; squeeze the shoulder blades together, shoulders down."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the arms go back out slowly toward the upright, keeping the band tight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the arms long, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows dropping toward the ribs (turning it into a low row)",
        "fix": "Keep the elbows at about shoulder height and out to the sides."
      },
      {
        "id": "m2",
        "mistake": "Leaning back to finish the pull",
        "fix": "Stand tall over the feet; use a lighter band or step closer to the rack."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the shoulders down while the hands come back."
      },
      {
        "id": "m4",
        "mistake": "Skipping the turn-out at the end",
        "fix": "Finish with the forearms pointing up and the hands beside the ears."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow height",
        "setup": "Arms reaching to the upright, ≈94° of elevation",
        "peak": "≈94° of elevation, elbow 1 cm vs the shoulder joint",
        "norm": "Elbows at about shoulder height at the finish (clinical opinion; the face pull is a high, wide pull)",
        "sources": []
      },
      {
        "measure": "Horizontal abduction",
        "setup": "Upper arm ≈84° in front of the frontal plane",
        "peak": "Upper arm ≈11° behind the frontal plane",
        "norm": "From the arms reaching forward to the upper arms in line with the shoulders or a little behind; prone horizontal abduction reached about 87% MVIC in the posterior deltoid (Reinold 2007)",
        "sources": [
          "reinold2007"
        ]
      },
      {
        "measure": "External rotation",
        "setup": "Forearm in line with the band (≈81° from vertical)",
        "peak": "Forearm ≈22° from vertical, hands beside the face (7 cm vs the top of the neck)",
        "norm": "The shoulders turn out at the end so the forearms point up (clinical opinion); external rotation work loads the infraspinatus (Sung 2023 compared positions and abduction angles)",
        "sources": [
          "sung2023"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈22°",
        "peak": "≈96°",
        "norm": "From nearly straight to about 90 degrees or a little more at the finish (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped round the upright 152 cm high, 109 cm in front of the shoulders; strands 55.2 cm",
        "peak": "Strands 114.3 cm, clear of the face by 7.93 cm or more",
        "norm": "Elastic tension rises as the band stretches, so the load is highest at the finish; at matched effort elastic tubing and dumbbells gave similar activity in shoulder exercises (Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s with the arms long",
        "peak": "1.2 s pull, 0.5 s hold, 2 s back",
        "norm": "About 1 s pull, 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #7013, Band Face Pull, video (movement reference)",
