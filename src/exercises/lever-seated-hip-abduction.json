      "Machine hip abduction",
      "Outer thigh machine"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "2950",
      "title": "Lever Seated Hip Abduction",
      "url": "https://gymvisual.com/videos/2950-lever-seated-hip-abduction.html",
      "listing": "Video (movement reference; the page was not opened from the authoring environment, so the data sheet was not read and the movement was taken from the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips",
    "secondaryBodyParts": [
      "Outer hips",
      "Glutes"
    ],
    "equipment": [
      "Hip abduction machine (selectorized, two lever arms on vertical axles)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip abduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_med_r",
        "glute_med_l"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l"
      ],
      "stabilizer": [
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the knees open, breathe in as they come back together.",
      "cadence": "About 1.2 s out, short hold, about 2.2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.6-2.2-0.4 (out-hold-in-pause, seconds)",
      "rest": "45-75 s",
      "frequency": "1-3 times a week",
      "load": "Stack load is user-chosen: pick a weight you can open fully without rocking the trunk.",
      "progression": "Add reps, then one plate; longer hold at the open position"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with your back on the pad, knees bent about 90 degrees and together, the pads on the outside of the knees and the feet on the footrests; hold the side handles."
      },
      {
        "id": "c2",
        "phase": "open",
        "text": "Breathe out and push the knees apart against the pads, the thighs turning out about the hips."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold the open position for a moment; keep the back on the pad and the hips on the seat."
      },
      {
        "id": "c4",
        "phase": "close",
        "text": "Breathe in and let the knees come back together slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause briefly with the knees almost together without letting the stack touch down."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rocking the trunk forward to open",
        "fix": "Keep the back on the pad and lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Letting the pads slam together",
        "fix": "Take about two seconds to close."
      },
      {
        "id": "m3",
        "mistake": "Short, bouncing reps",
        "fix": "Open as far as you comfortably can and hold briefly."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "≈2° each side, knees 23.6 cm apart",
        "peak": "≈35° each side, knees 67.4 cm apart",
        "norm": "From knees together to about 30-45 degrees each side (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈80°, knees ≈90°",
        "peak": "Unchanged",
        "norm": "Seated, hips and knees about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lever",
        "setup": "Axles under the hips (-18.6, ±10.4 cm)",
        "peak": "Arms turn 33°; pads within 0 cm of the knees' arc",
        "norm": "Each arm turns on a vertical axle under the hip, so the pad stays on the outside of the knee (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Muscles",
        "setup": "–",
        "peak": "Gluteus medius working hardest at the open position (illustrative)",
        "norm": "The gluteus medius is the main hip abductor; side-lying hip abduction ranked among the highest gluteus medius exercises (Distefano et al. 2009)",
        "sources": [
          "distefano2009"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the knees together",
        "peak": "1.2 s out, 0.6 s hold, 2.3 s back",
        "norm": "Controlled, about 1-1.5 s out and 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Lever Seated Hip Abduction, video (movement reference)",
        "url": "https://gymvisual.com/videos/2950-lever-seated-hip-abduction.html"
      },
      {
        "id": "distefano2009",
        "title": "Distefano et al. 2009, gluteal muscle activation during common therapeutic exercises (J Orthop Sports Phys Ther 39(7):532-540)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19574661/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "The stack load is user-chosen: start light and move smoothly.",
        "Hip or groin pain: reduce the range or skip the exercise and ask a clinician.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Hip discomfort: open only part of the way.",
        "Set the start position so the knees are not forced together."
      ],
      "regressions": [
        "Lighter stack.",
        "Side-lying hip abduction.",
        "Band seated hip abduction."
      ],
      "progressions": [
        "Heavier stack.",
        "Longer holds at the open position.",
        "Trunk leaning slightly forward off the pad (more gluteus maximus, clinical opinion)."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Prime mover: abducts the hip (moves the thigh out to the side).",
      "glute_med_l": "Prime mover: abducts the hip (moves the thigh out to the side).",
      "glute_max_r": "Upper fibres help to abduct the flexed hip.",
      "glute_max_l": "Upper fibres help to abduct the flexed hip.",
      "adductors_r": "Lengthen as the knees open.",
      "adductors_l": "Lengthen as the knees open.",
      "core": "Keeps the pelvis still on the seat.",
      "forearm_flexors_r": "Hold the side handles.",
      "forearm_flexors_l": "Hold the side handles."
    }
