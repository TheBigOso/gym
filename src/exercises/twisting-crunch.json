  "exercise": {
    "id": "twisting-crunch",
    "name": "Twisting Crunch",
    "aliases": [
      "Cross crunch",
      "Oblique crunch (alternating)",
      "Elbow-to-knee crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "462012",
      "title": "Twisting Crunch",
      "url": "https://gymvisual.com/videos/10729-twisting-crunch.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, obliques)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (spinal flexion with rotation)",
    "plane": "Multiplanar",
    "laterality": "Bilateral, alternating sides",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l",
        "core"
      ],
      "synergist": [],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl and turn, inhale as you lower.",
      "cadence": "About 1 s up and turn, a short squeeze, about 1.4 s down, then switch sides"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-15 per side",
      "tempo": "About 1 s up, brief pause, 1.5 s down, alternating",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering and a 2 s hold, then bicycle crunch"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent about 90 degrees, feet flat. Fingertips lightly behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "twistR",
        "text": "Breathe out, curl up and turn the right shoulder toward the left knee; lead with the shoulder, not the elbow."
      },
      {
        "id": "c3",
        "phase": "holdR",
        "text": "Short squeeze. Both elbows stay open; the low back and hips stay on the mat."
      },
      {
        "id": "c4",
        "phase": "lowerR",
        "text": "Breathe in and lower slowly back to the centre."
      },
      {
        "id": "c5",
        "phase": "twistL",
        "text": "Repeat to the other side: left shoulder toward the right knee."
      },
      {
        "id": "c6",
        "phase": "lowerL",
        "text": "Lower under control and rest the head briefly."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling the elbow across with the arm",
        "fix": "Keep both elbows wide; turn the rib cage, not the arm."
      },
      {
        "id": "m2",
        "mistake": "Yanking the head forward",
        "fix": "Fingertips only; look up past the knees."
      },
      {
        "id": "m3",
        "mistake": "Hips rocking or the feet lifting",
        "fix": "Keep the pelvis heavy and the feet flat."
      },
      {
        "id": "m4",
        "mistake": "Turning without curling (lying flat and rolling)",
        "fix": "Lift the shoulder blades first, then turn."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk (T12 to C7) from the floor",
        "setup": "≈-1°",
        "peak": "≈29° (C7 up 16.8 cm)",
        "norm": "Shoulder blades clear the mat as in a crunch (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk rotation",
        "setup": "Facing the ceiling",
        "peak": "≈32° toward the opposite knee (lumbar ≈3°, thoracic ≈29°); working shoulder 21.1 cm higher than the other",
        "norm": "Upper trunk turns toward the opposite knee; the cross curl-up raised external oblique activity (Konrad 2001)",
        "sources": [
          "konrad2001"
        ]
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈7° (resting curve)",
        "peak": "≈47° (+39°)",
        "norm": "Most of the curl happens here (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip and knee",
        "setup": "Hip ≈45°, knee ≈90°",
        "peak": "Unchanged (pelvis and feet still)",
        "norm": "Knees about 90 degrees, feet flat; the pelvis does not move (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Fingertips behind the head, elbows wide",
        "peak": "Elbow 83 cm from the opposite knee (reaching toward it, not touching)",
        "norm": "Hands support the head only; elbows stay wide (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.6 s",
        "peak": "1.0 s up and turn, 0.4 s squeeze, 1.4 s down, 0.5 s rest per side; 7.2 s loop",
        "norm": "Controlled, about 1 s up and 1.5 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
