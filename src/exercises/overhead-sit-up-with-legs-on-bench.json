      "Mat"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Trunk flexion with the arms as a long lever",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "hip_flexors_r",
