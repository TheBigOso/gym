    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Full sit-ups load the low back more than curl-ups (McGill 1998; Axler and McGill 1997).",
        "Low-back pain or flexion intolerance: choose a curl-up, dead bug or plank instead.",
        "Shoulder pain overhead: start with the arms crossed on the chest."
      ],
      "modify": [
        "Shoulder or neck discomfort: arms crossed on the chest.",
        "Low back discomfort: stop halfway (curl-up with the legs on the bench)."
      ],
      "regressions": [
        "Crunch with the legs on a bench.",
        "Sit-up with the arms reaching forward."
      ],
      "progressions": [
        "Arms beside the ears all the way up.",
        "Light plate held overhead."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the trunk; the straight arms overhead lengthen the lever at the start (clinical opinion). Bent-knee sit-ups gave about 35-40% MVIC in the rectus abdominis (Escamilla 2016).",
      "hip_flexors_r": "With the calves on the bench the hips start at about 90 degrees; iliopsoas still helps sit up once the shoulder blades are off the mat (Andersson 1997).",
      "hip_flexors_l": "With the calves on the bench the hips start at about 90 degrees; iliopsoas still helps sit up once the shoulder blades are off the mat (Andersson 1997).",
      "ant_deltoid_r": "Front deltoids bring the straight arms from overhead to forward (clinical opinion).",
      "ant_deltoid_l": "Front deltoids bring the straight arms from overhead to forward (clinical opinion)."
    }
