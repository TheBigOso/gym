      ],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "serratus_r",
        "serratus_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you swing the arms and sit up, inhale as you roll back down.",
      "cadence": "About 1.4 s up, short pause, 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-15",
      "tempo": "About 1.4 s up, short pause, 2 s down",
      "frequency": "2-3 times a week",
      "progression": "Keep the arms beside the ears all the way up (longer lever), then hold a light plate overhead"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back with the calves resting on a flat bench, hips and knees about 90 degrees. Arms straight overhead on the mat."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out, bring the straight arms up over the face and curl the head and shoulders off the mat."
      },
      {
        "id": "c3",
        "phase": "rise",
        "text": "Keep curling and sit up, reaching the hands past the knees toward the feet."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Brief pause at the top; calves stay on the bench."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Breathe in and roll back down slowly, arms returning overhead as the shoulders reach the mat."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Arms rest overhead; repeat without bouncing."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Throwing the arms to jerk up",
        "fix": "Bring the arms up with the curl, not ahead of it."
      },
      {
        "id": "m2",
        "mistake": "Legs pulling off the bench",
        "fix": "Keep the calves heavy on the bench."
      },
      {
        "id": "m3",
        "mistake": "Dropping back to the floor",
        "fix": "Roll down for about 2 s."
      },
      {
        "id": "m4",
        "mistake": "Arching the low back with the arms overhead",
        "fix": "Brace so the low back stays on the mat at the start."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from the floor",
        "setup": "Lying (shoulder blades on the mat)",
        "peak": "≈47° from the floor, chest toward the thighs",
        "norm": "From lying to sitting up near the thighs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈88° (calves on a 40.8 cm bench)",
        "peak": "≈101° (rig limit 140°)",
        "norm": "Starts at about 90 degrees with the calves on the bench and closes as you sit up; hip flexors take over in the second half of a sit-up (Andersson 1997)",
        "sources": [
          "andersson1997"
        ]
      },
      {
        "measure": "Arm position",
        "setup": "Straight overhead, resting on the mat",
        "peak": "Reaching past the knees (fingertips 38 cm beyond the knee joint)",
        "norm": "Straight overhead on the mat at the start, reaching past the knees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Spinal flexion",
        "setup": "≈3° (resting curve)",
        "peak": "≈62°",
        "norm": "The upper back curls first (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Lie 0.8 s",
        "peak": "1.4 s up, 0.4 s pause, 2 s down, 1.4 s rest",
        "norm": "Controlled, about 1.4 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
