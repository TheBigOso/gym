        "forearm_flexors_r"
      ]
    },
    "breathing": {
      "pattern": "Inhale and brace before you hinge; breathe out as you stand back up.",
      "cadence": "About 2.4 s down, a short pause, about 2.4 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "5-8 per side",
      "tempo": "Slow: about 2-3 s down, brief pause, 2-3 s up",
      "frequency": "1-2 times a week",
      "progression": "Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set. Learn it with no weight or a light dumbbell first; add load only when the arm stays vertical and the eyes stay on the weight."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet wider than the hips, both feet turned about 45 degrees to the left. Press the dumbbell overhead in the right hand and lock the elbow; eyes on the dumbbell."
      },
      {
        "id": "c2",
        "phase": "down",
        "text": "Push the right hip out and back, then hinge and side-bend to the left; slide the left hand down the inside of the left leg."
      },
      {
        "id": "c3",
        "phase": "pause",
        "text": "Pause with the left hand near the shin: right arm vertical, chest open toward the dumbbell, right knee straight, left knee soft."
      },
      {
        "id": "c4",
        "phase": "up",
        "text": "Drive the hips forward and stand back up the same path, eyes still on the dumbbell."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall with the arm locked; finish the set, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "The overhead arm drifting forward or bending",
        "fix": "Keep the knuckles to the ceiling and the arm stacked over the shoulder; go lighter."
      },
      {
        "id": "m2",
        "mistake": "Rounding forward instead of hinging at the hips",
        "fix": "Push the right hip back first; the spine stays long."
      },
      {
        "id": "m3",
        "mistake": "Reaching for the floor with the left hand",
        "fix": "Go only as low as you can with the arm vertical; mid-shin is plenty."
      },
      {
        "id": "m4",
        "mistake": "Looking down at the floor",
        "fix": "Eyes on the dumbbell for the whole rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from vertical",
        "setup": "Upright (≈5° from vertical)",
        "peak": "≈71° from vertical (pelvis to C7): hips hinge ≈68°, spine side-bends ≈27° to the left and turns ≈29° open toward the dumbbell",
        "norm": "Hip hinge with a side-bend and an open chest; no study defines the angles (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Overhead arm",
        "setup": "Vertical (≈0° off vertical)",
        "peak": "Stays vertical (≈3° max off vertical over the rep)",
        "norm": "Locked and vertical throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hips and knees",
        "setup": "Hips ≈-4° R / ≈9° L; knees ≈6° R / ≈5° L",
        "peak": "Hips ≈63° R / ≈97° L; knees ≈10° R (locked) / ≈22° L (soft)",
        "norm": "The loaded-side knee straight, the other soft; the hips hinge (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Free hand",
        "setup": "Left hand beside the left thigh, 86 cm up",
        "peak": "Slides to 39 cm above the floor along the inside of the left shin (wrist 14 cm from the leg's bone line)",
        "norm": "Slides down the inside of the front leg toward the shin or foot (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Feet",
        "setup": "Feet 44 cm apart, both turned 40° to the left",
        "peak": "Unchanged (planted)",
        "norm": "Wider than the hips, turned about 45 degrees away from the dumbbell (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.4 s down, 0.6 s pause, 2.4 s up, 0.8 s at the top",
        "norm": "Slow and controlled, about 2-3 s each way (clinical opinion)",
        "sources": []
      }
    ],
