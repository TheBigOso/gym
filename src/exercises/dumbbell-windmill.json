    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (hip hinge with trunk side-bend and rotation under an overhead load)",
    "plane": "Multiplanar",
    "laterality": "Unilateral (one side at a time)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r",
