        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7706677/"
      }
    ],
    "safety": {
      "cautions": [
        "Shoulder pain: lower only to a pain-free height, or use a lighter bar (clinical opinion).",
        "Keep the trunk still; leaning back shifts the load to the lower back.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: a neutral-grip dumbbell raise or a smaller range."
      ],
      "regressions": [
        "Seated dumbbell front raise.",
        "Light plate front raise."
      ],
      "progressions": [
        "Heavier bar in small steps.",
        "Standing barbell front raise."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover: shoulder flexion. The frontal raise gave the highest anterior deltoid activity in the lifting phase among the raises tested (Coratella 2020; standing, dumbbells).",
      "ant_deltoid_l": "Main mover: shoulder flexion. The frontal raise gave the highest anterior deltoid activity in the lifting phase among the raises tested (Coratella 2020; standing, dumbbells).",
      "pec_r": "The clavicular head helps flex the shoulder; it was most active in the frontal raise (Coratella 2020).",
      "pec_l": "The clavicular head helps flex the shoulder; it was most active in the frontal raise (Coratella 2020).",
      "lat_deltoid_r": "Helps hold the arms up; medial deltoid activity was lower in the frontal raise than in lateral raises (Coratella 2020).",
      "lat_deltoid_l": "Helps hold the arms up; medial deltoid activity was lower in the frontal raise than in lateral raises (Coratella 2020).",
      "serratus_r": "Upward rotation of the shoulder blades as the arms rise.",
      "serratus_l": "Upward rotation of the shoulder blades as the arms rise.",
      "upper_traps_r": "Supports the shoulder blades near the top.",
      "upper_traps_l": "Supports the shoulder blades near the top.",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred.",
      "forearm_flexors_r": "Grip the bar.",
      "forearm_flexors_l": "Grip the bar.",
      "spinal_extensors_r": "Keep the spine tall against the load in front.",
      "spinal_extensors_l": "Keep the spine tall against the load in front.",
      "core": "Holds the trunk still; no rocking back on the seat."
    }
