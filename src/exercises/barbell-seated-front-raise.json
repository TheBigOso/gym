    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 1.8 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds; Coratella 2020)",
      "frequency": "1-2 times a week",
      "load": "User-chosen barbell load; light (an empty or light fixed bar is often enough).",
      "rest": "60-90 s",
      "progression": "Add reps, then 1-2.5 kg"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench, feet flat. Hold the bar overhand about shoulder width apart, resting just above the thighs, arms straight with soft elbows."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the bar straight forward and up with nearly straight arms."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at shoulder height; chest up, no lean back, shoulders down away from the ears."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s back to just above the thighs."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause without resting the bar on the legs; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rocking back to swing the bar up",
        "fix": "Sit tall and still; lighter bar."
      },
      {
        "id": "m2",
        "mistake": "Raising far above shoulder height",
        "fix": "Stop at about shoulder height (clinical opinion)."
      },
      {
        "id": "m3",
        "mistake": "Bending the elbows into a curl",
        "fix": "Keep the arms nearly straight, elbows soft."
      },
      {
        "id": "m4",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the shoulders down and the neck long."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder flexion",
        "setup": "≈46° (bar 1.51 cm above the thighs at the closest)",
        "peak": "≈92° (bar 0 cm vs the shoulder joints)",
        "norm": "From the bar over the thighs to about 90 degrees (the top of the range tested by Coratella 2020)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈8°",
        "peak": "≈8°",
        "norm": "Elbows soft, about 5-15 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip width",
        "setup": "Overhand, 44 cm between the handle centres (shoulder joints 40.4 cm apart)",
        "peak": "Constant (43.93-44.07 cm over the loop)",
        "norm": "Overhand, about shoulder width (clinical opinion); the frontal raise loads the anterior deltoid most among the raises compared in Campos 2020",
        "sources": [
          "campos2020"
        ]
      },
      {
        "measure": "Seat",
        "setup": "Bench end, seat 45 cm; trunk ≈5° from vertical, knees ≈92°",
        "peak": "Unchanged (no rocking back)",
        "norm": "Upright on the end of a flat bench, feet flat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s above the thighs",
        "peak": "1.8 s up, 0.4 s at the top, 2 s down",
        "norm": "2 s up, 0.5 s pause, 2 s down in Coratella 2020",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Barbell Seated Front Raise, video (movement reference)",
