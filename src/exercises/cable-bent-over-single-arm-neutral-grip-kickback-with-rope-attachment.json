    "breathing": {
      "pattern": "Exhale as you straighten the elbow, inhale as the cable pulls the hand back.",
      "cadence": "About 1 s out, 0.6 s squeeze, about 1.8 s back"
    },
    "prescription": {
      "sets": "2-3 per arm",
      "reps": "10-15",
      "load": "Cable stack load is user-chosen: pick a weight you can control for every rep with 1-3 reps in reserve (RPE 7-9). Kickbacks need a light load.",
      "tempo": "1-1-2-0 (out, squeeze, back)",
      "frequency": "1-2 times a week",
      "progression": "More reps, a longer squeeze, then one plate on the stack"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Face a low pulley, feet hip width, knees soft, and hinge forward from the hips with a flat back; left hand on the hip. Hold one rope end in the right hand, palm facing in, upper arm along the side and the elbow bent about 90 degrees."
      },
      {
        "id": "c2",
        "phase": "extend",
        "text": "Breathe out and straighten the elbow, pushing the hand back until the arm is straight along the body."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the back of the arm with the arm straight; the upper arm stays still along the trunk."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the cable bend the elbow slowly back to about 90 degrees."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the back flat and the hips still; repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the arm (momentum)",
        "fix": "Move slowly and pause with the arm straight; use a lighter load."
      },
      {
        "id": "m2",
        "mistake": "Upper arm dropping as the elbow bends",
        "fix": "Keep the upper arm parallel to the trunk throughout."
      },
      {
        "id": "m3",
        "mistake": "Trunk rotating open toward the working arm",
        "fix": "Keep both shoulders square to the pulley."
      },
      {
        "id": "m4",
        "mistake": "Rounded back or standing up during the set",
        "fix": "Hold the hip hinge with a flat back, neck long."
      },
      {
        "id": "m5",
        "mistake": "Wrist bending",
        "fix": "Keep the wrist straight in line with the forearm."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈95° (forearm hanging)",
        "peak": "≈4° (arm straight back)",
        "norm": "From about 90 degrees (forearm hanging) to straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm to trunk",
        "setup": "≈11° from the trunk line, along the side",
        "peak": "Unchanged (elbow moves 0.00 cm over the loop)",
        "norm": "Upper arm along the trunk (low shoulder elevation), where the long head carried the most force (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈48° forward of vertical, knees ≈20°",
        "peak": "Unchanged",
        "norm": "Hip hinge with a flat back, trunk well forward (about 45-60 degrees from vertical) and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Elbow bent 0.5 s",
        "peak": "1 s out, 0.6 s squeeze, 1.8 s back",
        "norm": "Slow and controlled with a pause at full extension (clinical opinion); the EMG comparison used sets of 7 reps at 70% of 1RM (Boehler 2011)",
        "sources": [
          "boehler2011"
        ]
      },
      {
        "measure": "Cable",
        "setup": "Low pulley 75 cm in front of the hand, 15 cm high",
        "peak": "Clear of the body and legs by at least 6.11 cm",
        "norm": "Low pulley in front, so the cable pulls the hand forward and keeps tension through the whole range, unlike a dumbbell kickback, which loads mainly near full extension (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Bent Over Single Arm Neutral Grip Kickback with Rope Attachment, video (movement reference)",
