    "safety": {
      "cautions": [
        "Lower back pain: shorten the hinge, brace, and keep the back flat; stop if form slips (clinical opinion).",
        "Elbow pain: lighter load, slower tempo.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "The cable load is user-chosen: start light.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Back fatigue: brace the free hand on a bench or the cable column.",
        "Wrist discomfort: keep the palm facing the body (neutral grip, as here)."
      ],
      "regressions": [
        "Lighter load.",
        "Dumbbell kickback supported on a bench.",
        "One-arm cable pushdown."
      ],
      "progressions": [
        "Longer squeeze at full extension.",
        "Slower 3 s return."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Straightens the elbow against the cable; the load peaks with the arm straight. Kickbacks, dips and triangle push-ups did not differ significantly in long or lateral head EMG and led an eight-exercise comparison (Boehler 2011). With the upper arm near the trunk the long head produced the most force (Kholinne 2018).",
      "triceps_l": "Straightens the elbow against the cable; the load peaks with the arm straight. Kickbacks, dips and triangle push-ups did not differ significantly in long or lateral head EMG and led an eight-exercise comparison (Boehler 2011). With the upper arm near the trunk the long head produced the most force (Kholinne 2018).",
      "post_deltoid_r": "Holds the upper arm up along the trunk (clinical opinion).",
      "post_deltoid_l": "Holds the upper arm up along the trunk (clinical opinion).",
      "lats_r": "Help keep the upper arm against the side (clinical opinion).",
      "lats_l": "Help keep the upper arm against the side (clinical opinion).",
      "rhomboids_midtrap_r": "Hold the shoulder blade back so the upper arm stays still (clinical opinion).",
      "rhomboids_midtrap_l": "Hold the shoulder blade back so the upper arm stays still (clinical opinion).",
      "forearm_flexors_r": "Grip the handle; keep the wrist straight.",
      "forearm_flexors_l": "Grip the handle; keep the wrist straight.",
      "core": "Holds the trunk square to the hip hinge; no twisting as the arm straightens.",
      "spinal_extensors_r": "Keep a flat back in the bent-over position.",
      "spinal_extensors_l": "Keep a flat back in the bent-over position."
    }
