    "breathing": {
      "pattern": "Breathe in and brace at the shoulder, breathe out as you press against the band; breathe in as you lower.",
      "cadence": "About 1.5 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3 per arm",
      "reps": "6-12",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0-1.5-0 (down-pause-up-pause, seconds)",
      "rest": "60-90 s between arms",
      "frequency": "1-2 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; choke up on the band under the foot, for more tension.",
      "progression": "More reps, a slower return, a shorter band length under the foot (more stretch), then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Staggered stance: right foot forward standing on the band, left foot back, knees soft, ribs down and glutes lightly braced. Handle at the right shoulder, palm forward, elbow under the wrist; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press straight up against the band; do not lean away from it."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arm nearly straight overhead, biceps near the ear, ribs down; the band is tightest here."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower in about 2 s to shoulder height, elbow under the wrist; do not let the band pull the arm down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brace again and repeat; switch arms (and the front foot) after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning sideways or back as the band gets tight at the top",
        "fix": "Squeeze the glutes and brace the obliques; use a lighter band."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back to finish",
        "fix": "Ribs down, glutes tight; stop just short of lockout if needed."
      },
      {
        "id": "m3",
        "mistake": "Elbow flaring behind the body",
        "fix": "Keep the elbow a little in front of the shoulder (scapular plane)."
      },
      {
        "id": "m4",
        "mistake": "Band slipping from under the foot",
        "fix": "Keep the band under the middle of the front foot with the foot flat."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder elevation",
        "setup": "≈80° (upper arm vs trunk)",
        "peak": "≈167°",
        "norm": "From about 80-90 degrees (upper arm about level) to about 160-170 degrees overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈98°, forearm vertical",
        "peak": "≈12° (nearly straight)",
        "norm": "About 90 degrees at the bottom with the forearm vertical, nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Plane of elevation",
        "setup": "elbow ≈30° in front of the frontal plane",
        "peak": "≈40°",
        "norm": "Elbow about 20-40 degrees in front of the frontal plane (scapular plane; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "upright, left hand on the hip; staggered stance, right foot 40 cm forward on the band, left foot 10 cm back",
        "peak": "unchanged (no side lean)",
        "norm": "Upright with no side lean over a staggered stance; unilateral standing presses increase oblique demand (Saeterbakken 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Band",
        "setup": "Under the right forefoot; strand 161.5 cm at the shoulder",
        "peak": "Strand 191.6 cm overhead; at least 1.7 cm from the body (closest at the upperarm)",
        "norm": "Under the front foot, so tension rises as the hand goes up and is highest overhead; elastic resistance can give muscle activity comparable to free weights in shoulder exercises (Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.8 s at the shoulder",
        "peak": "1.5 s up, 0.4 s at the top, 2.0 s down",
        "norm": "Controlled, about 2 s down and 1-2 s up (clinical opinion)",
        "sources": []
      }
    ],
