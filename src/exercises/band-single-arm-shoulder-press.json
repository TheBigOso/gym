    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a heavy bench frame or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is lightest at the start and heaviest at the end of the push; let it return under control rather than snapping back.",
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder pain overhead: press with the palm facing in (neutral grip) and the elbow further forward.",
        "Low-back discomfort: press half-kneeling with the band under the front knee's foot."
      ],
      "regressions": [
        "Lighter band.",
        "Seated band shoulder press.",
        "Half-kneeling single-arm band press."
      ],
      "progressions": [
        "Stronger band or a shorter band length.",
        "Single-arm dumbbell shoulder press.",
        "Single-arm push press."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover. The shoulder press gave the highest anterior deltoid activity of four upper-body exercises (Campos 2020); standing presses gave more deltoid activity than seated with dumbbells (Saeterbakken 2013).",
      "ant_deltoid_l": "Main mover. The shoulder press gave the highest anterior deltoid activity of four upper-body exercises (Campos 2020); standing presses gave more deltoid activity than seated with dumbbells (Saeterbakken 2013).",
      "lat_deltoid_r": "Lifts the arm up and out; medial deltoid activity in the press was close to the lateral raise (Campos 2020).",
      "lat_deltoid_l": "Lifts the arm up and out; medial deltoid activity in the press was close to the lateral raise (Campos 2020).",
      "triceps_r": "Straightens the elbow in the top half.",
      "triceps_l": "Straightens the elbow in the top half.",
      "upper_traps_r": "Upward rotation and elevation of the shoulder blade overhead.",
      "upper_traps_l": "Upward rotation and elevation of the shoulder blade overhead.",
      "serratus_r": "Upward rotation of the shoulder blade so the arm can reach fully overhead.",
      "serratus_l": "Upward rotation of the shoulder blade so the arm can reach fully overhead.",
      "obliques_r": "Resist side-bending toward the band. Unilateral standing presses raised external oblique activity well above bilateral presses (Saeterbakken 2012).",
      "obliques_l": "Resist side-bending toward the band. Unilateral standing presses raised external oblique activity well above bilateral presses (Saeterbakken 2012).",
      "core": "Keeps the ribs down and the trunk stacked over the pelvis; standing presses used far more abdominal activity than seated (Saeterbakken 2012).",
      "spinal_extensors_r": "Hold the spine tall; erector spinae activity was higher in the unilateral standing press (Saeterbakken 2012).",
      "spinal_extensors_l": "Hold the spine tall; erector spinae activity was higher in the unilateral standing press (Saeterbakken 2012).",
      "infraspinatus_r": "Rotator cuff: centres the ball of the shoulder as the arm rises.",
      "infraspinatus_l": "Rotator cuff: centres the ball of the shoulder as the arm rises.",
      "post_deltoid_r": "Steadies the shoulder.",
      "post_deltoid_l": "Steadies the shoulder.",
      "glute_med_r": "Keeps the pelvis level against the one-sided load over the staggered stance.",
      "glute_med_l": "Keeps the pelvis level against the one-sided load over the staggered stance."
    }
  },
