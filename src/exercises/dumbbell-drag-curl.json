      "title": "Dumbbell Drag Biceps Curl",
      "url": "https://gymvisual.com/videos/9373-dumbbell-drag-biceps-curl.html",
      "listing": "Video; data sheet: body part Upper Arms, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "equipment": [
      "Dumbbell"
    ],
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight. Use less weight than for a standard curl; the dumbbells must stay in contact with the body (clinical opinion)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, dumbbells in front of the thighs, palms forward, handles touching the legs."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and drag the dumbbells straight up the front of the body: the elbows travel back, not forward."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze at the lower chest, elbows behind the trunk, shoulders down and back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and slide the dumbbells back down the body to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight, handles at the thighs, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the elbows swing forward (it turns into a normal curl)",
        "fix": "Think \"elbows back\": the dumbbells stay against the body all the way up."
      },
      {
        "id": "m2",
        "mistake": "Shrugging or rolling the shoulders forward at the top",
        "fix": "Keep the chest up and the shoulders down and back."
      },
      {
        "id": "m3",
        "mistake": "Leaning back to start the weight",
        "fix": "Brace the trunk; lighten the dumbbells."
      },
      {
        "id": "m4",
        "mistake": "Dumbbells drifting away from the body",
        "fix": "Keep the handles brushing the thighs and abdomen."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈27° (arm straight)",
        "peak": "≈134° at the top (range ≈107°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "-25.7° (palm forward/up)",
        "peak": "-7.1° (palm forward/up)",
        "norm": "The supinated grip gave the highest biceps activity in the lifting phase; neutral grips shift work toward the brachioradialis (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-10°",
        "peak": "≈-52° (elbow behind the trunk line)",
        "norm": "The upper arm moves back behind the trunk line (shoulder extension) as the dumbbells rise, the defining feature of the drag curl (clinical opinion); shoulder-extended curls load the biceps long head at long lengths (Attarieh 2025)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms straight 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Dumbbell path",
        "setup": "Handle at 79.4 cm high, 13.3 cm in front of the pelvis centre",
        "peak": "Handle at 117 cm high (lower chest), 14.8 cm forward: rises 37.6 cm, moves 1.5 cm fore-aft",
        "norm": "Vertical path close to the body with the elbows travelling back (clinical opinion; no kinematic study of the drag curl was found)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #368712, Dumbbell Drag Biceps Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/9373-dumbbell-drag-biceps-curl.html"
      },
      {
        "id": "attarieh2025",
        "title": "Attarieh, Nunes, Khani, Negahdar, Goli, Nazarirad, Nazarirad, Mojtahedi, Nosaka and Soori 2025, shoulder flexed versus extended elbow-flexion training: preacher versus Bayesian cable curls, regional hypertrophy and strength (Eur J Sport Sci 25(4):e12279; PMC11906226)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11906226/"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29; PMC3737788)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the dumbbell and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Pick the dumbbells up and set them down with a straight back and bent knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Front-of-shoulder discomfort as the elbows go back: shorten the pull and keep the shoulders down (clinical opinion)."
      ],
      "modify": [
        "Shoulder discomfort: reduce how far the elbows travel back.",
        "Elbow pain: lighter load."
      ],
      "regressions": [
        "Dumbbell biceps curl.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Slower lowering (3 s).",
        "Pause 1 s at the top."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor; the elbows travel back so the shoulder ends in extension, the same shoulder-extended position as the incline and Bayesian curls. Extended-shoulder and flexed-shoulder curls built the biceps similarly over 10 weeks (Attarieh 2025).",
      "biceps_l": "Main elbow flexor; the elbows travel back so the shoulder ends in extension, the same shoulder-extended position as the incline and Bayesian curls. Extended-shoulder and flexed-shoulder curls built the biceps similarly over 10 weeks (Attarieh 2025).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder so the upper arm stays put; it rises if the elbow drifts forward.",
      "ant_deltoid_l": "Steadies the shoulder so the upper arm stays put; it rises if the elbow drifts forward.",
      "core": "Keeps the trunk still so the hips do not swing the weight up.",
      "post_deltoid_r": "Draws the elbows back behind the trunk as the dumbbells rise.",
      "post_deltoid_l": "Draws the elbows back behind the trunk as the dumbbells rise.",
      "rhomboids_midtrap_r": "Hold the shoulder blades back so the shoulders do not roll forward as the elbows go back.",
      "rhomboids_midtrap_l": "Hold the shoulder blades back so the shoulders do not roll forward as the elbows go back."
    }
  },
