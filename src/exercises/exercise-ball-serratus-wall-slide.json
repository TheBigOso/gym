{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "exercise-ball-serratus-wall-slide",
    "name": "Exercise Ball Serratus Wall Slide",
    "aliases": [
      "Stability ball wall roll-up",
      "Ball serratus slide",
      "Forearm wall slide on a ball"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "20212",
      "title": "Exercise Ball Serratus Wall Slide",
      "url": "https://gymvisual.com/videos/20212-exercise-ball-serratus-wall-slide.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (serratus anterior)",
    "secondaryBodyParts": [
      "Upper back"
    ],
    "equipment": [
      "Stability ball",
      "Wall"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder flexion with scapular protraction)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "serratus_r",
        "serratus_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "stabilizer": [
        "core",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "lengthened": [
        "lats_r",
        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the ball rolls up, inhale as it rolls down.",
      "cadence": "About 1.5 s up, 0.5 s hold, 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "1.5-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Lift the forearms off the ball at the top, or add a mini band around the wrists"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Face the wall, pin the ball against it with both forearms, elbows bent, palms facing each other."
      },
      {
        "id": "c2",
        "phase": "up",
        "text": "Breathe out, press into the ball and roll it up the wall, letting the shoulder blades wrap forward."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Reach a little higher without shrugging; ribs down."
      },
      {
        "id": "c4",
        "phase": "down",
        "text": "Breathe in and roll the ball back down slowly, keeping the pressure on."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the ball pinned; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the shoulders down away from the ears; reach forward and up."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back",
        "fix": "Ribs down, glutes lightly on."
      },
      {
        "id": "m3",
        "mistake": "Losing pressure on the ball",
        "fix": "Keep pushing into the ball the whole way."
      },
      {
        "id": "m4",
        "mistake": "Leaning into the wall",
        "fix": "Stand tall; the arms do the work."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder elevation",
        "setup": "≈60° (joint channel)",
        "peak": "≈124°",
        "norm": "From about 50 to 130 degrees (clinical opinion); arm elevation with protraction targets the serratus anterior (Ekstrom 2003)",
        "sources": [
          "ekstrom2003"
        ]
      },
      {
        "measure": "Scapular protraction",
        "setup": "sc protraction 4°",
        "peak": "12°",
        "norm": "Shoulder blades glide forward as the arms rise (Ludewig 2004)",
        "sources": [
          "ludewig2004"
        ]
      },
      {
        "measure": "Elbows",
        "setup": "≈94°",
        "peak": "≈39°",
        "norm": "About 90 degrees, forearms on the ball (standard technique)",
        "sources": []
      },
      {
        "measure": "Ball",
        "setup": "55 cm ball between the forearms and the wall (forearm gap -1.0 to 0.9 cm)",
        "peak": "Rolls 30 cm up the wall",
        "norm": "Rolls up the wall, centre a constant distance from it (standard technique)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Set 0.8 s",
        "peak": "1.4 s up, 0.5 s hold, 1.8 s down",
        "norm": "Controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #20212, Exercise Ball Serratus Wall Slide, video (movement reference)",
        "url": "https://gymvisual.com/videos/20212-exercise-ball-serratus-wall-slide.html"
      },
      {
        "id": "ekstrom2003",
        "title": "Ekstrom, Donatelli & Soderberg 2003, surface electromyographic analysis of exercises for the trapezius and serratus anterior muscles (J Orthop Sports Phys Ther 33(5):247-258)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/12774999/"
      },
      {
        "id": "ludewig2004",
        "title": "Ludewig, Hoff, Osowski, Meschke and Rundquist 2004, relative balance of serratus anterior and upper trapezius muscle activity during push-up exercises (Am J Sports Med 32(2):484-493)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/14977678/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a ball rated for exercise, inflated firm.",
        "Shoulder pinching at the top: stop lower."
      ],
      "modify": [
        "Smaller range."
      ],
      "regressions": [
        "Wall slide without the ball."
      ],
      "progressions": [
        "Mini band around the wrists.",
        "Lift-off at the top."
      ]
    },
    "muscleNotes": {
      "serratus_r": "Protracts and upwardly rotates the shoulder blade as the arms rise against the ball; wall slides and elevation with protraction are serratus anterior favourites (Ekstrom 2003; Ludewig 2004).",
      "serratus_l": "Protracts and upwardly rotates the shoulder blade as the arms rise (Ekstrom 2003; Ludewig 2004).",
      "ant_deltoid_r": "Raises the arm (clinical opinion).",
      "ant_deltoid_l": "Raises the arm (clinical opinion).",
      "upper_traps_r": "Assists upward rotation; keep it from shrugging (Ludewig 2004).",
      "upper_traps_l": "Assists upward rotation; keep it from shrugging (Ludewig 2004).",
      "core": "Stops the ribs flaring as the arms go up (clinical opinion).",
      "rhomboids_midtrap_r": "Control the shoulder blade on the way down (clinical opinion).",
      "rhomboids_midtrap_l": "Control the shoulder blade on the way down (clinical opinion).",
      "lats_r": "Lengthen as the arms rise (clinical opinion).",
      "lats_l": "Lengthen as the arms rise (clinical opinion)."
    }
  },
