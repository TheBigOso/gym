    "id": "suspender-chest-press",
    "name": "Suspender Chest Press",
    "aliases": [
      "Suspension chest press",
      "TRX chest press",
      "Suspension push-up (standing)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14234",
      "title": "Suspender Chest Press",
      "url": "https://gymvisual.com/videos/14234-suspender-chest-press.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Front shoulders",
      "Triceps",
      "Core"
    ],
    "equipment": [
      "Suspension trainer straps",
      "Pull-up bar (anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "triceps_r",
        "triceps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "core",
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "lengthened": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the chest lowers between the hands, breathe out as you press back up.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-15",
      "tempo": "2-0-1-1",
      "load": "Bodyweight; set the body angle so the last reps are hard with 1-3 reps in reserve (RIR 1-3, clinical opinion)",
      "frequency": "2-3 times a week",
      "progression": "Walk the feet back toward the anchor so the body leans further"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Face away from the anchor, a handle in each hand in front of the chest, arms long; lean forward on the balls of the feet, body straight."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the chest between the hands, elbows about 45 degrees from the body."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Hands beside the chest; keep the straps off the arms and the body in one line."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the handles forward until the arms are long."
      },
      {
        "id": "c5",
        "phase": "top",
        "text": "Keep the ribs down and the glutes tight; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging",
        "fix": "Brace the abs and squeeze the glutes."
      },
      {
        "id": "m2",
        "mistake": "Hands drifting apart",
        "fix": "Keep the handles in line with the chest; press them straight."
      },
      {
        "id": "m3",
        "mistake": "Straps rubbing on the arms",
        "fix": "Keep the hands a little wider than the shoulders so the straps run outside the arms."
      },
      {
        "id": "m4",
        "mistake": "Shoulders rolling forward at the bottom",
        "fix": "Keep the chest up and stop at a comfortable depth."
      }
    ],
    "kinematics": [
      {
        "measure": "Body angle",
        "setup": "≈50° above the floor with the arms long, on the balls of the feet",
        "peak": "≈42° at the bottom of the press (the body turns about the feet)",
        "norm": "Leaning further forward makes the press harder (more of the body weight on the hands, clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈28° (arms long)",
        "peak": "≈110° with the hands beside the chest",
        "norm": "From nearly straight to about 90 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Straps",
        "setup": "One strap per hand, 156.8 cm from anchors behind the athlete, 76 cm apart",
        "peak": "27-42° from vertical; at least 4.5 cm off the body",
        "norm": "Straps stay taut; the hands stay on the strap arcs about the anchor behind the athlete (geometry)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms long 0.5 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up",
        "norm": "About 2 s down, 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #14234, Suspender Chest Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/14234-suspender-chest-press.html"
      },
      {
        "id": "calatayud2015",
        "title": "Calatayud, Borreani, Colado, Martin, Tella and Andersen 2015, bench press and push-up at comparable levels of muscle activity results in similar strength gains (J Strength Cond Res 29(1):246-253; elastic-band push-ups)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Calatayud+2015+bench+press+push-up+comparable+levels+muscle+activity"
      },
      {
        "id": "ludewig2004",
        "title": "Ludewig, Hoff, Osowski, Meschke and Rundquist 2004, relative balance of serratus anterior and upper trapezius muscle activity during push-up exercises (Am J Sports Med 32(2):484-493)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/14977678/"
      }
    ],
    "safety": {
      "cautions": [
        "Check the anchor and the straps before each set.",
        "Shoulder pain: lean less and shorten the range (clinical opinion).",
        "Keep a split stance at first so you can step out if the hands slip.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Staggered stance for balance."
      ],
      "regressions": [
        "Stand more upright.",
        "Incline push-up on a bench."
      ],
      "progressions": [
        "Feet closer to the anchor.",
        "Single-leg stance."
      ]
    },
    "muscleNotes": {
      "pec_r": "Brings the upper arm across and forward (pressing).",
      "pec_l": "Brings the upper arm across and forward (pressing).",
      "ant_deltoid_r": "Raises the upper arm forward.",
      "ant_deltoid_l": "Raises the upper arm forward.",
      "triceps_r": "Straightens the elbow.",
      "triceps_l": "Straightens the elbow.",
      "serratus_r": "Moves the shoulder blade forward around the ribs and holds it to the chest wall.",
      "serratus_l": "Moves the shoulder blade forward around the ribs and holds it to the chest wall.",
      "core": "Braces the trunk so the body stays in one line.",
      "glute_max_r": "Keeps the hips extended in line with the body.",
      "glute_max_l": "Keeps the hips extended in line with the body.",
      "quads_r": "Keep the knees straight.",
      "quads_l": "Keep the knees straight.",
      "spinal_extensors_r": "Hold the spine long.",
      "spinal_extensors_l": "Hold the spine long.",
      "infraspinatus_r": "Turns the upper arm out and steadies the shoulder.",
      "infraspinatus_l": "Turns the upper arm out and steadies the shoulder."
    }
  },
