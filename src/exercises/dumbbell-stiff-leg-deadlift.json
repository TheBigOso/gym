    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: prefer the soft-knee Romanian deadlift and a shorter range; seek advice if pain persists.",
        "Hamstring strain history: build the range gradually."
      ],
      "modify": [
        "Tight hamstrings: stop at the knees or bend the knees a little more (Romanian deadlift)."
      ],
      "regressions": [
        "Dumbbell Romanian deadlift.",
        "Shorter range.",
        "Bodyweight hip hinge with a dowel on the back."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Pause at the bottom.",
        "Single-leg RDL."
      ]
    },
    "muscleNotes": {
      "hamstrings_r": "With the knees nearly straight the hamstrings are stretched further at the bottom than in the soft-knee RDL; straight-knee hinges like the RDL gave some of the highest hamstring activity of the exercises tested by McAllister 2014.",
      "hamstrings_l": "With the knees nearly straight the hamstrings are stretched further at the bottom than in the soft-knee RDL; straight-knee hinges like the RDL gave some of the highest hamstring activity of the exercises tested by McAllister 2014.",
      "glute_max_r": "Extends the hips on the way up; a little less involved than in a conventional deadlift (Lee 2018, RDL).",
      "glute_max_l": "Extends the hips on the way up; a little less involved than in a conventional deadlift (Lee 2018, RDL).",
      "spinal_extensors_r": "Hold the spine neutral against a long lever.",
      "spinal_extensors_l": "Hold the spine neutral against a long lever.",
      "adductors_r": "Adductor magnus assists hip extension.",
      "adductors_l": "Adductor magnus assists hip extension.",
      "forearm_flexors_r": "Grip the dumbbells.",
      "forearm_flexors_l": "Grip the dumbbells.",
      "lats_r": "Keep the dumbbells close to the legs.",
      "lats_l": "Keep the dumbbells close to the legs.",
      "upper_traps_r": "Hold the shoulders against the pull of the dumbbells.",
      "upper_traps_l": "Hold the shoulders against the pull of the dumbbells.",
      "core": "Brace the trunk.",
      "calves_r": "Balance on the whole foot as the hips travel back.",
      "calves_l": "Balance on the whole foot as the hips travel back."
    }
