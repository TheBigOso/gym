        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the top, lower with the brace, breathe out as you stand.",
      "cadence": "About 2.2 s down, short pause, 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-1-1-1",
      "load": "User-chosen dumbbells, usually lighter than for the RDL; stop about 2-3 reps short of failure (RIR 2-3)",
      "frequency": "1-2 times a week",
      "progression": "Add load, then a longer pause in the stretch"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, dumbbells in front of the thighs, knees straight but not locked."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Keep the legs almost straight and hinge at the hips, back flat, dumbbells close to the legs."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop at the lower shin, or as soon as the back wants to round."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the hips forward and stand tall."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall without leaning back; breathe and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back to get the dumbbells lower",
        "fix": "Stop where the back is still flat."
      },
      {
        "id": "m2",
        "mistake": "Locking the knees hard",
        "fix": "Keep a tiny knee bend; the legs are stiff, not locked."
      },
      {
        "id": "m3",
        "mistake": "Letting the weight pull you onto the toes",
        "fix": "Push the hips back and keep the weight over the mid-foot."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈4°",
        "peak": "≈111° (joint channel), trunk ≈5° above horizontal",
        "norm": "Hip hinge to about 100-110 degrees with a flat back, the trunk a little below level (clinical opinion; RDLs reach about 98-103 degrees with soft knees)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈4°",
        "peak": "≈8°",
        "norm": "Knees nearly straight, about 5-10 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar motion",
        "setup": "Neutral",
        "peak": "Spine channels -3°/1°/2° (L5/T12/T6): neutral",
        "norm": "Neutral spine (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.2 s down to a handle height of 26.5 cm (lower shin), 0.3 s pause, 1.3 s up, 1.4 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
