    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Front of the shoulders",
      "Biceps"
    ],
    "equipment": [
      "Dumbbell",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "biceps_r",
        "biceps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "triceps_r",
        "triceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the arms open, exhale as you squeeze them together.",
      "cadence": "About 2.2 s down, 0.4 s on the floor, 1.5 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "2-1-2-0",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9). Use much lighter dumbbells than for the press.",
      "progression": "More reps, then a slower lowering, then the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the mat, knees bent and feet flat; dumbbells together over the chest, palms facing each other, elbows softly bent."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and open the arms in a wide arc, keeping the same soft elbow bend."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Backs of the upper arms touch the floor lightly; palms face the ceiling."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and squeeze the chest to sweep the dumbbells back up along the same arc."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Bring them together without clanging; keep the elbow bend."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Turning it into a press (elbows bending and straightening)",
        "fix": "Fix a soft elbow bend at the top and keep it all the way down and up."
      },
      {
        "id": "m2",
        "mistake": "Dropping the arms onto the floor",
        "fix": "Lower slowly and let the upper arms only touch the floor."
      },
      {
        "id": "m3",
        "mistake": "Locked straight elbows",
        "fix": "Keep a soft bend (elbows at about 150-160 degrees)."
      },
      {
        "id": "m4",
        "mistake": "Too heavy a weight",
        "fix": "The fly needs much lighter dumbbells than the press (Solstad 2020)."
      },
      {
        "id": "m5",
        "mistake": "Arms opening toward the head",
        "fix": "Open the arms out to the sides, a little toward the hips, in line with the chest."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈22° flexion (elbow angle ≈158°)",
        "peak": "≈22° at the bottom; 22-22° through the loop",
        "norm": "Fixed soft bend: Solstad 2020 held the elbow at about 150-160 degrees (20-30 degrees of flexion) in the bench fly",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Arm opening (upper arm from vertical)",
        "setup": "Upper arm ≈3° from vertical",
        "peak": "≈102° from vertical at the bottom, 14° toward the hips",
        "norm": "From over the chest down until the upper arms rest on the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm on the floor",
        "setup": "–",
        "peak": "Arm shapes 0.1 cm above the floor, dumbbells 1.9 cm; upper arm ≈13° below the back plane",
        "norm": "The floor stops the arms at about body level: less stretch than the bench fly (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral; dumbbells 6.2 cm apart at the top",
        "peak": "Palms up at the bottom; dumbbell centres 151.2 cm apart, 9.2 cm above the floor",
        "norm": "Neutral: palms face each other at the top and the ceiling at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈80°, feet 32 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat, knees bent about 70-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2.2 s down, 0.4 s on the floor, 1.5 s up, 0.6 s squeeze",
        "norm": "Slow and controlled; about 2 s down and 1.5-2 s up (clinical opinion; Solstad 2020 used a controlled tempo)",
        "sources": [
          "solstad2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #414912, Dumbbell Floor Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/9374-dumbbell-floor-fly.html"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      },
      {
        "id": "welsch2005",
        "title": "Welsch, Bird and Mayhew 2005, electromyographic activity of the pectoralis major and anterior deltoid muscles during three upper-body lifts (J Strength Cond Res 19(2):449-452)",
        "url": "https://www.bisp-surf.de/Record/PU201204002593"
      }
    ],
    "safety": {
      "cautions": [
        "Get into position safely: sit with the dumbbells on the thighs, roll back with them held at the chest, and at the end of the set roll them back onto the thighs rather than dropping them beside the head (clinical opinion).",
        "Let the upper arms touch the floor softly; do not bang the elbows down or bounce off the floor.",
        "Keep the wrists straight over the forearms.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: smaller arc, stop above the floor.",
        "Elbow discomfort: a little more elbow bend and lighter dumbbells."
      ],
      "regressions": [
        "Band fly.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Dumbbell fly on a bench (more stretch).",
        "Slower lowering.",
        "Heavier dumbbells."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main mover: hugs the upper arms across the chest. In the bench fly pectoralis activity was lower than the press mostly in the stretched part of the lowering (Solstad 2020); on the floor that deepest part is cut off because the upper arms stop on the floor (clinical opinion).",
      "pec_l": "Main mover: hugs the upper arms across the chest. In the bench fly pectoralis activity was lower than the press mostly in the stretched part of the lowering (Solstad 2020); on the floor that deepest part is cut off because the upper arms stop on the floor (clinical opinion).",
      "ant_deltoid_r": "Helps bring the arms together (about 25% lower than in the bench press, Solstad 2020, bench fly).",
      "ant_deltoid_l": "Helps bring the arms together (about 25% lower than in the bench press, Solstad 2020, bench fly).",
      "biceps_r": "Holds the fixed elbow bend against the load; biceps activity was about 76% higher in the fly than in the bench press (Solstad 2020).",
      "biceps_l": "Holds the fixed elbow bend against the load; biceps activity was about 76% higher in the fly than in the bench press (Solstad 2020).",
      "serratus_r": "Keeps the shoulder blades on the rib cage.",
      "serratus_l": "Keeps the shoulder blades on the rib cage.",
      "triceps_r": "Light work holding the elbow angle.",
      "triceps_l": "Light work holding the elbow angle.",
      "forearm_flexors_r": "Grip the handles, palms facing each other.",
      "forearm_flexors_l": "Grip the handles, palms facing each other.",
      "infraspinatus_r": "Steadies the head of the upper arm as the arms open.",
      "infraspinatus_l": "Steadies the head of the upper arm as the arms open.",
      "core": "Keeps the ribs down and the back flat."
    }
  },
