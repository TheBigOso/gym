    },
    "breathing": {
      "pattern": "Breathe out as you curl the bar up, breathe in as you lower it.",
      "cadence": "About 1 s up, short squeeze, 2-3 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.3-2.4-0.5 (up-squeeze-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: the arm blaster stops the elbows from swinging, so expect to use less than in a free curl.",
      "progression": "Add reps, then one plate on the stack; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Strap the arm blaster on so the plate sits across the lower chest with the elbows tucked into it. Face the low pulley, feet hip width, knees soft; hold the bar underhand about shoulder width, bar in front of the thighs."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the bar toward the chest; the elbows stay pressed against the blaster."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the biceps at the top without letting the elbows lift off the plate."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the bar is back in front of the thighs, keeping the cable taut."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause, trunk still, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back to swing the bar up",
        "fix": "Stand tall with the knees soft; the blaster only fixes the elbows, not the trunk. Lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders as the bar rises",
        "fix": "Keep the shoulders down and the straps loose on the neck."
      },
      {
        "id": "m3",
        "mistake": "Dropping the bar on the way down",
        "fix": "Lower over 2-3 s; the cable keeps pulling at the bottom."
      },
      {
        "id": "m4",
        "mistake": "Curling the wrists to finish",
        "fix": "Keep the wrists straight in line with the forearms."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈16° (bar resting just in front of the thighs)",
        "peak": "≈134° at the top (range ≈118°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Upper arm",
        "setup": "≈1° from vertical, elbows locked at the sides (arm blaster, not drawn)",
        "peak": "Unchanged (elbows move 0.00 cm over the loop)",
        "norm": "The arm blaster holds the upper arms vertical against the trunk so the elbows cannot drift forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Underhand, 38 cm between the hands on a 50 cm bar",
        "peak": "Unchanged (37.94-38.06 cm)",
        "norm": "Underhand (supinated) grip about shoulder width; the supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Cable",
        "setup": "Low pulley 55 cm in front of the bar, 14 cm high",
        "peak": "Clear of the body by at least 6.41 cm; bar clear by 1.52 cm",
        "norm": "Low pulley in front of the athlete (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms down 0.5 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
