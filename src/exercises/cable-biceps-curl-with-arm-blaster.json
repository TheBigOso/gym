    "safety": {
      "cautions": [
        "Stop if sharp pain in the elbow or shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can curl without leaning back.",
        "Adjust the arm blaster's neck strap so it does not press on the neck.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The arm blaster is not drawn in this animation (no prop exists); the pinned upper arms show its effect."
      ],
      "modify": [
        "Wrist discomfort with the straight bar: use an EZ-bar attachment or a rope.",
        "Elbow pain at the bottom: stop a little short of the lowest position (clinical opinion)."
      ],
      "regressions": [
        "Lighter load.",
        "Cable curl without the blaster, elbows held at the sides.",
        "One-arm cable curl."
      ],
      "progressions": [
        "Slower 3 s lowering.",
        "Pause 1 s halfway up.",
        "Heavier load for 6-10 reps."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Prime mover: bends the elbow against the cable with the palm up. The blaster removes the shoulder swing, so the elbow flexors do the whole lift.",
      "biceps_l": "Prime mover: bends the elbow against the cable with the palm up. The blaster removes the shoulder swing, so the elbow flexors do the whole lift.",
      "forearm_flexors_r": "Grip the bar and help bend the elbow.",
      "forearm_flexors_l": "Grip the bar and help bend the elbow.",
      "forearm_extensors_r": "Hold the wrist straight.",
      "forearm_extensors_l": "Hold the wrist straight.",
      "core": "Keeps the trunk upright so the bar is not swung up by leaning back."
    }
