  "exercise": {
    "id": "bent-knee-lying-twist",
    "name": "Bent-knee Lying Twist",
    "aliases": [
      "Lying knee drop twist",
      "Supine knee-drop rotation",
      "Windshield wipers (bent knee)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "363912",
      "title": "Bent knee Lying Twist (male)",
      "url": "https://gymvisual.com/videos/8654-bent-knee-lying-twist-male.html",
      "listing": "Video; data sheet: body part Hips; Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Core",
      "Hips"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (lower-trunk rotation, hips flexed)",
    "plane": "Transverse",
    "laterality": "Bilateral, alternating sides",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "core"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "adductors_r",
        "adductors_l",
        "lats_r",
        "lats_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the knees lower to the side, exhale as you pull them back to the middle.",
      "cadence": "About 1.5 s down, short pause, about 1.5 s back"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-10 per side",
      "tempo": "About 1.5 s to the side, brief pause, 1.5 s back",
      "frequency": "2-3 times a week",
      "progression": "Larger range, slower tempo, then straight legs (windshield wipers)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms out to the sides palms down. Lift the legs so the hips and knees are bent about 90 degrees, knees together."
      },
      {
        "id": "c2",
        "phase": "lowerR",
        "text": "Breathe in and lower both knees slowly to the right; the left shoulder stays heavy on the mat."
      },
      {
        "id": "c3",
        "phase": "backR",
        "text": "Pause, breathe out and pull the knees back over the hips with the obliques."
      },
      {
        "id": "c4",
        "phase": "lowerL",
        "text": "Lower to the left only as far as both shoulders stay down."
      },
      {
        "id": "c5",
        "phase": "backL",
        "text": "Breathe out and return to the middle without swinging."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the legs drop and bounce off the floor",
        "fix": "Lower in about 1.5 s and stop before you lose control."
      },
      {
        "id": "m2",
        "mistake": "The opposite shoulder lifting off the mat",
        "fix": "Shorten the range; press both arms into the floor."
      },
      {
        "id": "m3",
        "mistake": "Knees and feet separating",
        "fix": "Squeeze the knees together."
      },
      {
        "id": "m4",
        "mistake": "Low back arching as the legs travel",
        "fix": "Brace gently and keep the ribs down."
      }
    ],
    "kinematics": [
      {
        "measure": "Pelvis roll (knees to the side)",
        "setup": "Knees over the hips",
        "peak": "Pelvis rolled ≈51° to each side; knees 26 cm above the floor (from 42)",
        "norm": "As far as the shoulders stay down; no study defines the range (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk rotation",
        "setup": "Neutral",
        "peak": "≈51° between pelvis and upper back (lumbar ≈6°, lower and mid thoracic ≈45°)",
        "norm": "Shared by the lumbar and thoracic spine while the upper back stays on the mat; the lumbar segments rotate only a little (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hips and knees",
        "setup": "Hips ≈90°, knees ≈90° (tabletop)",
        "peak": "Unchanged; knees stay together",
        "norm": "Held at about 90 degrees (tabletop) (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulders and arms",
        "setup": "Arms out in a T, palms down",
        "peak": "Shoulders and upper back stay down (T6 moves 0.7 cm)",
        "norm": "Arms out in a T, shoulders down (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Centre 0.6 s",
        "peak": "1.6 s down to the side, 0.5 s pause, 1.5 s back through the middle, each side; 8.2 s loop",
        "norm": "Slow and controlled, about 1.5 s each way (clinical opinion)",
        "sources": []
      }
    ],
