        "pec_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "forearm_extensors_r",
        "forearm_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the arms rise overhead, breathe out as they come down.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12",
      "effort": "Easy to moderate: smooth, full range (RPE 5-7)",
      "tempo": "2-0.4-2-0.3 (up-pause-down-pause, seconds)",
      "rest": "45-60 s",
      "frequency": "2-3 times a week, or in a warm-up",
      "load": "User-chosen dumbbells; very light (1-5 kg): the straight arm is a long lever",
      "progression": "Add reps or slow the tempo before adding weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, light dumbbells in front of the thighs, palms facing forward, elbows soft."
      },
      {
        "id": "c2",
        "phase": "up",
        "text": "Breathe in and sweep the arms out to the sides and up in a big arc, palms turning up."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Bring the dumbbells together overhead without arching the low back; ribs down."
      },
      {
        "id": "c4",
        "phase": "down",
        "text": "Reverse the arc slowly back down to the thighs."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause in front of the thighs and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to get the arms overhead",
        "fix": "Brace, ribs down; stop the arc where the shoulders run out of range."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders up early",
        "fix": "Keep the shoulders down until the arms pass shoulder height."
      },
      {
        "id": "m3",
        "mistake": "Using weights that are too heavy",
        "fix": "Go light; the arms stay nearly straight the whole way."
      },
      {
        "id": "m4",
        "mistake": "Bending the elbows a lot",
        "fix": "Keep a soft, fixed elbow bend."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder elevation (humerus)",
        "setup": "≈8° (dumbbells in front of the thighs)",
        "peak": "≈171° overhead (hands 27 cm apart at the wrists)",
        "norm": "From the arms in front of the thighs to overhead; healthy men aged 20-44 averaged about 169 degrees of shoulder flexion (Soucie 2011)",
        "sources": [
          "soucie2011"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "arms in front (flexion plane)",
        "peak": "≈18° in front of the frontal plane at shoulder height",
        "norm": "Arms out to the sides, a little in front of the body (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Humeral rotation",
        "setup": "palms forward",
        "peak": "palms up at shoulder height, facing each other overhead",
        "norm": "Palms forward at the bottom, up at shoulder height, facing each other overhead (outward rotation as the arms rise; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈15°",
        "peak": "≈15°",
        "norm": "Soft and constant, about 10-20 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the thighs",
        "peak": "2.0 s up, 0.4 s overhead, 2.0 s down",
        "norm": "Slow and smooth, about 2 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #656312, Bodyweight Standing Around the World (female), video (movement reference)",
        "url": "https://gymvisual.com/videos/16483-bodyweight-standing-around-the-world-female.html"
      },
      {
        "id": "soucie2011",
        "title": "Soucie, Wang, Forsyth, Funk, Denney, Roach, Boone and the Hemophilia Treatment Center Network 2011, range of motion measurements: reference values and a database for comparison studies (Haemophilia 17(3):500-507); values from the CDC Joint Range of Motion Study page",
        "url": "https://archive.cdc.gov/www_cdc_gov/ncbddd/jointrom/index.html"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "No EMG study of the standing around the world was found; the muscle roles are from anatomy (clinical opinion)."
      ],
      "modify": [
        "Pinch in the shoulder overhead: stop the arc at shoulder height (a full lateral raise) or bend the elbows more.",
        "Low-back discomfort: do it seated on a bench."
      ],
      "regressions": [
        "No weight (bodyweight version).",
        "Seated around the world.",
        "Lying around the world on the floor."
      ],
      "progressions": [
        "Slower tempo with a pause overhead.",
        "Slightly heavier dumbbells.",
        "Half-kneeling version (more trunk control)."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Raises the arms out to the sides through the middle of the arc (clinical opinion).",
      "lat_deltoid_l": "Raises the arms out to the sides through the middle of the arc (clinical opinion).",
      "ant_deltoid_r": "Works with the palms turned up, and lifts the arms from shoulder height to overhead (clinical opinion).",
      "ant_deltoid_l": "Works with the palms turned up, and lifts the arms from shoulder height to overhead (clinical opinion).",
      "upper_traps_r": "Rotates the shoulder blades up so the arms can reach overhead.",
      "upper_traps_l": "Rotates the shoulder blades up so the arms can reach overhead.",
      "serratus_r": "Rotates the shoulder blades up and holds them on the ribs overhead.",
      "serratus_l": "Rotates the shoulder blades up and holds them on the ribs overhead.",
      "infraspinatus_r": "Turns the upper arm out so the palms face up as the arms pass shoulder height.",
      "infraspinatus_l": "Turns the upper arm out so the palms face up as the arms pass shoulder height.",
      "pec_r": "The upper fibres help bring the arms together overhead and in front of the thighs.",
      "pec_l": "The upper fibres help bring the arms together overhead and in front of the thighs.",
      "core": "Keeps the ribs down so the arms, not the low back, make the overhead range.",
      "spinal_extensors_r": "Hold the trunk tall.",
      "spinal_extensors_l": "Hold the trunk tall.",
      "forearm_extensors_r": "Hold the wrists straight.",
      "forearm_extensors_l": "Hold the wrists straight."
    }
