      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "synergist": [
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l",
        "infraspinatus_r",
        "infraspinatus_l",
