      "title": "Lever Lying Single Leg Curl",
      "url": "https://gymvisual.com/videos/11445-lever-lying-single-leg-curl.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (gymvisual.com refused the request), so the data sheet was not read and the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (hamstrings)",
    "secondaryBodyParts": [
      "Calves"
    ],
    "equipment": [
      "Lying leg curl machine (prone bench, lever on the knee axis, heel roller)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (knee flexion), unilateral",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "hamstrings_r"
      ],
      "synergist": [
        "calves_r"
      ],
      "stabilizer": [
        "glute_max_r",
        "glute_max_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "hamstrings_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl, breathe in as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.3 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 each side",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "tempo": "1.2-0.6-2.3-0.4 (lift-hold-lower-pause, seconds)",
      "load": "Stack load is user-chosen: curl without the hips lifting off the bench.",
      "progression": "Add reps, then load; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down with the knees just off the end of the pad, the right knee lined up with the lever axis and the roller behind the right lower calf; hold the front handles."
      },
      {
        "id": "c2",
        "phase": "work",
        "text": "Breathe out and curl the right heel toward the buttock; the left leg stays long."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the hamstrings with the knee well bent; hips stay on the bench."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and lower under control until the leg is nearly straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause without letting the stack rest; switch legs after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips lifting off the bench",
        "fix": "Press the hips into the pad; lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Knee off the lever axis",
        "fix": "Slide so the knee joint sits on the pivot line."
      },
      {
        "id": "m3",
        "mistake": "Swinging the leg up",
        "fix": "Curl smoothly and pause at the top."
      },
      {
        "id": "m4",
        "mistake": "Dropping the leg",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈6° with the leg long",
        "peak": "≈115° at the top of the curl",
        "norm": "From nearly straight to well bent, the heel toward the buttock (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee axis",
        "setup": "Lever pivot on the right knee (-40.6, 86.4 cm)",
        "peak": "Roller within 0.02 cm of its arc",
        "norm": "Lever pivot on the knee joint so the roller stays on the calf (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Roller",
        "setup": "Behind the right calf, 84% of the way from knee to ankle",
        "peak": "Lever 109° up",
        "norm": "Behind the lower calf above the heel (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip",
        "setup": "Prone on the 72 cm pad, hips extended; knees just off its end",
        "peak": "Unchanged; left leg stays long",
        "norm": "Lying prone, hips extended on the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hamstring EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Lying leg curls load the hamstrings well (McAllister 2014)",
        "sources": [
          "mcallister2014"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the leg long",
        "peak": "1.2 s up, 0.6 s squeeze, 2.3 s down",
        "norm": "About 1.2 s up and 2.3 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
