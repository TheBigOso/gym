    "id": "lever-lying-single-leg-curl",
    "name": "Lever Lying Single Leg Curl",
    "aliases": [
      "One-leg lying leg curl",
      "Prone single-leg hamstring curl",
      "Machine lying leg curl, one leg"
    ],
    "reference": {
      "source": "GymVisual",
