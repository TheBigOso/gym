    "breathing": {
      "pattern": "Breathe in and brace at the shoulder, breathe out as you press, breathe in as you lower.",
      "cadence": "About 1.4 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-10 per arm",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0-1.5-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s between arms",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; one dumbbell",
      "progression": "Add reps, then weight; tall-kneeling or standing single-arm press"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel tall on both knees, hip-width apart, toes tucked, thighs vertical. Squeeze both glutes, ribs down. Dumbbell at the right shoulder, palm facing forward; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press the dumbbell straight up, without leaning away from it."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arm nearly straight, biceps by the ear, wrist stacked over the shoulder; trunk still tall."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower under control to the shoulder in about 2 s."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brace again and repeat; switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning away from the dumbbell or arching the low back",
        "fix": "Squeeze both glutes, keep the ribs down; use a lighter weight."
      },
      {
        "id": "m2",
        "mistake": "Sitting back toward the heels or hips drifting forward",
        "fix": "Keep the thighs vertical and the hips stacked over the knees."
      },
      {
        "id": "m3",
        "mistake": "Pressing out in front of the head",
        "fix": "Finish with the dumbbell over the shoulder, biceps near the ear."
      },
      {
        "id": "m4",
        "mistake": "Shrugging at the bottom",
        "fix": "Start with the shoulder down and the elbow under the wrist."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance",
        "setup": "both knees down, knee angle 105° (toes tucked), thighs about vertical (hip -4°), knees 33.3 cm apart",
        "peak": "unchanged",
        "norm": "Tall-kneeling: both knees under the hips about hip-width apart, thighs about vertical, toes tucked (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation (humerus)",
        "setup": "≈75°",
        "peak": "≈169°",
        "norm": "Upper arm about level at the bottom to about 160-170 degrees overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈106°",
        "peak": "≈7°",
        "norm": "About 90 degrees or more at the bottom (forearm vertical), nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk lean",
        "setup": "vertical",
        "peak": "vertical (held)",
        "norm": "Trunk stays vertical; a unilateral load raises oblique and back-stabilizer activity to resist side bending (Saeterbakken 2012; Trunk 2005)",
        "sources": [
          "saeterbakken2012",
          "trunk2005"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Brace 0.8 s at the shoulder",
        "peak": "1.4 s up, 0.4 s at the top, 2.0 s down",
        "norm": "Controlled, about 1.5 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
