  "exercise": {
    "id": "hollow-hold",
    "name": "Hollow Hold",
    "aliases": [
      "Hollow body hold",
      "Hollow position",
      "Dish hold",
      "Banana hold"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "124612",
      "title": "Hollow Hold",
      "url": "https://gymvisual.com/videos/11199-hollow-hold.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isometric (anti-extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l",
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Keep breathing in small, steady breaths behind a braced belly; do not hold the breath.",
      "cadence": "Short breaths through the hold, about 3-4 s per breath"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "1 hold per set",
      "tempo": "Hold 10-30 s (start with 10-20 s), rest 30-60 s",
      "frequency": "2-4 times a week",
      "progression": "Tuck hollow, then one leg straight, then arms by the sides, then full hollow with arms overhead; then hollow rocks"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, legs together, arms overhead. Press the low back into the mat."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Tuck the chin slightly and lift the shoulder blades and the straight legs a few centimetres off the mat."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold the banana shape: low back glued down, ribs down, arms by the ears, toes pointed. Keep breathing."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the legs and shoulders together, slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest briefly, then lift again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back peeling off the mat (arching)",
        "fix": "Raise the legs higher, bend the knees (tuck hollow) or bring the arms to the sides."
      },
      {
        "id": "m2",
        "mistake": "Holding the breath",
        "fix": "Small steady breaths; shorten the hold if you cannot breathe."
      },
      {
        "id": "m3",
        "mistake": "Cranking the chin to the chest",
        "fix": "Small chin tuck; eyes toward the toes."
      },
      {
        "id": "m4",
        "mistake": "Legs and shoulders lifted too high (sit-up shape)",
        "fix": "Only a few centimetres off the mat: the lower the levers, the harder the hold."
      },
      {
        "id": "m5",
        "mistake": "Bent knees or flexed ankles drifting in",
        "fix": "Squeeze the legs together, knees straight, toes pointed."
      }
    ],
    "kinematics": [
      {
        "measure": "Low back",
        "setup": "Lumbar segment ≈0°, pelvis pitch ≈5°",
        "peak": "Lumbar segment ≈12° flexion, pelvis tucked ≈1° more (posterior tilt); low back on the mat",
        "norm": "Pressed into the mat with a posterior pelvic tilt (Drysdale 2004; standard coaching cue)",
        "sources": [
          "drysdale2004"
        ]
      },
      {
        "measure": "Leg lift",
        "setup": "Legs on the mat",
        "peak": "Hip ≈18°, legs ≈22° above level, heels 19 cm off the mat",
        "norm": "Straight legs a few centimetres to about 30 degrees off the floor; lower is harder (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder lift",
        "setup": "Upper back on the mat",
        "peak": "Shoulder blades 11 cm off the mat (thoracic segments ≈32°)",
        "norm": "Shoulder blades just clear of the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Overhead, shoulder ≈200°, resting",
        "peak": "Shoulder ≈185°, hands 19 cm off the mat",
        "norm": "Overhead beside the ears, off the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hold time",
        "setup": "Lie 0.8 s",
        "peak": "1.2 s lift, 6.4 s hold with two breath settles, 1 s lower; 10 s loop",
        "norm": "10-30 s holds are typical coaching practice (clinical opinion); the loop shows a short hold",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #124612, Hollow Hold, video (movement reference)",
        "url": "https://gymvisual.com/videos/11199-hollow-hold.html"
      },
      {
        "id": "drysdale2004",
        "title": "Drysdale, Earl and Hertel 2004, surface EMG of the abdominal muscles during pelvic-tilt and abdominal-hollowing exercises (J Athl Train 39(1):32-36)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC385259/"
      },
      {
        "id": "oliva2020",
        "title": "Oliva-Lozano and Muyor 2020, core muscle activity during physical fitness exercises: a systematic review (Int J Environ Res Public Health 17(12):4306)",
        "url": "https://www.mdpi.com/1660-4601/17/12/4306"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "No study measured the hollow hold itself; the muscle notes lean on pelvic-tilt and V-sit data.",
        "Holding the breath under effort raises blood pressure: keep breathing, and avoid long breath-held efforts with uncontrolled high blood pressure."
      ],
      "modify": [
        "Low back arches: tuck the knees in or raise the legs higher.",
        "Neck fatigue: rest the head down and keep only the legs up.",
        "Pregnancy, postpartum or diastasis recti: swap for dead bugs until cleared."
      ],
      "regressions": [
        "Tuck hollow (knees bent over the hips).",
        "Arms by the sides or reaching to the knees.",
        "One leg straight, one bent."
      ],
      "progressions": [
        "Lower legs and arms closer to the floor.",
        "Longer holds (30-60 s).",
        "Hollow rocks."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis and transversus abdominis hold the posterior pelvic tilt that keeps the low back pressed down while the long levers of the arms and legs pull it toward an arch. Pelvic tilting with the legs unsupported produced the highest rectus abdominis and external oblique activity in Drysdale 2004. Closely related V-sits reached about 80% MVIC of rectus abdominis (Maeo 2013, via Oliva-Lozano 2020).",
      "hip_flexors_r": "Iliopsoas and rectus femoris hold the straight legs off the floor; their pull on the pelvis is what the abdominals resist (clinical opinion).",
      "hip_flexors_l": "Iliopsoas and rectus femoris hold the straight legs off the floor; their pull on the pelvis is what the abdominals resist (clinical opinion).",
      "obliques_r": "Assist rectus abdominis in holding the ribs down and the pelvis tilted (Drysdale 2004: external oblique highest with the legs unsupported).",
      "obliques_l": "Assist rectus abdominis in holding the ribs down and the pelvis tilted (Drysdale 2004: external oblique highest with the legs unsupported).",
      "quads_r": "Keep the knees locked straight (clinical opinion).",
      "quads_l": "Keep the knees locked straight (clinical opinion).",
      "ant_deltoid_r": "Front deltoid holds the arms overhead off the floor (clinical opinion).",
      "ant_deltoid_l": "Front deltoid holds the arms overhead off the floor (clinical opinion)."
    }
  },
