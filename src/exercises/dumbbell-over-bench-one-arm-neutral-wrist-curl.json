    "id": "dumbbell-over-bench-one-arm-neutral-wrist-curl",
    "name": "Dumbbell Over Bench One Arm Neutral Wrist Curl",
    "aliases": [
      "Kneeling one-arm hammer wrist curl",
      "Over-bench radial deviation curl",
      "One-arm thumbs-up wrist curl on a bench"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "18527",
      "title": "Dumbbell Over Bench One Arm Neutral Wrist Curl",
      "url": "https://gymvisual.com/videos/18527-dumbbell-over-bench-one-arm-neutral-wrist-curl.html",
      "listing": "Page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Forearms",
    "secondaryBodyParts": [],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (wrist, radial deviation)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "forearm_extensors_r",
        "forearm_flexors_r"
      ],
      "synergist": [],
      "stabilizer": [
        "biceps_r",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the hands curl up, inhale as they lower.",
      "cadence": "About 1 s up, 0.4 s squeeze, 1.7 s down"
    },
    "prescription": {
      "sets": "2-3 per arm",
      "reps": "12-20",
      "load": "Dumbbell load is user-chosen: pick a weight you can control through the full range for every rep with 1-3 reps in reserve (RPE 7-9). Wrist curls need a light dumbbell.",
      "tempo": "1-0-2-0 (up, pause, down, pause)",
      "frequency": "2-3 times a week",
      "progression": "More reps, then a slower lowering, then a heavier dumbbell (small steps)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel facing the side of a flat bench and lean forward from the hips. Lay the right forearm across the pad, thumb up, wrist just past the far edge; rest the left forearm beside it."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and cock the hand up toward the thumb, bending only at the wrist."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Hold the top briefly; the forearm stays on the bench."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the hand tips down toward the little-finger side."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep a firm grip at the bottom; repeat, then switch arms."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Forearm lifting off the bench",
        "fix": "Keep the forearm pinned to the pad; only the hand moves."
      },
      {
        "id": "m2",
        "mistake": "Bouncing at the bottom",
        "fix": "Lower slowly and pause before curling."
      },
      {
        "id": "m3",
        "mistake": "Turning the forearm to help",
        "fix": "Keep the thumb pointing up the whole time; only the hand tilts."
      },
      {
        "id": "m4",
        "mistake": "Wrist resting on the edge of the bench",
        "fix": "Slide forward until the wrist is just past the edge."
      }
    ],
    "kinematics": [
      {
        "measure": "Wrist deviation (radial/ulnar)",
        "setup": "18° ulnar deviation (toward the little finger)",
        "peak": "18° radial deviation (toward the thumb) (arc ≈36°)",
        "norm": "Healthy adults used up to about 17 degrees of radial and 40 degrees of ulnar deviation in daily tasks, functional range about 10 radial and 30 ulnar (Ryu 1991); a curl moves through a comfortable range without pain (clinical opinion)",
        "sources": [
          "ryu1991"
        ]
      },
      {
        "measure": "Forearm on the bench",
        "setup": "Bench 45 cm high, 25.1 cm deep, set crosswise; elbow just inside the near edge, wrist 4 cm past the far edge; elbow ≈75°",
        "peak": "Forearm still (elbow and wrist move 0 cm over the loop)",
        "norm": "Forearm lies across the bench on its little-finger edge and stays still; the wrist just past the edge so the hand moves freely (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Kneeling lean",
        "setup": "Both knees on the floor, toes tucked; trunk ≈39° forward from vertical, upper arm ≈12° forward of vertical",
        "peak": "Unchanged",
        "norm": "Kneel close to the bench and lean forward from the hips so the forearm lies flat on the pad with the upper arm about vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Free arm",
        "setup": "Left forearm resting in the mirrored position, no dumbbell",
        "peak": "Unchanged (constant channels)",
        "norm": "The other forearm rests on the bench to keep the trunk square (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bottom 0.5 s",
        "peak": "1 s up, 0.4 s hold, 1.7 s down, 0.4 s at the bottom",
        "norm": "Slow and controlled, about 1 s up, a short squeeze and 1.5-2 s down (clinical opinion); resistance programmes for the wrist extensors in tendinopathy used 1-4 sets of about 15 reps, with no optimal dose defined (J Hand Ther 2012)",
        "sources": [
          "jht2012"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual Dumbbell Over Bench One Arm Neutral Wrist Curl, video page (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/18527-dumbbell-over-bench-one-arm-neutral-wrist-curl.html"
      },
      {
        "id": "ryu1991",
        "title": "Ryu, Cooney, Askew, An and Chao 1991, functional ranges of motion of the wrist joint (J Hand Surg Am 16(3):409-419; 40 adults, biaxial wrist electrogoniometer)",
        "url": "https://mayoclinic.elsevierpure.com/en/publications/functional-ranges-of-motion-of-the-wrist-joint/"
      },
      {
        "id": "szymanski2004",
        "title": "Szymanski, Szymanski, Molloy and Pascoe 2004, effect of 12 weeks of wrist and forearm training on high school baseball players (J Strength Cond Res 18(3):432-440; PubMed 15320673; 43 players)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/15320673/"
      },
      {
        "id": "jht2012",
        "title": "Effectiveness of different methods of resistance exercises in lateral epicondylosis, a systematic review (J Hand Ther 2012;25(1):5-25; PubMed 22075055; 12 studies)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/22075055/"
      }
    ],
    "safety": {
      "cautions": [
        "Thumb-side wrist pain (for example at the base of the thumb): shorten the range and use a lighter dumbbell (clinical opinion).",
        "Wrist or elbow pain: use a lighter dumbbell and a shorter range; stop if pain persists (clinical opinion).",
        "Keep the forearm on the thigh so the elbow and shoulder stay out of it.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee discomfort: kneel on a folded mat, or sit and rest the forearm on the thigh instead."
      ],
      "regressions": [
        "Lighter dumbbell, smaller range.",
        "Hold the dumbbell nearer the top plate."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Hold the dumbbell by the far end of the handle (longer lever).",
        "Slower lowering (3 s)."
      ]
    },
    "muscleNotes": {
      "forearm_extensors_r": "The radial wrist extensors (extensor carpi radialis longus and brevis) with flexor carpi radialis cock the hand up toward the thumb side (radial deviation) (clinical anatomy).",
      "forearm_flexors_r": "Flexor carpi radialis helps lift the hand toward the thumb side; the finger flexors hold the handle and flexor carpi ulnaris controls the lowering (clinical anatomy).",
      "biceps_r": "Holds the elbow bent while the forearm rests (clinical opinion).",
      "core": "Holds the forward lean with a long back."
    }
  },
