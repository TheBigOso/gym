  "exercise": {
    "id": "band-decline-sit-up",
    "name": "Band Decline Sit-up",
    "aliases": [
      "Resisted decline sit-up",
      "Banded decline sit-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "008997",
      "title": "Band Decline Sit-up",
      "url": "https://gymvisual.com/videos/8997-band-decline-sit-up.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Decline bench (slant board with ankle roller)",
      "Resistance bands with handles"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk flexion, then hip flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl and sit up, inhale as you lower under control.",
      "cadence": "About 1.6 s up, a short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-12",
      "tempo": "About 1.5 s up, brief pause, 2 s down",
      "frequency": "2-3 times a week",
      "progression": "Steeper board, slower lowering, then a light load"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the decline board head-down, feet hooked under the roller; hands behind the head holding the ends of two bands anchored low at the head end of the bench, elbows wide."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out, tuck the chin a little and curl the head and shoulder blades off the board."
      },
      {
        "id": "c3",
        "phase": "rise",
        "text": "Keep curling and sit up toward the knees against the bands; hands stay behind the head."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Pause with the chest close to the thighs, bands taut."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Breathe in and roll back down slowly: low back first, then the shoulder blades, head last."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Rest the shoulders on the board for a moment; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling the head forward with the hands",
        "fix": "Hands stay lightly behind the head, elbows wide; the trunk does the work."
      },
      {
        "id": "m2",
        "mistake": "Sitting up with a flat back from the hips",
        "fix": "Curl the head and shoulders first."
      },
      {
        "id": "m3",
        "mistake": "Letting the bands yank you back down",
        "fix": "Lower for about 2 s."
      },
      {
        "id": "m4",
        "mistake": "Feet slipping out from under the roller",
        "fix": "Hook the feet firmly."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from the board",
        "setup": "Lying on the 25° decline (shoulder blades on the board)",
        "peak": "≈81° from the board (≈56° from the floor)",
        "norm": "From lying on the board to sitting up close to the thighs (J Strength Cond Res 2015)",
        "sources": [
          "armysitup2015"
        ]
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈-5° (slight lordosis)",
        "peak": "≈26° (L5-T12 segment)",
        "norm": "Low back curls early and stays rounded at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈7° (resting curve)",
        "peak": "≈38° at the top",
        "norm": "Upper back curls first (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈44°",
        "peak": "≈88°",
        "norm": "Most of the second half of a sit-up is hip flexion (Andersson 1997)",
        "sources": [
          "andersson1997"
        ]
      },
      {
        "measure": "Band",
        "setup": "Hands behind the head holding the band ends; bands anchored low at the head end of the bench",
        "peak": "Bands stretch as the trunk rises",
        "norm": "The bands add load that grows as the trunk rises (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
