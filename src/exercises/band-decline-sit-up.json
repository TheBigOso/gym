    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Lying head-down raises pressure in the head; skip the decline with uncontrolled high blood pressure, glaucoma or a recent eye or head problem (clinical opinion), and sit up slowly at the end of the set.",
        "Check that the roller is locked and the feet are hooked before lying back.",
        "Full sit-ups load the low back more than curl-ups (McGill 1998; Axler and McGill 1997).",
        "Osteoporosis or vertebral fracture: avoid repeated loaded spinal flexion and twisting.",
        "Check the bands and anchors before each set; a snapped band can hit the head.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Neck pain: cross the arms on the chest.",
        "Low-back discomfort: stop at a crunch."
      ],
      "regressions": [
        "Floor version.",
        "Lower decline angle."
      ],
      "progressions": [
        "Slow 3 s lowering.",
        "Steeper decline."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the trunk off the board: about 40% (upper) and 35% (lower) MVIC in a bent-knee sit-up (Escamilla 2016).",
      "hip_flexors": "Iliopsoas and rectus femoris pull the trunk up once the shoulder blades are off the board; anchored feet raise hip-flexor activity (Andersson 1997).",
      "obliques": "External obliques steady the trunk on the way up and down (Escamilla 2016; Konrad 2001)."
    }
  },
