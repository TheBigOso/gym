    "id": "band-decline-close-grip-press",
    "name": "Band Decline Close Grip Press",
    "aliases": [
      "Banded decline close-grip press",
      "Decline close-grip band press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "025241",
      "title": "Band Decline Close grip Press",
      "url": "https://gymvisual.com/videos/25241-band-decline-close-grip-press-male.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper arms and chest (triceps, chest)",
    "secondaryBodyParts": [],
    "equipment": [
      "Decline bench",
      "Resistance bands with handles"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (elbow extension, shoulder flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l",
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "serratus_r",
        "serratus_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press or lift.",
      "cadence": "About 2 s down, a short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2 s down, brief pause, 1-1.5 s up",
      "frequency": "2 times a week",
      "progression": "Add load in small steps; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the decline bench, feet hooked under the roller; a band handle in each hand at the lower chest, hands close, bands tied to a rack beyond the head end."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the handles to the lower chest, elbows close to the sides."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause just above the chest."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press straight up until the arms are straight, hands close."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight, not locked; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows close to the body."
      },
      {
        "id": "m2",
        "mistake": "Letting the bands snap the hands down",
        "fix": "Lower in 2 s."
      },
      {
        "id": "m3",
        "mistake": "Bending the wrists back",
        "fix": "Keep the knuckles over the wrists."
      },
      {
        "id": "m4",
        "mistake": "Hands drifting apart",
        "fix": "Keep them about a fist apart."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈13° (arms straight)",
        "peak": "≈120° at the chest",
        "norm": "From about 90 degrees or more at the bottom to straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip width",
        "setup": "Hands 22 cm apart (close grip)",
        "peak": "Unchanged",
        "norm": "Close grip shifts work to the triceps (Saeterbakken 2021)",
        "sources": [
          "saeterbakken2021"
        ]
      },
      {
        "measure": "Decline",
        "setup": "25° decline, head low, feet hooked",
        "peak": "Body still on the board",
        "norm": "Lower-chest bias (Rodriguez-Ridao 2020)",
        "sources": [
          "rodriguez2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #025241, Band Decline Close grip Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/25241-band-decline-close-grip-press-male.html"
      },
      {
        "id": "saeterbakken2021",
        "title": "Saeterbakken, Stien, Pedersen, Solstad, Cumming and Andersen 2021, the effect of grip width on muscle strength and electromyographic activity in bench press among novice- and resistance-trained men (Int J Environ Res Public Health 18(12):6444; PMC8296276)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8296276/"
      },
      {
        "id": "rodriguez2020",
        "title": "Rodríguez-Ridao, Antequera-Vique, Martín-Fuentes and Muyor 2020, effect of five bench inclinations on the electromyographic activity of the pectoralis major, anterior deltoid and triceps brachii during the bench press exercise (Int J Environ Res Public Health 17(19):7339; PMC7579505)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7579505/"
      }
    ],
    "safety": {
      "cautions": [
        "Lying head-down raises pressure in the head; skip the decline with uncontrolled high blood pressure, glaucoma or a recent eye or head problem (clinical opinion), and sit up slowly after the set.",
        "Hook the feet under the roller before taking the weights; hand the weights down or lower them to the floor beside the bench at the end.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Check the bands and anchors before each set.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [],
      "regressions": [
        "Floor press with a band."
      ],
      "progressions": [
        "Thicker band."
      ]
    },
    "muscleNotes": {
      "triceps": "A close grip shifts pressing work toward the triceps (Saeterbakken 2021 on grip width).",
      "pec": "The decline biases the lower chest (Rodriguez-Ridao 2020)."
    }
  },
