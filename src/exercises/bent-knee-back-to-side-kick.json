{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "bent-knee-back-to-side-kick",
    "name": "Bent Knee Back to Side Kick",
    "aliases": [
      "Donkey kick to fire hydrant",
      "Quadruped kickback to hydrant",
      "Bent-leg back and side kick (kneeling)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "10856",
      "title": "Bent Knee Back to Side Kick",
      "url": "https://gymvisual.com/videos/10856-bent-knee-back-to-side-kick-male.html",
      "listing": "Video (movement reference; page could not be read at authoring time, movement taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Core",
      "Thighs (hamstrings)"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (bent-knee hip extension, then hip abduction)",
    "plane": "Multiplanar",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_med_r"
      ],
      "synergist": [
        "hamstrings_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "serratus_r",
        "serratus_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale on each kick, inhale as the knee comes back under the hip.",
      "cadence": "About 1.2 s back, 0.8 s return, 1.2 s side, 1.2 s down"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "10-15 (back plus side counts as one)",
      "tempo": "Controlled, short pause at each end",
      "frequency": "2-4 times a week",
      "progression": "Pauses at each end, then an ankle weight, then a mini band above the knees once that gear is available"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "On all fours: hands under the shoulders, knees under the hips, back flat."
      },
      {
        "id": "c2",
        "phase": "back",
        "text": "Knee bent 90 degrees, press the right sole up toward the ceiling until the thigh is level."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the glute; hips stay square, no low back arch."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Bring the knee back under the hip without touching down."
      },
      {
        "id": "c5",
        "phase": "side",
        "text": "Lift the bent leg out to the side, knee and foot at about the same height."
      },
      {
        "id": "c6",
        "phase": "lower",
        "text": "Lower the knee to just touch the mat; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back on the back kick",
        "fix": "Stop when the thigh is level; brace the abdomen."
      },
      {
        "id": "m2",
        "mistake": "Leaning the trunk away on the side lift",
        "fix": "Keep the shoulders and hips square; lift only as high as you can without leaning."
      },
      {
        "id": "m3",
        "mistake": "Knee straightening into a kick",
        "fix": "Keep the knee at about 90 degrees throughout."
      },
      {
        "id": "m4",
        "mistake": "Swinging between positions",
        "fix": "Pause at each end and move under control."
      }
    ],
    "kinematics": [
      {
        "measure": "Hands and knees",
        "setup": "Hands under the shoulders, knees under the hips (hip 74°, knee 90°)",
        "peak": "Hands and the left knee stay planted",
        "norm": "Hands under the shoulders, knees under the hips (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension",
        "setup": "Hip 74° flexion (thigh vertical)",
        "peak": "Hip -17° (thigh 1° from level)",
        "norm": "Thigh level with the trunk at the back kick (clinical opinion; Selkowitz 2013)",
        "sources": [
          "selkowitz2013"
        ]
      },
      {
        "measure": "Hip abduction",
        "setup": "≈2°",
        "peak": "44-45° channel (rig limit 45°); thigh ≈44° out from vertical",
        "norm": "Thigh out toward level with the floor at the side kick (clinical opinion; Macadam 2015)",
        "sources": [
          "macadam2015"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈90°",
        "peak": "≈92° on the back kick, ≈90° on the side kick",
        "norm": "About 90 degrees throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and trunk",
        "setup": "Trunk 74° from vertical",
        "peak": "Unchanged (pelvis fixed)",
        "norm": "Pelvis square and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s on all fours",
        "peak": "1.2 s back, 0.4 s squeeze, 0.8 s return, 1.2 s side, 0.4 s pause, 1.2 s down",
        "norm": "About 1.2 s each way with short pauses (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #10856, Bent Knee Back to Side Kick, video (movement reference)",
        "url": "https://gymvisual.com/videos/10856-bent-knee-back-to-side-kick-male.html"
      },
      {
        "id": "selkowitz2013",
        "title": "Selkowitz, Beneck & Powers 2013, which exercises target the gluteal muscles while minimizing activation of the tensor fascia lata? Fine-wire EMG of 11 exercises (J Orthop Sports Phys Ther 43(2):54-64)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23160432/"
      },
      {
        "id": "macadam2015",
        "title": "Macadam, Cronin & Contreras 2015, gluteal muscle activity in dynamic hip abduction and hip external rotation exercise: a systematic review (Int J Sports Phys Ther 10(5):573-591; PMC4595911)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4595911/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Wrist pain on all fours: use fists or forearms on a bench or box.",
        "Knee pain kneeling: pad the knees with a folded mat."
      ],
      "modify": [
        "Smaller range on the side lift.",
        "Pause on the mat between the two kicks."
      ],
      "regressions": [
        "Donkey kick alone.",
        "Fire hydrant alone."
      ],
      "progressions": [
        "Ankle weight.",
        "Longer pauses at each end."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Drives the back kick (bent-knee hip extension); quadruped hip extension ranks among the better bodyweight gluteus maximus exercises (Selkowitz 2013).",
      "glute_med_r": "Lifts the thigh out to the side (abduction with the hip flexed); the fire hydrant pattern loads the gluteus medius and upper gluteus maximus (Macadam 2015).",
      "hamstrings_r": "Assist hip extension; the bent knee keeps them short so the glute does most of the work (clinical opinion).",
      "glute_med_l": "Holds the pelvis level over the supporting knee (Boren 2011).",
      "core": "Keeps the trunk flat and the pelvis from rotating.",
      "spinal_extensors_r": "Hold a neutral back.",
      "spinal_extensors_l": "Hold a neutral back.",
      "serratus_r": "Keep the shoulder blades flat on the ribs.",
      "serratus_l": "Keep the shoulder blades flat on the ribs.",
      "triceps_r": "Keep the elbows soft and locked out under load.",
      "triceps_l": "Keep the elbows soft and locked out under load."
    }
  },
