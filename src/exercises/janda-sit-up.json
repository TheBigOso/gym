  "exercise": {
    "id": "janda-sit-up",
    "name": "Janda Sit-up",
    "aliases": [
      "Janda curl-up",
      "Hamstring-activated sit-up",
      "Heels-down sit-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "22554",
      "title": "Janda Sit up",
      "url": "https://gymvisual.com/videos/22554-janda-sit-up.html",
      "listing": "GymVisual page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching knowledge",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hamstrings (co-contraction)",
      "Hip flexors (reduced)"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Trunk flexion with hamstring co-contraction",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "hamstrings_r",
        "hamstrings_l"
      ],
      "stabilizer": [
        "glute_max_r",
        "glute_max_l",
        "calves_r",
        "calves_l",
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up slowly, inhale as you roll back down.",
      "cadence": "About 2 s up, a short pause, 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "5-10",
      "tempo": "Slow: about 2 s up, 1 s pause, 2 s down",
      "frequency": "2-3 times a week",
      "progression": "Slower reps and a longer pause; arms crossed on the chest, then hands by the ears"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent about 90 degrees, feet flat and free (not anchored). Arms straight, reaching toward the knees."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Press the heels down into the mat and pull them gently toward you (hamstrings on) as you breathe out and curl the head and shoulders up."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Keep curling slowly until the trunk is roughly halfway up; heels stay pressed down and the feet stay on the mat."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Roll back down slowly, one vertebra at a time, heels still pressing."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest briefly with the head down; repeat without momentum."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Feet lifting off the mat",
        "fix": "Keep pressing the heels down and pulling back; curl only as far as the feet stay down."
      },
      {
        "id": "m2",
        "mistake": "Swinging the arms for momentum",
        "fix": "Arms just reach; the abdominals do the work slowly."
      },
      {
        "id": "m3",
        "mistake": "Hooking the feet under something",
        "fix": "The feet stay free: that is the point of the Janda version."
      },
      {
        "id": "m4",
        "mistake": "Dropping back to the floor",
        "fix": "Lower for about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from the floor",
        "setup": "Lying (shoulder blades on the mat)",
        "peak": "≈46° from the floor (about halfway up)",
        "norm": "Roughly halfway up: the hip flexors are meant to be quiet, so the sit-up stays mostly trunk flexion (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar and thoracic flexion",
        "setup": "≈3° (resting curve)",
        "peak": "≈62° (rounded)",
        "norm": "The spine curls first (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈46°",
        "peak": "≈60° (pelvis rolled 14°)",
        "norm": "Less than in a full sit-up (clinical opinion; full sit-ups add hip flexion in the second half, Andersson 1997)",
        "sources": [
          "andersson1997"
        ]
      },
      {
        "measure": "Knee",
        "setup": "≈92°",
        "peak": "≈92°, feet unchanged (heels pressing)",
        "norm": "About 90 degrees, heels pressed down and back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.6 s curl, 0.8 s pause, 2 s roll down, 1.2 s rest",
        "norm": "Slow, about 2 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #22554, Janda Sit up, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/22554-janda-sit-up.html"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      },
      {
        "id": "konrad2001",
        "title": "Konrad, Schmitz and Denner 2001, neuromuscular evaluation of trunk-training exercises (J Athl Train 36(2):109-118; PMC155519)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC155519"
      },
      {
        "id": "axler1997",
        "title": "Axler and McGill 1997, low-back loads over a variety of abdominal exercises: searching for the safest abdominal challenge (Med Sci Sports Exerc 29(6):804-811)",
        "url": "https://acnpsearch.tweb-dev.unibo.it/singlejournalindex/7588015"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The idea that a hamstring press silences the hip flexors is a clinical claim; it is not well supported by EMG data (clinical opinion).",
        "Low-back pain or flexion intolerance: curl-ups load the spine less than sit-ups (Axler and McGill 1997; McGill 1998).",
        "Osteoporosis or vertebral fracture: avoid repeated loaded spinal flexion."
      ],
      "modify": [
        "Neck pain: cross the arms on the chest and keep the chin slightly tucked.",
        "Hamstring cramps: press the heels more gently."
      ],
      "regressions": [
        "Crunch.",
        "Curl-up with the arms reaching to the knees."
      ],
      "progressions": [
        "Arms crossed on the chest.",
        "Slower 3 s lowering."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the trunk slowly against gravity; free feet mean the abdominals cannot lean on the hip flexors as much as in an anchored sit-up (Andersson 1997 found anchoring raised hip-flexor activity).",
      "hamstrings_r": "Heels press down and pull back so the hamstrings co-contract (the intended Janda cue; clinical opinion).",
      "hamstrings_l": "Heels press down and pull back so the hamstrings co-contract (the intended Janda cue; clinical opinion).",
      "hip_flexors_r": "Intended to stay quiet; measured hip-flexor activity in Janda-style sit-ups is debated (clinical opinion).",
      "hip_flexors_l": "Intended to stay quiet; measured hip-flexor activity in Janda-style sit-ups is debated (clinical opinion)."
    }
  },
