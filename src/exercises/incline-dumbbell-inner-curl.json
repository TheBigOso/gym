    "id": "incline-dumbbell-inner-curl",
    "name": "Incline Dumbbell Inner Curl",
    "aliases": [
      "Incline inner biceps curl",
      "Incline out-curl",
      "Incline curl with arms out"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "032212",
      "title": "Dumbbell Incline Inner Biceps Curl",
      "url": "https://gymvisual.com/videos/907-dumbbell-incline-inner-biceps-curl.html",
      "listing": "Video; data sheet: body part Upper Arms, equipment Dumbbell, Bench, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "equipment": [
      "Dumbbell",
      "Adjustable bench"
    ],
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.5 s down, brief pause in the stretch"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight. Use a lighter dumbbell than for the regular incline curl (clinical opinion)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the back pad at about 45-60 degrees. Sit back with the hips and upper back on the pad, feet flat. Let the arms hang out to the sides, turned out, palms facing forward."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the dumbbells up and out toward the outside of the shoulders, keeping the elbows where they hang."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze with the palms facing the shoulders; upper back stays on the pad."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly along the same arc to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause briefly in the stretch, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the arms drift back to the sides of the body",
        "fix": "Keep the elbows out and the arms turned out."
      },
      {
        "id": "m2",
        "mistake": "Shoulders rolling forward off the pad",
        "fix": "Keep the upper back and head on the pad."
      },
      {
        "id": "m3",
        "mistake": "Elbows swinging forward",
        "fix": "Only the forearms move."
      },
      {
        "id": "m4",
        "mistake": "Pad too low for your shoulders",
        "fix": "Raise the pad to 60 degrees if the front of the shoulder feels strained (clinical opinion)."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈8° (arm straight)",
        "peak": "≈130° at the top (range ≈122°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "25.8° (semi-supinated)",
        "peak": "-10.6° (palm forward/up)",
        "norm": "The supinated grip gave the highest biceps activity in the lifting phase; neutral grips shift work toward the brachioradialis (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-56°",
        "peak": "≈-56° (elbow behind the trunk line)",
        "norm": "Elbows stay near the sides; a small forward drift at the top is normal, a big swing shifts work to the front deltoid (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.8 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.5 s down, 1.2 s pause in the stretch",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Back pad angle",
        "setup": "55° from the floor (trunk line ≈41° back from vertical)",
        "peak": "Unchanged (the trunk stays on the pad)",
        "norm": "About 45-60 degrees from the floor (common practice, clinical opinion); Oliveira 2009 used an incline bench to put the shoulder in extension",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Arm abduction (upper arm out from the trunk)",
        "setup": "Upper arm ≈20° out from the sagittal plane, turned out (palms forward and out)",
        "peak": "≈20° (elbows stay out); forearms curl 40° out from straight ahead",
        "norm": "Arms angled out to the sides with the shoulders turned out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #032212, Dumbbell Incline Inner Biceps Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/907-dumbbell-incline-inner-biceps-curl.html"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29; PMC3737788)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      },
      {
        "id": "kassiano2025",
        "title": "Kassiano et al. 2025, distinct muscle growth and strength adaptations after preacher and incline biceps curls (Int J Sports Med, randomized trial in 63 young women)",
        "url": "https://ro.ecu.edu.au/ecuworks2022-2026/5817"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the dumbbell and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Pick the dumbbells up and set them down with a straight back and bent knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Front-of-shoulder pain in the turned-out stretch: raise the pad and shorten the range (clinical opinion)."
      ],
      "modify": [
        "Shoulder discomfort: regular incline curl with the arms by the sides.",
        "Elbow pain: lighter load."
      ],
      "regressions": [
        "Dumbbell incline curl.",
        "Seated dumbbell curl."
      ],
      "progressions": [
        "Slower lowering with a pause in the stretch."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor; on the incline the shoulder starts extended (long head stretched). Turning the arms out with the palms facing forward and out is commonly said to bias the short (inner) head; we found no study measuring this (clinical opinion). Incline curls trained the proximal elbow flexors more than preacher curls (Kassiano 2025).",
      "biceps_l": "Main elbow flexor; on the incline the shoulder starts extended (long head stretched). Turning the arms out with the palms facing forward and out is commonly said to bias the short (inner) head; we found no study measuring this (clinical opinion). Incline curls trained the proximal elbow flexors more than preacher curls (Kassiano 2025).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder in the stretched, turned-out position.",
      "ant_deltoid_l": "Steadies the shoulder in the stretched, turned-out position.",
      "core": "Keeps the trunk still so the hips do not swing the weight up.",
      "infraspinatus_r": "Holds the arms turned out (external rotation) through the set.",
      "infraspinatus_l": "Holds the arms turned out (external rotation) through the set."
    }
  },
