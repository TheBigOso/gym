    "equipment": [
      "Kettlebell"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (hip hinge with side bend under a fixed load, then a stand-up with the arm locked)",
    "plane": "Multiplanar",
    "laterality": "Unilateral (one side at a time)",
    "authoredSide": "right",
    "muscles": {
