        "infraspinatus_r",
        "upper_traps_r",
        "forearm_flexors_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace in the rack, short breaths behind the brace on the way under, breathe out as you stand up.",
      "cadence": "About 2.4 s under, 2.2 s up"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "1-5 per side",
      "tempo": "Slow bend under, controlled stand-up",
      "rest": "90-180 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen kettlebell; start light, the bent press allows heavy loads only after long practice",
      "progression": "More reps, then a heavier bell; master the windmill first"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet wider than the hips, both turned about 45 degrees to the left. Kettlebell racked at the right shoulder, elbow on the side of the ribs, forearm vertical; eyes on the bell."
      },
      {
        "id": "c2",
        "phase": "under",
        "text": "Keep the bell where it is and move the body away: hips out to the right and back, hinge and side-bend to the left, left hand sliding down the left leg, until the right arm is straight."
      },
      {
        "id": "c3",
        "phase": "pause",
        "text": "Arm locked and vertical over the shoulder, chest open toward the bell, right knee straight, left knee soft."
      },
      {
        "id": "c4",
        "phase": "up",
        "text": "Stand back up with the arm locked, eyes on the bell."
      },
      {
        "id": "c5",
        "phase": "lockout",
        "text": "Stand tall with the bell overhead."
      },
      {
        "id": "c6",
        "phase": "lower",
        "text": "Lower the bell back to the rack under control."
      },
      {
        "id": "c7",
        "phase": "reset",
        "text": "Re-set the elbow on the ribs and repeat; switch sides after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pressing the bell up with the arm",
        "fix": "The bell stays still; the body moves down and away from it until the arm is straight."
      },
      {
        "id": "m2",
        "mistake": "Losing the vertical forearm",
        "fix": "Keep the forearm vertical under the bell the whole way."
      },
      {
        "id": "m3",
        "mistake": "Rounding forward instead of hinging and side-bending",
        "fix": "Push the right hip out and back first; the spine stays long."
      },
      {
        "id": "m4",
        "mistake": "Looking away from the bell",
        "fix": "Eyes on the bell for the whole rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from vertical",
        "setup": "Upright (≈5° from vertical)",
        "peak": "≈66° from vertical (pelvis to C7): hips hinge ≈62°, spine side-bends ≈25° to the left and turns ≈27° open toward the dumbbell",
        "norm": "Hip hinge with a side bend and an open chest, as in the windmill; no study defines the angles (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Loaded arm",
        "setup": "Racked: fist 128 cm up beside the shoulder, elbow ≈146°",
        "peak": "Locked vertical over the shoulder at the bottom (≈0° off vertical, elbow ≈4°); the hand stays between 128 and 166 cm on the way under",
        "norm": "Starts racked with the elbow on the ribs and finishes locked vertical; the bell stays at about the same height while the body moves under it (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hips and knees",
        "setup": "Hips ≈-2° R / ≈10° L; knees ≈10° R / ≈7° L",
        "peak": "Hips ≈60° R / ≈91° L; knees ≈10° R (locked) / ≈20° L (soft)",
        "norm": "The loaded-side knee straight, the other soft; the hips hinge (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Free hand",
        "setup": "Left hand beside the left thigh, 84 cm up",
        "peak": "Slides to 43 cm above the floor along the inside of the left shin (wrist 15.5 cm from the leg's bone line)",
        "norm": "Slides down the inside of the front leg toward the shin or foot (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Feet",
        "setup": "Feet 44 cm apart, both turned 40° to the left",
        "peak": "Unchanged (planted)",
        "norm": "Wider than the hips, turned about 45 degrees away from the kettlebell (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rack 0.6 s",
        "peak": "2.4 s bend under, 0.4 s pause, 2.2 s stand up, 0.4 s lockout, 1 s back to the rack",
        "norm": "Slow and controlled, about 2-3 s to get under the bell (clinical opinion)",
        "sources": []
      }
    ],
