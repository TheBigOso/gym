    "breathing": {
      "pattern": "Inhale as the band draws the hands down, exhale as you press up against it.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-2 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; stand or sit farther from the anchor, or choke up on the band, for more tension.",
      "progression": "More reps, a slower return, more distance from the anchor (more stretch), then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set a rack (or two sturdy uprights) just behind the top of the bench and loop a band around each upright low down. Back pad at 30 degrees; glutes in the crease, upper back and head on the pad, feet planted; a handle in each hand, palms facing each other, arms straight over the upper chest."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the band draw the hands down slowly, elbows tucked about 30 degrees from your sides, forearms vertical."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Hands beside the upper chest, palms still facing; keep the band taut."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press straight up against the band until the arms are straight over the shoulders."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief hold at the top, shoulder blades on the pad, then lower again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring out as the band gets heavy",
        "fix": "Keep the elbows tucked about 30 degrees and the palms facing each other."
      },
      {
        "id": "m2",
        "mistake": "Letting the band snap the hands back down",
        "fix": "Lower for about 2 s and keep tension at the bottom."
      },
      {
        "id": "m3",
        "mistake": "Wrists bent back by the band",
        "fix": "Keep the wrists straight over the forearms."
      },
      {
        "id": "m4",
        "mistake": "Sliding down the bench as the band pulls",
        "fix": "Sit back into the crease and keep the feet planted."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "30° back pad, flat seat",
        "peak": "Glutes in the crease, upper back on the pad, head just off it (rig shapes)",
        "norm": "Back pad at 30 degrees (the angle that gave the highest upper-pectoralis activity in Rodríguez-Ridao 2020; Lauver 2016 also recommends 30 degrees); 30-45 degrees is common for the incline hammer press (clinical opinion)",
        "sources": [
          "rodriguez2020",
          "lauver2016"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Neutral (palms facing each other), hands 35.5 cm apart at the top",
        "peak": "Neutral beside the chest, hands 59.2 cm apart",
        "norm": "Neutral (palms facing each other) throughout (clinical opinion; the neutral grip shifted activity toward the clavicular pectoralis in a seated press, Muyor 2023)",
        "sources": [
          "muyor2023"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈11° (arms straight, not locked)",
        "peak": "≈113° at the bottom",
        "norm": "Arms straight but not locked at the top; hands beside the chest at the bottom with the elbows roughly 90-110 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "Arms vertical over the shoulders",
        "peak": "≈30° from the trunk at the bottom; upper arm ≈14° below the back plane",
        "norm": "About 20-40 degrees from the body, closer than a pronated press (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped around the rack uprights 40 cm up, 85 cm behind the hinge, 120 cm apart",
        "peak": "Strands 96.5-116.6 cm (longest at the top), at least 7.6 cm from the body",
        "norm": "Anchored low behind the bench so it resists the press; tension rises as the band stretches toward the top. Elastic resistance can reach muscle activity comparable to free weights (Andersen 2010; Calatayud 2015)",
        "sources": [
          "andersen2010",
          "calatayud2015"
        ]
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up, 0.7 s at the top",
        "norm": "Controlled: about 2 s down and 1-2 s up; Rodríguez-Ridao 2020 used 2 s down and 2 s up at 60% of 1RM",
        "sources": [
          "rodriguez2020"
        ]
      }
    ],
