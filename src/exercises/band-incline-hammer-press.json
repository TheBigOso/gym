    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a heavy bench frame or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is lightest at the start and heaviest at the end of the push; let it return under control rather than snapping back.",
        "Shoulder discomfort in the regular press: the neutral grip with tucked elbows is often more comfortable; keep the range pain-free (clinical opinion).",
        "Keep the wrists straight over the forearms.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower the bench to 15-30 degrees if the shoulders take over.",
        "Shorten the range at the bottom if the front of the shoulder is uncomfortable."
      ],
      "regressions": [
        "Lighter band.",
        "Incline push-up."
      ],
      "progressions": [
        "Stronger band or the bench moved farther from the rack.",
        "Slower lowering (3-4 s) with a 1 s pause.",
        "Incline dumbbell hammer press."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher, biased toward the upper (clavicular) fibres by the incline: 30 degrees gave the highest upper-pectoralis activity in pressing (Rodríguez-Ridao 2020, barbell). In a seated chest press the neutral grip gave more clavicular activity than a wide pronated barbell grip (Muyor 2023).",
      "pec_l": "Main pusher, biased toward the upper (clavicular) fibres by the incline: 30 degrees gave the highest upper-pectoralis activity in pressing (Rodríguez-Ridao 2020, barbell). In a seated chest press the neutral grip gave more clavicular activity than a wide pronated barbell grip (Muyor 2023).",
      "ant_deltoid_r": "Flexes the shoulder; with the elbows tucked by the neutral grip the press is more of a forward (flexion) push, and the deltoid works harder as the bench rises (Rodríguez-Ridao 2020).",
      "ant_deltoid_l": "Flexes the shoulder; with the elbows tucked by the neutral grip the press is more of a forward (flexion) push, and the deltoid works harder as the bench rises (Rodríguez-Ridao 2020).",
      "triceps_r": "Straightens the elbows; triceps activity did not change with bench angle (Rodríguez-Ridao 2020).",
      "triceps_l": "Straightens the elbows; triceps activity did not change with bench angle (Rodríguez-Ridao 2020).",
      "serratus_r": "Holds the shoulder blades against the rib cage while each arm moves on its own.",
      "serratus_l": "Holds the shoulder blades against the rib cage while each arm moves on its own.",
      "biceps_r": "Works as a stabiliser: biceps activity rose with the stability demand, highest with dumbbells (Saeterbakken 2011).",
      "biceps_l": "Works as a stabiliser: biceps activity rose with the stability demand, highest with dumbbells (Saeterbakken 2011).",
      "forearm_flexors_r": "Grip the band handle.",
      "forearm_flexors_l": "Grip the band handle.",
      "infraspinatus_r": "Rotator cuff: centres the head of the upper arm while the band handles move freely (clinical opinion).",
      "infraspinatus_l": "Rotator cuff: centres the head of the upper arm while the band handles move freely (clinical opinion).",
      "rhomboids_midtrap_r": "Keep the shoulder blades drawn back and down on the bench.",
      "rhomboids_midtrap_l": "Keep the shoulder blades drawn back and down on the bench.",
      "core": "Bracing keeps the ribs down and the pelvis on the seat."
    }
  },
