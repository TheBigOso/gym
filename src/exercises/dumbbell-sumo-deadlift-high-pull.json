    "breathing": {
      "pattern": "Breathe in and brace at the bottom, breathe out as you pull, breathe in on the way down.",
      "cadence": "About 0.85 s up, 1.6 s down"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "10-15 or timed rounds",
      "tempo": "Explosive up, controlled down",
      "load": "User-chosen dumbbell; stop about 2-3 reps short of failure or when the hips slow",
      "frequency": "1-3 times a week",
      "progression": "Heavier dumbbell, more reps per round"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Wide stance, toes out, one dumbbell held vertically in both hands, hips down, chest up, arms long."
      },
      {
        "id": "c2",
        "phase": "drive",
        "text": "Drive the floor away, knees out, stand up fast."
      },
      {
        "id": "c3",
        "phase": "pull",
        "text": "Shrug and pull the dumbbell up the body, elbows high and out above the hands."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Hands at the upper chest, elbows high; do not lean back."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Straighten the arms, then sit back down into the sumo squat with a flat back."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Dumbbell just above the floor, brace, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling with the arms before the legs finish",
        "fix": "Stand up first; the arms take over at the top."
      },
      {
        "id": "m2",
        "mistake": "Knees caving in",
        "fix": "Push the knees out over the toes."
      },
      {
        "id": "m3",
        "mistake": "Rounding the back at the bottom",
        "fix": "Sit the hips down and keep the chest up; touch higher if needed."
      },
      {
        "id": "m4",
        "mistake": "Pulling above shoulder height or with pain",
        "fix": "Stop at the upper chest; skip the pull if the shoulders pinch."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance",
        "setup": "Ankles 54 cm apart, toes out 28°",
        "peak": "Unchanged; knees track over the toes",
        "norm": "Wide stance with the toes turned out, knees over the toes (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bottom position",
        "setup": "Knees ≈100°, trunk ≈42° forward, dumbbell 4 cm off the floor (rig estimate)",
        "peak": "Hip flexion ≈137° (joint channel)",
        "norm": "Upright sumo squat with a flat back, load between the feet (clinical opinion)",
        "sources": []
      },
      {
        "measure": "High pull",
        "setup": "Arms long until the hips and knees extend",
        "peak": "Elbows 6.3 cm above the wrists, hands 13.9 cm below the shoulders",
        "norm": "Elbows lead and stay above the hands; narrow grips shift work toward the biceps, wider grips toward the deltoids and trapezius (McAllister 2013, upright row)",
        "sources": [
          "mcallister2013"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "0.35 s set",
        "peak": "0.85 s up (explosive), 0.2 s hold, 1.6 s down",
        "norm": "Explosive pull; high pulls produced more peak power and velocity than the hang clean in Suchomel 2014",
        "sources": [
          "suchomel2014"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
