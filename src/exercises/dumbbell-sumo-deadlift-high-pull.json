      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Shoulder pinching at the top: pull only to the lower chest or keep to the sumo deadlift.",
        "Low-back pain: keep the bottom position high and the back flat."
      ],
      "modify": [
        "Shoulder discomfort: pull to the belly button (a sumo deadlift shrug).",
        "Limited hip mobility: narrower stance, touch a step."
      ],
      "regressions": [
        "Dumbbell sumo deadlift.",
        "Dumbbell upright row (light).",
        "Goblet squat."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Kettlebell or barbell sumo deadlift high pull.",
        "Dumbbell power clean."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Drive the hips through to stand up fast.",
      "glute_max_l": "Drive the hips through to stand up fast.",
      "quads_r": "Extend the knees from the wide squat.",
      "quads_l": "Extend the knees from the wide squat.",
      "upper_traps_r": "Shrug, then keep pulling: in the upright row the upper trapezius worked harder as the grip widened (McAllister 2013).",
      "upper_traps_l": "Shrug, then keep pulling: in the upright row the upper trapezius worked harder as the grip widened (McAllister 2013).",
      "lat_deltoid_r": "Lift the elbows; the lateral deltoid was more active with wider grips in the upright row (McAllister 2013), so this narrow, one-dumbbell grip is a little more biceps-dominant.",
      "lat_deltoid_l": "Lift the elbows; the lateral deltoid was more active with wider grips in the upright row (McAllister 2013), so this narrow, one-dumbbell grip is a little more biceps-dominant.",
      "adductors_r": "Work hard from the wide, toes-out stance.",
      "adductors_l": "Work hard from the wide, toes-out stance.",
      "hamstrings_r": "Extend the hips with the glutes.",
      "hamstrings_l": "Extend the hips with the glutes.",
      "ant_deltoid_r": "Helps raise the arms.",
      "ant_deltoid_l": "Helps raise the arms.",
      "biceps_r": "Bend the elbows in the pull; narrow grips gave more biceps activity (McAllister 2013).",
      "biceps_l": "Bend the elbows in the pull; narrow grips gave more biceps activity (McAllister 2013).",
      "rhomboids_midtrap_r": "Steady the shoulder blades as the elbows rise.",
      "rhomboids_midtrap_l": "Steady the shoulder blades as the elbows rise.",
      "spinal_extensors_r": "Hold the flat back off the floor.",
      "spinal_extensors_l": "Hold the flat back off the floor.",
      "core": "Brace; finish tall without leaning back.",
      "forearm_flexors_r": "Grip the handle with both hands.",
      "forearm_flexors_l": "Grip the handle with both hands."
    }
