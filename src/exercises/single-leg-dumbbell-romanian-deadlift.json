      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes) and thighs (hamstrings)",
    "secondaryBodyParts": [
      "Lower back",
      "Core (anti-rotation)",
      "Forearms (grip)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (single-leg hip hinge)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r",
        "hamstrings_r"
      ],
      "synergist": [
        "adductors_r",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_med_r"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
