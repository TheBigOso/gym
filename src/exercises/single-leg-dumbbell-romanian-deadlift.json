        "glute_max_l",
        "forearm_flexors_l",
        "lats_l"
      ],
      "lengthened": [
        "hamstrings_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the top, hold the brace on the way down, breathe out as you stand.",
      "cadence": "About 2.2 s down, short pause, 1.6 s up"
    },
    "prescription": {
      "sets": "3 per leg",
      "reps": "6-10",
      "tempo": "2-1-1.5-1",
      "load": "User-chosen dumbbell held in the hand opposite the standing leg; stop about 2 reps short of failure (RIR 2)",
      "frequency": "1-2 times a week",
      "progression": "Add load, then add a pause at the bottom"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the right leg, knee soft, dumbbell in the left hand, left foot just off the floor."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Hinge at the right hip: the chest goes down as the left leg reaches back, one straight line from head to heel."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop when the trunk is about level or the hamstring is stretched; hips stay square to the floor."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the right hip forward and stand tall, bringing the free leg under you."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Balance tall on the right leg for a breath, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Opening the hips (the free hip rotates up toward the ceiling)",
        "fix": "Point the free toes at the floor and keep both hip bones level."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back to reach lower",
        "fix": "Stop where the back is still flat; the range comes from the standing hip."
      },
      {
        "id": "m3",
        "mistake": "Bending the standing knee into a squat",
        "fix": "Keep a small, steady knee bend and push the hips back."
      },
      {
        "id": "m4",
        "mistake": "Rushing and losing balance",
        "fix": "Slow down; touch a wall or rack lightly with the free hand if needed."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈4° (standing hip)",
        "peak": "≈104° (joint channel), trunk ≈14° above horizontal",
        "norm": "Hinge until the trunk is about level, the free leg in line with it (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈8° (standing knee)",
        "peak": "≈20°",
        "norm": "Standing knee softly bent, about 15-25 degrees, nearly constant (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Free leg",
        "setup": "Hovering beside the standing ankle (toe 8.9 cm up)",
        "peak": "Hip-to-ankle line 177.4° to the trunk line (180 = straight line), pelvis level",
        "norm": "Extends back in line with the trunk, toes pointing down, pelvis square (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Load position",
        "setup": "Dumbbell in the left hand (opposite the standing leg)",
        "peak": "Hangs by the standing shin, handle 35 cm up; centre of mass kept over the right mid-foot (max offset 0.1 cm)",
        "norm": "Dumbbell in the hand opposite the standing leg gave higher gluteus maximus and erector spinae activity than the same-side hand (Mo 2023)",
        "sources": [
          "mo2023"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Balance 0.8 s",
        "peak": "2.2 s down, 0.4 s pause, 1.6 s up, 1.5 s reset",
        "norm": "Controlled, about 2 s down and 1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #975212, Dumbbell Single Leg Romanian Deadlift (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/21423-dumbbell-single-leg-romanian-deadlift-male.html"
      },
      {
        "id": "mo2023",
        "title": "Mo, Ngai, Ng, Sin, Luk & Ho 2023, effects of loading positions on the activation of trunk and hip muscles during flywheel and dumbbell single-leg Romanian deadlift exercises (Front Physiol 14:1264604)",
        "url": "https://www.frontiersin.org/articles/10.3389/fphys.2023.1264604/full"
      },
      {
        "id": "mcallister2014",
        "title": "McAllister, Hammond, Schilling, Ferreria, Reed & Weiss 2014, muscle activation during various hamstring exercises (J Strength Cond Res 28(6):1573-1580)",
        "url": "https://digitalcommons.memphis.edu/facpubs/9934"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Balance: practise near a wall or rack; set the free foot down whenever you need to.",
        "Low-back pain: shorten the range and keep the spine neutral."
      ],
      "modify": [
        "Poor balance: keep the free toes lightly on the floor behind you (kickstand RDL).",
        "Tight hamstrings: stop higher and bend the standing knee a little more."
      ],
      "regressions": [
        "Bodyweight single-leg RDL holding a wall.",
        "Kickstand (staggered-stance) RDL.",
        "Two-leg dumbbell RDL."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Pause at the bottom.",
        "Dumbbell in each hand."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor of the standing leg. Superior gluteus maximus reached very high activity (about 105-169% MVIC) in the dumbbell and flywheel single-leg RDLs of Mo 2023, highest with the load in the opposite hand.",
      "hamstrings_r": "Lengthen as the hips hinge back over the standing leg, then extend the hip; biceps femoris was about 70-122% MVIC in Mo 2023.",
      "adductors_r": "Adductor magnus helps extend the standing hip.",
      "spinal_extensors_r": "Keep the back flat from head to free heel; erector spinae were highly active, more so with the contralateral load (Mo 2023).",
      "spinal_extensors_l": "Keep the back flat from head to free heel; erector spinae were highly active, more so with the contralateral load (Mo 2023).",
      "glute_med_r": "Keeps the pelvis level over the standing leg (about 41-89% MVIC in Mo 2023).",
      "core": "Brace so the trunk does not twist toward the dumbbell.",
      "obliques_r": "Resist rotation from the one-sided load; external oblique activity was only low to moderate (Mo 2023).",
      "obliques_l": "Resist rotation from the one-sided load; external oblique activity was only low to moderate (Mo 2023).",
      "calves_r": "Balance on the standing foot.",
      "glute_max_l": "Lifts the free leg back in line with the trunk.",
      "forearm_flexors_l": "Grip the dumbbell.",
      "lats_l": "Keep the dumbbell arm close to the body."
    }
  },
