  "exercise": {
    "id": "lever-seated-calf-press",
    "name": "Lever Seated Calf Press",
    "aliases": [
      "Seated calf press machine",
      "Lever calf press",
      "Plate-loaded seated calf press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "7442",
      "title": "Lever Seated Calf Press",
      "url": "https://gymvisual.com/videos/7442-lever-seated-calf-press.html",
      "listing": "Video (title from the listing URL; the page could not be fetched from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Lower legs (calves)",
    "secondaryBodyParts": [],
    "equipment": [
      "Seated leg press (plate-loaded lever)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (ankle)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "calves_r",
        "calves_l"
      ],
      "synergist": [],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you press the plate away with the balls of the feet, breathe in as the heels come back.",
      "cadence": "About 1 s press, a short pause, about 2 s back"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "12-20",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Machine load is user-chosen: pick a weight you can move through the full range shown with good form, leaving about 2-3 reps in reserve (RPE 7-8).",
      "rest": "1-1.5 minutes between sets",
      "progression": "Add a small amount of load when every rep of every set reaches the full range with good form."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with the hips and back on the pads, hold the handles. Press the plate out to nearly straight legs, then slide the feet down so only the balls of the feet are on the bottom edge of the plate, heels off."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Keep the knees still and let the plate push the toes back toward you, heels travelling past the plate edge for a full calf stretch."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause in the stretch; no bounce."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and press the plate away by pointing the toes as far as they go; the knees do not move."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the calves for a moment with the toes pointed, then go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending and straightening the knees to move the plate",
        "fix": "Lock the knee angle in and move only at the ankles."
      },
      {
        "id": "m2",
        "mistake": "Short, bouncy reps",
        "fix": "Use the whole range: full stretch, full point, with a pause at each end."
      },
      {
        "id": "m3",
        "mistake": "Feet slipping off the plate edge",
        "fix": "Keep the balls of the feet firmly on the plate; use a lighter load."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle",
        "norm": "From a full stretch to full plantarflexion (clinical opinion)",
        "sources": [],
        "setup": "≈-33° dorsiflexion at the top",
        "peak": "≈14° at the bottom"
      },
      {
        "measure": "Knee flexion",
        "norm": "Knees nearly straight and still: with straight knees the gastrocnemius works fully; standing (straight-knee) training grew the gastrocnemius more than seated work (Kinoshita 2023)",
        "sources": [
          "kinoshita2023"
        ],
        "setup": "≈12° at the top",
        "peak": "≈12° at the bottom"
      },
      {
        "measure": "Seat and back",
        "norm": "Hips and back stay on the pads (machine design)",
        "sources": [],
        "setup": "Seat 46 cm high, back pad 20° back from vertical",
        "peak": "Unchanged (hips and back on the pads)"
      },
      {
        "measure": "Plate travel",
        "norm": "Fixed by the lever arc; the ankles alone move it",
        "sources": [],
        "setup": "Plate on a 95 cm lever arm",
        "peak": "3.6° of lever swing"
      },
      {
        "measure": "Foot position",
        "norm": "Balls of the feet on the bottom edge of the plate, heels free (common coaching)",
        "sources": [],
        "setup": "Feet 24 cm apart on the plate, toes out 6°",
        "peak": "The ball of the foot stays on the same spot of the plate"
      },
      {
        "measure": "Tempo",
        "norm": "About 1 s press, a short pause, about 2 s back (clinical opinion)",
        "sources": [],
        "setup": "Top 0.6 s",
        "peak": "1.8 s heels down, 0.4 s pause, 1 s press"
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Lever Seated Calf Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/7442-lever-seated-calf-press.html"
      },
      {
        "id": "kinoshita2023",
        "title": "Kinoshita, Maeo et al. 2023, triceps surae muscle hypertrophy is greater after standing versus seated calf-raise training (Front Physiol 14:1272106)",
        "url": "https://www.frontiersin.org/articles/10.3389/fphys.2023.1272106/full"
      },
      {
        "id": "heberlosier2012",
        "title": "Hébert-Losier, Schneiders, García, Sullivan & Simoneau 2012, influence of knee flexion angle and age on triceps surae muscle fatigue during heel raises (J Strength Cond Res 26(11))",
        "url": "https://epublications.marquette.edu/phys_therapy_fac/29"
      }
    ],
    "safety": {
      "cautions": [
        "Set the seat so the legs are nearly straight with the balls of the feet on the plate.",
        "Keep the knees soft but still; never let the plate slide off the balls of the feet.",
        "Achilles or calf pain: shorten the stretch at the bottom.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Achilles pain: work through a shorter, pain-free range."
      ],
      "regressions": [
        "Standing two-leg calf raise on the floor."
      ],
      "progressions": [
        "Single-leg calf press.",
        "Slower lowering (3 s)."
      ]
    },
    "muscleNotes": {
      "calves_r": "Soleus-biased plantarflexion: with the knee bent 90 degrees the two-joint gastrocnemius is slack. In a 12-week trial seated (knee 90 degrees) calf raises grew the soleus about as much as standing raises but barely changed the gastrocnemius (Kinoshita 2023).",
      "calves_l": "Soleus-biased plantarflexion: with the knee bent 90 degrees the two-joint gastrocnemius is slack. In a 12-week trial seated (knee 90 degrees) calf raises grew the soleus about as much as standing raises but barely changed the gastrocnemius (Kinoshita 2023).",
      "quads_r": "Hold the knees at the same angle so the ankles do the work.",
      "quads_l": "Hold the knees at the same angle so the ankles do the work.",
      "forearm_flexors_r": "Grip holds the bar in place across the knees (clinical opinion).",
      "forearm_flexors_l": "Grip holds the bar in place across the knees (clinical opinion).",
      "core": "Keeps the trunk tall on the bench (clinical opinion)."
    }
  },
