{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "standing-side-leg-raise",
    "name": "Standing Side Leg Raise",
    "aliases": [
      "Standing hip abduction",
      "Standing lateral leg raise",
      "Side leg lift (standing)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9132",
      "title": "Standing Side Leg Raise",
      "url": "https://gymvisual.com/videos/9132-standing-side-leg-raise.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the network proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (hamstrings)",
      "Core"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip abduction)",
    "plane": "Frontal",
    "laterality": "Unilateral (one leg at a time)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_med_r"
      ],
      "synergist": [
        "glute_max_r",
        "hip_flexors_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "core",
        "obliques_l",
        "calves_l"
      ],
      "lengthened": [
        "adductors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg lifts out, inhale as it returns.",
      "cadence": "About 1 s out, short pause, about 1.8 s back"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20 per leg",
      "tempo": "About 1 s out, brief pause, 2 s back",
      "frequency": "2-4 times a week",
      "progression": "Longer pause at the top, then a light band above the knees or an ankle weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, hands on the hips, weight on the left foot with a soft knee."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and lift the straight right leg out to the side, toes pointing forward."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at about 30-40 degrees. Trunk tall; do not lean far away from the leg."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Lower slowly until the foot is just above the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Reset your balance and repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning the trunk far to the side to lift the leg higher",
        "fix": "Stay tall and accept a smaller range; the hip only abducts about 30-45 degrees."
      },
      {
        "id": "m2",
        "mistake": "Turning the toes up to the ceiling",
        "fix": "Keep the toes pointing forward so the glute medius, not the hip flexors, does the work."
      },
      {
        "id": "m3",
        "mistake": "Swinging the leg",
        "fix": "Lift and lower slowly with a short pause."
      },
      {
        "id": "m4",
        "mistake": "Stance hip dropping out to the side",
        "fix": "Keep the stance hip stacked over the foot; hold a wall or chair if balance is poor."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "≈3°",
        "peak": "≈33° (joint channel)",
        "norm": "Normal active hip abduction is about 30-45 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Leg from vertical",
        "setup": "≈4°",
        "peak": "≈37° (hip abduction plus 4° pelvic hitch)",
        "norm": "Includes a few degrees of pelvic tip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Tall",
        "peak": "≈8° from vertical toward the stance side",
        "norm": "Tall, a small lean toward the stance side only (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "Moving knee ≈28°, stance ≈6°",
        "peak": "Moving knee ≈4°",
        "norm": "Moving knee straight; stance knee soft (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.7 s",
        "peak": "1.1 s out, 0.5 s pause, 1.8 s return",
        "norm": "Slow and controlled with a short pause (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #9132, Standing Side Leg Raise, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/9132-standing-side-leg-raise.html"
      },
      {
        "id": "distefano2009",
        "title": "Distefano, Blackburn, Marshall and Padua 2009, gluteal muscle activation during common therapeutic exercises (J Orthop Sports Phys Ther 39(7):532-540; PMID 19574661)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19574661/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Balance: hold a wall or chair if single-leg stance is unsteady.",
        "Hip pain or a recent hip replacement: follow your surgeon or physiotherapist's range limits."
      ],
      "modify": [
        "Lightly hold a wall or chair back.",
        "Smaller range."
      ],
      "regressions": [
        "Hold a support with both hands.",
        "Side-lying hip abduction."
      ],
      "progressions": [
        "3 s pause at the top.",
        "Light ankle weight or a band above the knees.",
        "Cable hip abduction."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Main mover: abducts the hip. Side-lying hip abduction gave about 81% MVIC for gluteus medius in Distefano 2009; the standing version is lighter because the leg lifts through a shorter lever against gravity (clinical opinion).",
      "glute_max_r": "Upper fibres assist abduction (clinical opinion).",
      "hip_flexors_r": "Tensor fasciae latae assists abduction, more so if the toes turn up (clinical opinion).",
      "glute_med_l": "Holds the pelvis level over the stance leg; single-leg stance work loads the stance-side gluteus medius (Distefano 2009).",
      "core": "Keeps the trunk tall over the stance leg.",
      "obliques_l": "Limits the side lean (clinical opinion).",
      "calves_l": "Balance on the stance foot.",
      "adductors_r": "Lengthen as the leg lifts out."
    }
  },
