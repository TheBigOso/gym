  },
  "exercise": {
    "id": "band-seated-twist",
    "name": "Band Seated Twist",
    "aliases": [
      "Seated band rotation",
      "Band seated trunk rotation",
      "Seated band torso twist"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "23083",
      "title": "Band Seated Twist",
      "url": "https://gymvisual.com/videos/23083-band-seated-twist.html",
      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read; the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Abdominals"
    ],
    "equipment": [
      "Resistance band",
      "Squat rack upright (band anchor)",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk rotation, seated)",
    "plane": "Transverse",
    "laterality": "Unilateral (band pulls from one side)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "pec_r",
        "pec_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you turn away from the anchor, breathe in as you come back.",
      "cadence": "About 1.2 s away, short pause, 1.5 s back"
    },
    "prescription": {
      "sets": "2-3 per side",
      "reps": "10-15 per side",
      "effort": "Stop 2-3 reps short of losing the tall seated posture (clinical opinion)",
      "tempo": "1.2-0.5-1.5-0.6 (turn-hold-return-pause, seconds)",
      "rest": "30-60 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: sit farther from the anchor for more tension",
      "progression": "Stronger band, longer pause at the end, feet lifted"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit side-on to the anchor, knees bent, feet flat, trunk tall and leaning back slightly. Hold the band handle in both hands, arms long in front of the chest, band at chest height."
      },
      {
        "id": "c2",
        "phase": "twist",
        "text": "Breathe out and turn the ribs and shoulders away from the anchor; the hands stay in front of the breastbone."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the end; hips and knees stay still, chest lifted."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Turn back slowly toward the anchor, controlling the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause just past the middle, then turn again. Turn around to train the other side."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the arms while the trunk stays still",
        "fix": "Keep the hands in front of the breastbone and turn the ribs and shoulders."
      },
      {
        "id": "m2",
        "mistake": "Slumping into a rounded low back",
        "fix": "Sit tall; lean back less or sit on a folded mat."
      },
      {
        "id": "m3",
        "mistake": "Knees falling to the side",
        "fix": "Keep the knees together and the pelvis still."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap you back",
        "fix": "Control the return; take 1-2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk rotation",
        "setup": "≈12° toward the anchor",
        "peak": "≈46° away from the anchor (lumbar ≈6°, thoracic ≈40°), head turning with the hands",
        "norm": "Moderate range, mostly thoracic; end-range twisting under flexion is the concern (Marshall and McGill 2010)",
        "sources": [
          "marshall2010"
        ]
      },
      {
        "measure": "Trunk lean",
        "setup": "≈20° back from vertical (pelvis to C7)",
        "peak": "Held",
        "norm": "Tall, leaning back a little (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hands",
        "setup": "Together, 57 cm in front of the upper back at 52 cm, band tied 88 cm to the side at the same height",
        "peak": "Still in front of the breastbone, -41 cm across the midline",
        "norm": "Together in front of the chest, arms long, turning with the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knees and hips",
        "setup": "Knees ≈80°, hips ≈110°, feet flat",
        "peak": "Feet and pelvis do not move",
        "norm": "Knees bent, feet flat, pelvis still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Sit 0.6 s",
        "peak": "1.2 s away, 0.5 s pause, 1.5 s back, 0.6 s pause",
        "norm": "Controlled, no momentum (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Seated Twist, video (movement reference)",
        "url": "https://gymvisual.com/videos/23083-band-seated-twist.html"
      },
      {
        "id": "torso2015",
        "title": "Torso-twist exercise with elastic resistance vs a training machine: core muscle EMG (Scientifica 2015:403068; PubMed 26557405)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26557405/"
      },
      {
        "id": "oliva2020",
        "title": "Oliva-Lozano and Muyor 2020, core muscle activity during physical fitness exercises: a systematic review (Int J Environ Res Public Health 17(12):4306)",
        "url": "https://www.mdpi.com/1660-4601/17/12/4306"
      },
      {
        "id": "marshall2010",
        "title": "Marshall and McGill 2010, the role of axial torque in disc herniation (Clin Biomech 25:6-9), porcine model",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19815318/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Check the band and the anchor before each set: a band that slips or snaps can hit you.",
        "Repeated twisting combined with flexion promoted disc injury in a porcine model (Marshall and McGill 2010): sit tall and keep the range moderate.",
        "Disc herniation, rotation intolerance, osteoporosis: use an anti-rotation hold (Pallof press) instead.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low back discomfort: sit on a folded mat or a low box and make the turn smaller.",
        "Hip flexors cramp: lean back less."
      ],
      "regressions": [
        "Lighter band or sit closer to the anchor.",
        "Smaller turns.",
        "Seated Pallof press (hold, no turn)."
      ],
      "progressions": [
        "Stronger band.",
        "Pause 2 s at the end.",
        "Feet lifted off the floor."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Turn the trunk against the band: the external oblique of one side works with the internal oblique of the other. In elastic-band torso twists the external oblique reached about 54-77% MVC (Scientifica 2015).",
      "obliques_l": "Turn the trunk against the band (oblique pair across the trunk; Scientifica 2015).",
      "core": "Rectus and transversus abdominis hold the leaned-back sit (clinical opinion).",
      "spinal_extensors_r": "Keep the chest lifted and help the rotation (erector spinae about 32-50% MVC in torso twists, Scientifica 2015).",
      "spinal_extensors_l": "Keep the chest lifted and help the rotation (Scientifica 2015).",
      "hip_flexors_r": "Hold the hips flexed so the trunk does not fall back (clinical opinion).",
      "hip_flexors_l": "Hold the hips flexed so the trunk does not fall back (clinical opinion).",
      "ant_deltoid_r": "Hold the arms out in front (clinical opinion).",
      "ant_deltoid_l": "Hold the arms out in front (clinical opinion).",
      "pec_r": "Keep the hands together in front of the chest (clinical opinion).",
      "pec_l": "Keep the hands together in front of the chest (clinical opinion).",
      "rhomboids_midtrap_r": "Keep the shoulder blades set as the band pulls (clinical opinion).",
      "rhomboids_midtrap_l": "Keep the shoulder blades set as the band pulls (clinical opinion)."
    }
  },
