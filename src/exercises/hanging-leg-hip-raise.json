    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Check the bar is secure and can take your weight before hanging from it.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low back pain: use the bent-knee version or a smaller range; the straight-leg hanging raise loads the spine heavily.",
        "Shoulder pain in the hang: shorten the set or use arm straps."
      ],
      "modify": [
        "Grip gives out first: use arm straps or shorter sets.",
        "Too hard with straight legs: bend the knees (hanging knee raise)."
      ],
      "regressions": [
        "Hanging knee raise.",
        "Lying leg raise.",
        "Reverse crunch."
      ],
      "progressions": [
        "Toes to bar.",
        "Pause at the top.",
        "Ankle weights."
      ]
    },
    "muscleNotes": {
      "core": "Main mover for the hip raise: curls the pelvis up toward the ribs (posterior tilt).",
      "hip_flexors_r": "Lift the legs in front (hip flexion).",
      "hip_flexors_l": "Lift the legs in front (hip flexion).",
      "obliques_r": "Help curl the pelvis and stop the body twisting.",
      "obliques_l": "Help curl the pelvis and stop the body twisting.",
      "adductors_r": "Keep the legs together and help lift them.",
      "adductors_l": "Keep the legs together and help lift them.",
      "quads_r": "Keep the knees straight; the rectus femoris also flexes the hip.",
      "quads_l": "Keep the knees straight; the rectus femoris also flexes the hip.",
      "forearm_flexors_r": "Grip the bar.",
      "forearm_flexors_l": "Grip the bar.",
      "lats_r": "Keep the shoulders set and stop the body swinging.",
      "lats_l": "Keep the shoulders set and stop the body swinging.",
      "serratus_r": "Steadies the shoulder blades overhead.",
      "serratus_l": "Steadies the shoulder blades overhead.",
      "triceps_r": "Long head steadies the shoulder in the hang.",
      "triceps_l": "Long head steadies the shoulder in the hang.",
      "rhomboids_midtrap_r": "Hold the shoulder blades set.",
      "rhomboids_midtrap_l": "Hold the shoulder blades set."
    }
