    "id": "hanging-leg-hip-raise",
    "name": "Hanging Leg Hip Raise",
    "aliases": [
      "Hanging leg raise",
      "Hanging straight-leg raise",
      "Hanging leg and hip raise",
      "Hanging leg lift"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5137",
      "title": "Hanging Leg Hip Raise",
      "url": "https://gymvisual.com/videos/5137-hanging-leg-hip-raise.html",
      "listing": "Video (movement reference; page could not be read at authoring time, title from the link)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Forearms (grip)",
      "Back (lats)",
      "Thighs (quadriceps)"
    ],
    "equipment": [
      "Pull-up bar"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (hip flexion with posterior pelvic tilt and lumbar flexion, hanging)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "adductors_r",
        "adductors_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "lats_r",
        "lats_l",
        "serratus_r",
        "serratus_l",
        "triceps_r",
        "triceps_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the legs rise and the pelvis curls, breathe in on the way down.",
      "cadence": "About 1.4 s up, 2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-12",
      "tempo": "About 1.5 s up, brief hold, 2 s down",
      "load": "Body weight",
      "frequency": "2-3 times a week",
      "progression": "Higher raise (toes toward the bar), slower lowering, then ankle weights"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hang from the bar, hands a little wider than the shoulders, legs together and straight."
      },
      {
        "id": "c2",
        "phase": "set",
        "text": "Pull the shoulders down away from the ears and brace."
      },
      {
        "id": "c3",
        "phase": "raise",
        "text": "Lift the straight legs in front; as they pass level, curl the pelvis up toward the ribs."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Hold the curl for a moment, legs above level, no swing."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Uncurl the pelvis, then lower the legs slowly to the hang."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Stop the swing in the hang, then the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the body to throw the legs up",
        "fix": "Start each rep from a still hang; lower slowly so the body does not rock."
      },
      {
        "id": "m2",
        "mistake": "Only lifting the legs to level (hip flexors only)",
        "fix": "Finish with the pelvis curling up; that is the abdominal part of the rep."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back at the bottom",
        "fix": "Keep the ribs down and the trunk braced in the hang."
      },
      {
        "id": "m4",
        "mistake": "Bending the knees more and more",
        "fix": "Keep the knees nearly straight; use the bent-knee version if needed."
      },
      {
        "id": "m5",
        "mistake": "Shrugging, shoulders by the ears",
        "fix": "Keep the shoulder blades set down through the rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈3° in the dead hang",
        "peak": "≈100° at the top (joint channel); legs 48° above horizontal",
        "norm": "From about neutral in the hang to about 90-110 degrees, legs at or above level (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "Neutral in the hang",
        "peak": "Pelvis curls up: about 39° of spinal flexion (low back 20°)",
        "norm": "Posterior pelvic tilt and lumbar flexion at the top raise the abdominal demand; hanging leg raises are among the hardest abdominal exercises, with high spine compression (Axler and McGill 1997)",
        "sources": [
          "axler1997"
        ]
      },
      {
        "measure": "Knees",
        "setup": "Nearly straight (≈8°)",
        "peak": "Nearly straight (≈6°)",
        "norm": "Nearly straight; bending the knees shortens the lever and makes it easier (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body swing",
        "setup": "Body hangs under the hands",
        "peak": "Trunk 19° back from vertical at the top so the centre of mass stays under the hands (within 0.4 cm)",
        "norm": "Minimal: the trunk leans back only as much as the legs come forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.6 s, set the shoulders 0.3 s",
        "peak": "About 1.4 s up, 0.4 s hold, 2.2 s down",
        "norm": "About 1-2 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
