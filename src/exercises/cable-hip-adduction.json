{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "cable-hip-adduction",
    "name": "Cable Hip Adduction",
    "aliases": [
      "Standing cable adduction",
      "Ankle-strap cable adduction",
      "Cable inner thigh sweep"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "4349",
      "title": "Cable Hip Adduction",
      "url": "https://gymvisual.com/videos/4349-cable-hip-adduction.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (adductors)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Cable machine (low pulley)",
      "Ankle strap"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip adduction)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "adductors_r"
      ],
      "synergist": [
        "hip_flexors_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "core",
        "obliques_r",
        "calves_l"
      ],
      "lengthened": [
        "glute_med_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg sweeps in, inhale as it returns.",
      "cadence": "About 1.2 s in, 0.5 s hold, 1.8 s out"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Add a plate on the stack once 15 controlled reps are easy"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Strap the right ankle to the low pulley on your right; stand tall on the left leg, hands on the hips, leg drawn out by the cable."
      },
      {
        "id": "c2",
        "phase": "in",
        "text": "Breathe out and sweep the long right leg in, just in front of the stance foot."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause with the toes forward and the pelvis level."
      },
      {
        "id": "c4",
        "phase": "out",
        "text": "Breathe in and let the cable take the leg back out slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stop at about 25 degrees out; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning toward the tower",
        "fix": "Stay tall; the hip moves, not the trunk."
      },
      {
        "id": "m2",
        "mistake": "Swinging the leg through",
        "fix": "Slow in, pause, slower out."
      },
      {
        "id": "m3",
        "mistake": "Kicking the stance foot",
        "fix": "Let the leg pass a little in front of the stance foot."
      },
      {
        "id": "m4",
        "mistake": "Turning the toes out",
        "fix": "Keep the toes forward."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip adduction",
        "setup": "≈25° abduction",
        "peak": "≈11° adduction (channel); leg 13° past vertical, 34 cm in front of the stance ankle",
        "norm": "From about 25 degrees of abduction to 10-15 degrees past the midline (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and trunk",
        "setup": "Tall, pelvis level",
        "peak": "≤6° lean",
        "norm": "Pelvis level, trunk tall (clinical opinion)",
        "sources": [
          "boren2011"
        ]
      },
      {
        "measure": "Cable line",
        "setup": "Pulley on the right at ankle height; cable 61 cm",
        "peak": "Cable 114 cm; clears the body by 6.6 cm or more",
        "norm": "Low pulley at ankle height on the working side (standard setup)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.2 s in, 0.5 s hold, 1.8 s out",
        "norm": "Controlled, slower out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #4349, Cable Hip Adduction, video (movement reference)",
        "url": "https://gymvisual.com/videos/4349-cable-hip-adduction.html"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the strap is snug and the clip is closed before each set.",
        "Groin strain history: start light and keep the range small."
      ],
      "modify": [
        "Poor balance: hold the machine with the free hand."
      ],
      "regressions": [
        "Side-lying hip adduction."
      ],
      "progressions": [
        "Heavier stack.",
        "Longer pause."
      ]
    },
    "muscleNotes": {
      "adductors_r": "Adductor longus, brevis, magnus and gracilis pull the leg in across the body (clinical opinion).",
      "hip_flexors_r": "Assist as the leg passes in front of the stance leg (clinical opinion).",
      "glute_med_l": "Holds the pelvis level on the stance leg (Boren 2011).",
      "core": "Keeps the trunk tall (clinical opinion).",
      "obliques_r": "Resist the cable pulling the trunk toward the tower (clinical opinion).",
      "calves_l": "Balance (clinical opinion).",
      "glute_med_r": "Lengthens as the leg crosses the midline (clinical opinion)."
    }
  },
