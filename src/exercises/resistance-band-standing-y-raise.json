    "secondaryBodyParts": [
      "Upper back (serratus anterior)"
    ],
    "equipment": [
      "Resistance band"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder elevation with upward rotation of the shoulder blade)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "ant_deltoid_r",
        "ant_deltoid_l",
