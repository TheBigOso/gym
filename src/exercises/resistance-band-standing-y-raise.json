        "spinal_extensors_r",
        "spinal_extensors_l",
        "forearm_extensors_r",
        "forearm_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "effort": "Stop 2-3 reps short of failure (RIR 2-3); form first",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen; light; the band is hardest overhead, where it is stretched most",
      "progression": "More reps or a slower lowering, then a stronger band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the middle of the band, feet hip width, knees soft; hold an end in each hand by the front of the thighs, thumbs up."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the straight arms up and out into a Y, thumbs leading."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms overhead in a Y, thumbs pointing back; ribs down, shoulders away from the ears."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause by the thighs, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to get the arms higher",
        "fix": "Ribs down, glutes and abs braced; raise only as high as the back stays still."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders up to the ears",
        "fix": "Let the shoulder blades turn up but keep the neck long; use a lighter band."
      },
      {
        "id": "m3",
        "mistake": "Arms drifting in front of the face (a front raise)",
        "fix": "Keep the arms out in a Y, a little in front of the body."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the arms down",
        "fix": "Lower over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder elevation",
        "setup": "≈17° (hands by the thighs)",
        "peak": "≈145° (arms in a Y overhead)",
        "norm": "Arms overhead to about 135-145 degrees (a Y, about 45 degrees out from vertical), in line with the lower trapezius fibres; an overhead raise in that line gave the highest lower trapezius activity among the exercises tested (Ekstrom 2003, prone)",
        "sources": [
          "ekstrom2003"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈33° in front of the frontal plane",
        "peak": "≈50°",
        "norm": "A Y: about 30-45 degrees in front of the frontal plane (scapular plane, Tsuruike 2019)",
        "sources": [
          "tsuruike2019"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12°",
        "peak": "≈9°",
        "norm": "Arms long, elbows soft and steady (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "One band per hand, under the ball of each foot; strand 81.8 cm at the bottom",
        "peak": "Strand 186.8 cm at the top (most stretch, most tension)",
        "norm": "Elastic tension rises as the band stretches, so the load is highest where the band is longest; at matched effort, elastic tubing and dumbbells gave similar muscle activity in upper-body exercises (Andersen 2010); with the band under the feet the load is highest overhead",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the thighs",
        "peak": "2.0 s up, 0.4 s at the top, 2.2 s down",
        "norm": "Slow, about 2 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
