    "safety": {
      "cautions": [
        "Stop if sharp pain in the back, shoulder or elbow, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can row with a still, upright trunk.",
        "At the end of the set, lean forward and let the rope back to the stack slowly; do not let go at the finish.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low-back discomfort: keep the trunk upright the whole time (no lean at the reach) and bend the knees more (clinical opinion).",
        "Shoulder discomfort at the reach: shorten the reach so the shoulders do not round forward."
      ],
      "regressions": [
        "Lighter load.",
        "Band seated row anchored at the feet.",
        "Chest-supported dumbbell row."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Pause 1 s at the stomach.",
        "One-arm seated cable row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Prime mover: pulls the upper arm back to the side of the trunk.",
      "lats_l": "Prime mover: pulls the upper arm back to the side of the trunk.",
      "rhomboids_midtrap_r": "Prime mover: draws the shoulder blade back toward the spine at the finish.",
      "rhomboids_midtrap_l": "Prime mover: draws the shoulder blade back toward the spine at the finish.",
      "post_deltoid_r": "Helps pull the upper arm back.",
      "post_deltoid_l": "Helps pull the upper arm back.",
      "biceps_r": "Bends the elbow as the rope comes in (neutral grip).",
      "biceps_l": "Bends the elbow as the rope comes in (neutral grip).",
      "forearm_flexors_r": "Grip the rope.",
      "forearm_flexors_l": "Grip the rope.",
      "spinal_extensors_r": "Hold the spine long and the trunk upright against the cable.",
      "spinal_extensors_l": "Hold the spine long and the trunk upright against the cable.",
      "core": "Braces the trunk so the arms, not a rock of the body, move the load.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
