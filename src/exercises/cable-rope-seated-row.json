        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row the rope to the stomach, breathe in as the arms reach forward.",
      "cadence": "About 1.2 s pull, short squeeze, about 2 s return"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
      "rest": "60-120 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can row to the stomach without rocking the trunk back.",
      "progression": "Add reps, then one plate on the stack; add a 1 s squeeze"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the seat facing the low pulley, feet braced on the foot plate with the knees slightly bent; hold the rope ends with the thumbs up, arms long, chest leaning a little forward."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out; sit tall, draw the shoulder blades back and row the rope ends to the stomach, elbows close to the sides."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Elbows just behind the trunk, shoulder blades together, chest up; do not lean far back."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the arms reach forward under control, letting the shoulder blades slide forward and the chest lean slightly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief stretch at full reach, back long, then row again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the trunk far back to move the weight",
        "fix": "Keep the lean small (about 15 degrees forward to upright); lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Rounding the lower back at the reach",
        "fix": "Lean from the hips with a long spine; reach only as far as you can keep it."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulders up toward the ears",
        "fix": "Think of pulling the shoulder blades back and down."
      },
      {
        "id": "m4",
        "mistake": "Flaring the elbows out wide",
        "fix": "Keep the elbows close to the sides and pull toward the stomach."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk lean",
        "setup": "≈10° forward of upright at the reach",
        "peak": "≈-8° (upright) at the finish",
        "norm": "From slightly forward at the reach to upright at the finish, with a neutral spine; rows with a supported or upright trunk kept lumbar loads lower than a free bent-over row (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈19° (arms long)",
        "peak": "≈108°",
        "norm": "From nearly straight to about 90-100 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder extension",
        "setup": "Upper arm ≈73° from the trunk line, in front",
        "peak": "Elbows 9 cm behind the shoulders",
        "norm": "Upper arm from in front of the body to just behind the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blades",
        "setup": "Protracted (reaching forward)",
        "peak": "Retracted (drawn together)",
        "norm": "Forward (protracted) at the reach, drawn together (retracted) at the finish; retraction work drives the middle trapezius and rhomboids (Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Neutral on the rope ends, 24 cm apart",
        "peak": "Unchanged (23.51-24.68 cm)",
        "norm": "Neutral (thumbs up) on the rope ends (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stretch 0.5 s at full reach",
        "peak": "1.2 s pull, 0.4 s squeeze, 2 s return",
        "norm": "Controlled, about 1 s pull and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
