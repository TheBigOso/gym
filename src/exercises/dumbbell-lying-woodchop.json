    "secondaryBodyParts": [
      "Shoulders (moving the dumbbell)"
    ],
    "equipment": [
      "Dumbbell",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk flexion with rotation, shoulder extension)",
    "plane": "Multiplanar",
    "laterality": "Unilateral (one side at a time)",
    "authoredSide": "right",
    "muscles": {
