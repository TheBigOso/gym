        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl up and chop across, breathe in as you lower back down.",
      "cadence": "About 1.5 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per side",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0.5-1.5-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbell; light to moderate, held by the ends",
      "progression": "Add reps, then a heavier dumbbell; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent, feet flat. Hold the dumbbell by its ends with straight arms above the head, off to the left side, a little off the floor."
      },
      {
        "id": "c2",
        "phase": "chop",
        "text": "Breathe out, curl the head and shoulders up and turn to the right, sweeping the dumbbell in an arc over the body to the outside of the right knee."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause with the right shoulder blade off the floor and the left shoulder turned toward the right knee."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and reverse the arc slowly, lowering the trunk and taking the dumbbell back above the head to the left."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest the shoulders, keep the dumbbell off the floor, and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling with the arms only",
        "fix": "Lead with the ribs: curl and turn the trunk, the arms stay long."
      },
      {
        "id": "m2",
        "mistake": "Feet lifting or sliding",
        "fix": "Keep the feet flat and heavy on the floor."
      },
      {
        "id": "m3",
        "mistake": "Yanking the head forward",
        "fix": "Keep a fist of space between chin and chest; the neck follows the trunk."
      },
      {
        "id": "m4",
        "mistake": "Dropping the dumbbell back overhead",
        "fix": "Lower for about two seconds and stop a little off the floor."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk curl",
        "setup": "Lying flat, head resting (thorax ≈-1° from the floor)",
        "peak": "Thorax ≈31° off the floor, shoulder blades up",
        "norm": "Head, shoulders and shoulder blades curl off the floor, as in a twisting crunch (clinical opinion); curl-up and oblique crunch variations load the obliques and rectus abdominis (Escamilla 2006)",
        "sources": [
          "escamilla2006"
        ]
      },
      {
        "measure": "Trunk rotation",
        "setup": "Facing the ceiling",
        "peak": "≈25° toward the right knee (lumbar ≈3°)",
        "norm": "Turn toward the knee about 20-30 degrees, mostly thoracic (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell path",
        "setup": "Above the head, 20.6 cm off the floor at the wrists, to the left",
        "peak": "Outside the right knee; held by the ends 23 cm apart",
        "norm": "Diagonal arc from above the opposite shoulder to outside the knee (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Feet and pelvis",
        "setup": "Knees ≈90°, feet flat",
        "peak": "Unchanged (planted feet, still pelvis)",
        "norm": "Feet flat, pelvis on the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.6 s up, 0.4 s pause, 2.0 s down",
        "norm": "Controlled, no swing (clinical opinion)",
        "sources": []
      }
    ],
