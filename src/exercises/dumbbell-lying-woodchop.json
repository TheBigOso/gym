    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Repeated loaded trunk flexion with rotation stresses the discs; skip it with a disc problem or back pain (McGill 1998).",
        "Keep the dumbbell light enough to control over the face."
      ],
      "modify": [
        "Back discomfort: smaller curl, no dumbbell.",
        "Shoulder discomfort overhead: start with the dumbbell above the chest instead of above the head."
      ],
      "regressions": [
        "Twisting crunch with no weight.",
        "Lighter dumbbell or a medicine ball."
      ],
      "progressions": [
        "Slower 3 s lowering.",
        "Standing cable or band woodchop."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Prime movers: rotate and flex the trunk toward the right knee (left external with right internal oblique).",
      "obliques_l": "Prime movers: rotate and flex the trunk toward the right knee (left external with right internal oblique).",
      "core": "Curls the trunk off the floor (rectus abdominis).",
      "lats_r": "Pull the straight arms down from overhead.",
      "lats_l": "Pull the straight arms down from overhead.",
      "pec_r": "Brings the arms across the body.",
      "pec_l": "Brings the arms across the body.",
      "triceps_r": "Keep the elbows straight.",
      "triceps_l": "Keep the elbows straight.",
      "hip_flexors_r": "Anchor the pelvis as the trunk curls.",
      "hip_flexors_l": "Anchor the pelvis as the trunk curls.",
      "ant_deltoid_r": "Controls the dumbbell over the body.",
      "ant_deltoid_l": "Controls the dumbbell over the body.",
      "forearm_flexors_r": "Grip the dumbbell ends.",
      "forearm_flexors_l": "Grip the dumbbell ends."
