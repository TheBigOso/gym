  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "alternate-lying-floor-leg-raise",
    "name": "Alternate Lying Floor Leg Raise",
    "aliases": [
      "Single-leg raise (lying)",
      "Alternating straight-leg raise",
      "Supine alternating leg lift"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "976",
      "title": "Alternate Lying Floor Leg Raise",
      "url": "https://gymvisual.com/videos/976-alternate-lying-floor-leg-raise.html",
      "listing": "Video (movement reference; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (hip flexors) and waist",
    "secondaryBodyParts": [
      "Thighs (quadriceps)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (single-leg hip flexion, trunk held)",
    "plane": "Sagittal",
    "laterality": "Unilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core"
      ],
      "synergist": [
        "quads_r",
        "quads_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the leg rises, in as it lowers.",
      "cadence": "About 1.2 s up, 1.3 s down per leg"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per leg",
      "tempo": "About 1 s up, short pause, 1.5 s down",
      "load": "Body weight",
      "frequency": "2-4 times a week",
      "progression": "Slower lowering, then both legs hovering (alternate leg raise), then ankle weights"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, arms by your sides palms down, both legs straight on the mat."
      },
      {
        "id": "c2",
        "phase": "raiseR",
        "text": "Brace and lift the right leg straight up toward vertical; the left leg stays on the mat."
      },
      {
        "id": "c3",
        "phase": "lowerR",
        "text": "Lower it slowly back to the mat without letting the low back arch."
      },
      {
        "id": "c4",
        "phase": "raiseL",
        "text": "Same with the left leg; the right leg rests."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Both legs down, breathe, and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching as the leg lowers",
        "fix": "Brace first and keep the ribs down; shorten the range if the back lifts."
      },
      {
        "id": "m2",
        "mistake": "Bending the lifting knee",
        "fix": "Keep the knee long; lift only as high as the hamstrings allow."
      },
      {
        "id": "m3",
        "mistake": "Pushing hard through the hands",
        "fix": "Hands rest lightly; the abdominals hold the pelvis."
      },
      {
        "id": "m4",
        "mistake": "Dropping the leg",
        "fix": "Lower under control, slower than the lift."
      }
    ],
    "kinematics": [
      {
        "measure": "Lifting leg from the floor",
        "setup": "On the mat",
        "peak": "≈82° at the top",
        "norm": "Up to about vertical (75-90 degrees), limited by hamstring length (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈2°",
        "peak": "≈88° on the lifting side",
        "norm": "From 0 to about 80-90 degrees on the lifting side (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Resting leg",
        "setup": "Heels on the mat (0.2 cm)",
        "peak": "Stays on the mat (0.2 cm) while the other leg lifts",
        "norm": "Stays on the mat; a single straight-leg raise loads the spine less than a double one (McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Pelvis and low back",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Pelvis stays still on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.5 s",
        "peak": "Per leg: 1.2 s up, 0.3 s pause, 1.3 s down; 0.3 s between legs",
        "norm": "About 1 s up and 1.5 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 976, Alternate Lying Floor Leg Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/976-alternate-lying-floor-leg-raise.html"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: bend the resting knee with the foot flat; it keeps the pelvis level.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before straight-leg work."
      ],
      "modify": [
        "Bend the resting knee, foot flat.",
        "Hands under the hips."
      ],
      "regressions": [
        "Bent-knee leg lift (heel slide).",
        "Dead bug."
      ],
      "progressions": [
        "Alternate leg raise with both legs hovering.",
        "Lying leg raise (both legs).",
        "Ankle weights."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas and rectus femoris lift the right leg; leg raises gave high psoas activity in McGill's comparison (McGill 1998).",
      "hip_flexors_l": "Iliopsoas and rectus femoris lift the left leg in its turn.",
      "core": "Rectus abdominis and transversus hold the pelvis still against the pull of the lifting leg (Andersson 1997).",
      "quads_r": "Rectus femoris helps flex the hip and keeps the knee straight.",
      "quads_l": "Rectus femoris helps flex the hip and keeps the knee straight.",
      "adductors_r": "Help flex the hip near the floor and keep the leg in line.",
      "adductors_l": "Help flex the hip near the floor and keep the leg in line.",
      "obliques_r": "Resist the pelvis rotating toward the lifting leg.",
      "obliques_l": "Resist the pelvis rotating toward the lifting leg."
    }
  },
