        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the handles come back to the chest, breathe out as you press.",
      "cadence": "About 2 s back, short pause, about 1.3 s press"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2-0.3-1.3-0.5 (back-pause-press-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can press without the stacks pulling you backward or the trunk twisting.",
      "progression": "Add reps, then one plate on each stack; then a staggered stance with less forward lean"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing away from two towers with the pulleys about shoulder height, a D-handle in each hand, feet hip width, a slight forward lean, core braced; arms extended in front of the chest, palms down."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the handles come back to the sides of the chest, elbows travelling back and out at about 45-60 degrees."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with the hands beside the chest and a light stretch across the chest; shoulders down."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the handles forward and slightly together until the arms are long, elbows soft."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the chest with the hands in front; keep the trunk still and the ribs down."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Being pulled backward by the stacks",
        "fix": "Lean slightly forward, brace and use a lighter load or a staggered stance."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring straight out to the sides",
        "fix": "Keep the elbows about 45-60 degrees from the trunk."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back to push",
        "fix": "Ribs down, glutes tight, move only the arms."
      },
      {
        "id": "m4",
        "mistake": "Shrugging as you press",
        "fix": "Keep the shoulders down and back throughout."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈23° with the arms extended",
        "peak": "≈131° with the hands beside the chest",
        "norm": "From well bent with the hands beside the chest to nearly straight in front (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare",
        "setup": "–",
        "peak": "≈52° from the trunk at the chest",
        "norm": "About 45-60 degrees from the trunk at the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Palms down, hands 19.9 cm apart in front",
        "peak": "Hands 60.3 cm apart beside the chest",
        "norm": "Pronated: palms down, handles across the body (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Pulleys 138 cm high, 32 cm behind the hips, 168 cm apart",
        "peak": "Both cables clear of the body by at least 5.88 cm (over the upper arms)",
        "norm": "One cable per hand from its own pulley behind the athlete at about shoulder height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈7° forward of vertical, braced",
        "peak": "Unchanged",
        "norm": "Slight forward lean, braced; standing presses demand more trunk muscle work than seated or supported ones (Saeterbakken and Fimland 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the arms extended",
        "peak": "2 s back, 0.3 s pause, 1.3 s press",
        "norm": "Controlled, about 2 s back and 1-1.5 s press (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
