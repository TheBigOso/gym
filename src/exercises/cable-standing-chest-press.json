      },
      {
        "id": "saeterbakken2011",
        "title": "Saeterbakken, van den Tillaar and Fimland 2011, a comparison of muscle activity and 1-RM strength of three chest-press exercises with different stability requirements (J Sports Sci 29(5):533-538; PubMed 21225489)",
        "url": "https://read.qxmd.com/read/21225489/a-comparison-of-muscle-activity-and-1-rm-strength-of-three-chest-press-exercises-with-different-stability-requirements"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can press without being pulled backward.",
        "Take the handles one at a time and step forward away from the towers; at the end of the set step back before letting them go so the stacks lower under control.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Balance: use a staggered stance with one foot forward.",
        "Shoulder discomfort: shorten the range so the hands stop in front of the chest."
      ],
      "regressions": [
        "Lighter stacks.",
        "Band chest press.",
        "Seated cable chest press or machine chest press (more support)."
      ],
      "progressions": [
        "Staggered or split stance with a slower return.",
        "Single-arm cable press (anti-rotation).",
        "Heavier stacks."
      ]
    },
    "muscleNotes": {
      "pec_r": "Prime mover: pushes the arm forward and across. The unstable dumbbell press activated the pectoralis about as much as the barbell press in one study (Saeterbakken 2011); the standing cable press adds a trunk-stability demand.",
      "pec_l": "Prime mover: pushes the arm forward and across. The unstable dumbbell press activated the pectoralis about as much as the barbell press in one study (Saeterbakken 2011); the standing cable press adds a trunk-stability demand.",
      "ant_deltoid_r": "Flexes the shoulder with the chest.",
      "ant_deltoid_l": "Flexes the shoulder with the chest.",
      "triceps_r": "Straightens the elbow.",
      "triceps_l": "Straightens the elbow.",
      "serratus_r": "Moves the shoulder blade forward at the end of the press.",
      "serratus_l": "Moves the shoulder blade forward at the end of the press.",
      "core": "Holds the trunk still against the cables pulling backward (standing loads work the trunk more, Saeterbakken and Fimland 2012).",
      "obliques_r": "Resist trunk rotation and extension.",
      "obliques_l": "Resist trunk rotation and extension.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "biceps_r": "Controls the elbow on the return.",
      "biceps_l": "Controls the elbow on the return."
    }
