    "breathing": {
      "pattern": "Breathe in and brace before the bar leaves the floor, hold through the pull, breathe out at the top or once the plates are back down.",
      "cadence": "About 1.9 s up, a short lockout, about 2 s down, reset on the floor"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "2-4 minutes between sets",
      "sets": "3-4",
      "reps": "3-6",
      "tempo": "Controlled pull from the floor, short lockout, controlled lowering",
      "load": "Barbell load is user-chosen: usually 10-20 % lighter than your floor deadlift; keep the back flat off the floor, about 2-3 reps in reserve.",
      "progression": "Add 2.5-5 kg when every rep leaves the floor with a flat back; or raise the platform a little (2.5 to 10 cm)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the platform, bar over mid-foot, plates on the floor in front. Hinge down and grip just outside the knees, shins to the bar, hips a little lower than in a floor deadlift, back flat, brace."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Push the platform away: the bar slides up the shins, hips and shoulders rising together, then drive the hips through once the bar passes the knees."
      },
      {
        "id": "c3",
        "phase": "lockout",
        "text": "Stand tall, hips and knees straight, shoulders over the bar."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Hips back first, bar close to the thighs, then bend the knees to set the plates down on the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Plates touch down softly; keep the brace or take a new breath, then pull again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Back rounding in the deeper start",
        "fix": "Use a lower platform or a lighter load until the back stays flat off the floor."
      },
      {
        "id": "m2",
        "mistake": "Hips shooting up first",
        "fix": "Push with the legs so the hips and shoulders rise together."
      },
      {
        "id": "m3",
        "mistake": "Bar drifting forward",
        "fix": "Keep the bar against the shins and thighs, lats tight."
      },
      {
        "id": "m4",
        "mistake": "Too high a platform",
        "fix": "2.5-10 cm is enough; more turns it into a different lift."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈96° with the plates on the floor",
        "peak": "≈4° at lockout",
        "norm": "More knee bend at the start than a floor deadlift because the bar starts lower relative to the feet (clinical opinion); conventional deadlift about 65-85 degrees (Swinton 2011)",
        "sources": [
          "swinton2011"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈139° (joint channel); hips 60.3 cm high, knees 52.9 cm, shoulders 75.8 cm",
        "peak": "≈5° at lockout",
        "norm": "Hips above the knees, below the shoulders, deeper than from the floor (clinical opinion; conventional start: Escamilla 2002)",
        "sources": [
          "escamilla2002"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈53° from vertical, back flat",
        "peak": "≈5° at lockout",
        "norm": "Trunk more inclined than in a floor deadlift at the start (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Deficit",
        "setup": "5 cm platform, 60 cm wide (the plates sit outside it, inner faces 68.8 cm from the centre)",
        "peak": "Bar 22.5 cm above the floor at the start (17.5 cm above the feet); lockout height 85.4 cm",
        "norm": "Platform about 2.5-10 cm (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Set up 0.8 s",
        "peak": "1.9 s up, 0.6 s lockout, 2.1 s down, 0.8 s reset on the floor",
        "norm": "Controlled lift and lowering; reset on the floor each rep (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Only add the deficit once the floor deadlift is solid; the deeper start asks more of the hips and hamstrings.",
        "The platform must be solid and not slide; leave the plates clear of it.",
        "Low-back pain: go back to the floor or to blocks.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Tight hips or hamstrings: lower platform (2.5-5 cm).",
        "Grip: chalk or straps for top sets."
      ],
      "regressions": [
        "Conventional deadlift from the floor.",
        "Dumbbell deficit deadlift.",
        "Trap-bar deadlift."
      ],
      "progressions": [
        "Pause just off the floor.",
        "Slightly higher platform.",
        "Heavier bar in small steps."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor through the longer pull (Escamilla 2002).",
      "glute_max_l": "Main hip extensor through the longer pull (Escamilla 2002).",
      "hamstrings_r": "Extend the hip from the deeper hinge (Lee 2018).",
      "hamstrings_l": "Extend the hip from the deeper hinge (Lee 2018).",
      "quads_r": "Straighten the knees through the extra range off the floor.",
      "quads_l": "Straighten the knees through the extra range off the floor.",
      "spinal_extensors_r": "Hold the back flat with the bar hanging in front (Escamilla 2002).",
      "spinal_extensors_l": "Hold the back flat with the bar hanging in front (Escamilla 2002).",
      "adductors_r": "Adductor magnus assists hip extension from the bottom.",
      "adductors_l": "Adductor magnus assists hip extension from the bottom.",
      "core": "Bracing stiffens the trunk.",
      "obliques_r": "Part of the brace.",
      "obliques_l": "Part of the brace.",
      "lats_r": "Keep the bar close to the legs.",
      "lats_l": "Keep the bar close to the legs.",
      "upper_traps_r": "Hold the shoulders against the bar.",
      "upper_traps_l": "Hold the shoulders against the bar.",
