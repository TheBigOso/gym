    },
    "breathing": {
      "pattern": "Breathe out as you press, breathe steadily through the hold, in as the hands come back.",
      "cadence": "About 1 s out, 1.5 s hold, 1 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12 per side (or 10-20 s holds)",
      "tempo": "Slow press, 1-3 s hold",
      "load": "User-chosen: the cable should pull hard but never twist you",
      "frequency": "2-4 times a week",
      "progression": "Longer holds, then more weight, then tall kneeling or standing with the feet together"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Half-kneel side-on to the pulley, inside knee down, front foot flat; hold the handle with both hands at the middle of the chest."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Press straight out from the chest; do not let the cable turn you."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold at arm's length: hips and shoulders square to the front, glute of the down leg tight."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Bring the handle back to the chest, still square."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause, then press again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rotating toward the pulley",
        "fix": "Lighter weight; brace and squeeze the glute of the down leg."
      },
      {
        "id": "m2",
        "mistake": "Leaning or arching away from the cable",
        "fix": "Stay tall, ribs down, pelvis level."
      },
      {
        "id": "m3",
        "mistake": "Pressing up instead of straight out",
        "fix": "The hands travel level with the chest."
      },
      {
        "id": "m4",
        "mistake": "Front knee drifting in",
        "fix": "Keep the front shin vertical and the knee over the foot."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk rotation",
        "setup": "Square to the front",
        "peak": "None: pelvis and shoulders stay square (still joints)",
        "norm": "None: resist the cable's turning pull (anti-rotation; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hand travel",
        "setup": "Handle against the chest, 29 cm in front of the spine at T6, 79 cm high",
        "peak": "30 cm straight out at the same height; pulley 110 cm to the side",
        "norm": "From the chest straight out to about arm's length at chest height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈120°",
        "peak": "≈37°",
        "norm": "Bent at the chest, nearly straight at the end (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance",
        "setup": "Half-kneeling: down (right) knee ≈105°, front knee ≈90°, down thigh about vertical",
        "peak": "Unchanged",
        "norm": "Half-kneeling narrows the base and takes the legs out of the bracing (clinical opinion); unilateral loading raises trunk activity (Saeterbakken 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the chest",
        "peak": "1 s out, 1.5 s hold, 1 s back, 0.5 s pause",
        "norm": "Slow press, hold of a few seconds (clinical opinion)",
        "sources": []
      }
    ],
