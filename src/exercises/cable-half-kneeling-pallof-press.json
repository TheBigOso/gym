    "safety": {
      "cautions": [
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Knee pain on the down knee: use a thicker pad or switch to the standing version.",
        "Choose a load you can hold square; the load is user-chosen.",
        "Low-back pain: keep the ribs down and the pelvis level."
      ],
      "modify": [
        "Tall kneeling (both knees down).",
        "Standing Pallof press with the feet wider."
      ],
      "regressions": [
        "Lighter weight or a band.",
        "Shorter holds with the hands closer to the chest."
      ],
      "progressions": [
        "Longer holds (10-30 s).",
        "Pallof press with an overhead reach.",
        "Standing with the feet together."
      ]
    },
    "muscleNotes": {
      "obliques_l": "The obliques on both sides stop the trunk turning toward the pulley; the far-side internal and near-side external obliques work hardest (clinical opinion).",
      "obliques_r": "Work with the other side to hold the trunk square (clinical opinion).",
      "core": "Rectus abdominis and the deep abdominals brace the trunk; McGill 1998 describes this kind of bracing for spine stability.",
      "ant_deltoid_r": "Presses the hands out and holds them there (clinical opinion).",
      "ant_deltoid_l": "Presses the hands out and holds them there (clinical opinion).",
      "pec_r": "Helps press the handle out (clinical opinion).",
      "pec_l": "Helps press the handle out (clinical opinion).",
      "triceps_r": "Straightens the elbows (clinical opinion).",
      "triceps_l": "Straightens the elbows (clinical opinion).",
      "serratus_r": "Reaches the shoulder blades forward at the end of the press (clinical opinion).",
      "serratus_l": "Reaches the shoulder blades forward at the end of the press (clinical opinion).",
      "glute_max_r": "The down-leg glute keeps the hip extended and the pelvis square (clinical opinion).",
      "glute_med_r": "Steadies the pelvis on the narrow base (clinical opinion).",
      "glute_med_l": "Steadies the pelvis on the narrow base (clinical opinion).",
      "spinal_extensors_r": "Keep the trunk tall (clinical opinion).",
      "spinal_extensors_l": "Keep the trunk tall (clinical opinion).",
      "forearm_flexors_r": "Grip the handle (clinical opinion).",
      "forearm_flexors_l": "Grip the handle (clinical opinion).",
      "rhomboids_midtrap_r": "Hold the shoulder blades steady against the sideways pull (clinical opinion).",
      "rhomboids_midtrap_l": "Hold the shoulder blades steady against the sideways pull (clinical opinion)."
