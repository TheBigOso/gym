    ],
    "equipment": [
      "Cable"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isometric trunk (anti-rotation) with a horizontal press",
    "plane": "Transverse",
    "laterality": "Unilateral (cable on one side)",
    "authoredSide": "right",
    "muscles": {
