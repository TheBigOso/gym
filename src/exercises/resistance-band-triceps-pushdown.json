        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you push the band down, breathe in as it draws the hands back up.",
      "cadence": "About 1 s down, short pause, about 2 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1-0.4-2-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; choke up on the band or use a stronger one, for more tension.",
      "progression": "More reps, a slower return, choking up on the band (more stretch), then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop a band over a pull-up bar (or a high anchor) and face it, feet hip width, slight forward lean; hold the band palms down about shoulder width, elbows at your sides and bent about 90 degrees."
      },
      {
        "id": "c2",
        "phase": "push",
        "text": "Breathe out and push the band down until the arms are straight, moving only at the elbows."
      },
      {
        "id": "c3",
        "phase": "lockout",
        "text": "Squeeze the back of the arms with the hands in front of the thighs; shoulders down, wrists straight."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the band draw the hands up slowly until the elbows are back at about 90 degrees; the elbows stay pinned."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause, keep the trunk still, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows drifting forward or flaring out",
        "fix": "Keep the elbows touching your sides; use a lighter band."
      },
      {
        "id": "m2",
        "mistake": "Leaning over the band to push with body weight",
        "fix": "Stay nearly upright with a slight lean; move only the forearms."
      },
      {
        "id": "m3",
        "mistake": "Letting the band snap the hands up past 90 degrees",
        "fix": "Control the return and stop when the forearms are about level."
      },
      {
        "id": "m4",
        "mistake": "Bending the wrists",
        "fix": "Keep the wrists straight in line with the forearms."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈90° (forearms about level)",
        "peak": "≈8° (arms straight, not locked hard)",
        "norm": "From about 90 degrees to straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm",
        "setup": "≈12° forward of vertical, elbows at the sides",
        "peak": "Unchanged (elbows move 0.00 cm over the loop)",
        "norm": "Upper arm along the trunk and still; with the arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Overhand on the band, 36 cm between the hands",
        "peak": "About the same (35.91-36.05 cm)",
        "norm": "Overhand grip about shoulder width on the band (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈8° forward lean, knees soft",
        "peak": "Unchanged",
        "norm": "Upright or slightly forward, still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped over a pull-up bar 215 cm high, 42.5 cm in front of the pelvis; strands 101.8 cm",
        "peak": "Strands 140.2 cm with the arms straight; at least 4.9 cm from the face and body",
        "norm": "Anchored high in front so the strands run in front of the face; tension is highest with the arms straight (clinical opinion). Elastic resistance can give muscle activity comparable to free weights (Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the elbows at 90 degrees",
        "peak": "1 s down, 0.4 s at the bottom, 2 s up",
        "norm": "Controlled, about 1 s down and 2 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
