        "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Andersen+2010+muscle+activation+perceived+loading+dumbbells+elastic+resistance"
      }
    ],
    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a heavy bench frame or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is lightest at the start and heaviest at the end of the push; let it return under control rather than snapping back.",
        "Stop if sharp pain in the elbow or shoulder, numbness or tingling occurs.",
        "Keep the face out of the strands' path in case the band slips off the anchor.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Elbow pain: use a lighter band and a shorter range (clinical opinion).",
        "Wrist discomfort: hold the band with the palms facing each other."
      ],
      "regressions": [
        "Lighter band.",
        "One-arm band pushdown."
      ],
      "progressions": [
        "Stronger band or choke up on it.",
        "Slower 3 s return.",
        "Cable pushdown, or an overhead band triceps extension (more triceps growth with the arm overhead in a 12-week study, PubMed 35819335)."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Prime mover: straightens the elbow against the band. With the upper arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018); training in this position gave less triceps growth than overhead extensions in a 12-week study (PubMed 35819335).",
      "triceps_l": "Prime mover: straightens the elbow against the band. With the upper arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018); training in this position gave less triceps growth than overhead extensions in a 12-week study (PubMed 35819335).",
      "lats_r": "Holds the upper arm against the side so the elbow stays pinned.",
      "lats_l": "Holds the upper arm against the side so the elbow stays pinned.",
      "post_deltoid_r": "Keeps the upper arm from drifting forward.",
      "post_deltoid_l": "Keeps the upper arm from drifting forward.",
      "forearm_flexors_r": "Grip the band.",
      "forearm_flexors_l": "Grip the band.",
      "forearm_extensors_r": "Hold the wrist straight.",
      "forearm_extensors_l": "Hold the wrist straight.",
      "core": "Keeps the trunk still so body weight does not push the band."
    }
  },
