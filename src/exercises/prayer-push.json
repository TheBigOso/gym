  "exercise": {
    "id": "prayer-push",
    "name": "Prayer Push",
    "aliases": [
      "Palm press push",
      "Standing palm squeeze press",
      "Prayer press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11010",
      "title": "Prayer Push",
      "url": "https://gymvisual.com/videos/11010-prayer-push.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the proxy). Online descriptions of a \"prayer push\" differ (a standing palm press versus a push-up with the hands in a prayer position); the standing palm press is authored here and the reading is flagged as uncertain.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Front of the shoulders",
      "Upper Arms"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (isometric palm squeeze with shoulder flexion and elbow extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "triceps_r",
        "triceps_l"
      ],
      "stabilizer": [
        "serratus_r",
        "serratus_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "biceps_r",
        "biceps_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you press the palms together and push them forward; breathe in as they come back to the chest. Do not hold your breath.",
      "cadence": "About 1.6 s out, 1 s squeeze, 1.6 s back"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 (or 10-15 s squeeze holds)",
      "tempo": "1.5-1-1.5-0",
      "frequency": "3-5 times a week",
      "progression": "Squeeze harder and hold longer; then a plate or ball squeeze press"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width; palms pressed together in front of the chest, fingers up, elbows out."
      },
      {
        "id": "c2",
        "phase": "push",
        "text": "Breathe out, squeeze the palms together as hard as you can and push them straight forward."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Arms almost straight at chest height; keep squeezing, shoulders down."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and draw the hands back to the chest without easing the squeeze."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Reset the posture and go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shrugging the shoulders",
        "fix": "Keep the shoulders down away from the ears."
      },
      {
        "id": "m2",
        "mistake": "Letting the squeeze go soft on the way back",
        "fix": "Press the palms together through the whole rep."
      },
      {
        "id": "m3",
        "mistake": "Leaning back",
        "fix": "Brace the trunk; stand tall."
      },
      {
        "id": "m4",
        "mistake": "Bending the wrists hard",
        "fix": "Keep the wrists comfortable; ease off if they ache."
      }
    ],
    "kinematics": [
      {
        "measure": "Palm squeeze",
        "setup": "Palms together at the chest (hand surfaces -0.2 to 0.2 cm from the midline)",
        "peak": "Unchanged through the push",
        "norm": "Palms pressed together throughout; the chest works isometrically (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈109° at the chest",
        "peak": "≈16° at arm length",
        "norm": "From well bent at the chest to almost straight at arm length (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder flexion",
        "setup": "Hands 23.3 cm in front of the shoulders",
        "peak": "46.5 cm in front, at 130.4 cm height",
        "norm": "Arms move forward at about chest height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s set",
        "peak": "1.6 s push, 1 s squeeze, 1.6 s return",
        "norm": "Slow push and return with a short squeeze (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11010, Prayer Push (movement reference only)",
        "url": "https://gymvisual.com/videos/11010-prayer-push.html"
      }
    ],
    "safety": {
      "cautions": [
        "Wrists: pressing with the wrists bent back can strain them; keep the pressure comfortable (from the source description).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrist discomfort: press with the fingers pointing forward instead of up."
      ],
      "regressions": [
        "Squeeze at the chest only (no push)."
      ],
      "progressions": [
        "Longer squeeze holds.",
        "Plate squeeze press (Svend press)."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main target: squeezing the palms together is horizontal adduction held isometrically.",
      "pec_l": "Main target: squeezing the palms together is horizontal adduction held isometrically.",
      "ant_deltoid_r": "Raises the arms forward and holds them at chest height.",
      "ant_deltoid_l": "Raises the arms forward and holds them at chest height.",
      "triceps_r": "Straightens the elbows as the hands push forward.",
      "triceps_l": "Straightens the elbows as the hands push forward.",
      "serratus_r": "Lets the shoulder blades follow the push.",
      "serratus_l": "Lets the shoulder blades follow the push.",
      "core": "Holds the trunk still.",
      "forearm_flexors_r": "Keep the hands firm against each other.",
      "forearm_flexors_l": "Keep the hands firm against each other.",
      "biceps_r": "Steadies the elbows.",
      "biceps_l": "Steadies the elbows."
    }
  },
