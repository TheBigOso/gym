      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read; the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Cable machine",
      "Rope attachment"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "hip_flexors_r",
        "hip_flexors_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe out as you curl down, breathe in as you come back up.",
      "cadence": "About 1 s down, short squeeze, about 2 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.4-1.9-0.5 (down-squeeze-up-pause, seconds)",
      "rest": "45-90 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can curl down with the hips still for every rep.",
      "progression": "Add reps, then one plate on the stack; slower return"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel facing the high pulley, knees hip width, toes tucked. Hold the rope ends beside your head at the temples, elbows in front, trunk leaning slightly forward."
      },
      {
        "id": "c2",
        "phase": "crunch",
        "text": "Breathe out and curl the ribs toward the pelvis, bringing the elbows down toward the thighs. The hips stay over the knees."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the abdominals at the bottom; the hands stay at the head and do not pull."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and uncurl slowly back to the start, keeping tension on the cable."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Sitting the hips back toward the heels",
        "fix": "Keep the hips over the knees; the movement is a curl of the spine, not a hip hinge."
      },
      {
        "id": "m2",
        "mistake": "Pulling the rope down with the arms",
        "fix": "Lock the hands at the head; let the trunk move them."
      },
      {
        "id": "m3",
        "mistake": "Letting the stack yank you upright",
        "fix": "Return over about 2 s and stop before the weight touches down."
      },
      {
        "id": "m4",
        "mistake": "Going too heavy and bouncing",
        "fix": "Use a load you can curl and hold for a moment at the bottom."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk",
        "setup": "≈22° forward of vertical (pelvis to C7)",
        "peak": "≈76° forward of vertical",
        "norm": "From a slight forward lean to the elbows near the thighs; no study fixes the angle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Spine flexion",
        "setup": "≈4° (sum of the lumbar and thoracic segments)",
        "peak": "≈60° (lumbar ≈18°, thoracic ≈42°)",
        "norm": "Most of the curl comes from the lumbar and thoracic spine, with some pelvic tilt (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hips",
        "setup": "Over the knees, hip flexion ≈25°",
        "peak": "Still over the knees (hip flexion ≈45° as the pelvis tilts)",
        "norm": "Hips stay over the knees; sitting back turns it into a hip hinge (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hands",
        "setup": "Beside the temples, 28 cm apart",
        "peak": "Unchanged on the head (27.97-28.02 cm); rope knot above the forehead",
        "norm": "Rope held at the head, arms passive (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s at the top",
        "peak": "1.2 s down, 0.4 s squeeze, 1.9 s up",
        "norm": "Controlled, about 1 s down and 2 s up (clinical opinion)",
        "sources": []
      }
    ],
