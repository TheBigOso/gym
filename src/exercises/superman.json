      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low back pain, spondylolisthesis or spinal stenosis: the full superman has high spine compression (about 4,000-6,000 N, McGill 1998); use the bird dog or single-limb lifts instead.",
        "Neck pain: keep the head down."
      ],
      "modify": [
        "Lift only the arms and chest, or only the legs.",
        "Alternate: lift one arm and the opposite leg (lower load)."
      ],
      "regressions": [
        "Bird dog (quadruped opposite arm and leg).",
        "Prone single-leg lifts."
      ],
      "progressions": [
        "Longer holds (5-10 s).",
        "Back extension on a bench or Roman chair."
      ]
    },
    "muscleNotes": {
      "spinal_extensors_r": "Lift and hold the chest and legs. Prone trunk extension gave the highest lumbar paraspinal activity of the prone and quadruped exercises tested (Kim 2014: about 50% MVIC; Kelly 2016). A cited study put the full superman at about 62-82% MVC (Dafkou 2021 review).",
      "spinal_extensors_l": "Lift and hold the chest and legs. Prone trunk extension gave the highest lumbar paraspinal activity of the prone and quadruped exercises tested (Kim 2014: about 50% MVIC; Kelly 2016). A cited study put the full superman at about 62-82% MVC (Dafkou 2021 review).",
      "glute_max_r": "Extends the hips to lift the legs.",
      "glute_max_l": "Extends the hips to lift the legs.",
      "hamstrings_r": "Help extend the hips with the knees straight.",
      "hamstrings_l": "Help extend the hips with the knees straight.",
      "rhomboids_midtrap_r": "Set the shoulder blades as the arms lift overhead (the lower trapezius does most of this; clinical opinion).",
      "rhomboids_midtrap_l": "Set the shoulder blades as the arms lift overhead (the lower trapezius does most of this; clinical opinion).",
      "post_deltoid_r": "Helps hold the arms up off the mat (clinical opinion).",
      "post_deltoid_l": "Helps hold the arms up off the mat (clinical opinion).",
      "infraspinatus_r": "Centres the shoulder with the arms overhead (clinical opinion).",
      "infraspinatus_l": "Centres the shoulder with the arms overhead (clinical opinion).",
      "core": "Abdominals stay lightly braced so the lift comes from the whole back, not a sharp low-back hinge (clinical opinion)."
    }
  },
