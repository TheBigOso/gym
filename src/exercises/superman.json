      "title": "Superman (male)",
      "url": "https://gymvisual.com/videos/8934-superman-male.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (erector spinae)",
    "secondaryBodyParts": [
      "Hips (glutes, hamstrings)",
      "Upper back and shoulders"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isometric hold with a short lift (trunk and hip extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l",
        "hamstrings_r",
        "hamstrings_l"
      ],
      "stabilizer": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you lift, keep breathing lightly in the hold, inhale as you lower.",
      "cadence": "About 1 s up, 2 s hold, 1 s down, 1 s rest"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12",
      "tempo": "1 s up, 2 s hold, 1 s down",
      "frequency": "2-3 times a week",
      "progression": "Longer holds (5-10 s), then alternating arm and leg lifts or back extensions on a bench"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down, arms straight overhead, legs straight, forehead just off the mat."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Squeeze the glutes and lift the arms, chest and legs a few centimetres off the mat."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold about 2 s, reaching long through the fingers and toes; look at the mat."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly back to the mat."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Relax for a moment, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Cranking the head up",
        "fix": "Keep the neck long; eyes on the mat."
      },
      {
        "id": "m2",
        "mistake": "Lifting too high (sharp low-back arch)",
        "fix": "Lift only a few centimetres; length, not height."
      },
      {
        "id": "m3",
        "mistake": "Bending the knees",
        "fix": "Keep the legs straight and lift from the hips."
      },
      {
        "id": "m4",
        "mistake": "Jerking up",
        "fix": "Lift and lower smoothly."
      }
    ],
    "kinematics": [
      {
        "measure": "Chest lift",
        "setup": "Chest on the mat (1 cm)",
        "peak": "6 cm off the mat",
        "norm": "A few centimetres off the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hand and foot lift",
        "setup": "Hands and feet resting on the mat",
        "peak": "Hands 13 cm, feet 13 cm, knees 4 cm off the mat",
        "norm": "A few centimetres off the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Spine extension (sum of segments)",
        "setup": "0°",
        "peak": "≈20° (lumbar 8°, thoracic 12°)",
        "norm": "Small; the lift loads the lumbar spine with about 4,000 N or more of compression in the full superman (McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Hip extension",
        "setup": "≈-1°",
        "peak": "≈14°",
        "norm": "A few degrees past neutral, knees straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder flexion",
        "setup": "≈166° (arms overhead, hands on the mat)",
        "peak": "≈146°",
        "norm": "Arms overhead in line with the body, lifted slightly (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "1 s relaxed",
        "peak": "1 s up, 2 s hold, 1 s down, 1 s rest",
        "norm": "About 2 s hold at the top (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
