      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper Arms",
    "secondaryBodyParts": [
      "Shoulders",
      "Core"
    ],
    "equipment": [
      "Cable machine",
      "D-handle"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "post_deltoid_r",
        "post_deltoid_l",
