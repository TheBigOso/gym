        "forearm_extensors_l",
        "obliques_r",
        "obliques_l",
        "core"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe out as you push the handle down, breathe in as it rises.",
      "cadence": "About 1 s down, short pause, about 2 s up"
    },
    "prescription": {
      "sets": "2-4 per arm",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1-0.4-2-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can push down with the working elbow still at your side for every rep.",
      "progression": "Add reps, then one plate on the stack; slower return. Do the same reps with each arm."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Face the high pulley, feet hip width, slight forward lean, free hand on the hip; hold the D-handle in the working hand, palm down, elbow at your side and bent about 90 degrees."
      },
      {
        "id": "c2",
        "phase": "push",
        "text": "Breathe out and push the handle down until the arm is straight, moving only at the elbow."
      },
      {
        "id": "c3",
        "phase": "lockout",
        "text": "Squeeze the back of the arm with the hand beside the thigh; shoulder down, wrist straight."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the handle rise slowly until the elbow is back at about 90 degrees; the elbow stays pinned."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause, keep the trunk square to the tower, then repeat; switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbow drifting forward or out",
        "fix": "Keep the elbow against your side; lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Twisting the trunk toward the working arm",
        "fix": "Keep the hips and shoulders square to the tower; free hand on the hip."
      },
      {
        "id": "m3",
        "mistake": "Letting the handle fly up past 90 degrees",
        "fix": "Control the return and stop when the forearm is about level."
      },
      {
        "id": "m4",
        "mistake": "Bending the wrist",
        "fix": "Keep the wrist straight in line with the forearm."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈90° (forearm about level)",
        "peak": "≈8° (arm straight, not locked hard)",
        "norm": "From about 90 degrees to straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm",
        "setup": "≈8° forward of vertical, elbow at the side",
        "peak": "Unchanged (elbow moves 0.00 cm over the loop)",
        "norm": "Upper arm along the trunk and still; with the arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Palm down, handle 19.1 cm from the midline (in line with the shoulder)",
        "peak": "Palm back beside the thigh",
        "norm": "Palm down on a D-handle (an underhand grip is a common variation) (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈4° forward of vertical, left hand on the hip",
        "peak": "Unchanged",
        "norm": "Upright or slightly forward, square to the tower and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the elbow at 90 degrees",
        "peak": "1 s down, 0.4 s at the bottom, 2 s up",
        "norm": "Controlled, about 1 s down and 2 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable One Arm Triceps Pushdown, video (movement reference)",
        "url": "https://gymvisual.com/videos/12482-cable-one-arm-triceps-pushdown.html"
      },
      {
        "id": "kholinne2018",
        "title": "The different role of each head of the triceps brachii muscle in elbow extension (Acta Orthop Traumatol Turc 2018;52(3):201-205; PubMed 29503079; EMG plus OpenSim at 0-180 degrees of shoulder elevation)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29503079/"
      },
      {
        "id": "overhead2022",
        "title": "Triceps brachii hypertrophy is substantially greater after elbow extension training performed in the overhead versus neutral arm position (Eur J Sport Sci 2022, DOI 10.1080/17461391.2022.2100279; PubMed 35819335; 21 adults, 12 weeks, cable)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/35819335/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain in the elbow or shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can control for every rep with the elbows still.",
        "Stand close enough that the cable runs in front of the shoulder and face, not into them.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Elbow pain: use a lighter load and a shorter range (clinical opinion).",
        "Wrist discomfort: turn the palm in (neutral grip) or use a rope end."
      ],
      "regressions": [
        "Lighter load.",
        "Two-hand cable pushdown.",
        "Band pushdown."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Overhead cable triceps extension (more triceps growth than the arm-at-the-side position in a 12-week study, PubMed 35819335).",
        "Underhand-grip one-arm pushdown."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Prime mover: straightens the elbow against the cable, one arm at a time. With the upper arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018); training in this position gave less triceps growth than overhead extensions in a 12-week study (PubMed 35819335).",
      "triceps_l": "Prime mover: straightens the elbow against the cable, one arm at a time. With the upper arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018); training in this position gave less triceps growth than overhead extensions in a 12-week study (PubMed 35819335).",
      "lats_r": "Holds the upper arm against the side so the elbow stays pinned.",
      "lats_l": "Holds the upper arm against the side so the elbow stays pinned.",
      "post_deltoid_r": "Keeps the upper arm from drifting forward.",
      "post_deltoid_l": "Keeps the upper arm from drifting forward.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "forearm_extensors_r": "Hold the wrist straight.",
      "forearm_extensors_l": "Hold the wrist straight.",
      "core": "Keeps the trunk still and square so body weight does not push the handle.",
      "obliques_r": "Keep the trunk from twisting toward the working arm.",
      "obliques_l": "Keep the trunk from twisting toward the working arm."
    }
  },
