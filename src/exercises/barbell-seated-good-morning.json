        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace sitting tall, hold it as you lean forward and come back up, breathe out at the top.",
      "cadence": "About 2 s down, a short pause, about 1.4 s up"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "90 s between sets",
      "sets": "3",
      "reps": "8-12",
      "tempo": "2 s down, short pause, 1-1.5 s up",
      "load": "Barbell load is user-chosen and light: start with an empty bar; the back stays flat at every depth.",
      "progression": "Add 2.5 kg once every rep reaches the same lean with a flat back."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench, feet wide and flat, toes a little out. Bar across the upper traps (as in a back squat), hands just outside the shoulders, elbows down."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Hinge forward from the hips with a flat back, chest leading, the trunk lowering between the thighs."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop when the back would have to round to go further; hips stay on the bench."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Squeeze the glutes and lift the chest to sit tall again."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Sit tall, re-brace, then go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back to go deeper",
        "fix": "Stop at the depth where the back stays flat."
      },
      {
        "id": "m2",
        "mistake": "Bar sliding up the neck",
        "fix": "Squeeze the shoulder blades to make a shelf on the upper traps and hold the bar down into it."
      },
      {
        "id": "m3",
        "mistake": "Hips lifting off the bench",
        "fix": "Keep the glutes pressed into the seat; the trunk moves, the hips stay."
      },
      {
        "id": "m4",
        "mistake": "Head cranked up",
        "fix": "Keep the neck in line with the back, eyes on the floor ahead."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈84° seated",
        "peak": "≈135° (joint channel)",
        "norm": "Seated hinge from about 90 degrees at the hip to a deep forward lean (clinical opinion); good mornings load the hip and back extensors (Vigotsky 2015)",
        "sources": [
          "vigotsky2015"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5° (sitting tall), bar on the upper traps, 80 cm grip",
        "peak": "≈45° forward of vertical",
        "norm": "Lean forward about 45-60 degrees from upright with a flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar motion",
        "setup": "Neutral",
        "peak": "Spine channels -4°/-1°/1° (L5/T12/T6): neutral",
        "norm": "Neutral spine; avoid loaded spine flexion (McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Sit 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.4 s up, 1.1 s reset",
        "norm": "Slow and controlled (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Use a light bar; the long lever arm loads the low back a lot.",
        "Take the bar from a rack set at shoulder height when seated, or have it handed to you.",
        "Low-back pain: shorten the range or skip it.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower back: smaller range.",
        "Bar on the neck: use a pad or the safety-squat bar."
      ],
      "regressions": [
        "Seated dumbbell good morning (goblet hold).",
        "Bodyweight seated hinge.",
        "Standing good morning with a dowel."
      ],
      "progressions": [
        "Pause at the bottom.",
        "Standing barbell good morning."
      ]
    },
    "muscleNotes": {
      "spinal_extensors_r": "Hold the spine neutral and lift the trunk back up; the seated version shortens the hamstrings so the back and hips do more (Vigotsky 2015).",
      "spinal_extensors_l": "Hold the spine neutral and lift the trunk back up; the seated version shortens the hamstrings so the back and hips do more (Vigotsky 2015).",
      "glute_max_r": "Extends the hip to sit back up.",
      "glute_max_l": "Extends the hip to sit back up.",
      "hamstrings_r": "Assist hip extension with the knees bent.",
      "hamstrings_l": "Assist hip extension with the knees bent.",
      "adductors_r": "Adductor magnus assists hip extension in the wide seat.",
      "adductors_l": "Adductor magnus assists hip extension in the wide seat.",
      "core": "Bracing protects the spine (McGill 1998).",
      "obliques_r": "Part of the brace.",
      "obliques_l": "Part of the brace.",
      "upper_traps_r": "Shelf for the bar.",
      "upper_traps_l": "Shelf for the bar.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades to hold the bar.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades to hold the bar.",
      "lats_r": "Pull the bar down into the back.",
      "lats_l": "Pull the bar down into the back."
    },
