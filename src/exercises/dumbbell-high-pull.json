      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace in the hang, breathe out sharply through the drive and pull, breathe in as you lower back to the hang.",
      "cadence": "Fast up (about 0.6 s), controlled down (about 1.2 s)"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "3-6",
      "effort": "Every rep fast; stop the set when the speed drops",
      "tempo": "Explosive up, controlled down, reset in the hang",
      "rest": "90-180 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; light to moderate. With a barbell, peak power in the hang high pull was highest at about 45% of the hang power clean 1RM (Suchomel 2015)",
      "progression": "Add speed first, then load; progress to the dumbbell hang clean or snatch"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall with a dumbbell in each hand in front of the thighs, palms facing you. Push the hips back and bend the knees a little until the dumbbells are just above the knees; flat back, shoulders over the dumbbells."
      },
      {
        "id": "c2",
        "phase": "drive",
        "text": "Jump the hips forward: drive hard through the feet, straighten the hips and knees and shrug."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Let the momentum carry the dumbbells up; pull the elbows high and out to about shoulder height, dumbbells close to the chest."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the dumbbells under control and hinge back into the hang."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Reset the flat back and brace before the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling with the arms first (a slow upright row)",
        "fix": "Let the hip drive start the dumbbells moving; the arms only finish the pull."
      },
      {
        "id": "m2",
        "mistake": "Leaning back at the top",
        "fix": "Finish tall, hips straight but not pushed forward past the feet."
      },
      {
        "id": "m3",
        "mistake": "Rounding the back in the hang",
        "fix": "Hinge from the hips, chest up, dumbbells close to the thighs."
      },
      {
        "id": "m4",
        "mistake": "Wrists curled and elbows low",
        "fix": "Lead with the elbows; keep them above the hands at the top."
      }
    ],
    "kinematics": [
      {
        "measure": "Hang position",
        "setup": "trunk ≈50° above horizontal, dumbbells at 59 cm (knee joint 49 cm)",
        "peak": "—",
        "norm": "Dumbbells just above the knees: hips back, knees slightly bent, trunk inclined forward with a flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension",
        "setup": "hip 57° flexion",
        "peak": "hip 5° (upright)",
        "norm": "From the hinge to fully upright in the drive; the high pull produced more peak power and velocity than the hang clean (Suchomel 2014)",
        "sources": [
          "suchomel2014"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈25°",
        "peak": "≈6°",
        "norm": "About 20-30 degrees in the hang, nearly straight at the end of the drive (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow height",
        "setup": "arms straight",
        "peak": "elbow 3 cm from shoulder height, 10 cm above the wrist; elbow 114°",
        "norm": "Elbows up and out to about shoulder height, above the hands (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s",
        "peak": "Drive 0.35 s, pull 0.3 s, hold 0.35 s, lower 1.2 s",
        "norm": "Explosive drive; peak velocity in the hang high pull was highest with the lightest load tested, 30% of 1RM (Suchomel 2015)",
        "sources": [
          "suchomel2015"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #566613, Dumbbell High Pull, animated GIF (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/14155-dumbbell-high-pull.html"
      },
      {
        "id": "suchomel2014",
        "title": "Suchomel, Wright, Kernozek and Kline 2014, kinetic comparison of the power development between power clean variations (J Strength Cond Res 28(2):350-360)",
        "url": "https://dc.etsu.edu/etsu-works/15817"
      },
      {
        "id": "suchomel2015",
        "title": "Suchomel, Beckham and Wright 2015, effect of various loads on the force-time characteristics of the hang high pull (J Strength Cond Res 29(5):1295-1301)",
        "url": "https://dc.etsu.edu/etsu-works/15516"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The studies used a barbell; dumbbell loads and timing are clinical opinion.",
        "Keep the elbows no higher than about shoulder height if raising the arms with internal rotation causes a pinch in the shoulder."
      ],
      "modify": [
        "Shoulder pinch at the top: stop the elbows below shoulder height, or do a dumbbell jump shrug (no arm pull).",
        "Low-back discomfort: start from a higher hang (mid-thigh) with less hinge."
      ],
      "regressions": [
        "Dumbbell jump shrug or plain shrug.",
        "Dumbbell Romanian deadlift to learn the hang position.",
        "Slow dumbbell upright row to shoulder height."
      ],
      "progressions": [
        "Dumbbell hang clean.",
        "Dumbbell hang snatch.",
        "Barbell hang high pull."
      ]
    },
    "muscleNotes": {
      "upper_traps_r": "Shrug the shoulders up hard at the end of the hip drive and keep pulling as the elbows rise.",
      "upper_traps_l": "Shrug the shoulders up hard at the end of the hip drive and keep pulling as the elbows rise.",
      "lat_deltoid_r": "Lifts the elbows high and out to the sides, to about shoulder height.",
      "lat_deltoid_l": "Lifts the elbows high and out to the sides, to about shoulder height.",
      "glute_max_r": "Drives the explosive hip extension from the hang; most of the power comes from the hips and knees (clinical opinion; the high pull is a clean pulling derivative, Suchomel 2014).",
      "glute_max_l": "Drives the explosive hip extension from the hang; most of the power comes from the hips and knees (clinical opinion; the high pull is a clean pulling derivative, Suchomel 2014).",
      "post_deltoid_r": "Pulls the elbows up and back at the top.",
      "post_deltoid_l": "Pulls the elbows up and back at the top.",
      "hamstrings_r": "Load in the hang (hinge) and extend the hips.",
      "hamstrings_l": "Load in the hang (hinge) and extend the hips.",
      "quads_r": "Straighten the knees in the drive.",
      "quads_l": "Straighten the knees in the drive.",
      "rhomboids_midtrap_r": "Hold the shoulder blades back as the elbows rise.",
      "rhomboids_midtrap_l": "Hold the shoulder blades back as the elbows rise.",
      "biceps_r": "Bend the elbows as the dumbbells travel up.",
      "biceps_l": "Bend the elbows as the dumbbells travel up.",
      "calves_r": "Finish the drive; many lifters rise onto the balls of the feet (this animation keeps the feet flat).",
      "calves_l": "Finish the drive; many lifters rise onto the balls of the feet (this animation keeps the feet flat).",
      "spinal_extensors_r": "Keep the back flat in the hang and as the hips drive through.",
      "spinal_extensors_l": "Keep the back flat in the hang and as the hips drive through.",
      "core": "Braces the trunk so the hip drive passes into the arms.",
      "forearm_flexors_r": "Grip the dumbbells.",
      "forearm_flexors_l": "Grip the dumbbells."
    }
  },
