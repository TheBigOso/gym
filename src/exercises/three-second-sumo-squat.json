    "muscleNotes": {
      "quads_r": "Main knee extensors: control the 3-second lowering and drive the stand. Stance width did not change quadriceps EMG in two studies (McCaw 1999; Paoli 2009), so the sumo stance keeps them working without raising their demand.",
      "quads_l": "Main knee extensors: control the 3-second lowering and drive the stand. Stance width did not change quadriceps EMG in two studies (McCaw 1999; Paoli 2009), so the sumo stance keeps them working without raising their demand.",
      "glute_max_r": "Hip extensor; wider stances raised gluteus maximus EMG, including unloaded (Paoli 2009), and raised modelled gluteal force (Sinclair 2022). Works hardest standing up out of the bottom.",
      "glute_max_l": "Hip extensor; wider stances raised gluteus maximus EMG, including unloaded (Paoli 2009), and raised modelled gluteal force (Sinclair 2022). Works hardest standing up out of the bottom.",
      "adductors_r": "Adductor magnus and longus help extend the hip from the wide, turned-out position. Evidence is mixed (McCaw 1999 found a width effect; Paoli 2009 and Larsen 2021 did not), so the stance works them but does not isolate them.",
      "adductors_l": "Adductor magnus and longus help extend the hip from the wide, turned-out position. Evidence is mixed (McCaw 1999 found a width effect; Paoli 2009 and Larsen 2021 did not), so the stance works them but does not isolate them.",
      "hamstrings_r": "Assist hip extension on the way up; no stance-width effect (Paoli 2009).",
      "hamstrings_l": "Assist hip extension on the way up; no stance-width effect (Paoli 2009).",
      "calves_r": "Soleus and gastrocnemius control the shin; the wide stance asks less of them than a narrow squat (Larsen 2021).",
      "calves_l": "Soleus and gastrocnemius control the shin; the wide stance asks less of them than a narrow squat (Larsen 2021).",
      "glute_med_r": "Holds the knee out over the toes; no stance-width effect on its EMG (Paoli 2009; Larsen 2021).",
      "glute_med_l": "Holds the knee out over the toes; no stance-width effect on its EMG (Paoli 2009; Larsen 2021).",
      "spinal_extensors_r": "Keep the trunk upright, especially through the slow lowering (clinical opinion).",
      "spinal_extensors_l": "Keep the trunk upright, especially through the slow lowering (clinical opinion).",
      "core": "Light brace keeps the ribs down and the trunk stiff; bodyweight load does not call for a full breath hold (clinical opinion)."
    },
    "breathing": {
      "pattern": "Inhale slowly through the 3-second lowering, brace lightly at the bottom pause, exhale as you stand. No full breath hold is needed at body weight.",
      "cadence": "3 s down (inhale), about 0.5 s pause (brace), about 1 s up (exhale), then a short reset standing (natural breath)"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "tempo": "3-1-1-0: 3 s down, a short pause (about 0.5-1 s), about 1 s up, no pause at the top. About 5 s per rep, inside the 2-8 s range drawn from meta-analytic data (Korakakis 2023).",
      "timeUnderTension": "10 reps x 5 s = about 50 s per set (within the 20-70 s per set proposed by Wilk 2021, who note no data establish optimal values)",
      "frequency": "2-3 times a week, or as a warm-up before lower-body training",
      "progression": "Lengthen the pause, add reps, then hold a dumbbell or kettlebell at the chest (goblet) or between the legs"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet about 1.5x shoulder width, toes turned out about 30 degrees, hands clasped at the chest. Ribs down, chest tall, light brace."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and sit the hips straight down between the heels: one, two, three. Push the knees out over the toes the whole way."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause for a beat with thighs about parallel, trunk upright, heels flat."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive through the whole foot, squeezing the glutes to stand tall."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand fully, re-brace, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rushing the lowering (dropping in 1 s)",
        "fix": "Count one, two, three out loud; the slow descent is the point of the drill."
      },
      {
        "id": "m2",
        "mistake": "Knees caving inside the toes",
        "fix": "Push the knees out over the 2nd-3rd toe; reduce depth until you can hold the alignment. Novices drift more than experienced squatters (Lorenzetti 2018)."
      },
      {
        "id": "m3",
        "mistake": "Toes pointing straight ahead in a wide stance",
        "fix": "Turn the toes out to match the knees; a wide stance with 0 degrees toe-out was flagged as an extreme position (Lorenzetti 2018)."
      },
      {
        "id": "m4",
        "mistake": "Folding forward or hinging like a deadlift",
        "fix": "Keep the chest tall and the hands at the chest; sit down between the heels, not back."
      },
      {
        "id": "m5",
        "mistake": "Heels or inner arches lifting",
        "fix": "Keep weight across the whole foot; narrow the stance slightly if the heels rise, and stop descending when they do (ACE)."
      },
      {
        "id": "m6",
        "mistake": "Stance so wide the feet slide or the groin pulls",
        "fix": "Bring the feet in to about 1.4x shoulder width and use grippy footwear or a non-slip floor; wide stances push more force sideways into the floor (Sinclair 2022)."
      },
      {
        "id": "m7",
        "mistake": "Bouncing out of the bottom",
        "fix": "Hold the pause for a full beat before standing."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "56 cm (≈1.4x the rig's 40 cm shoulder width)",
        "peak": "Unchanged",
        "norm": "About 1.5x shoulder width (reference). Studies' wide stances: 140% of shoulder width (McCaw 1999), 1.7x acromion width (Larsen 2021), 150-200% of trochanter distance (Paoli 2009)",
