        "setup": "≈1°",
        "peak": "≈117° (joint channel, as in the HUD); ≈100° between thigh and trunk line",
        "norm": "About 110-112 degrees at the bottom of loaded squats with a 46-53 degree trunk lean (Larsen 2021); less with the upright bodyweight trunk (clinical opinion)",
        "sources": [
          "larsen2021",
          "lorenzetti2018"
        ]
      },
      {
        "measure": "Hip abduction",
        "setup": "≈13° (set by the stance)",
        "peak": "≈42° (thigh angle out of the sagittal plane, knees pushed out over the toes)",
        "norm": "Increases as the hips sink; about 33 degrees peak at 42 degrees toe-out vs about 20 degrees at 0 degrees (Sinclair 2022, habitual width)",
        "sources": [
          "sinclair2022sensors",
          "larsen2021"
        ]
      },
      {
        "measure": "Trunk inclination (forward from vertical)",
        "setup": "≈5°",
        "peak": "≈20° forward",
        "norm": "Upright; about 20-35 degrees suggested for the bodyweight version (clinical opinion). Loaded high-bar wide squats: about 46 degrees (Larsen 2021)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Knee line (front view)",
        "setup": "Knee over the 2nd-3rd toe",
        "peak": "Knee 2.0 cm outside the foot's long axis at the bottom; at most 5.3 cm inside it early in the descent (knee under 45°)",
        "norm": "Knee over the 2nd-3rd toe throughout; wider stances reduced knee drift (Lorenzetti 2018; ACE)",
