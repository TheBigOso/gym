        "upper_traps_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds; Coratella 2020)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; light",
      "progression": "Add reps, then 1-2 kg"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench, feet flat. Dumbbells hanging beside the bench, palms in, elbows soft."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise both arms straight forward, turning the palms down as the dumbbells clear the thighs."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at shoulder height, arms about shoulder width; chest up, no lean back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s back beside the bench."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rocking back to swing the weights up",
        "fix": "Sit tall and still; lighter dumbbells."
      },
      {
        "id": "m2",
        "mistake": "Raising far above shoulder height",
        "fix": "Stop at about shoulder height; above that the deltoid is unloaded and the trapezius takes over (clinical opinion)."
      },
      {
        "id": "m3",
        "mistake": "Dropping the dumbbells onto the thighs",
        "fix": "Lower them beside the bench, under control."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder flexion",
        "setup": "≈21° (dumbbells beside the bench)",
        "peak": "≈82° (hands at shoulder height, -4 cm vs the shoulder joint)",
        "norm": "From the side to about 90 degrees (the range tested by Coratella 2020)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12°",
        "peak": "≈10°",
        "norm": "Elbows soft, about 10-15 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "palms in",
        "peak": "palms down, hands 43 cm apart",
        "norm": "Palms in at the start, palms down at shoulder height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Seat",
        "setup": "bench end, seat 45 cm; trunk ≈1° forward of vertical, knees ≈94°",
        "peak": "unchanged (no rocking back)",
        "norm": "Upright on the end of a flat bench, feet flat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the bottom",
        "peak": "1.8 s up, 0.4 s at the top, 2.0 s down",
        "norm": "2 s up, 0.5 s pause, 2 s down in Coratella 2020",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #039212, Dumbbell Seated Front Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/9225-dumbbell-seated-front-raise.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://johk.pl/?p=5707"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The cited EMG study used a standing frontal raise; the seated version is assumed to load the front deltoid similarly with less swing (clinical opinion)."
      ],
      "modify": [
        "Shoulder discomfort: keep the thumbs up (neutral grip) all the way.",
        "Low-back fatigue: sit against an upright back pad."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "One arm at a time.",
        "Bent-elbow front raise."
      ],
      "progressions": [
        "Standing front raise.",
        "Incline front raise (longer range).",
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover: shoulder flexion. The frontal raise gave the highest anterior deltoid activity in the lifting phase among the raises tested (Coratella 2020; standing).",
      "ant_deltoid_l": "Main mover: shoulder flexion. The frontal raise gave the highest anterior deltoid activity in the lifting phase among the raises tested (Coratella 2020; standing).",
      "pec_r": "The clavicular head helps flex the shoulder; it was most active in the frontal raise (Coratella 2020).",
      "pec_l": "The clavicular head helps flex the shoulder; it was most active in the frontal raise (Coratella 2020).",
      "lat_deltoid_r": "Helps hold the arms up; medial deltoid activity was lower in the frontal raise than in lateral raises (Coratella 2020).",
      "lat_deltoid_l": "Helps hold the arms up; medial deltoid activity was lower in the frontal raise than in lateral raises (Coratella 2020).",
      "serratus_r": "Upward rotation of the shoulder blades as the arms rise.",
      "serratus_l": "Upward rotation of the shoulder blades as the arms rise.",
      "upper_traps_r": "Supports the shoulder blades near the top.",
      "upper_traps_l": "Supports the shoulder blades near the top.",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred.",
      "core": "Holds the trunk still; no rocking back on the seat.",
      "spinal_extensors_r": "Keep the spine tall against the load in front.",
      "spinal_extensors_l": "Keep the spine tall against the load in front."
    }
  },
