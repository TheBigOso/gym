    "breathing": {
      "pattern": "Inhale as you lower the dumbbells to the chest, exhale as you press.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9). Expect to use less than for a regular dumbbell press: the narrow grip gave the lowest 6RM loads in Saeterbakken 2021.",
      "progression": "More reps, a 1 s pause on the chest, then the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench, feet planted; press the dumbbells up with the palms facing each other and the two dumbbells touching along their length."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower them together to the middle of the chest, elbows tucked close to your sides."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbells touch the lower chest lightly, still pressed against each other."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press up, squeezing the dumbbells together the whole way."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight over the chest, dumbbells still touching; reset and go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dumbbells drifting apart",
        "fix": "Squeeze them together hard the whole set; that squeeze is what loads the chest."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows close to the ribs, about 15-30 degrees from the body."
      },
      {
        "id": "m3",
        "mistake": "Lowering to the neck or the belly",
        "fix": "Lower to the middle of the chest, with the forearms angled in toward the dumbbells."
      },
      {
        "id": "m4",
        "mistake": "Bouncing off the chest",
        "fix": "Touch lightly and press."
      },
      {
        "id": "m5",
        "mistake": "Wrists bent back",
        "fix": "Stack the wrists straight over the forearms."
      }
    ],
    "kinematics": [
      {
        "measure": "Grip",
        "setup": "Neutral, dumbbells together: centres 13.2 cm apart (plates about 0.7 cm apart at the closest)",
        "peak": "Unchanged through the rep",
        "norm": "Neutral, dumbbells pressed together (clinical opinion). A narrow grip increased triceps activity in the barbell press (Saeterbakken 2021; Muyor 2023)",
        "sources": [
          "saeterbakken2021",
          "muyor2023"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈8° (arms straight over the chest)",
        "peak": "≈109° with the dumbbells on the chest",
        "norm": "Arms straight at the top; at the bottom the dumbbells touch the chest with the elbows about 90-100 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "Arms angled in over the chest",
        "peak": "≈34° from the trunk at the bottom",
        "norm": "Elbows close to the ribs, about 15-30 degrees from the body (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell path",
        "setup": "Top: centres 55.4 cm above the shoulder joints, 4 cm toward the feet",
        "peak": "Bottom: plates 1.5 cm above the mid-chest surface (rig shapes), 22 cm below the shoulder line; rise 34.3 cm",
        "norm": "Up and down over the middle of the chest, dumbbells together (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s on the chest, 1.2 s up, 0.7 s at the top",
        "norm": "Controlled; Muyor 2023 paced 2 s up and 2 s down with a metronome",
        "sources": [
          "muyor2023"
        ]
      }
    ],
