  "exercise": {
    "id": "standing-calf-raise",
    "name": "Standing Calf Raise",
    "aliases": [
      "Calf raise",
      "Heel raise",
      "Double-leg heel raise",
      "Bodyweight calf raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "301812",
      "title": "Standing Calf Raise (female)",
      "url": "https://gymvisual.com/videos/12529-standing-calf-raise-female.html",
      "listing": "Video; data sheet: body part Calves, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Calves",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Wall (fingertip balance)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (ankle plantarflexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "calves_r",
        "calves_l"
      ],
      "synergist": [],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "glute_med_r",
        "glute_med_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you rise, inhale as you lower.",
      "cadence": "About 1 s up, 0.8 s pause, 1.8 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "15-25",
      "tempo": "1-1-2-0",
      "frequency": "3-5 times a week",
      "progression": "Single-leg calf raise, then a step edge for more range, then added load"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall facing a wall, feet hip width, toes forward, fingertips resting lightly on the wall."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Breathe out and rise onto the balls of the feet as high as you can."
      },
      {
        "id": "c3",
        "phase": "pause",
        "text": "Pause at the top; weight over the big and second toes, ankles not rolling out."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the heels slowly to the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Heels down, reset, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Half reps",
        "fix": "Rise as high as you can; activity rises with heel height (Fujisawa 2015)."
      },
      {
        "id": "m2",
        "mistake": "Ankles rolling outward",
        "fix": "Keep the pressure over the big and second toes."
      },
      {
        "id": "m3",
        "mistake": "Dropping fast or bouncing",
        "fix": "Lower over about 2 s."
      },
      {
        "id": "m4",
        "mistake": "Leaning on the wall or bending the knees",
        "fix": "Fingertips only for balance; stay tall and rise straight up."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle plantarflexion",
        "setup": "≈-2° (foot flat)",
        "peak": "≈30° (foot 34° heel-up)",
        "norm": "Rise as high as possible; heel-raise activity rises with height, and active standing plantarflexion range averaged about 50 degrees in young men (Fujisawa 2015)",
        "sources": [
          "fujisawa2015"
        ]
      },
      {
        "measure": "Heel height",
        "setup": "0 cm (heels down)",
        "peak": "≈11.2 cm",
        "norm": "Standing heel-rise height was about 9-11 cm in a small study (Zellers 2019, machine heel raise on a step)",
        "sources": [
          "zellers2019"
        ]
      },
      {
        "measure": "Knee",
        "setup": "≈4°",
        "peak": "≈4°",
        "norm": "Straight but not locked (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance width",
        "setup": "19 cm between ankle centres, toes out 5°",
        "peak": "Unchanged; balls of the feet stay planted",
        "norm": "Feet hip width, toes forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.0 s up, 0.8 s pause, 1.8 s down, 0.6 s reset",
        "norm": "Fujisawa 2015 used 1 s up and 1 s down; a slower lowering is common in training (clinical opinion)",
        "sources": [
          "fujisawa2015"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #301812, Standing Calf Raise (female), video (movement reference)",
        "url": "https://gymvisual.com/videos/12529-standing-calf-raise-female.html"
      },
      {
        "id": "fujisawa2015",
        "title": "Fujisawa et al. 2015, ankle plantar flexor activity in the double-leg heel raise and walking (J Phys Ther Sci 27(5):1523-1526; PMC4483433)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4483433/"
      },
      {
        "id": "zellers2019",
        "title": "Zellers et al. 2019, seated and standing heel raises and triceps surae activation after Achilles tendon rupture (Transl Sports Med 3(1):3-8; PMC7236791)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7236791/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Good balance: hands at the sides or on the hips, no wall.",
        "Achilles pain: smaller range and slower, as advised by a clinician."
      ],
      "regressions": [
        "Hold the wall more firmly.",
        "Seated calf raise."
      ],
      "progressions": [
        "No hand support.",
        "Single-leg calf raise.",
        "Raise from a step edge.",
        "Hold dumbbells."
      ]
    },
    "muscleNotes": {
      "calves_r": "Gastrocnemius and soleus lift the heels. Plantar flexor activity rose with heel height in the double-leg heel raise (Fujisawa 2015); standing heel raises drew more gastrocnemius activity than seated ones (Zellers 2019).",
      "calves_l": "Gastrocnemius and soleus lift the heels. Plantar flexor activity rose with heel height in the double-leg heel raise (Fujisawa 2015); standing heel raises drew more gastrocnemius activity than seated ones (Zellers 2019).",
      "quads_r": "Keep the knees straight but not locked (clinical opinion).",
      "quads_l": "Keep the knees straight but not locked (clinical opinion).",
      "glute_med_r": "Keeps the pelvis and knees steady over the feet (clinical opinion).",
      "glute_med_l": "Keeps the pelvis and knees steady over the feet (clinical opinion).",
      "core": "Keeps the body tall so it rises straight up (clinical opinion)."
    }
  },
