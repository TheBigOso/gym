{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-unisex-172-v1"
  },
  "exercise": {
    "id": "air-bike",
    "name": "Air Bike",
    "aliases": [
      "Bicycle crunch",
      "Bicycle maneuver",
      "Elbow-to-knee bicycle"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "000312",
      "title": "Air Bike (male)",
      "url": "https://gymvisual.com/videos/4156-air-bike-male.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, obliques)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk flexion with rotation, alternating hip and knee flexion)",
    "plane": "Multiplanar",
    "laterality": "Bilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as each elbow turns toward the opposite knee; breathe in as you pass through the middle. Breathe steadily, no breath-holding.",
      "cadence": "About 1.2 s per side"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-20 total twists (5-10 per side)",
      "tempo": "Slow pedalling, about 1-1.5 s per side; a short pause at each twist",
      "frequency": "2-3 times a week",
      "progression": "Slower pedalling, longer pause at each twist, straight leg lower to the floor"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, fingertips behind the head, elbows wide. Curl the head and shoulders up and lift both knees over the hips."
      },
      {
        "id": "c2",
        "phase": "twistA",
        "text": "Breathe out: turn the right elbow toward the left knee as the right leg straightens away."
      },
      {
        "id": "c3",
        "phase": "twistB",
        "text": "Switch: left elbow toward the right knee, left leg straightens."
      },
      {
        "id": "c4",
        "phase": "twistA2",
        "text": "Turn from the ribs, not by pulling the head; elbows stay wide."
      },
      {
        "id": "c5",
        "phase": "twistB2",
        "text": "Keep the low back down and pedal slowly."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Return to the middle, knees over the hips, and keep the shoulders up."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling the head forward with the hands",
        "fix": "Fingertips only, elbows wide; the turn comes from the ribs."
      },
      {
        "id": "m2",
        "mistake": "Pedalling fast with little rotation",
        "fix": "Slow down; turn the shoulder toward the knee and pause."
      },
      {
        "id": "m3",
        "mistake": "Only the elbow moves (shoulder stays on the mat)",
        "fix": "Lift and turn the whole shoulder blade off the mat."
      },
      {
        "id": "m4",
        "mistake": "Low back arching as the leg straightens",
        "fix": "Straighten the leg higher (about 45 degrees) until you can keep the back flat."
      },
      {
        "id": "m5",
        "mistake": "Holding the breath",
        "fix": "Exhale on each twist."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk curl",
        "setup": "Shoulder blades 7 cm off the mat (thoracic ≈44° flexion)",
        "peak": "Held up through every twist",
        "norm": "Head and shoulder blades off the mat throughout; lower back stays on the floor (ACE 2001 description)",
        "sources": [
          "ace2001"
        ]
      },
      {
        "measure": "Trunk rotation",
        "setup": "Square to the ceiling",
        "peak": "≈40° toward the bent knee (mostly thoracic), elbow 31 cm from the opposite knee",
        "norm": "Shoulder turns toward the opposite knee; elbow aims at the knee (ACE 2001); rotation amount is clinical opinion",
        "sources": [
          "ace2001"
        ]
      },
      {
        "measure": "Bent leg",
        "setup": "Hip ≈88°, knee ≈95° (both knees over the hips)",
        "peak": "Hip ≈119°, knee ≈118°",
        "norm": "Knee drawn toward the chest to meet the opposite elbow (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Straight leg",
        "setup": "–",
        "peak": "Hip ≈20°, knee ≈5°, leg ≈28° above the floor",
        "norm": "Knees lifted to about 45 degrees and pedalled (ACE 2001); the straight leg hovers off the floor",
        "sources": [
          "ace2001"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Set 0.6 s",
        "peak": "About 1.2 s per twist with a short pause, 4 twists per 6.4 s loop",
        "norm": "Slow pedalling (ACE 2001: \"slowly pedal\")",
        "sources": [
          "ace2001"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #000312, Air Bike (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/4156-air-bike-male.html"
      },
      {
        "id": "ace2001",
        "title": "ACE-sponsored study, Francis and Davis (San Diego State University Biomechanics Lab) 2001, best and worst abdominal exercises, 30 adults, EMG relative to a crunch (ACE FitnessMatters, May/June 2001)",
        "url": "https://www.acefitness.org/getfit/studies/BestWorstAbExercises.pdf"
      },
      {
        "id": "oliva2020",
        "title": "Oliva-Lozano and Muyor 2020, core muscle activity during physical fitness exercises: a systematic review (Int J Environ Res Public Health 17(12):4306)",
        "url": "https://www.mdpi.com/1660-4601/17/12/4306"
      },
      {
        "id": "marshall2010",
        "title": "Marshall and McGill 2010, the role of axial torque in disc herniation (Clin Biomech 25:6-9), porcine model",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19815318/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The ACE result is from a magazine-published lab study (EMG relative to a crunch), not a peer-reviewed paper; treat the ranking as indicative.",
        "Repeated loaded flexion combined with twisting promoted disc delamination in a porcine model (Marshall and McGill 2010); people with disc problems or flexion intolerance should pick a dead bug or side plank instead."
      ],
      "modify": [
        "Neck strain: rest the head in the hands without pulling, or cross the arms on the chest.",
        "Low back arches: keep the straight leg higher.",
        "Pregnancy or diastasis recti: avoid curl-up twists."
      ],
      "regressions": [
        "Feet on the floor, alternate elbow to opposite knee one side at a time.",
        "Legs only (no curl).",
        "Dead bug."
      ],
      "progressions": [
        "Slower pedalling with a 2 s pause at each twist.",
        "Straight leg lower toward the floor."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis keeps the shoulders curled off the mat the whole set. In the ACE-sponsored San Diego State study the bicycle maneuver gave the highest rectus abdominis activity of 13 exercises, about 2.5 times a standard crunch (Francis and Davis 2001).",
      "obliques_r": "Obliques turn the trunk so the elbow travels toward the opposite knee: the external oblique on the side of the moving elbow and the internal oblique on the knee side. Oblique activity was about 2.9 times a crunch, second only to the captain's chair (ACE 2001).",
      "obliques_l": "Obliques turn the trunk so the elbow travels toward the opposite knee: the external oblique on the side of the moving elbow and the internal oblique on the knee side. Oblique activity was about 2.9 times a crunch, second only to the captain's chair (ACE 2001).",
      "hip_flexors_r": "Iliopsoas draws each knee toward the chest and holds the straight leg off the floor (clinical opinion).",
      "hip_flexors_l": "Iliopsoas draws each knee toward the chest and holds the straight leg off the floor (clinical opinion).",
      "quads_r": "Straighten the extending leg and help hold it up (clinical opinion).",
      "quads_l": "Straighten the extending leg and help hold it up (clinical opinion)."
    }
  },
