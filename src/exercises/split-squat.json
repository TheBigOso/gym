  "exercise": {
    "id": "split-squat",
    "name": "Split Squat",
    "aliases": [
      "Static lunge",
      "Stationary lunge"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "078113",
      "title": "Split Squat",
      "url": "https://gymvisual.com/animated-gifs/2264-split-squat.html",
      "listing": "Animated GIF; data sheet: body part Thighs, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Core"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip, knee and ankle)",
    "plane": "Sagittal",
    "laterality": "Unilateral bias (both feet down)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "hamstrings_r",
        "hamstrings_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale on the way down, exhale on the way up.",
      "cadence": "About 1.8 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "8-15",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering, then hold dumbbells, then rear-foot-elevated split squat"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Long split stance, front foot flat, back heel up, hands on hips, chest tall."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and drop the back knee straight down toward the floor."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Both knees about 90 degrees, back knee just above the floor, front knee over the foot."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive through the front heel to come up."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the split stance, reset, repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Front knee caving inward",
        "fix": "Keep the front knee over the 2nd-3rd toe; shorten the range if needed."
      },
      {
        "id": "m2",
        "mistake": "Front heel lifting",
        "fix": "Lengthen the step and keep the weight in the front heel."
      },
      {
        "id": "m3",
        "mistake": "Back knee slamming the floor",
        "fix": "Lower under control and stop just above the floor."
      }
    ],
    "kinematics": [
      {
        "measure": "Step length (ankle centres)",
        "setup": "80 cm between ankle centres, feet 18 cm apart sideways",
        "peak": "Unchanged",
        "norm": "Front knee about over the front foot at the bottom (common guideline); a step about one leg length was suggested as optimal for strength training (Song 2023)",
        "sources": [
          "song2023"
        ]
      },
      {
        "measure": "Front knee flexion",
        "setup": "≈22°",
        "peak": "≈92°",
        "norm": "About 90 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Back knee",
        "setup": "≈33°",
        "peak": "≈94°, 13 cm above the floor (knee joint centre)",
        "norm": "Lowers to just above the floor, about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈7°",
        "peak": "≈5°",
        "norm": "Upright to slightly forward; more lean shifts work to the hip extensors (Farrokhi 2008)",
        "sources": [
          "farrokhi2008"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s reset",
        "norm": "Controlled, about 1-2 s down and 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #078113, Split Squat, animated gif (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/2264-split-squat.html"
      },
      {
        "id": "song2023",
        "title": "Song et al. 2023, effects of step lengths on lower-extremity biomechanics during the split squat (Front Bioeng Biotechnol 11:1277493)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10667687/"
      },
      {
        "id": "farrokhi2008",
        "title": "Farrokhi et al. 2008, trunk position influences lead-leg kinematics, kinetics and muscle activity in the forward lunge (J Orthop Sports Phys Ther 38:403-409)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/18591759/"
      },
      {
        "id": "trunklunge2021",
        "title": "Influence of trunk position during three lunge exercises on muscular activation in trained women (PMC8136561)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8136561/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee pain: shorten the range and keep the front knee over the middle of the foot.",
        "Balance concerns: hold a wall or chair with one hand."
      ],
      "regressions": [
        "Shorter range.",
        "Hold a support."
      ],
      "progressions": [
        "Hold dumbbells.",
        "Rear-foot-elevated (Bulgarian) split squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Front-leg knee extensors control the lowering and drive the rise.",
      "quads_l": "Front-leg knee extensors control the lowering and drive the rise.",
      "glute_max_r": "Front-leg hip extensor; works hardest out of the bottom. Longer steps raised gluteus maximus activity more than knee-extensor activity (Song 2023).",
      "glute_max_l": "Front-leg hip extensor; works hardest out of the bottom. Longer steps raised gluteus maximus activity more than knee-extensor activity (Song 2023).",
      "adductors_r": "Adductor magnus assists hip extension and steadies the thigh.",
      "adductors_l": "Adductor magnus assists hip extension and steadies the thigh.",
      "hamstrings_r": "Assist hip extension and co-contract around the front knee.",
      "hamstrings_l": "Assist hip extension and co-contract around the front knee.",
      "calves_r": "Steady the front shin; the back calf holds the heel up.",
      "calves_l": "Steady the front shin; the back calf holds the heel up.",
      "glute_med_r": "Keeps the pelvis level and the front knee over the toes on the narrow base.",
      "glute_med_l": "Keeps the pelvis level and the front knee over the toes on the narrow base.",
      "core": "Keeps the trunk tall and the pelvis level.",
      "spinal_extensors_r": "Hold the trunk upright; a forward-inclined trunk raises their activity (PMC8136561).",
      "spinal_extensors_l": "Hold the trunk upright; a forward-inclined trunk raises their activity (PMC8136561)."
    }
  },
