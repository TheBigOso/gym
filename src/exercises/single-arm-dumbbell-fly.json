      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Front of the shoulders",
      "Biceps",
      "Core"
    ],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (shoulder)",
    "plane": "Transverse",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "pec_r"
      ],
      "synergist": [
        "ant_deltoid_r",
        "biceps_r",
        "serratus_r"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "infraspinatus_r",
        "obliques_r",
        "obliques_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the arm opens, exhale as you sweep it back up.",
      "cadence": "About 2.2 s down, 0.4 s stretch, 1.5 s up"
    },
    "prescription": {
      "sets": "2-3 per side",
      "reps": "10-15",
      "tempo": "3-1-2-0",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9). Use a lighter dumbbell than for a two-arm fly at first.",
      "progression": "More reps, a longer pause in the stretch, then the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench, feet planted wide; hold one dumbbell over the chest, palm facing in, elbow softly bent; rest the other hand on your stomach."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and open the arm in a wide arc, elbow bend fixed, hips and shoulders staying flat."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop with the upper arm about level with the bench, palm to the ceiling, chest stretched."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and sweep the dumbbell back up along the same arc, squeezing the chest."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Dumbbell back over the chest, the trunk still square; repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Trunk rolling toward the dumbbell",
        "fix": "Brace, plant both feet wide and keep both shoulder blades on the bench."
      },
      {
        "id": "m2",
        "mistake": "Turning it into a press",
        "fix": "Keep the same soft elbow bend all the way down and up."
      },
      {
        "id": "m3",
        "mistake": "Lowering too far",
        "fix": "Stop with the upper arm about level with the bench."
      },
      {
        "id": "m4",
        "mistake": "Locked elbow",
        "fix": "Keep a soft bend (elbow about 150-160 degrees)."
      },
      {
        "id": "m5",
        "mistake": "Rushing the stretch",
        "fix": "Lower slowly and pause briefly at the bottom."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈22° flexion (elbow angle ≈158°)",
        "peak": "≈22° at the bottom; 22-22° through the loop",
        "norm": "Fixed soft bend: Solstad 2020 held the elbow at about 150-160 degrees (20-30 degrees of flexion) in the fly",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Arm opening (upper arm from vertical)",
        "setup": "Upper arm ≈3° from vertical",
        "peak": "≈93° from vertical at the bottom, 12° toward the hips",
        "norm": "From over the chest to about level with the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm depth",
        "setup": "–",
        "peak": "≈4° below the back plane",
        "norm": "Upper arm about level with the bench at the bottom, no lower (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Free arm",
        "setup": "Left hand resting on the stomach",
        "peak": "Unchanged",
        "norm": "Rests on the stomach (clinical opinion; the GymVisual reference is used only to identify the movement)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 56 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat and a little wider than for a two-arm fly for a stable base, knees about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2.2 s down, 0.4 s stretch, 1.5 s up, 0.6 s squeeze",
        "norm": "Slow and controlled, about 2-3 s down and 1.5-2 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #128512, Dumbbell One Arm Bench Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/21344-dumbbell-one-arm-bench-fly.html"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      },
      {
        "id": "patterson2015",
        "title": "Patterson, Vigotsky, Oppenheimer and Feser 2015, differences in unilateral chest press muscle activation and kinematics on a stable versus unstable surface while holding one versus two dumbbells (PeerJ 3:e1365; PMC4627906)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4627906/"
      }
    ],
    "safety": {
      "cautions": [
        "Get into position with the dumbbell on the thigh, lie back and bring it up over the chest; at the end lower it back to the thigh or the floor beside the bench (clinical opinion).",
        "Do not let the dumbbell pull the arm below the bench line: the stretched shoulder is the vulnerable position (clinical opinion).",
        "Keep the wrists straight over the forearms; bent-back wrists under a heavy dumbbell strain the wrist.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorten the arc.",
        "Rolling off balance: hold the bench edge with the free hand."
      ],
      "regressions": [
        "Two-arm dumbbell fly with light dumbbells.",
        "Floor fly (the floor limits the depth)."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Longer pause in the stretch.",
        "Single-arm fly on a bench with the feet together (more trunk demand)."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main mover: hugs the working arm across the chest (horizontal adduction). In the two-arm fly pectoralis activity was about 16% below the barbell bench press overall (Solstad 2020); holding one dumbbell instead of two did not change pectoralis activity in a unilateral press (Patterson 2015).",
      "ant_deltoid_r": "Helps bring the arm in; about 25% lower than in the bench press in the two-arm fly (Solstad 2020).",
      "biceps_r": "Holds the fixed elbow bend against the load: much higher than in the bench press in the fly (Solstad 2020).",
      "serratus_r": "Keeps the shoulder blade on the rib cage.",
      "forearm_flexors_r": "Grip the handle.",
      "infraspinatus_r": "Rotator cuff: steadies the shoulder in the stretched position (clinical opinion).",
      "obliques_r": "Resist the pull of the single dumbbell rolling the trunk toward the working side (clinical opinion; oblique activity changed across one- and two-dumbbell conditions in Patterson 2015).",
      "obliques_l": "Resist the pull of the single dumbbell rolling the trunk toward the working side (clinical opinion; oblique activity changed across one- and two-dumbbell conditions in Patterson 2015).",
      "core": "Brace so the hips and shoulders stay square on the bench."
    }
  },
