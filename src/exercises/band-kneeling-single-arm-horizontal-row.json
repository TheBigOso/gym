    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Knee discomfort: kneel on a mat or a folded towel.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee discomfort: half-kneeling or standing."
      ],
      "regressions": [
        "Lighter band or kneel closer to the rack.",
        "Both arms together."
      ],
      "progressions": [
        "Stronger band or kneel farther away.",
        "Half-kneeling (narrower base, more anti-rotation demand).",
        "One-arm dumbbell row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Extend the shoulder as the elbow drives back (Lehman 2004 compared muscle activity across rows and pulldowns).",
      "rhomboids_midtrap_r": "Retract the shoulder blade at the end of the row.",
      "post_deltoid_r": "Extends the arm behind the body.",
      "biceps_r": "Bends the elbow.",
      "infraspinatus_r": "Steadies the shoulder through the row.",
      "forearm_flexors_r": "Grip the band.",
      "upper_traps_r": "Steady the shoulder blade; keep it from shrugging.",
      "core": "Braces the trunk in tall kneeling.",
      "obliques_r": "Resist the one-arm pull twisting the trunk (Fenwick 2009 measured trunk muscle demand in rowing exercises).",
      "obliques_l": "Resist the one-arm pull twisting the trunk (Fenwick 2009 measured trunk muscle demand in rowing exercises).",
      "glute_max_r": "Keeps the hips extended over the knees.",
      "glute_max_l": "Keeps the hips extended over the knees."
    }
