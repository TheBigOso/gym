    "breathing": {
      "pattern": "Breathe out as you row, breathe in as the arm reaches forward again.",
      "cadence": "About 1 s row, short squeeze, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 each side",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1",
      "progression": "More reps, a longer squeeze, kneeling farther from the rack, then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Tall kneeling facing a rack, knees about hip width, glutes squeezed, trunk tall. The band is looped round the upright at about chest height; hold it in the right hand, arm straight toward the upright, palm facing in. Left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and pull the elbow straight back close to the side until the hand reaches the lower ribs, the shoulder blade drawing back."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the shoulder blade toward the spine; hips and shoulders stay square to the rack."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the arm reach forward again under control, letting the shoulder blade glide forward at the end."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the band taut, then row again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting the trunk to pull the band",
        "fix": "Keep the hips and shoulders square to the anchor; brace the trunk."
      },
      {
        "id": "m2",
        "mistake": "Sitting back onto the heels",
        "fix": "Squeeze the glutes and keep the hips over the knees."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulder up",
        "fix": "Pull the elbow back and down toward the back pocket."
      },
      {
        "id": "m4",
        "mistake": "Elbow flaring out wide",
        "fix": "Keep the elbow close to the side for a horizontal row."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow path",
        "setup": "Arm reaching toward the upright (≈72° from the trunk)",
        "peak": "Elbow 10.5 cm behind the shoulder, 26.8 cm out from the spine line",
        "norm": "Elbow travels straight back close to the side, to a little behind the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈11°",
        "peak": "≈122°",
        "norm": "Nearly straight in front to about 100-120 degrees at the ribs, the forearm staying in line with the band (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blade",
        "setup": "Protracted (clavicle 8°)",
        "peak": "Retracted (clavicle -14°)",
        "norm": "Protracted at the reach, retracted at the end of the row (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Kneeling",
        "setup": "Tall kneeling, knees ≈105°, trunk ≈5° from vertical, left hand on the hip",
        "peak": "Unchanged (hips and shoulders square)",
        "norm": "Tall kneeling, hips over the knees: one-arm rows also load the trunk against rotation (Fenwick 2009).",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack upright in line with the right shoulder, 81.1 cm up, 101 cm in front of the shoulder; strand 42.5 cm",
        "peak": "Strand 84.4 cm at the ribs",
        "norm": "Elastic resistance can give muscle activity comparable to free weights at a matched effort (Andersen 2010).",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s with the arm long",
        "peak": "1.1 s row, 0.4 s squeeze, 1.8 s back, 0.4 s pause",
        "norm": "About 1 s row and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
