  "exercise": {
    "id": "exercise-ball-one-legged-diagonal-kick-hamstring-curl",
    "name": "Exercise Ball One Legged Diagonal Kick Hamstring Curl",
    "aliases": [
      "Single-leg stability ball curl with diagonal kick",
      "Swiss ball one-leg hamstring curl and kick"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "13796",
      "title": "Exercise Ball One Legged Diagonal Kick Hamstring Curl",
      "url": "https://gymvisual.com/videos/13796-exercise-ball-one-legged-diagonal-kick-hamstring-curl.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (hamstrings)",
    "secondaryBodyParts": [
      "Hips",
      "Core"
    ],
    "equipment": [
      "Stability ball",
      "Mat"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (knee flexion with hip extension)",
    "plane": "Multiplanar",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "hamstrings_l"
      ],
      "synergist": [
        "glute_max_l",
        "calves_l",
        "hip_flexors_r"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "glute_med_l",
        "adductors_r"
      ],
      "lengthened": [
        "hamstrings_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the ball curls in and the leg kicks, inhale as both return.",
      "cadence": "About 1.2 s in, 0.5 s hold, 1.8 s out"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "6-10 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Slower return, or arms across the chest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms on the floor, left heel on the ball, right leg up in line, hips lifted."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out, curl the ball in with the left heel and kick the straight right leg up and across."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hips high, ball still."
      },
      {
        "id": "c4",
        "phase": "extend",
        "text": "Breathe in, roll the ball back out and bring the right leg back in line."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hips off the floor; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping the hips as the ball rolls in",
        "fix": "Drive the hips up as the heel comes in."
      },
      {
        "id": "m2",
        "mistake": "Letting the ball wander sideways",
        "fix": "Press the heel straight down through the middle of the ball."
      },
      {
        "id": "m3",
        "mistake": "Bending the kicking knee",
        "fix": "Keep the right leg long."
      },
      {
        "id": "m4",
        "mistake": "Rushing the roll-out",
        "fix": "Roll out over about 2 s with the hips up."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion (ball leg)",
        "setup": "≈12°",
        "peak": "≈92°",
        "norm": "From near straight to about 80-100 degrees (clinical opinion); Swiss ball curls load the hamstrings (Escamilla 2016)",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Hips",
        "setup": "Lifted in line (hip joint 27.6 cm)",
        "peak": "36.9 cm; lowest point of the seat 20.7 cm off the mat",
        "norm": "Lifted throughout (Lehecka 2017)",
        "sources": [
          "lehecka2017"
        ]
      },
      {
        "measure": "Diagonal kick",
        "setup": "Right hip ≈8°",
        "peak": "Right hip ≈78° flexion, 16° adduction, knee straight",
        "norm": "Straight leg to about 60-80 degrees of hip flexion, across the midline (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Ball",
        "setup": "55 cm ball under the left heel",
        "peak": "Rolls 27 cm toward the glutes",
        "norm": "Rolls toward the glutes under the heel (standard technique)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Set 0.8 s",
        "peak": "1.2 s in, 0.5 s hold, 1.8 s out",
        "norm": "Controlled, slower out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #13796, Exercise Ball One Legged Diagonal Kick Hamstring Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/13796-exercise-ball-one-legged-diagonal-kick-hamstring-curl.html"
      },
      {
        "id": "escamilla2016",
        "title": "Escamilla, Lewis, Pecson, Imamura and Andrews 2016, muscle activation among supine, prone and side position exercises with and without a Swiss ball (Sports Health 8(4):372-379; PMC4922527)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4922527"
      },
      {
        "id": "lehecka2017",
        "title": "Lehecka et al. 2017, building a better gluteal bridge: EMG of hip muscles during modified single-leg bridges (Int J Sports Phys Ther 12(4):543-549; PMC5534144)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5534144/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a ball rated for exercise, inflated firm, on a non-slip mat.",
        "Hamstring cramp: stop and use both legs."
      ],
      "modify": [
        "Both heels on the ball (two-leg curl)."
      ],
      "regressions": [
        "Lying hip lift on a stability ball."
      ],
      "progressions": [
        "Arms across the chest.",
        "Pause with the ball curled in."
      ]
    },
    "muscleNotes": {
      "hamstrings_l": "Curl the ball in on one leg while holding the hips up (Escamilla 2016, Swiss ball curls).",
      "glute_max_l": "Keeps the hips lifted (Lehecka 2017).",
      "calves_l": "Gastrocnemius assists knee flexion (clinical opinion).",
      "hip_flexors_r": "Lift the straight right leg into the diagonal kick (clinical opinion).",
      "core": "Steadies the trunk on one leg and the ball (Escamilla 2016).",
      "obliques_r": "Resist the twist of the diagonal kick (clinical opinion).",
      "obliques_l": "Resist the twist of the diagonal kick (clinical opinion).",
      "glute_med_l": "Keeps the pelvis level (clinical opinion).",
      "adductors_r": "Draw the kicking leg across (clinical opinion).",
      "hamstrings_r": "Lengthen as the straight leg kicks up (clinical opinion)."
    }
