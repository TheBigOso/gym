    "id": "dumbbell-incline-one-arm-lateral-raise",
    "name": "Dumbbell Incline One Arm Lateral Raise",
    "aliases": [
      "Incline side-lying lateral raise",
      "Lean-on-bench one-arm lateral raise",
      "Side-lying incline lateral raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "1368",
      "title": "Dumbbell Incline One Arm Lateral Raise",
      "url": "https://gymvisual.com/videos/1368-dumbbell-incline-one-arm-lateral-raise.html",
      "listing": "Page not read (gymvisual.com is blocked by the proxy); movement taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (middle deltoid)",
    "secondaryBodyParts": [
      "Upper back (upper trapezius)",
      "Rotator cuff (supraspinatus)"
    ],
    "equipment": [
      "Dumbbell",
      "Adjustable bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (shoulder abduction)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "lat_deltoid_r"
      ],
      "synergist": [
        "ant_deltoid_r",
        "post_deltoid_r",
        "upper_traps_r",
        "infraspinatus_r"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "core",
        "forearm_flexors_r",
        "glute_med_r",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the arm rises, breathe in as it lowers.",
      "cadence": "About 1.5 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 per arm",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0.5-1.5-0 (down-pause-up-bottom, seconds)",
      "rest": "45-75 s",
      "frequency": "2-3 times a week",
      "load": "Light dumbbell; the side-lying angle loads the bottom of the raise",
      "progression": "Add reps, then weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Turn an incline bench (about 45 degrees) across your path. Sit side-on on the seat, lean your left side on the pad with the left arm hooked over its top, feet on the floor. The right arm starts angled down across the front of the body, thumb forward."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the straight arm out and up, leading with the elbow, until it is just past vertical to the floor."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause with the arm about straight up; no shrug."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly back down across the body."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep a little tension at the bottom and repeat. Then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rolling the body away from the pad to lift",
        "fix": "Keep the left side on the pad; only the arm moves."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulder to the ear",
        "fix": "Keep the shoulder down; lead with the elbow."
      },
      {
        "id": "m3",
        "mistake": "Bending the elbow more as you lift",
        "fix": "Hold a fixed, soft elbow."
      },
      {
        "id": "m4",
        "mistake": "Swinging up from the bottom",
        "fix": "Start each rep from still."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "Arm ≈56° up from hanging, across the front of the body (≈28° from the trunk)",
        "peak": "Arm ≈15° from vertical (≈137° from the trunk)",
        "norm": "From the arm across the front of the body up to about vertical to the floor (clinical opinion); lying on an incline shifts the hardest part of the raise toward the start (Coratella 2020 compared lateral raise variations)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Bench angle",
        "setup": "Pad 45°, seat 45 cm; trunk leaning ≈45° onto it",
        "peak": "Unchanged",
        "norm": "Pad about 45 degrees, the left side of the ribs resting on it, the bottom arm over the top edge (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12°",
        "peak": "≈12°",
        "norm": "Soft, fixed (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Left side on the pad, left arm hooked over its top edge, feet on the floor",
        "peak": "Unchanged",
        "norm": "Side-on to the pad, still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s",
        "peak": "1.5 s up, 0.5 s at the top, 2.0 s down",
        "norm": "Controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #1368, Dumbbell Incline One Arm Lateral Raise, video (movement reference only; page not read)",
