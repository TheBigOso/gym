        "url": "https://johk.pl/?p=5707"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if it pinches at the top of the shoulder; raise a little lower."
      ],
      "modify": [
        "Shoulder pinching: stop at about 60-70 degrees from the body.",
        "Ribs uncomfortable on the pad: put a folded towel under the side."
      ],
      "regressions": [
        "Standing single-arm dumbbell lateral raise.",
        "Lighter dumbbell."
      ],
      "progressions": [
        "Pause at the top.",
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Prime mover: abducts the arm; the incline makes the lower part of the range harder than in a standing raise.",
      "ant_deltoid_r": "Assists when the arm drifts forward.",
      "post_deltoid_r": "Assists and steadies the arm.",
      "upper_traps_r": "Upwardly rotates the shoulder blade near the top.",
      "infraspinatus_r": "Holds the arm in a neutral rotation.",
      "obliques_r": "Hold the trunk side-on against the pad.",
      "obliques_l": "Hold the trunk side-on against the pad.",
      "core": "Holds the trunk still.",
      "forearm_flexors_r": "Hold the dumbbell.",
      "glute_med_r": "Steadies the hips on the staggered feet.",
      "glute_med_l": "Steadies the hips on the staggered feet."
    }
