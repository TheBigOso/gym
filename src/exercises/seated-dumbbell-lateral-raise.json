      "listing": "Video; data sheet: body part Shoulders, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (lateral deltoid)",
    "secondaryBodyParts": [
      "Upper back (trapezius)"
    ],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "effort": "Stop 0-3 reps short of failure (RIR 0-3)",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds; Coratella 2020)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbells; light, usually a little lighter than standing",
      "progression": "Add reps, then 1-2 kg; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench, feet flat and wide, thighs on the seat. Dumbbells hanging beside the bench, palms in, elbows soft."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the arms out to the sides, a little in front of the body, thumbs forward."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at about shoulder height, elbows level with the hands; shoulders down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s, stopping before the dumbbells touch the bench."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the dumbbells beside the bench and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rocking the trunk to start the lift",
        "fix": "Sit tall and still; use a lighter weight."
      },
      {
        "id": "m2",
        "mistake": "Shrugging toward the ears",
        "fix": "Reach the hands long and out."
      },
      {
        "id": "m3",
        "mistake": "Raising well above shoulder height",
        "fix": "Stop at about 90 degrees (impingement study 2014)."
      },
      {
        "id": "m4",
        "mistake": "Rounding the low back on the bench",
        "fix": "Sit on the sit bones with the chest up."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "≈21° (dumbbells clear of the bench)",
        "peak": "≈88° (elbow -1 cm vs the shoulder joint)",
        "norm": "From beside the bench to about 90 degrees (the range used by Coratella 2020; impingement study 2014)",
        "sources": [
          "coratella2020",
          "impinge2014"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈-1° in front of the frontal plane",
        "peak": "≈34°",
        "norm": "About 30 degrees in front of the frontal plane (scapular plane; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈18°",
        "norm": "Elbows soft, about 10-20 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Seat",
        "setup": "bench end, seat 45 cm; trunk ≈1° forward of vertical, knees ≈94°",
        "peak": "unchanged (no rocking)",
        "norm": "Upright on the end of a flat bench, knees about 90 degrees, feet flat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the bottom",
        "peak": "1.8 s up, 0.4 s at the top, 2.0 s down",
        "norm": "2 s up, 0.5 s pause, 2 s down in Coratella 2020",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #039612, Dumbbell Seated Lateral Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/5051-dumbbell-seated-lateral-raise.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://johk.pl/?p=5707"
      },
      {
        "id": "impinge2014",
        "title": "Characteristics of shoulder impingement in the recreational weight-training population (J Strength Cond Res 2014;28(4):1081-1089, PubMed 24077379)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/24077379/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The cited EMG studies used standing raises; the seated version is assumed to load the deltoids similarly with less body swing (clinical opinion)."
      ],
      "modify": [
        "Pinching at the top: stop at about 70-80 degrees.",
        "Low-back fatigue: sit against an upright back pad."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Bent-arm seated lateral raise.",
        "One arm at a time."
      ],
      "progressions": [
        "Standing lateral raise.",
        "Slower lowering or a 2 s hold at the top.",
        "Seated lateral raise with a 1.5-rep pattern."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Main mover. The lateral raise gave the highest medial deltoid activity of the exercises tested (Campos 2020); \"thumbs forward\" gave the highest medial deltoid activity in the lifting phase (Coratella 2020). Those studies tested standing raises.",
      "lat_deltoid_l": "Main mover. The lateral raise gave the highest medial deltoid activity of the exercises tested (Campos 2020); \"thumbs forward\" gave the highest medial deltoid activity in the lifting phase (Coratella 2020). Those studies tested standing raises.",
      "ant_deltoid_r": "Helps lift the arms, more so if they drift forward (Coratella 2020).",
      "ant_deltoid_l": "Helps lift the arms, more so if they drift forward (Coratella 2020).",
      "post_deltoid_r": "Helps lift the arms (Campos 2020).",
      "post_deltoid_l": "Helps lift the arms (Campos 2020).",
      "upper_traps_r": "Upward rotation of the shoulder blades near the top.",
      "upper_traps_l": "Upward rotation of the shoulder blades near the top.",
      "serratus_r": "Upward rotation of the shoulder blades.",
      "serratus_l": "Upward rotation of the shoulder blades.",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred.",
      "core": "Holds the trunk tall without back support; sitting removes leg drive and swinging (clinical opinion).",
      "spinal_extensors_r": "Keep the spine tall on the unsupported seat.",
      "spinal_extensors_l": "Keep the spine tall on the unsupported seat."
    }
  },
