    "breathing": {
      "pattern": "Inhale as the arms open, exhale as you hug them back up against the band.",
      "cadence": "About 2.2 s down, 0.4 s stretch, 1.5 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "3-1-2-0 (3 s down, 1 s stretch, 2 s up)",
      "frequency": "1-2 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; stand or sit farther from the anchor, or choke up on the band, for more tension.",
      "progression": "More reps, a slower return, more distance from the anchor (more stretch), then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set a rack (or two sturdy uprights) just behind the top of the bench and loop a band around each upright low down. Back pad at 30 degrees; glutes in the crease, upper back and head on the pad, feet planted; a handle in each hand over the upper chest, palms facing, elbows softly bent."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the arms open in a wide arc, elbows fixed in a soft bend."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Upper arms about level with the pad; feel the chest stretch, keep the band taut."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and hug the hands back up along the same arc against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the chest with the hands together over the upper chest."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the elbows into a press as the band gets heavy",
        "fix": "Keep the soft elbow bend fixed; use a lighter band."
      },
      {
        "id": "m2",
        "mistake": "Letting the band pull the arms below the bench line",
        "fix": "Stop with the upper arms about level with the pad."
      },
      {
        "id": "m3",
        "mistake": "Shoulders shrugging or rolling forward at the top",
        "fix": "Keep the shoulder blades on the pad; bring the hands together only over the chest."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the arms open",
        "fix": "Open the arms for about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "30° back pad, flat seat",
        "peak": "Glutes on the seat, upper back and head on the pad (skinned mesh within about 1 cm, measured with b2/chest_mesh.mjs)",
        "norm": "Back pad at 30 degrees, seat flat (same angle as the incline press: 30 degrees maximised upper-pectoralis activity in pressing, Rodríguez-Ridao 2020; no incline fly study found)",
        "sources": [
          "rodriguez2020",
          "lauver2016"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈22° flexion (elbow angle ≈158°)",
        "peak": "≈22° at the bottom; 22-22° through the loop",
        "norm": "Fixed soft bend: Solstad 2020 held the elbow at about 150-160 degrees (20-30 degrees of flexion) at the bottom and stopped the set if it bent further",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Arm opening (upper arm from vertical)",
        "setup": "Upper arm ≈3° from vertical",
        "peak": "≈98° from vertical at the bottom, 12° toward the hips",
        "norm": "From over the chest to about level with the bench at the bottom (clinical opinion); Solstad 2020 standardised depth in the dumbbell fly with the dumbbells reaching the chest line",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Upper arm depth",
        "setup": "–",
        "peak": "≈4° below the back plane",
        "norm": "Upper arms about level with the bench at the bottom, no lower (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral; hands 26.6 cm apart at the top",
        "peak": "Palms up at the bottom; hands 150 cm apart",
        "norm": "Neutral: palms face each other at the top and the ceiling at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped around the rack uprights 40 cm up, 85 cm behind the hinge, 120 cm apart",
        "peak": "Strands 73.1-117.3 cm (longest with the hands together), at least 5.7 cm from the body",
        "norm": "Anchored low behind and outside the bench so it pulls the arms open; tension is highest with the hands together, unlike a dumbbell fly (clinical opinion). Elastic resistance can reach muscle activity comparable to free weights (Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat, knees about 90 degrees (Solstad 2020 set-up)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2.2 s down, 0.4 s stretch, 1.5 s up, 0.6 s squeeze",
        "norm": "Slow and controlled; Solstad 2020 used a controlled self-selected tempo. About 2-3 s down and 1.5-2 s up (clinical opinion)",
        "sources": [
          "solstad2020"
        ]
      }
    ],
