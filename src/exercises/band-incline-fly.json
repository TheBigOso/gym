    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a heavy bench frame or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is lightest at the start and heaviest at the end of the push; let it return under control rather than snapping back.",
        "Shoulder pain: shorten the arc so the upper arms stop above the bench line (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorten the arc so the upper arms stop above the bench line.",
        "Elbow discomfort: keep a little more bend and use a lighter band."
      ],
      "regressions": [
        "Lighter band.",
        "Floor band fly (the floor limits the depth)."
      ],
      "progressions": [
        "Stronger band or the bench moved farther from the rack.",
        "Slower opening with a 1-2 s pause in the stretch.",
        "Incline dumbbell or cable fly."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main mover (horizontal adduction), biased toward the upper fibres by the incline: in pressing, 30 degrees gave the highest upper-pectoralis activity (Rodríguez-Ridao 2020); the fly itself has been studied flat, where it was about 16% below the barbell bench press overall (Solstad 2020).",
      "pec_l": "Main mover (horizontal adduction), biased toward the upper fibres by the incline: in pressing, 30 degrees gave the highest upper-pectoralis activity (Rodríguez-Ridao 2020); the fly itself has been studied flat, where it was about 16% below the barbell bench press overall (Solstad 2020).",
      "ant_deltoid_r": "Helps bring the arms together; it works harder as the bench rises (Rodríguez-Ridao 2020, pressing).",
      "ant_deltoid_l": "Helps bring the arms together; it works harder as the bench rises (Rodríguez-Ridao 2020, pressing).",
      "biceps_r": "Holds the fixed elbow bend against the load: biceps activity was about 76% higher in the dumbbell fly than in the bench press (Solstad 2020).",
      "biceps_l": "Holds the fixed elbow bend against the load: biceps activity was about 76% higher in the dumbbell fly than in the bench press (Solstad 2020).",
      "serratus_r": "Keeps the shoulder blades on the rib cage while the arms open and close.",
      "serratus_l": "Keeps the shoulder blades on the rib cage while the arms open and close.",
      "triceps_r": "Light work holding the elbows from bending further; about 75% lower than in the bench press (Solstad 2020).",
      "triceps_l": "Light work holding the elbows from bending further; about 75% lower than in the bench press (Solstad 2020).",
      "forearm_flexors_r": "Grip the band handle.",
      "forearm_flexors_l": "Grip the band handle.",
      "infraspinatus_r": "Rotator cuff: steadies the head of the upper arm in the stretched position (clinical opinion).",
      "infraspinatus_l": "Rotator cuff: steadies the head of the upper arm in the stretched position (clinical opinion).",
      "core": "Bracing keeps the ribs down and the pelvis on the seat."
    }
