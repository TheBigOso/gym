    "breathing": {
      "pattern": "Inhale as you lower toward the bench, exhale as you press away.",
      "cadence": "About 1.7 s down, short pause, about 1 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-20",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Lower surface over the weeks (box, then step, then floor push-up)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hands on the edge of a bench, a little wider than the shoulders, palms flat on top; walk the feet back onto the balls until the body is one straight line."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows back at about 45 degrees, bringing the chest toward the edge."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Chest just above the edge of the bench, body still straight."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and push the bench away until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep bracing at the top and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging (lower back arching)",
        "fix": "Brace the abs and squeeze the glutes so the body stays one straight line from head to heels."
      },
      {
        "id": "m2",
        "mistake": "Hips piking up",
        "fix": "Lower the hips into line with the shoulders and ankles."
      },
      {
        "id": "m3",
        "mistake": "Elbows flared straight out to the sides (a \"T\")",
        "fix": "Tuck the elbows to about 30-45 degrees from the body, pointing back toward the hips."
      },
      {
        "id": "m4",
        "mistake": "Head dropping or chin poking forward",
        "fix": "Keep the neck long; look at the floor a little ahead of the hands."
      },
      {
        "id": "m5",
        "mistake": "Bench or box sliding",
        "fix": "Use a stable bench or box against a wall, never a rolling chair."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈7° (straight, not locked)",
        "peak": "≈126° at the bottom (chest 3 cm above the bench edge)",
        "norm": "Arms straight but not locked at the top. Many lab protocols standardise the bottom at 90 degrees of elbow flexion (Zhang 2023); lowering the chest to a few cm from the edge of the bench takes the elbows further (clinical opinion)",
        "sources": [
          "zhang2023"
        ]
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "≈11°",
        "peak": "≈28°",
        "norm": "About 30-45 degrees from the body at the bottom (clinical opinion; no measured norm found)",
        "sources": []
      },
      {
        "measure": "Hand width",
        "setup": "Wrists 50 cm apart (shoulder joints 38 cm): about 131% of shoulder width",
        "peak": "Unchanged (hands planted on the bench)",
        "norm": "Shoulder width (100% of the acromion distance) or a little wider; 150% raised serratus and lowered pectoralis and triceps activity versus 100% (Kim 2016)",
        "sources": [
          "kim2016",
          "marcolin2015"
        ]
      },
      {
        "measure": "Body line",
        "setup": "Trunk ≈46° above horizontal; trunk-to-leg bend 0.0°",
        "peak": "Trunk ≈28° above horizontal; bend 0.0°",
        "norm": "Head, trunk, hips and ankles in one straight line throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Wrist extension",
        "setup": "≈82°",
        "peak": "≈64° at the bottom",
        "norm": "Palms flat; the wrist is bent back about 90 degrees with the forearm vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Load on the hands",
        "setup": "Hands 45 cm up: between the measured 55% (30 cm box) and 41% (61 cm box) of body mass, roughly 48% by straight-line interpolation (estimate)",
        "peak": "–",
        "norm": "Peak hand force about 64% of body mass for a floor push-up, 55% with hands on a 30 cm box and 41% on a 61 cm box (Wurm et al., Ebben lab)",
        "sources": [
          "wurm2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.7 s down, 0.3 s pause, 1.0 s up, 1.0 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up; lab studies used 2-2.5 s per repetition (Wurm et al.; Marcolin 2015)",
        "sources": [
          "wurm2010",
          "marcolin2015"
        ]
      }
    ],
    "sources": [
