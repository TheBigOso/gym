{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "side-lying-scissors",
    "name": "Side Lying Scissors",
    "aliases": [
      "Side-lying leg scissors",
      "Side scissors (Pilates)",
      "Side-lying scissor kicks",
      "Lateral scissors"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "10802",
      "title": "Side Lying Scissors",
      "url": "https://gymvisual.com/videos/10802-side-lying-scissors.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (outer and inner thighs)",
    "secondaryBodyParts": [
      "Obliques",
      "Hip flexors",
      "Glutes"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isometric hip hold with alternating hip flexion and extension",
    "plane": "Sagittal",
    "laterality": "Unilateral (lying on one side), legs alternate",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_med_r",
        "adductors_l"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "core",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily; exhale on every second switch.",
      "cadence": "About one breath per two switches"
    },
    "prescription": {
      "sets": "2-3 per side",
      "reps": "10-20 switches",
      "tempo": "About 0.6 s per switch",
      "frequency": "2-3 times a week",
      "progression": "Bigger swings, longer sets, then a light ankle weight on the top leg"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your left side, head on the outstretched left arm, right hand on the mat in front of the chest, hips stacked, legs long."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Lift both legs together a few centimetres off the mat, top leg a little higher."
      },
      {
        "id": "c3",
        "phase": "scissor",
        "text": "Swing the top leg forward and the bottom leg back, then switch, like scissors."
      },
      {
        "id": "c4",
        "phase": "scissor",
        "text": "Keep the hips stacked and the trunk still; the legs move, the pelvis does not."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Bring the legs together and lower them."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rolling the pelvis back and forth",
        "fix": "Smaller swings; keep the top hip stacked over the bottom hip."
      },
      {
        "id": "m2",
        "mistake": "Legs dropping to the mat",
        "fix": "Keep both legs off the mat for the whole set."
      },
      {
        "id": "m3",
        "mistake": "Bending the knees",
        "fix": "Long legs, toes pointed."
      },
      {
        "id": "m4",
        "mistake": "Arching the low back on the back swing",
        "fix": "Brace the belly; swing back only a little."
      }
    ],
    "kinematics": [
      {
        "measure": "Leg lift",
        "setup": "Legs stacked on the mat",
        "peak": "Bottom leg 6 cm off the mat (hip adduction ≈4°), top ankle 14 cm above the bottom one",
        "norm": "Both legs a few centimetres off the mat, top leg higher (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Scissor",
        "setup": "–",
        "peak": "Top leg ≈24° forward / ≈12° back; bottom leg the opposite (ankles 5 cm apart at each switch)",
        "norm": "Top leg swings forward and back past the bottom leg, about 20-30 degrees each way (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "Stacked on the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Stacked and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.6 s, lift 0.6 s",
        "peak": "0.5 s per switch (6 switches), lower 0.6 s",
        "norm": "Brisk, controlled switches (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #10802, Side Lying Scissors, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/10802-side-lying-scissors.html"
      },
      {
        "id": "boren2011",
