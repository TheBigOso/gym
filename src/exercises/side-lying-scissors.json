        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      },
      {
        "id": "distefano2009",
        "title": "Distefano et al. 2009, gluteal muscle activation during common therapeutic exercises (J Orthop Sports Phys Ther 39(7):532-540)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19574661/"
      },
      {
        "id": "macadam2015",
        "title": "Macadam, Cronin & Contreras 2015, gluteal muscle activity in dynamic hip abduction and hip external rotation exercise: a systematic review (Int J Sports Phys Ther 10(5):573-591; PMC4595911)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4595911/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Hip or groin pain on the swing: make the swings smaller."
      ],
      "modify": [
        "A folded towel under the waist or the head for comfort.",
        "Bottom knee bent for support, scissor only the top leg."
      ],
      "regressions": [
        "Bottom leg on the mat, top leg swings forward and back.",
        "Smaller swings."
      ],
      "progressions": [
        "Bigger swings.",
        "Longer sets.",
        "Light ankle weights."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "The top leg is held up off the bottom leg against gravity by gluteus medius and the other abductors while it swings (side-lying abduction is among the higher gluteus medius exercises in Boren 2011 and Distefano 2009).",
      "adductors_l": "Lifting and holding the bottom leg off the mat is adduction against gravity (clinical opinion).",
      "hip_flexors_r": "Swing the leg forward (clinical opinion).",
      "hip_flexors_l": "Swing the leg forward (clinical opinion).",
      "glute_max_r": "Swing the leg back behind the body line (clinical opinion).",
      "glute_max_l": "Swing the leg back behind the body line (clinical opinion).",
      "obliques_r": "The top-side obliques and the trunk hold the pelvis stacked and the waist lifted (clinical opinion).",
      "obliques_l": "The bottom-side obliques lift the waist off the mat and hold the pelvis steady (clinical opinion).",
      "core": "Keeps the pelvis from rocking forward and back as the legs swing (clinical opinion).",
      "quads_r": "Keep the knees straight and the legs long (clinical opinion).",
      "quads_l": "Keep the knees straight and the legs long (clinical opinion)."
    }
  },
