    "safety": {
      "cautions": [
        "Use a light dumbbell: with the hands only squeezing the ends, a heavy one can slip; hold it over the floor, not over the feet.",
        "Keep the wrists straight; stop if the wrists or elbows hurt.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: press at a slightly lower height and shorten the reach.",
        "Unsure grip: use two small weight plates pressed together (the classic Svend press)."
      ],
      "regressions": [
        "Isometric palm squeeze at the chest without a weight.",
        "Dumbbell squeeze press on a bench."
      ],
      "progressions": [
        "Longer squeeze at full reach.",
        "Slightly heavier dumbbell.",
        "Press up and out on an incline line."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main working muscle: the inward squeeze is horizontal adduction held isometrically while the arms move forward (clinical opinion).",
      "pec_l": "Main working muscle: the inward squeeze is horizontal adduction held isometrically while the arms move forward (clinical opinion).",
      "ant_deltoid_r": "Holds the arms up in front and helps the forward press (clinical opinion).",
      "ant_deltoid_l": "Holds the arms up in front and helps the forward press (clinical opinion).",
      "triceps_r": "Straightens the elbows.",
      "triceps_l": "Straightens the elbows.",
      "serratus_r": "Reaches the shoulder blades forward at full reach.",
      "serratus_l": "Reaches the shoulder blades forward at full reach.",
      "forearm_flexors_r": "Hold the flat-palm squeeze.",
      "forearm_flexors_l": "Hold the flat-palm squeeze.",
      "biceps_r": "Steadies the elbows.",
      "biceps_l": "Steadies the elbows.",
      "core": "Keeps the trunk upright as the weight moves away from the body.",
      "spinal_extensors_r": "Resist the forward pull of the outstretched load.",
      "spinal_extensors_l": "Resist the forward pull of the outstretched load."
