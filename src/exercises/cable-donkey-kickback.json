  },
  "exercise": {
    "id": "cable-donkey-kickback",
    "name": "Cable Donkey Kickback",
    "aliases": [
      "Quadruped cable kickback",
      "Ankle-strap donkey kick",
      "Kneeling cable glute kickback"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15173",
      "title": "Cable Donkey Kickback",
      "url": "https://gymvisual.com/videos/15173-cable-donkey-kickback-male.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus maximus)",
    "secondaryBodyParts": [
      "Hamstrings",
      "Core"
    ],
    "equipment": [
      "Cable machine (low pulley)",
      "Ankle strap",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip extension)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r"
      ],
      "synergist": [
        "hamstrings_r"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "glute_med_l",
        "serratus_r",
        "serratus_l",
        "triceps_r",
        "triceps_l"
      ],
      "lengthened": [
        "hip_flexors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the foot presses up, inhale as it lowers.",
      "cadence": "About 1.2 s up, 0.6 s squeeze, 1.6 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Add a plate on the stack once 15 controlled reps are easy"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Strap the right ankle to the low pulley behind you; hands under the shoulders, knees under the hips, back flat."
      },
      {
        "id": "c2",
        "phase": "up",
        "text": "Breathe out and press the right sole toward the ceiling, knee bent at 90 degrees."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Thigh level with the floor; squeeze the glute without arching."
      },
      {
        "id": "c4",
        "phase": "down",
        "text": "Breathe in and let the cable bring the knee back under the hip slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Hover the knee just over the mat; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back",
        "fix": "Stop when the thigh is level; brace the abs."
      },
      {
        "id": "m2",
        "mistake": "Rotating the hip open",
        "fix": "Keep both hip bones facing the floor."
      },
      {
        "id": "m3",
        "mistake": "Letting the knee straighten",
        "fix": "Keep the knee bent so the glute does the work."
      },
      {
        "id": "m4",
        "mistake": "Rushing the return",
        "fix": "Lower in about 1.5 s; the cable should not yank the leg down."
      }
    ],
    "kinematics": [
      {
        "measure": "Hands and knees",
        "setup": "Hands under the shoulders, knees under the hips (hip 74°)",
        "peak": "Hands and the left knee stay planted",
        "norm": "Hands under the shoulders, knees under the hips (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension",
        "setup": "Hip ≈62° flexion (knee just off the mat)",
        "peak": "Hip ≈-17° (thigh 1° from level)",
        "norm": "From about 90 degrees of flexion to the thigh level with the floor (clinical opinion); quadruped hip extension excites the gluteus maximus (Macadam 2019; Neto 2020)",
        "sources": [
          "macadam2019",
          "neto2020"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈93°",
        "peak": "≈92°",
        "norm": "About 90 degrees throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable line",
        "setup": "Pulley behind at floor level; cable 81 cm",
        "peak": "Cable 119 cm; clears the body by 3.1 cm or more",
        "norm": "Low pulley behind and in line with the strapped ankle (standard setup)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s on all fours",
        "peak": "1.2 s up, 0.6 s squeeze, 1.6 s down",
        "norm": "Controlled, squeeze at the top (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15173, Cable Donkey Kickback, video (movement reference)",
        "url": "https://gymvisual.com/videos/15173-cable-donkey-kickback-male.html"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      },
      {
        "id": "neto2020",
        "title": "Krause Neto, Soares, Vieira et al. 2020, gluteus maximus activation during common strength and hypertrophy exercises: a systematic review (J Sports Sci Med 19(1):195-203)",
        "url": "https://www.jssm.org/jssm-19-195.xml-abst"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the strap is snug and the clip is closed before each set.",
        "Wrist discomfort: use fists or forearms."
      ],
      "modify": [
        "Knee discomfort: fold the mat under the support knee."
      ],
      "regressions": [
        "Donkey kick without load."
      ],
      "progressions": [
        "Heavier stack.",
        "Longer squeeze."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Quadruped hip extension with the knee bent biases the gluteus maximus; the cable keeps tension through the whole arc (Macadam 2019; Neto 2020).",
      "hamstrings_r": "Assist, less with the knee bent (clinical opinion).",
      "core": "Holds the spine neutral (clinical opinion).",
      "obliques_r": "Stop the pelvis rotating up toward the kicking side (clinical opinion).",
      "obliques_l": "Stop the pelvis rotating (clinical opinion).",
      "glute_med_l": "Steadies the support hip (clinical opinion).",
      "serratus_r": "Holds the shoulder blades on the ribs (clinical opinion).",
      "serratus_l": "Holds the shoulder blades on the ribs (clinical opinion).",
      "triceps_r": "Keep the support arm straight (clinical opinion).",
      "triceps_l": "Keep the support arm straight (clinical opinion).",
      "hip_flexors_r": "Lengthen at the top (clinical opinion)."
    }
