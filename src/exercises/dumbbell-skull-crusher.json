    "breathing": {
      "pattern": "Inhale as the dumbbells lower beside the head, exhale as the elbows straighten.",
      "cadence": "About 2.2 s down, short pause, about 1.4 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "load": "Dumbbell load is user-chosen: pick a weight you can control for every rep with 1-3 reps in reserve (RPE 7-9).",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "progression": "More reps in the range, then a heavier dumbbell (2-5% steps), then a slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the bench, feet flat on the floor, a dumbbell in each hand, palms facing each other, arms straight up over the shoulders."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend only the elbows: the dumbbells travel back and down beside the head."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbells beside the ears, upper arms still vertical, elbows pointing at the ceiling."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbows, moving only the forearms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked, dumbbells over the shoulders; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arms swinging (turning it into a pullover)",
        "fix": "Keep the elbows pointing at the ceiling; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out wide",
        "fix": "Keep the elbows about shoulder width apart."
      },
      {
        "id": "m3",
        "mistake": "Dumbbells dropping toward the face",
        "fix": "Lower them beside the head, not over the face; use a lighter weight if control slips."
      },
      {
        "id": "m4",
        "mistake": "Lower back arching off the bench",
        "fix": "Brace, keep the feet planted and the ribs down."
      },
      {
        "id": "m5",
        "mistake": "Bouncing out of the bottom",
        "fix": "Pause briefly beside the head, then press smoothly."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (straight, not locked)",
        "peak": "≈112° at the bottom",
        "norm": "Straight but not locked at the top; lower until the dumbbells are beside the head, about 100-120 degrees of elbow flexion (clinical opinion). Activation and relative force were matched across the three heads at 90 degrees of flexion or more (PLoS ONE 2021)",
        "sources": [
          "plos2021"
        ]
      },
      {
        "measure": "Upper arm angle",
        "setup": "≈0° from vertical",
        "peak": "Unchanged: shoulder channels constant (max 0.0° from vertical over the loop)",
        "norm": "Upper arms vertical (about 90 degrees of shoulder flexion) and still; at 90 degrees and above the medial head carries the most force (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Dumbbell clearance",
        "setup": "Dumbbells over the shoulders",
        "peak": "4.1 cm from the head at the closest (rig shapes); 6.9 cm above the bench",
        "norm": "The dumbbells pass beside the head, never over the face (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Back on the bench",
        "setup": "Bench 42 cm; buttocks, upper back and head on the pad",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "Head, upper back and buttocks on the bench, feet flat on the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.2 s down, 0.3 s pause, 1.4 s up, 0.5 s at the top",
        "norm": "Controlled, about 2 s lowering and 1-1.5 s pressing (clinical opinion); the EMG comparison used sets of 7 reps at 70% of 1RM (Boehler 2011)",
        "sources": [
          "boehler2011"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #035112, Dumbbell Lying Triceps Extension, video (movement reference)",
