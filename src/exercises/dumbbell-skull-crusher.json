      }
    ],
    "safety": {
      "cautions": [
        "Elbow pain: use a lighter dumbbell, shorten the range or switch to a cable pushdown (clinical opinion).",
        "Control the dumbbells over the head; never lower them toward the face.",
        "Hand the dumbbells off by bringing them to the chest and sitting up, not by dropping them beside the bench.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Elbow discomfort: angle the upper arms slightly back toward the head, or use a neutral grip (as here).",
        "Lower back arching: put the feet on the end of the bench."
      ],
      "regressions": [
        "Lighter dumbbells, partial range.",
        "Cable or band pushdown."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Slower lowering (3 s).",
        "Incline-bench version (upper arm more overhead)."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Does all of the work: lowers the dumbbells under control and straightens the elbows. In the lying barbell version the long and lateral heads differed significantly in activity (Boehler 2011). With the upper arm vertical (about 90 degrees of shoulder flexion) the medial head produced the most force in a model and EMG study (Kholinne 2018).",
      "triceps_l": "Does all of the work: lowers the dumbbells under control and straightens the elbows. In the lying barbell version the long and lateral heads differed significantly in activity (Boehler 2011). With the upper arm vertical (about 90 degrees of shoulder flexion) the medial head produced the most force in a model and EMG study (Kholinne 2018).",
      "lats_r": "Hold the upper arms vertical as the dumbbells travel back toward the head (clinical opinion).",
      "lats_l": "Hold the upper arms vertical as the dumbbells travel back toward the head (clinical opinion).",
      "post_deltoid_r": "Helps the lats keep the elbows pointing at the ceiling (clinical opinion).",
      "post_deltoid_l": "Helps the lats keep the elbows pointing at the ceiling (clinical opinion).",
      "forearm_flexors_r": "Grip the handles and keep the wrists straight.",
      "forearm_flexors_l": "Grip the handles and keep the wrists straight.",
      "core": "Keeps the ribs down and the lower back from arching off the bench."
    }
