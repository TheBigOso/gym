  "exercise": {
    "id": "lever-standing-lateral-raise",
    "name": "Lever Standing Lateral Raise",
    "aliases": [
      "Standing lateral raise machine",
      "Machine side raise (standing)",
      "Lever side delt raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "19889",
      "title": "Lever Standing Lateral Raise",
      "url": "https://gymvisual.com/videos/19889-lever-standing-lateral-raise-male.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (gymvisual.com refused the request), so the data sheet was not read and the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders",
    "secondaryBodyParts": [
      "Upper trapezius",
      "Front of the shoulders"
    ],
    "equipment": [
      "Standing lateral raise machine (chest pad, two lever arms on fore-aft axles level with the shoulders, elbow pads)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder abduction)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "core"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe out as the arms rise, breathe in as they lower.",
      "cadence": "About 1.3 s up, short hold, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "45-75 s",
      "frequency": "1-2 times a week",
      "tempo": "1.3-0.5-2-0.5 (raise-hold-lower-pause, seconds)",
      "load": "Load is user-chosen: light; raise without shrugging or leaning.",
      "progression": "Add reps, then load; longer hold at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing the machine with the chest against the pad and the feet flat; elbows bent about 90 degrees, the outsides of the arms just above the elbows against the pads."
      },
      {
        "id": "c2",
        "phase": "work",
        "text": "Breathe out and raise the elbows out to the sides on the lever arcs, leading with the elbows."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold with the upper arms about level with the shoulders; shoulders down from the ears."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and lower the arms slowly back to the sides."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with light tension, without letting the levers rest on their stops."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the shoulders down; lighten the load."
      },
      {
        "id": "m2",
        "mistake": "Raising above shoulder height",
        "fix": "Stop with the upper arms about level with the shoulders."
      },
      {
        "id": "m3",
        "mistake": "Leaning back off the chest pad",
        "fix": "Keep the chest on the pad."
      },
      {
        "id": "m4",
        "mistake": "Dropping the arms",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "Upper arms ≈16° from the sides",
        "peak": "≈86°, about level with the shoulders",
        "norm": "From the arms near the sides to the upper arms about level with the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow",
        "setup": "≈90°, forearms forward",
        "peak": "Unchanged",
        "norm": "Held at about 90 degrees, forearms pointing forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lever",
        "setup": "Axles level with the shoulder joints (y 133.5, z ±20.2 cm), pads on the outside of the arms",
        "peak": "Levers turn 70°; pads within 0.04 cm of the arms",
        "norm": "Each pad turns about a fore-aft axle lined up with the shoulder joint, so it stays on the arm (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Deltoid EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Lateral raise variations load the lateral deltoid most in the frontal plane (Coratella 2020; Campos 2020)",
        "sources": [
          "coratella2020",
          "campos2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the arms down",
        "peak": "1.3 s up, 0.5 s hold, 2 s down",
        "norm": "About 1.3 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #19889, Lever Standing Lateral Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/19889-lever-standing-lateral-raise-male.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://johk.pl/?p=5707"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Load is user-chosen: start light; the shoulder needs little load here.",
        "Pain at the top of the raise: stop lower.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: raise to about 70 degrees only."
      ],
      "regressions": [
        "Lighter load.",
        "Band standing lateral raise."
      ],
      "progressions": [
        "Heavier load.",
        "Pause 2 s at the top."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Prime mover: raises the arm to the side (Coratella 2020).",
      "lat_deltoid_l": "Prime mover: raises the arm to the side (Coratella 2020).",
      "ant_deltoid_r": "Helps raise the arm.",
      "ant_deltoid_l": "Helps raise the arm.",
      "upper_traps_r": "Rotates the shoulder blade upward near the top.",
      "upper_traps_l": "Rotates the shoulder blade upward near the top.",
      "serratus_r": "Rotates the shoulder blade upward.",
      "serratus_l": "Rotates the shoulder blade upward.",
      "infraspinatus_r": "Steadies the shoulder.",
      "infraspinatus_l": "Steadies the shoulder.",
      "core": "Keeps the trunk still on the pad."
    }
