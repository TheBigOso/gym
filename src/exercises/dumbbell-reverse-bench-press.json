    "safety": {
      "cautions": [
        "Get into position safely: sit with the dumbbells on the thighs, lie back and kick them up with the knees; at the end of the set bring them back to the thighs rather than dropping them (clinical opinion).",
        "Shoulder pain: shorten the range at the bottom until it settles (clinical opinion).",
        "Keep the wrists straight over the forearms; bent-back wrists under a heavy dumbbell strain the wrist.",
        "Start light: an underhand grip is harder to control, and a dumbbell that rolls out of the hand can hit the face (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrist discomfort: use the neutral (hammer) grip instead."
      ],
      "regressions": [
        "Dumbbell lying hammer press.",
        "Dumbbell floor press."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Pause 1-2 s at the bottom."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher; a reverse (supinated) grip raised upper (clavicular) pectoralis activity in the barbell bench press (Lehman 2005).",
      "pec_l": "As the right side.",
      "triceps_r": "Straightens the elbow with the elbows tucked.",
      "triceps_l": "As the right side.",
      "ant_deltoid_r": "Flexes the shoulder as the arm rises.",
      "ant_deltoid_l": "As the right side.",
      "serratus_r": "Holds the shoulder blade on the rib cage.",
      "serratus_l": "As the right side.",
      "biceps_r": "More involved with the forearm turned up; steadies the elbow (Lehman 2005; Saeterbakken 2011).",
      "biceps_l": "As the right side.",
      "forearm_flexors_r": "Grip the handle and hold the wrist straight.",
      "forearm_flexors_l": "As the right side.",
      "rhomboids_midtrap_r": "Keep the shoulder blades back on the bench.",
      "rhomboids_midtrap_l": "As the right side.",
      "core": "Keeps the trunk still."
    }
