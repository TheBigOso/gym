    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low back pain that increases in the plank: shorten the hold or drop to the knee plank.",
        "High blood pressure: breathe steadily; long breath-held efforts raise blood pressure."
      ],
      "modify": [
        "Shoulder discomfort: hands together (forearms in a slight V) or an incline plank with the forearms on a bench.",
        "Elbow discomfort: fold the mat under the forearms."
      ],
      "regressions": [
        "Knee plank (forearms and knees).",
        "Front plank without limb lifts."
      ],
      "progressions": [
        "Longer holds at the top.",
        "Front plank with arm and leg lift."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis and obliques resist sagging and rotation when one foot leaves the floor; a three-point base raises the trunk demand over a normal plank (clinical opinion; Ekstrom 2007 for the bridge family).",
      "glute_max_r": "Gluteus maximus extends the lifted hip and holds the standing hip level; hip extension from a plank position gave high gluteal activity in Boren 2011.",
      "glute_max_l": "Gluteus maximus extends the lifted hip and holds the standing hip level; hip extension from a plank position gave high gluteal activity in Boren 2011.",
      "obliques_r": "Obliques stop the pelvis rotating toward the lifted leg (clinical opinion).",
      "obliques_l": "Obliques stop the pelvis rotating toward the lifted leg (clinical opinion)."
    }
