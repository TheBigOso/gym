        "quads_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the leg lifts, breathe in as it lowers; keep the brace on throughout.",
      "cadence": "About 1 s up, 1 s hold, 1 s down per leg"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-10 lifts per leg",
      "tempo": "1 s up, 1 s hold, 1 s down",
      "frequency": "2-3 times a week",
      "progression": "Longer holds at the top, then the plank with an arm and leg lift"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Forearm plank: elbows under the shoulders, body in one line from head to heels."
      },
      {
        "id": "c2",
        "phase": "liftR",
        "text": "Squeeze the right glute and lift the straight leg a hand-width or two; hips stay level and square."
      },
      {
        "id": "c3",
        "phase": "holdR",
        "text": "Hold briefly without arching the low back or rolling the hips."
      },
      {
        "id": "c4",
        "phase": "lowerR",
        "text": "Lower the toes back to the mat under control."
      },
      {
        "id": "c5",
        "phase": "liftL",
        "text": "Same with the left leg: lift from the glute, not from the low back."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Hold the plank briefly, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to get the leg higher",
        "fix": "Lift only as high as the hips stay level; the movement is at the hip."
      },
      {
        "id": "m2",
        "mistake": "Hips rolling toward the lifted leg",
        "fix": "Keep both hip bones pointing at the mat."
      },
      {
        "id": "m3",
        "mistake": "Hips sagging when one foot is up",
        "fix": "Brace harder and squeeze the standing-leg glute."
      },
      {
        "id": "m4",
        "mistake": "Bending the knee",
        "fix": "Keep the lifting leg long, toes reaching back."
      }
    ],
    "kinematics": [
      {
        "measure": "Body line (shoulder-hip-ankle)",
        "setup": "≈13° off straight (shoulder-hip-ankle)",
        "peak": "Unchanged on the supporting leg (pelvis fixed)",
        "norm": "Straight line held throughout; the lift happens at the hip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension (lifted leg)",
        "setup": "Hip ≈0° (in line with the trunk)",
        "peak": "Hip ≈-14°: leg ≈13° above the body line, foot 20 cm up",
        "norm": "A small lift of about 10-15 degrees past the body line keeps the pelvis level (clinical opinion); unilateral hip extension in a plank raises gluteal activity (Boren 2011)",
        "sources": [
          "boren2011"
        ]
      },
      {
        "measure": "Elbow position",
        "setup": "Directly under the shoulders, 40 cm apart",
        "peak": "Unchanged (forearms planted)",
        "norm": "Elbows under the shoulders (Schoenfeld 2014 set-up)",
        "sources": [
          "schoenfeld2014"
        ]
      },
      {
        "measure": "Pelvis",
        "setup": "Level, square to the mat",
        "peak": "Unchanged (no rotation toward the lifted leg)",
        "norm": "Level and square, no rotation toward the lifted leg (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s plank",
        "peak": "1 s up, 1 s hold, 1 s down per leg",
        "norm": "About 1 s up, 1 s hold, 1 s down (clinical opinion)",
        "sources": []
      }
    ],
