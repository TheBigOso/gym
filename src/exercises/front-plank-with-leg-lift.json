    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isometric trunk (anti-extension, anti-rotation) with hip extension",
    "plane": "Sagittal",
    "laterality": "Alternating (both sides in one loop)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
