    "breathing": {
      "pattern": "Breathe in as the hands go back behind the head, breathe out as the arms extend.",
      "cadence": "About 2 s back, short pause, about 1.5 s out"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2.2-0.3-1.4-0.5 (lower-pause-extend-pause, seconds)",
      "rest": "60-120 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen: the elbows must stay still.",
      "progression": "Add reps, then one plate on the stack"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing away from a high pulley, feet hip width, knees soft, trunk leaning forward from the hips; rope ends in both hands overhead, upper arms beside the head pointing forward and up, arms extended."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in; keep the elbows still and let the rope draw the hands back behind the head."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Deep stretch in the back of the arms, elbows still pointing forward."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out; straighten the elbows and drive the hands forward in line with the upper arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms long, ribs down, then lower again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows about shoulder width, pointing forward."
      },
      {
        "id": "m2",
        "mistake": "Upper arms swinging",
        "fix": "Only the forearms move."
      },
      {
        "id": "m3",
        "mistake": "Arching the lower back",
        "fix": "Brace the trunk, ribs down."
      },
      {
        "id": "m4",
        "mistake": "Cutting the stretch short",
        "fix": "Let the hands go well behind the head."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈10° (arms long, not locked)",
        "peak": "≈118° with the hands behind the head",
        "norm": "From nearly straight to about 110-130 degrees (clinical opinion)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Shoulder elevation (upper arm)",
        "setup": "Upper arm ≈25° from the trunk line, ≈45° forward of vertical",
        "peak": "Unchanged (elbows move 0.00 cm over the loop)",
        "norm": "Upper arms overhead and still; overhead elbow extension grew the triceps more than a neutral arm position (overhead 2022)",
        "sources": [
          "overhead2022"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Neutral, hands 36.4 cm apart on the rope ends",
        "peak": "Unchanged (36.36-36.46 cm)",
        "norm": "Neutral on the rope ends (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "High pulley 220 cm high, 80 cm behind the hips",
        "peak": "Cable clear by at least 12.93 cm, rope strands by 10.81 cm (knot behind the head)",
        "norm": "High pulley behind and above the hands (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Standing, ≈20° forward of vertical (hips flexed ≈35°), knees ≈12°",
        "peak": "Unchanged",
        "norm": "Leaning forward from the hips, braced and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s with the arms extended",
        "peak": "2.2 s back, 0.3 s pause, 1.4 s extending, 0.5 s pause",
        "norm": "Controlled, about 2 s back and 1.5 s out (clinical opinion)",
        "sources": []
      }
