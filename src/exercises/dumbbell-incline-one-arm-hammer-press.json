    "safety": {
      "cautions": [
        "Get into position safely: sit with the dumbbells on the thighs, lie back and kick them up with the knees; at the end of the set bring them back to the thighs rather than dropping them (clinical opinion).",
        "Shoulder pain: shorten the range at the bottom until it settles (clinical opinion).",
        "Keep the wrists straight over the forearms; bent-back wrists under a heavy dumbbell strain the wrist.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower back arching: feet on a low step."
      ],
      "regressions": [
        "Two-arm incline hammer press.",
        "Incline push-up."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Slower lowering (3-4 s)."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher with a shift toward the upper fibres on a 30-degree incline (Rodríguez-Ridao 2020; Lauver 2016).",
      "ant_deltoid_r": "Works harder as the bench rises (Rodríguez-Ridao 2020).",
      "triceps_r": "Straightens the elbow.",
      "serratus_r": "Holds the shoulder blade against the rib cage while the arm presses.",
      "biceps_r": "Works as a stabiliser; biceps activity rose with the stability demand, highest with dumbbells (Saeterbakken 2011).",
      "forearm_flexors_r": "Grip the dumbbell handle.",
      "infraspinatus_r": "Rotator cuff: centres the head of the upper arm.",
      "rhomboids_midtrap_r": "Keep the shoulder blade drawn back on the bench.",
      "core": "Bracing keeps the trunk square while only one side is loaded; unilateral pressing raised trunk muscle activity (Saeterbakken 2012).",
      "obliques_r": "Resist the trunk being pulled toward the loaded side.",
      "obliques_l": "Resist the trunk being pulled toward the loaded side."
    }
