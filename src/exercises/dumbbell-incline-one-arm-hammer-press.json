    "breathing": {
      "pattern": "Inhale as you lower the dumbbell, exhale as you press it up.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12 per arm",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "Add reps up to the top of the range, then the next dumbbell; finish all reps on the weaker arm first."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Back pad at 30 degrees, glutes in the crease, upper back and head on the pad, feet planted wide; one dumbbell over the right shoulder with the palm facing in, the free hand on the stomach."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the dumbbell beside the upper chest, elbow tucked about 30 degrees from the side, forearm vertical."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Handle beside the upper chest, palm still facing in; brief pause."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press straight up until the arm is straight over the shoulder."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause at the top, chest square, then lower again. Switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Trunk rolling toward the working arm",
        "fix": "Brace the trunk and plant the opposite foot; both shoulder blades stay on the pad."
      },
      {
        "id": "m2",
        "mistake": "Elbow drifting out wide",
        "fix": "Keep the elbow close to the ribs with the palm facing in."
      },
      {
        "id": "m3",
        "mistake": "Dumbbell tipping as the wrist turns",
        "fix": "Keep the handle along the body and the wrist straight."
      },
      {
        "id": "m4",
        "mistake": "Bouncing out of the bottom or cutting the range short",
        "fix": "Lower under control to beside the chest, pause, then press."
      },
      {
        "id": "m5",
        "mistake": "Hips lifting off the seat",
        "fix": "Keep the glutes down and both feet planted."
      }
    ],
    "kinematics": [
