        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "upper_traps_r",
        "upper_traps_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the hands curl up, inhale as they lower.",
      "cadence": "About 1 s up, 0.4 s squeeze, 1.7 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "load": "Dumbbell load is user-chosen: pick a weight you can control through the full range for every rep with 1-3 reps in reserve (RPE 7-9).",
      "tempo": "1-0-2-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, then a heavier dumbbell"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width; hold the dumbbells behind the hips, arms straight, palms facing back."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the hands up and back, bending only at the wrists."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze; the arms stay straight and still."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the hands hang straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Shoulders back and down, chest up; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the elbows or shrugging",
        "fix": "Arms straight, shoulders down; only the wrists move."
      },
      {
        "id": "m2",
        "mistake": "Leaning forward",
        "fix": "Stand tall; the dumbbells hang just behind the hips."
      },
      {
        "id": "m3",
        "mistake": "Dumbbells knocking the legs",
        "fix": "Keep the arms a hand width behind the body."
      }
    ],
    "kinematics": [
      {
        "measure": "Wrist flexion",
        "setup": "8° extension (hands hanging, wrist about straight)",
        "peak": "58° flexion at the top (arc ≈66°)",
        "norm": "Healthy adults used up to about 54 degrees of wrist flexion and 60 degrees of extension in daily tasks, functional range about 40 each way (Ryu 1991); a curl goes a little further, to a comfortable end range without pain (clinical opinion)",
        "sources": [
          "ryu1991"
        ]
      },
      {
        "measure": "Arm position",
        "setup": "Elbows ≈4° (straight); arm ≈12° behind vertical, wrists 42 cm apart",
        "peak": "Unchanged (arms move 0 cm over the loop)",
        "norm": "Arms straight, hanging just behind the hips, still throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell clearance",
        "setup": "≥ 1.3 cm from the body (rig shapes, nearest thigh_r)",
        "peak": "Dumbbells 5 cm apart at the closest",
        "norm": "The dumbbells stay clear of the buttocks and thighs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bottom 0.5 s",
        "peak": "1 s up, 0.4 s squeeze, 1.7 s down, 0.4 s at the bottom",
        "norm": "Slow and controlled, about 1 s up, a short squeeze and 1.5-2 s down (clinical opinion); resistance programmes for the wrist extensors in tendinopathy used 1-4 sets of about 15 reps, with no optimal dose defined (J Hand Ther 2012)",
        "sources": [
          "jht2012"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
