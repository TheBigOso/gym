      }
    ],
    "safety": {
      "cautions": [
        "Front-of-shoulder discomfort with the arms behind the body: bring the hands closer to the hips or switch to the seated wrist curl (clinical opinion).",
        "Wrist pain: lighter dumbbells, smaller range.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "One arm at a time.",
        "Seated wrist curl if the shoulders do not like the behind-the-back position."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Seated wrist curl."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Slower lowering.",
        "Barbell behind-the-back wrist curl."
      ]
    },
    "muscleNotes": {
      "forearm_flexors_r": "Curl the hands up and back behind the body; the finger flexors hold the handles. Added wrist and forearm work gave greater wrist and forearm strength gains (Szymanski 2004).",
      "forearm_flexors_l": "Curl the hands up and back behind the body; the finger flexors hold the handles. Added wrist and forearm work gave greater wrist and forearm strength gains (Szymanski 2004).",
      "post_deltoid_r": "Holds the arms slightly behind the body so the dumbbells clear the buttocks (clinical opinion).",
      "post_deltoid_l": "Holds the arms slightly behind the body so the dumbbells clear the buttocks (clinical opinion).",
      "triceps_r": "Keeps the elbows straight (clinical opinion).",
      "triceps_l": "Keeps the elbows straight (clinical opinion).",
      "rhomboids_midtrap_r": "Draw the shoulders back so the arms can hang behind the hips (clinical opinion).",
      "rhomboids_midtrap_l": "Draw the shoulders back so the arms can hang behind the hips (clinical opinion).",
      "upper_traps_r": "Carry the weight of the dumbbells on the shoulders (clinical opinion).",
      "upper_traps_l": "Carry the weight of the dumbbells on the shoulders (clinical opinion).",
      "core": "Keeps the trunk tall."
