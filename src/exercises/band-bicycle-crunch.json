  "exercise": {
    "id": "band-bicycle-crunch",
    "name": "Band Bicycle Crunch",
    "aliases": [
      "Banded bicycle crunch",
      "Band air bike",
      "Resisted bicycle crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9443",
      "title": "Band Bicycle Crunch",
      "url": "https://gymvisual.com/videos/9443-band-bicycle-crunch.html",
      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read and the band set-up could not be confirmed; authored with the band anchored low behind the head and held by the ears)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, obliques)",
    "secondaryBodyParts": [
      "Hip flexors"
    ],
    "equipment": [
      "Resistance band (two)",
      "Squat rack uprights (band anchors)",
      "Exercise mat"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk curl and rotation with alternating hip flexion)",
    "plane": "Multiplanar",
    "laterality": "Bilateral, alternating sides",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "lats_r",
        "lats_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out on each twist, breathe in through the middle. Do not hold the breath.",
      "cadence": "About 1.2 s per twist"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-20 total twists (5-10 per side)",
      "effort": "Stop when the low back starts to arch off the mat (clinical opinion)",
      "tempo": "Slow pedalling, about 1.2 s per twist with a short pause",
      "rest": "30-60 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: light bands, the curl must stay smooth",
      "progression": "Stronger bands, a longer pause at each side, legs lower"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the mat with the head toward the rack, a band tied low on each upright. Hold one band in each hand by the ears, elbows wide. Curl the head and shoulder blades up and lift the knees over the hips."
      },
      {
        "id": "c2",
        "phase": "twistA",
        "text": "Breathe out, turn the right shoulder toward the left knee as the left knee draws in and the right leg straightens."
      },
      {
        "id": "c3",
        "phase": "twistB",
        "text": "Switch: left shoulder toward the right knee, left leg straight. The bands stay taut."
      },
      {
        "id": "c4",
        "phase": "twistA2",
        "text": "Turn from the ribs; the hands stay by the ears and do not pull on the head."
      },
      {
        "id": "c5",
        "phase": "twistB2",
        "text": "Keep the low back on the mat and pedal slowly."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Return to the middle, shoulders still curled up, knees over the hips."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling the head forward with the hands",
        "fix": "Hands stay by the ears holding the bands; the curl comes from the ribs."
      },
      {
        "id": "m2",
        "mistake": "Flapping the elbows instead of turning the trunk",
        "fix": "Turn the shoulder toward the knee; elbows stay wide."
      },
      {
        "id": "m3",
        "mistake": "Low back arching as the leg straightens",
        "fix": "Keep the straight leg higher and the low back pressed to the mat."
      },
      {
        "id": "m4",
        "mistake": "Pedalling fast with momentum",
        "fix": "Slow, controlled twists with a short pause."
      },
      {
        "id": "m5",
        "mistake": "Letting the bands pull the shoulders back to the mat",
        "fix": "Use lighter bands; the shoulder blades stay up throughout."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk curl",
        "setup": "Shoulder blades 8 cm off the mat (thoracic ≈37° flexion)",
        "peak": "Held up through every twist, against the bands",
        "norm": "Head and shoulder blades off the mat throughout; lower back stays on the floor (ACE 2001 description)",
        "sources": [
          "ace2001"
        ]
      },
      {
        "measure": "Trunk rotation",
        "setup": "Square to the ceiling",
        "peak": "≈40° toward the bent knee (mostly thoracic), elbow 30 cm from the opposite knee",
        "norm": "Shoulder turns toward the opposite knee (ACE 2001); rotation amount is clinical opinion",
        "sources": [
          "ace2001"
        ]
      },
      {
        "measure": "Bent leg",
        "setup": "Hip ≈88°, knee ≈95° (both knees over the hips)",
        "peak": "Hip ≈119°, knee ≈118°",
        "norm": "Knee drawn toward the chest to meet the opposite elbow (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Straight leg",
        "setup": "-",
        "peak": "Hip ≈20°, knee ≈5°, leg ≈21° above the floor",
        "norm": "Knees lifted to about 45 degrees and pedalled (ACE 2001); the straight leg hovers off the floor",
        "sources": [
          "ace2001"
        ]
      },
      {
        "measure": "Hands",
        "setup": "Fists by the ears; bands tied 12 cm up the uprights, 48 cm beyond the head",
        "peak": "Unchanged relative to the head",
        "norm": "By the ears holding the bands, elbows wide (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Set 0.6 s",
        "peak": "About 1.2 s per twist with a short pause, 4 twists per 6.4 s loop",
        "norm": "Slow pedalling (ACE 2001: \"slowly pedal\")",
        "sources": [
          "ace2001"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Bicycle Crunch, video (movement reference)",
        "url": "https://gymvisual.com/videos/9443-band-bicycle-crunch.html"
      },
      {
        "id": "ace2001",
        "title": "ACE-sponsored study, Francis and Davis (San Diego State University Biomechanics Lab) 2001, best and worst abdominal exercises, 30 adults, EMG relative to the traditional crunch",
        "url": "https://www.acefitness.org/getfit/studies/BestWorstAbExercises.pdf"
      },
      {
        "id": "oliva2020",
        "title": "Oliva-Lozano and Muyor 2020, core muscle activity during physical fitness exercises: a systematic review (Int J Environ Res Public Health 17(12):4306)",
        "url": "https://www.mdpi.com/1660-4601/17/12/4306"
      },
      {
        "id": "marshall2010",
        "title": "Marshall and McGill 2010, the role of axial torque in disc herniation (Clin Biomech 25:6-9), porcine model",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19815318/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Check the bands and the anchors before each set: the bands run beside the head, and a band that slips or snaps can hit you.",
        "Repeated twisting combined with flexion promoted disc injury in a porcine model (Marshall and McGill 2010): keep the turns moderate and slow.",
        "Disc herniation, flexion or rotation intolerance, osteoporosis: avoid; use a dead bug or side plank instead.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Neck strain: rest the head between sets and keep the chin slightly tucked.",
        "Low back discomfort: keep the straight leg higher, or keep both feet down and twist only."
      ],
      "regressions": [
        "Bicycle crunch without bands.",
        "Heels on the floor, twist only.",
        "Smaller turns."
      ],
      "progressions": [
        "Stronger bands.",
        "Pause 1-2 s at each side.",
        "Straight leg lower (still off the floor)."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis holds the trunk curl against the bands. In the ACE 2001 study the bicycle crunch produced the highest rectus abdominis activity of 13 exercises (about 248% of the traditional crunch); the band adds resistance to the curl (clinical opinion).",
      "obliques_r": "Turn the trunk toward the opposite knee (oblique pair across the trunk). The bicycle crunch ranked second for oblique activity in ACE 2001 (about 290% of the traditional crunch).",
      "obliques_l": "Turn the trunk toward the opposite knee (ACE 2001).",
      "hip_flexors_r": "Draw the knee in and hold the straight leg off the mat (clinical opinion).",
      "hip_flexors_l": "Draw the knee in and hold the straight leg off the mat (clinical opinion).",
      "quads_r": "Straighten the knee as the leg pedals out (clinical opinion).",
      "quads_l": "Straighten the knee as the leg pedals out (clinical opinion).",
      "lats_r": "Hold the arms by the head against the bands (clinical opinion).",
      "lats_l": "Hold the arms by the head against the bands (clinical opinion).",
      "triceps_r": "Hold the elbows against the bands (clinical opinion).",
      "triceps_l": "Hold the elbows against the bands (clinical opinion)."
    }
  },
