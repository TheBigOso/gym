    "bodyPart": "Upper Arms",
    "secondaryBodyParts": [],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "triceps_r"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_flexors_r",
        "ant_deltoid_r",
        "post_deltoid_r",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the dumbbell lowers beside the head, exhale as you straighten the arm.",
      "cadence": "About 2.2 s down, 0.3 s pause, 1.4 s up"
    },
    "prescription": {
      "sets": "2-3 per arm",
      "reps": "10-15",
      "tempo": "2-0-1-1",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "More reps, then the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench, feet planted. Hold one dumbbell straight up over the shoulder, palm facing in; rest the other hand on your stomach."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Keep the upper arm vertical and breathe in as you bend the elbow, lowering the dumbbell beside the head."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbell beside the head, elbow pointing at the ceiling, stretch in the back of the arm."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbow."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arm straight, squeeze, repeat; then switch arms."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arms swinging back and forth",
        "fix": "Keep the elbows pointing at the same spot; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Trunk twisting toward the dumbbell",
        "fix": "Keep both shoulder blades on the bench; brace lightly."
      },
      {
        "id": "m3",
        "mistake": "Lowering too fast toward the head",
        "fix": "Lower under control beside the head; keep the dumbbell clear of the face."
      },
      {
        "id": "m4",
        "mistake": "Locking out hard",
        "fix": "Straighten the elbows without snapping them."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (straight, not locked)",
        "peak": "≈100° at the bottom",
        "norm": "From straight to a little past 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm angle",
        "setup": "≈0° from vertical",
        "peak": "Unchanged: shoulder channels constant (max 0.0° drift)",
        "norm": "Vertical over the shoulder and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell clearance",
        "setup": "Over the shoulder",
        "peak": "Closest approach to the body 3.6 cm (rig shapes), to the bench 14.8 cm",
        "norm": "Dumbbell beside the head, clear of the head and bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Free hand",
        "setup": "Left hand resting on the stomach",
        "peak": "Unchanged (constant left-arm channels)",
        "norm": "Rests on the stomach; some lifters steady the working upper arm with it instead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.2 s down, 0.3 s pause, 1.4 s up, 0.5 s at the top",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #036212, Dumbbell One Arm Triceps Extension (on bench), video (movement reference)",
