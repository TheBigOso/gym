    "id": "single-arm-dumbbell-triceps-extension",
    "name": "Single-Arm Lying Dumbbell Triceps Extension",
    "aliases": [
      "One-arm lying triceps extension",
      "Single-arm skull crusher",
      "One arm DB extension on bench"
    ],
    "reference": {
      "source": "GymVisual",
