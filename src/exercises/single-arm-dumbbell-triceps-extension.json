      },
      {
        "id": "maeo_desc",
        "title": "Maeo and Kanehisa, triceps hypertrophy after 12 weeks of elbow extension training with the shoulder at 180 versus 0 degrees of flexion (Descente Sports Science vol 41; full paper: Maeo et al. 2023, Eur J Sport Sci 23(7):1240-1250, PubMed 35819335)",
        "url": "https://www.shinshu-u.ac.jp/faculty/textiles/db/seeds/descente_sports41_21.pdf"
      }
    ],
    "safety": {
      "cautions": [
        "Lower the dumbbell beside the head, never toward the face; use a fixed-plate dumbbell.",
        "Elbow pain: shorten the range and use a lighter dumbbell (clinical opinion).",
        "Keep the wrists straight over the forearms; bent-back wrists under a heavy dumbbell strain the wrist.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: let the upper arm tilt slightly toward the head.",
        "Elbow discomfort: lighter dumbbell, shorter range."
      ],
      "regressions": [
        "Two-arm skull crusher with light dumbbells.",
        "Band pushdown."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Slower lowering.",
        "Incline single-arm extension."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Only mover: straightens the elbow while the upper arm stays vertical. Long and lateral head activity differed in lying barbell triceps extensions (Boehler 2011); the long head works at a longer length the higher the arm is raised (Maeo and Kanehisa).",
      "forearm_flexors_r": "Grip the handle.",
      "ant_deltoid_r": "Holds the upper arm vertical.",
      "post_deltoid_r": "Holds the upper arm vertical as the dumbbell lowers behind the elbow.",
      "core": "Keeps the trunk still on the bench."
    }
