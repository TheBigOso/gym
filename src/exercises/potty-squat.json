  "exercise": {
    "id": "potty-squat",
    "name": "Potty Squat",
    "aliases": [
      "Toilet squat",
      "Deep bodyweight squat",
      "Heels-down deep squat",
      "Sit-down squat"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "17609",
      "title": "Potty Squat",
      "url": "https://gymvisual.com/videos/17609-potty-squat.html",
      "listing": "Video (movement reference; the page could not be read at authoring time: gymvisual.com is blocked by the proxy, so the movement comes from the name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Calves"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip, knee and ankle; full depth)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "hamstrings_r",
        "hamstrings_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core",
        "glute_med_r",
        "glute_med_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as you sit down, hold briefly at the bottom, breathe out as you stand.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "2 s down, brief pause in the deep squat, about 1 s up",
      "frequency": "2-4 times a week",
      "progression": "Longer pauses at the bottom, then a goblet-held weight; use a support if balance or heel contact is lost."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand with the feet a little wider than the shoulders, toes turned out, arms reaching forward."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and sit straight down between the heels, knees tracking over the toes."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause in the deep squat with the heels down and the chest up."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive through the whole foot to stand."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall and reset the arms."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Heels lifting at the bottom",
        "fix": "Widen the stance and turn the toes out a little more, or hold a support."
      },
      {
        "id": "m2",
        "mistake": "Knees caving inward",
        "fix": "Push the knees out over the 2nd-3rd toe."
      },
      {
        "id": "m3",
        "mistake": "Back rounding at the bottom",
        "fix": "Keep the chest up; only go as deep as you can with a neutral back."
      },
      {
        "id": "m4",
        "mistake": "Dropping into the bottom",
        "fix": "Lower over about 2 s and stay braced."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "42 cm (≈1.0x shoulder width), toes out 25°",
        "peak": "Unchanged",
        "norm": "A little wider than the shoulders with the toes turned out suits a deep squat (Lorenzetti 2018)",
        "sources": [
          "lorenzetti2018"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈3°",
        "peak": "≈125°",
        "norm": "Well past thighs-parallel; depth comes mostly from knee range of motion (Zawadka 2020)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈1°",
        "peak": "≈137° (joint channel)",
        "norm": "Deep hip flexion with the pelvis between the heels (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈23° forward",
        "norm": "Fairly upright for the depth; less lean moves demand toward the knees (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Ankle",
        "setup": "Heels down",
        "peak": "≈27° dorsiflexion, heels still down",
        "norm": "Heels stay down; deep squats need generous ankle dorsiflexion (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.5 s pause, 1.2 s up, 1.5 s reset",
        "norm": "2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #17609, Potty Squat, video (movement reference)",
        "url": "https://gymvisual.com/videos/17609-potty-squat.html"
      },
      {
        "id": "zawadka2020",
        "title": "Zawadka et al. 2020, How are squat timing and kinematics in the sagittal plane related to squat depth? (J Sports Sci Med 19:500-507)",
        "url": "https://www.jssm.org/jssm-19-500.xml-Fulltext"
      },
      {
        "id": "straub2024",
        "title": "Straub and Powers 2024, a biomechanical review of the squat exercise: implications for clinical practice (Int J Sports Phys Ther)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10987311/"
      },
      {
        "id": "lorenzetti2018",
        "title": "Lorenzetti et al. 2018, how to squat: stance widths, foot angles and experience (BMC Sports Sci Med Rehabil)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6050697"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Knee pain in deep flexion: limit the depth to what is comfortable.",
        "Hip or ankle stiffness: use the supported version or a smaller range."
      ],
      "modify": [
        "Heels lifting: wider stance, toes further out, or hold a support.",
        "Balance: potty squat with support."
      ],
      "regressions": [
        "Potty squat with support.",
        "Box squat.",
        "Bodyweight squat to parallel."
      ],
      "progressions": [
        "Paused deep squat (3 s).",
        "Goblet squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Knee extensors control the deep descent and drive the stand (clinical opinion).",
      "quads_l": "Knee extensors control the deep descent and drive the stand (clinical opinion).",
      "glute_max_r": "Hip extensor, working hardest out of the deep bottom (clinical opinion).",
      "glute_max_l": "Hip extensor, working hardest out of the deep bottom (clinical opinion).",
      "adductors_r": "Adductor magnus assists hip extension at depth (clinical opinion).",
      "adductors_l": "Adductor magnus assists hip extension at depth (clinical opinion).",
      "hamstrings_r": "Assist hip extension (clinical opinion).",
      "hamstrings_l": "Assist hip extension (clinical opinion).",
      "calves_r": "Control the forward shin travel with the heels down (clinical opinion).",
      "calves_l": "Control the forward shin travel with the heels down (clinical opinion).",
      "spinal_extensors_r": "Keep the back neutral at depth (clinical opinion).",
      "spinal_extensors_l": "Keep the back neutral at depth (clinical opinion).",
      "core": "Brace the trunk (clinical opinion).",
      "glute_med_r": "Keeps the knees tracking over the toes (clinical opinion).",
      "glute_med_l": "Keeps the knees tracking over the toes (clinical opinion).",
      "ant_deltoid_r": "Holds the arms forward as a counterbalance (clinical opinion).",
      "ant_deltoid_l": "Holds the arms forward as a counterbalance (clinical opinion)."
    }
