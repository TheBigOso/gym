    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Shoulder pain on the supporting side (instability, rotator cuff): start with the knee side plank or skip."
      ],
      "modify": [
        "Bottom knee down (knee side plank) while the top knee drives in.",
        "Smaller knee drive."
      ],
      "regressions": [
        "Side plank hold.",
        "Knee side plank with the top knee drive."
      ],
      "progressions": [
        "Slower reps with a 2 s squeeze.",
        "Side plank on the hand (straight arm) with the knee drive."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Bottom-side obliques hold the trunk up against gravity as in the side plank (external oblique about 62% MVIC in the side bridge, Escamilla 2016).",
      "obliques_l": "Top-side obliques curl and turn the trunk down toward the knee (clinical opinion).",
      "core": "Rectus abdominis curls the trunk toward the knee (clinical opinion; about 21-26% MVIC just to hold the side bridge, Escamilla 2016).",
      "hip_flexors_l": "Draw the top knee forward and up (clinical opinion).",
      "glute_med_r": "Bottom-side hip abductors hold the pelvis up (side bridge above 45% MVIC, Ekstrom 2007).",
      "serratus_r": "Keeps the supporting shoulder blade on the rib cage.",
      "ant_deltoid_r": "Steadies the supporting shoulder over the elbow.",
      "post_deltoid_r": "Steadies the supporting shoulder over the elbow.",
      "infraspinatus_r": "Rotator cuff steadies the supporting shoulder.",
      "lats_r": "Helps hold the trunk up on the supporting side (clinical opinion).",
      "spinal_extensors_r": "Stands in for quadratus lumborum, highly active in side support (McGill 1998).",
      "quads_r": "Keeps the bottom knee straight."
    }
