    "breathing": {
      "pattern": "Exhale as the elbow and knee meet, inhale as you return to the straight plank.",
      "cadence": "About 1 s in, short squeeze, 1.2 s out"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-12 per side",
      "tempo": "About 1 s in, brief squeeze, 1 s out",
      "frequency": "2-3 times a week",
      "progression": "More reps, then a straight-arm side plank"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Side plank on the right forearm, elbow under the shoulder, feet stacked, hips up in one line. Left fingertips behind the head."
      },
      {
        "id": "c2",
        "phase": "crunch",
        "text": "Breathe out and draw the top knee forward and up while the trunk curls down to meet it, elbow to knee."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Short squeeze; keep the hips lifted."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and return to the straight side plank, top foot back on the bottom foot."
      },
      {
        "id": "c5",
        "phase": "crunch2",
        "text": "Repeat; finish the set, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging toward the mat during the crunch",
        "fix": "Push the floor away with the forearm and keep the bottom hip up."
      },
      {
        "id": "m2",
        "mistake": "Pulling the head down with the hand",
        "fix": "Fingertips only; curl from the ribs."
      },
      {
        "id": "m3",
        "mistake": "Supporting shoulder sinking",
        "fix": "Elbow under the shoulder; press up through the forearm."
      },
      {
        "id": "m4",
        "mistake": "Rushing",
        "fix": "About 1 s in, short squeeze, 1 s out."
      }
    ],
    "kinematics": [
      {
        "measure": "Body line",
        "setup": "Straight side plank, pelvis 10 cm off the mat",
        "peak": "Hips held (pelvis 10 cm off the mat)",
        "norm": "Hips stay lifted in line with the shoulders and feet (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Neutral",
