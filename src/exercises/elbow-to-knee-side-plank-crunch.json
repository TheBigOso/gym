        "norm": "Trunk curls and turns down toward the knee (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Top leg",
        "setup": "Stacked on the bottom leg",
        "peak": "Hip ≈105°, knee ≈110°; elbow 8 cm from the knee",
        "norm": "Knee drawn forward to meet the elbow (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Support",
        "setup": "Elbow under the shoulder, elbow ≈87°",
