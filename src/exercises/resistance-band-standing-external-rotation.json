  "exercise": {
    "id": "resistance-band-standing-external-rotation",
    "name": "Resistance Band Standing External Rotation",
    "aliases": [
      "Band external rotation",
      "Standing band external rotation, elbow at the side",
      "Band shoulder external rotation"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "18909",
      "title": "Resistance Band Standing External Rotation",
      "url": "https://gymvisual.com/videos/18909-resistance-band-standing-external-rotation-male.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (the proxy refused gymvisual.com), so the movement follows the name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength / rehabilitation",
    "bodyPart": "Shoulders (rotator cuff)",
    "secondaryBodyParts": [
      "Upper back (trapezius)",
      "Posterior deltoid"
    ],
    "equipment": [
      "Resistance band",
      "Squat rack upright (band anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder rotation)",
    "plane": "Transverse",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "infraspinatus_r"
      ],
      "synergist": [
        "post_deltoid_r",
        "rhomboids_midtrap_r"
      ],
      "stabilizer": [
        "lat_deltoid_r",
        "serratus_r",
        "core",
        "forearm_extensors_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you rotate up, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-15 per arm",
      "effort": "Moderate (RIR 2-4); no pain",
      "tempo": "2-0.5-2-0.3 (up-pause-down-pause, seconds)",
      "rest": "45-60 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbells; very light (1-4 kg)",
      "progression": "Add reps, then 0.5-1 kg; longer pause at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand side-on to the anchor, band at elbow height on the side away from the working arm. Elbow bent 90 degrees and tucked by the side (a rolled towel helps), thumb up, hand in front of the belly."
      },
      {
        "id": "c2",
        "phase": "rotate",
        "text": "Breathe out and turn the forearm out like a gate, keeping the elbow against the side."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop when the forearm points about 45-60 degrees out, before the elbow leaves the side; shoulder blade back and down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the hand come back across the belly slowly against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause, then repeat. Turn around to train the other arm."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbow drifting away from the side",
        "fix": "Keep the elbow tucked (squeeze a towel roll); stop the turn earlier."
      },
      {
        "id": "m2",
        "mistake": "Turning the trunk instead of the arm",
        "fix": "Keep the hips and shoulders square; only the forearm moves."
      },
      {
        "id": "m3",
        "mistake": "Bending the wrist back to finish the range",
        "fix": "Keep the wrist straight; the turn comes from the shoulder."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the hand back",
        "fix": "Return over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper arm",
        "setup": "By the side, ≈10° from the trunk (elbow 4 cm out from below the shoulder joint)",
        "peak": "Unchanged (elbow moves 0.4 cm)",
        "norm": "By the side (0-20 degrees of abduction; a towel roll under the arm is common), still through the rep (clinical opinion); Sung 2023 tested external rotation at 45 and 90 degrees of abduction",
        "sources": [
          "sung2023"
        ]
      },
      {
        "measure": "External rotation",
        "setup": "Forearm 40° across the belly (internal rotation)",
        "peak": "Forearm 49° out from straight ahead",
        "norm": "From the forearm across the belly to about 45-60 degrees out, as far as the elbow stays put (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈91°",
        "peak": "≈91°",
        "norm": "Held at about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack upright on the left at 107.1 cm (hand height), 62 cm left of the midline; strand 63.8 cm",
        "peak": "Strand 109.7 cm with the forearm turned out",
        "norm": "Elastic tension rises as the band stretches, so the load is highest where the band is longest; at matched effort, elastic tubing and dumbbells gave similar muscle activity in upper-body exercises (Andersen 2010); anchored to the opposite side at elbow height, the band pulls the hand back across the body, so it resists the whole turn out",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s across the belly",
        "peak": "1.6 s out, 0.5 s hold, 2.0 s back",
        "norm": "Slow, about 2 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #18909, Resistance Band Standing External Rotation, video (movement reference)",
        "url": "https://gymvisual.com/videos/18909-resistance-band-standing-external-rotation-male.html"
      },
      {
        "id": "sung2023",
        "title": "Sung, Jung, Wang and Kim 2023, the effects of body positions and abduction angles on shoulder muscle activity patterns during external rotation exercises (Healthcare 11(14):1977)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10378914/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a catching feeling, numbness or tingling occurs.",
        "Check the band for nicks or tears before each set and make sure it cannot slip off its anchor (under the feet, round the upright).",
        "Use a light band: the rotator cuff is small and this is a control exercise, not a strength test.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Pain at the end of the turn: shorten the range.",
        "Hard to keep the elbow still: put a rolled towel between the elbow and the ribs."
      ],
      "regressions": [
        "Lighter band, or step closer to the anchor.",
        "Side-lying external rotation with no load."
      ],
      "progressions": [
        "Step further from the anchor.",
        "External rotation at 90 degrees of abduction (as in the dumbbell standing external rotation).",
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "infraspinatus_r": "Prime mover (with teres minor): turns the upper arm out. External rotation exercises target it; Sung 2023 found body position and abduction angle change how much it works (tested at 45 and 90 degrees).",
      "post_deltoid_r": "Helps turn the arm out (clinical opinion).",
      "rhomboids_midtrap_r": "Hold the shoulder blade back as the arm turns out (clinical opinion).",
      "lat_deltoid_r": "Holds the small gap between the elbow and the ribs.",
      "serratus_r": "Keeps the shoulder blade on the ribs.",
      "core": "Keeps the trunk square so it does not turn with the arm.",
      "forearm_extensors_r": "Hold the wrist straight against the band."
    }
  },
