  "exercise": {
    "id": "kneeling-leg-half-circle",
    "name": "Kneeling Leg Half Circle",
    "aliases": [
      "Quadruped rainbow",
      "Kneeling rainbow leg arc",
      "All-fours leg half circle"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "469312",
      "title": "Kneeling Leg Half Circle (male)",
      "url": "https://gymvisual.com/videos/10857-kneeling-leg-half-circle-male.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (hip extension and abduction, straight leg)",
    "plane": "Multiplanar",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_med_r"
      ],
      "synergist": [
        "hamstrings_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "core",
        "obliques_r",
        "obliques_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "serratus_r",
        "serratus_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale through the arc out, inhale through the arc back.",
      "cadence": "About 2 s each way"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "8-12 arcs",
      "tempo": "About 2 s out, 1 s pause, 2 s back",
      "frequency": "2-4 times a week",
      "progression": "Ankle weight, then a mini band above the knees"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "On all fours: hands under the shoulders, knees under the hips, back flat, neck long."
      },
      {
        "id": "c2",
        "phase": "extend",
        "text": "Straighten the right leg behind you, toes pointed just above the mat."
      },
      {
        "id": "c3",
        "phase": "circle",
        "text": "Breathe out and sweep the straight leg up and out to the side in a half circle, toes ending just off the mat out to the side."
      },
      {
        "id": "c4",
        "phase": "back",
        "text": "Breathe in and trace the same half circle back behind you."
      },
      {
        "id": "c5",
        "phase": "tuck",
        "text": "Bend the knee back under the hip; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Trunk swaying and hips tilting with the leg",
        "fix": "Brace; the pelvis stays level and square, only the leg moves."
      },
      {
        "id": "m2",
        "mistake": "Bending the knee",
        "fix": "Keep the leg long from hip to toes."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back at the top of the arc",
        "fix": "Keep the arc low enough that the back stays flat."
      },
      {
        "id": "m4",
        "mistake": "Rushing the arc",
        "fix": "Slow, even half circle in about 2 s each way."
      }
    ],
    "kinematics": [
      {
        "measure": "Hands and knees",
        "setup": "Hands under the shoulders, knees under the hips (hip 75°)",
        "peak": "Hands and the left knee stay planted",
        "norm": "Hands under the shoulders, support knee under the hip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension",
        "setup": "Leg straight behind, 19° below level (hip 6° flexion channel)",
        "peak": "Top of the arc: leg 1° from level, hip -14.4°",
        "norm": "Straight leg extended behind to about hip height without lumbar extension (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip abduction",
        "setup": "≈0°",
        "peak": "≈43° (leg 46° out from straight back at the end of the arc)",
        "norm": "Leg carried out to the side within a comfortable range (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈3° (straight)",
        "peak": "≈3°",
        "norm": "Straight throughout the arc (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.6 s on all fours, 1 s to straighten the leg",
        "peak": "2 s arc out, 0.25 s pause, 1.75 s arc back, 0.8 s knee back",
        "norm": "Slow and even, about 2 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #469312, Kneeling Leg Half Circle (male), video (movement reference)",
