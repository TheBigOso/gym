        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      },
      {
        "id": "macadam2015",
        "title": "Macadam, Cronin & Contreras 2015, gluteal muscle activity in dynamic hip abduction and hip external rotation exercise: a systematic review (Int J Sports Phys Ther 10(5):573-591; PMC4595911)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4595911/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a mat or folded towel under the knees."
      ],
      "modify": [
        "Wrist discomfort: fists or forearms on the mat.",
        "Low back or hip discomfort: make the arc smaller."
      ],
      "regressions": [
        "Donkey kick (bent knee, no circle).",
        "Smaller arc."
      ],
      "progressions": [
        "Ankle weight.",
        "Mini band above the knees.",
        "Pause at the top of the arc."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Holds the straight leg extended behind the hip; quadruped hip extension with the knee extending gave about 29% MVIC in the superior gluteus maximus (Selkowitz 2013).",
      "glute_med_r": "Carries the leg out to the side through the arc (hip abduction); Boren 2011 measured about 57% MVIC gluteus medius in standing hip circumduction, the closest studied movement.",
      "hamstrings_r": "Assist hip extension with the knee straight (clinical opinion).",
      "glute_med_l": "Support side: keeps the pelvis level on three points (clinical opinion).",
      "core": "Keeps the trunk still while the leg circles (clinical opinion).",
      "obliques_r": "Resist the pelvis rotating toward the moving leg (clinical opinion).",
      "obliques_l": "Resist the pelvis rotating toward the moving leg (clinical opinion).",
      "spinal_extensors_r": "Hold a flat back (clinical opinion).",
      "spinal_extensors_l": "Hold a flat back (clinical opinion).",
      "serratus_r": "Keeps the shoulder blades flat on the support arms (clinical opinion).",
      "serratus_l": "Keeps the shoulder blades flat on the support arms (clinical opinion)."
    }
  },
