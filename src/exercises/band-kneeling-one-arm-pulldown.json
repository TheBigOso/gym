        "glute_max_r",
        "glute_max_l"
      ],
      "lengthened": [
        "lats_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull down, breathe in as the arm reaches back up.",
      "cadence": "About 1 s down, short squeeze, about 2 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 each side",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1",
      "progression": "More reps, a longer squeeze, a stronger band."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Tall kneeling facing a rack, knees about hip width, glutes squeezed. The band is looped round the upright well above head height; hold it in the right hand, arm reaching up toward it, palm facing in. Left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and pull the elbow down to the side of the ribs, the hand finishing in front of the shoulder."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the lat and draw the shoulder blade down; trunk tall and square."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the arm reach back up toward the anchor, letting the shoulder blade rise at the top."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the arm long, then pull again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning or side-bending toward the working arm",
        "fix": "Stay tall and square; brace the trunk."
      },
      {
        "id": "m2",
        "mistake": "Pulling with the hand instead of the elbow",
        "fix": "Think of driving the elbow down to the back pocket."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the bottom",
        "fix": "Finish with the shoulder blade down."
      },
      {
        "id": "m4",
        "mistake": "Sitting back onto the heels",
        "fix": "Keep the hips over the knees."
      }
    ],
    "kinematics": [
      {
        "measure": "Arm path",
        "setup": "Reaching up toward the upright, ≈132° of elevation",
        "peak": "Elbow beside the ribs (≈26°), hand in front of the shoulder",
        "norm": "From reaching up toward the anchor (about 130-140 degrees of elevation) down to the elbow beside the ribs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈0°",
        "peak": "≈145°",
        "norm": "Nearly straight at the top to about 130-145 degrees at the bottom, the forearm in line with the band (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blade",
        "setup": "Raised (clavicle elevation 16°)",
        "peak": "Drawn down (clavicle elevation -4°)",
        "norm": "Elevated and upwardly rotated at the reach, depressed at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Kneeling",
        "setup": "Tall kneeling, knees ≈105°, trunk ≈5° from vertical, left hand on the hip",
        "peak": "Unchanged (no lean or side bend)",
        "norm": "Tall kneeling, hips over the knees; pulldown-type pulls load the lats strongly (Lehman 2004).",
        "sources": [
          "lehman2004"
        ]
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack upright 164.1 cm up, 67 cm in front of the right shoulder; strand 39.4 cm",
        "peak": "Strand 89.6 cm at the bottom",
        "norm": "Elastic resistance can give muscle activity comparable to free weights at a matched effort (Andersen 2010).",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s in the stretch",
        "peak": "1.1 s down, 0.4 s squeeze, 1.8 s up, 0.4 s pause",
        "norm": "About 1 s down and 2 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Kneeling One Arm Pulldown, video (movement reference)",
        "url": "https://gymvisual.com/videos/8995-band-kneeling-one-arm-pulldown.html"
      },
      {
        "id": "lehman2004",
        "title": "Lehman et al. 2004, variations in muscle activation levels during traditional latissimus dorsi weight training exercises (Dynamic Medicine 3:4)",
        "url": "https://link.springer.com/article/10.1186/1476-5918-3-4"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Knee discomfort: kneel on a mat or a folded towel.",
        "Shoulder pain at the top: stop the reach short of full overhead (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee discomfort: half-kneeling or seated on a box."
      ],
      "regressions": [
        "Lighter band.",
        "Both arms together."
      ],
      "progressions": [
        "Stronger band.",
        "Pause 2 s at the bottom.",
        "Cable one-arm pulldown."
      ]
    },
    "muscleNotes": {
      "lats_r": "Main mover: pulls the arm down from overhead (shoulder adduction and extension); Lehman 2004 compared lat activity across pulldowns and rows.",
      "biceps_r": "Bends the elbow.",
      "rhomboids_midtrap_r": "Draw the shoulder blade back and down.",
      "post_deltoid_r": "Assists as the elbow moves behind the trunk line.",
      "forearm_flexors_r": "Grip the band.",
      "infraspinatus_r": "Steadies the shoulder.",
      "triceps_r": "Long head assists shoulder extension.",
      "core": "Braces the trunk in tall kneeling.",
      "obliques_r": "Resist the side bend toward the working arm.",
      "obliques_l": "Resist the side bend toward the working arm.",
      "glute_max_r": "Keeps the hips over the knees.",
      "glute_max_l": "Keeps the hips over the knees."
    }
