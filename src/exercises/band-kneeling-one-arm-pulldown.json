      "Lower trapezius"
    ],
    "equipment": [
      "Resistance band",
      "Rack (band anchor)",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Frontal",
    "laterality": "Unilateral",
