    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Shoulders (front deltoid)"
    ],
    "equipment": [
      "Cable crossover (two pulleys at chest height)",
      "Two D-handles"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (horizontal adduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
