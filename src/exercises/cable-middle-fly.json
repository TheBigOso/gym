    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can move with the trunk still and the shoulders down.",
        "Step in and out of the stance with the hands together in front, not with the arms open.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorten the opening.",
        "Use a staggered stance for more balance."
      ],
      "regressions": [
        "Lighter load.",
        "Band chest fly."
      ],
      "progressions": [
        "Slower 3 s opening.",
        "Single-arm cable fly."
      ]
