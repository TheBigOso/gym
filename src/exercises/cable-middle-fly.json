        "core"
      ],
      "lengthened": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the arms open, breathe out as they hug back together.",
      "cadence": "About 2 s down, short stretch, about 1.5 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2.2-0.4-1.5-0.6 (open-stretch-close-squeeze, seconds)",
      "rest": "60-120 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen and moderate: the elbows must stay softly bent.",
      "progression": "Add reps, then load; add a 1 s squeeze"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand midway between two pulleys set at chest height, feet hip width, knees soft, a slight forward lean; a handle in each hand, hands together in front of the chest, palms facing."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in; open the arms in a level arc, elbows softly bent and fixed, until the hands are about in line with the shoulders."
      },
      {
        "id": "c3",
        "phase": "stretch",
        "text": "Brief stretch across the chest, chest tall, shoulders down."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out; hug the handles back together along the same level arc in front of the chest."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the chest with the hands together, then open again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pressing the handles forward (elbows bending and straightening)",
        "fix": "Keep the elbow bend fixed."
      },
      {
        "id": "m2",
        "mistake": "Letting the arms drift far behind the shoulders",
        "fix": "Stop with the hands about in line with the shoulders."
      },
      {
        "id": "m3",
        "mistake": "Rocking the trunk",
        "fix": "Brace and keep the lean fixed."
      },
      {
        "id": "m4",
        "mistake": "Shrugging",
        "fix": "Shoulders down and back."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈20° (soft, fixed)",
        "peak": "≈20° in the stretch",
        "norm": "Soft and fixed, about 20 degrees (Solstad 2020, dumbbell flyes)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Arm opening",
        "setup": "Upper arm ≈3° from straight ahead, hands 19.6 cm apart",
        "peak": "≈97° from straight ahead (hands about in line with the shoulders); hands -11 / -10 cm vs shoulder height (level arc)",
        "norm": "Level arc at chest height, from hands together to about in line with the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral: palms facing each other, handles vertical",
        "peak": "Unchanged (palms forward as the arms open)",
        "norm": "Neutral, palms facing (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Pulleys 128 cm high (about chest height), 184 cm apart, 8 cm behind the hips",
        "peak": "Both cables clear of the body by at least 7.73 cm",
        "norm": "Pulleys at chest height, out to the sides (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈9° forward of vertical, knees soft",
        "peak": "Unchanged",
        "norm": "Slight forward lean, knees soft, still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Squeeze 0.6 s with the hands together",
        "peak": "2.2 s opening, 0.4 s stretch, 1.5 s closing",
        "norm": "Controlled, about 2 s opening and 1.5 s closing (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
