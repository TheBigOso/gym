  },
  "exercise": {
    "id": "band-kneeling-rear-kick",
    "name": "Band Kneeling Rear Kick",
    "aliases": [
      "Mini band quadruped kickback",
      "Banded straight-leg rear kick"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "2381",
      "title": "Band Kneeling Rear Kick",
      "url": "https://gymvisual.com/animated-gifs/2381-band-kneeling-rear-kick.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus maximus)",
    "secondaryBodyParts": [
      "Hamstrings",
      "Core"
    ],
    "equipment": [
      "Resistance band (mini loop above the knees)",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip extension)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r"
      ],
      "synergist": [
        "hamstrings_r"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "glute_med_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "serratus_r",
        "serratus_l"
      ],
      "lengthened": [
        "hip_flexors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg kicks back, inhale as it returns.",
      "cadence": "About 1.2 s back, 0.5 s hold, 1.8 s in"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Stronger band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Band above the knees; hands under the shoulders, knees under the hips, back flat."
      },
      {
        "id": "c2",
        "phase": "kick",
        "text": "Breathe out and kick the right leg straight back to hip height against the band."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Leg long and level; hips square, no arch."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in, bend the knee and bring it back under the hip slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Hover the knee above the mat; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Kicking above hip height",
        "fix": "Stop when the leg is level; higher only arches the low back."
      },
      {
        "id": "m2",
        "mistake": "Opening the hip to the side",
        "fix": "Toes point down, hips square."
      },
      {
        "id": "m3",
        "mistake": "Sagging through the shoulders",
        "fix": "Push the floor away."
      },
      {
        "id": "m4",
        "mistake": "Swinging",
        "fix": "Pause at the back, return slower."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip extension",
        "setup": "Hip ≈62° flexion (knee hovering)",
        "peak": "Hip ≈-14°; leg 0° from level",
        "norm": "Leg level with the hips, about 0-15 degrees past neutral (clinical opinion); quadruped hip extension excites the gluteus maximus (Macadam 2019; Neto 2020)",
        "sources": [
          "macadam2019",
          "neto2020"
        ]
      },
      {
        "measure": "Knee",
        "setup": "≈94°",
        "peak": "≈4°",
        "norm": "Straight at the back, bent under the hip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Above both knees (24 cm apart)",
        "peak": "Stretched to 53 cm",
        "norm": "Mini loop above both knees (elastic resistance, Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s on all fours",
        "peak": "1.2 s back, 0.5 s hold, 1.8 s in",
        "norm": "Controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #2381, Band Kneeling Rear Kick, video (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/2381-band-kneeling-rear-kick.html"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      },
      {
        "id": "neto2020",
