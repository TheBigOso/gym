        "url": "https://www.jssm.org/jssm-19-195.xml-abst"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjørnlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Andersen+2010+muscle+activation+perceived+loading+dumbbells+elastic+resistance"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the band for nicks before use.",
        "Wrist discomfort: use fists or forearms."
      ],
      "modify": [
        "Knee discomfort: fold the mat under the support knee."
      ],
      "regressions": [
        "Rear kick without a band."
      ],
      "progressions": [
        "Heavier band.",
        "Cable donkey kickback."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Extends the hip against the band (Macadam 2019; Neto 2020).",
      "hamstrings_r": "Assist hip extension with the knee straight (clinical opinion).",
      "core": "Holds the spine neutral (clinical opinion).",
      "obliques_r": "Stop the pelvis rotating (clinical opinion).",
      "obliques_l": "Stop the pelvis rotating (clinical opinion).",
      "glute_med_l": "Steadies the support hip and resists the band (clinical opinion).",
      "spinal_extensors_r": "Hold the back flat (clinical opinion).",
      "spinal_extensors_l": "Hold the back flat (clinical opinion).",
      "serratus_r": "Hold the shoulder blades on the ribs (clinical opinion).",
      "serratus_l": "Hold the shoulder blades on the ribs (clinical opinion).",
      "hip_flexors_r": "Lengthen at the back of the kick (clinical opinion)."
    }
