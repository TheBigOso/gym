  "exercise": {
    "id": "glute-bridge",
    "name": "Glute Bridge",
    "aliases": [
      "Bridge",
      "Hip bridge",
      "Supine bridge",
      "Two-leg glute bridge"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "247112",
      "title": "Glute Bridge Two Legs on Floor (female)",
      "url": "https://gymvisual.com/videos/7905-glute-bridge-two-legs-on-floor-female.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (hamstrings)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip extension; knees and feet fixed)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l",
        "quads_r",
        "quads_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you drive the hips up, keep breathing in the squeeze, inhale as you lower.",
      "cadence": "About 1.5 s up, 1 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "1.5-1-2-0 (up, squeeze, down)",
      "frequency": "2-4 times a week",
      "progression": "Longer squeeze, then single-leg bridge, then hip thrust from a bench"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent, feet flat and hip width, arms on the floor by your sides."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out, press through the heels and drive the hips up."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Knees, hips and shoulders in one line. Squeeze the glutes; ribs down, no arching."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the hips slowly back to the mat."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch down lightly, reset, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back at the top",
        "fix": "Stop when knees, hips and shoulders line up; tuck the pelvis slightly and keep the ribs down."
      },
      {
        "id": "m2",
        "mistake": "Knees falling in or out",
        "fix": "Keep the knees over the feet, hip width apart."
      },
      {
        "id": "m3",
        "mistake": "Feeling it mostly in the hamstrings (cramping)",
        "fix": "Bring the feet a little closer to the hips; more knee bend lowered hamstring activity in Lehecka 2017."
      },
      {
        "id": "m4",
        "mistake": "Pushing through the neck or head",
        "fix": "Weight on the upper back and feet; neck relaxed, chin gently tucked."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈54° (lying)",
        "peak": "≈-5° (neutral; knee-hip-shoulder line 180°)",
        "norm": "Hips extend to neutral at the top (straight knee-hip-shoulder line); no extra lumbar arch (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈106°",
        "peak": "≈90° (shin about vertical)",
        "norm": "About 90 degrees at the top is the traditional bridge; more knee bend shifts work away from the hamstrings (Lehecka 2017)",
        "sources": [
          "lehecka2017"
        ]
      },
      {
        "measure": "Trunk line",
        "setup": "≈-3° (shoulder-to-hip line from the floor)",
        "peak": "≈24° from the floor",
        "norm": "Shoulder-to-hip line rises until it is in line with the thighs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip height",
        "setup": "Hip joint 8.6 cm above the floor",
        "peak": "29.5 cm (+20.9 cm)",
        "norm": "Pelvis lifts until the line is straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Lying 0.8 s",
        "peak": "1.5 s up, 1.0 s squeeze, 2.0 s down, 0.7 s reset",
        "norm": "Controlled: about 1-2 s up, a brief squeeze, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #247112, Glute Bridge Two Legs on Floor (female), video (movement reference)",
        "url": "https://gymvisual.com/videos/7905-glute-bridge-two-legs-on-floor-female.html"
      },
      {
        "id": "lehecka2017",
        "title": "Lehecka et al. 2017, building a better gluteal bridge: EMG of hip muscles during modified single-leg bridges (Int J Sports Phys Ther 12(4):543-549; PMC5534144)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5534144/"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low back discomfort: lift less high and brace the abdomen first.",
        "Hamstring cramps: move the feet closer to the hips."
      ],
      "regressions": [
        "Smaller lift (pelvic tilt to a half bridge).",
        "Shorter squeeze."
      ],
      "progressions": [
        "Longer squeeze at the top.",
        "Single-leg bridge.",
        "Hip thrust with the upper back on a bench."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor lifting the pelvis. Cueing the glutes about doubled gluteus maximus activity in a bridge study listed by Macadam 2019 (16.8% to 33.0% MVIC).",
      "glute_max_l": "Main hip extensor lifting the pelvis. Cueing the glutes about doubled gluteus maximus activity in a bridge study listed by Macadam 2019 (16.8% to 33.0% MVIC).",
      "hamstrings_r": "Assist hip extension; with the knees at about 90 degrees they work hard. Biceps femoris reached about 75% MVIC in a single-leg bridge at 90 degrees of knee flexion (Lehecka 2017).",
      "hamstrings_l": "Assist hip extension; with the knees at about 90 degrees they work hard. Biceps femoris reached about 75% MVIC in a single-leg bridge at 90 degrees of knee flexion (Lehecka 2017).",
      "adductors_r": "Adductor magnus assists hip extension and keeps the knees from drifting apart (clinical opinion).",
      "adductors_l": "Adductor magnus assists hip extension and keeps the knees from drifting apart (clinical opinion).",
      "glute_med_r": "Keeps the pelvis level and the knees in line with the feet; it was active in bridging studies (Lehecka 2017).",
      "glute_med_l": "Keeps the pelvis level and the knees in line with the feet; it was active in bridging studies (Lehecka 2017).",
      "quads_r": "Hold the knee angle and press the feet into the floor (clinical opinion).",
      "quads_l": "Hold the knee angle and press the feet into the floor (clinical opinion).",
      "core": "Holds the ribs down and the pelvis neutral so the lift comes from the hips, not the low back.",
      "spinal_extensors_r": "Hold the trunk in line; they should not take over by arching the low back (clinical opinion).",
      "spinal_extensors_l": "Hold the trunk in line; they should not take over by arching the low back (clinical opinion)."
    }
  },
