      },
      {
        "id": "mcgill2012",
        "title": "McGill & Marshall 2012, kettlebell swing, snatch, and bottoms-up carry: back and hip muscle activation, motion, and low back loads (J Strength Cond Res 26(1):16-27)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21997449/"
      },
      {
        "id": "saeterbakken2012",
        "title": "Saeterbakken & Fimland 2012, muscle activity of the core during bilateral, unilateral, seated and standing resistance exercise (Eur J Appl Physiol 112:1671-1678)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21877146/"
      }
    ],
    "safety": {
      "cautions": [
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Low-back pain: keep the back flat; stop the set when the hips slow down or the back rounds.",
        "Hold the handle firmly and clear the space in front of you.",
        "Shoulder pain: keep the swing to belly height.",
        "Load is user-chosen: start lighter than your two-hand swing."
      ],
      "modify": [
        "Two-hand dumbbell swing.",
        "Lower swing (to belly height)."
      ],
      "regressions": [
        "Two-hand dumbbell swing.",
        "Single-arm dumbbell deadlift."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Hand-to-hand switch at the top.",
        "Single-arm dumbbell snatch."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Drives the hip snap (McGill 2012 measured high glute activity in the swing).",
      "glute_max_l": "Drives the hip snap (McGill 2012 measured high glute activity in the swing).",
      "hamstrings_r": "Load in the hinge and help snap the hips through; lengthened at the bottom (clinical opinion).",
      "hamstrings_l": "Load in the hinge and help snap the hips through; lengthened at the bottom (clinical opinion).",
      "spinal_extensors_r": "Hold the back flat in the hinge (McGill 2012).",
      "spinal_extensors_l": "Hold the back flat in the hinge (McGill 2012).",
      "quads_r": "Extend the knees at the top (clinical opinion).",
      "quads_l": "Extend the knees at the top (clinical opinion).",
      "glute_med_r": "Steadies the pelvis against the one-sided pull (clinical opinion).",
      "glute_med_l": "Steadies the pelvis against the one-sided pull (clinical opinion).",
      "ant_deltoid_r": "Guides the arm at the top of the float (clinical opinion).",
      "core": "Resists rotation and side-bend toward the dumbbell; unilateral loading raised trunk activity in Saeterbakken 2012.",
      "obliques_r": "Keep the trunk square (clinical opinion).",
      "obliques_l": "Keep the trunk square (clinical opinion).",
      "lats_r": "Pull the falling dumbbell back through the legs and keep the shoulder set (clinical opinion).",
      "forearm_flexors_r": "Grip the handle (clinical opinion).",
      "upper_traps_r": "Support the shoulder girdle (clinical opinion).",
      "serratus_r": "Keeps the shoulder blade on the ribs (clinical opinion)."
    }
