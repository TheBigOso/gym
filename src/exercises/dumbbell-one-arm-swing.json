    "id": "dumbbell-one-arm-swing",
    "name": "Dumbbell One Arm Swing",
    "aliases": [
      "Single-arm dumbbell swing",
      "One-hand dumbbell swing",
      "Unilateral dumbbell swing"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15884",
      "title": "Dumbbell One Arm Swing",
      "url": "https://gymvisual.com/videos/15884-dumbbell-one-arm-swing.html",
      "listing": "Video; the page could not be read here (blocked), so the movement follows the name and standard coaching (one-hand swing to chest height).",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Power (ballistic hip hinge)",
    "bodyPart": "Hips (glutes and hamstrings)",
    "secondaryBodyParts": [
      "Core (anti-rotation)",
      "Shoulders",
      "Lower back",
      "Forearms (grip)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (explosive hip extension from a hinge, one-sided load)",
    "plane": "Sagittal",
    "laterality": "Unilateral (one arm at a time)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l",
        "hamstrings_r",
        "hamstrings_l"
      ],
      "synergist": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "quads_r",
        "quads_l",
        "glute_med_r",
        "glute_med_l",
        "ant_deltoid_r"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "lats_r",
        "forearm_flexors_r",
        "upper_traps_r",
        "serratus_r"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in on the way down, a short sharp breath out as the hips snap.",
      "cadence": "About 1.5 s per swing"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "8-15 per arm",
      "tempo": "Continuous, about 1.5 s per swing",
      "load": "User-chosen; a little lighter than for the two-hand swing",
      "frequency": "2-3 times a week",
      "progression": "More reps, heavier dumbbell, then hand-to-hand switches at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet wider than the hips; dumbbell in the right hand, thumb forward; free arm relaxed."
      },
      {
        "id": "c2",
        "phase": "hike",
        "text": "Hinge: hips back, flat back, dumbbell between the thighs."
      },
      {
        "id": "c3",
        "phase": "swing",
        "text": "Snap the hips and stand tall; the straight arm floats the dumbbell to chest height."
      },
      {
        "id": "c4",
        "phase": "back",
        "text": "Let it fall; hinge late and hike it back through."
      },
      {
        "id": "c5",
        "phase": "swing2",
        "text": "Snap again; keep the shoulders and hips square, do not twist toward the dumbbell."
      },
      {
        "id": "c6",
        "phase": "park",
        "text": "Let it slow and stop hanging in front."
      },
      {
        "id": "c7",
        "phase": "reset",
        "text": "Stand tall; switch hands after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting the trunk toward the dumbbell",
        "fix": "Brace and keep both shoulders square to the front."
      },
      {
        "id": "m2",
        "mistake": "Lifting with the arm",
        "fix": "The hips move the dumbbell; the arm is a rope."
      },
      {
        "id": "m3",
        "mistake": "Squatting instead of hinging",
        "fix": "Hips back, shins nearly vertical."
      },
      {
        "id": "m4",
        "mistake": "Shoulder pulled forward at the top",
        "fix": "Keep the shoulder blade set back and down."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈93° at the bottom (joint channel), trunk ≈47° forward",
        "peak": "≈-1° at the top (standing tall)",
        "norm": "Kettlebell swing: about 75 degrees of hip flexion at the start to about 1 degree of extension at the top (McGill 2012)",
        "sources": [
          "mcgill2012"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈40° at the bottom",
        "peak": "≈3° at the top",
        "norm": "About 69 degrees at the bottom to about 2 degrees of extension at the top (McGill 2012); a hinge, not a squat",
        "sources": [
          "mcgill2012"
        ]
      },
      {
        "measure": "Arm swing",
        "setup": "Right arm 22° behind vertical, dumbbell between the thighs",
        "peak": "Right arm ≈86° forward (about chest height) at the top; free arm hanging",
        "norm": "Floats to about chest height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk rotation",
        "setup": "Square to the front",
        "peak": "Square (the trunk resists the pull of the one-sided load)",
        "norm": "The trunk stays square; one-sided loads raise the trunk muscle demand (Saeterbakken 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.6 s, hike back 0.75 s",
        "peak": "About 1.5 s per swing, two swings, then park",
        "norm": "Fast contraction-relaxation cycles over about half a second (McGill 2012)",
        "sources": [
          "mcgill2012"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15884, Dumbbell One Arm Swing, video (movement reference)",
