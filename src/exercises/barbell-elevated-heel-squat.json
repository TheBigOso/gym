    "breathing": {
      "pattern": "Breathe in and brace at the top, hold it down and through the bottom, breathe out as you pass the hardest part of the rise.",
      "cadence": "About 2 s down, a short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "2-1-1-0",
      "frequency": "1-2 times a week",
      "load": "Barbell load is user-chosen: start lighter than your normal back squat; leave about 2-3 reps in reserve (RPE 7-8).",
      "rest": "2 minutes between sets",
      "progression": "Add 2.5 kg when every rep reaches full depth with the heels down on the block."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar on the upper traps just below the bony bump at the base of the neck, hands just outside the shoulders, elbows down, shoulder blades squeezed together. Heels on a low block (plates or a wedge), balls of the feet on the floor, feet about hip width, toes nearly straight."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Brace and sit straight down: knees travel well forward over the toes, trunk stays upright."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Hips below the knees, heels pressed into the block, back flat."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive up through the whole foot, chest leading; breathe out as you pass the hardest part."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, re-brace."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Heels sliding off the block",
        "fix": "Set the block under the heels with the balls of the feet on the floor, and press the heels down all rep."
      },
      {
        "id": "m2",
        "mistake": "Knees caving in",
        "fix": "Push the knees out over the toes."
      },
      {
        "id": "m3",
        "mistake": "Rounding the lower back at depth",
        "fix": "Stop just above the depth where the pelvis tucks under."
      },
      {
        "id": "m4",
        "mistake": "Bouncing out of the bottom",
        "fix": "Pause briefly and rise under control."
      }
    ],
    "kinematics": [
      {
        "measure": "Heel block",
        "setup": "4 cm block under the heels, feet 15° heel-up with the balls of the feet on the floor",
        "peak": "Unchanged; peak ankle dorsiflexion ≈28° relative to the foot",
        "norm": "A heel lift reduces the ankle dorsiflexion needed and lets the trunk stay more upright (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Stance width",
        "setup": "26 cm between the ankle centres, toes out 10°",
        "peak": "Unchanged (feet planted)",
        "norm": "About hip width with the toes nearly straight (Lorenzetti 2018)",
        "sources": [
          "lorenzetti2018"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈4°",
        "peak": "≈125°; hip joints -5.7 cm below the knees, knees 18.8 cm past the toe joints",
        "norm": "Full depth, about 120 degrees or more (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈-6°",
        "peak": "≈104° (joint channel)",
        "norm": "Less hip flexion for the same depth than with the heels flat (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈25° forward of vertical; bar 0.2 cm from mid-foot",
        "norm": "More upright than a flat-footed high-bar squat (Larsen 2021)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
