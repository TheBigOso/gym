    "safety": {
      "cautions": [
        "Squat inside a rack with the safety arms set just below your bottom position, or with a spotter; the rack drawn here shows only the J-hooks.",
        "Use a stable block that cannot tip or slide (stacked plates or a squat wedge).",
        "The forward knee travel loads the front of the knee: build depth and load gradually.",
        "Keep the bar on the muscle of the upper back, never on the neck.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee pain: reduce depth or lower the block.",
        "Balance issues: lighter bar, slower descent."
      ],
      "regressions": [
        "Heels-elevated goblet squat.",
        "Heels-elevated bodyweight squat."
      ],
      "progressions": [
        "Heavier bar.",
        "Pause at the bottom.",
        "Barbell front squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Raised heels let the knees travel far forward with an upright trunk, which shifts the work toward the knee extensors (Straub 2024).",
      "quads_l": "Raised heels let the knees travel far forward with an upright trunk, which shifts the work toward the knee extensors (Straub 2024).",
      "glute_max_r": "Extends the hip from the bottom; a little less hip demand with the trunk upright.",
      "glute_max_l": "Extends the hip from the bottom; a little less hip demand with the trunk upright.",
      "adductors_r": "Help extend the hip from the bottom.",
      "adductors_l": "Help extend the hip from the bottom.",
      "hamstrings_r": "Assist hip extension; their length changes little in a squat.",
      "hamstrings_l": "Assist hip extension; their length changes little in a squat.",
      "spinal_extensors_r": "Hold the back flat under the bar.",
      "spinal_extensors_l": "Hold the back flat under the bar.",
      "calves_r": "Control the forward travel of the knees over the planted feet.",
      "calves_l": "Control the forward travel of the knees over the planted feet.",
      "core": "Bracing stiffens the trunk under the bar.",
      "obliques_r": "Part of the brace.",
      "obliques_l": "Part of the brace.",
      "glute_med_r": "Keeps the knees tracking over the feet.",
      "glute_med_l": "Keeps the knees tracking over the feet.",
      "upper_traps_r": "The muscle shelf the bar rests on.",
      "upper_traps_l": "The muscle shelf the bar rests on.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together so the upper back forms a tight shelf.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together so the upper back forms a tight shelf.",
      "lats_r": "Pull the bar down into the back and keep the upper back tight.",
      "lats_l": "Pull the bar down into the back and keep the upper back tight.",
