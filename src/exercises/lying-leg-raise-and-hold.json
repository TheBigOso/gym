  "exercise": {
    "id": "lying-leg-raise-and-hold",
    "name": "Lying Leg Raise and Hold",
    "aliases": [
      "Leg raise hold",
      "Straight-leg raise isometric",
      "Supine 45-degree leg hold"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5109",
      "title": "Lying Leg Raise and Hold",
      "url": "https://gymvisual.com/videos/5109-lying-leg-raise-and-hold.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the network proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (isometric hip flexion, trunk braced)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the legs rise; keep breathing slowly and shallowly through the hold (do not hold the breath); inhale as they lower.",
      "cadence": "About 1.2 s up, 3 s hold, 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "5-8 holds of 3-5 s (or one 15-30 s hold)",
      "tempo": "About 1.2 s up, 3-5 s hold, 2 s down",
      "frequency": "2-3 times a week",
      "progression": "Longer holds, then lower holds (30 degrees), then add slow flutters during the hold"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, arms by your sides palms down, legs straight and together, heels just off the mat."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and lift both legs together to about 45 degrees, knees long."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold still. Low back pressed into the mat, ribs down, keep breathing."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly, stopping with the heels just above the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short hover, then raise again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching off the mat during the hold",
        "fix": "Raise the legs higher or bend the knees until the back stays flat."
      },
      {
        "id": "m2",
        "mistake": "Holding the breath",
        "fix": "Breathe slowly through the hold while keeping the brace."
      },
      {
        "id": "m3",
        "mistake": "Legs drifting down or shaking apart",
        "fix": "Squeeze the legs together and pick a shorter hold you can keep still."
      },
      {
        "id": "m4",
        "mistake": "Pushing hard into the floor with the hands and neck",
        "fix": "Hands rest lightly; head relaxed on the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Legs from the floor",
        "setup": "Heels 6 cm off the mat (hip-to-ankle line ≈6°)",
        "peak": "≈45°, held about 3 s",
        "norm": "Held at about 45 degrees; lower holds are harder (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈9°",
        "peak": "≈49°",
        "norm": "About 45 degrees during the hold (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈3°",
        "peak": "≈4°",
        "norm": "Straight or nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Pelvis stays on the mat; the low back should not arch (clinical opinion; McGill 1998 for the load)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hover 0.6 s",
        "peak": "1.2 s up, 3 s hold, 2 s down, 0.7 s hover",
        "norm": "Controlled lift, 3-5 s still hold, slow lowering (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #5109, Lying Leg Raise and Hold, video (movement reference; page not readable here)",
