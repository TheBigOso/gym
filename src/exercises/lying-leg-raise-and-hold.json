      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      },
      {
        "id": "clark2003",
        "title": "Clark, Holt and Sinyard 2003, electromyographic comparison of the upper and lower rectus abdominis during abdominal exercises (J Strength Cond Res 17(3):475-483; PMID 12930172)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/12930172/"
      },
      {
        "id": "axler1997",
        "title": "Axler and McGill 1997, low-back loads over a variety of abdominal exercises: searching for the safest abdominal challenge (Med Sci Sports Exerc 29(6):804-811)",
        "url": "https://acnpsearch.tweb-dev.unibo.it/singlejournalindex/7588015"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Straight-leg raises load the low back: leg raises gave higher psoas activity and spine compression than sit-ups in McGill's data (McGill 1998). If the low back arches off the mat, bend the knees or shorten the range.",
        "Low-back pain or disc problems: prefer bent-knee raises, dead bugs or curl-ups.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion or straight-leg work."
      ],
      "modify": [
        "Bend the knees to shorten the lever.",
        "Hands under the hips if the low back lifts.",
        "Shorter range: stop lowering higher up."
      ],
      "regressions": [
        "Bent-knee hold (tabletop).",
        "Single-leg hold with the other foot on the floor.",
        "Dead bug."
      ],
      "progressions": [
        "Longer holds (up to 30 s).",
        "Lower hold angle (about 30 degrees).",
        "Small flutter kicks during the hold."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas lifts and lowers the legs. Bilateral leg lifts gave higher iliacus activity than hip-flexion sit-ups (Andersson 1997), and leg raises produced the highest psoas activity in McGill's comparison (McGill 1998).",
      "hip_flexors_l": "Iliopsoas lifts and lowers the legs. Bilateral leg lifts gave higher iliacus activity than hip-flexion sit-ups (Andersson 1997), and leg raises produced the highest psoas activity in McGill's comparison (McGill 1998).",
      "core": "Rectus abdominis does not move the legs; it holds the pelvis and low back against the pull of the hip flexors. Bilateral, but not unilateral, leg lifts needed abdominal activation (Andersson 1997). Leg lowering gave less rectus activity than curl-ups (Clark 2003).",
      "obliques_r": "Brace with the rectus to stop the low back arching.",
      "obliques_l": "Brace with the rectus to stop the low back arching.",
      "adductors_r": "Keep the legs together and assist hip flexion near the bottom (clinical opinion).",
      "adductors_l": "Keep the legs together and assist hip flexion near the bottom (clinical opinion).",
      "quads_r": "Keep the knees straight; rectus femoris also helps flex the hips.",
      "quads_l": "Keep the knees straight; rectus femoris also helps flex the hips."
    }
  },
