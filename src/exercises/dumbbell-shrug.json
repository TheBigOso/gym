  "exercise": {
    "id": "dumbbell-shrug",
    "name": "Dumbbell Shrug",
    "aliases": [
      "Dumbbell shoulder shrug",
      "Standing dumbbell shrug"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "040612",
      "title": "Dumbbell Shrug",
      "url": "https://gymvisual.com/videos/1370-dumbbell-shrug.html",
      "listing": "Video; data sheet: body part Back, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (upper trapezius)",
    "secondaryBodyParts": [
      "Neck",
      "Forearms (grip)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (scapular elevation)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "upper_traps_r",
        "upper_traps_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you shrug, hold briefly, inhale as you lower.",
      "cadence": "About 1 s up, 1 s hold, 1.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "1-1-1.5 (up, hold, down)",
      "load": "User-chosen dumbbells; stop about 1-3 reps short of failure (RIR 1-3)",
      "frequency": "1-2 times a week",
      "progression": "Add load, then a longer hold at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, dumbbells at your sides, palms facing in, arms long."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and lift the shoulders straight up toward the ears."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the top for a second; arms stay straight."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to a full stretch."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay tall and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rolling the shoulders in circles",
        "fix": "Move straight up and straight down."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbows to help",
        "fix": "Keep the arms long; let the shoulders do the lifting."
      },
      {
        "id": "m3",
        "mistake": "Poking the head forward",
        "fix": "Keep the chin tucked and the neck long."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder girdle elevation",
        "setup": "Clavicle -3° (slight stretch)",
        "peak": "Clavicle +28°: shoulders rise ≈8.3 cm, dumbbells ≈9.1 cm",
        "norm": "Shoulders rise straight up as far as comfortable (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arm position",
        "setup": "Arms hang by the sides, elbows ≈6°",
        "peak": "Elbows ≈10°, hands 0.8 cm wider",
        "norm": "Arms by the sides; about 30 degrees of abduction is a variation that raised trapezius activity (Pizzari 2014)",
        "sources": [
          "pizzari2014"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.0 s up, 1.0 s hold, 1.5 s down, 0.7 s reset",
        "norm": "About 1 s up, a 1 s hold and a slower lowering (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #040612, Dumbbell Shrug, video (movement reference)",
        "url": "https://gymvisual.com/videos/1370-dumbbell-shrug.html"
      },
      {
        "id": "ekstrom2003",
        "title": "Ekstrom, Donatelli & Soderberg 2003, surface electromyographic analysis of exercises for the trapezius and serratus anterior muscles (J Orthop Sports Phys Ther 33(5):247-258)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/12774999/"
      },
      {
        "id": "pizzari2014",
        "title": "Pizzari et al. 2014, modifying a shrug exercise can facilitate the upward rotator muscles of the scapula (Clin Biomech 29(2):201-205)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/24342452/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Neck pain or headache: use a lighter load and a smaller range."
      ],
      "modify": [
        "Shoulder pain: try the dumbbells slightly out from the sides.",
        "Grip fatigue: use straps or lighter dumbbells."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Shrug without weights."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Longer hold at the top.",
        "Shrug with the arms about 30 degrees out to the side (Pizzari 2014)."
      ]
    },
    "muscleNotes": {
      "upper_traps_r": "Elevate the shoulder girdle. A shoulder shrug produced the greatest upper trapezius EMG of the exercises tested by Ekstrom 2003; shrugging with the arms about 30 degrees out to the side raised upper and lower trapezius activity further (Pizzari 2014).",
      "upper_traps_l": "Elevate the shoulder girdle. A shoulder shrug produced the greatest upper trapezius EMG of the exercises tested by Ekstrom 2003; shrugging with the arms about 30 degrees out to the side raised upper and lower trapezius activity further (Pizzari 2014).",
      "rhomboids_midtrap_r": "Rhomboids (with levator scapulae, not shown) help elevate and steady the shoulder blade.",
      "rhomboids_midtrap_l": "Rhomboids (with levator scapulae, not shown) help elevate and steady the shoulder blade.",
      "forearm_flexors_r": "Hold the dumbbells; grip is often the limit with heavy shrugs.",
      "forearm_flexors_l": "Hold the dumbbells; grip is often the limit with heavy shrugs.",
      "core": "Keeps the trunk tall."
    }
  },
