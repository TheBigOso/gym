    "breathing": {
      "pattern": "Breathe out as the arms sweep out, breathe in as they come back down.",
      "cadence": "About 1 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1",
      "progression": "More reps, a longer squeeze, a wider stance on the band, then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the bands, feet about hip width; hinge at the hips with a flat back until the trunk is well forward, knees soft. Arms hang under the shoulders, palms facing each other, elbows soft."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and sweep the arms out to the sides in a wide arc, leading with the elbows, until they are about level with the back."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the shoulder blades together; hold the trunk still."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the arms back under the shoulders against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the band still taut, then sweep again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the trunk as the arms rise",
        "fix": "Hold the hinge; the arms move, the trunk does not."
      },
      {
        "id": "m2",
        "mistake": "Rounding the low back",
        "fix": "Hinge from the hips with a flat back; soften the knees more."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulders toward the ears",
        "fix": "Keep the neck long and the shoulders down."
      },
      {
        "id": "m4",
        "mistake": "Bending the elbows to row the band up",
        "fix": "Keep a fixed slight bend and sweep the arms wide."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk",
        "setup": "≈25° above horizontal (≈65° from vertical), knees ≈22°",
        "peak": "Unchanged",
        "norm": "Hinged well forward with a flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arm path",
        "setup": "Arms hanging (upper arm ≈11° from vertical), palms facing",
        "peak": "Upper arm ≈104° from vertical, about level with the back; palms down",
        "norm": "From hanging under the shoulders out to the sides to about level with the back; a neutral grip suits the posterior deltoid (Schoenfeld 2013).",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈18°",
        "norm": "Fixed, about 10-20 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "One band per hand under the ball of each foot; strands 46 cm",
        "peak": "Strands 133.3 cm at the top; at least 9.8 cm from the body",
        "norm": "Each band under the ball of its own foot; tension rises toward the top. Elastic resistance can match free weights (Andersen 2010).",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hold the hinge 0.6 s",
        "peak": "1.1 s up, 0.4 s squeeze, 1.8 s down, 0.4 s pause",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
