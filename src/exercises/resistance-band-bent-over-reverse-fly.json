    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Low back: keep the hinge flat-backed and the band light enough that the trunk stays still (clinical opinion).",
        "Keep the band securely under the feet; a band that slips can whip up toward the face.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low back discomfort: do it seated, leaning forward over the thighs, or chest-supported on an incline bench."
      ],
      "regressions": [
        "Lighter band.",
        "Band pull-apart (standing)."
      ],
      "progressions": [
        "Stronger band or a wider stance on the band.",
        "Pause 2 s at the top.",
        "Dumbbell rear delt fly."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Main mover: horizontal abduction of the arm; a neutral grip suits the posterior deltoid (Schoenfeld 2013).",
      "post_deltoid_l": "Main mover: horizontal abduction of the arm; a neutral grip suits the posterior deltoid (Schoenfeld 2013).",
      "rhomboids_midtrap_r": "Pull the shoulder blades together at the top.",
      "rhomboids_midtrap_l": "Pull the shoulder blades together at the top.",
      "infraspinatus_r": "Assists horizontal abduction and keeps the arm turned out.",
      "infraspinatus_l": "Assists horizontal abduction and keeps the arm turned out.",
      "lat_deltoid_r": "Assists as the arms reach shoulder level.",
      "lat_deltoid_l": "Assists as the arms reach shoulder level.",
      "upper_traps_r": "Steadies the shoulder blades; keep them from shrugging.",
      "upper_traps_l": "Steadies the shoulder blades; keep them from shrugging.",
      "spinal_extensors_r": "Hold the flat-backed hinge.",
      "spinal_extensors_l": "Hold the flat-backed hinge.",
      "hamstrings_r": "Hold the hips in the hinge.",
      "hamstrings_l": "Hold the hips in the hinge.",
      "glute_max_r": "Holds the hips in the hinge.",
