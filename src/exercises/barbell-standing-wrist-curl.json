      }
    ],
    "safety": {
      "cautions": [
        "Wrist pain: lighter bar, smaller range (clinical opinion).",
        "Pain on the inside of the elbow (golfer's elbow): use a light bar and a slow lowering, and get it assessed if it does not settle (clinical opinion).",
        "Lift the bar from a rack or the floor with a flat back and bent knees, and set it down the same way.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Seated wrist curl with the forearms on the thighs.",
        "Dumbbells, one arm at a time."
      ],
      "regressions": [
        "Empty bar or a light fixed barbell.",
        "Seated dumbbell wrist curl."
      ],
      "progressions": [
        "Heavier bar.",
        "Slower lowering.",
        "Behind-the-back barbell wrist curl."
      ]
    },
    "muscleNotes": {
      "forearm_flexors_r": "Curl the hands forward and up; the finger flexors hold the bar. Added wrist and forearm work gave greater wrist and forearm strength gains (Szymanski 2004).",
      "forearm_flexors_l": "Curl the hands forward and up; the finger flexors hold the bar. Added wrist and forearm work gave greater wrist and forearm strength gains (Szymanski 2004).",
      "ant_deltoid_r": "Holds the straight arms just in front of the thighs (clinical opinion).",
      "ant_deltoid_l": "Holds the straight arms just in front of the thighs (clinical opinion).",
      "biceps_r": "Keeps the elbows straight against the pull of the bar together with the triceps; little work (clinical opinion).",
      "biceps_l": "Keeps the elbows straight against the pull of the bar together with the triceps; little work (clinical opinion).",
      "upper_traps_r": "Carry the bar on the shoulders (clinical opinion).",
      "upper_traps_l": "Carry the bar on the shoulders (clinical opinion).",
      "core": "Keeps the trunk tall."
