    "breathing": {
      "pattern": "Breathe out as the arms straighten, breathe in as the band draws the hands back behind the head.",
      "cadence": "About 1 s out, short pause, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-15",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1",
      "progression": "More reps, a slower return, a step farther from the rack, then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop the band round a rack upright behind you, above head height. Staggered stance facing away, lean forward a little, trunk braced. Hold the band in both hands behind the head, palms facing, upper arms forward and up beside the head, elbows bent."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and straighten the elbows, pushing the hands forward and up in line with the upper arms; only the forearms move."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Arms straight but not locked hard, upper arms beside the head; squeeze the triceps."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the band draw the hands back behind the head, keeping the elbows pointing forward."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the elbows fully bent, then straighten again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring out to the sides",
        "fix": "Keep the elbows about shoulder width, pointing forward."
      },
      {
        "id": "m2",
        "mistake": "Upper arms swinging (turning it into a pullover)",
        "fix": "Hold the upper arms still; move only at the elbows."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back",
        "fix": "Ribs down, slight forward lean, glutes braced."
      },
      {
        "id": "m4",
        "mistake": "Cutting the stretch short",
        "fix": "Let the hands come well behind the head."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈115° with the hands behind the head",
        "peak": "≈10° (arms long, not locked)",
        "norm": "About 110-120 degrees in the stretch to nearly straight; overhead elbow extension grew the triceps more than the neutral-arm position (Maeo et al. 2022).",
        "sources": [
          "overhead2022"
        ]
      },
      {
        "measure": "Upper arm",
        "setup": "≈35° forward of vertical, ≈155° from the trunk line; elbows 40.8 cm apart",
        "peak": "Unchanged (only the elbows move)",
        "norm": "Still, forward and up beside the head (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack upright behind, 205 cm up, 57 cm behind the hips; strands 72.2 cm",
        "peak": "Strands 105.3 cm with the arms straight; at least 13.2 cm from the body and head",
        "norm": "Anchored high behind so it pulls the hands back toward the stretch; Boehler 2011 compared triceps activity across exercises.",
        "sources": [
          "boehler2011"
        ]
      },
      {
        "measure": "Trunk",
        "setup": "Staggered stance, right foot forward, trunk ≈10° forward of vertical",
        "peak": "Unchanged",
        "norm": "Staggered stance, leaning forward about 15-20 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s in the stretch",
        "peak": "1.1 s out, 0.4 s squeeze, 1.8 s back, 0.4 s pause",
        "norm": "About 1 s out and 2 s back (clinical opinion)",
        "sources": []
      }
    ],
