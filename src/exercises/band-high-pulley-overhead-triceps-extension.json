    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Elbow pain: shorten the stretch (clinical opinion).",
        "Shoulder pain overhead: lower the upper arms toward horizontal (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: upper arms pointing more forward than up."
      ],
      "regressions": [
        "Lighter band or step closer to the rack.",
        "Band triceps pushdown."
      ],
      "progressions": [
        "Stronger band or step farther away.",
        "Pause 2 s in the stretch.",
        "Cable overhead triceps extension."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Main mover. With the arms overhead the long head works from a stretched position; overhead extensions grew the triceps more than neutral-arm extensions (Maeo et al. 2022), and the heads share the work differently across the range (Kholinne 2018).",
      "triceps_l": "Main mover. With the arms overhead the long head works from a stretched position; overhead extensions grew the triceps more than neutral-arm extensions (Maeo et al. 2022), and the heads share the work differently across the range (Kholinne 2018).",
      "forearm_extensors_r": "Steady the wrists.",
      "forearm_extensors_l": "Steady the wrists.",
      "ant_deltoid_r": "Holds the upper arms up.",
      "ant_deltoid_l": "Holds the upper arms up.",
      "lat_deltoid_r": "Holds the upper arms up.",
      "lat_deltoid_l": "Holds the upper arms up.",
      "serratus_r": "Rotates the shoulder blades upward with the arms overhead.",
      "serratus_l": "Rotates the shoulder blades upward with the arms overhead.",
      "upper_traps_r": "Support the raised arms.",
      "upper_traps_l": "Support the raised arms.",
      "forearm_flexors_r": "Grip the band.",
      "forearm_flexors_l": "Grip the band.",
      "core": "Braces the trunk against the band pulling back (clinical opinion).",
      "obliques_r": "Help keep the ribs down.",
      "obliques_l": "Help keep the ribs down."
    }
