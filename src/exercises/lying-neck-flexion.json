  "exercise": {
    "id": "lying-neck-flexion",
    "name": "Lying Neck Flexion",
    "aliases": [
      "Supine neck flexion on a bench",
      "Neck curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "022216",
      "title": "Lying Neck Flexion",
      "url": "https://gymvisual.com/videos/22216-lying-neck-flexion.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Neck (front)",
    "secondaryBodyParts": [],
    "equipment": [
      "Flat bench",
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (neck flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "upper_traps_r",
        "upper_traps_l"
      ],
      "synergist": [],
      "stabilizer": [
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl the head up, inhale as you lower it.",
      "cadence": "About 1.5 s up, a short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "Slow, 1.5 s up, 2 s down",
      "frequency": "2 times a week",
      "progression": "More reps, then a light plate held on the forehead"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back on a flat bench with the head off the end, knees bent with the feet on the bench; let the head lower a little."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Tuck the chin and curl the head up toward the chest."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause with the chin near the chest."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the head slowly, only a little below the bench line."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Repeat smoothly."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping the head far back",
        "fix": "Lower only a little below the bench line."
      },
      {
        "id": "m2",
        "mistake": "Jerking the head up",
        "fix": "Move slowly."
      },
      {
        "id": "m3",
        "mistake": "Lifting the shoulders off the bench",
        "fix": "Only the head and neck move."
      },
      {
        "id": "m4",
        "mistake": "Holding the breath",
        "fix": "Breathe out as you curl up."
      }
    ],
    "kinematics": [
      {
        "measure": "Neck flexion",
        "setup": "≈-24° (head a little below the bench line)",
        "peak": "≈48° (chin toward the chest)",
        "norm": "From slight extension to chin near the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Head support",
        "setup": "Head off the end of the bench, shoulders on the pad",
        "peak": "Only the head and neck move",
        "norm": "Shoulders stay on the bench (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #022216, Lying Neck Flexion, video (movement reference)",
        "url": "https://gymvisual.com/videos/22216-lying-neck-flexion.html"
      }
    ],
    "safety": {
      "cautions": [
        "Neck pain, a recent neck injury, dizziness or tingling in the arms: skip this and get advice (clinical opinion).",
        "Move slowly and keep the range small at first.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Smaller range: from level to half way."
      ],
      "regressions": [
        "Chin tucks lying on the floor."
      ],
      "progressions": [
        "Light plate held on the forehead."
      ]
    },
    "muscleNotes": {
      "upper_traps": "The rig has no separate neck flexor group: the deep neck flexors and sternocleidomastoid do this work; the glow on the upper neck region is approximate (clinical opinion)."
    }
  },
