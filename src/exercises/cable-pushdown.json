        "forearm_extensors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you push the bar down, breathe in as it rises.",
      "cadence": "About 1 s down, short pause, about 2 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1-0.4-2-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can push down with the elbows still at your sides for every rep.",
      "progression": "Add reps, then one plate on the stack; slower return"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Face the high pulley, feet hip width, slight forward lean; hold the bar palms down about shoulder width, elbows at your sides and bent about 90 degrees."
      },
      {
        "id": "c2",
        "phase": "push",
        "text": "Breathe out and push the bar down until the arms are straight, moving only at the elbows."
      },
      {
        "id": "c3",
        "phase": "lockout",
        "text": "Squeeze the back of the arms with the bar in front of the thighs; shoulders down, wrists straight."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the bar rise slowly until the elbows are back at about 90 degrees; the elbows stay pinned."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause, keep the trunk still, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows drifting forward or flaring out",
        "fix": "Keep the elbows touching your sides; lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Leaning over the bar to push with body weight",
        "fix": "Stay nearly upright with a slight lean; move only the forearms."
      },
      {
        "id": "m3",
        "mistake": "Letting the bar fly up past 90 degrees",
        "fix": "Control the return and stop when the forearms are about level."
      },
      {
        "id": "m4",
        "mistake": "Bending the wrists",
        "fix": "Keep the wrists straight in line with the forearms."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈90° (forearms about level)",
        "peak": "≈8° (arms straight, not locked hard)",
        "norm": "From about 90 degrees to straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm",
        "setup": "≈12° forward of vertical, elbows at the sides",
        "peak": "Unchanged (elbows move 0.00 cm over the loop)",
        "norm": "Upper arm along the trunk and still; with the arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Overhand, 36 cm between the hands on a 50 cm bar",
        "peak": "Unchanged (35.91-36.05 cm)",
        "norm": "Overhand grip about shoulder width on a straight bar (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈8° forward lean, knees soft",
        "peak": "Unchanged",
        "norm": "Upright or slightly forward, still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the elbows at 90 degrees",
        "peak": "1 s down, 0.4 s at the bottom, 2 s up",
        "norm": "Controlled, about 1 s down and 2 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Pushdown, video (movement reference)",
        "url": "https://gymvisual.com/videos/5020-cable-pushdown.html"
      },
      {
        "id": "kholinne2018",
        "title": "The different role of each head of the triceps brachii muscle in elbow extension (Acta Orthop Traumatol Turc 2018;52(3):201-205; PubMed 29503079; EMG plus OpenSim at 0-180 degrees of shoulder elevation)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29503079/"
      },
      {
        "id": "overhead2022",
        "title": "Triceps brachii hypertrophy is substantially greater after elbow extension training performed in the overhead versus neutral arm position (Eur J Sport Sci 2022, DOI 10.1080/17461391.2022.2100279; PubMed 35819335; 21 adults, 12 weeks, cable)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/35819335/"
      },
      {
        "id": "augustin2025",
        "title": "Augustin, Pinero, Enes, Mohan, Sapuppo, Coleman, Wolf, Korakakis, Swinton, Nippard and Schoenfeld 2025, do cheaters prosper? Externally supplied momentum in curls and pushdowns and upper-arm hypertrophy (Int J Exerc Sci 18(3):329-342)",
        "url": "https://digitalcommons.wku.edu/ijes/vol18/iss3/5"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain in the elbow or shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can control for every rep with the elbows still.",
        "Stand close enough that the cable runs in front of the face, not into it, and keep the head out of its path.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Elbow pain: use a rope or a lighter load and a shorter range (clinical opinion).",
        "Wrist discomfort with the straight bar: use a rope or an angled bar for a more neutral grip."
      ],
      "regressions": [
        "Lighter load.",
        "Band pushdown.",
        "One-arm pushdown with a D-handle."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Overhead cable triceps extension (more triceps growth than the arm-at-the-side position in a 12-week study, PubMed 35819335).",
        "Rope pushdown with a spread at the bottom."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Prime mover: straightens the elbow against the cable. With the upper arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018); training in this position gave less triceps growth than overhead extensions in a 12-week study (PubMed 35819335).",
      "triceps_l": "Prime mover: straightens the elbow against the cable. With the upper arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018); training in this position gave less triceps growth than overhead extensions in a 12-week study (PubMed 35819335).",
      "lats_r": "Holds the upper arm against the side so the elbow stays pinned.",
      "lats_l": "Holds the upper arm against the side so the elbow stays pinned.",
      "post_deltoid_r": "Keeps the upper arm from drifting forward.",
      "post_deltoid_l": "Keeps the upper arm from drifting forward.",
      "forearm_flexors_r": "Grip the bar.",
      "forearm_flexors_l": "Grip the bar.",
      "forearm_extensors_r": "Hold the wrist straight.",
      "forearm_extensors_l": "Hold the wrist straight.",
      "core": "Keeps the trunk still so body weight does not push the bar."
    }
  },
