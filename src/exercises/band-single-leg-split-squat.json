  "exercise": {
    "id": "band-single-leg-split-squat",
    "name": "Band Single Leg Split Squat",
    "aliases": [
      "Band split squat",
      "Banded split squat",
      "Resistance band split squat"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14270",
      "title": "Band single leg split squat",
      "url": "https://gymvisual.com/videos/14270-band-single-leg-split-squat.html",
      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read; authored as a floor split squat with the band under the front foot and held in the hands at the sides)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Adductors"
    ],
    "equipment": [
      "Resistance band"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (knee and hip extension, split stance)",
    "plane": "Sagittal",
    "laterality": "Unilateral (right leg forward)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "quads_r",
        "glute_max_r"
      ],
      "synergist": [
        "adductors_r",
        "quads_l",
        "hamstrings_r"
      ],
      "stabilizer": [
        "glute_med_r",
        "calves_r",
        "calves_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "lengthened": [
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in on the way down, breathe out as you stand up against the band.",
      "cadence": "About 1.8 s down, 1.1 s up"
    },
    "prescription": {
      "sets": "2-4 per leg",
      "reps": "8-15 per leg",
      "effort": "Stop 2-3 reps short of failure (clinical opinion)",
      "tempo": "1.8-0.3-1.1-1 (down-pause-up-reset, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: shorten the band (hands lower on it) or use a stronger band",
      "progression": "Stronger band, rear foot elevated (Bulgarian split squat), or dumbbells"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Long split stance, right foot forward standing on the middle of the band, left heel up. Hold the band ends in the hands at the sides, arms long, palms in, chest tall."
      },
      {
        "id": "c2",
        "phase": "down",
        "text": "Breathe in and drop straight down until the front knee is about 90 degrees and the back knee is just above the floor."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Brief pause; front heel down, knee in line with the toes."
      },
      {
        "id": "c4",
        "phase": "up",
        "text": "Breathe out and push through the whole front foot to stand up against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, arms long at the sides, then go again. Switch legs after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Front heel lifting",
        "fix": "Lengthen the stance and push through the heel and mid-foot."
      },
      {
        "id": "m2",
        "mistake": "Front knee caving in",
        "fix": "Knee tracks over the second toe."
      },
      {
        "id": "m3",
        "mistake": "Trunk folding forward or shoulders rounding",
        "fix": "Keep the chest tall and the shoulders down and back; arms hang straight."
      },
      {
        "id": "m4",
        "mistake": "Band slipping from under the foot",
        "fix": "Stand on the middle of the band with the whole mid-foot."
      }
    ],
    "kinematics": [
      {
        "measure": "Step length",
        "setup": "80 cm between ankle centres, feet 18 cm apart sideways",
        "peak": "Unchanged",
        "norm": "About one leg length between the feet (Song 2023 compared step lengths)",
        "sources": [
          "song2023"
        ]
      },
      {
        "measure": "Front knee",
        "setup": "≈22°",
        "peak": "≈92°",
        "norm": "About 90 degrees at the bottom (clinical opinion; Song 2023)",
        "sources": [
          "song2023"
        ]
      },
      {
        "measure": "Back knee",
        "setup": "≈33°",
        "peak": "≈94°, 13 cm above the floor (knee joint centre)",
        "norm": "Just above the floor at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈3°",
        "norm": "Upright to slightly forward; a forward trunk shifts work toward the hip extensors (Farrokhi 2008)",
        "sources": [
          "farrokhi2008"
        ]
      },
      {
        "measure": "Hands",
        "setup": "At the sides on long arms, 70 cm high; band under the middle of the front foot",
        "peak": "Still at the sides, 41 cm high",
        "norm": "Band ends held at the sides on long arms, like dumbbells (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s reset",
        "norm": "Controlled descent (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band single leg split squat, video (movement reference)",
        "url": "https://gymvisual.com/videos/14270-band-single-leg-split-squat.html"
      },
      {
        "id": "song2023",
        "title": "Song et al. 2023, effects of step lengths on lower-extremity biomechanics during the split squat (Front Bioeng Biotechnol 11:1277493)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10667687/"
      },
      {
        "id": "farrokhi2008",
        "title": "Farrokhi et al. 2008, trunk position influences lead-leg kinematics, kinetics and muscle activity in the forward lunge (J Orthop Sports Phys Ther 38:403-409)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/18591759/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp knee or hip pain.",
        "Check the band before each set and keep it centred under the foot: a band that slips can snap up toward the face.",
        "Use support (a wall or rack) for balance if needed.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee discomfort: shorter range and a slightly longer stance.",
        "Balance: hold a support with one hand and the band in the other."
      ],
      "regressions": [
        "No band (bodyweight split squat).",
        "Shorter range.",
        "Lighter band."
      ],
      "progressions": [
        "Stronger band.",
        "Rear foot elevated.",
        "Pause at the bottom."
      ]
    },
    "muscleNotes": {
      "quads_r": "Prime mover of the front leg: knee extension from about 90 degrees (Song 2023 split squat data).",
      "glute_max_r": "Extends the front hip; more so with a longer step or a forward trunk (Song 2023; Farrokhi 2008).",
      "adductors_r": "Help extend the front hip and steady the knee (clinical opinion).",
      "quads_l": "The back leg helps push up (clinical opinion).",
      "hamstrings_r": "Help extend the front hip (clinical opinion).",
      "glute_med_r": "Keep the pelvis level and the front knee in line (clinical opinion).",
      "calves_r": "Steady the front foot (clinical opinion).",
      "calves_l": "Hold the back heel up (clinical opinion).",
      "core": "Keep the trunk tall against the band (clinical opinion).",
      "spinal_extensors_r": "Keep the chest tall (clinical opinion).",
      "spinal_extensors_l": "Keep the chest tall (clinical opinion).",
      "forearm_flexors_r": "Grip the band (clinical opinion).",
      "forearm_flexors_l": "Grip the band (clinical opinion).",
      "upper_traps_r": "Hold the shoulders against the band's pull (clinical opinion).",
      "upper_traps_l": "Hold the shoulders against the band's pull (clinical opinion).",
      "hip_flexors_l": "Stretched on the back leg at the bottom (clinical opinion)."
    }
  },
