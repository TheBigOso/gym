      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (lateral deltoid)",
    "secondaryBodyParts": [
      "Upper back (trapezius)"
    ],
    "equipment": [
      "Resistance band",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 0-3 reps short of failure (RIR 0-3)",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen; the band is hardest at the top, where it is stretched most",
      "progression": "More reps, a slower lowering, a stronger band, or the feet wider on the band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench, feet flat and wide with the band under the balls of the feet; one end in each hand beside the bench, palms in, elbows soft."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the arms out to the sides, a little in front of the body, thumbs forward."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at about shoulder height, elbows level with the hands; shoulders down while the band is tightest."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause beside the bench with a little tension left in the band, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rocking the trunk to start the lift",
        "fix": "Sit tall and still; use a lighter band."
      },
      {
        "id": "m2",
        "mistake": "Shrugging toward the ears as the band gets tight",
        "fix": "Reach the hands long and out."
      },
      {
        "id": "m3",
        "mistake": "Raising well above shoulder height",
        "fix": "Stop at about 90 degrees (impingement study 2014)."
      },
      {
        "id": "m4",
        "mistake": "Feet sliding so the band slips off",
        "fix": "Keep the feet flat and pressed down on the band."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "≈23° (hands beside the bench)",
        "peak": "≈88° (elbow 0 cm vs the shoulder joint)",
        "norm": "From beside the bench to about 90 degrees (the range used by Coratella 2020; impingement study 2014)",
        "sources": [
          "coratella2020",
          "impinge2014"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈15° in front of the frontal plane",
        "peak": "≈34°",
        "norm": "About 30 degrees in front of the frontal plane (scapular plane; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈18°",
        "norm": "Elbows soft, about 10-20 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Seat",
        "setup": "bench end, seat 45 cm; trunk ≈5° forward of vertical, knees ≈92°",
        "peak": "unchanged (no rocking)",
        "norm": "Upright on the end of a flat bench, knees about 90 degrees, feet flat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Under the balls of the feet, 44 cm apart; strand 54.6 cm",
        "peak": "Strand 105.5 cm at the top (most stretch, most tension)",
        "norm": "Elastic tension rises as the band stretches, so the load is highest near the top; at matched effort, elastic tubing and dumbbells gave similar deltoid activity in a lateral raise (Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the bottom",
        "peak": "1.8 s up, 0.4 s at the top, 2.0 s down",
        "norm": "2 s up, 0.5 s pause, 2 s down in Coratella 2020",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #16966, Band Seated Lateral Raise, video (movement reference)",
