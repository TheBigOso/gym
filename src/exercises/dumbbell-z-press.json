      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "No study of the Z press itself was found; the muscle roles are inferred from shoulder press EMG and anatomy.",
        "With tight hamstrings the low back rounds; sit on a folded mat or bend the knees a little."
      ],
      "modify": [
        "Tight hamstrings: sit on a folded mat or cross the legs.",
        "Shoulder pain overhead: palms facing in, elbows further forward."
      ],
      "regressions": [
        "Seated dumbbell press with back support.",
        "Half-kneeling press.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Alternating Z press.",
        "Single-arm Z press.",
        "Barbell Z press."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover, as in any overhead press (Campos 2020).",
      "ant_deltoid_l": "Main mover, as in any overhead press (Campos 2020).",
      "lat_deltoid_r": "Lifts the arms up and out (Campos 2020).",
      "lat_deltoid_l": "Lifts the arms up and out (Campos 2020).",
      "triceps_r": "Straightens the elbows in the top half.",
      "triceps_l": "Straightens the elbows in the top half.",
      "upper_traps_r": "Upward rotation and elevation of the shoulder blades overhead.",
      "upper_traps_l": "Upward rotation and elevation of the shoulder blades overhead.",
      "serratus_r": "Upward rotation of the shoulder blades; the press only finishes overhead with full upward rotation.",
      "serratus_l": "Upward rotation of the shoulder blades; the press only finishes overhead with full upward rotation.",
      "core": "Holds the trunk upright with no back support and no leg drive. No EMG study of the Z press was found; standing (unsupported) presses used far more trunk activity than back-supported seated presses (Saeterbakken 2012), and the Z press is assumed to be at least as demanding (clinical opinion).",
      "spinal_extensors_r": "Keep the spine tall over the pelvis; tight hamstrings make this harder (clinical opinion).",
      "spinal_extensors_l": "Keep the spine tall over the pelvis; tight hamstrings make this harder (clinical opinion).",
      "hip_flexors_r": "Hold the trunk upright over the straight legs (clinical opinion).",
      "hip_flexors_l": "Hold the trunk upright over the straight legs (clinical opinion).",
      "obliques_r": "Keep the ribs down and the trunk from leaning.",
      "obliques_l": "Keep the ribs down and the trunk from leaning.",
      "post_deltoid_r": "Steadies the shoulders.",
      "post_deltoid_l": "Steadies the shoulders.",
      "infraspinatus_r": "Rotator cuff: centres the ball of the shoulder.",
      "infraspinatus_l": "Rotator cuff: centres the ball of the shoulder."
    }
