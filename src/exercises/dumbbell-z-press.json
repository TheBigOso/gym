    "breathing": {
      "pattern": "Breathe in and brace at the shoulders, breathe out as you press; breathe in as you lower.",
      "cadence": "About 1.6 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-10",
      "effort": "Stop 2-3 reps short of failure (RIR 2-3)",
      "tempo": "2-0-1.5-0 (down-pause-up-pause, seconds)",
      "rest": "90-120 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; clearly lighter than for the seated press (clinical opinion)",
      "progression": "Add reps, then weight; alternating Z press"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the floor, legs straight and about hip width, toes up. Sit tall over the sit bones. Dumbbells at shoulder height, palms forward."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Brace and breathe out as you press up and slightly in; do not lean back."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms nearly straight overhead, biceps by the ears, ribs down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower in about 2 s to shoulder height, trunk still tall."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Reset the brace and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the low back and slumping",
        "fix": "Sit on a folded mat or bend the knees slightly if the hamstrings are tight."
      },
      {
        "id": "m2",
        "mistake": "Leaning back to finish the press",
        "fix": "Keep the ribs over the pelvis; lighter dumbbells."
      },
      {
        "id": "m3",
        "mistake": "Pressing forward of the head",
        "fix": "Finish with the dumbbells over the shoulders, head through the arms."
      }
    ],
    "kinematics": [
      {
        "measure": "Sitting posture",
        "setup": "hips flexed ≈86° (trunk to thigh), trunk ≈3° from vertical",
        "peak": "unchanged (no lean back)",
        "norm": "Hips flexed about 85-95 degrees with the trunk upright over straight legs; needs hamstring flexibility (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation",
        "setup": "≈80° (upper arm vs trunk)",
        "peak": "≈169°",
        "norm": "From about 80-90 degrees at the bottom to about 160-170 degrees overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈98°, forearm vertical",
        "peak": "≈12° (nearly straight)",
        "norm": "About 90 degrees at the bottom, nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈4°, heels 34 cm apart",
        "peak": "unchanged (legs still)",
        "norm": "Legs straight or nearly straight on the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.8 s at the shoulders",
        "peak": "1.6 s up, 0.4 s at the top, 2.1 s down",
        "norm": "Controlled, about 2 s down and 1-2 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
