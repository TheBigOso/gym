        "obliques_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you chop down across the body, breathe in as you lift back up.",
      "cadence": "About 1 s down, 1.5 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per side",
      "tempo": "1-0-2-0",
      "load": "A light plate (2.5-10 kg) you can control (clinical opinion)",
      "frequency": "2-3 times a week",
      "progression": "Heavier plate, then a slower lift"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall near the front of a sturdy chair, feet flat and wide; hold a plate by its rim in both hands up beside the right shoulder, chest turned to the right."
      },
      {
        "id": "c2",
        "phase": "chop",
        "text": "Breathe out and chop the plate down across the body to the outside of the left knee, turning the chest to the left."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Arms long, chest over the left thigh; hips stay on the seat."
      },
      {
        "id": "c4",
        "phase": "lift",
        "text": "Breathe in and lift the plate back up across the body to the right shoulder."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay tall; repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back hard at the bottom",
        "fix": "Hinge a little from the hips and keep the chest long."
      },
      {
        "id": "m2",
        "mistake": "Lifting the hips off the seat",
        "fix": "Keep both sitting bones down; the turn comes from the trunk."
      },
      {
        "id": "m3",
        "mistake": "Bending the arms a lot",
        "fix": "Keep the arms fairly long so the plate travels a wide arc."
      },
      {
        "id": "m4",
        "mistake": "Throwing the plate",
        "fix": "Control both directions."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk rotation",
        "setup": "Shoulder line turned ≈38° to the right, plate up beside the right shoulder",
        "peak": "≈29° to the left at the bottom; hips square on the seat",
        "norm": "Chest turns about 30-45 degrees to each side of square (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk lean",
        "setup": "≈-5° (tall)",
        "peak": "≈34° forward at the bottom",
        "norm": "Upright at the top, leaning about 20-35 degrees forward at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Plate path",
        "setup": "Plate centre 128 cm high beside the right shoulder; rim grip 31 cm wide (34 cm plate)",
        "peak": "Down to 65 cm outside the left knee",
        "norm": "Diagonal from above the right shoulder to the outside of the left knee (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.6 s set",
        "peak": "1 s down, 0.3 s pause, 1.6 s up",
        "norm": "About 1 s down, 1.5 s up (clinical opinion)",
        "sources": []
