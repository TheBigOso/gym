  "exercise": {
    "id": "barbell-decline-pullover",
    "name": "Barbell Decline Pullover",
    "aliases": [
      "Decline bench barbell pullover",
      "Decline straight-arm pullover"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "005287",
      "title": "Barbell Decline Pullover",
      "url": "https://gymvisual.com/videos/5287-barbell-decline-pullover.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back and chest (lats, chest)",
    "secondaryBodyParts": [
      "Triceps (long head)",
      "Serratus"
    ],
    "equipment": [
      "Decline bench",
      "Barbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (shoulder flexion and extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l",
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "triceps_r",
        "triceps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "core",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "lats_r",
        "lats_l",
        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press or lift.",
      "cadence": "About 2 s down, a short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2 s down, brief pause, 1-1.5 s up",
      "frequency": "2 times a week",
      "progression": "Add load in small steps; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the decline bench, feet hooked under the roller, a barbell held over the chest with straight arms, hands about shoulder width."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the bar in an arc over and past the head, arms nearly straight."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with the upper arms about level with the floor; feel the stretch in the lats and chest."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and pull the bar back over the chest in the same arc."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Bar over the chest; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the elbows a lot (turns into a triceps extension)",
        "fix": "Keep a small fixed elbow bend."
      },
      {
        "id": "m2",
        "mistake": "Going too deep",
        "fix": "Stop with the upper arms about level with the floor."
      },
      {
        "id": "m3",
        "mistake": "Arching the back off the bench",
        "fix": "Keep the ribs down."
      },
      {
        "id": "m4",
        "mistake": "Too heavy a bar",
        "fix": "Start with an empty bar."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder flexion",
        "setup": "Arms ≈15° from vertical over the chest",
        "peak": "≈100° from vertical, past the head (about level with the floor)",
        "norm": "From arms vertical to arms about level with the floor overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow",
        "setup": "≈12°",
        "peak": "≈18°",
        "norm": "Small fixed bend (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Muscles",
        "setup": "Lats and chest lengthen as the bar goes overhead",
        "peak": "Both pull the bar back over the chest",
        "norm": "Pectoralis and latissimus both active in the pullover (Campos 2014)",
        "sources": [
          "campos2014"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #005287, Barbell Decline Pullover, video (movement reference)",
        "url": "https://gymvisual.com/videos/5287-barbell-decline-pullover.html"
      },
      {
        "id": "campos2014",
        "title": "Campos and Silva 2014, comparison of electromyographic activity during the bench press and barbell pullover exercises (Motriz 20(2):200-205)",
        "url": "https://scielo.br/j/motriz/a/jbfGfJrRsXbfc9BrfXgVSPy/?lang=en"
      },
      {
        "id": "washif2016",
        "title": "Washif, Hébert-Losier and Beaven 2016, electromyographic assessment of pullover exercise variations and javelin throw on nine upper-body muscles (poster, 10th International Conference on Strength Training; University of Waikato Research Commons)",
        "url": "https://researchcommons.waikato.ac.nz/handle/10289/13942"
      }
    ],
    "safety": {
      "cautions": [
        "Lying head-down raises pressure in the head; skip the decline with uncontrolled high blood pressure, glaucoma or a recent eye or head problem (clinical opinion), and sit up slowly after the set.",
        "Hook the feet under the roller before taking the weights; hand the weights down or lower them to the floor beside the bench at the end.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Shoulder: the overhead stretch loads the shoulder joint; skip with a history of instability (clinical opinion).",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [],
      "regressions": [
        "Dumbbell pullover on a flat bench."
      ],
      "progressions": [
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "lats": "The pullover works the shoulder extensors; latissimus and pectoralis share the work (Campos 2014; Washif 2016).",
      "pec": "Pectoralis major was very active in the barbell pullover (Campos 2014)."
    }
  },
