    "safety": {
      "cautions": [
        "Stop if sharp pain in the back, shoulder or elbow, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can turn and row smoothly, without jerking the spine.",
        "People with a current back problem should check with a clinician before loaded trunk rotation.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Back discomfort with the turn: do the one-arm row without rotation, chest facing the pulley (clinical opinion).",
        "Shoulder discomfort at the reach: shorten the reach."
      ],
      "regressions": [
        "Lighter load.",
        "One-arm seated cable row without the turn.",
        "Two-arm seated cable row."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Pause 1 s at the finish.",
        "Half-kneeling one-arm cable row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Prime mover: pulls the upper arm back to the side.",
      "rhomboids_midtrap_r": "Prime mover: draws the right shoulder blade back; it slides forward with the reach.",
      "post_deltoid_r": "Helps pull the upper arm back.",
      "biceps_r": "Bends the elbow as the handle comes in.",
      "obliques_r": "Turn the trunk toward the working side and control the turn back.",
      "obliques_l": "Turn the trunk toward the working side and control the turn back.",
      "forearm_flexors_r": "Grip the handle.",
      "spinal_extensors_r": "Hold the spine long and upright.",
      "spinal_extensors_l": "Hold the spine long and upright.",
      "core": "Keeps the pelvis square on the seat while the upper body turns.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug."
    }
