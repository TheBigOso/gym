      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lats and mid-back)",
    "secondaryBodyParts": [
      "Core (obliques)",
      "Shoulders (rear deltoid)",
      "Upper arms (biceps)"
    ],
    "equipment": [
      "Cable machine (low pulley)",
      "D-handle",
      "Box or bench seat",
      "Foot plate"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder extension, scapular retraction, elbow flexion, trunk rotation)",
    "plane": "Multiplanar",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "lats_r",
        "rhomboids_midtrap_r"
      ],
      "synergist": [
        "post_deltoid_r",
        "biceps_r",
        "obliques_r",
        "obliques_l",
        "forearm_flexors_r"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core",
        "upper_traps_r"
      ],
      "lengthened": [
        "lats_r",
        "rhomboids_midtrap_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row and turn the chest toward the working side, breathe in as you reach and turn back.",
      "cadence": "About 1.3 s pull, short squeeze, about 2 s return"
    },
    "prescription": {
      "sets": "2-3 per arm",
      "reps": "8-12",
      "effort": "Stop 2-3 reps short of failure (RIR 2-3, clinical opinion)",
      "tempo": "1.3-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
      "rest": "60-90 s between arms",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen and lighter than for a two-arm row: the turn must stay smooth and controlled.",
      "progression": "Add reps, then a plate; slower turn back"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall facing the low pulley, feet braced on the plate, knees soft; hold the handle in the right hand, arm long, right shoulder reaching forward with the chest turned a little to the left; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out; turn the chest back to the right as you row the handle to the side of the stomach, elbow close to the body."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Elbow behind the trunk, shoulder blade drawn back, chest turned slightly right; sit tall."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in; let the arm reach forward and the right shoulder follow it as the chest turns back to the left, under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief stretch at full reach without rounding the back, then repeat; switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Yanking the turn with momentum",
        "fix": "Lighten the load and turn smoothly with the row."
      },
      {
        "id": "m2",
        "mistake": "Twisting from the lower back and hips",
        "fix": "Keep the hips square on the seat; let the rotation come from the upper back and shoulder blade."
      },
      {
        "id": "m3",
        "mistake": "Rounding forward at the reach",
        "fix": "Reach with the shoulder blade and a long spine, not by slumping."
      },
      {
        "id": "m4",
        "mistake": "Shrugging the working shoulder",
        "fix": "Draw the shoulder blade back and down."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk rotation",
        "setup": "Shoulder line turned ≈35° to the left (right shoulder forward); hips square",
        "peak": "Turned ≈25° to the right (right shoulder back)",
        "norm": "Moderate upper-back rotation, hips square on the seat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk lean",
        "setup": "≈10° forward of upright",
        "peak": "≈-8° (upright)",
        "norm": "From slightly forward at the reach to upright at the finish, neutral spine (clinical opinion); seated or supported rows kept lumbar loads lower than free bent-over rows (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈17° (arm long)",
        "peak": "≈106°",
        "norm": "From nearly straight to about 90-100 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blade",
        "setup": "Protracted, reaching forward",
        "peak": "Retracted",
        "norm": "Protracted at the reach, retracted at the finish; retraction drives the middle trapezius and rhomboids (Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stretch 0.5 s at full reach",
        "peak": "1.3 s pull, 0.4 s squeeze, 2 s return",
        "norm": "Controlled, about 1 s pull and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
