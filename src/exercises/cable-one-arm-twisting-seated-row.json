    "name": "Cable One Arm Twisting Seated Row",
    "aliases": [
      "Single arm twisting seated row",
      "One-arm seated cable row with rotation",
      "Rotational one-arm low row",
      "Twisting cable row"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "4351",
      "title": "Cable one arm twisting seated row",
