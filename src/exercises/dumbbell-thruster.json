    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Clear space around and above you; do not lock out a dumbbell you cannot control overhead."
      ],
      "modify": [
        "Shoulder discomfort overhead: press to the forehead only or switch to a front squat.",
        "Knee pain: squat to a box or a shallower depth."
      ],
      "regressions": [
        "Dumbbell front squat and a separate standing press.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Higher-rep conditioning sets."
      ]
    },
    "muscleNotes": {
      "quads_r": "Drive the squat out of the bottom; the leg drive pops the dumbbells off the shoulders (CrossFit 2019).",
      "quads_l": "Drive the squat out of the bottom; the leg drive pops the dumbbells off the shoulders (CrossFit 2019).",
      "glute_max_r": "Hip extensor out of the bottom of the front squat (clinical opinion).",
      "glute_max_l": "Hip extensor out of the bottom of the front squat (clinical opinion).",
      "ant_deltoid_r": "Presses the dumbbells overhead once the legs have extended (CrossFit 2019).",
      "ant_deltoid_l": "Presses the dumbbells overhead once the legs have extended (CrossFit 2019).",
      "lat_deltoid_r": "Lifts the elbows up and out as the dumbbells pass the head (clinical opinion).",
      "lat_deltoid_l": "Lifts the elbows up and out as the dumbbells pass the head (clinical opinion).",
      "triceps_r": "Straighten the elbows to lock the dumbbells out overhead.",
      "triceps_l": "Straighten the elbows to lock the dumbbells out overhead.",
      "upper_traps_r": "Rotate and lift the shoulder blades so the arms can finish overhead; \"shoulders drive up toward the bar\" (CrossFit 2019).",
      "upper_traps_l": "Rotate and lift the shoulder blades so the arms can finish overhead; \"shoulders drive up toward the bar\" (CrossFit 2019).",
      "serratus_r": "Rotates the shoulder blades upward at lockout (clinical opinion).",
      "serratus_l": "Rotates the shoulder blades upward at lockout (clinical opinion).",
      "adductors_r": "Assist hip extension out of the deep squat (clinical opinion).",
      "adductors_l": "Assist hip extension out of the deep squat (clinical opinion).",
      "hamstrings_r": "Assist hip extension and steady the knee (clinical opinion).",
      "hamstrings_l": "Assist hip extension and steady the knee (clinical opinion).",
      "calves_r": "Finish the leg drive and steady the shins (clinical opinion).",
      "calves_l": "Finish the leg drive and steady the shins (clinical opinion).",
      "core": "Keeps the trunk neutral in the squat and stops the low back arching at lockout (CrossFit 2019).",
      "spinal_extensors_r": "Hold the chest up in the front squat under the front load (Gullett 2009).",
      "spinal_extensors_l": "Hold the chest up in the front squat under the front load (Gullett 2009).",
      "forearm_flexors_r": "Grip the dumbbell handles; the hands stay closed all set (clinical opinion).",
      "forearm_flexors_l": "Grip the dumbbell handles; the hands stay closed all set (clinical opinion)."
    }
