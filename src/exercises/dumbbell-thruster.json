        "norm": "Arms fully extended overhead, the load stacked over the hips and ankles (CrossFit 2019)",
        "sources": [
          "crossfit2019"
        ]
      },
      {
        "measure": "Press timing",
        "setup": "Dumbbells racked through the squat",
        "peak": "Hands leave the shoulders as the knees pass about 20° (0.15 s before full extension); lockout 0.4 s later",
        "norm": "The press starts after the hips and knees have extended (CrossFit 2019)",
        "sources": [
          "crossfit2019"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.6 s",
        "peak": "1.45 s down, 0.15 s bottom, 1.1 s drive and press, 0.4 s lockout, 1.1 s back to the shoulders",
