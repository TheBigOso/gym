    "breathing": {
      "pattern": "Breathe in and brace at the top, squat down; breathe out as you drive up and press; breathe in again as the dumbbells come back to the shoulders.",
      "cadence": "About 1.4 s down, 1 s up and press, about 1 s back to the shoulders"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "6-12",
      "tempo": "Controlled squat, fast drive and press",
      "frequency": "1-3 times a week",
      "progression": "Heavier dumbbells, more reps per set, then timed sets for conditioning. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Dumbbells on the front of the shoulders, palms in, elbows forward. Feet about shoulder width, toes slightly out."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, brace and front squat until the hip crease is just below the knees; heels down."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Chest up, elbows up, knees out over the toes."
      },
      {
        "id": "c4",
        "phase": "drive",
        "text": "Drive the floor away; let the leg drive pop the dumbbells off the shoulders, then press straight up past the face."
      },
      {
        "id": "c5",
        "phase": "lockout",
        "text": "Arms straight overhead, biceps by the ears, ribs down; breathe out."
      },
      {
        "id": "c6",
        "phase": "return",
        "text": "Bring the dumbbells back to the shoulders before the next squat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pressing before the legs have finished driving",
        "fix": "Wait for the hips and knees to extend; the arms take over from the leg drive (CrossFit 2019)."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back at lockout",
        "fix": "Brace the ribs down; finish with the dumbbells over the middle of the feet."
      },
      {
        "id": "m3",
        "mistake": "Starting the next squat with the dumbbells still overhead",
        "fix": "Bring them back to the shoulders first, then squat (CrossFit 2019)."
      },
      {
        "id": "m4",
        "mistake": "Elbows dropping in the bottom",
        "fix": "Keep the elbows forward so the dumbbells stay on the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "39 cm, toes out 15°",
        "peak": "Unchanged",
        "norm": "About shoulder width, toes slightly out (CrossFit 2019)",
        "sources": [
          "crossfit2019"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈1°",
