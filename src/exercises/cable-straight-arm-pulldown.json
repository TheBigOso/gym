        "lats_r",
        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you sweep the bar down to the thighs, breathe in as it rises.",
      "cadence": "About 1.2 s down, short pause, about 2 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.4-2-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can sweep down with straight arms and a still trunk.",
      "progression": "Add reps, then one plate on the stack; 1 s pause at the thighs"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing the high pulley, feet hip width, knees soft, hips back so the trunk leans about 25 degrees forward with a flat back; hold the bar overhand about shoulder width, arms long and raised in front, elbows softly bent."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and sweep the bar down in an arc to the front of the thighs, arms staying straight, shoulders down."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Bar at the thighs, lats tight, chest proud; do not bend the elbows."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the bar rise in the same arc until the arms are about level with the head."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the lats stretched, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the elbows and pushing the bar down like a pushdown",
        "fix": "Keep the soft bend fixed; the movement is only at the shoulders."
      },
      {
        "id": "m2",
        "mistake": "Rocking the trunk up and down",
        "fix": "Hold the hinge still; lighten the load."
      },
      {
        "id": "m3",
        "mistake": "Rounding the back or shrugging at the top",
        "fix": "Keep the back flat and the shoulders away from the ears."
      },
      {
        "id": "m4",
        "mistake": "Letting the bar crash up",
        "fix": "Control the return through the whole arc."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder flexion",
        "setup": "Upper arm ≈136° from the trunk (bar about head height)",
        "peak": "≈23° (bar 2 cm off the thighs)",
        "norm": "From arms about level with the head to the bar at the thighs (clinical opinion); pullover-type shoulder extension exercises load the lats (Teixeira 2022)",
        "sources": [
          "teixeira2022"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12°-12° over the loop",
        "peak": "Unchanged",
        "norm": "Soft and unchanged, about 10-20 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈25° forward lean, knees soft",
        "peak": "Unchanged",
        "norm": "Hinged about 20-30 degrees forward with a flat back, still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Overhand, 44 cm between the hands on a 50 cm bar",
        "peak": "Unchanged (43.88-44.08 cm)",
        "norm": "Overhand about shoulder width (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the arms raised",
        "peak": "1.2 s down, 0.4 s at the thighs, 2 s up",
        "norm": "Controlled, about 1 s down and 2 s up (clinical opinion)",
        "sources": []
      }
    ],
