    "safety": {
      "cautions": [
        "Stop if sharp pain in the shoulder, elbow or back, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can move with straight arms and a still trunk.",
        "Stand far enough back that the bar can rise to head height without pulling you forward.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort at the top: start the arc lower, around shoulder height (clinical opinion).",
        "Back discomfort: stand more upright with less hinge and a lighter load."
      ],
      "regressions": [
        "Lighter load.",
        "Band straight-arm pulldown anchored high.",
        "Kneeling straight-arm pulldown."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Rope straight-arm pulldown.",
        "Dumbbell pullover on a bench."
      ]
    },
    "muscleNotes": {
