    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower. Brace before each rep.",
      "cadence": "About 1 s up, a short squeeze, about 1.8 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "tempo": "About 1 s up, brief pause, 2 s down",
      "frequency": "1-3 times a week",
      "progression": "Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set. Add load in small steps once 12 clean reps are easy."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent about 90 degrees, feet flat. Hold one dumbbell by its top plate in both hands, arms straight overhead, the dumbbell just off the mat."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the head, shoulders and shoulder blades off the mat; the arms and dumbbell travel with the trunk."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Short squeeze at the top; ribs down, low back on the mat, elbows straight."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, shoulder blades first, head last, until the dumbbell hovers over the mat."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest the head briefly, keep the grip firm, and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the dumbbell forward to get up",
        "fix": "Keep the arms locked beside the ears; reduce the load if you need momentum."
      },
      {
        "id": "m2",
        "mistake": "Letting the dumbbell drop to the floor behind the head",
        "fix": "Stop it a few centimetres above the mat and keep tension."
      },
      {
        "id": "m3",
        "mistake": "Low back arching under the load",
        "fix": "Brace and draw the ribs down first; use a lighter dumbbell."
      },
      {
        "id": "m4",
        "mistake": "Bending the elbows into a pullover",
        "fix": "Elbows stay straight; the trunk does the work."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk (T12 to C7) from the floor",
        "setup": "≈-1°",
        "peak": "≈32° (C7 up 18.2 cm)",
        "norm": "Head, shoulders and shoulder blades clear the mat; no study fixes the angle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈-5° (slight lordosis)",
        "peak": "≈-2° (low back stays on the mat)",
        "norm": "Small: about 3 degrees of lumbar flexion in a crunch, cited by Escamilla 2016 from earlier work",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈7° (resting curve)",
        "peak": "≈45° (+37°)",
        "norm": "Most of the curl happens here (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms and dumbbell",
        "setup": "Dumbbell held overhead in both hands; shoulder elevation ≈192°, elbows ≈0°, arms ≈169° off the trunk line",
        "peak": "Unchanged relative to the trunk (hands rise 44.1 cm)",
        "norm": "Straight overhead in line with the trunk; the arm load raises abdominal activity (Crommert 2021)",
        "sources": [
          "crommert2021"
        ]
      },
      {
        "measure": "Hip and knee",
        "setup": "Hip ≈45°, knee ≈90°",
        "peak": "Unchanged (pelvis and feet still)",
        "norm": "Knees about 90 degrees, feet flat; the pelvis and legs do not move (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.0 s up, 0.5 s squeeze, 1.8 s down, 1.1 s rest",
        "norm": "Controlled, about 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
