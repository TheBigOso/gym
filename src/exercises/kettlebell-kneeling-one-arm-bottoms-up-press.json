    "breathing": {
      "pattern": "Breathe in and brace with the bell balanced at the shoulder, breathe out as you press, breathe in as you lower.",
      "cadence": "About 1.4 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "3-6 per arm",
      "effort": "Stop when the bell starts to tip; quality over load",
      "tempo": "2-0-1.5-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s between arms",
      "frequency": "1-2 times a week",
      "load": "User-chosen kettlebell, usually much lighter than for a regular press",
      "progression": "More reps, then a heavier bell; then standing bottoms-up press"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel with the right knee down under the hip and the left foot flat in front. Hold the kettlebell upside down (bell above the fist) by the handle at the right shoulder, forearm vertical, crushing the handle; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press straight up, keeping the forearm vertical and the bell balanced over the fist."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arm nearly straight, biceps by the ear, wrist straight and stacked over the shoulder."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly to the shoulder, still crushing the handle."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Re-balance the bell and brace; switch sides (and knees) after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Loose grip, so the bell flops over",
        "fix": "Crush the handle and keep the wrist straight; use a lighter bell."
      },
      {
        "id": "m2",
        "mistake": "Elbow drifting out to the side",
        "fix": "Keep the forearm vertical under the bell all the way up."
      },
      {
        "id": "m3",
        "mistake": "Leaning away from the bell or arching the low back",
        "fix": "Squeeze the down-leg glute and keep the ribs down."
      },
      {
        "id": "m4",
        "mistake": "Rushing the press",
        "fix": "Move slowly; the balance is the point."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance",
        "setup": "down knee 105°, front knee 90°, down thigh about vertical (hip -4°)",
        "peak": "unchanged",
        "norm": "Half-kneeling: down knee under the hip, front shin about vertical, both knees about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation (humerus)",
        "setup": "≈75°",
        "peak": "≈170°",
        "norm": "Upper arm about level at the bottom to about 160-170 degrees overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈106°",
        "peak": "≈7°",
        "norm": "About 90 degrees or more at the bottom with the forearm vertical under the upside-down bell, nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bell orientation",
        "setup": "Upside down above the fist, forearm 8° off vertical, bell centre 21.5 cm above the wrist",
        "peak": "Upside down over the locked-out arm (forearm 1° off vertical)",
        "norm": "Bell held upside down above the fist the whole rep, the forearm vertical (bottoms-up position; McGill 2012 studied the bottoms-up carry)",
        "sources": [
          "mcgill2012"
        ]
      },
      {
        "measure": "Trunk lean",
        "setup": "vertical",
        "peak": "vertical (held)",
        "norm": "Trunk stays vertical; a unilateral load raises oblique and back-stabilizer activity to resist side bending (Saeterbakken 2012; Trunk 2005)",
        "sources": [
          "saeterbakken2012",
          "trunk2005"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Brace 0.8 s at the shoulder",
        "peak": "1.4 s up, 0.4 s at the top, 2.0 s down",
        "norm": "Controlled, about 1.5 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
