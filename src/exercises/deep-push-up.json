    "id": "deep-push-up",
    "name": "Deep Push-Up",
    "aliases": [
      "Deficit push-up",
      "Raised-hands deep push-up",
      "Box deficit push-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9292",
      "title": "Deep Push-Up",
      "url": "https://gymvisual.com/videos/9292-deep-push-up.html",
