      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Upper Arms",
      "Front of the shoulders",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Two low boxes or push-up blocks"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "lengthened": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you sink between the blocks, exhale as you press up.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-12",
      "tempo": "2-1-1-0",
      "frequency": "2 times a week",
      "progression": "Deeper blocks, slower lowering, then a weighted vest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hands on two low blocks well outside the shoulders, arms straight, body in one line on the balls of the feet."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the chest between the blocks, elbows back at about 45 degrees."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Sink until the chest is below the hands: a stretch across the chest, shoulders still down."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press up through the palms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight at the top; reset and go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping into the bottom",
        "fix": "Lower under control and stop where the shoulders still feel strong."
      },
      {
        "id": "m2",
        "mistake": "Shoulders rolling forward at the bottom",
        "fix": "Keep the chest open and the shoulder blades drawn back."
      },
      {
        "id": "m3",
        "mistake": "Hips sagging",
        "fix": "Brace the abs and squeeze the glutes."
      },
      {
        "id": "m4",
        "mistake": "Blocks too far apart or wobbly",
        "fix": "Use stable blocks just outside shoulder width."
      }
    ],
    "kinematics": [
      {
        "measure": "Hand width",
        "setup": "Wrists 66 cm apart on 15 cm blocks (shoulder joints 40 cm): about 164% of shoulder width",
        "peak": "Unchanged (hands planted)",
        "norm": "Wide (well outside the shoulders), palms on raised blocks so the chest can travel below hand level (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (arms straight, not locked)",
        "peak": "≈146° at the bottom (chest 3 cm below the block tops)",
        "norm": "Arms straight but not locked at the top; elbows bend to about 90 degrees or more at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "≈35° (arms near vertical)",
        "peak": "≈21° at the bottom",
        "norm": "Elbows close to the ribs, about 10-30 degrees from the body at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line",
        "setup": "Trunk ≈29° above horizontal; trunk-to-leg bend -0.0°",
        "peak": "Trunk ≈9°; bend -0.0°",
        "norm": "Head, trunk, hips and ankles (or knees) in one straight line throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Wrist extension",
        "setup": "≈81°",
        "peak": "≈46° at the bottom",
        "norm": "Palms flat; the wrist bends back about 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.0 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up; lab studies used 2-2.5 s per repetition (Marcolin 2015)",
        "sources": [
          "marcolin2015"
        ]
      },
      {
        "measure": "Depth below the hands",
        "setup": "Chest 35 cm above the block tops",
        "peak": "Chest 3 cm below the block tops (12 cm above the floor)",
        "norm": "Chest a few centimetres below the top of the blocks at the bottom; more range than a floor push-up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #9292, Deep Push-Up (movement reference only)",
        "url": "https://gymvisual.com/videos/9292-deep-push-up.html"
      },
      {
        "id": "marcolin2015",
        "title": "Marcolin, Petrone, Moro, Battaglia, Bianco and Paoli 2015, selective activation of shoulder, trunk and arm muscles: a comparative analysis of different push-up variants (J Athl Train 50(11):1126-1132)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26488636/"
      },
      {
        "id": "kim2016",
        "title": "Kim, Kim and Ha 2016, effect of the push-up exercise at different palmar width on muscle activities (J Phys Ther Sci 28(2):446-449; PMC4792988)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4792988/"
      }
    ],
    "safety": {
      "cautions": [
        "Shoulder pain: the extra depth stretches the front of the shoulder; reduce the depth if the front of the shoulder aches (clinical opinion).",
        "Use stable blocks that cannot slide or tip.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: lower blocks or stop at hand level.",
        "Too hard: knees down on the mat."
      ],
      "regressions": [
        "Floor push-up.",
        "Deep push-up on the knees."
      ],
      "progressions": [
        "Higher blocks.",
        "Slow 3 s lowering with a pause.",
        "Weighted vest."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main target, loaded in a long position as the chest sinks below the hands.",
      "pec_l": "Main target, loaded in a long position as the chest sinks below the hands.",
      "triceps_r": "Straightens the elbows; narrow hands raise its share (Kim 2016).",
      "triceps_l": "Straightens the elbows; narrow hands raise its share (Kim 2016).",
      "ant_deltoid_r": "Flexes the shoulder with the chest muscles.",
      "ant_deltoid_l": "Flexes the shoulder with the chest muscles.",
      "serratus_r": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "serratus_l": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "core": "Bracing keeps the hips from sagging or piking.",
      "obliques_r": "Help hold the trunk rigid and level.",
      "obliques_l": "Help hold the trunk rigid and level.",
      "rhomboids_midtrap_r": "Control the shoulder blades as they draw together on the way down.",
      "rhomboids_midtrap_l": "Control the shoulder blades as they draw together on the way down.",
      "infraspinatus_r": "Keeps the head of the upper arm centred as the elbows bend.",
      "infraspinatus_l": "Keeps the head of the upper arm centred as the elbows bend.",
      "glute_max_r": "Squeezed lightly to keep the pelvis in line.",
      "glute_max_l": "Squeezed lightly to keep the pelvis in line.",
      "quads_r": "Keep the knees straight so the legs stay part of the plank.",
      "quads_l": "Keep the knees straight so the legs stay part of the plank.",
      "spinal_extensors_r": "Hold a long, neutral spine and neck.",
      "spinal_extensors_l": "Hold a long, neutral spine and neck."
    }
