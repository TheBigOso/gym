  "exercise": {
    "id": "lever-seated-reverse-fly",
    "name": "Lever Seated Reverse Fly",
    "aliases": [
      "Rear delt machine fly",
      "Reverse pec deck",
      "Machine rear delt fly"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5074",
      "title": "Lever Seated Reverse Fly",
      "url": "https://gymvisual.com/videos/5074-lever-seated-reverse-fly.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (gymvisual.com refused the request), so the data sheet was not read and the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders",
    "secondaryBodyParts": [
      "Upper back (rhomboids, middle trapezius)"
    ],
    "equipment": [
      "Reverse fly / pec deck machine (chest pad, two lever arms with handles swinging about overhead axles)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (horizontal shoulder abduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe out as the arms open, breathe in as they come back together.",
      "cadence": "About 1.3 s out, short squeeze, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "45-75 s",
      "frequency": "1-2 times a week",
      "tempo": "1.3-0.5-2-0.5 (out-squeeze-in-pause, seconds)",
      "load": "Stack load is user-chosen: light loads; open without arching off the chest pad.",
      "progression": "Add reps, then one plate on the stack; slower opening"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit facing the machine with the chest on the pad and the feet flat; hold the handles in front at shoulder height, arms long with a soft elbow."
      },
      {
        "id": "c2",
        "phase": "close",
        "text": "Breathe out and sweep the arms out and back in a wide arc, leading with the back of the arms."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the shoulder blades together with the arms in line with the trunk."
      },
      {
        "id": "c4",
        "phase": "open",
        "text": "Breathe in and bring the handles back together in front under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Let the shoulder blades spread slightly at the front without losing the chest pad."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Chest leaving the pad",
        "fix": "Keep the chest on the pad; lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Shrugging",
        "fix": "Keep the shoulders down from the ears."
      },
      {
        "id": "m3",
        "mistake": "Bending the elbows to cheat",
        "fix": "Keep the soft elbow bend fixed."
      },
      {
        "id": "m4",
        "mistake": "Swinging past the trunk line",
        "fix": "Stop with the arms in line with the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Horizontal abduction",
        "setup": "Shoulder plane ≈98°, hands 12.5 cm apart in front",
        "peak": "Shoulder plane ≈-8°, arms in line with the shoulders",
        "norm": "From the arms in front to the arms out in line with the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow",
        "setup": "≈12° (soft bend)",
        "peak": "Unchanged",
        "norm": "Held softly bent, about 10-20 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation",
        "setup": "≈90°",
        "peak": "Unchanged",
        "norm": "Arms about level with the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lever",
        "setup": "Axles over the shoulders (-4.2, ±20.2 cm); chest pad in front",
        "peak": "Arms turn 106.1°; handles within 0.07 cm of the hands",
        "norm": "Each handle swings about a vertical axle lined up over the shoulder joint (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Rear deltoid EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Hand position changes posterior shoulder activity in rear fly variations (Schoenfeld 2013); posterior deltoid works hardest in horizontal abduction (Franke 2015)",
        "sources": [
          "schoenfeld2013",
          "franke2015"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the arms in front",
        "peak": "1.3 s out, 0.5 s squeeze, 2 s back",
        "norm": "About 1.3 s out and 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #5074, Lever Seated Reverse Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/5074-lever-seated-reverse-fly.html"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "franke2015",
        "title": "de Azevedo Franke, Botton, Rodrigues, Pinto and Lima 2015, analysis of anterior, middle and posterior deltoid activation during single and multijoint exercises (J Sports Med Phys Fitness 55(7-8):714-721)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/24947920/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Stack load is user-chosen: rear deltoid work needs only light loads.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorten the opening so the arms stop just in front of the trunk line."
      ],
      "regressions": [
        "Lighter stack.",
        "Band pull-apart."
      ],
      "progressions": [
        "Heavier stack.",
        "Pause 2 s at the open position."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover: draws the arm back in the horizontal plane (Franke 2015).",
      "post_deltoid_l": "Prime mover: draws the arm back in the horizontal plane (Franke 2015).",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together.",
      "infraspinatus_r": "Helps draw the arm back and steadies the shoulder.",
      "infraspinatus_l": "Helps draw the arm back and steadies the shoulder.",
      "lat_deltoid_r": "Helps hold the arm up and back.",
      "lat_deltoid_l": "Helps hold the arm up and back.",
      "forearm_flexors_r": "Grip the handles.",
      "forearm_flexors_l": "Grip the handles.",
      "spinal_extensors_r": "Keep the chest tall on the pad.",
      "spinal_extensors_l": "Keep the chest tall on the pad.",
      "core": "Keeps the trunk still."
    }
