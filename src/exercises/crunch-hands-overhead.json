  "exercise": {
    "id": "crunch-hands-overhead",
    "name": "Crunch (Hands Overhead)",
    "aliases": [
      "Overhead-reach crunch",
      "Long-lever crunch",
      "Arms-overhead curl-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "026712",
      "title": "Crunch (hands overhead)",
      "url": "https://gymvisual.com/videos/11188-crunch-hands-overhead.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (spinal flexion, mostly thoracic; long lever)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "lats_r",
        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower. Do not hold the breath at the top.",
      "cadence": "About 1 s up, a short squeeze, about 1.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-15",
      "tempo": "About 1 s up, brief pause, 1.5-2 s down",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering and a 2 s hold, then a light dumbbell held overhead"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent about 90 degrees, feet flat. Reach the arms straight overhead, biceps beside the ears, hands close together."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the head, shoulders and shoulder blades off the mat; the arms travel with the trunk, not ahead of it."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Short squeeze at the top. Low back stays on the mat, ribs pulled down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, shoulder blades first, head last; arms stay beside the ears."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest the head briefly and repeat without swinging the arms."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the arms forward to throw the trunk up",
        "fix": "Keep the arms locked in line with the upper trunk; let the abs do the lift."
      },
      {
        "id": "m2",
        "mistake": "Ribs flaring and the low back arching at the start",
        "fix": "Exhale and draw the ribs down before you curl; bend the elbows if the shoulders are tight."
      },
      {
        "id": "m3",
        "mistake": "Chin jammed to the chest",
        "fix": "Look up toward the ceiling just ahead of the knees."
      },
      {
        "id": "m4",
        "mistake": "Sitting all the way up",
        "fix": "Stop once the shoulder blades clear the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk (T12 to C7) from the floor",
        "setup": "≈0°",
        "peak": "≈32° (C7 up 18.2 cm)",
        "norm": "Head, shoulders and shoulder blades clear the mat; no study fixes the angle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈-6° (slight lordosis)",
        "peak": "≈-4° (low back stays on the mat)",
        "norm": "Small: about 3 degrees of lumbar flexion in a crunch, cited by Escamilla 2016 from earlier work",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈-7° (resting curve)",
        "peak": "≈30° (+38°)",
        "norm": "Most of the curl happens here (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Shoulder elevation ≈194°, elbows ≈0°, arms ≈170° off the trunk line",
        "peak": "Unchanged relative to the trunk (hands rise 38.8 cm)",
        "norm": "Straight overhead in line with the trunk: the longest arm lever, which raised abdominal activity (Crommert 2021)",
        "sources": [
          "crommert2021"
        ]
      },
      {
        "measure": "Hip and knee",
        "setup": "Hip ≈67°, knee ≈90°",
        "peak": "Unchanged (pelvis and feet still)",
        "norm": "Knees about 90 degrees, feet flat; the pelvis and legs do not move (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.0 s up, 0.5 s squeeze, 1.6 s down, 1.1 s rest",
        "norm": "Controlled, about 1 s up and 1.5-2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #026712, Crunch (hands overhead), video (movement reference)",
