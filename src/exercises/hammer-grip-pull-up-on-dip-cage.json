    "breathing": {
      "pattern": "Exhale as you pull up, inhale as you lower.",
      "cadence": "About 1 s up, brief hold, 2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "4-10",
      "tempo": "1 s up, brief hold, 2 s down",
      "frequency": "2 times a week",
      "progression": "Band or machine assistance, then body weight, then added load"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hang from the parallel handles, palms facing each other, arms straight, knees slightly bent."
      },
      {
        "id": "c2",
        "phase": "set",
        "text": "Pull the shoulder blades down before bending the arms."
      },
      {
        "id": "c3",
        "phase": "pull",
        "text": "Breathe out and drive the elbows down past the ribs until the chin rises above the handles."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Pause with the chest up and the head between the bars."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Lower under control to a full hang."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Settle in the hang without swinging; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Kipping or swinging the legs",
        "fix": "Keep the legs still and pull with the arms and back."
      },
      {
        "id": "m2",
        "mistake": "Half reps",
        "fix": "Start from straight arms and finish with the chin above the handles."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the top",
        "fix": "Keep the shoulders down and back."
      },
      {
        "id": "m4",
        "mistake": "Craning the chin up",
        "fix": "Lift the chest, not just the chin."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈9° in the dead hang",
        "peak": "≈140° at the top",
        "norm": "Nearly straight in the hang to well over 90 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip width",
        "setup": "Neutral handles 52 cm apart (shoulder joints 39 cm), palms facing each other",
        "peak": "Unchanged (hands planted on the bars)",
        "norm": "Neutral handles about shoulder width (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Chin height",
        "setup": "Chin 52 cm below the bars in the hang",
        "peak": "Chin 2.3 cm above the bars at the top (face between them); body rises 51 cm",
        "norm": "Chin clears the handles at the top (common standard for a full rep)",
        "sources": []
      },
      {
        "measure": "Shoulder blades",
        "setup": "Elevated (26) in the hang",
        "peak": "Depressed and retracted (elevate -10, protract -16) at the top",
        "norm": "Elevated in the hang, depressed and retracted as the body rises (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #009056, Hammer Grip Pull-up on Dip Cage, video (movement reference)",
