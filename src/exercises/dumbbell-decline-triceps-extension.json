    "id": "dumbbell-decline-triceps-extension",
    "name": "Dumbbell Decline Triceps Extension",
    "aliases": [
      "Decline dumbbell skull crusher",
      "Decline lying triceps extension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "000962",
      "title": "Dumbbell Decline Triceps Extension",
      "url": "https://gymvisual.com/videos/962-dumbbell-decline-triceps-extension.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper arms (triceps)",
    "secondaryBodyParts": [],
    "equipment": [
      "Decline bench",
      "Dumbbells"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (elbow extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ],
      "lengthened": [
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press or lift.",
      "cadence": "About 2 s down, a short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2 s down, brief pause, 1-1.5 s up",
      "frequency": "2 times a week",
      "progression": "Add load in small steps; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the decline bench, feet hooked under the roller, dumbbells straight up over the shoulders, palms facing each other."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend only the elbows, lowering the dumbbells beside the head; upper arms stay still."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with the dumbbells beside the ears."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbows back to the top."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight, not locked; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows pointing at the feet."
      },
      {
        "id": "m2",
        "mistake": "Upper arms swinging back and forth",
        "fix": "Only the forearms move."
      },
      {
        "id": "m3",
        "mistake": "Dropping the dumbbells to the head",
        "fix": "Lower in 2 s and stop beside the ears."
      },
      {
        "id": "m4",
        "mistake": "Locking out hard",
        "fix": "Stop just short of lockout."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈9° (arms straight up)",
        "peak": "≈108° with the dumbbells beside the head",
        "norm": "From nearly straight to about 100-120 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm",
        "setup": "≈8° from vertical",
        "peak": "≈8° from vertical (elbows pinned)",
        "norm": "Upper arms stay about vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Triceps heads",
        "setup": "All three heads lengthen as the elbows bend",
        "peak": "Shortening to straight arms",
        "norm": "Each head contributes to elbow extension (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #000962, Dumbbell Decline Triceps Extension, video (movement reference)",
        "url": "https://gymvisual.com/videos/962-dumbbell-decline-triceps-extension.html"
      },
      {
        "id": "kholinne2018",
        "title": "The different role of each head of the triceps brachii muscle in elbow extension (Acta Orthop Traumatol Turc 2018;52(3):201-205; PubMed 29503079; EMG plus OpenSim at 0-180 degrees of shoulder elevation)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29503079/"
      },
      {
        "id": "boehler2011",
        "title": "Boehler 2011, electromyographic analysis of the triceps brachii muscle during a variety of triceps exercises (MS thesis, University of Wisconsin-La Crosse)",
        "url": "https://minds.wisc.edu/items/4876923b-3a14-47c3-9a69-decf731bd027"
      }
    ],
    "safety": {
      "cautions": [
        "Lying head-down raises pressure in the head; skip the decline with uncontrolled high blood pressure, glaucoma or a recent eye or head problem (clinical opinion), and sit up slowly after the set.",
        "Hook the feet under the roller before taking the weights; hand the weights down or lower them to the floor beside the bench at the end.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Elbow pain: lighter load and a smaller range.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [],
      "regressions": [
        "Flat lying triceps extension."
      ],
      "progressions": [
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "triceps": "All three heads extend the elbow; with the upper arm vertical the long head works at a medium length (clinical opinion; Kholinne 2018 on the heads)."
    }
  },
