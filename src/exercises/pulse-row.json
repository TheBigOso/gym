  "exercise": {
    "id": "pulse-row",
    "name": "Pulse Row",
    "aliases": [
      "Bodyweight pulse row",
      "Bent-over pulse row",
      "Pulsing row (no weight)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9008",
      "title": "Pulse Row",
      "url": "https://gymvisual.com/videos/9008-pulse-row-male.html",
      "listing": "Video (movement reference only; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (mid-back, lats)",
    "secondaryBodyParts": [
      "Shoulders (rear delts)",
      "Arms (biceps)",
      "Low back (holding the hinge)"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder extension, scapular retraction, elbow flexion) with small pulses at the top",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "lats_r",
        "lats_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "biceps_r",
        "biceps_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "hamstrings_r",
        "hamstrings_l",
        "glute_max_r",
        "glute_max_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull back, keep breathing in short breaths through the pulses, breathe in as you lower.",
      "cadence": "About 1 s up, three small pulses, 1.6 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 (each with 3 pulses)",
      "tempo": "1 s pull, three 0.6 s pulses, 1.6 s lower",
      "load": "Body weight (arms only); add light dumbbells or a band to progress",
      "frequency": "2-4 times a week (also as a warm-up)",
      "progression": "More pulses per rep, longer holds, then dumbbell rows"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet about hip width, knees slightly bent, hinge forward with a flat back; arms hang toward the floor."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Pull the elbows back toward the hips, close to the body, and squeeze the shoulder blades together."
      },
      {
        "id": "c3",
        "phase": "pulse",
        "text": "At the top, pulse: let the elbows forward a few cm and pull them back again, three times, squeezing each time."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the arms under control back to the hang."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the hinge, breathe, and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back",
        "fix": "Keep the chest long and the back flat; hinge a little less if needed."
      },
      {
        "id": "m2",
        "mistake": "Shrugging toward the ears",
        "fix": "Keep the shoulders down while you squeeze."
      },
      {
        "id": "m3",
        "mistake": "Pulses too big or too fast",
        "fix": "Small, controlled pulses with a squeeze at the back each time."
      },
      {
        "id": "m4",
        "mistake": "Elbows flaring wide",
        "fix": "Keep the elbows close to the ribs."
      },
      {
        "id": "m5",
        "mistake": "Standing up during the set",
        "fix": "Hold the hinge angle the whole set."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk angle",
        "setup": "≈43° above horizontal (hip channel 78°), spine neutral",
        "peak": "Unchanged (held)",
        "norm": "Hinged forward with a neutral spine (common coaching standard; bent-over rowing trunk loading in Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈20°",
        "peak": "Unchanged",
        "norm": "Slightly bent (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈10°",
        "peak": "≈86° at the top, shoulder blades retracted (clavicle protraction 6° to -16°)",
        "norm": "Arms straight at the bottom, elbows well bent beside the ribs at the top (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Pulses",
        "setup": "Row to the top first",
        "peak": "Three pulses between ≈76° and ≈86° of elbow flexion",
        "norm": "Three small partial reps at the top (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1 s up, three 0.6 s pulses, 1.6 s down, 0.6 s reset",
        "norm": "Controlled, no momentum (common coaching standard)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 9008, Pulse Row, video (movement reference)",
        "url": "https://gymvisual.com/videos/9008-pulse-row-male.html"
      },
      {
        "id": "fenwick2009",
        "title": "Fenwick, Brown & McGill 2009, comparison of different rowing exercises: trunk muscle activation and lumbar spine motion, load and stiffness (J Strength Cond Res 23(2):350-358)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19197209/"
      },
      {
        "id": "oyama2010",
        "title": "Oyama, Myers, Wassinger and Lephart 2010, three-dimensional scapular and clavicular kinematics and scapular muscle activity during retraction exercises (J Orthop Sports Phys Ther 40(3):169-179)",
        "url": "https://chs.uky.edu/sites/default/files/2023-12/Oyama_2010_Three-Dimensional%20Scapular%20and%20Clavicular%20Kinematics.pdf"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The bent-over position loads the low back even without weights: keep the back flat and rest if it tires."
      ],
      "modify": [
        "Low-back discomfort: stand more upright or do it lying face down on a bench.",
        "Hamstring tightness: bend the knees more."
      ],
      "regressions": [
        "Standing band row.",
        "Seated scapula adduction."
      ],
      "progressions": [
        "Hold light dumbbells.",
        "More pulses or a 3 s hold at the top.",
        "Dumbbell bent-over row."
      ]
    },
    "muscleNotes": {
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together at the top and on every pulse.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together at the top and on every pulse.",
      "lats_r": "Pull the elbows back toward the hips.",
      "lats_l": "Pull the elbows back toward the hips.",
      "post_deltoid_r": "Helps take the upper arms back.",
      "post_deltoid_l": "Helps take the upper arms back.",
      "biceps_r": "Bends the elbows.",
      "biceps_l": "Bends the elbows.",
      "infraspinatus_r": "Steadies the shoulder.",
      "infraspinatus_l": "Steadies the shoulder.",
      "spinal_extensors_r": "Hold the flat back in the hinge for the whole set.",
      "spinal_extensors_l": "Hold the flat back in the hinge for the whole set.",
      "hamstrings_r": "Hold the hinge at the hips with the knees soft.",
      "hamstrings_l": "Hold the hinge at the hips with the knees soft.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Keeps the trunk still.",
      "forearm_flexors_r": "Light fists.",
      "forearm_flexors_l": "Light fists."
    }
