    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain, disc problems or flexion intolerance: start with a McGill-style curl-up, dead bug or plank; partial curl-ups gave the best abdominal challenge for the least spine compression in one model study (Axler and McGill 1997).",
        "Combined flexion and twisting under fatigue is a common trigger of back pain; keep the reps controlled and stop the set when form slips (clinical opinion).",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion work.",
        "Osteoporosis or vertebral fracture: avoid repeated loaded spinal flexion and twisting.",
        "The athlete mesh rests on the mat; the rig collision shapes are thicker than the mesh at the back and buttocks, so floorTolerance records how far those proxy shapes sink below the mat surface."
      ],
      "modify": [
        "Neck pain: cross the arms on the chest and turn the chest.",
        "Smaller twist and range."
      ],
      "regressions": [
        "Keep both legs on the mat and reach to the opposite knee.",
        "Twisting crunch with the feet flat."
      ],
      "progressions": [
        "Straight-leg starfish crunch.",
        "Slower lowering with a 2 s touch.",
        "V-up."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the trunk up to the reach (about 56% MVC in a cross curl-up, Konrad 2001).",
      "obliques_r": "External oblique on the reaching side and internal oblique on the other side turn the trunk toward the knee (Konrad 2001; Crommert 2021).",
      "obliques_l": "External oblique on the reaching side and internal oblique on the other side turn the trunk toward the knee (Konrad 2001; Crommert 2021).",
      "hip_flexors_l": "Draw the knee in on the first side (clinical opinion).",
      "hip_flexors_r": "Draw the knee in on the second side (clinical opinion).",
      "serratus_r": "Reaches the shoulder blade forward with the hand (clinical opinion).",
      "serratus_l": "Reaches the shoulder blade forward with the hand (clinical opinion).",
      "quads_r": "Keep the resting leg long (clinical opinion).",
      "quads_l": "Keep the resting leg long (clinical opinion)."
    }
  },
