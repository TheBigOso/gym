      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, obliques)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (spinal flexion with rotation)",
    "plane": "Multiplanar",
    "laterality": "Bilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "hip_flexors_l",
        "hip_flexors_r",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl and turn, inhale as you lower.",
      "cadence": "About 1 s up and turn, a short squeeze, about 1.4 s down, then switch sides"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-10 per side",
      "tempo": "About 1 s up and reach, brief touch, 1.5 s down",
      "frequency": "2-3 times a week",
      "progression": "Lift the leg straight to meet the hand (full starfish crunch), then both arms and legs together"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie in a star: legs straight and apart, arms overhead in a wide V, all resting on the mat."
      },
      {
        "id": "c2",
        "phase": "reachA",
        "text": "Breathe out, curl up and turn, reaching the right hand across to the left shin as the left knee bends in."
      },
      {
        "id": "c3",
        "phase": "lowerA",
        "text": "Breathe in and lower back to the star, arm and leg long again."
      },
      {
        "id": "c4",
        "phase": "reachB",
        "text": "Repeat to the other side: left hand to the right shin."
      },
      {
        "id": "c5",
        "phase": "lowerB",
        "text": "Lower with control and keep alternating."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the arm to reach",
        "fix": "Curl and turn the trunk first; the arm follows."
      },
      {
        "id": "m2",
        "mistake": "Pulling the knee all the way to the chest to meet the hand",
        "fix": "Draw the knee in only part way; make the trunk do the work."
      },
      {
        "id": "m3",
        "mistake": "Low back arching as the leg returns",
        "fix": "Brace and lower the leg slowly."
      },
      {
        "id": "m4",
        "mistake": "Neck cranking forward",
        "fix": "Look toward the knee, chin slightly tucked."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk (T12 to C7) from the floor",
        "setup": "≈-1°",
        "peak": "≈31° (C7 up 17.9 cm)",
        "norm": "Shoulder blades clear the mat as in a crunch (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk rotation",
        "setup": "Facing the ceiling",
        "peak": "≈31° toward the drawn-in knee (mostly thoracic)",
        "norm": "Upper trunk turns toward the opposite knee; twisting curl-ups raise external oblique activity (Konrad 2001)",
        "sources": [
          "konrad2001"
        ]
      },
      {
        "measure": "Legs",
        "setup": "Legs straight, ≈18° apart each side, on the mat",
        "peak": "Drawn-in leg: hip ≈74°, knee ≈86°; other leg still on the mat",
        "norm": "Beginner: the knee bends and draws in (the advanced form lifts the straight leg) (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Arms overhead in a wide V (hands 95 cm apart) on the mat",
        "peak": "Reaching hand 0.1 cm from the front of the opposite shin; other arm stays on the mat",
        "norm": "One hand reaches across to the opposite shin; the other rests overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Star 0.5 s",
        "peak": "1.0 s up and reach, 0.4 s touch, 1.4 s back to the star per side; 6.7 s loop",
        "norm": "Controlled, a short pause at the reach (clinical opinion)",
        "sources": []
      }
    ],
