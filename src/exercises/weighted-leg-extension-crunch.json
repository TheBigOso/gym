    "id": "weighted-leg-extension-crunch",
    "name": "Weighted Leg Extension Crunch",
    "aliases": [
      "Seated dumbbell knee tuck",
      "Weighted seated in-and-out",
      "Dumbbell tuck crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "985",
      "title": "Weighted Leg Extension Crunch",
      "url": "https://gymvisual.com/videos/985-weighted-leg-extension-crunch.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (rectus abdominis)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Obliques"
    ],
    "equipment": [
      "Dumbbell (between the feet)",
      "Mat"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip and trunk flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "triceps_r",
        "triceps_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "lengthened": [
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the knees come in, inhale as the legs extend.",
      "cadence": "About 1.2 s in, 0.5 s hold, 1.8 s out"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Heavier dumbbell, then hands off the floor"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit leaning back on your hands, dumbbell squeezed upright between the feet, legs extended off the floor."
      },
      {
        "id": "c2",
        "phase": "in",
        "text": "Breathe out, pull the knees to the chest and curl the trunk up to meet them."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the abs; keep the feet off the floor."
      },
      {
        "id": "c4",
        "phase": "out",
        "text": "Breathe in, push the legs back out and lean back with control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Hold the legs long just off the floor; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the feet touch down",
        "fix": "Keep the legs hovering; make the range smaller if needed."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back as the legs go out",
        "fix": "Keep the ribs down; stop the legs higher."
      },
      {
        "id": "m3",
        "mistake": "Losing the dumbbell",
        "fix": "Squeeze the handle with the feet flexed; use a light one."
      },
      {
        "id": "m4",
        "mistake": "Rocking with momentum",
        "fix": "Pause in and out."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈48° (legs out)",
        "peak": "≈116° (knees in)",
        "norm": "From about 45 degrees (legs out) to 110-130 degrees (knees in) (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈8°",
        "peak": "≈100°",
        "norm": "From near straight to about 120 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Leaned back ≈57° from vertical",
        "peak": "≈29°, spine curled",
        "norm": "Leaned back about 45-55 degrees, curls up as the knees come in (Escamilla 2006)",
        "sources": [
          "escamilla2006"
        ]
      },
      {
        "measure": "Dumbbell",
        "setup": "Upright between the feet, lowest 5 cm off the floor",
        "peak": "Rides with the feet",
        "norm": "Upright between the feet (standard technique)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.2 s in, 0.5 s hold, 1.8 s out",
        "norm": "Controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
