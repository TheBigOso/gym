      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a light dumbbell you can grip securely with the feet; clear the area in case it slips.",
        "Low-back pain: keep the legs higher."
      ],
      "modify": [
        "No dumbbell until the movement is smooth."
      ],
      "regressions": [
        "Seated knee tuck without weight."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Hands lifted off the floor."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the pelvis and trunk together (Escamilla 2006).",
      "hip_flexors_r": "Draw the weighted legs in and hold them off the floor (Escamilla 2006).",
      "hip_flexors_l": "Draw the weighted legs in and hold them off the floor (Escamilla 2006).",
      "obliques_r": "Assist trunk flexion (clinical opinion).",
      "obliques_l": "Assist trunk flexion (clinical opinion).",
      "quads_r": "Straighten the knees on the way out (clinical opinion).",
      "quads_l": "Straighten the knees on the way out (clinical opinion).",
      "triceps_r": "Prop the trunk on the hands (clinical opinion).",
      "triceps_l": "Prop the trunk on the hands (clinical opinion).",
      "post_deltoid_r": "Hold the arms behind the body (clinical opinion).",
      "post_deltoid_l": "Hold the arms behind the body (clinical opinion).",
      "spinal_extensors_r": "Lengthen as the trunk curls (clinical opinion).",
      "spinal_extensors_l": "Lengthen as the trunk curls (clinical opinion)."
    }
