  "exercise": {
    "id": "leg-raise-dragon-flag",
    "name": "Leg Raise Dragon Flag",
    "aliases": [
      "Dragon flag (from a leg raise)",
      "Bench leg raise to dragon flag",
      "Dragon flag negative"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14480",
      "title": "Leg Raise Dragon Flag",
      "url": "https://gymvisual.com/videos/14480-leg-raise-dragon-flag.html",
      "listing": "Video (movement reference; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hips (hip flexors)",
      "Back (lats)",
      "Forearms (grip)"
    ],
    "equipment": [
      "Bench (flat)"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (leg raise rolling onto the upper back, then a rigid-body lowering from the shoulders)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "triceps_r",
        "triceps_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out on the raise, brace (short hold) at the top, breathe out slowly through the lowering.",
      "cadence": "About 2 s up, brief brace, 2.5 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "3-6",
      "tempo": "About 2 s up, 0.5 s brace, 2.5-3 s lowering",
      "load": "Body weight",
      "frequency": "1-2 times a week",
      "progression": "Slower lowering, longer pauses part way down, then full dragon flags"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the bench, head near one end, and grip the bench behind your head."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Raise the straight legs to vertical, then keep going: roll the hips and low back up off the bench onto the upper back."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "At the top, squeeze the glutes and lock the body straight from the shoulders to the toes."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the whole body as one rigid line, slowly, pivoting on the upper back."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Bring the hips down to the bench and the legs back to the start."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending at the hips on the way down",
        "fix": "Squeeze the glutes and keep one straight line; bend the knees to shorten the lever if needed."
      },
      {
        "id": "m2",
        "mistake": "Resting the neck on the bench",
        "fix": "The upper back and shoulders carry the load; keep the neck relaxed."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back",
        "fix": "Keep the ribs down and the pelvis tucked."
      },
      {
        "id": "m4",
        "mistake": "Dropping the last part",
        "fix": "Stop where you can still control the line."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈12° (legs just above level)",
        "peak": "≈88°-92° (legs vertical, rolling up), then ≈9° in the line",
        "norm": "Legs to about vertical (about 90 degrees), then the hips open toward a straight line as the pelvis rises (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line at the top",
        "setup": "Lying on the bench",
        "peak": "Shoulder-to-ankle line 68° above the bench",
        "norm": "Shoulders to toes close to straight, steep above the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis lift",
        "setup": "Buttocks on the bench",
        "peak": "Pelvis 39 cm above the bench; upper back stays on it (pivot within 0.3 cm)",
        "norm": "Pelvis and low back well off the bench; the upper back is the pivot (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lowering",
        "setup": "From 68°",
        "peak": "Rigid line down to 24° above the bench, then the hips land",
        "norm": "Rigid body lowered slowly; long-lever trunk work loads the spine heavily (Axler and McGill 1997)",
        "sources": [
          "axler1997"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Lie 0.5 s",
        "peak": "2.1 s up and over, 0.4 s brace, 2.6 s lowering, 0.8 s down",
        "norm": "About 2 s up and 2.5-3 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
