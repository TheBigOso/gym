    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Advanced: build up with lying leg raises, reverse crunches and hollow holds first.",
        "Low back pain: avoid; the long lever loads the spine heavily (Axler and McGill 1997).",
        "Neck pain: stop; the weight should rest on the upper back and shoulders, not the neck.",
        "Use a stable bench that will not tip."
      ],
      "modify": [
        "Bend the knees (tuck dragon flag).",
        "Lower only part way."
      ],
      "regressions": [
        "Lying leg raise.",
        "Reverse crunch.",
        "Hollow hold."
      ],
      "progressions": [
        "Full dragon flag with pauses.",
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis and transversus keep the body in one rigid line as it lowers; the main load of the lift.",
      "hip_flexors_r": "Lift the legs to vertical and help hold the line.",
      "hip_flexors_l": "Lift the legs to vertical and help hold the line.",
      "obliques_r": "Brace the trunk and keep it from twisting.",
      "obliques_l": "Brace the trunk and keep it from twisting.",
      "glute_max_r": "Keep the hips open (no pike) in the rigid line.",
      "glute_max_l": "Keep the hips open (no pike) in the rigid line.",
      "quads_r": "Keep the knees straight.",
      "quads_l": "Keep the knees straight.",
      "lats_r": "Pull on the bench behind the head and anchor the upper back.",
      "lats_l": "Pull on the bench behind the head and anchor the upper back.",
      "forearm_flexors_r": "Grip the bench.",
      "forearm_flexors_l": "Grip the bench.",
      "triceps_r": "Long head helps pull the arms down against the bench.",
      "triceps_l": "Long head helps pull the arms down against the bench.",
      "post_deltoid_r": "Help pull the arms down against the bench.",
      "post_deltoid_l": "Help pull the arms down against the bench."
