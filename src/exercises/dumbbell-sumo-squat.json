    "breathing": {
      "pattern": "Breathe in and brace at the top, lower; breathe out as you stand.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbell, a pause at the bottom, then stand on two low steps for more depth. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet well wider than the shoulders, toes turned out. Hold one dumbbell upright by the top plate, arms long, so it hangs between the legs."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, brace and sit straight down between the heels; push the knees out over the toes."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs about parallel, chest tall, dumbbell hanging straight down clear of the floor."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive through the whole foot and squeeze the glutes to stand; breathe out."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, reset, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Knees caving in toward each other",
        "fix": "Push the knees out so they track over the turned-out toes."
      },
      {
        "id": "m2",
        "mistake": "Toes pointing forward in a very wide stance",
        "fix": "Turn the toes out about 30-45 degrees to match the knees (Lorenzetti 2018)."
      },
      {
        "id": "m3",
        "mistake": "Leaning far forward and letting the dumbbell swing",
        "fix": "Stay tall; the dumbbell hangs straight below the shoulders."
      },
      {
        "id": "m4",
        "mistake": "Dumbbell hitting the floor at the bottom",
        "fix": "Stop at thighs parallel or stand on two low steps."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "60 cm (≈1.5x the rig's 40 cm shoulder width)",
        "peak": "Unchanged",
        "norm": "About 1.4-2x shoulder width; 140% of shoulder width was the widest stance in McCaw 1999, about 1.7x acromion width in Larsen 2021",
        "sources": [
          "mccaw1999",
          "larsen2021"
        ]
      },
      {
        "measure": "Toe-out (each foot)",
        "setup": "30°",
        "peak": "Unchanged; knee 1 cm outside the foot axis at the bottom",
        "norm": "About 30-45 degrees, matched to the knees (Lorenzetti 2018; Sinclair 2022)",
        "sources": [
          "lorenzetti2018",
          "sinclair2022"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈104°",
        "norm": "About 100-120 degrees at thighs parallel (clinical opinion; Larsen 2021 reported about 119-120 degrees in wide-stance loaded squats)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈2°",
        "peak": "≈114° (joint channel), thighs ≈43° out of the sagittal plane",
        "norm": "Not specified by the sources for this load and trunk angle",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈22° forward",
        "norm": "Upright to slightly forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell",
        "setup": "Hanging upright between the legs, top plate between the palms",
        "peak": "2.5 cm above the floor at the lowest; ≥3.3 cm from the legs and trunk (rig shapes)",
        "norm": "Hangs straight down between the legs, clear of the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "About 2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
