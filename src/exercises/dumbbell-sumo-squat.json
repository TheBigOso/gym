    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Groin or hip discomfort: narrow the stance a little and turn the toes out less.",
        "Knee pain: shorten the depth."
      ],
      "regressions": [
        "Bodyweight sumo squat.",
        "Lighter dumbbell."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Pause at the bottom.",
        "Feet on two low steps for more depth."
      ]
    },
    "muscleNotes": {
      "quads_r": "Knee extensors lower and drive the squat; stance width did not change quadriceps activity (McCaw 1999).",
      "quads_l": "Knee extensors lower and drive the squat; stance width did not change quadriceps activity (McCaw 1999).",
      "glute_max_r": "Hip extensor; a wide stance changed buttock muscle activity compared with narrower stances (McCaw 1999).",
      "glute_max_l": "Hip extensor; a wide stance changed buttock muscle activity compared with narrower stances (McCaw 1999).",
      "adductors_r": "Medial thigh muscles work harder with the wide stance (McCaw 1999 found stance width changed medial thigh activity).",
      "adductors_l": "Medial thigh muscles work harder with the wide stance (McCaw 1999 found stance width changed medial thigh activity).",
      "hamstrings_r": "Assist hip extension and co-contract around the knee (clinical opinion).",
      "hamstrings_l": "Assist hip extension and co-contract around the knee (clinical opinion).",
      "calves_r": "Steady the shins (clinical opinion).",
      "calves_l": "Steady the shins (clinical opinion).",
      "glute_med_r": "Keeps the knees pushed out over the turned-out toes (clinical opinion).",
      "glute_med_l": "Keeps the knees pushed out over the turned-out toes (clinical opinion).",
      "core": "Keeps the trunk tall over the wide base (clinical opinion).",
      "spinal_extensors_r": "Hold the chest up; the wide stance lets the trunk stay more upright (clinical opinion).",
      "spinal_extensors_l": "Hold the chest up; the wide stance lets the trunk stay more upright (clinical opinion).",
      "forearm_flexors_r": "Squeeze the top plate between the palms all set (clinical opinion).",
      "forearm_flexors_l": "Squeeze the top plate between the palms all set (clinical opinion).",
      "upper_traps_r": "Hold the shoulders level while the dumbbell hangs from the arms (clinical opinion).",
      "upper_traps_l": "Hold the shoulders level while the dumbbell hangs from the arms (clinical opinion)."
    }
