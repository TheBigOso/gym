      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Stack load is user-chosen: start light; the open position stretches the front of the shoulder.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort at the open position: set the range limiter so the arms stop level with the trunk."
      ],
      "regressions": [
        "Lighter stack.",
        "Band chest fly."
      ],
      "progressions": [
        "Heavier stack.",
        "Pause 2 s with the arms together."
      ]
    },
    "muscleNotes": {
      "pec_r": "Prime mover: brings the arm across the body (horizontal adduction) (Welsch 2005 for fly EMG).",
      "pec_l": "Prime mover: brings the arm across the body (horizontal adduction) (Welsch 2005 for fly EMG).",
      "ant_deltoid_r": "Helps bring the arm forward and across.",
      "ant_deltoid_l": "Helps bring the arm forward and across.",
      "biceps_r": "Holds the elbow bend.",
      "biceps_l": "Holds the elbow bend.",
      "serratus_r": "Steadies the shoulder blade.",
      "serratus_l": "Steadies the shoulder blade.",
      "core": "Keeps the trunk on the pad.",
