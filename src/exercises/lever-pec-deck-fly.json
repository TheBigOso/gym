    "id": "lever-pec-deck-fly",
    "name": "Lever Pec Deck Fly",
    "aliases": [
      "Pec deck",
      "Butterfly machine (elbow pads)",
      "Machine chest fly with forearm pads"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "1350",
      "title": "Lever Pec Deck Fly",
      "url": "https://gymvisual.com/videos/1350-lever-pec-deck-fly.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (gymvisual.com refused the request), so the data sheet was not read and the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Front of the shoulders"
    ],
    "equipment": [
      "Pec deck machine (forearm pads on two lever arms swinging about overhead axles)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (horizontal shoulder adduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "serratus_r",
        "serratus_l",
        "biceps_r",
        "biceps_l",
        "core"
      ],
      "lengthened": [
        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the pads come together, breathe in as they open.",
      "cadence": "About 1.3 s in, short squeeze, about 2 s out"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "45-75 s",
      "frequency": "1-2 times a week",
      "tempo": "1.3-0.5-2-0.5 (in-squeeze-out-pause, seconds)",
      "load": "Stack load is user-chosen: pick a weight you can close without the back leaving the pad.",
      "progression": "Add reps, then one plate on the stack; slower opening"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with the back on the pad and the feet flat; upper arms level with the shoulders, elbows bent about 90 degrees, forearms upright against the pads."
      },
      {
        "id": "c2",
        "phase": "close",
        "text": "Breathe out and bring the pads together in front of the chest by squeezing the elbows toward each other."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the chest with the pads together; shoulders down and back on the pad."
      },
      {
        "id": "c4",
        "phase": "open",
        "text": "Breathe in and let the pads open slowly until the elbows are about level with the trunk."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Feel the stretch across the chest without letting the shoulders roll forward."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Seat too low or high",
        "fix": "Set the seat so the upper arms are level with the shoulders."
      },
      {
        "id": "m2",
        "mistake": "Pushing with the hands",
        "fix": "Press with the forearms and elbows into the pads."
      },
      {
        "id": "m3",
        "mistake": "Opening too far",
        "fix": "Stop with the elbows about level with the trunk."
      },
      {
        "id": "m4",
        "mistake": "Back leaving the pad",
        "fix": "Keep the back and head on the pad."
      }
    ],
    "kinematics": [
      {
        "measure": "Horizontal adduction",
        "setup": "Shoulder plane ≈-6°, elbows 88.9 cm apart",
        "peak": "Shoulder plane ≈104°, elbows 28.6 cm apart",
        "norm": "From the arms out to the sides to the pads together in front of the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow",
        "setup": "≈90°, forearms upright on the pads",
        "peak": "Unchanged",
        "norm": "Held at about 90 degrees, forearms upright against the pads (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation",
        "setup": "≈90°",
        "peak": "Unchanged",
        "norm": "Upper arms about level with the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lever",
        "setup": "Axles over the shoulders (-15.4, ±20.2 cm)",
        "peak": "Arms turn 145.5°; pads within 0.03 cm of the forearms",
        "norm": "Each pad swings about a vertical axle lined up over the shoulder joint (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Fly EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Machine and dumbbell flys activated the pectoralis similarly to presses in one study (Welsch 2005)",
        "sources": [
          "welsch2005"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s open",
        "peak": "1.3 s in, 0.5 s squeeze, 2 s out",
        "norm": "About 1.3 s in and 2 s out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #1350, Lever Pec Deck Fly, video (movement reference)",
