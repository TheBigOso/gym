  "exercise": {
    "id": "dumbbell-reverse-wrist-curl",
    "name": "Dumbbell Reverse Wrist Curl",
    "aliases": [
      "Seated reverse wrist curl",
      "Palms-down wrist curl",
      "Dumbbell wrist extension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "038512",
      "title": "Dumbbell Reverse Wrist Curl",
      "url": "https://gymvisual.com/videos/13765-dumbbell-reverse-wrist-curl.html",
      "listing": "Video; data sheet: body part Forearms, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Forearms",
    "secondaryBodyParts": [],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (wrist)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "biceps_r",
        "biceps_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the knuckles lift, inhale as they lower.",
      "cadence": "About 1 s up, 0.4 s squeeze, 1.7 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "load": "Dumbbell load is user-chosen: pick a weight you can control through the full range for every rep with 1-3 reps in reserve (RPE 7-9). Expect to use a lighter dumbbell than for the palms-up wrist curl (clinical opinion).",
      "tempo": "1-0-2-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, then a slower lowering, then a heavier dumbbell"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the end of the bench, forearms along the thighs, palms down, wrists just past the knees; hands relaxed down."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and lift the knuckles up, bending only at the wrists."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause with the backs of the hands up; forearms stay on the thighs."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the hands point down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the grip firm; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Forearms rising off the thighs",
        "fix": "Pin the forearms; only the hands move."
      },
      {
        "id": "m2",
        "mistake": "Dropping the dumbbell on the way down",
        "fix": "Lower over about 2 s."
      },
      {
        "id": "m3",
        "mistake": "Too heavy",
        "fix": "The extensors are weaker than the flexors; go light."
      },
      {
        "id": "m4",
        "mistake": "Thumbs turning up (forearm rotating)",
        "fix": "Keep the palms facing straight down."
      }
    ],
    "kinematics": [
      {
        "measure": "Wrist extension/flexion",
        "setup": "45° flexion",
        "peak": "51° extension (arc ≈96°)",
        "norm": "Healthy adults used up to about 54 degrees of wrist flexion and 60 degrees of extension in daily tasks, functional range about 40 each way (Ryu 1991); a curl goes a little further, to a comfortable end range without pain (clinical opinion)",
        "sources": [
          "ryu1991"
        ]
      },
      {
        "measure": "Forearm on the thigh",
        "setup": "Elbow at 62% of the thigh, wrist at 122% (just past the knee); elbow ≈48°",
        "peak": "Forearm still (elbow and wrist move 0 cm over the loop)",
        "norm": "Forearms rest along the thighs and stay still; only the hands move, the wrists just past the knees so the hands move freely (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk lean",
        "setup": "≈11° forward from vertical",
        "peak": "Unchanged",
        "norm": "Lean forward from the hips with a long back so the forearms lie flat on the thighs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bottom 0.5 s",
        "peak": "1 s up, 0.4 s pause, 1.7 s down, 0.4 s at the bottom",
        "norm": "Slow and controlled, about 1 s up, a short squeeze and 1.5-2 s down (clinical opinion); resistance programmes for the wrist extensors in tendinopathy used 1-4 sets of about 15 reps, with no optimal dose defined (J Hand Ther 2012)",
        "sources": [
          "jht2012"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #038512, Dumbbell Reverse Wrist Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/13765-dumbbell-reverse-wrist-curl.html"
      },
      {
        "id": "ryu1991",
        "title": "Ryu, Cooney, Askew, An and Chao 1991, functional ranges of motion of the wrist joint (J Hand Surg Am 16(3):409-419; 40 adults, biaxial wrist electrogoniometer)",
        "url": "https://mayoclinic.elsevierpure.com/en/publications/functional-ranges-of-motion-of-the-wrist-joint/"
      },
      {
        "id": "jht2012",
        "title": "Effectiveness of different methods of resistance exercises in lateral epicondylosis, a systematic review (J Hand Ther 2012;25(1):5-25; PubMed 22075055; 12 studies)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/22075055/"
      },
      {
        "id": "szymanski2004",
        "title": "Szymanski, Szymanski, Molloy and Pascoe 2004, effect of 12 weeks of wrist and forearm training on high school baseball players (J Strength Cond Res 18(3):432-440; PubMed 15320673; 43 players)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/15320673/"
      }
    ],
    "safety": {
      "cautions": [
        "Pain on the outside of the elbow (tennis elbow): use a light dumbbell and a slow lowering, and get it assessed if it does not settle (clinical opinion).",
        "Wrist or elbow pain: use a lighter dumbbell and a shorter range; stop if pain persists (clinical opinion).",
        "Keep the forearm on the thigh so the elbow and shoulder stay out of it.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Forearms on a flat bench instead of the thighs.",
        "One arm at a time."
      ],
      "regressions": [
        "Lighter dumbbell, smaller range.",
        "Band reverse wrist curl."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Slower lowering (3 s).",
        "Pause at the top."
      ]
    },
    "muscleNotes": {
      "forearm_extensors_r": "The wrist extensors (extensor carpi radialis longus and brevis, extensor carpi ulnaris) lift the back of the hand. This palms-down curl is a staple of tendon-loading programmes for tennis elbow, which used 1-4 sets of about 15 reps (J Hand Ther 2012).",
      "forearm_extensors_l": "The wrist extensors (extensor carpi radialis longus and brevis, extensor carpi ulnaris) lift the back of the hand. This palms-down curl is a staple of tendon-loading programmes for tennis elbow, which used 1-4 sets of about 15 reps (J Hand Ther 2012).",
      "forearm_flexors_r": "The finger flexors hold the handle (clinical opinion).",
      "forearm_flexors_l": "The finger flexors hold the handle (clinical opinion).",
      "biceps_r": "Holds the elbow bent while the forearm rests on the thigh (clinical opinion).",
      "biceps_l": "Holds the elbow bent while the forearm rests on the thigh (clinical opinion).",
      "core": "Holds the forward lean with a long back."
    }
  },
