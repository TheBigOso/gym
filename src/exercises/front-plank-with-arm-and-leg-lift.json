        "lat_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the arm and leg lift, breathe in as they return; keep the brace on.",
      "cadence": "About 1 s out, 1 s hold, 1 s back per side"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "5-8 per side",
      "tempo": "1 s out, 1 s hold, 1 s back",
      "frequency": "2-3 times a week",
      "progression": "Longer holds, then slower reps; regress to the bird dog on all fours"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Forearm plank: elbows under the shoulders, feet hip width or a little wider for balance."
      },
      {
        "id": "c2",
        "phase": "liftA",
        "text": "Shift the weight a touch onto the left forearm, then reach the right arm forward and lift the left leg; hips stay level."
      },
      {
        "id": "c3",
        "phase": "holdA",
        "text": "Hold briefly: long line from the fingertips to the lifted heel, no twisting."
      },
      {
        "id": "c4",
        "phase": "lowerA",
        "text": "Return the forearm and the toes to the mat under control."
      },
      {
        "id": "c5",
        "phase": "liftB",
        "text": "Other side: left arm forward, right leg up, hold, return."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Hold the plank, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips twisting toward the lifted leg",
        "fix": "Keep both hip bones facing the mat; lift less if needed."
      },
      {
        "id": "m2",
        "mistake": "Low back arching as the leg lifts",
        "fix": "Lift from the glute, only as high as the pelvis stays level."
      },
      {
        "id": "m3",
        "mistake": "Shoulder of the support arm sinking",
        "fix": "Push the mat away with the supporting forearm."
      },
      {
        "id": "m4",
        "mistake": "Feet too close together",
        "fix": "Widen the feet a little for a stable base."
      }
    ],
    "kinematics": [
      {
        "measure": "Arm elevation",
        "setup": "Forearm on the mat, elbow under the shoulder",
        "peak": "Straight forward, ≈3° from level (hand 31 cm above the mat)",
        "norm": "Reaching arm forward, about level with the shoulder (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension (lifted leg)",
        "setup": "Hip ≈0° (in line)",
        "peak": "Hip ≈-12°: leg ≈11° above the body line",
        "norm": "A small lift past the body line keeps the pelvis level (clinical opinion); hip extension in a plank raised gluteal activity (Boren 2011)",
        "sources": [
          "boren2011"
        ]
      },
      {
        "measure": "Body line (shoulder-hip-ankle)",
        "setup": "≈13° off straight",
        "peak": "Unchanged (pelvis fixed)",
        "norm": "Held straight on the two support points (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "Level, square to the mat",
        "peak": "Unchanged (no rotation)",
        "norm": "Level and square; contralateral lifts load the obliques as anti-rotators (clinical opinion; Ekstrom 2007 for the quadruped arm and leg lift)",
        "sources": [
          "ekstrom2007"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s plank",
        "peak": "1 s out, 1 s hold, 1 s back per side",
        "norm": "About 1 s out, 1 s hold, 1 s back (clinical opinion)",
        "sources": []
      }
    ],
