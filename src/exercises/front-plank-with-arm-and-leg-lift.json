    ],
    "difficulty": "Advanced",
    "mechanics": "Isometric trunk (anti-extension, anti-rotation) with shoulder flexion and hip extension",
    "plane": "Multiplanar",
    "laterality": "Alternating (both sides in one loop)",
    "authoredSide": "bilateral",
    "muscles": {
