    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low back pain that increases in the plank: shorten the hold or drop to the knee plank.",
        "High blood pressure: breathe steadily; long breath-held efforts raise blood pressure."
      ],
      "modify": [
        "Shoulder discomfort: hands together (forearms in a slight V) or an incline plank with the forearms on a bench.",
        "Elbow discomfort: fold the mat under the forearms."
      ],
      "regressions": [
        "Front plank with leg lift.",
        "Bird dog on all fours."
      ],
      "progressions": [
        "Longer holds.",
        "Slow 3 s reach."
      ]
    },
    "muscleNotes": {
      "core": "The two-point base asks the abdominals to resist both sagging and rotation (clinical opinion).",
      "obliques_r": "Obliques resist the rotation created by lifting opposite limbs (clinical opinion; Ekstrom 2007 measured high oblique activity in the quadruped arm and leg lift).",
      "obliques_l": "Obliques resist the rotation created by lifting opposite limbs (clinical opinion; Ekstrom 2007 measured high oblique activity in the quadruped arm and leg lift).",
      "glute_max_r": "Gluteus maximus extends the lifted leg; hip extension from a plank gave high gluteal activity in Boren 2011.",
      "glute_max_l": "Gluteus maximus extends the lifted leg; hip extension from a plank gave high gluteal activity in Boren 2011.",
      "ant_deltoid_r": "Anterior deltoid holds the reaching arm forward (clinical opinion).",
      "ant_deltoid_l": "Anterior deltoid holds the reaching arm forward (clinical opinion)."
    }
