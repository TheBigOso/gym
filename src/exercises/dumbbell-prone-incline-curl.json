      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the dumbbell and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Pick the dumbbells up and set them down with a straight back and bent knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Pressure on the chest or breathing discomfort: set the pad a little steeper (clinical opinion)."
      ],
      "modify": [
        "Shoulder or chest discomfort: steeper pad (55-60 degrees).",
        "Elbow pain: neutral (hammer) grip."
      ],
      "regressions": [
        "Seated dumbbell curl.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Spider curl (lower pad, stricter arm).",
        "Slower lowering with a 1 s pause at the top."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor; with the chest on the pad the arms hang straight down and the body cannot swing. With the arms hanging in front of the trunk (shoulder flexed), biceps activity rose with shoulder flexion up to about 75 degrees in an isometric curl (Moon 2013).",
      "biceps_l": "Main elbow flexor; with the chest on the pad the arms hang straight down and the body cannot swing. With the arms hanging in front of the trunk (shoulder flexed), biceps activity rose with shoulder flexion up to about 75 degrees in an isometric curl (Moon 2013).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Holds the upper arm vertical; it should not lift the elbows forward.",
      "ant_deltoid_l": "Holds the upper arm vertical; it should not lift the elbows forward.",
      "core": "Keeps the trunk still so the hips do not swing the weight up.",
      "rhomboids_midtrap_r": "Keep the shoulder blades set on the pad.",
      "rhomboids_midtrap_l": "Keep the shoulder blades set on the pad."
    }
