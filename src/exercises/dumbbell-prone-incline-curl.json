      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.3 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight. Start lighter than for the standing curl (clinical opinion)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the back pad to about 45 degrees. Lie chest-down on it with the chin just over the top, feet on the floor behind, arms hanging straight down, palms forward."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl both dumbbells toward the shoulders; the upper arms stay vertical."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze at the top; chest stays on the pad."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms hanging straight down, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows swinging forward as the weight rises",
        "fix": "Keep the upper arms vertical; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Lifting the chest off the pad",
        "fix": "Keep the chest and hips against the pad."
      },
      {
        "id": "m3",
        "mistake": "Half reps at the bottom",
        "fix": "Straighten the arms fully each rep."
      },
      {
        "id": "m4",
        "mistake": "Craning the neck to look forward",
        "fix": "Keep the head in line with the trunk, chin just over the pad."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈1° (arm straight)",
        "peak": "≈130° at the top (range ≈129°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "18.1° (palm forward/up)",
        "peak": "6.5° (palm forward/up)",
        "norm": "The supinated grip gave the highest biceps activity in the lifting phase; neutral grips shift work toward the brachioradialis (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈3° from vertical (hanging); ≈48° from the trunk line (shoulder flexed)",
        "peak": "Unchanged: pure elbow hinge",
        "norm": "Upper arms hang vertically, about 45 degrees of shoulder flexion relative to the trunk on a 45-degree pad; biceps activity peaked near 75 degrees of shoulder flexion in an isometric curl (Moon 2013)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.8 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.3 s down, 1.0 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Bench angle",
        "setup": "45° back pad (80 cm), seat 45 cm",
        "peak": "Trunk ≈42° above horizontal, along the pad",
        "norm": "Back pad about 45 degrees (common practice, clinical opinion)",
        "sources": []
      },
      {
        "measure": "Chest on the pad (skinned mesh gap)",
        "setup": "Chest on the pad; head 4.6 cm past the top edge, shoulders -15.7 cm",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "Chest on the pad, chin over the top, feet planted behind (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #037412, Dumbbell Prone Incline Curl, video (movement reference)",
