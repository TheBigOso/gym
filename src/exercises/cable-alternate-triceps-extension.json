    "id": "cable-alternate-triceps-extension",
    "name": "Cable Alternate Triceps Extension",
    "aliases": [
      "Alternating cable pushdown",
      "Alternating one-arm triceps pushdown",
      "Cable alternating triceps pressdown"
    ],
    "reference": {
      "source": "GymVisual",
