    "breathing": {
      "pattern": "Exhale as you curl and sit up, inhale as you lower under control.",
      "cadence": "About 1.6 s up, a short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-15",
      "tempo": "About 1.5 s up, brief pause, 2 s down; no jerking with the arms",
      "frequency": "2-3 times a week",
      "progression": "Arms crossed on the chest, then hands behind the head (longer lever), then a slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent about 90 degrees, feet flat and anchored. Arms straight, reaching toward the knees."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out, tuck the chin slightly and curl the head and shoulder blades off the mat first."
      },
      {
        "id": "c3",
        "phase": "rise",
        "text": "Keep curling and sit all the way up, reaching the straight arms forward past the knees."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Brief pause sitting over the hips, arms long, shoulders down."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Breathe in and roll back down slowly: low back first, then the shoulder blades, head last."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Head rests briefly; repeat without bouncing off the floor."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Throwing the arms forward to swing up",
        "fix": "Keep the arms still relative to the trunk; let the abdominals lift you."
      },
      {
        "id": "m2",
        "mistake": "Sitting up with a flat back from the hips (hip flexors only)",
        "fix": "Curl the head and shoulders first, then sit up."
      },
      {
        "id": "m3",
        "mistake": "Dropping back to the floor",
        "fix": "Lower for about 2 s, one vertebra at a time."
      },
      {
        "id": "m4",
        "mistake": "Feet lifting or knees falling open",
        "fix": "Anchor the feet and keep the knees hip width."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from the floor",
        "setup": "Lying (shoulder blades on the mat)",
        "peak": "≈79° from the floor",
        "norm": "From lying to sitting up close to the thighs; the traditional sit-up reaches more hip flexion and the modified one more trunk flexion (J Strength Cond Res 2015)",
        "sources": [
          "armysitup2015"
        ]
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈-5° (slight lordosis)",
        "peak": "≈26° (L5-T12 segment, rounded)",
        "norm": "Low back curls early and stays rounded at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈7° (resting curve)",
        "peak": "≈38° at the top (more during the curl)",
        "norm": "Upper back curls first (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈44°",
        "peak": "≈86° (pelvis rolled toward the thighs)",
        "norm": "Most of the second half of the rise is hip flexion (Andersson 1997)",
        "sources": [
          "andersson1997"
        ]
      },
      {
        "measure": "Knee",
        "setup": "≈88°",
        "peak": "≈88°, feet unchanged",
        "norm": "About 90 degrees, feet anchored and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Straight arms aimed at the knees (shoulder elevation ≈19°)",
        "peak": "Shoulder elevation ≈95°, elbows ≈5° or less; fingertips 35 cm past the knees",
        "norm": "Straight and reaching forward; the arms do not swing (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "0.7 s curl, 0.9 s sit up, 0.5 s pause, 2.1 s roll down, 1.4 s rest",
