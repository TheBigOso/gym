    "breathing": {
      "pattern": "Breathe out as you turn to each side, breathe in through the middle.",
      "cadence": "About 1.3 s per side with a short pause"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per side",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "About 1 s turn, short pause each side",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbell; light to moderate, held by the ends",
      "progression": "Bodyweight Russian twist first; then feet up, then a heavier dumbbell"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with knees bent, lean back to about 45 degrees with a long spine and lift the feet off the floor. Hold the dumbbell by its ends in front of the chest."
      },
      {
        "id": "c2",
        "phase": "turnR",
        "text": "Breathe out and turn the ribs and shoulders to the right, taking the dumbbell beside the right hip."
      },
      {
        "id": "c3",
        "phase": "turnL",
        "text": "Turn through the middle to the left; the knees and feet stay up and still."
      },
      {
        "id": "c4",
        "phase": "turnR2",
        "text": "Turn back to the right with control."
      },
      {
        "id": "c5",
        "phase": "turnL2",
        "text": "And to the left again; keep the chest lifted."
      },
      {
        "id": "c6",
        "phase": "return",
        "text": "Return to the middle, dumbbell in front of the chest, and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back and collapsing the chest",
        "fix": "Sit tall through the spine; lean back from the hips."
      },
      {
        "id": "m2",
        "mistake": "Swinging only the arms",
        "fix": "Turn the ribs and shoulders; the dumbbell follows the chest."
      },
      {
        "id": "m3",
        "mistake": "Legs swinging side to side",
        "fix": "Keep the knees together and the feet still in the air."
      },
      {
        "id": "m4",
        "mistake": "Going fast with a heavy dumbbell",
        "fix": "Control each turn and pause; twisting under heavy load is a disc risk."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk lean",
        "setup": "≈45° back from vertical (pelvis to C7)",
        "peak": "Held through the turns",
        "norm": "About 45 degrees back from vertical with a long spine (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk rotation",
        "setup": "Facing the knees",
        "peak": "≈46° each way (lumbar ≈5°, thoracic ≈41°), head turns with the dumbbell",
        "norm": "Rotation mostly through the thoracic spine, about 40-50 degrees each way (clinical opinion); repeated twisting under load raises disc stress (Marshall 2010)",
        "sources": [
          "marshall2010"
        ]
      },
      {
        "measure": "Legs",
        "setup": "Knees ≈70°, hips ≈83°, heels 14 cm off the floor",
        "peak": "Legs do not move",
        "norm": "Feet off the floor, knees bent, held still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell",
        "setup": "Held by the ends 23 cm apart, in front of the chest",
        "peak": "Beside the hip, 7.4 cm above the floor at the lowest",
        "norm": "Held by its ends in front of the chest, travelling beside each hip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Sit 0.8 s, feet up",
