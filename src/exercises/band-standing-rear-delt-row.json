    "bodyPart": "Shoulders (posterior deltoid)",
    "secondaryBodyParts": [
      "Upper back (middle trapezius, rhomboids)"
    ],
    "equipment": [
      "Resistance band",
      "Power rack (anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder, elbow)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
