    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the shoulder, numbness or tingling occurs.",
        "Check the band for nicks or tears and loop it securely round the upright; a band that slips or snaps can hit the face.",
        "Band tension is user-chosen: pick one you can row to the squeeze without leaning back.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: let the elbows come a little lower and closer to the body.",
        "Low-back tension: soften the knees and brace the trunk; use a lighter band."
      ],
      "regressions": [
        "Lighter band or a step closer to the rack.",
        "Band pull-apart.",
        "Seated band row."
      ],
      "progressions": [
        "Stronger band or a step further back.",
        "2 s squeeze.",
        "Band face pull (adds a turn-out at the end)."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover: with the elbows out wide the row becomes a horizontal abduction (a bent-arm reverse fly). Horizontal abduction (reverse peck deck) gave much higher posterior deltoid activity than a close-elbow seated row (Franke 2015; Botton 2013).",
      "post_deltoid_l": "Prime mover: with the elbows out wide the row becomes a horizontal abduction (a bent-arm reverse fly). Horizontal abduction (reverse peck deck) gave much higher posterior deltoid activity than a close-elbow seated row (Franke 2015; Botton 2013).",
      "rhomboids_midtrap_r": "Pull the shoulder blades together at the end of the row.",
      "rhomboids_midtrap_l": "Pull the shoulder blades together at the end of the row.",
      "infraspinatus_r": "External rotator that works with the posterior deltoid in horizontal abduction (Schoenfeld 2013).",
      "infraspinatus_l": "External rotator that works with the posterior deltoid in horizontal abduction (Schoenfeld 2013).",
      "lat_deltoid_r": "Helps hold the upper arms out wide.",
      "lat_deltoid_l": "Helps hold the upper arms out wide.",
      "biceps_r": "Holds the elbow bend; less involved than in a close row because the elbows lead.",
      "biceps_l": "Holds the elbow bend; less involved than in a close row because the elbows lead.",
      "core": "Keeps the trunk upright so the body does not lean back.",
      "forearm_flexors_r": "Grip the band.",
      "forearm_flexors_l": "Grip the band.",
      "upper_traps_r": "Steadies the shoulder blade; shrugging shifts work here.",
      "upper_traps_l": "Steadies the shoulder blade; shrugging shifts work here."
    }
