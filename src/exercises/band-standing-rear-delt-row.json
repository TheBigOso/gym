      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row, breathe in as the arms go back out.",
      "cadence": "About 1 s row, short squeeze, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1-0.5-2-0.5 (row-squeeze-return-pause, seconds)",
      "rest": "45-75 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: you should be able to bring the elbows level with the back without leaning",
      "progression": "More reps, a longer squeeze, a step further from the rack, or a stronger band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop the band round a rack upright at shoulder height. Face it, feet hip width, a strand in each hand, palms down, arms reaching forward."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and row the elbows back and out wide, a little below shoulder height, forearms in line with the band."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Stop with the elbows just behind the shoulders, bent about 90 degrees; squeeze the shoulder blades together, shoulders down."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the arms go back out slowly, keeping the band tight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the arms long, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows tucking to the sides (a normal row)",
        "fix": "Keep the elbows out wide, about 80 degrees from the trunk."
      },
      {
        "id": "m2",
        "mistake": "Leaning back to finish",
        "fix": "Stand tall; use a lighter band or step closer to the rack."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the shoulders down as the elbows go back."
      },
      {
        "id": "m4",
        "mistake": "Letting the band pull the arms back fast",
        "fix": "Return slowly, about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flare",
        "setup": "Arms reaching to the upright, ≈81° from the trunk",
        "peak": "Upper arm ≈82° from the trunk, elbow 4 cm below the shoulder joint",
        "norm": "Upper arm about 60-90 degrees out from the trunk so the pull is a horizontal abduction; horizontal abduction loads the posterior deltoid more than a close row (Franke 2015)",
        "sources": [
          "franke2015"
        ]
      },
      {
        "measure": "Horizontal abduction",
        "setup": "Upper arm ≈84° in front of the frontal plane",
        "peak": "Upper arm ≈12° behind the frontal plane",
        "norm": "From the arms reaching forward to the upper arms just behind the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈23°",
        "peak": "≈107°",
        "norm": "Nearly straight at the bottom, about 90 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Overhand, palms down",
        "peak": "Unchanged",
        "norm": "Overhand (palms down) is the usual rear delt row grip; on a reverse fly a neutral grip gave more posterior deltoid activity than a pronated one (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Band",
        "setup": "Looped round the upright 133.4 cm high (shoulder height), 109 cm in front of the shoulders; strands 53.7 cm",
        "peak": "Strands 96.8 cm",
        "norm": "Elastic tension rises as the band stretches, so the load is highest at the squeeze; at matched effort elastic tubing and dumbbells gave similar activity in shoulder exercises (Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s with the arms long",
        "peak": "1.2 s pull, 0.5 s squeeze, 2 s back",
        "norm": "Controlled, about 1 s out and 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #9237, Band standing rear delt row, video (movement reference)",
