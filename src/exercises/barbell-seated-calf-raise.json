    "name": "Barbell Seated Calf Raise",
    "aliases": [
      "Seated barbell calf raise",
      "Seated barbell heel raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "947",
      "title": "Barbell Seated Calf Raise",
      "url": "https://gymvisual.com/videos/947-barbell-seated-calf-raise.html",
      "listing": "Video (title from the listing URL; the page could not be fetched from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Calves",
    "secondaryBodyParts": [],
    "equipment": [
      "Barbell",
      "Flat bench",
      "Low step"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (ankle)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "calves_r",
        "calves_l"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the heels rise, inhale as they lower.",
      "cadence": "About 1 s up, 0.8 s pause, 1.8 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "12-20",
      "tempo": "1-1-2-0 (up, pause, down)",
      "frequency": "2-3 times a week",
      "load": "Barbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set.",
      "progression": "Heavier bar, then a slower lowering and a longer pause in the stretch"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the end of a bench with the balls of the feet on a low step, heels hanging off its back edge, shins about vertical. Rest the bar across the lower thighs just behind the knees (a pad or towel helps) and hold it there with both hands."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Breathe out and press through the balls of the feet, lifting the heels, the knees and the bar as high as you can."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the top; pressure on the big and second toes, ankles straight (no rolling out)."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the heels slowly below the step."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Hold the stretch briefly with the heels below the step, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bouncing through short reps",
        "fix": "Full range: heels below the step, pause at the top, slow lowering."
      },
      {
        "id": "m2",
        "mistake": "Feet rolling out onto the little toes",
        "fix": "Keep the pressure on the big and second toes."
      },
      {
        "id": "m3",
        "mistake": "Pushing the bar up with the arms",
        "fix": "The hands only hold the bar in place; the calves lift it."
      },
      {
        "id": "m4",
        "mistake": "Bar resting on the kneecaps",
        "fix": "Place it on the thigh muscle just behind the knees, padded."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle plantarflexion",
        "setup": "≈19° dorsiflexion (heels 5.1 cm below the flat-foot line, 16° heel-down)",
        "peak": "≈32° plantarflexion (feet 28° heel-up)",
        "norm": "From a stretch with the heels below the step to as high as possible (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Heel height",
        "setup": "-5.1 cm (below the step top line)",
        "peak": "+9.4 cm; 14.5 cm of heel travel",
        "norm": "As high as possible each rep (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈94°, shins about vertical",
        "peak": "≈99° (knees 9.4 cm higher)",
        "norm": "About 90 degrees: with the knee bent the soleus does most of the work; seated (knee 90 degrees) training grew the soleus but barely the gastrocnemius (Kinoshita 2023)",
        "sources": [
          "kinoshita2023"
        ]
      },
      {
        "measure": "Bar position",
        "setup": "Across the lower thighs (84% of the way to the knee), 0.1 cm off the thigh shapes at the closest; hands overhand 64 cm apart (handle centres), outside the thighs",
        "peak": "Rides up with the knees (6.6 cm)",
        "norm": "Across the lower thighs just behind the knees, held in place by the hands (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stretch 0.8 s",
        "peak": "1.0 s up, 0.8 s pause, 1.8 s down, 0.6 s stretch",
        "norm": "About 1 s up, a short pause, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Barbell Seated Calf Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/947-barbell-seated-calf-raise.html"
      },
      {
        "id": "kinoshita2023",
        "title": "Kinoshita, Maeo et al. 2023, triceps surae muscle hypertrophy is greater after standing versus seated calf-raise training (Front Physiol 14:1272106)",
        "url": "https://www.frontiersin.org/articles/10.3389/fphys.2023.1272106/full"
      },
      {
        "id": "zellers2019",
        "title": "Zellers et al. 2019, seated and standing heel raises and triceps surae activation after Achilles tendon rupture (Transl Sports Med 3(1):3-8; PMC7236791)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7236791/"
      },
      {
        "id": "heberlosier2012",
        "title": "Hébert-Losier, Schneiders, García, Sullivan & Simoneau 2012, influence of knee flexion angle and age on triceps surae muscle fatigue during heel raises (J Strength Cond Res 26(11))",
        "url": "https://epublications.marquette.edu/phys_therapy_fac/29"
      }
    ],
    "safety": {
      "cautions": [
        "Pad the bar (a towel or bar pad) so it does not press on the kneecaps or the nerves above the knee.",
        "Use a stable, non-slip step; keep the balls of the feet well on it.",
        "Load the bar onto the thighs from a rack or a partner; do not curl a heavy bar onto the knees.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Achilles or plantar heel pain: smaller range (feet flat on the floor), lighter load, slow tempo.",
        "Knee discomfort under the bar: more padding or dumbbells across the thighs."
      ],
      "regressions": [
        "Seated dumbbell calf raise.",
        "Seated heel raise without load."
      ],
      "progressions": [
        "Heavier bar.",
        "Single-leg seated raise.",
        "Seated calf raise machine."
      ]
    },
    "muscleNotes": {
      "calves_r": "Soleus-biased plantarflexion: with the knee bent 90 degrees the two-joint gastrocnemius is slack. In a 12-week trial seated (knee 90 degrees) calf raises grew the soleus about as much as standing raises but barely changed the gastrocnemius (Kinoshita 2023).",
      "calves_l": "Soleus-biased plantarflexion: with the knee bent 90 degrees the two-joint gastrocnemius is slack. In a 12-week trial seated (knee 90 degrees) calf raises grew the soleus about as much as standing raises but barely changed the gastrocnemius (Kinoshita 2023).",
      "forearm_flexors_r": "Grip holds the bar in place across the knees (clinical opinion).",
      "forearm_flexors_l": "Grip holds the bar in place across the knees (clinical opinion).",
      "core": "Keeps the trunk tall on the bench (clinical opinion)."
    }
  },
