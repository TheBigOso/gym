    "breathing": {
      "pattern": "Big breath in and brace at the top, hold it on the way down and through the bottom, breathe out as you pass the hardest part of the rise or at the top.",
      "cadence": "About 2 s down, a short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "5-10",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Barbell load is user-chosen: pick a weight you can squat to full depth with the form shown, leaving about 2-3 reps in reserve (RPE 7-8).",
      "rest": "2-3 minutes between sets",
      "progression": "Add 2.5-5 kg when every rep of every set reaches full depth with good form."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar on the upper traps just below the bony bump at the base of the neck, hands just outside the shoulders, elbows down, shoulder blades squeezed together. Step back from the rack, feet a little wider than the hips, toes turned out."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Big breath, brace, then sit down between the heels: knees travel forward and out over the toes, chest stays up, bar stays over the middle of the foot."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Hip crease below the top of the knees, heels flat, back flat; no bounce or relaxing at the bottom."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the floor away, chest and hips rising together; knees keep pushing out. Breathe out as you pass the hardest part."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, hips and knees straight, take a new breath and brace before the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Knees caving in on the way up",
        "fix": "Push the knees out over the toes; use a lighter load or a slightly wider stance."
      },
      {
        "id": "m2",
        "mistake": "Hips shooting up first so the squat turns into a good morning",
        "fix": "Lead with the chest and upper back against the bar; hips and shoulders rise at the same rate."
      },
      {
        "id": "m3",
        "mistake": "Heels lifting or weight on the toes",
        "fix": "Keep the bar over mid-foot and the whole foot on the floor; work on ankle mobility or wear lifting shoes."
      },
      {
        "id": "m4",
        "mistake": "Bar sitting on the neck or rolling up toward it",
        "fix": "Squeeze the shoulder blades together to build a shelf on the upper traps and pull the bar down into it."
      },
      {
        "id": "m5",
        "mistake": "Rounding the lower back at the bottom",
        "fix": "Stop just above the depth where the pelvis tucks under, and brace harder before each rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "44 cm between the ankle centres (≈1.1x the rig's 40 cm shoulder width), toes out 28°",
        "peak": "Unchanged (feet planted)",
        "norm": "About hip to shoulder width with the toes out about 20-30 degrees (Lorenzetti 2018; Sinclair 2022); wider stances moved demand toward the hip (Paoli 2009)",
        "sources": [
          "lorenzetti2018",
          "paoli2009"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈2°",
        "peak": "≈122°; hip joints 4.1 cm below the knee joints",
        "norm": "A full squat takes the hip crease below the top of the knee, about 115-130 degrees of knee flexion (clinical opinion; Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈-7°",
        "peak": "≈133° (joint channel, as in the HUD)",
        "norm": "Large hip flexion at full depth; the trunk lean adds to it (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈43° forward of vertical",
        "norm": "High-bar squats keep the trunk more upright than low-bar squats; a front squat is more upright still (Glassbrook-style comparisons summarised in Larsen 2021; Gullett 2009)",
        "sources": [
          "larsen2021",
          "frontsquat2009"
        ]
      },
      {
        "measure": "Bar position",
        "setup": "High bar: on the upper traps just below C7, 80 cm grip (handle centres)",
        "peak": "Bar -3.2 cm over / behind mid-foot at the top, 6.3 cm at the bottom (bar + body centre of mass 2 → 1.9 cm from mid-foot)",
        "norm": "High bar on the upper trapezius; the combined centre of mass stays over mid-foot through the rep (common coaching; Larsen 2021)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
