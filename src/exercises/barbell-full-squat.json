    "safety": {
      "cautions": [
        "Squat inside a rack with the safety arms set just below your bottom position, or with a trained spotter; the rack drawn here shows only the J-hooks.",
        "Set the J-hooks at about mid-chest height so you unrack and re-rack the bar with a small knee bend, not on tiptoe.",
        "Keep the bar on the muscle of the upper back, never on the bones of the neck.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Limited ankle mobility: a slightly wider stance with the toes turned out more, or a small heel lift.",
        "Knee or hip pain: squat to a box at a pain-free depth.",
        "Shoulder discomfort holding the bar: widen the grip a little."
      ],
      "regressions": [
        "Goblet squat with a dumbbell.",
        "Box squat to a parallel-height box.",
        "Bodyweight squat."
      ],
      "progressions": [
        "Heavier bar in small steps.",
        "Pause squat (2 s at the bottom).",
        "Front squat or low-bar back squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Knee extensors control the descent and drive the rise; they work hardest near the bottom (Straub 2024). Back squat vastus lateralis activity was higher than in the hip thrust (Contreras 2015).",
      "quads_l": "Knee extensors control the descent and drive the rise; they work hardest near the bottom (Straub 2024). Back squat vastus lateralis activity was higher than in the hip thrust (Contreras 2015).",
      "glute_max_r": "Main hip extensor, working hardest out of the bottom of a full squat (clinical opinion; Straub 2024).",
      "glute_max_l": "Main hip extensor, working hardest out of the bottom of a full squat (clinical opinion; Straub 2024).",
      "adductors_r": "Adductor magnus helps extend the hip from deep flexion; wider stances raised adductor activity (Paoli 2009).",
      "adductors_l": "Adductor magnus helps extend the hip from deep flexion; wider stances raised adductor activity (Paoli 2009).",
      "hamstrings_r": "Assist hip extension; their length changes little in a squat, so activity stays moderate (Contreras 2015).",
      "hamstrings_l": "Assist hip extension; their length changes little in a squat, so activity stays moderate (Contreras 2015).",
      "spinal_extensors_r": "Hold the back flat against the forward lean the bar on the shoulders creates.",
      "spinal_extensors_l": "Hold the back flat against the forward lean the bar on the shoulders creates.",
      "calves_r": "Control the forward travel of the knees over the planted feet.",
      "calves_l": "Control the forward travel of the knees over the planted feet.",
      "core": "Bracing (breath held against a tight midsection) stiffens the trunk under the bar.",
      "obliques_r": "Part of the brace around the trunk.",
      "obliques_l": "Part of the brace around the trunk.",
      "glute_med_r": "Keeps the knee tracking over the foot and the pelvis level.",
      "glute_med_l": "Keeps the knee tracking over the foot and the pelvis level.",
      "upper_traps_r": "The muscle shelf the high bar rests on.",
      "upper_traps_l": "The muscle shelf the high bar rests on.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together so the upper traps form the shelf.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together so the upper traps form the shelf.",
      "lats_r": "Pull the bar down into the back and help keep the upper back tight.",
      "lats_l": "Pull the bar down into the back and help keep the upper back tight.",
      "forearm_flexors_r": "Grip the bar to hold it in place on the back.",
      "forearm_flexors_l": "Grip the bar to hold it in place on the back."
    }
