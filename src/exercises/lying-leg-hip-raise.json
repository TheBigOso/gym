    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Straight-leg raising loads the hip flexors and the lumbar spine; low-back loads were among the higher of the abdominal exercises compared by Axler and McGill (1997).",
        "Low-back pain or flexion intolerance: start with the dead bug or a bent-knee reverse crunch.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before straight-leg or trunk-flexion work."
      ],
      "modify": [
        "Hamstring tightness: allow a small knee bend.",
        "Low back lifting at the start: begin with the legs a little above level."
      ],
      "regressions": [
        "Lying leg hip raise on the floor.",
        "Reverse crunch.",
        "Bent-knee hip raise."
      ],
      "progressions": [
        "Slow 3 s lowering.",
        "Hanging leg hip raise."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the pelvis toward the ribs to lift the hips; leg-raise variants with a pelvic curl raised lower rectus activity (Clark 2003).",
      "hip_flexors_r": "Iliopsoas and rectus femoris lift the straight legs to vertical (Andersson 1997).",
      "hip_flexors_l": "Iliopsoas and rectus femoris lift the straight legs to vertical (Andersson 1997).",
      "obliques_r": "Help curl the pelvis and keep it square (clinical opinion).",
      "obliques_l": "Help curl the pelvis and keep it square (clinical opinion).",
      "quads_r": "Keep the knees straight (clinical opinion).",
      "quads_l": "Keep the knees straight (clinical opinion).",
      "lats_r": "Pull against the bench grip to keep the upper back down (clinical opinion).",
      "lats_l": "Pull against the bench grip to keep the upper back down (clinical opinion).",
      "adductors_r": "Hold the legs together (clinical opinion).",
      "adductors_l": "Hold the legs together (clinical opinion).",
      "forearm_flexors_r": "Grip the bench to anchor the upper body (clinical opinion).",
      "forearm_flexors_l": "Grip the bench to anchor the upper body (clinical opinion)."
    }
