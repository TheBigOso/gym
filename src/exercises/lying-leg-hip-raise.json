  "exercise": {
    "id": "lying-leg-hip-raise",
    "name": "Lying Leg Hip Raise",
    "aliases": [
      "Bench leg-hip raise",
      "Flat bench leg raise with hip lift",
      "Lying leg-hip raise (bench)",
      "Bench leg raise to hip thrust up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5283",
      "title": "Lying leg hip raise",
      "url": "https://gymvisual.com/videos/5283-lying-leg-hip-raise.html",
      "listing": "Video (movement reference; the page could not be read at authoring time: gymvisual.com is blocked by the proxy, so the movement comes from the name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Hips (hip flexors)",
      "Thighs (quadriceps)"
    ],
    "equipment": [
      "Flat bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip flexion, then posterior pelvic tilt and lumbar flexion with the legs vertical)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l",
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "lats_r",
        "lats_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the legs rise to vertical, breathe out as the hips curl off the mat, breathe in as you lower.",
      "cadence": "About 1.4 s legs up, 1.1 s hips up, short pause, 1.7 s hips down, 1.9 s legs down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-12",
      "tempo": "Legs up in about 1.5 s, hips up in 1 s, lower each part in about 2 s; no swinging",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering and a longer pause with the hips up, then hanging leg hip raises."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench with the glutes near the end, grip the sides of the pad beside your head, legs straight out in line with the bench."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Keep the knees straight and lift the legs to vertical without arching the low back."
      },
      {
        "id": "c3",
        "phase": "lift",
        "text": "Breathe out and curl the hips up off the bench, driving the feet straight up toward the ceiling."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Roll the pelvis down onto the bench, then lower the legs slowly to level."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the low back on the pad and the legs out straight before the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the legs to throw the hips up",
        "fix": "Stop at vertical for a beat and lift the hips with the abdominals, not momentum."
      },
      {
        "id": "m2",
        "mistake": "Low back arching as the legs drop below the bench",
        "fix": "Stop the legs level with the bench and keep the low back on the pad."
      },
      {
        "id": "m3",
        "mistake": "Pulling hard on the bench with the arms",
        "fix": "The grip only anchors you; keep the head and shoulders relaxed on the pad."
      },
      {
        "id": "m4",
        "mistake": "Bending the knees to make it easier",
        "fix": "Keep the legs straight, or switch to the bent-knee hip raise."
      }
    ],
    "kinematics": [
      {
        "measure": "Legs from the floor",
        "setup": "≈-8° (straight out, just below the line of the bench)",
        "peak": "≈104° (vertical is 90°; the feet go a little past it as the hips lift)",
        "norm": "From about level to vertical before the hips lift (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈-5°",
        "peak": "≈95° with the legs vertical, ≈75° at the top",
        "norm": "About 90 degrees with the legs vertical; straight-leg raises load the hip flexors heavily (Andersson 1997)",
        "sources": [
          "andersson1997"
        ]
      },
      {
        "measure": "Pelvis roll",
        "setup": "Pelvis on the bench",
        "peak": "≈34° posterior tilt; buttocks 7.3 cm off the pad",
        "norm": "The pelvis curls until the buttocks clear the bench; this curl brings in the lower abdominals (Clark 2003)",
        "sources": [
          "clark2003"
        ]
      },
      {
        "measure": "Knees",
        "setup": "≈4°",
        "peak": "≈7°",
        "norm": "Straight or nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Hands grip the sides of the pad beside the head, elbows out",
        "peak": "Unchanged; upper back stays on the pad (T6 moves 0.1 cm)",
        "norm": "Hands hold the bench behind or beside the head to anchor the upper body (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Legs out 0.6 s",
        "peak": "1.4 s legs up, 1.1 s hips up, 0.4 s pause, 1.65 s hips down, 1.95 s legs down",
        "norm": "Controlled, about 1-2 s per part (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
