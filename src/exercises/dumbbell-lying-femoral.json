    "breathing": {
      "pattern": "Exhale as the heels curl up, inhale as they lower.",
      "cadence": "About 1.2 s up, 0.5 s hold, 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Heavier dumbbell; have a partner place it between the feet"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down, knees just past the end of the bench, a dumbbell squeezed upright between the feet; hold the bench."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the heels up, keeping the feet flexed around the handle."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Shins just past vertical; hips stay down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to almost straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the knees soft at the bottom; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the hips off the bench",
        "fix": "Press the hips down; go lighter if they rise."
      },
      {
        "id": "m2",
        "mistake": "Losing the squeeze on the dumbbell",
        "fix": "Keep the feet flexed and pressed together."
      },
      {
        "id": "m3",
        "mistake": "Dropping into full extension",
        "fix": "Stop with the knees soft so the load stays on the hamstrings."
      },
      {
        "id": "m4",
        "mistake": "Curling too far",
        "fix": "Past vertical the load falls off; stop there."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈10°",
        "peak": "≈102°",
        "norm": "From about 10 degrees to 90-110 degrees (clinical opinion)",
