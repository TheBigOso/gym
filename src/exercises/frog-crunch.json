  "exercise": {
    "id": "frog-crunch",
    "name": "Frog Crunch",
    "aliases": [
      "Butterfly crunch",
      "Frog-leg crunch",
      "Lying frog crunch (feet together)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "897612",
      "title": "Lying Frog Crunch Feet Together (male)",
      "url": "https://gymvisual.com/videos/20163-lying-frog-crunch-feet-together-male.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Core",
      "Hips (adductor stretch)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (spinal flexion, mostly thoracic)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1 s up, a short squeeze, about 1.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "tempo": "About 1 s up, brief pause, 1.5-2 s down",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering and a 2 s hold, then arms overhead"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, bring the soles of the feet together close to the hips and let the knees fall out to the sides. Fingertips lightly behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the head, shoulders and shoulder blades off the mat; ribs toward the hips."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Short squeeze at the top. Knees stay open and relaxed; low back stays on the mat."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, shoulder blades first, head last."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest the head briefly; repeat without bouncing."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling on the head",
        "fix": "Fingertips only, elbows wide."
      },
      {
        "id": "m2",
        "mistake": "Squeezing the knees up and together as you curl",
        "fix": "Leave the legs relaxed in the frog position; only the trunk moves."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back to start the curl",
        "fix": "Exhale and draw the ribs down first."
      },
      {
        "id": "m4",
        "mistake": "Rushing the reps",
        "fix": "Lower for about 1.5-2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk (T12 to C7) from the floor",
        "setup": "≈6°",
        "peak": "≈36° (C7 up 16.2 cm)",
        "norm": "Shoulder blades clear the mat as in a crunch (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈-3° (slight lordosis)",
        "peak": "≈-1° (low back stays on the mat)",
        "norm": "Small: about 3 degrees of lumbar flexion in a crunch, cited by Escamilla 2016 from earlier work",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈19° (resting curve)",
        "peak": "≈52° (+33°)",
        "norm": "Most of the curl happens here (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Legs (frog position)",
        "setup": "Hip flexion ≈37°, abduction ≈42°, external rotation ≈40°; knees ≈120°, 75 cm apart; soles 35° from facing straight in",
        "peak": "Unchanged (pelvis and legs still)",
        "norm": "Soles together, knees out; the legs stay still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Fingertips behind the head, elbows wide",
        "peak": "Unchanged; the hands only support the head",
        "norm": "Hands support the head only; elbows stay wide (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.0 s up, 0.5 s squeeze, 1.6 s down, 1.1 s rest",
        "norm": "Controlled, about 1 s up and 1.5-2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
