      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press up.",
      "cadence": "About 1.8 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-15 (stop 1-2 reps before form breaks)",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, then a slower lowering, then a weighted vest or a higher box"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet on the bench on the balls of the feet, hands on the floor a little wider than the shoulders, body in one straight line from head to heels."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows back at about 45 degrees, lowering the chest toward the floor as one piece."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Chest a few centimetres above the floor, hips still in line, neck long."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and push the floor away until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep bracing at the top; do not let the hips sag toward the floor."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging (lower back arching)",
        "fix": "Brace the abs and squeeze the glutes: the higher feet make sagging more likely."
      },
      {
        "id": "m2",
        "mistake": "Hips piking up",
        "fix": "Lower the hips into line with the shoulders and ankles."
      },
      {
        "id": "m3",
        "mistake": "Elbows flared straight out",
        "fix": "Tuck the elbows to about 30-45 degrees from the body."
      },
      {
        "id": "m4",
        "mistake": "Head dropping first (nose to the floor)",
        "fix": "Keep the neck long and lead with the chest."
      },
      {
        "id": "m5",
        "mistake": "Feet slipping off the bench",
        "fix": "Use a stable bench against a wall, toes tucked on its top."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈15° on the drawn arm (straight, not locked; rig channel ≈43°)",
        "peak": "≈130° at the bottom (chest 16 cm, head 11 cm above the floor)",
        "norm": "Arms straight but not locked at the top; lab protocols often standardise the bottom at 90 degrees of elbow flexion (Zhang 2023); lowering the chest close to the floor takes the elbows further (clinical opinion)",
        "sources": [
          "zhang2023"
        ]
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "≈26°",
        "peak": "≈34° at the bottom",
        "norm": "About 30-45 degrees from the body at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body angle",
        "setup": "Trunk ≈2° from horizontal at the top (feet on a 45 cm bench)",
        "peak": "≈11° head-down at the bottom; trunk-to-leg bend 0.0°",
        "norm": "Feet higher than the hands: the body slopes down toward the head; higher feet raise the load on the hands (Wurm et al.)",
        "sources": [
          "wurm2010"
        ]
      },
      {
        "measure": "Hand width",
        "setup": "Wrists 50 cm apart (shoulder joints 38 cm): about 131% of shoulder width",
        "peak": "Unchanged (hands planted)",
        "norm": "Shoulder width or a little wider (Kim 2016)",
        "sources": [
          "kim2016"
        ]
      },
      {
        "measure": "Load on the hands",
        "setup": "Feet 45 cm up: between the measured 70% (30.5 cm) and 74% (61 cm) of body mass, roughly 72% by straight-line interpolation (estimate)",
        "peak": "–",
        "norm": "Peak hand force 64% of body mass on the floor, 70% (feet on 30.5 cm) and 74% (61 cm) (Wurm et al., Ebben lab)",
        "sources": [
          "wurm2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up; the force study used a 2 s repetition (Wurm et al.)",
        "sources": [
          "wurm2010"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #027912, Decline Push-Up, video (movement reference)",
        "url": "https://gymvisual.com/videos/927-decline-push-up.html"
      },
      {
        "id": "wurm2010",
        "title": "Wurm, VanderZanden, Spadavecchia, Durocher, Bickham, Petushek and Ebben, kinetic analysis of several variations of push-ups (ISBS 2010 conference proceedings; peak hand force 64% of body mass for a regular push-up, 70% and 74% with the feet on 30.5 cm and 61 cm boxes)",
        "url": "https://ojs.ub.uni-konstanz.de/cpa/article/view/4457"
      },
      {
        "id": "zhang2023",
        "title": "Zhang, Dong, Zhao, Hou, Chen et al. 2023, joint loading and muscle activation of the upper body in incline/decline push-up variants by AnyBody modelling (Research Square preprint rs-3344478, not peer reviewed)",
        "url": "https://www.researchsquare.com/article/rs-3344478/v1"
      },
      {
        "id": "kim2016",
        "title": "Kim, Kim and Ha 2016, effect of the push-up exercise at different palmar width on muscle activities (J Phys Ther Sci 28(2):446-449; PMC4792988)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4792988/"
      }
    ],
    "safety": {
      "cautions": [
        "Wrist pain: the planted palm bends the wrist back about 80-90 degrees; use push-up handles or hex dumbbells to keep the wrists straight, or stop if pain persists (clinical opinion).",
        "Shoulder pain: keep the elbows tucked rather than flared out to the sides, and shorten the range if needed (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a bench or box that cannot slide or tip, and get in and out of the position with control."
      ],
      "modify": [
        "Too hard: use a lower box (30 cm) or go back to the floor push-up.",
        "Wrist pain: hold hex dumbbells or push-up handles."
      ],
      "regressions": [
        "Floor push-up.",
        "Feet on a low step."
      ],
      "progressions": [
        "Higher box.",
        "Weighted vest.",
        "Pike push-up for more shoulder work."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher, at a higher load than the floor push-up: peak hand force rose from about 64% of body mass on the floor to 70% and 74% with the feet on 30.5 cm and 61 cm boxes (Wurm et al., Ebben lab). The steeper body angle shifts the work toward the upper chest (clinical opinion).",
      "pec_l": "Main pusher, at a higher load than the floor push-up: peak hand force rose from about 64% of body mass on the floor to 70% and 74% with the feet on 30.5 cm and 61 cm boxes (Wurm et al., Ebben lab). The steeper body angle shifts the work toward the upper chest (clinical opinion).",
      "triceps_r": "Straightens the elbows on the way up and brakes them on the way down.",
      "triceps_l": "Straightens the elbows on the way up and brakes them on the way down.",
      "ant_deltoid_r": "Works harder as the feet go up and the press turns more overhead (clinical opinion; modelled shoulder loading rose with decline in Zhang 2023, preprint).",
      "ant_deltoid_l": "Works harder as the feet go up and the press turns more overhead (clinical opinion; modelled shoulder loading rose with decline in Zhang 2023, preprint).",
      "serratus_r": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "serratus_l": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "core": "Bracing keeps the hips from sagging or piking: the body moves as one plank.",
      "obliques_r": "Help hold the trunk rigid and level.",
      "obliques_l": "Help hold the trunk rigid and level.",
      "rhomboids_midtrap_r": "Control the shoulder blades as they draw together on the way down.",
      "rhomboids_midtrap_l": "Control the shoulder blades as they draw together on the way down.",
      "infraspinatus_r": "Keeps the head of the upper arm centred as the elbows bend.",
      "infraspinatus_l": "Keeps the head of the upper arm centred as the elbows bend.",
      "glute_max_r": "Squeezed lightly to keep the pelvis in line (no sag).",
      "glute_max_l": "Squeezed lightly to keep the pelvis in line (no sag).",
      "quads_r": "Keep the knees straight so the legs stay part of the plank.",
      "quads_l": "Keep the knees straight so the legs stay part of the plank.",
      "spinal_extensors_r": "Hold a long, neutral spine and neck.",
      "spinal_extensors_l": "Hold a long, neutral spine and neck."
    }
  },
