  "exercise": {
    "id": "resistance-band-standing-balance-glute-kickback",
    "name": "Resistance Band Standing Balance Glute Kickback",
    "aliases": [
      "Mini band single-leg balance kickback",
      "Banded standing glute kickback"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "18906",
      "title": "Resistance Band Standing Balance Glute Kickback (version 2)",
      "url": "https://gymvisual.com/videos/18906-resistance-band-standing-balance-glute-kickback-version-2-male.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus maximus)",
    "secondaryBodyParts": [
      "Thighs",
      "Core"
    ],
    "equipment": [
      "Resistance band (mini loop above the knees)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (hip extension) with single-leg balance",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r"
      ],
      "synergist": [
        "hamstrings_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "glute_max_l",
        "quads_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "lengthened": [
        "hip_flexors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg drives back, inhale as it returns.",
      "cadence": "About 1.2 s back, 0.5 s squeeze, 1.8 s forward"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Stronger band or a longer squeeze"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Band above the knees; hinge into a quarter squat on the left leg, hands on the hips."
      },
      {
        "id": "c2",
        "phase": "back",
        "text": "Breathe out and drive the right knee back against the band."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the glute; ribs down, no low-back arch."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and bring the knee back under the hip slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay balanced in the squat; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to kick higher",
        "fix": "Stop when the hip is fully open; the range is small."
      },
      {
        "id": "m2",
        "mistake": "Standing up out of the squat",
        "fix": "Keep the stance knee bent."
      },
      {
        "id": "m3",
        "mistake": "Swinging",
        "fix": "Pause at the back and return slower."
      },
      {
        "id": "m4",
        "mistake": "Twisting the pelvis open",
        "fix": "Keep both hip bones facing the floor."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip extension",
        "setup": "Hip ≈37° flexion (knee under the hip)",
        "peak": "Hip ≈18° extension (channel); thigh 43° behind vertical",
        "norm": "Hip to about 10-20 degrees of extension past neutral; with the trunk hinged the thigh ends well behind vertical (clinical opinion); hip extension exercises excite the gluteus maximus (Macadam 2019; Neto 2020)",
        "sources": [
          "macadam2019",
          "neto2020"
        ]
      },
      {
        "measure": "Stance leg",
        "setup": "Knee ≈25°, trunk ≈20° forward",
        "peak": "Held",
        "norm": "Quarter squat, trunk hinged about 25 degrees (clinical opinion)",
        "sources": [
          "boren2011"
        ]
      },
      {
        "measure": "Band",
        "setup": "Above both knees (21 cm apart)",
        "peak": "Stretched to 39 cm",
        "norm": "Mini loop above the knees (elastic resistance, Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Balance 0.8 s",
        "peak": "1.2 s back, 0.5 s squeeze, 1.8 s forward",
        "norm": "Controlled, squeeze at the back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
