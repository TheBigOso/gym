    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the band for nicks before use."
      ],
      "modify": [
        "Poor balance: one hand on a wall.",
        "Low-back discomfort: smaller range."
      ],
      "regressions": [
        "Standing hip extension without a band.",
        "Donkey kick."
      ],
      "progressions": [
        "Heavier band.",
        "Cable donkey kickback."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Drives hip extension against the band (Macadam 2019; Neto 2020).",
      "hamstrings_r": "Assist hip extension (clinical opinion).",
      "glute_med_l": "Keeps the pelvis level on the stance leg (Boren 2011).",
      "glute_max_l": "Holds the stance hip in the quarter squat (clinical opinion).",
      "quads_l": "Hold the stance knee bent (clinical opinion).",
      "core": "Stops the low back arching (clinical opinion).",
      "spinal_extensors_r": "Hold the hinged trunk (clinical opinion).",
      "spinal_extensors_l": "Hold the hinged trunk (clinical opinion).",
      "hip_flexors_r": "Lengthen at the back of the kick (clinical opinion)."
    }
