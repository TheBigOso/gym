  "exercise": {
    "id": "kneeling-plank",
    "name": "Kneeling Plank",
    "aliases": [
      "Knee plank",
      "Modified plank",
      "Forearm plank on the knees",
      "Half plank"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "10391",
      "title": "Kneeling plank (male)",
      "url": "https://gymvisual.com/videos/10391-kneeling-plank-male.html",
      "listing": "GymVisual page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching knowledge",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Shoulders (serratus, anterior deltoid)",
      "Hips (glutes)"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isometric (anti-extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "serratus_r",
        "serratus_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "pec_r",
        "pec_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "triceps_r",
        "triceps_l",
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily through the hold with the brace on; do not hold the breath.",
      "cadence": "About one breath every 3 s during the 9 s hold"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "1 hold per set",
      "tempo": "Hold 10-30 s, build toward 60 s",
      "frequency": "2-4 times a week",
      "progression": "Longer holds, then the full front plank on the toes"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Forearms flat on the mat, elbows under the shoulders, knees down hip width, hips sitting back a little, toes tucked."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Brace the stomach, squeeze the glutes and roll the hips forward until shoulders, hips and knees make one line."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Push the floor away with the forearms, keep the hips level and breathe steadily."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Sit the hips back under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips left high and behind the knees (piked)",
        "fix": "Roll the hips forward until shoulder, hip and knee line up."
      },
      {
        "id": "m2",
        "mistake": "Low back sagging",
        "fix": "Brace and squeeze the glutes; tilt the pelvis slightly under."
      },
      {
        "id": "m3",
        "mistake": "Elbows far in front of the shoulders",
        "fix": "Stack the elbows under the shoulders."
      },
      {
        "id": "m4",
        "mistake": "Head hanging or craning up",
        "fix": "Look at the mat just ahead of the hands; neck long."
      }
    ],
    "kinematics": [
      {
        "measure": "Body line (shoulder-hip-knee)",
        "setup": "Hips back: ≈64° off straight (shoulder-hip-knee)",
        "peak": "≈14° off straight",
        "norm": "Straight line from shoulders through hips to knees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow position",
        "setup": "On the mat, shoulders 12 cm behind the elbows",
        "peak": "Directly under the shoulders, 40 cm apart",
        "norm": "Elbows directly below the shoulders, as in the forearm plank (Schoenfeld 2014 set-up)",
        "sources": [
          "schoenfeld2014"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈57°",
        "peak": "≈0°",
        "norm": "From sitting back to neutral (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈67°, knees on the mat, toes tucked",
        "peak": "≈37°",
        "norm": "Knees on the mat; the knee-supported plank roughly halves abdominal activity compared with the full plank (Escamilla 2016)",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Trunk angle to the floor",
        "setup": "≈3°",
        "peak": "≈24°",
        "norm": "Steeper than the full plank because the knees are the base (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "1 s hips back",
        "peak": "1 s into line, 9 s hold with breathing settles, 1 s back, 1 s rest",
        "norm": "Short holds of 10-30 s for beginners (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #10391, Kneeling plank (male), video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/10391-kneeling-plank-male.html"
      },
      {
        "id": "escamilla2016",
        "title": "Escamilla, Lewis, Pecson, Imamura and Andrews 2016, muscle activation among supine, prone and side position exercises with and without a Swiss ball (Sports Health 8(4):372-379; PMC4922527)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4922527"
      },
      {
        "id": "schoenfeld2014",
        "title": "Schoenfeld et al. 2014, an electromyographic comparison of a modified version of the plank with a long lever and posterior tilt versus the traditional plank exercise (Sports Biomechanics, doi 10.1080/14763141.2014.942355)",
        "url": "https://bretcontreras.com/wp-content/uploads/An-electromyographic-comparison-of-a-modified-version-of-the-plank-with-a-long-lever-and-posterior-tilt-versus-the-traditional-plank-exercise.pdf"
      },
      {
        "id": "ekstrom2007",
        "title": "Ekstrom, Donatelli and Carp 2007, electromyographic analysis of core trunk, hip and thigh muscles during 9 rehabilitation exercises (J Orthop Sports Phys Ther 37(12):754-762; PubMed 18560185)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/18560185/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low back pain that increases in the plank: shorten the hold or drop to the knee plank.",
        "High blood pressure: breathe steadily; long breath-held efforts raise blood pressure."
      ],
      "modify": [
        "Shoulder discomfort: hands together (forearms in a slight V) or an incline plank with the forearms on a bench.",
        "Elbow discomfort: fold the mat under the forearms."
      ],
      "regressions": [
        "Incline plank with the forearms on a bench.",
        "Shorter holds (5-10 s)."
      ],
      "progressions": [
        "Longer holds.",
        "Front plank on the toes.",
        "Kneeling plank with one arm reaching forward."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis and the deep abdominals resist the hips sagging; the knee base shortens the lever so the load is about half the full plank (Escamilla 2016).",
      "obliques_r": "External obliques share the anti-extension work with the rectus abdominis (clinical opinion).",
      "obliques_l": "External obliques share the anti-extension work with the rectus abdominis (clinical opinion).",
      "glute_max_r": "Glutes hold the hips forward in line with the knees (clinical opinion).",
      "glute_max_l": "Glutes hold the hips forward in line with the knees (clinical opinion)."
    }
  },
