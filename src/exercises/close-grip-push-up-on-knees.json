    "safety": {
      "cautions": [
        "Wrist pain: the planted palm bends the wrist back about 80-90 degrees; use push-up handles or hex dumbbells to keep the wrists straight, or stop if pain persists (clinical opinion).",
        "Knee discomfort: kneel on a mat or folded towel.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrist or elbow discomfort: hands slightly wider.",
        "Too hard: hands on a bench."
      ],
      "regressions": [
        "Incline close-grip push-up.",
        "Wall close-grip push-up."
      ],
      "progressions": [
        "Close-grip push-up on the toes.",
        "Diamond push-up on the knees."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher with the front deltoids: flexes and adducts the upper arm as the body rises.",
      "pec_l": "Main pusher with the front deltoids: flexes and adducts the upper arm as the body rises.",
      "triceps_r": "Straightens the elbows; narrow hands raise its share (Kim 2016).",
      "triceps_l": "Straightens the elbows; narrow hands raise its share (Kim 2016).",
      "ant_deltoid_r": "Flexes the shoulder with the chest muscles.",
      "ant_deltoid_l": "Flexes the shoulder with the chest muscles.",
      "serratus_r": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "serratus_l": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "core": "Bracing keeps the hips from sagging or piking.",
      "obliques_r": "Help hold the trunk rigid and level.",
      "obliques_l": "Help hold the trunk rigid and level.",
      "rhomboids_midtrap_r": "Control the shoulder blades as they draw together on the way down.",
      "rhomboids_midtrap_l": "Control the shoulder blades as they draw together on the way down.",
      "infraspinatus_r": "Keeps the head of the upper arm centred as the elbows bend.",
      "infraspinatus_l": "Keeps the head of the upper arm centred as the elbows bend.",
      "glute_max_r": "Squeezed lightly to keep the hips in line with the knees and shoulders.",
      "glute_max_l": "Squeezed lightly to keep the hips in line with the knees and shoulders.",
      "quads_r": "Keep the knees straight so the legs stay part of the plank.",
      "quads_l": "Keep the knees straight so the legs stay part of the plank.",
      "spinal_extensors_r": "Hold a long, neutral spine and neck.",
      "spinal_extensors_l": "Hold a long, neutral spine and neck."
    }
