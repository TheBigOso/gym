        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press up.",
      "cadence": "About 1.8 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, then the close-grip push-up on the toes"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Knees on the mat behind the hips, shins down; hands under the chest, closer than shoulder width; knees, hips and shoulders in one line."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the chest toward the hands, elbows brushing back along the ribs."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Chest just above the hands, elbows pointing back."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the floor away until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hips in line at the top; go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips piking up (bottom stuck out)",
        "fix": "Push the hips forward until knees, hips and shoulders line up."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows close to the ribs."
      },
      {
        "id": "m3",
        "mistake": "Knees too close to the hands",
        "fix": "Walk the hands forward so the body is a long ramp from the knees."
      },
      {
        "id": "m4",
        "mistake": "Kneeling on a hard floor",
        "fix": "Use a mat or a folded towel under the knees."
      }
    ],
    "kinematics": [
      {
        "measure": "Hand width",
        "setup": "Wrists 22 cm apart (shoulder joints 40 cm): about 55% of shoulder width; knees 73 cm behind the wrists",
        "peak": "Unchanged (hands planted)",
        "norm": "Inside shoulder width; 50% of shoulder width raised triceps activity versus wider hands (Kim 2016)",
        "sources": [
          "kim2016"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈9° (arms straight, not locked)",
        "peak": "≈118° at the bottom (chest 10 cm above the floor)",
        "norm": "Arms straight but not locked at the top; elbows bend to about 90 degrees or more at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "≈-13° (arms near vertical)",
        "peak": "≈7° at the bottom",
        "norm": "Elbows close to the ribs, about 10-30 degrees from the body at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line",
        "setup": "Trunk ≈42° above horizontal; trunk-to-leg bend 0.1°",
        "peak": "Trunk ≈21°; bend -0.3°",
        "norm": "Head, trunk, hips and ankles (or knees) in one straight line throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Wrist extension",
        "setup": "≈83°",
        "peak": "≈54° at the bottom",
        "norm": "Palms flat; the wrist bends back about 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up; lab studies used 2-2.5 s per repetition (Marcolin 2015)",
        "sources": [
          "marcolin2015"
        ]
      }
    ],
    "sources": [
