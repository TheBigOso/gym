      },
      {
        "id": "lehman2004",
        "title": "Lehman et al. 2004, variations in muscle activation levels during traditional latissimus dorsi weight training exercises (Dynamic Medicine 3:4)",
        "url": "https://link.springer.com/article/10.1186/1476-5918-3-4"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: the level trunk loads the back heavily; a bench-supported row is gentler (Fenwick 2009)."
      ],
      "modify": [
        "Tight hamstrings: bend the knees more or set the dumbbells on low blocks."
      ],
      "regressions": [
        "Chest-supported dumbbell row.",
        "Dumbbell bent-over row with a more upright trunk."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Single-arm Pendlay row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Main shoulder extensor: pulls the elbow from below the shoulder back beside the trunk.",
      "lats_l": "Main shoulder extensor: pulls the elbow from below the shoulder back beside the trunk.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blade back at the top; rows gave the highest middle trapezius/rhomboid activity of the pulls tested by Lehman 2004.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blade back at the top; rows gave the highest middle trapezius/rhomboid activity of the pulls tested by Lehman 2004.",
      "post_deltoid_r": "Helps extend the shoulder as the elbow passes the trunk.",
      "post_deltoid_l": "Helps extend the shoulder as the elbow passes the trunk.",
      "biceps_r": "Flexes the elbow; the neutral grip shares the work with brachialis and brachioradialis.",
      "biceps_l": "Flexes the elbow; the neutral grip shares the work with brachialis and brachioradialis.",
      "forearm_flexors_r": "Grip the dumbbell.",
      "forearm_flexors_l": "Grip the dumbbell.",
      "spinal_extensors_r": "Hold the trunk near level with a flat back for every rep; the standing bent-over row placed the highest lumbar load of the rows in Fenwick 2009.",
      "spinal_extensors_l": "Hold the trunk near level with a flat back for every rep; the standing bent-over row placed the highest lumbar load of the rows in Fenwick 2009.",
      "hamstrings_r": "Hold the hinge (isometric).",
      "hamstrings_l": "Hold the hinge (isometric).",
      "glute_max_r": "Hold the hips back.",
      "glute_max_l": "Hold the hips back.",
      "core": "Re-brace at every dead stop."
    }
