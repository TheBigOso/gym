      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength / power",
    "bodyPart": "Back (lats and mid-back)",
    "secondaryBodyParts": [
      "Shoulders (rear deltoid)",
      "Upper arms (biceps)",
      "Lower back (isometric)",
      "Hamstrings (isometric)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder extension, scapular retraction, elbow flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "hamstrings_r",
        "hamstrings_l",
        "glute_max_r",
        "glute_max_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Brace at the dead stop, exhale through the fast pull, inhale as you lower to the floor.",
      "cadence": "About 0.6 s up, short squeeze, 1.2 s down, 1.2 s dead stop"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "5-8",
      "tempo": "Explosive up, 1 s down, dead stop on the floor",
      "load": "User-chosen dumbbells; stop about 2 reps short of failure (RIR 2) or when the trunk starts to rise",
      "frequency": "1-2 times a week",
      "progression": "Add load, keeping the trunk still"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hinge until the back is nearly level, knees bent, dumbbells resting on the floor under the shoulders; brace."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Row both dumbbells fast to the lower ribs, elbows driving back; the trunk does not move."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the shoulder blades together for a moment."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower under control until the dumbbells touch the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Dead stop: let the dumbbells rest on the floor, re-brace, then pull again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the chest to swing the weight up",
        "fix": "The back stays level; only the arms and shoulder blades move."
      },
      {
        "id": "m2",
        "mistake": "Bouncing the dumbbells off the floor",
        "fix": "Come to a full stop on every rep."
      },
      {
        "id": "m3",
        "mistake": "Rounding the back to reach the floor",
        "fix": "Bend the knees more so the dumbbells reach the floor with a flat back."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk angle",
        "setup": "≈14° above horizontal (hip channel 136°), spine neutral",
        "peak": "Unchanged (held)",
        "norm": "Back nearly level, held still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈63° (sets the dumbbells on the floor)",
        "peak": "Unchanged",
        "norm": "Knees bent enough for the dumbbells to reach the floor with a flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈2°, dumbbells resting on the floor",
        "peak": "≈124°, shoulder blades retracted (clavicle protraction 26° to -14°)",
        "norm": "From straight to about 90 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Dead stop 0.8 s",
        "peak": "0.6 s up, 0.2 s squeeze, 1.2 s down, 2 s dead stop on the floor",
        "norm": "Fast pull, controlled lowering, full stop on the floor (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
