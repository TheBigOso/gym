    },
    "type": "Strength",
    "bodyPart": "Core (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Shoulders",
      "Quadriceps"
    ],
    "equipment": [
      "Gymnastic rings or suspension straps (foot cradles)",
      "Pull-up bar (anchor)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip and knee; shoulders braced)",
    "plane": "Sagittal",
    "laterality": "Alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "serratus_r",
        "serratus_l",
        "triceps_r",
        "triceps_l",
        "pec_r",
        "pec_l",
        "glute_max_r",
        "glute_max_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out with each knee drive, breathe in as the leg goes back.",
      "cadence": "One knee drive about every 0.8 s"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-20 per side or 20-40 s",
      "tempo": "Controlled",
      "load": "Bodyweight",
      "frequency": "2-3 times a week",
      "progression": "Longer sets, then faster drives with the hips still level"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet in the cradles under the anchor, hands under the shoulders: high plank, body straight."
      },
      {
        "id": "c2",
        "phase": "right",
        "text": "Breathe out and drive the right knee toward the chest; the foot rides forward in its strap."
      },
      {
        "id": "c3",
        "phase": "left",
        "text": "Return the right leg and drive the left knee in."
      },
      {
        "id": "c4",
        "phase": "reset",
        "text": "Keep the hips level and the shoulders over the hands; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips piking up",
        "fix": "Keep the hips level with the shoulders."
      },
      {
        "id": "m2",
        "mistake": "Swinging the straps",
        "fix": "Drive the knee in and out under control so the feet do not bounce."
      },
      {
        "id": "m3",
        "mistake": "Shoulders behind the hands",
        "fix": "Keep the shoulders over the wrists."
      },
      {
        "id": "m4",
        "mistake": "Holding the breath",
        "fix": "Breathe out with each drive."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "Both legs straight in the plank",
        "peak": "Driving hip ≈78°, knee ≈135°, the foot 50.6 cm forward",
        "norm": "The driving hip bends to about 75-100 degrees with the knee tucked under the body (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Trunk 8° from horizontal (feet 48 cm up)",
        "peak": "Unchanged: hips level while the knees drive",
        "norm": "Trunk stays level, close to a plank; suspension raises the trunk-muscle demand of plank work (clinical opinion; Schoenfeld 2014 for plank variants)",
        "sources": [
          "schoenfeld2014"
        ]
      },
      {
        "measure": "Straps",
        "setup": "One strap per foot, 167.5 cm",
        "peak": "The driving foot rises 4 cm on its strap arc; straps at least 12.7 cm off the body",
        "norm": "Each foot strap stays taut; the moving foot swings on its strap arc (geometry)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Plank 0.4 s",
        "peak": "0.8 s per knee drive and return",
        "norm": "One drive about every 0.8 s, controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
