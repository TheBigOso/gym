    "breathing": {
      "pattern": "Breathe in at the bottom of the short range, breathe out as you drive the hips up, hold briefly at the top.",
      "cadence": "About 1 s up, 0.8 s squeeze, 1.5 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-15",
      "tempo": "1-1-2-0",
      "frequency": "1-2 times a week",
      "load": "Barbell load is user-chosen: you can use about as much as in a hip thrust; use a bar pad. Leave about 2-3 reps in reserve (RPE 7-8).",
      "rest": "90 s between sets",
      "progression": "Heavier bar, then a longer squeeze at the top."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Upper back on the bench (higher on the pad than a hip thrust, just below the shoulder blades), bar with a pad on the hip crease, feet flat about hip width, knees above the ankles at the top."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Chin tucked, ribs down: the hips rise only from a little below level to level; the upper back stays still on the bench instead of rolling."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Hard glute squeeze at the top, pelvis tucked under."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower only a short way, keeping tension in the glutes; the bar never touches the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Next rep straight away."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Turning it into a full hip thrust",
        "fix": "Lower only until the hips are a little below the knees and the shoulders; keep the upper back still."
      },
      {
        "id": "m2",
        "mistake": "Arching the lower back at the top",
        "fix": "Tuck the chin and pelvis; finish with the glutes."
      },
      {
        "id": "m3",
        "mistake": "Feet too far out or too close",
        "fix": "Set the feet so the shins are vertical at the top."
      },
      {
        "id": "m4",
        "mistake": "Rocking the trunk on the bench",
        "fix": "Keep the trunk fixed and move only at the hips."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench height",
        "setup": "42 cm",
        "peak": "Upper back (just below the shoulder blades) pivots on the edge through about 20°",
        "norm": "About knee height (common coaching)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈33° at the bottom of the short range (buttocks 29.2 cm off the floor)",
        "peak": "≈-5° at the top, pelvis tucked",
        "norm": "Short range near full hip extension (Contreras 2015)",
        "sources": [
          "contreras2015"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈111° at the bottom",
        "peak": "≈95° (knees over the ankles); feet 26 cm apart",
        "norm": "About 90 degrees at the top, knees above the ankles (common coaching)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈20° below level",
        "peak": "≈4° (level)",
        "norm": "Trunk stays fixed on the bench; the hips move (common coaching)",
        "sources": []
      },
      {
        "measure": "Bar position",
        "setup": "Across the hip crease, 68 cm overhand grip; plates 29.52 cm or more off the floor",
        "peak": "Rides on the hips, 12.2 cm of hip travel",
        "norm": "Bar across the hip crease, padded (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hips a little below level 0.6 s",
        "peak": "1.0 s up, 0.8 s squeeze, 1.5 s down, 0.6 s reset",
        "norm": "Short controlled reps with a squeeze (clinical opinion)",
        "sources": []
      }
    ],
