      },
      {
        "id": "ekstrom2003",
        "title": "Ekstrom, Donatelli & Soderberg 2003, surface electromyographic analysis of exercises for the trapezius and serratus anterior muscles (J Orthop Sports Phys Ther 33(5):247-258)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/12774999/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Shoulder pain at the front of the joint: lower the arms a little toward the body or shorten the hold.",
        "Neck discomfort: rest the forehead on a folded towel."
      ],
      "modify": [
        "Forehead on a folded towel.",
        "Bend the elbows to 90 degrees (shorter lever)."
      ],
      "regressions": [
        "Seated scapula adduction.",
        "Band pull-apart."
      ],
      "progressions": [
        "Light weights in the hands.",
        "Incline bench T raise.",
        "Y and W raises."
      ]
    },
    "muscleNotes": {
      "rhomboids_midtrap_r": "Middle trapezius and rhomboids retract the shoulder blade; prone horizontal abduction with external rotation was among the best middle-trapezius exercises (Ekstrom 2003).",
      "rhomboids_midtrap_l": "Middle trapezius and rhomboids retract the shoulder blade (Ekstrom 2003).",
      "post_deltoid_r": "Posterior deltoid lifts the straight arm in horizontal abduction.",
      "post_deltoid_l": "Posterior deltoid lifts the straight arm in horizontal abduction.",
      "infraspinatus_r": "Holds the thumbs-up (externally rotated) arm.",
      "infraspinatus_l": "Holds the thumbs-up (externally rotated) arm.",
      "lat_deltoid_r": "Helps hold the arm out at shoulder level.",
      "lat_deltoid_l": "Helps hold the arm out at shoulder level.",
      "spinal_extensors_r": "Keep the upper back from rounding.",
      "spinal_extensors_l": "Keep the upper back from rounding.",
      "upper_traps_r": "Should stay quiet: shoulders away from the ears.",
      "upper_traps_l": "Should stay quiet: shoulders away from the ears."
    }
