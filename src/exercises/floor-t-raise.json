  "exercise": {
    "id": "floor-t-raise",
    "name": "Floor T Raise",
    "aliases": [
      "Prone T raise",
      "Prone T",
      "Lying T raise (floor)",
      "Prone horizontal abduction"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "13818",
      "title": "Floor T Raise",
      "url": "https://gymvisual.com/videos/13818-floor-t-raise-male.html",
      "listing": "Video (movement reference; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper back (middle trapezius, rhomboids) and rear shoulders",
    "secondaryBodyParts": [
      "Shoulders (rotator cuff)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder horizontal abduction with scapular retraction, prone)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "synergist": [
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "lengthened": [
        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the arms lift, breathe steadily in the hold, in as they lower.",
      "cadence": "About 1 s up, 2 s hold, 1 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "About 1 s up, 2 s hold, 1 s down",
      "load": "Body weight (light plates or dumbbells later)",
      "frequency": "2-4 times a week",
      "progression": "Longer holds, then light weights in the hands, then the incline-bench T raise"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down, forehead just off the mat, arms straight out to the sides in a T, thumbs up."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Squeeze the shoulder blades back and together and lift the straight arms off the mat."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold, shoulders away from the ears, neck long."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the arms slowly to the mat."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Relax for a moment, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shrugging the shoulders up",
        "fix": "Draw the shoulder blades down and back before lifting."
      },
      {
        "id": "m2",
        "mistake": "Lifting the head and chest",
        "fix": "Keep the forehead near the mat; only the arms lift."
      },
      {
        "id": "m3",
        "mistake": "Bending the elbows",
        "fix": "Keep the arms long."
      },
      {
        "id": "m4",
        "mistake": "Swinging the arms up",
        "fix": "Lift slowly and hold."
      }
    ],
    "kinematics": [
      {
        "measure": "Arm position",
        "setup": "Shoulder elevation 90° (arm out to the side), thumbs up",
        "peak": "Arms 88-90° from the long axis of the body (T)",
        "norm": "Arms out at about 90 degrees from the body (T), thumbs up (Ekstrom 2003 prone horizontal abduction)",
        "sources": [
          "ekstrom2003"
        ]
      },
      {
        "measure": "Arm lift",
        "setup": "Hands resting on the mat",
        "peak": "Hands 9.7 cm off the mat (horizontal abduction: plane 4.9° to 17.6°)",
        "norm": "Hands a few to about 10 cm off the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blade retraction",
        "setup": "Clavicle protraction 2°",
        "peak": "-14.8° (17° of retraction)",
        "norm": "Shoulder blades squeeze back and together (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Chest and pelvis on the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Chest and pelvis stay on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 1 s",
        "peak": "1 s up, 2 s hold, 1 s down, 1 s rest",
        "norm": "About 1 s up, 2 s hold, 1 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 13818, Floor T Raise, video (movement reference)",
