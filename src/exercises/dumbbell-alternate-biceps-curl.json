    "name": "Dumbbell Alternate Biceps Curl",
    "aliases": [
      "Alternating dumbbell curl",
      "Alternate curl with supination"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "028512",
      "title": "Dumbbell Alternate Biceps Curl",
      "url": "https://gymvisual.com/videos/906-dumbbell-alternate-biceps-curl.html",
      "listing": "Video; data sheet: body part Upper Arms, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "equipment": [
      "Dumbbell"
    ],
    "laterality": "Unilateral, alternating (right then left in one loop)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale on each curl, inhale as each dumbbell lowers.",
      "cadence": "Per arm: about 1.1 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12 per arm",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall with a dumbbell in each hand at your sides, palms facing in (neutral)."
      },
      {
        "id": "c2",
        "phase": "rightUp",
        "text": "Breathe out and curl the right dumbbell, turning the palm up as it rises; elbow stays by your side."
      },
      {
        "id": "c3",
        "phase": "rightTop",
        "text": "Squeeze at the top, little finger turned up slightly."
      },
      {
        "id": "c4",
        "phase": "rightDown",
        "text": "Lower slowly, turning the palm back in at the bottom."
      },
      {
        "id": "c5",
        "phase": "leftUp",
        "text": "Now the left: curl and turn the palm up while the right arm stays still."
      },
      {
        "id": "c6",
        "phase": "leftTop",
        "text": "Squeeze at the top."
      },
      {
        "id": "c7",
        "phase": "leftDown",
        "text": "Lower slowly to a straight arm, palm back to neutral."
      },
      {
        "id": "c8",
        "phase": "reset",
        "text": "Both arms straight; repeat, alternating sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the hips and leaning back to heave the weight",
        "fix": "Lighten the dumbbell; stand tall with the glutes and abs braced."
      },
      {
        "id": "m2",
        "mistake": "Elbows drifting forward or flaring out",
        "fix": "Keep the elbows by the sides; only the forearms move."
      },
      {
        "id": "m3",
        "mistake": "Dropping the weight on the way down",
        "fix": "Take 2-3 s to lower all the way to straight arms."
      },
      {
        "id": "m4",
        "mistake": "Half reps (stopping short at the bottom)",
        "fix": "Straighten the elbow at the bottom of every rep."
      },
      {
        "id": "m5",
        "mistake": "Twisting the trunk toward the working arm",
        "fix": "Keep the shoulders and hips square to the front."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈8° (arm straight)",
        "peak": "≈137° at the top (range ≈129°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "85° (neutral, thumb up)",
        "peak": "-5° (palm forward/up)",
        "norm": "Grip changes the biceps/brachioradialis share: the supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-2°",
        "peak": "≈11° (elbow forward)",
        "norm": "Elbows stay near the sides; a small forward drift at the top is normal, a big swing shifts work to the front deltoid (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms straight 0.5 s",
        "peak": "Per arm: 1.1 s up, 0.2 s squeeze, 2.0 s down; right rep then left rep",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #028512, Dumbbell Alternate Biceps Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/906-dumbbell-alternate-biceps-curl.html"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the dumbbell and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Pick the dumbbells up and set them down with a straight back and bent knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Elbow pain: keep the palm neutral (hammer curl) or lighten the load.",
        "Balance or back concerns: sit on a bench with the back supported."
      ],
      "regressions": [
        "Seated alternate curl.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Both arms together (dumbbell biceps curl).",
        "Incline alternate curl.",
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor and forearm supinator: turning the palm from neutral to up as the weight rises uses both of its jobs. Supinated grips gave the highest biceps activity (Coratella 2023).",
      "biceps_l": "Main elbow flexor and forearm supinator: turning the palm from neutral to up as the weight rises uses both of its jobs. Supinated grips gave the highest biceps activity (Coratella 2023).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder so the elbow stays by the side; it rises if the elbow drifts forward.",
      "ant_deltoid_l": "Steadies the shoulder so the elbow stays by the side; it rises if the elbow drifts forward.",
      "core": "Resists the side-to-side pull of one working arm; keep the trunk square.",
      "upper_traps_r": "Hold the shoulder girdle level under the dumbbells.",
      "upper_traps_l": "Hold the shoulder girdle level under the dumbbells."
    }
