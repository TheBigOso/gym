      "listing": "Video; the page could not be read here (blocked), so the movement follows the name and standard coaching (windmill hinge with the dumbbell in the low hand, free arm straight up).",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Hips",
      "Hamstrings",
      "Shoulders"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip hinge with trunk side-bend and rotation; load in the low hand)",
    "plane": "Multiplanar",
    "laterality": "Unilateral (one side at a time)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_l",
        "spinal_extensors_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "obliques_r",
        "glute_med_r",
        "glute_med_l",
        "hamstrings_r",
        "hamstrings_l",
        "core"
      ],
      "stabilizer": [
        "lat_deltoid_l",
        "serratus_l",
        "infraspinatus_l",
        "forearm_flexors_r",
        "lats_r",
        "upper_traps_r"
      ],
      "lengthened": [
        "hamstrings_l",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale and brace before you hinge; breathe out as you stand back up.",
      "cadence": "About 2.4 s down, a short pause, about 2.4 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-10 per side",
      "tempo": "Slow: about 2-3 s down, brief pause, 2-3 s up",
      "frequency": "1-2 times a week",
      "progression": "Dumbbell load is user-chosen: start light; progress to the overhead windmill once the hinge is smooth."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet wider than the hips, both turned about 45 degrees to the right. Dumbbell in the right hand at the thigh; left arm straight up, eyes on the left hand."
      },
      {
        "id": "c2",
        "phase": "down",
        "text": "Push the left hip out and back, then hinge and side-bend to the right; slide the dumbbell down the inside of the right leg."
      },
      {
        "id": "c3",
        "phase": "pause",
        "text": "Pause with the dumbbell near the shin: top arm vertical, chest open, left knee straight, right knee soft."
      },
      {
        "id": "c4",
        "phase": "up",
        "text": "Drive the hips forward and stand back up the same path, eyes on the top hand."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall; finish the set, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back to reach the floor",
        "fix": "Hinge from the hips; mid-shin is plenty."
      },
      {
        "id": "m2",
        "mistake": "Top arm drifting or bending",
        "fix": "Keep it locked and stacked over the shoulder."
      },
      {
        "id": "m3",
        "mistake": "Squatting down instead of hinging",
        "fix": "Push the left hip back; the left knee stays straight."
      },
      {
        "id": "m4",
        "mistake": "Dropping the eyes to the floor",
        "fix": "Eyes on the top hand."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from vertical",
        "setup": "Upright (≈5° from vertical)",
        "peak": "≈75° from vertical (pelvis to C7): hips hinge ≈70°, spine side-bends ≈28° to the right and turns ≈30° open toward the top hand",
        "norm": "Hip hinge with a side-bend and an open chest; no study defines the angles (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Top arm",
        "setup": "Vertical (≈0° off vertical)",
        "peak": "Stays vertical (≈3° max off vertical over the rep)",
        "norm": "Locked and vertical throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hips and knees",
        "setup": "Hips ≈10° R / ≈-2° L; knees ≈7° R / ≈10° L",
        "peak": "Hips ≈100° R / ≈65° L; knees ≈24° R (soft) / ≈11° L (locked)",
        "norm": "The top-arm side knee straight, the dumbbell-side knee soft; the hips hinge (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Low hand (dumbbell)",
        "setup": "Dumbbell hand beside the right thigh, wrist 86 cm up",
        "peak": "Slides to 42 cm above the floor along the inside of the right shin (lowest dumbbell point 24.81 cm)",
        "norm": "Slides down the inside of the front leg toward the shin or foot (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Feet",
        "setup": "Feet 44 cm apart, both turned 40° to the right",
        "peak": "Unchanged (planted)",
        "norm": "Wider than the hips, turned about 45 degrees toward the dumbbell side (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.4 s down, 0.6 s pause, 2.4 s up, 0.8 s at the top",
        "norm": "Slow and controlled, about 2-3 s each way (clinical opinion)",
        "sources": []
      }
    ],
