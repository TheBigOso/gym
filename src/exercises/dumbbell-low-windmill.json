    "safety": {
      "cautions": [
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Low-back pain: keep the range small; the hinge and side-bend combine under load.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Hamstring or groin strain: shorten the range."
      ],
      "modify": [
        "No weight, or the free hand on a box to shorten the range.",
        "Top arm on the hip instead of overhead if the shoulder is sore."
      ],
      "regressions": [
        "Bodyweight windmill.",
        "Dumbbell side bend."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Overhead (high) dumbbell windmill.",
        "Kettlebell windmill."
      ]
    },
    "muscleNotes": {
      "obliques_l": "The obliques on the top-arm side lower the trunk into the side-bend under control and pull it back up (clinical opinion for the windmill; side-lying lateral flexion drove external oblique to about 98% MVC in Konrad 2001).",
      "spinal_extensors_l": "Quadratus lumborum and the erector spinae hold the trunk as it hinges and bends; quadratus lumborum is a primary lateral stabiliser (McGill, Juker and Kropf).",
      "glute_max_r": "Both glutes control the hip hinge and drive the stand-up (clinical opinion).",
      "glute_max_l": "Both glutes control the hip hinge and drive the stand-up (clinical opinion).",
      "obliques_r": "Turn the chest open toward the top hand (clinical opinion).",
      "glute_med_r": "Steadies the pelvis over the planted feet as the hips shift (clinical opinion).",
      "glute_med_l": "Steadies the pelvis over the planted feet as the hips shift (clinical opinion).",
      "hamstrings_r": "Lengthen as the hips hinge over the straight back leg (clinical opinion).",
      "hamstrings_l": "Lengthen as the hips hinge over the straight back leg (clinical opinion).",
      "core": "Keeps the trunk braced (clinical opinion).",
      "lat_deltoid_l": "Holds the empty top arm vertical (clinical opinion).",
      "serratus_l": "Keeps the top shoulder blade rotated up (clinical opinion).",
      "infraspinatus_l": "Centres the top shoulder as the trunk turns under it (clinical opinion).",
      "forearm_flexors_r": "Grip the dumbbell (clinical opinion).",
      "lats_r": "Keep the dumbbell shoulder packed as the weight hangs (clinical opinion).",
      "upper_traps_r": "Hold the shoulder girdle under the hanging dumbbell (clinical opinion)."
    }
