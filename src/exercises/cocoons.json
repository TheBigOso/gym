{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "cocoons",
    "name": "Cocoons",
    "aliases": [
      "Cocoon crunch",
      "Tuck crunch from hollow",
      "Hollow-to-tuck crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5037",
      "title": "Cocoons",
      "url": "https://gymvisual.com/videos/5037-cocoons.html",
      "listing": "Video (movement reference; page could not be read at authoring time, movement taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hips (hip flexors)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk flexion with hip and knee flexion; arms sweep forward)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you tuck, inhale as you open out.",
      "cadence": "About 1 s in, 1.2 s out"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "1-0.5-1.2-0",
      "frequency": "2-3 times a week",
      "progression": "Lower the extended position closer to the floor, then a V-up"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, arms straight overhead, legs long."
      },
      {
        "id": "c2",
        "phase": "hollow",
        "text": "Brace and lift the arms, shoulders and heels just off the mat."
      },
      {
        "id": "c3",
        "phase": "tuck",
        "text": "Curl up: knees to the chest, arms sweep over to hug around the shins."
      },
      {
        "id": "c4",
        "phase": "hold",
        "text": "Squeeze tight like a cocoon, balanced on the hips."
      },
      {
        "id": "c5",
        "phase": "extend",
        "text": "Open out long again to the hollow, heels and hands hovering."
      },
      {
        "id": "c6",
        "phase": "lower",
        "text": "Lower to the mat and rest."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching in the extended position",
        "fix": "Keep the legs higher and the low back pressed down."
      },
      {
        "id": "m2",
        "mistake": "Throwing the arms to generate momentum",
        "fix": "Move arms and legs together under control."
      },
      {
        "id": "m3",
        "mistake": "Pulling on the neck",
        "fix": "Let the chest lead; keep the chin slightly tucked."
      },
      {
        "id": "m4",
        "mistake": "Feet slamming down between reps",
        "fix": "Stay in the hollow between reps."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk from the floor",
        "setup": "≈-5° lying, ≈9° in the hollow",
        "peak": "≈46° in the tuck (balanced on the buttock)",
        "norm": "Shoulders curl well off the mat in the tuck (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈18° in the hollow",
        "peak": "≈126°",
        "norm": "Knees drawn to the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈2°",
        "peak": "≈125°",
        "norm": "Straight in the hollow, deeply bent in the tuck (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Straight overhead",
        "peak": "Around the shins (wrist 9.3 cm from the shin line)",
        "norm": "Overhead in the hollow, around the shins in the tuck (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Lie 0.6 s, hollow 0.6 s",
        "peak": "1 s in, 0.4 s squeeze, 1.2 s out, 0.8 s down",
        "norm": "About 1 s in and 1.2 s out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #5037, Cocoons, video (movement reference)",
