    "id": "chin-ups-narrow-parallel-grip",
    "name": "Chin-ups (narrow parallel grip)",
    "aliases": [
      "Close neutral-grip chin-up",
      "Narrow parallel-grip pull-up",
      "V-handle chin-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "4368",
      "title": "Chin-ups (narrow parallel grip)",
      "url": "https://gymvisual.com/videos/4368-chin-ups-narrow-parallel-grip.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lats)",
    "secondaryBodyParts": [
      "Biceps",
      "Brachialis and forearms",
      "Mid-back"
    ],
    "equipment": [
      "Pull-up bar",
      "Parallel grip handles"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l",
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "pec_r",
        "pec_l"
      ],
      "stabilizer": [
        "core",
        "upper_traps_r",
        "upper_traps_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "triceps_r",
        "triceps_l"
      ],
      "lengthened": [
        "lats_r",
        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull up, breathe in as you lower.",
      "cadence": "About 1.1 s up, short hold, about 2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "5-10",
      "tempo": "2-1-1-1",
      "load": "Bodyweight; add load with a belt when 10 clean reps are easy (RIR 1-3, clinical opinion)",
      "frequency": "2 times a week",
      "progression": "More reps, then added load"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hang from parallel handles close together (palms facing each other), arms long."
      },
      {
        "id": "c2",
        "phase": "set",
        "text": "Set the shoulders: pull the shoulder blades down before you bend the arms."
      },
      {
        "id": "c3",
        "phase": "pull",
        "text": "Breathe out and pull the chest up toward the handles, elbows forward and down."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Chin over the handles; hold briefly."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Breathe in and lower to a full hang under control."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Full hang; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Kipping or swinging",
        "fix": "Pull from a still hang."
      },
      {
        "id": "m2",
        "mistake": "Half reps",
        "fix": "Start from long arms each time."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the top",
        "fix": "Keep the shoulders down away from the ears."
      },
      {
        "id": "m4",
        "mistake": "Chin reaching up with the neck",
        "fix": "Pull the chest up; keep the neck long."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈13° in the dead hang",
        "peak": "≈104° at the top",
        "norm": "From nearly straight in the hang to about 115-140 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip width",
        "setup": "Neutral grip on parallel handles 14 cm apart (shoulder joints 39 cm in the hang): about 36% of shoulder width",
        "peak": "Unchanged (hands planted on the handles)",
        "norm": "Narrow neutral grip: biceps and brachioradialis help more than with a wide overhand grip (Youdas 2010; Lusk 2010 for forearm orientation)",
        "sources": [
          "youdas2010",
          "lusk2010"
        ]
      },
      {
        "measure": "Chin height",
        "setup": "Chin 52 cm below the handles in the dead hang",
        "peak": "Chin 12.7 cm above the handles at the top; body rises 62 cm",
        "norm": "Chin clears the handles at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blades",
        "setup": "Elevated (26) in the hang",
        "peak": "Depressed and retracted (elevate -10, protract -16) at the top",
        "norm": "Elevated in the hang, depressed and retracted at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s, set the shoulders 0.3 s",
        "peak": "About 1.1 s up, 0.4 s hold, 2 s down",
        "norm": "About 1 s up, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #4368, Chin-ups (narrow parallel grip), video (movement reference)",
