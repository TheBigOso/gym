    "id": "inverted-row-between-chairs",
    "name": "Inverted Row between Chairs",
    "aliases": [
      "Chair row",
      "Home inverted row",
      "Bodyweight row between chairs"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "7574",
      "title": "Inverted Row between Chairs",
      "url": "https://gymvisual.com/videos/7574-inverted-row-between-chairs.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lats, mid-back)",
    "secondaryBodyParts": [
      "Upper arms (biceps)",
      "Rear shoulders",
      "Core"
    ],
    "equipment": [
      "Two sturdy chairs"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_max_r",
        "glute_max_l",
        "hamstrings_r",
        "hamstrings_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "lengthened": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull the chest up between the chairs, breathe in as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-15",
      "tempo": "1-1-2-0",
      "load": "Bodyweight (RIR 1-3, clinical opinion)",
      "frequency": "2-3 times a week",
      "progression": "Straighten the legs fully, then raise the feet"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Two sturdy chairs back to back about shoulder width apart; lie between them and hold the tops of the backrests, arms long, heels on the floor, body straight."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and pull the chest up between the chairs, elbows close to the body."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the shoulder blades together."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to long arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hips up; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Chairs that tip or slide",
        "fix": "Use heavy, stable chairs on a non-slip floor, or weight the seats."
      },
      {
        "id": "m2",
        "mistake": "Hips sagging",
        "fix": "Brace and squeeze the glutes."
      },
      {
        "id": "m3",
        "mistake": "Shrugging",
        "fix": "Pull the shoulder blades back and down."
      },
      {
        "id": "m4",
        "mistake": "Half reps",
        "fix": "Lower to long arms each time."
      }
    ],
    "kinematics": [
      {
        "measure": "Body angle",
        "setup": "≈20° above the floor, heels down, straight from heels to head",
        "peak": "≈38° at the top; backrests 96 cm high",
        "norm": "Fixed by the chair height; bending the knees makes it easier (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈28° (arms long)",
        "peak": "≈125° with the chest between the chairs",
        "norm": "From nearly straight to about 90-110 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral grip on the backrest tops, hands 68 cm apart",
        "peak": "Hands fixed on the chairs; the body turns about the heels",
        "norm": "Neutral grip on the backrests; inverted rows load the trunk extensors less than bent-over rows (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s",
        "peak": "1.2 s up, 0.4 s squeeze, 2 s down",
        "norm": "About 1 s up, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #7574, Inverted Row between Chairs, video (movement reference)",
        "url": "https://gymvisual.com/videos/7574-inverted-row-between-chairs.html"
      },
      {
        "id": "fenwick2009",
        "title": "Fenwick, Brown & McGill 2009, comparison of different rowing exercises: trunk muscle activation and lumbar spine motion, load and stiffness (J Strength Cond Res 23(2):350-358)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19197209/"
      },
      {
        "id": "oyama2010",
        "title": "Oyama, Myers, Wassinger and Lephart 2010, three-dimensional scapular and clavicular kinematics and scapular muscle activity during retraction exercises (J Orthop Sports Phys Ther 40(3):169-179)",
        "url": "https://chs.uky.edu/sites/default/files/2023-12/Oyama_2010_Three-Dimensional%20Scapular%20and%20Clavicular%20Kinematics.pdf"
      }
    ],
    "safety": {
      "cautions": [
        "Test the chairs first: they must not tip, fold or slide. Weight the seats if in doubt.",
        "Shoulder pain: bend the knees and shorten the range (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "A broomstick across two chairs works the same way (overhand grip)."
      ],
      "regressions": [
        "Bend the knees, feet flat."
      ],
      "progressions": [
        "Feet raised on a box.",
        "Pause at the top."
      ]
    },
    "muscleNotes": {
      "lats_r": "Pulls the upper arm down and back toward the trunk.",
      "lats_l": "Pulls the upper arm down and back toward the trunk.",
      "rhomboids_midtrap_r": "Draws the shoulder blade back at the finish.",
      "rhomboids_midtrap_l": "Draws the shoulder blade back at the finish.",
      "post_deltoid_r": "Pulls the upper arm back and out.",
      "post_deltoid_l": "Pulls the upper arm back and out.",
      "biceps_r": "Bends the elbow.",
      "biceps_l": "Bends the elbow.",
      "forearm_flexors_r": "Grip.",
      "forearm_flexors_l": "Grip.",
      "core": "Braces the trunk so the body stays in one line.",
      "spinal_extensors_r": "Hold the spine long.",
      "spinal_extensors_l": "Hold the spine long.",
      "glute_max_r": "Keeps the hips extended in line with the body.",
      "glute_max_l": "Keeps the hips extended in line with the body.",
      "hamstrings_r": "Help the glutes hold the hips up.",
      "hamstrings_l": "Help the glutes hold the hips up.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
      "upper_traps_l": "Steadies the shoulder girdle; should not shrug."
    }
