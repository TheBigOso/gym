    "difficulty": "Intermediate",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "id": "dumbbell-incline-curl",
    "name": "Dumbbell Incline Curl",
    "aliases": [
      "Incline dumbbell curl",
      "Seated incline curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "031712",
      "title": "Dumbbell Incline Curl",
      "url": "https://gymvisual.com/videos/8708-dumbbell-incline-curl.html",
      "listing": "Video; data sheet: body part Upper Arms, equipment Dumbbell, Bench, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "equipment": [
      "Dumbbell",
      "Adjustable bench"
    ],
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.5 s down, brief pause in the stretch"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight. Start lighter than for the standing curl: the stretched start makes the same weight feel heavier (clinical opinion)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the back pad at about 45-60 degrees. Sit back with the hips and upper back on the pad, head neutral, feet flat, arms hanging straight down, palms forward."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl both dumbbells without letting the elbows swing forward."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the biceps; shoulders stay back on the pad."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly all the way to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause briefly in the stretch, arms hanging straight, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows swinging forward as the weight rises",
        "fix": "Keep the upper arms hanging; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Shoulders rolling forward off the pad",
        "fix": "Keep the upper back and head on the pad, chest open."
      },
      {
        "id": "m3",
        "mistake": "Bouncing out of the bottom",
        "fix": "Pause briefly at straight arms, then curl."
      },
      {
        "id": "m4",
        "mistake": "Pad too low (shoulder strain)",
        "fix": "Use 45-60 degrees; raise the pad if the front of the shoulder feels stretched too far (clinical opinion)."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈5° (arm straight)",
        "peak": "≈130° at the top (range ≈125°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "8° (palm forward/up)",
        "peak": "0° (palm forward/up)",
        "norm": "Grip changes the biceps/brachioradialis share: the supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-43°",
        "peak": "≈-33° (elbow behind the trunk line)",
        "norm": "Elbows stay near the sides; a small forward drift at the top is normal, a big swing shifts work to the front deltoid (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.8 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.5 s down, 1.2 s pause in the stretch",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Back pad angle",
        "setup": "55° from the floor (trunk line ≈41° back from vertical)",
        "peak": "Unchanged (the trunk stays on the pad)",
        "norm": "About 45-60 degrees from the floor (common practice, clinical opinion); Oliveira 2009 used an incline bench to put the shoulder in extension",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Back on the pad (skinned mesh gap)",
        "setup": "",
        "peak": "",
        "norm": "Hips and upper back on the pad, feet flat (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #031712, Dumbbell Incline Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/8708-dumbbell-incline-curl.html"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      },
      {
        "id": "kassiano2025",
        "title": "Kassiano et al. 2025, distinct muscle growth and strength adaptations after preacher and incline biceps curls (Int J Sports Med, randomized trial in 63 young women)",
        "url": "https://ro.ecu.edu.au/ecuworks2022-2026/5817"
      },
      {
        "id": "ace2014",
        "title": "Young, Porcari, Camic, Kovacs and Foster 2014, ACE-sponsored EMG study of eight biceps exercises, University of Wisconsin-La Crosse (ACE ProSource, August 2014)",
        "url": "https://www.acefitness.org/prosourcearticle/4933/ace-study-reveals-best-biceps-exercises"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the dumbbell and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Pick the dumbbells up and set them down with a straight back and bent knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Front-of-shoulder pain in the stretched position: raise the back pad and use a lighter load (clinical opinion)."
      ],
      "modify": [
        "Shoulder discomfort: set the pad steeper (60-75 degrees).",
        "Elbow pain: try a neutral (hammer) grip on the incline."
      ],
      "regressions": [
        "Seated dumbbell curl (upright back pad).",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Lower pad (45 degrees) for a longer stretch.",
        "Slower lowering with a 1 s pause at the bottom."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor; with the arms hanging behind the trunk the long head starts stretched. Incline and standing curls gave similar biceps activation patterns, peaking near 95% of maximum late in the lift (Oliveira 2009), and incline curls grew the proximal elbow flexors more than preacher curls (Kassiano 2025).",
      "biceps_l": "Main elbow flexor; with the arms hanging behind the trunk the long head starts stretched. Incline and standing curls gave similar biceps activation patterns, peaking near 95% of maximum late in the lift (Oliveira 2009), and incline curls grew the proximal elbow flexors more than preacher curls (Kassiano 2025).",
      "forearm_extensors_r": "Brachioradialis assists; the incline curl showed lower brachioradialis activity than the narrow-grip EZ curl (ACE 2014).",
      "forearm_extensors_l": "Brachioradialis assists; the incline curl showed lower brachioradialis activity than the narrow-grip EZ curl (ACE 2014).",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder in extension; the incline curl showed less front-deltoid activity than the barbell curl (ACE 2014).",
      "ant_deltoid_l": "Steadies the shoulder in extension; the incline curl showed less front-deltoid activity than the barbell curl (ACE 2014).",
      "core": "Keeps the trunk still so the hips do not swing the weight up.",
      "upper_traps_r": "Hold the shoulder girdle level under the dumbbells.",
      "upper_traps_l": "Hold the shoulder girdle level under the dumbbells."
    }
  },
