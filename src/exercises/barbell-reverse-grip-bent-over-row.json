    "breathing": {
      "pattern": "Brace in the hinge, breathe out as the bar comes up, in as it lowers.",
      "cadence": "About 1.1 s up, 0.4 s squeeze, 2 s down"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "2-3 minutes between sets",
      "sets": "3-4",
      "reps": "6-12",
      "tempo": "1 s up, short squeeze, 2 s down",
      "load": "Barbell load is user-chosen: keep the trunk still with no heave, about 2 reps in reserve.",
      "progression": "Add 2.5 kg when every rep touches the belly without the trunk rising."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Underhand grip about shoulder width, knees soft, hinge until the trunk is about 30-40 degrees above the floor, back flat, bar hanging under the shoulders."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Drive the elbows back close to the sides and pull the bar to the lower belly."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the shoulder blades together for a moment; the trunk stays still."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the bar slowly to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hinge and the brace; start the next rep without standing up."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Standing up and heaving the bar",
        "fix": "Fix the trunk angle; lighten the load until it stays still."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows close to the body and drive them toward the hips."
      },
      {
        "id": "m3",
        "mistake": "Curling the bar with the biceps",
        "fix": "Think of pulling with the elbows; the hands are just hooks."
      },
      {
        "id": "m4",
        "mistake": "Rounding the back",
        "fix": "Chest proud, brace, hinge only as far as a flat back allows."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk angle",
        "setup": "≈36° above level (hip channel ≈86°), spine neutral",
        "peak": "Unchanged (held)",
        "norm": "Bent-over rows load the lumbar spine and extensors; the trunk is held still (Fenwick 2009); about 30-45 degrees above horizontal is common",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈22°",
        "peak": "Unchanged",
        "norm": "Soft knees, about 15-25 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈4°, underhand 46 cm grip (handle centres)",
        "peak": "≈105°, elbows 7.6 cm out from the shoulders, bar at the lower belly; shoulder blades retracted (clavicle protraction 6° to -14°)",
        "norm": "Underhand grip keeps the elbows close and brings in the biceps (Lehman 2004 compared grips in lat exercises)",
        "sources": [
          "lehman2004"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.1 s up, 0.4 s squeeze, 2 s down, 1.2 s reset",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Hold the brace and the hinge for the whole set; set the bar down if the back starts to round.",
        "Low-back pain: use a chest-supported row instead.",
        "Elbow or biceps pain with the underhand grip: use an overhand grip.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower back tires: more upright trunk or chest-supported row.",
        "Wrists: EZ bar."
      ],
      "regressions": [
        "Chest-supported dumbbell row.",
        "Overhand barbell row with a lighter load.",
        "Seated cable row."
      ],
      "progressions": [
        "Pause at the belly.",
        "Pendlay-style dead stop from the floor.",
        "Heavier bar in small steps."
      ]
    },
    "muscleNotes": {
      "lats_r": "Pull the elbows back close to the body; the underhand grip keeps the arm path close (Lehman 2004).",
      "lats_l": "Pull the elbows back close to the body; the underhand grip keeps the arm path close (Lehman 2004).",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together at the top.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together at the top.",
      "biceps_r": "Elbow flexor, working harder with the palms up.",
      "biceps_l": "Elbow flexor, working harder with the palms up.",
      "post_deltoid_r": "Extends the shoulder behind the trunk.",
      "post_deltoid_l": "Extends the shoulder behind the trunk.",
      "forearm_flexors_r": "Hold the bar.",
      "forearm_flexors_l": "Hold the bar.",
      "spinal_extensors_r": "Hold the hinged back flat (Fenwick 2009).",
      "spinal_extensors_l": "Hold the hinged back flat (Fenwick 2009).",
      "hamstrings_r": "Hold the hips in the hinge.",
      "hamstrings_l": "Hold the hips in the hinge.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Bracing keeps the trunk still while the arms move."
    },
