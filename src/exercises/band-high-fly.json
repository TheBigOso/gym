        "obliques_r",
        "obliques_l"
      ],
      "lengthened": [
        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the hands sweep down and together, breathe in as they rise and open.",
      "cadence": "About 1 s down, short squeeze, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1",
      "progression": "More reps, a slower return, a step farther from the rack, then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop a band round each rack upright behind you, well above head height. Staggered stance, slight forward lean, knees soft; a band end in each hand, arms up and out in a wide V, elbows slightly bent."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and sweep the hands down and forward in a wide arc until they meet in front of the hips; keep the elbow bend fixed."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hands together low in front, chest proud, shoulders down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the band draw the arms back up and out along the same arc."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the band taut, then sweep again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the elbows to push the hands down",
        "fix": "Lock the elbow angle and move only at the shoulders."
      },
      {
        "id": "m2",
        "mistake": "Rounding the upper back at the bottom",
        "fix": "Keep the chest up as the hands meet."
      },
      {
        "id": "m3",
        "mistake": "Letting the arms go too far back at the top",
        "fix": "Stop with the hands a little in front of the body line."
      },
      {
        "id": "m4",
        "mistake": "Leaning into the movement to use body weight",
        "fix": "Keep the trunk still; the arms do the work."
      }
    ],
    "kinematics": [
      {
        "measure": "Arm path",
        "setup": "Arms up and out, ≈131° of elevation",
        "peak": "Hands together in front of the hips (≈48° of elevation), 6.2 cm apart",
        "norm": "From up and out (about 120-130 degrees of elevation) down and in to the hands together in front of the hips: a high-to-low line that biases the lower (sternal) chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈20°, held",
        "peak": "≈20° (unchanged)",
        "norm": "Fixed, about 15-25 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack uprights 35 cm behind, 205 cm up, 150 cm apart; strands 55.7 cm",
        "peak": "Strands 157.8 cm with the hands together; at least 1.2 cm from the body",
        "norm": "Anchored high behind so it resists the downward sweep; dumbbell flyes give pectoral activity similar to the bench press (Solstad 2020) and elastic resistance can match free weights (Andersen 2010).",
        "sources": [
          "solstad2020",
          "andersen2010"
        ]
      },
      {
        "measure": "Stance",
        "setup": "Staggered: right foot 24 cm forward, left 22 cm back, knees soft, trunk ≈3° forward",
        "peak": "Unchanged (trunk still)",
        "norm": "Staggered, slight forward lean, so the band does not pull the trunk back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s open",
        "peak": "1.1 s in, 0.4 s squeeze, 1.8 s out, 0.4 s pause",
        "norm": "About 1 s down and 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band High Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/8659-band-high-fly-male.html"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Shoulder pain with the arms high: start the arc lower (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: start with the hands at shoulder height."
      ],
      "regressions": [
        "Lighter band or step closer to the rack.",
        "Band chest fly at shoulder height."
      ],
      "progressions": [
        "Stronger band or step farther from the rack.",
        "Pause 2 s with the hands together.",
        "Cable high-to-low fly."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main mover: brings the arm across the body (horizontal adduction) and, with the shoulder, presses the hands forward. The downward line of the sweep shifts the work toward the lower (sternal) fibres (clinical opinion).",
      "pec_l": "Main mover: brings the arm across the body (horizontal adduction) and, with the shoulder, presses the hands forward. The downward line of the sweep shifts the work toward the lower (sternal) fibres (clinical opinion).",
      "ant_deltoid_r": "Assists early in the sweep while the arms are high.",
      "ant_deltoid_l": "Assists early in the sweep while the arms are high.",
      "lats_r": "Help pull the arms down from overhead (shoulder extension) early in the arc (clinical opinion).",
      "lats_l": "Help pull the arms down from overhead (shoulder extension) early in the arc (clinical opinion).",
      "biceps_r": "Holds the slight elbow bend (Solstad 2020).",
      "biceps_l": "Holds the slight elbow bend (Solstad 2020).",
      "serratus_r": "Keeps the shoulder blades on the rib cage.",
      "serratus_l": "Keeps the shoulder blades on the rib cage.",
      "forearm_flexors_r": "Grip the band.",
      "forearm_flexors_l": "Grip the band.",
      "triceps_r": "Steadies the elbow angle.",
      "triceps_l": "Steadies the elbow angle.",
      "core": "Keeps the trunk still against the bands.",
      "obliques_r": "Resist the bands pulling the trunk back.",
      "obliques_l": "Resist the bands pulling the trunk back."
    }
  },
