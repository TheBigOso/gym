    "breathing": {
      "pattern": "Breathe in and brace before the bar leaves the floor, hold the brace through the pull, breathe out at the top or once the plates are back on the floor.",
      "cadence": "About 1.8 s up, a short lockout, about 2 s down, reset on the floor"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "3-8",
      "tempo": "1-1-2-1",
      "load": "User-chosen; stop about 2 reps short of failure (RIR 2)",
      "frequency": "1-2 times a week",
      "progression": "Add load, then move to the low handles or a barbell deadlift"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand in the middle of the hex bar, feet hip width; hinge and bend the knees to grip the side handles in the middle, palms facing in, arms straight, chest up, back flat."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Brace and push the floor away; hips and shoulders rise together, the bar travels straight up beside the legs."
      },
      {
        "id": "c3",
        "phase": "lockout",
        "text": "Stand tall: hips through, glutes tight, shoulders down; no leaning back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Push the hips back and bend the knees to lower the bar straight down, back flat."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Set the plates down softly, reset the brace and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back off the floor",
        "fix": "Lighter load; chest up, brace before the pull."
      },
      {
        "id": "m2",
        "mistake": "Hips shooting up first",
        "fix": "Push through the whole foot so the hips and shoulders rise together."
      },
      {
        "id": "m3",
        "mistake": "Gripping the handles off-centre so the bar tips",
        "fix": "Hold each handle in its middle so the bar stays level."
      },
      {
        "id": "m4",
        "mistake": "Leaning back at the top",
        "fix": "Finish tall with the hips under the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈98° with the plates on the floor",
        "peak": "≈4° at lockout",
        "norm": "More knee bend than a straight-bar deadlift: the hex bar shifted load toward the knees (higher knee moment) and lifted heavier at similar effort (Swinton 2011)",
        "sources": [
          "swinton2011"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈130° (joint channel); hips 55.4 cm high, knees 47.1 cm",
        "peak": "≈1° at lockout",
        "norm": "Hips below the shoulders and above the knees at the start (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈45° from vertical, back flat",
        "peak": "≈5° at lockout",
        "norm": "More upright trunk than with an Olympic bar (Stewart 2008, Troy-Hex bar; Swinton 2011)",
        "sources": [
          "stewart2008",
          "swinton2011"
        ]
      },
      {
        "measure": "Bar path",
        "setup": "Handles 4.3 cm from mid-foot, 22.8 cm high; 62 cm between the handle centres",
        "peak": "Handles travel 4.2 cm fore-aft; lockout height 76.8 cm; frame at least 12.4 cm off the legs",
        "norm": "The handles rise straight up beside the legs, over mid-foot; the frame never touches the shins (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Set up 0.8 s",
        "peak": "1.8 s up, 0.6 s lockout, 2 s down, 0.8 s reset on the floor",
        "norm": "Controlled lift and lowering; reset on the floor between reps (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #2293, Trap Bar Deadlift, animated GIF (movement reference)",
