        "url": "https://pubmed.ncbi.nlm.nih.gov/21659894/"
      },
      {
        "id": "stewart2008",
        "title": "Stewart & Stewart-Menteth 2008, comparative kinematic analysis of the deadlift with an Olympic bar and a Troy-Hex bar (J Sports Sci 26(2))",
        "url": "https://researchportal.northumbria.ac.uk/en/publications/a-comparative-kinematic-analysis-of-the-deadlift-performed-using-/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The load is your choice: pick a weight you can move with the form shown for every rep.",
        "Low-back pain: keep the range above pain and the back flat; seek advice if pain persists.",
        "Step in and out of the frame carefully and set the bar down level.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "High handles if you cannot reach the low handles with a flat back.",
        "Knee pain: hinge a little more and bend the knees a little less."
      ],
      "regressions": [
        "Lighter plates or an unloaded bar.",
        "Pull from blocks.",
        "Dumbbell deadlift."
      ],
      "progressions": [
        "Heavier load.",
        "Barbell deadlift.",
        "Trap bar deadlift from a deficit."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Hip extensor: drives the hips through as you stand.",
      "glute_max_l": "Hip extensor: drives the hips through as you stand.",
      "quads_r": "Extend the knees off the floor; trap bar beside the feet (like a hex bar) shift more of the lift to the knees than a straight-bar deadlift (Swinton 2011).",
      "quads_l": "Extend the knees off the floor; trap bar beside the feet (like a hex bar) shift more of the lift to the knees than a straight-bar deadlift (Swinton 2011).",
      "hamstrings_r": "Hip extensors with the glutes.",
      "hamstrings_l": "Hip extensors with the glutes.",
      "spinal_extensors_r": "Keep the back flat under load. A hex-bar style deadlift allowed a more upright trunk and lower erector spinae activity than a straight bar (Stewart 2008).",
      "spinal_extensors_l": "Keep the back flat under load. A hex-bar style deadlift allowed a more upright trunk and lower erector spinae activity than a straight bar (Stewart 2008).",
      "adductors_r": "Adductor magnus assists hip extension.",
      "adductors_l": "Adductor magnus assists hip extension.",
      "forearm_flexors_r": "Grip the trap bar.",
      "forearm_flexors_l": "Grip the trap bar.",
      "upper_traps_r": "Hold the shoulders against the pull of the trap bar.",
      "upper_traps_l": "Hold the shoulders against the pull of the trap bar.",
      "lats_r": "Keep the arms close to the body.",
      "lats_l": "Keep the arms close to the body.",
      "core": "Brace the trunk."
    }
