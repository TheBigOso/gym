    ],
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, 0.3 s squeeze, about 2.3 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight. Use a light dumbbell: the top is the hardest point (clinical opinion)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the back pad low, about 30 degrees. Lie chest-down with the shoulders over the top edge, feet planted behind, arms hanging straight down, palms forward."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the dumbbells up; the upper arms stay perpendicular to the floor."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze hard at the top for a moment."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms hanging, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows drifting forward toward the head",
        "fix": "Keep the upper arms pointing straight at the floor."
      },
      {
        "id": "m2",
        "mistake": "Swinging the dumbbells back and up",
        "fix": "Pause at the bottom; lighten the load."
      },
      {
        "id": "m3",
        "mistake": "Partial reps near the top only",
        "fix": "Straighten the arms fully each rep."
      },
      {
        "id": "m4",
        "mistake": "Lifting the chest off the pad",
        "fix": "Keep the chest on the pad throughout."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈17° (arm straight)",
        "peak": "≈130° at the top (range ≈113°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "14.2° (palm forward/up)",
        "peak": "4.5° (palm forward/up)",
        "norm": "The supinated grip gave the highest biceps activity in the lifting phase; neutral grips shift work toward the brachioradialis (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈11° from vertical (hanging); ≈54° from the trunk line (shoulder flexed)",
        "peak": "Unchanged: pure elbow hinge",
        "norm": "Upper arms vertical, so the shoulder is flexed about 60 degrees from the trunk on a 30-degree pad (Moon 2013 found biceps activity highest near 75 degrees of shoulder flexion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.8 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.3 s down, 1.0 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Bench angle",
        "setup": "30° back pad (80 cm), seat 45 cm",
        "peak": "Trunk ≈27° above horizontal, along the pad",
        "norm": "Low incline, about 30-45 degrees, chest at the top edge (common practice, clinical opinion)",
        "sources": []
      },
      {
        "measure": "Chest on the pad (skinned mesh gap)",
        "setup": "Chest on the pad; head 17.3 cm past the top edge, shoulders 3.5 cm",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "Chest on the pad, shoulders at the top edge, feet planted (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #993112, Dumbbell Spider Curl (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/21858-dumbbell-spider-curl-male.html"
      },
      {
        "id": "moon2013",
        "title": "Moon, Shin, Kang, Kim, Lee, Park, Kim, Hong, Koo and O'Sullivan 2013, the effect of shoulder flexion angles on the recruitment of upper-extremity muscles during isometric contraction (J Phys Ther Sci 25(10):1299-1301; PMC3820192)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3820192"
      },
      {
        "id": "pedrosa2023",
        "title": "Pedrosa, Simoes, Figueiredo, Lacerda, Schoenfeld, Lima, Chagas and Diniz 2023, training in the initial range of motion promotes greater muscle adaptations than at final in the arm curl (Sports 11(2):39; PMC9960616)",
        "url": "https://www.mdpi.com/2075-4663/11/2/39"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the dumbbell and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Pick the dumbbells up and set them down with a straight back and bent knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Neck strain: keep the head in line with the trunk rather than looking up (clinical opinion)."
      ],
      "modify": [
        "Chest pressure: raise the pad to 45 degrees (prone incline curl).",
        "Elbow pain: neutral (hammer) grip."
      ],
      "regressions": [
        "Prone incline curl.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Pause 1-2 s at the top.",
        "Slower lowering (3-4 s)."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor; with the trunk low on the pad the upper arms hang straight down in front of the head line (shoulder flexed about 60 degrees), so the load is highest near the top of the curl where the forearm is horizontal. Biceps activity peaked near 75 degrees of shoulder flexion in an isometric curl (Moon 2013).",
      "biceps_l": "Main elbow flexor; with the trunk low on the pad the upper arms hang straight down in front of the head line (shoulder flexed about 60 degrees), so the load is highest near the top of the curl where the forearm is horizontal. Biceps activity peaked near 75 degrees of shoulder flexion in an isometric curl (Moon 2013).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Holds the upper arms vertical; the elbows must not drift forward.",
      "ant_deltoid_l": "Holds the upper arms vertical; the elbows must not drift forward.",
      "core": "Keeps the trunk still so the hips do not swing the weight up.",
      "rhomboids_midtrap_r": "Keep the shoulder blades set so the shoulders do not sag toward the floor.",
      "rhomboids_midtrap_l": "Keep the shoulder blades set so the shoulders do not sag toward the floor."
    }
  },
