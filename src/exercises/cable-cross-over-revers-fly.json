  "exercise": {
    "id": "cable-cross-over-revers-fly",
    "name": "Cable Cross over Revers Fly",
    "aliases": [
      "Cable crossover reverse fly",
      "Standing cable rear delt fly",
      "Cable crossover rear delt fly"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5008",
      "title": "Cable Cross over Revers Fly",
      "url": "https://gymvisual.com/videos/5008-cable-cross-over-revers-fly.html",
      "listing": "Video; the page could not be read here (blocked), so the movement follows the name and standard coaching (standing between crossover towers, cables crossed in front at shoulder height, arms sweep out to a T).",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (rear deltoid)",
    "secondaryBodyParts": [
      "Upper back"
    ],
    "equipment": [
      "Cable"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (horizontal shoulder abduction)",
    "plane": "Transverse",
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "upper_traps_r",
        "upper_traps_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "triceps_r",
        "triceps_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the arms open, in as they come back together.",
      "cadence": "About 1.2 s out, 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "Controlled: about 1 s out, short hold, 2 s back",
      "load": "User-chosen light cable weight; the shoulders, not the back, should do the work",
      "frequency": "2-3 times a week",
      "progression": "Longer holds in the T, then more weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall between the towers; right hand holds the left cable, left hand the right cable; arms long in front at shoulder height."
      },
      {
        "id": "c2",
        "phase": "open",
        "text": "Sweep the arms out wide to a T, leading with the backs of the hands; elbows stay softly bent."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold the T: shoulder blades back and down, no shrug, ribs down."
      },
      {
        "id": "c4",
        "phase": "close",
        "text": "Let the cables draw the arms back in front under control, crossing again."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the hands in front."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending and straightening the elbows (rowing)",
        "fix": "Fix the elbow angle; the movement is at the shoulder."
      },
      {
        "id": "m2",
        "mistake": "Leaning back to pull",
        "fix": "Stand tall, ribs down; lighter weight."
      },
      {
        "id": "m3",
        "mistake": "Shrugging",
        "fix": "Keep the shoulders down away from the ears."
      },
      {
        "id": "m4",
        "mistake": "Letting the cables yank the arms back in",
        "fix": "Control the return over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder horizontal abduction",
        "setup": "Upper arm ≈-6° from straight ahead (hands 28 cm apart in front, cables crossed)",
        "peak": "≈92° from straight ahead (arms in a T)",
        "norm": "From arms in front to arms in line with the shoulders (clinical opinion); in a horizontal abduction exercise the posterior deltoid was highly active and hand position changed its activity (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Shoulder elevation",
        "setup": "≈73° from the trunk",
        "peak": "≈79°",
        "norm": "Arms near shoulder height throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°-14° over the loop",
        "peak": "Unchanged",
        "norm": "Soft and unchanged, about 10-20 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈-5° from upright, standing tall, knees soft",
        "peak": "Unchanged",
        "norm": "Upright and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the hands in front",
        "peak": "1.2 s out, 0.4 s hold, 2 s back",
        "norm": "Controlled, about 1 s out and 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #5008, Cable Cross over Revers Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/5008-cable-cross-over-revers-fly.html"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7706677/"
      }
    ],
    "safety": {
      "cautions": [
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Shoulder pain: keep the arms a little below shoulder height and use a light weight.",
        "Step in carefully between the towers and set the handles back with control.",
        "Load is user-chosen: start light."
      ],
      "modify": [
        "One arm at a time.",
        "Band reverse fly."
      ],
      "regressions": [
        "Band pull-apart.",
        "Lighter weight, smaller range."
      ],
      "progressions": [
        "Hold the T for 2-3 s.",
        "More weight.",
        "Bent-over cable reverse fly."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Posterior deltoid moves the arm back in the horizontal plane; it was highly active in horizontal abduction in Schoenfeld 2013.",
      "post_deltoid_l": "Posterior deltoid moves the arm back in the horizontal plane; it was highly active in horizontal abduction in Schoenfeld 2013.",
      "rhomboids_midtrap_r": "Pull the shoulder blades together as the arms reach the T (clinical opinion).",
      "rhomboids_midtrap_l": "Pull the shoulder blades together as the arms reach the T (clinical opinion).",
      "infraspinatus_r": "Externally rotates and steadies the shoulder (clinical opinion).",
      "infraspinatus_l": "Externally rotates and steadies the shoulder (clinical opinion).",
      "lat_deltoid_r": "Holds the arms at shoulder height and helps the sweep (Campos 2020).",
      "lat_deltoid_l": "Holds the arms at shoulder height and helps the sweep (Campos 2020).",
      "upper_traps_r": "Supports the shoulder girdle; should not shrug (clinical opinion).",
      "upper_traps_l": "Supports the shoulder girdle; should not shrug (clinical opinion).",
      "core": "Keeps the trunk still against the cables (clinical opinion).",
      "forearm_flexors_r": "Grip the handles (clinical opinion).",
      "forearm_flexors_l": "Grip the handles (clinical opinion).",
      "triceps_r": "Hold the elbow angle (clinical opinion).",
      "triceps_l": "Hold the elbow angle (clinical opinion).",
      "spinal_extensors_r": "Keep the trunk tall (clinical opinion).",
      "spinal_extensors_l": "Keep the trunk tall (clinical opinion)."
    }
