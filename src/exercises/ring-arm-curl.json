  "exercise": {
    "id": "ring-arm-curl",
    "name": "Ring Arm Curl",
    "aliases": [
      "Ring biceps curl",
      "Suspension biceps curl",
      "Bodyweight ring curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15615",
      "title": "Ring Arm Curl",
      "url": "https://gymvisual.com/videos/15615-ring-arm-curl-male.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper arms (biceps)",
    "secondaryBodyParts": [
      "Forearms",
      "Core"
    ],
    "equipment": [
      "Gymnastic rings",
      "Pull-up bar (anchor)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "core",
        "glute_max_r",
        "glute_max_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "hamstrings_r",
        "hamstrings_l"
      ],
      "lengthened": [
        "biceps_r",
        "biceps_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl the body up to the rings, breathe in as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-15",
      "tempo": "1-1-2-0",
      "load": "Bodyweight; body angle sets the load (RIR 1-3, clinical opinion)",
      "frequency": "2 times a week",
      "progression": "Walk the feet toward the anchor"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Rings in front, underhand grip (palms up); lean back with long arms raised toward the anchor, heels down, body straight."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and bend the elbows, bringing the rings toward the forehead; the upper arms stay pointing at the anchor."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the biceps with the hands beside the forehead."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and straighten the elbows slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the body straight; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Turning it into a row (elbows dropping to the ribs)",
        "fix": "Keep the upper arms up toward the anchor; only the elbows bend."
      },
      {
        "id": "m2",
        "mistake": "Hips sagging",
        "fix": "Brace and squeeze the glutes."
      },
      {
        "id": "m3",
        "mistake": "Wrists curling",
        "fix": "Keep the wrists straight."
      },
      {
        "id": "m4",
        "mistake": "Dropping fast",
        "fix": "Lower over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Body angle",
        "setup": "≈26° above the floor, heels down",
        "peak": "≈50° at the top",
        "norm": "The more upright the body, the easier the curl (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈9° (arms long)",
        "peak": "≈112° with the hands beside the forehead",
        "norm": "From nearly straight to about 110-130 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm",
        "setup": "Raised toward the rings (within 0° of the line to the anchor)",
        "peak": "Still pointing at the rings (within 4°); only the elbows bend",
        "norm": "Upper arms stay raised toward the anchor (shoulder flexed), so the elbows hinge; curls with the shoulder flexed load the biceps at long length (Kassiano 2025, by analogy)",
        "sources": [
          "kassiano2025"
        ]
      },
      {
        "measure": "Straps",
        "setup": "One strap per ring, 119 cm; 29° from vertical at the bottom",
        "peak": "23° from vertical at the top; at least 4.2 cm off the body",
        "norm": "Straps stay taut; each ring stays on its strap arc (geometry)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s",
        "peak": "1.2 s up, 0.4 s squeeze, 2 s down",
        "norm": "About 1 s up, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15615, Ring Arm Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/15615-ring-arm-curl-male.html"
      },
      {
        "id": "kassiano2025",
        "title": "Kassiano et al. 2025, distinct muscle growth and strength adaptations after preacher and incline biceps curls (Int J Sports Med, randomized trial in 63 young women)",
        "url": "https://ro.ecu.edu.au/ecuworks2022-2026/5817"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      }
    ],
    "safety": {
      "cautions": [
        "Check the anchor and the straps before each set; anchor only to a sturdy bar or a door anchor made for it.",
        "Shoulder pain: stand more upright and shorten the range (clinical opinion).",
        "Elbow pain: shorten the range and stand more upright.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Suspension handles work the same way."
      ],
      "regressions": [
        "Stand more upright."
      ],
      "progressions": [
        "Feet closer to the anchor.",
        "Single-arm ring curl."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Bends the elbow.",
      "biceps_l": "Bends the elbow.",
      "forearm_flexors_r": "Grip.",
      "forearm_flexors_l": "Grip.",
      "ant_deltoid_r": "Raises the upper arm forward.",
      "ant_deltoid_l": "Raises the upper arm forward.",
      "lats_r": "Pulls the upper arm down and back toward the trunk.",
      "lats_l": "Pulls the upper arm down and back toward the trunk.",
      "core": "Braces the trunk so the body stays in one line.",
      "glute_max_r": "Keeps the hips extended in line with the body.",
      "glute_max_l": "Keeps the hips extended in line with the body.",
      "spinal_extensors_r": "Hold the spine long.",
      "spinal_extensors_l": "Hold the spine long.",
      "hamstrings_r": "Help the glutes hold the hips up.",
      "hamstrings_l": "Help the glutes hold the hips up."
    }
