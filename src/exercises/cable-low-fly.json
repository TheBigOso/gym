    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Front of the shoulders",
      "Biceps",
      "Core"
    ],
    "equipment": [
      "Cable machine (two towers)",
      "Two D-handles"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
