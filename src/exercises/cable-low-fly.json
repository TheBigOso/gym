        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the hands lower and open, breathe out as you sweep them up and together.",
      "cadence": "About 2.2 s down, short stretch, about 1.5 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2-0.4-1.5-0.6 (down-stretch-up-squeeze, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can sweep up to chest height with the elbow bend unchanged and without leaning back.",
      "progression": "Add reps, then one plate on each stack; slower opening"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand between two towers with the pulleys at the bottom, a D-handle in each hand, feet hip width, chest up; hands together in front of the upper chest, palms up, elbows softly bent."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the cables draw the hands down and out in a wide arc, elbow bend fixed."
      },
      {
        "id": "c3",
        "phase": "stretch",
        "text": "Stop with the hands out beside the hips, palms forward, and a light stretch across the chest."
      },
      {
        "id": "c4",
        "phase": "raise",
        "text": "Breathe out and scoop the handles up and together in front of the upper chest, as if lifting a big bowl."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze with the hands just apart at about chin to upper-chest height; shoulders down."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Curling the handles up with the biceps",
        "fix": "Keep the same soft elbow bend; the arm moves from the shoulder."
      },
      {
        "id": "m2",
        "mistake": "Leaning back to heave the handles",
        "fix": "Brace with a slight forward lean and lighten the stacks."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the top",
        "fix": "Stop at upper-chest height with the shoulders down."
      },
      {
        "id": "m4",
        "mistake": "Letting the hands drift behind the body at the bottom",
        "fix": "Stop with the hands beside the hips, a little in front of the body line."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈20° (soft, fixed)",
        "peak": "≈20° in the stretch",
        "norm": "Fixed soft bend of about 20-30 degrees (as in the dumbbell fly protocol of Solstad 2020)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Arm path",
        "setup": "Upper arm ≈90° from the trunk, hands 0.2 cm from shoulder height, 19.8 cm apart",
        "peak": "Upper arm ≈35° from the trunk, hands 43.3 cm out from the midline at 81.5 cm",
        "norm": "From the hands out beside the hips up and in to the upper chest: a low-to-high line of pull (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Palms up and slightly in at the top",
        "peak": "Palms forward at the bottom",
        "norm": "Palms forward at the bottom, turning up at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Low pulleys 16 cm high, 160 cm apart, 10 cm behind the hips",
        "peak": "Both cables clear of the body by at least 6.88 cm",
        "norm": "One cable per hand from its own low pulley (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈5° forward of vertical, knees soft",
        "peak": "Unchanged",
        "norm": "Upright or slightly forward, braced and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Squeeze 0.6 s at the top",
        "peak": "2.2 s down, 0.4 s stretch, 1.5 s up",
        "norm": "Controlled, about 2 s down and 1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Low Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/2885-cable-low-fly.html"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can lift to chest height without leaning back or shrugging.",
        "Pick the handles up from the low pulleys one at a time with a flat back, bending the knees, then step into position.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: keep the hands lower at the top, about mid-chest.",
        "Balance: use a staggered stance with one foot forward."
      ],
      "regressions": [
        "Lighter stacks.",
        "Band low-to-high fly anchored under the feet.",
        "Dumbbell incline fly."
      ],
      "progressions": [
        "Slower lowering with a 1 s pause in the stretch.",
        "Heavier stacks.",
        "Single-arm low fly for an anti-rotation challenge."
      ]
    },
    "muscleNotes": {
      "pec_r": "Prime mover: the upper (clavicular) fibres lift and draw the arm across the body on the low-to-high path (clinical opinion; fly mechanics as in Solstad 2020).",
      "pec_l": "Prime mover: the upper (clavicular) fibres lift and draw the arm across the body on the low-to-high path (clinical opinion; fly mechanics as in Solstad 2020).",
      "ant_deltoid_r": "Lifts the arm forward and up with the upper chest.",
      "ant_deltoid_l": "Lifts the arm forward and up with the upper chest.",
      "biceps_r": "Holds the soft elbow bend and assists shoulder flexion with the palm up.",
      "biceps_l": "Holds the soft elbow bend and assists shoulder flexion with the palm up.",
      "serratus_r": "Rotates the shoulder blade upward as the arm rises.",
      "serratus_l": "Rotates the shoulder blade upward as the arm rises.",
      "triceps_r": "Keeps the elbow from bending further.",
      "triceps_l": "Keeps the elbow from bending further.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
      "upper_traps_l": "Steadies the shoulder girdle; should not shrug.",
      "core": "Keeps the trunk from leaning back as the cables pull down and out."
    }
