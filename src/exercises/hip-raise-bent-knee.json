    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain, disc problems or flexion intolerance: start with a posterior pelvic tilt or the dead bug; partial curl-ups gave the best abdominal challenge for the least spine compression in one model study (Axler and McGill 1997).",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before trunk-flexion work."
      ],
      "modify": [
        "Low-back discomfort: smaller curl (tailbone just off the mat).",
        "Neck tension: relax the head on the mat."
      ],
      "regressions": [
        "Posterior pelvic tilt with feet on the floor.",
        "Dead bug."
      ],
      "progressions": [
        "Reverse crunch (no floor touch).",
        "Lying leg hip raise on the floor.",
        "Hanging knee raise."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the pelvis toward the ribs; reverse-crunch style curls raised lower rectus activity (Sarti 1996, Clark 2003).",
      "hip_flexors_r": "Lift the thighs from the floor to vertical (clinical opinion).",
      "hip_flexors_l": "Lift the thighs from the floor to vertical (clinical opinion).",
      "obliques_r": "Help curl the pelvis and keep it square (clinical opinion).",
      "obliques_l": "Help curl the pelvis and keep it square (clinical opinion).",
      "quads_r": "Hold the knee angle (clinical opinion).",
      "quads_l": "Hold the knee angle (clinical opinion).",
      "lats_r": "Press the arms into the mat to steady the trunk (clinical opinion).",
      "lats_l": "Press the arms into the mat to steady the trunk (clinical opinion).",
      "triceps_r": "Keep the elbows straight as the hands press down (clinical opinion).",
      "triceps_l": "Keep the elbows straight as the hands press down (clinical opinion)."
    }
