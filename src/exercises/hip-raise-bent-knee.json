  "exercise": {
    "id": "hip-raise-bent-knee",
    "name": "Hip Raise (bent knee)",
    "aliases": [
      "Bent-knee hip raise",
      "Floor-to-chest reverse crunch",
      "Bent-knee leg-hip raise",
      "Knee-tuck hip raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5062",
      "title": "Hip Raise (bent knee)",
      "url": "https://gymvisual.com/videos/5062-hip-raise-bent-knee.html",
      "listing": "Video (movement reference; the page could not be read at authoring time: gymvisual.com is blocked by the proxy, so the movement comes from the name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hips (hip flexors)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip flexion, then posterior pelvic tilt and lumbar flexion, knees bent)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l",
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "lats_r",
        "lats_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the knees come up, breathe out as the hips curl off the mat, breathe in as you lower.",
      "cadence": "About 0.9 s knees up, 1 s hips up, short pause, 1.7 s down, 1.2 s feet down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "About 1 s up, brief pause, 2-3 s down; no swinging",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering, then the straight-leg lying leg hip raise."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms by your sides palms down, knees bent with the feet flat on the mat."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Lift the feet and bring the thighs to vertical, knees bent about 90 degrees."
      },
      {
        "id": "c3",
        "phase": "lift",
        "text": "Breathe out and curl the hips off the mat, drawing the knees toward the chest."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Roll the pelvis down slowly, then lower the feet until they just touch the mat."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief touch, low back heavy, then go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the knees to roll the hips up",
        "fix": "Pause at vertical and curl the pelvis with the abdominals."
      },
      {
        "id": "m2",
        "mistake": "Opening the knee angle as the hips lift",
        "fix": "Hold the knees at about 90 degrees all the way."
      },
      {
        "id": "m3",
        "mistake": "Dropping the feet onto the floor",
        "fix": "Lower under control and only tap the mat."
      },
      {
        "id": "m4",
        "mistake": "Pushing through the neck",
        "fix": "Keep the head and shoulders relaxed on the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈48° (feet on the mat)",
        "peak": "≈92° with the thighs vertical, ≈100° at the top",
        "norm": "From feet on the floor to thighs vertical, then past vertical as the pelvis curls (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈92°",
        "peak": "≈96° (held)",
        "norm": "About 90 degrees, held (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Thighs from the floor",
        "setup": "≈46°",
        "peak": "≈136° (knees toward the chest)",
        "norm": "Knees travel toward the chest at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis roll",
        "setup": "Pelvis resting",
        "peak": "≈38° posterior tilt; buttocks 8.4 cm off the mat",
        "norm": "The pelvis curls until the tailbone clears the mat; this curl brings in the lower abdominals (Clark 2003)",
        "sources": [
          "clark2003"
        ]
      },
      {
        "measure": "Upper back",
        "setup": "On the mat",
        "peak": "Stays down (T6 moves 0.2 cm)",
        "norm": "Shoulders and head stay on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Feet down 0.6 s",
        "peak": "0.9 s knees up, 0.95 s hips up, 0.45 s pause, 1.7 s hips down, 1.15 s feet down",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
