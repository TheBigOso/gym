      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the shoulder, breathe out as you press, breathe in as you lower.",
      "cadence": "About 1.4 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12 each side",
      "tempo": "1-0-2-1",
      "load": "User-chosen; pick a load you can press for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion)",
      "frequency": "2 times a week",
      "progression": "Add reps, then a plate"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel tall facing the landmine, knees hip width on a pad, toes tucked; hold the end of the bar in front of your right shoulder, left hand on the hip, glutes and abs tight."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press the bar up and forward along its arc until the arm is long."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Reach a little at the top without shrugging; hips and ribs stay stacked."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the bar back to the front of the shoulder under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Re-brace, stay tall; repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back or arching the low back to push the bar",
        "fix": "Squeeze the glutes and keep the ribs down; lighten the load."
      },
      {
        "id": "m2",
        "mistake": "Twisting the trunk toward the pressing arm",
        "fix": "Keep the shoulders and hips square to the pivot."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulder to the ear at the top",
        "fix": "Reach forward and up, shoulder away from the ear."
      },
      {
        "id": "m4",
        "mistake": "Letting the bar drop onto the shoulder",
        "fix": "Lower over about 2 s and stop at the front of the shoulder."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance",
        "setup": "both knees down, knee angle 105° (toes tucked), thighs about vertical; pivot 226.2 cm in front of the knees",
        "peak": "unchanged",
        "norm": "Tall-kneeling: both knees under the hips about hip-width apart, thighs about vertical, toes tucked (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation (humerus)",
        "setup": "≈25°",
        "peak": "≈88°",
        "norm": "The bar's arc takes the hand up and forward rather than straight overhead: the upper arm finishes in front of the head, short of full overhead elevation (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈138°",
        "peak": "≈72°",
        "norm": "About 90 degrees or more at the bottom with the hand at the shoulder, nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar angle",
        "setup": "≈21° above the floor at the shoulder",
        "peak": "≈32° at the top; the hand travels 41.1 cm along the arc",
        "norm": "The bar rises from about 30 degrees above the floor at the shoulder; the hand moves on the arc set by the bar length (geometry)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Brace 0.8 s at the shoulder",
        "peak": "1.4 s up, 0.4 s at the top, 2.0 s down",
        "norm": "Controlled, about 1.5 s up and 2 s down (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk lean",
        "setup": "vertical",
        "peak": "vertical (held)",
        "norm": "Trunk stays tall; a unilateral load raises oblique and back-stabilizer activity to resist side bending (Saeterbakken 2012; Trunk 2005)",
        "sources": [
          "saeterbakken2012",
          "trunk2005"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #8849, Landmine Kneeling One Arm Shoulder Press, animated GIF (movement reference; page not readable here)",
        "url": "https://gymvisual.com/animated-gifs/8849-landmine-kneeling-one-arm-shoulder-press.html"
      },
      {
        "id": "saeterbakken2012",
        "title": "Saeterbakken & Fimland 2012, muscle activity of the core during bilateral, unilateral, seated and standing resistance exercise (Eur J Appl Physiol 112:1671-1678)",
        "url": "https://link.springer.com/article/10.1007/s00421-011-2141-7"
      },
      {
        "id": "trunk2005",
        "title": "Trunk muscle electromyographic activity with unstable and unilateral exercises (J Strength Cond Res 19(1):193-201, 2005; PubMed 15705034)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/15705034/"
      }
    ],
    "safety": {
      "cautions": [
        "Shoulder pain: shorten the range or lighten the load; stop if pain is sharp (clinical opinion).",
        "Seat the bar end fully in the pivot and keep the area around the bar clear.",
        "Knee discomfort: use a thicker pad.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Half-kneeling (one knee up) for a wider base.",
        "Standing landmine press."
      ],
      "regressions": [
        "Bar without plates.",
        "Two-hand landmine press."
      ],
      "progressions": [
        "Add a plate.",
        "Half-kneeling or standing press.",
        "Landmine push press."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover: the press goes up and forward along the bar's arc, so the front of the shoulder does most of the work (clinical opinion).",
      "lat_deltoid_r": "Helps lift the arm; less than in a vertical press because the arm stays in front of the body (clinical opinion).",
      "triceps_r": "Straightens the elbow in the top half.",
      "upper_traps_r": "Upward rotation and elevation of the shoulder blade overhead.",
      "serratus_r": "Upward rotation of the shoulder blade so the arm can reach overhead.",
      "obliques_r": "Stop the trunk side-bending away from the one-sided load. A unilateral press gave much higher external oblique activity than a bilateral press (Saeterbakken 2012).",
      "obliques_l": "Stop the trunk side-bending away from the one-sided load. A unilateral press gave much higher external oblique activity than a bilateral press (Saeterbakken 2012).",
      "core": "Braces the trunk; kneeling takes away help from the legs, so the trunk works more (clinical opinion).",
      "glute_max_r": "Both glutes squeeze to keep the hips extended and the pelvis stacked over the knees (clinical opinion).",
      "glute_max_l": "Both glutes squeeze to keep the hips extended and the pelvis stacked over the knees (clinical opinion).",
      "spinal_extensors_r": "Keep the trunk tall; a unilateral press activated the back stabilizers more than a bilateral press (Trunk 2005; Saeterbakken 2012).",
      "spinal_extensors_l": "Keep the trunk tall; a unilateral press activated the back stabilizers more than a bilateral press (Trunk 2005; Saeterbakken 2012).",
      "infraspinatus_r": "Rotator cuff: centres the ball of the shoulder as the arm rises."
    }
  },
