      "title": "Dumbbell Romanian Deadlift",
      "url": "https://gymvisual.com/videos/2962-dumbbell-romanian-deadlift.html",
      "listing": "Video; data sheet: body part Thighs, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (hamstrings) and hips",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Lower back",
      "Forearms (grip)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip hinge)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hamstrings_r",
        "hamstrings_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "lats_r",
        "lats_l",
        "upper_traps_r",
        "upper_traps_l",
        "core"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the top, lower with the brace, breathe out as you stand.",
      "cadence": "About 2.2 s down, short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-1-1-1",
      "load": "User-chosen dumbbells; stop about 2 reps short of failure (RIR 2)",
      "frequency": "1-2 times a week",
      "progression": "Add load, then single-leg RDL"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, dumbbells in front of the thighs, palms facing you, knees soft."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Push the hips back, keep the back flat and slide the dumbbells down the front of the thighs."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop at about mid-shin, or where the hamstrings are stretched with the back still flat."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the hips forward to stand tall, dumbbells close to the legs."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall without leaning back; breathe and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back to go lower",
        "fix": "Stop where the back is still flat; the range comes from the hips."
      },
      {
        "id": "m2",
        "mistake": "Squatting the weight down (knees bending a lot)",
        "fix": "Keep the knee bend small and constant; push the hips back."
      },
      {
        "id": "m3",
        "mistake": "Dumbbells drifting away from the legs",
        "fix": "Keep them brushing the thighs and shins."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈6°",
        "peak": "≈106° (joint channel), trunk ≈20° above horizontal",
        "norm": "Peak hip flexion about 98-103 degrees in barbell and landmine RDLs (McCurdy 2025)",
        "sources": [
          "mccurdy2025"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈6°",
        "peak": "≈22°",
        "norm": "Small, nearly constant soft knee bend, about 15-25 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar motion",
        "setup": "Neutral",
        "peak": "Spine channels -3°/0°/1° (L5/T12/T6): neutral",
        "norm": "Neutral spine; about 7 degrees of lumbar motion was measured in RDLs (McCurdy 2025)",
        "sources": [
          "mccurdy2025"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.2 s down to a handle height of 37 cm (upper shin), 0.3 s pause, 1.3 s up, 1.4 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #145912, Dumbbell Romanian Deadlift, video (movement reference)",
        "url": "https://gymvisual.com/videos/2962-dumbbell-romanian-deadlift.html"
      },
      {
        "id": "mccurdy2025",
        "title": "McCurdy & Koldenhoven 2025, comparison of muscle activation and range of motion between the traditional and landmine Romanian deadlift (Int J Strength Cond 5(1))",
        "url": "https://doi.org/10.47206/ijsc.v5i1.370"
      },
      {
        "id": "lee2018",
        "title": "Lee et al. 2018, an electromyographic and kinetic comparison of conventional and Romanian deadlifts (J Exerc Sci Fit; PMC6323186)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/30662500/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: shorten the range and keep the spine neutral; seek advice if pain persists."
      ],
      "modify": [
        "Tight hamstrings: stop higher (around the knees) and bend the knees a little more.",
        "Balance: stand with the feet a little wider."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Shorter range (to the knees).",
        "Bodyweight hip hinge with a dowel on the back."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Single-leg dumbbell RDL.",
        "Barbell RDL."
      ]
    },
    "muscleNotes": {
      "hamstrings_r": "Lengthen under load as the hips hinge back, then extend the hips. Biceps femoris averaged about 41% MVIC lowering and 72% MVIC rising in a barbell RDL (McCurdy 2025).",
      "hamstrings_l": "Lengthen under load as the hips hinge back, then extend the hips. Biceps femoris averaged about 41% MVIC lowering and 72% MVIC rising in a barbell RDL (McCurdy 2025).",
      "glute_max_r": "Extends the hips on the way up; gluteus maximus activity was a little lower in the Romanian than the conventional deadlift (Lee 2018).",
      "glute_max_l": "Extends the hips on the way up; gluteus maximus activity was a little lower in the Romanian than the conventional deadlift (Lee 2018).",
      "spinal_extensors_r": "Hold the spine neutral; lumbar motion stayed about 7 degrees in the RDLs measured by McCurdy 2025.",
      "spinal_extensors_l": "Hold the spine neutral; lumbar motion stayed about 7 degrees in the RDLs measured by McCurdy 2025.",
      "adductors_r": "Adductor magnus assists hip extension.",
      "adductors_l": "Adductor magnus assists hip extension.",
      "forearm_flexors_r": "Grip the dumbbells.",
      "forearm_flexors_l": "Grip the dumbbells.",
      "lats_r": "Keep the dumbbells close to the legs.",
      "lats_l": "Keep the dumbbells close to the legs.",
      "upper_traps_r": "Hold the shoulders against the pull of the dumbbells.",
      "upper_traps_l": "Hold the shoulders against the pull of the dumbbells.",
      "core": "Brace the trunk."
    }
  },
