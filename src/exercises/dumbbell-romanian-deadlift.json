    "name": "Dumbbell Romanian Deadlift",
    "aliases": [
      "Dumbbell RDL",
      "DB Romanian deadlift",
      "Dumbbell stiff-leg deadlift (soft knees)"
    ],
    "reference": {
      "source": "GymVisual",
