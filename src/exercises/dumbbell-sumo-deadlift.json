      "listing": "Video; data sheet: body part Hips, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes) and thighs",
    "secondaryBodyParts": [
      "Adductors (inner thigh)",
      "Quadriceps",
      "Lower back",
      "Forearms (grip)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip and knee extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l",
        "adductors_r",
        "adductors_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "upper_traps_r",
        "upper_traps_l",
        "core",
        "glute_med_r",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the top, hold the brace down and up, breathe out at the top.",
      "cadence": "About 2 s down, light touch, 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-1",
      "load": "User-chosen dumbbell; stop about 2 reps short of failure (RIR 2)",
      "frequency": "1-2 times a week",
      "progression": "Heavier dumbbell, then a kettlebell or barbell sumo deadlift"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet wide, toes turned out, one dumbbell hanging upright between the legs, both hands under the top plate."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Sit the hips back and down, knees pushing out over the toes, chest up, back flat."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Touch the end of the dumbbell lightly to the floor between your feet."
      },
      {
        "id": "c4",
        "phase": "lift",
        "text": "Push the floor apart and stand tall, the dumbbell rising straight up close to the body."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the glutes at the top without leaning back; breathe and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Knees caving in",
        "fix": "Push the knees out in line with the toes all the way."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back to reach the floor",
        "fix": "Sit deeper with the hips or stop the dumbbell higher."
      },
      {
        "id": "m3",
        "mistake": "Swinging the dumbbell forward",
        "fix": "Keep it hanging straight under the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈2°",
        "peak": "≈119° flexion with 34° abduction (joint channels)",
        "norm": "More hip abduction and external rotation and less hip flexion than the conventional deadlift (Hanen 2025)",
        "sources": [
          "hanen2025"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈4°",
        "peak": "≈95°, knee 9.4° off the toe line (seen from above)",
        "norm": "Quadriceps work more at deeper knee flexion; peak knee flexion did not differ from the conventional style (PubMed 11932579; Hanen 2025)",
        "sources": [
          "escamilla2002",
          "hanen2025"
        ]
      },
      {
        "measure": "Stance",
        "setup": "Ankles 54 cm apart, toes out 30°",
        "peak": "Unchanged",
        "norm": "Feet wider than the shoulders, toes turned out about 30 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈38° from vertical, spine neutral",
        "norm": "More upright than a conventional deadlift (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2 s down, 0.3 s touch, 1.3 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #819212, Dumbbell Sumo Deadlift (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/19020-dumbbell-sumo-deadlift-male.html"
      },
      {
        "id": "escamilla2002",
        "title": "An electromyographic analysis of sumo and conventional style deadlifts (Med Sci Sports Exerc 34(4):682-688, 2002; PubMed 11932579)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/11932579/"
      },
      {
        "id": "hanen2025",
        "title": "Hanen, Ben Mansour, Ertel, Duchene & Gauchard 2025, biomechanical analysis of conventional and sumo deadlift (Front Bioeng Biotechnol 13:1597209)",
        "url": "https://www.frontiersin.org/journals/bioengineering-and-biotechnology/articles/10.3389/fbioe.2025.1597209/full"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Groin or hip pain: narrow the stance and turn the toes out less."
      ],
      "modify": [
        "Limited hip mobility: stop the dumbbell higher, or stand on two low steps.",
        "Knee pain: sit back more and keep the shins more vertical."
      ],
      "regressions": [
        "Lighter dumbbell.",
        "Sumo box squat holding the dumbbell."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Pause just off the floor.",
        "Sumo deadlift from a deficit (feet on two steps)."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Extends the hips as you stand; late in the lift it was more active in sumo than in the conventional deadlift (Hanen 2025).",
      "glute_max_l": "Extends the hips as you stand; late in the lift it was more active in sumo than in the conventional deadlift (Hanen 2025).",
      "quads_r": "Extend the knees: vastus medialis and lateralis were more active in the sumo than in the conventional deadlift (PubMed 11932579; Hanen 2025).",
      "quads_l": "Extend the knees: vastus medialis and lateralis were more active in the sumo than in the conventional deadlift (PubMed 11932579; Hanen 2025).",
      "adductors_r": "The wide stance puts adductor magnus to work as a hip extensor; it was more active late in the sumo lift (Hanen 2025).",
      "adductors_l": "The wide stance puts adductor magnus to work as a hip extensor; it was more active late in the sumo lift (Hanen 2025).",
      "hamstrings_r": "Hip extensors; biceps femoris was more active in the conventional style (Hanen 2025).",
      "hamstrings_l": "Hip extensors; biceps femoris was more active in the conventional style (Hanen 2025).",
      "spinal_extensors_r": "Keep the back flat; the sumo stance lets the trunk stay more upright (clinical opinion).",
      "spinal_extensors_l": "Keep the back flat; the sumo stance lets the trunk stay more upright (clinical opinion).",
      "forearm_flexors_r": "Hold the dumbbell by its top plate.",
      "forearm_flexors_l": "Hold the dumbbell by its top plate.",
      "upper_traps_r": "Hold the shoulders against the pull of the dumbbell.",
      "upper_traps_l": "Hold the shoulders against the pull of the dumbbell.",
      "core": "Brace the trunk.",
      "glute_med_r": "Push the knees out over the toes.",
      "glute_med_l": "Push the knees out over the toes."
    }
