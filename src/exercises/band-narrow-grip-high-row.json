    },
    "type": "Strength",
    "bodyPart": "Back (lats, middle trapezius, rhomboids)",
    "secondaryBodyParts": [
      "Rear of the shoulders",
      "Biceps"
    ],
    "equipment": [
      "Resistance band",
      "Rack (band anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
