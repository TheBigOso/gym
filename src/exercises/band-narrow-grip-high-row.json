      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row the hands to the chest, breathe in as the arms reach back up.",
      "cadence": "About 1 s row, short squeeze, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1",
      "progression": "More reps, a longer squeeze, a step farther from the rack, then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing a rack, feet about hip width, knees soft. The band is looped round the upright above head height; hold both strands close together, palms facing, arms reaching up toward the upright."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and pull the hands down and back to the upper chest, elbows travelling down and back close to the body, chest up."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the shoulder blades back and down; hands at the top of the chest."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the arms reach back up toward the upright under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the band taut, then row again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back to pull with body weight",
        "fix": "Stand tall; the arms and shoulder blades do the work."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders up at the end",
        "fix": "Finish with the shoulders down and back."
      },
      {
        "id": "m3",
        "mistake": "Hands drifting apart",
        "fix": "Keep the hands together, palms facing."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the arms back",
        "fix": "Return for about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Arm path",
        "setup": "Reaching up toward the upright, ≈102° of elevation",
        "peak": "Elbows beside the ribs (≈10°), hands 1.8 cm below the shoulders",
        "norm": "From reaching up toward the anchor (about 100-110 degrees of elevation) down to the elbows beside the ribs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈18°",
        "peak": "≈126°",
        "norm": "Nearly straight at the reach to about 110-130 degrees at the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral, palms facing; grip points 13.9 cm apart",
        "peak": "Grip points 11.5 cm apart",
        "norm": "Narrow neutral grip, hands together; close-grip pulldowns and rows load the lats comparably to wide grips (Lehman 2004).",
        "sources": [
          "lehman2004"
        ]
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack upright on the midline 178.4 cm up, 92 cm in front of the shoulders; strands 45.5 cm",
        "peak": "Strands 87.3 cm at the chest",
        "norm": "Elastic resistance can give muscle activity comparable to free weights at a matched effort (Andersen 2010).",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s with the arms long",
        "peak": "1.1 s row, 0.4 s squeeze, 1.8 s back, 0.4 s pause",
        "norm": "About 1 s row and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Narrow Grip High Row, video (movement reference)",
        "url": "https://gymvisual.com/videos/12877-band-narrow-grip-high-row.html"
      },
      {
        "id": "lehman2004",
        "title": "Lehman et al. 2004, variations in muscle activation levels during traditional latissimus dorsi weight training exercises (Dynamic Medicine 3:4)",
        "url": "https://link.springer.com/article/10.1186/1476-5918-3-4"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Shoulder pain with the arms high: start the reach lower (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: anchor the band at chest height (horizontal row)."
      ],
      "regressions": [
        "Lighter band or step closer to the rack.",
        "Seated band row."
      ],
      "progressions": [
        "Stronger band or step farther away.",
        "Pause 2 s at the chest.",
        "Cable close-grip pulldown or high row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Pull the arms down and back from overhead (shoulder extension); Lehman 2004 compared lat activity across grips in rows and pulldowns.",
      "lats_l": "Pull the arms down and back from overhead (shoulder extension); Lehman 2004 compared lat activity across grips in rows and pulldowns.",
      "rhomboids_midtrap_r": "Retract the shoulder blades at the chest.",
      "rhomboids_midtrap_l": "Retract the shoulder blades at the chest.",
      "post_deltoid_r": "Extends the arms behind the trunk line.",
      "post_deltoid_l": "Extends the arms behind the trunk line.",
      "biceps_r": "Bends the elbows; the neutral grip shares the work with the brachialis and brachioradialis.",
      "biceps_l": "Bends the elbows; the neutral grip shares the work with the brachialis and brachioradialis.",
      "infraspinatus_r": "Steadies the shoulders.",
      "infraspinatus_l": "Steadies the shoulders.",
      "forearm_flexors_r": "Grip the band.",
      "forearm_flexors_l": "Grip the band.",
      "upper_traps_r": "Steady the shoulder blades.",
      "upper_traps_l": "Steady the shoulder blades.",
      "core": "Keeps the trunk upright against the band.",
      "spinal_extensors_r": "Hold the chest up.",
      "spinal_extensors_l": "Hold the chest up."
    }
