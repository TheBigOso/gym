        "forearm_flexors_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in at the top, hold a brace as you lower, breathe out as you press through the sticking point.",
      "cadence": "About 2.4 s down, short pause, about 1.4 s up"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "2-8 (quality reps only)",
      "tempo": "2-1-1-0",
      "frequency": "2 times a week",
      "progression": "Pike push-up, then feet-on-box pike push-up, then negatives against the wall, then full reps, then a deficit (hands on blocks)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kick up into a handstand with your back to the wall: hands just wider than the shoulders about a hand length from the wall, arms locked, heels resting on the wall."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Brace, bend the elbows and lower the head under control; the head travels slightly in front of the hands, elbows angled forward and out."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Crown of the head just above the mat: the head and hands form a triangle."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the floor away, pushing the head back through the arms to straight elbows."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Lock out and stack the body; heels lightly on the wall."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Crashing the head into the floor",
        "fix": "Lower slowly, put a folded mat under the head and only go as deep as you can control."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring straight out to the sides",
        "fix": "Keep the elbows angled forward at about 45 degrees."
      },
      {
        "id": "m3",
        "mistake": "Big low-back arch",
        "fix": "Brace the abs and squeeze the glutes; ribs down."
      },
      {
        "id": "m4",
        "mistake": "Hands too far from the wall",
        "fix": "About a hand length away; too far makes the body bow and the heels slide."
      }
    ],
    "kinematics": [
      {
        "measure": "Hand placement",
        "setup": "Wrists 46 cm apart (shoulder joints 40 cm), 25.3 cm from the wall face",
        "peak": "Unchanged (hands planted)",
        "norm": "Hands just wider than the shoulders, about 10-25 cm from the wall, fingers spread (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈7° (locked out)",
        "peak": "≈95° at the bottom",
        "norm": "From locked out to about 90 degrees or more with the head just above the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder flexion",
        "setup": "Arm 174° from the trunk line (overhead)",
        "peak": "144° at the bottom",
        "norm": "Arms overhead (about 170-180 degrees) at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Head path",
        "setup": "Crown 25.5 cm above the floor",
        "peak": "2.5 cm above the floor, 13 cm in front of the wrists",
        "norm": "The head lowers slightly in front of the hands so head and hands form a triangle at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line",
        "setup": "Trunk 1° from vertical; heels on the wall",
        "peak": "6° at the bottom; heels slide down the wall 25.5 cm",
        "norm": "Body close to vertical, slight lean toward the wall, heels resting on it (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "1 s at the top",
        "peak": "2.4 s down, 0.3 s pause, 1.4 s up, 0.9 s lock-out",
        "norm": "Slow lowering of about 2-3 s; press as one smooth effort (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11591, Handstand Push-up (movement reference only)",
        "url": "https://gymvisual.com/videos/11591-handstand-push-up.html"
      },
      {
        "id": "marcolin2015",
        "title": "Marcolin, Petrone, Moro, Battaglia, Bianco and Paoli 2015, selective activation of shoulder, trunk and arm muscles: a comparative analysis of different push-up variants (J Athl Train 50(11):1126-1132)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26488636/"
      }
    ],
    "safety": {
      "cautions": [
        "Advanced: only attempt once you can hold a wall handstand for 30 s and do strict pike push-ups (clinical opinion).",
        "Neck: never land on the head with force; use a folded mat or cushion and control the depth.",
        "Avoid with uncontrolled high blood pressure, glaucoma, or recent head, neck or shoulder injury; being upside down raises pressure in the head (clinical opinion).",
        "Wrist pain: the planted palm bends the wrist back about 80-90 degrees; use push-up handles or hex dumbbells to keep the wrists straight, or stop if pain persists (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Not yet strong enough: partial range to a stack of mats, or wall negatives only.",
        "Wrist discomfort: parallettes or push-up handles."
      ],
      "regressions": [
        "Pike push-up.",
        "Feet-on-box pike push-up.",
        "Wall-supported handstand hold."
      ],
      "progressions": [
        "Deficit handstand push-up (hands on blocks).",
        "Freestanding handstand push-up."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover: flexes the shoulder overhead against the full body weight.",
      "ant_deltoid_l": "Main mover: flexes the shoulder overhead against the full body weight.",
      "lat_deltoid_r": "Helps press overhead as the elbows angle out.",
      "lat_deltoid_l": "Helps press overhead as the elbows angle out.",
      "triceps_r": "Straightens the elbows; hardest near the bottom.",
      "triceps_l": "Straightens the elbows; hardest near the bottom.",
      "upper_traps_r": "Upwardly rotate and elevate the shoulder blades so the arms can lock overhead.",
      "upper_traps_l": "Upwardly rotate and elevate the shoulder blades so the arms can lock overhead.",
      "serratus_r": "Upwardly rotates the shoulder blades with the trapezius.",
      "serratus_l": "Upwardly rotates the shoulder blades with the trapezius.",
      "pec_r": "Upper (clavicular) fibres assist shoulder flexion.",
      "pec_l": "Upper (clavicular) fibres assist shoulder flexion.",
      "core": "Bracing stops the low back arching under the load.",
      "obliques_r": "Help keep the trunk rigid.",
      "obliques_l": "Help keep the trunk rigid.",
      "spinal_extensors_r": "Hold the trunk long and stacked.",
      "spinal_extensors_l": "Hold the trunk long and stacked.",
      "glute_max_r": "Squeezed to keep the hips extended and in line.",
      "glute_max_l": "Squeezed to keep the hips extended and in line.",
      "forearm_flexors_r": "Fingers grip the floor for balance.",
      "forearm_flexors_l": "Fingers grip the floor for balance.",
      "infraspinatus_r": "Keeps the shoulder joint centred overhead.",
      "infraspinatus_l": "Keeps the shoulder joint centred overhead."
    }
