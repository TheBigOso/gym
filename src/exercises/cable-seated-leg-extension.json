  },
  "exercise": {
    "id": "cable-seated-leg-extension",
    "name": "Cable Seated Leg Extension",
    "aliases": [
      "Ankle-strap cable knee extension",
      "Seated cable leg extension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14653",
      "title": "Cable Seated Leg Extension",
      "url": "https://gymvisual.com/videos/14653-cable-seated-leg-extension.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [],
    "equipment": [
      "Cable machine (low pulley)",
      "Ankle strap",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (knee extension)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "quads_r"
      ],
      "synergist": [
        "hip_flexors_r"
      ],
      "stabilizer": [
        "core"
      ],
      "lengthened": [
        "hamstrings_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the knee straightens, inhale as it bends.",
      "cadence": "About 1.2 s up, 0.5 s hold, 1.8 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Add a plate on the stack once 15 controlled reps are easy"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall at the end of the bench, right ankle strapped to the low pulley under it, hands on the bench behind you."
      },
      {
        "id": "c2",
        "phase": "up",
        "text": "Breathe out and straighten the right knee against the cable."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the quads with the knee almost straight; thigh stays on the bench."
      },
      {
        "id": "c4",
        "phase": "down",
        "text": "Breathe in and bend the knee slowly back to 90 degrees."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep tension on the cable; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the thigh off the bench",
        "fix": "Only the knee moves; keep the thigh down."
      },
      {
        "id": "m2",
        "mistake": "Kicking the leg up",
        "fix": "Straighten smoothly and pause."
      },
      {
        "id": "m3",
        "mistake": "Leaning far back",
        "fix": "Sit tall; the hands just steady you."
      },
      {
        "id": "m4",
        "mistake": "Letting the stack drop",
        "fix": "Lower over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈88°",
        "peak": "≈10°",
        "norm": "From about 90 degrees to 5-15 degrees (clinical opinion); open-chain extension loads the quadriceps most near extension (Escamilla 1998)",
        "sources": [
          "escamilla1998"
        ]
      },
      {
        "measure": "Hip",
        "setup": "≈88° flexion, trunk 14° back of vertical",
        "peak": "Unchanged",
        "norm": "About 90 degrees, thigh on the bench (standard setup)",
        "sources": []
      },
      {
        "measure": "Cable line",
        "setup": "Pulley under the bench; cable 26 cm",
        "peak": "Cable 74 cm; clears the body by 4.5 cm or more",
        "norm": "Low pulley under the bench, behind the strapped ankle (standard setup)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Seated 0.8 s",
        "peak": "1.2 s up, 0.5 s hold, 1.8 s down",
        "norm": "Controlled, slower down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #14653, Cable Seated Leg Extension, video (movement reference)",
        "url": "https://gymvisual.com/videos/14653-cable-seated-leg-extension.html"
      },
      {
        "id": "escamilla1998",
        "title": "Escamilla et al. 1998, biomechanics of the knee during closed kinetic chain and open kinetic chain exercises (Med Sci Sports Exerc 30(4):556-569; PubMed 9565938)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9565938/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the strap is snug and the clip is closed before each set.",
        "Knee pain at the front of the knee: shorten the range near full extension."
      ],
      "modify": [
        "Lighter stack with a longer pause."
      ],
      "regressions": [
        "Seated knee extension without load."
      ],
      "progressions": [
        "Heavier stack.",
        "Lever leg extension."
      ]
    },
    "muscleNotes": {
      "quads_r": "Open-chain knee extension isolates the quadriceps; activity peaks near full extension (Escamilla 1998).",
      "hip_flexors_r": "Rectus femoris also crosses the hip (clinical opinion).",
      "core": "Keeps the trunk still on the bench (clinical opinion).",
      "hamstrings_r": "Lengthen as the knee straightens (clinical opinion)."
    }
  },
