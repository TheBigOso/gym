    "id": "pistol-squat-to-box",
    "name": "Pistol Squat to Box",
    "aliases": [
      "Box pistol squat",
      "Single-leg box squat",
      "Pistol to bench",
      "One-leg sit to stand"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "13815",
      "title": "Pistol Squat to Box",
      "url": "https://gymvisual.com/videos/13815-pistol-squat-to-box.html",
      "listing": "Video (movement reference; the page could not be read at authoring time: gymvisual.com is blocked by the proxy, so the movement comes from the name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Hips (hip flexors)",
      "Core"
    ],
    "equipment": [
      "Box or bench (about knee height or a little lower)"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (hip, knee and ankle on one leg)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core",
        "obliques_r",
        "obliques_l",
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as you sit down to the box, breathe out as you stand up on one leg.",
      "cadence": "About 2 s down, light touch, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "4-8 per leg",
      "tempo": "2 s down, touch the box without relaxing, 1-2 s up",
      "frequency": "2-3 times a week",
      "progression": "Lower box, then a pause above the box, then the full pistol squat."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on one foot in front of a box, the other leg straight out in front, arms reaching forward."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and sit the hips back and down on one leg; keep the free heel off the floor."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Touch the box lightly with the buttocks; stay braced, do not sit and relax."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive through the whole foot to stand on the same leg."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, find your balance, go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Plopping onto the box",
        "fix": "Lower under control and only touch the box."
      },
      {
        "id": "m2",
        "mistake": "Rocking back to get up",
        "fix": "Lean the chest forward and stand without swinging the arms or free leg."
      },
      {
        "id": "m3",
        "mistake": "Knee caving inward",
        "fix": "Keep the knee over the 2nd-3rd toe."
      },
      {
        "id": "m4",
        "mistake": "Heel lifting",
        "fix": "Keep the whole foot planted; use a higher box if the heel comes up."
      }
    ],
    "kinematics": [
      {
        "measure": "Box height",
        "setup": "45.2 cm box, front edge 17.9 cm behind the stance ankle",
        "peak": "Buttocks touch the box top lightly",
        "norm": "Set so the thigh is about parallel at the touch; lower boxes are harder (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance knee flexion",
        "setup": "≈5°",
        "peak": "≈104°",
        "norm": "Deeper than a controlled single-leg squat (60-90 degrees in Muyor 2020); people squatted as low as possible in Lewis 2015",
        "sources": [
          "muyor2020",
          "lewis2015"
        ]
      },
      {
        "measure": "Stance hip flexion",
        "setup": "≈7°",
        "peak": "≈122° (joint channel)",
        "norm": "Hips sit back as the knee bends (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈1°",
        "peak": "≈35° forward",
        "norm": "Forward lean keeps the centre of mass over the foot (Lewis 2015)",
        "sources": [
          "lewis2015"
        ]
      },
      {
        "measure": "Free leg",
        "setup": "Straight out in front (knee ≈5°), foot 4.2 cm up",
        "peak": "Hip ≈123°, knee ≈5°, lowest 4.2 cm off the floor",
        "norm": "Held off the floor in front of the body (Lewis 2015)",
        "sources": [
          "lewis2015"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Balance 0.8 s",
        "peak": "2.1 s down, 0.5 s light touch on the box, 1.3 s up, 1.1 s reset",
        "norm": "About 2 s down, 1-2 s up (clinical opinion)",
        "sources": []
      }
    ],
