      "spinal_extensors_r": "Hold the forward-leaning trunk (clinical opinion).",
      "spinal_extensors_l": "Hold the forward-leaning trunk (clinical opinion).",
      "core": "Brace the trunk (clinical opinion).",
      "obliques_r": "Resist trunk rotation on one leg (clinical opinion).",
