    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a box that cannot slide or tip.",
        "Knee pain in deep single-leg flexion: raise the box."
      ],
      "modify": [
        "Balance: hold a support with one hand.",
        "Free leg too heavy: bend its knee a little."
      ],
      "regressions": [
        "Box squat on two legs.",
        "Bodyweight single-leg squat to a higher box."
      ],
      "progressions": [
        "Lower box.",
        "Pistol squat without the box."
      ]
