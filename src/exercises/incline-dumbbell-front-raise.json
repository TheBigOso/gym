    "id": "incline-dumbbell-front-raise",
    "name": "Incline Dumbbell Front Raise",
    "aliases": [
      "Incline bench front raise",
      "Lying incline front raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "117612",
      "title": "Dumbbell Incline Front Raise",
      "url": "https://gymvisual.com/videos/5284-dumbbell-incline-front-raise.html",
      "listing": "Video; data sheet: body part Shoulders, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (anterior deltoid)",
    "secondaryBodyParts": [
      "Chest (upper)"
    ],
    "equipment": [
      "Dumbbell",
      "Adjustable bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (shoulder)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "synergist": [
        "pec_r",
        "pec_l",
        "serratus_r",
        "serratus_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "biceps_r",
        "biceps_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; lighter than for a standing front raise (clinical opinion)",
      "progression": "Add reps, then 1-2 kg"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie back on a 30-45 degree incline, head and upper back on the pad, feet flat. Arms hang straight down to the floor, palms in, elbows soft."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise both arms forward and up in an arc, keeping the elbows soft."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop with the arms vertical over the shoulders; keep the shoulder blades on the pad."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s back to hanging straight down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause in the stretch (no bouncing) and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the arms drop fast into the bottom stretch",
        "fix": "Lower with a 2 s count and stop with the arms vertical to the floor."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbows to shorten the lever",
        "fix": "Keep the same soft bend all the way."
      },
      {
        "id": "m3",
        "mistake": "Lifting the head and shoulders off the pad",
        "fix": "Keep the back and head on the pad; lighter dumbbells."
      }
    ],
    "kinematics": [
      {
        "measure": "Back pad angle",
        "setup": "40° (trunk line ≈33° above horizontal)",
        "peak": "unchanged; back and head on the pad",
        "norm": "Incline set to about 30-45 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder flexion",
        "setup": "upper arm 70° below horizontal (hanging), ≈59° from the trunk line, behind it",
        "peak": "upper arm 84° above horizontal (vertical), ≈123° from the trunk line",
        "norm": "From arms hanging vertical (shoulder slightly extended relative to the trunk) to arms vertical overhead of the shoulders, about 90 degrees of world arc (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12°",
        "peak": "≈12°",
        "norm": "Elbows soft, about 10-15 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "palms in, dumbbells beside the bench",
        "peak": "palms in, dumbbells over the shoulders",
        "norm": "Neutral (palms in) throughout so the dumbbells clear the pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s hanging",
        "peak": "2.0 s up, 0.4 s at the top, 2.2 s down",
        "norm": "About 2 s up, short pause, 2 s down (clinical opinion; Coratella 2020 used 2-0.5-2 for standing raises)",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #117612, Dumbbell Incline Front Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/5284-dumbbell-incline-front-raise.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://johk.pl/?p=5707"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "No EMG study of the incline front raise was found; the muscle roles are inferred from standing raise EMG and anatomy.",
        "The bottom position stretches the front of the shoulder; skip or shorten it if that is uncomfortable."
      ],
      "modify": [
        "Front-of-shoulder discomfort at the bottom: start with the arms beside the bench instead of fully hanging.",
        "Use a steeper incline (45 degrees) for a shorter stretch."
      ],
      "regressions": [
        "Standing or seated front raise.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Slower lowering (3 s).",
        "Pause for 1 s at the bottom."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover: shoulder flexion from a stretched start (arms hanging behind the trunk line). Hardest near the bottom, where the arm is horizontal-to-the-floor torque is highest (clinical opinion; the frontal raise gave the highest anterior deltoid activity among raises, Coratella 2020).",
      "ant_deltoid_l": "Main mover: shoulder flexion from a stretched start (arms hanging behind the trunk line). Hardest near the bottom, where the arm is horizontal-to-the-floor torque is highest (clinical opinion; the frontal raise gave the highest anterior deltoid activity among raises, Coratella 2020).",
      "pec_r": "The clavicular head helps flex the shoulder, especially in the first half (Coratella 2020 found it most active in the frontal raise).",
      "pec_l": "The clavicular head helps flex the shoulder, especially in the first half (Coratella 2020 found it most active in the frontal raise).",
      "serratus_r": "Protracts and upwardly rotates the shoulder blade as the arms reach up.",
      "serratus_l": "Protracts and upwardly rotates the shoulder blade as the arms reach up.",
      "lat_deltoid_r": "Helps hold the arm; low in frontal raises (Coratella 2020).",
      "lat_deltoid_l": "Helps hold the arm; low in frontal raises (Coratella 2020).",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred in the stretched start.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred in the stretched start.",
      "biceps_r": "The long head helps flex the shoulder with the elbow nearly straight (clinical opinion).",
      "biceps_l": "The long head helps flex the shoulder with the elbow nearly straight (clinical opinion).",
      "core": "Keeps the back on the pad."
    }
  },
