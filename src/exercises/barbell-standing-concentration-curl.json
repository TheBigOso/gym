        "post_deltoid_r",
        "post_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Brace in the hinge; breathe out as the bar comes up, in as it lowers.",
      "cadence": "About 1.2 s up, 0.3 s squeeze, 2.4 s down"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "60-90 seconds between sets",
      "sets": "2-3",
      "reps": "8-12",
      "tempo": "1 s up, short squeeze, 2-3 s down",
      "load": "Barbell load is user-chosen: light; the upper arms and trunk must stay still, about 2 reps in reserve.",
      "progression": "Add reps, then a small amount of weight."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet hip width, soft knees, hinge forward until the trunk is well inclined, back flat; underhand grip about shoulder width, arms hanging straight down."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Curl the bar up toward the face; the upper arms stay hanging still."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the biceps hard at the top."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly to straight arms, upper arms still."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hinge and the brace for the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the upper arms forward",
        "fix": "Keep the elbows hanging under the shoulders; lighten the bar."
      },
      {
        "id": "m2",
        "mistake": "Standing up during the curl",
        "fix": "Hold the hinge; only the forearms move."
      },
      {
        "id": "m3",
        "mistake": "Rounding the back",
        "fix": "Brace and hinge only as far as a flat back allows."
      },
      {
        "id": "m4",
        "mistake": "Short range",
        "fix": "Straighten the arms fully at the bottom."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈2° (arm straight)",
        "peak": "≈123° at the top (range ≈121°)",
        "norm": "Full range from a straight arm to about 130-145 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "5.2° (palm forward/up)",
        "peak": "-1.3° (palm forward/up)",
        "norm": "Palms up the whole rep with a straight bar (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈57°",
        "peak": "≈59° (elbow forward)",
        "norm": "Upper arms hang vertically under the shoulders while the trunk is hinged (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar clearance",
        "setup": "Underhand, 42 cm between the handle points; bar 1.6 cm or more off the body",
        "peak": "Grip width steady within 0.66 cm; at the top the bar is 1.6 cm from the head",
        "norm": "Bar clear of the legs and the head (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "About 1 s up and 2-3 s down (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk angle",
        "setup": "≈58° from vertical (hip channel ≈92°), knees ≈20°",
        "peak": "Unchanged (held); upper arms hang straight down",
        "norm": "Hinged trunk held still; bent-over positions load the lower back (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      }
    ],
    "safety": {
      "cautions": [
        "Hold the brace and the hinge for the whole set; stand up and rest if the back starts to round.",
        "Low-back pain: do a seated dumbbell concentration curl instead.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower back: smaller hinge or rest the free forearm on a bench (dumbbell version)."
      ],
      "regressions": [
        "Seated dumbbell concentration curl.",
        "Dumbbell biceps curl."
      ],
      "progressions": [
        "Slower lowering.",
        "Pause at the top."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Bends the elbows with the upper arms hanging straight down, so the curl works hardest at the top.",
      "biceps_l": "Bends the elbows with the upper arms hanging straight down, so the curl works hardest at the top.",
      "forearm_flexors_r": "Hold the bar and help bend the elbows.",
      "forearm_flexors_l": "Hold the bar and help bend the elbows.",
      "spinal_extensors_r": "Hold the hinged back flat.",
      "spinal_extensors_l": "Hold the hinged back flat.",
      "hamstrings_r": "Hold the hips in the hinge.",
      "hamstrings_l": "Hold the hips in the hinge.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Bracing keeps the trunk still.",
      "post_deltoid_r": "Keeps the upper arms hanging still.",
      "post_deltoid_l": "Keeps the upper arms hanging still."
    },
