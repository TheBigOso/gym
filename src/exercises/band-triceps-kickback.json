    "bodyPart": "Upper arms (triceps)",
    "secondaryBodyParts": [
      "Shoulders",
      "Back",
      "Core"
    ],
    "equipment": [
      "Resistance band"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [],
      "stabilizer": [
        "post_deltoid_r",
        "post_deltoid_l",
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you straighten the elbows, inhale as the hands return.",
      "cadence": "About 1 s back, 0.6 s squeeze, about 1.8 s forward"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1-1-2-0 (back, squeeze, forward)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Band tension is user-chosen; the band is hardest with the arms straight, where it is stretched most",
      "progression": "More reps, a longer squeeze, then a stronger band or a shorter hold on the band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the middle of the band, feet hip width; hinge forward with a flat back, knees soft. Draw the elbows back by your sides, forearms hanging, palms facing in."
      },
      {
        "id": "c2",
        "phase": "extend",
        "text": "Breathe out and straighten the elbows, pushing the hands back; the upper arms stay still."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the backs of the arms with the arms straight, where the band is tightest."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the forearms swing slowly back down against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Elbows still tucked, back flat; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the upper arms instead of straightening the elbows",
        "fix": "Pin the elbows by the sides; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back or standing up during the set",
        "fix": "Hold the hip hinge with a flat back and braced trunk."
      },
      {
        "id": "m3",
        "mistake": "Letting the band snap the hands forward",
        "fix": "Take about 2 s to return."
      },
      {
        "id": "m4",
        "mistake": "Elbows dropping as the band gets tight",
        "fix": "Keep the upper arms up along the sides; use a lighter band."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈95° (forearms hanging)",
        "peak": "≈8° (arms straight back)",
        "norm": "From about 90 degrees (forearm hanging) to straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm to trunk",
        "setup": "≈19° from the trunk line, 20° below horizontal",
        "peak": "≈20° (held still)",
        "norm": "Upper arm along the trunk (low shoulder elevation), where the long head carried the most force (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈35° above horizontal; knees ≈25°",
        "peak": "Unchanged",
        "norm": "Hip hinge with a flat back, trunk well forward (about 30-45 degrees above horizontal), knees soft (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "One band per hand, under the ball of each foot; strand 69.2 cm with the forearms hanging",
        "peak": "Strand 94.7 cm with the arms straight back (most stretch, most tension)",
        "norm": "Elastic tension rises as the band stretches, so the load is highest where the band is longest; at matched effort, elastic tubing and dumbbells gave similar muscle activity in upper-body exercises (Andersen 2010); with the band under the feet the load is highest with the arms straight back",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hold the hinge 0.5 s",
        "peak": "1.0 s back, 0.6 s squeeze, 1.8 s forward",
        "norm": "Slow and controlled with a pause at full extension (clinical opinion); the EMG comparison used sets of 7 reps at 70% of 1RM (Boehler 2011)",
        "sources": [
          "boehler2011"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #10725, Band Triceps Kickback, video (movement reference)",
        "url": "https://gymvisual.com/videos/10725-band-triceps-kickback.html"
      },
      {
        "id": "boehler2011",
        "title": "Boehler 2011, electromyographic analysis of the triceps brachii muscle during a variety of triceps exercises (MS thesis, University of Wisconsin-La Crosse, ACE-sponsored; 15 women, 8 exercises at 70% 1RM)",
        "url": "https://minds.wisc.edu/items/4876923b-3a14-47c3-9a69-decf731bd027"
      },
      {
        "id": "kholinne2018",
        "title": "The different role of each head of the triceps brachii muscle in elbow extension (Acta Orthop Traumatol Turc 2018;52(3):201-205; PubMed 29503079; EMG plus OpenSim at 0-180 degrees of shoulder elevation)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29503079/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Lower back pain: keep the back flat and the knees bent; stand up between sets if the back tires (clinical opinion).",
        "Elbow pain: lighter band, slower tempo.",
        "Check the band for nicks or tears before each set and make sure it cannot slip off its anchor (under the feet, round the upright). Stand firmly on its middle so it cannot slip out from under the feet.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Back discomfort in the hinge: one arm at a time with the other hand on a bench (as in the dumbbell kickback).",
        "Too hard at full extension: step on the band with the feet closer together, or hold the band longer."
      ],
      "regressions": [
        "Lighter band, shorter range.",
        "One arm at a time, supported on a bench."
      ],
      "progressions": [
        "Stronger band.",
        "Longer pause at full extension.",
        "Dumbbell or cable kickback."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Straightens the elbow against the band; the load peaks with the arm straight, where the band is stretched most. Kickbacks led an eight-exercise triceps EMG comparison with dips and triangle push-ups (Boehler 2011, dumbbells); with the upper arm near the trunk the long head produced the most force (Kholinne 2018).",
      "triceps_l": "Straightens the elbow against the band; the load peaks with the arm straight, where the band is stretched most. Kickbacks led an eight-exercise triceps EMG comparison with dips and triangle push-ups (Boehler 2011, dumbbells); with the upper arm near the trunk the long head produced the most force (Kholinne 2018).",
      "post_deltoid_r": "Holds the upper arm up along the trunk (clinical opinion).",
      "post_deltoid_l": "Holds the upper arm up along the trunk (clinical opinion).",
      "lats_r": "Help keep the upper arm against the side (clinical opinion).",
      "lats_l": "Help keep the upper arm against the side (clinical opinion).",
      "rhomboids_midtrap_r": "Hold the shoulder blade back so the upper arm stays still (clinical opinion).",
      "rhomboids_midtrap_l": "Hold the shoulder blade back so the upper arm stays still (clinical opinion).",
      "forearm_flexors_r": "Grip the band; keep the wrist straight.",
      "forearm_flexors_l": "Grip the band; keep the wrist straight.",
      "core": "Braces the trunk in the hinge.",
      "spinal_extensors_r": "Keep a flat back in the bent-over position.",
      "spinal_extensors_l": "Keep a flat back in the bent-over position."
    }
  },
