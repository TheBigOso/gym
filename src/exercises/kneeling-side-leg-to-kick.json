  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "kneeling-side-leg-to-kick",
    "name": "Kneeling Side Leg to Kick",
    "aliases": [
      "Fire hydrant kick-out",
      "Quadruped side kick",
      "Hydrant with leg extension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "10855",
      "title": "Kneeling Side Leg to Kick (male)",
      "url": "https://gymvisual.com/videos/10855-kneeling-side-leg-to-kick-male.html",
      "listing": "GymVisual page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching knowledge",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (quadriceps)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip abduction, then knee extension with the leg held out)",
    "plane": "Multiplanar",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_med_r",
        "glute_max_r"
      ],
      "synergist": [
        "quads_r",
        "hip_flexors_r"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "serratus_r",
        "serratus_l",
        "glute_med_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the leg lifts and kicks out, breathe in as it bends and lowers.",
      "cadence": "About 2.2 s out, short hold, 1.4 s back"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 per side",
      "tempo": "0.8 s lift, 0.6 s kick, short hold, 0.6 s bend, 0.8 s lower",
      "frequency": "2-3 times a week",
      "progression": "Longer hold with the leg out, then a band just above the knees"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "All fours: hands under the shoulders, knees under the hips, back flat."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Keep the knee bent and lift the right leg out to the side (fire hydrant) until the thigh is about level with the hip."
      },
      {
        "id": "c3",
        "phase": "kick",
        "text": "Straighten the knee and kick the foot out to the side, leg long and level."
      },
      {
        "id": "c4",
        "phase": "hold",
        "text": "Hold briefly; hips stay square, the trunk does not lean away."
      },
      {
        "id": "c5",
        "phase": "bend",
        "text": "Bend the knee back to the hydrant position."
      },
      {
        "id": "c6",
        "phase": "lower",
        "text": "Lower the knee back under the hip under control."
      },
      {
        "id": "c7",
        "phase": "reset",
        "text": "Repeat; then the other side."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning the trunk away from the lifted leg",
        "fix": "Keep the weight even on both hands; lift only as high as the trunk stays still."
      },
      {
        "id": "m2",
        "mistake": "Rotating the pelvis open",
        "fix": "Keep the hips square to the mat."
      },
      {
        "id": "m3",
        "mistake": "Snapping the knee straight",
        "fix": "Extend the knee smoothly and stop short of locking hard."
      },
      {
        "id": "m4",
        "mistake": "Low back sagging",
        "fix": "Brace the stomach; flat back."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "≈2°",
        "peak": "44° channel (rig limit 45°): thigh ≈44° out from vertical in the hydrant",
        "norm": "Thigh lifts out to about level with the hip (fire hydrant); quadruped hip abduction targets the gluteus medius (Distefano 2009; Boren 2011)",
        "sources": [
          "distefano2009",
          "boren2011"
        ]
      },
      {
        "measure": "Knee extension",
        "setup": "≈90° in the hydrant",
        "peak": "≈5°: leg level (ankle 0.1 cm from hip height), 44° out from straight back",
        "norm": "From about 90 degrees to nearly straight with the leg held out (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and trunk",
        "setup": "Trunk 74° from vertical",
        "peak": "Unchanged (pelvis fixed, no lean)",
        "norm": "Still and square (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hands and knees",
        "setup": "Hands under the shoulders, knees under the hips (hip 74°)",
        "peak": "Hands and the left knee stay planted",
        "norm": "Supporting hands and knee stay planted (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s on all fours",
        "peak": "0.8 s lift, 0.6 s kick, 0.4 s hold, 0.6 s bend, 0.8 s lower",
        "norm": "Controlled, no swinging (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #10855, Kneeling Side Leg to Kick (male), video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/10855-kneeling-side-leg-to-kick-male.html"
      },
      {
        "id": "distefano2009",
        "title": "Distefano et al. 2009, gluteal muscle activation during common therapeutic exercises (J Orthop Sports Phys Ther 39(7):532-540)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19574661/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      },
      {
        "id": "ekstrom2007",
        "title": "Ekstrom, Donatelli and Carp 2007, electromyographic analysis of core trunk, hip and thigh muscles during 9 rehabilitation exercises (J Orthop Sports Phys Ther 37(12):754-762; PubMed 18560185)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/18560185/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp pain in the hip, knee or back.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Knee discomfort on the mat: fold the mat under the knees.",
        "Wrist pain: fists or forearms on the mat."
      ],
      "modify": [
        "Smaller lift.",
        "Pause in the hydrant and skip the kick."
      ],
      "regressions": [
        "Fire hydrant.",
        "Side-lying clamshell."
      ],
      "progressions": [
        "Hold the kick 2-3 s.",
        "Band just above the knees."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Gluteus medius lifts the thigh out to the side and holds it there through the kick; quadruped hip abduction drills activate it (Distefano 2009).",
      "glute_max_r": "Upper gluteus maximus helps abduct and hold the leg out (Boren 2011).",
      "quads_r": "Quadriceps straighten the knee for the kick (clinical opinion).",
      "obliques_r": "Obliques stop the trunk leaning away from the lifted leg (clinical opinion).",
      "obliques_l": "Obliques stop the trunk leaning away from the lifted leg (clinical opinion)."
    }
  },
