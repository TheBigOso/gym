  "exercise": {
    "id": "decline-crunch",
    "name": "Decline Crunch",
    "aliases": [
      "Decline bench crunch",
      "Slant board crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "000913",
      "title": "Decline Crunch",
      "url": "https://gymvisual.com/videos/913-decline-crunch.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Decline bench (slant board with ankle roller)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 0.9 s up, a short pause, about 1.2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "tempo": "About 1 s up, brief pause, 1.5 s down",
      "frequency": "2-3 times a week",
      "progression": "Steeper board, slower lowering, then a light plate on the chest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the decline board head-down, feet hooked under the roller, fingertips lightly behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the head and shoulder blades off the board; the low back stays down."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause with the shoulder blades just off the board."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and uncurl back to the board under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest briefly; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Sitting all the way up",
        "fix": "Lift only the shoulder blades; keep the low back on the board."
      },
      {
        "id": "m2",
        "mistake": "Pulling the head with the hands",
        "fix": "Fingertips only, elbows wide."
      },
      {
        "id": "m3",
        "mistake": "Dropping back down",
        "fix": "Lower in about 1.5 s."
      },
      {
        "id": "m4",
        "mistake": "Holding the breath",
        "fix": "Breathe out on the way up."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from the board",
        "setup": "Lying on the 25° decline (shoulder blades on the board)",
        "peak": "≈13° from the board (≈-12° from the floor)",
        "norm": "Shoulder blades just off the board (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈-5° (slight lordosis)",
        "peak": "≈0° (L5-T12 segment)",
        "norm": "Low back stays on the board (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈7° (resting curve)",
        "peak": "≈42° at the top",
        "norm": "Upper back curls (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈44°",
        "peak": "≈42°",
        "norm": "Hips barely move in a crunch (Escamilla 2016)",
        "sources": [
          "escamilla2016"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
