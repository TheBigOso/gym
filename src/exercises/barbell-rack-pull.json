    "breathing": {
      "pattern": "Big breath and brace with the bar on the pins, hold it through the pull, breathe out at lockout; breathe in again and brace before lowering.",
      "cadence": "About 1.6 s up, 0.6 s lockout, 1.8 s down to the pins"
    },
    "prescription": {
      "frequency": "Once a week",
      "rest": "2-4 minutes between sets",
      "sets": "3-5",
      "reps": "3-6",
      "tempo": "Controlled pull, 2 s down to the pins",
      "load": "Barbell load is user-chosen: often 100-110 percent of a floor deadlift for short ranges, as long as the back stays flat.",
      "progression": "Add 2.5-5 kg when every rep locks out with a flat back; lower the pins over a block of weeks."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Pins just below the knees. Feet hip width under the bar, shins close, overhand grip just outside the thighs, hips back, flat back, shoulders over the bar."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Push the floor away and drive the hips forward; the bar slides up the thighs."
      },
      {
        "id": "c3",
        "phase": "lockout",
        "text": "Stand tall with the glutes squeezed; do not lean back or shrug."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Push the hips back and lower the bar down the thighs under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Set the bar quietly on the pins, keep the brace, and reset."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back at lockout",
        "fix": "Finish with the hips under the shoulders; stop when standing tall."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back",
        "fix": "Brace and set the lats before the pull; lighten the bar."
      },
      {
        "id": "m3",
        "mistake": "Bar drifting away from the thighs",
        "fix": "Pull the bar back into the legs with the lats."
      },
      {
        "id": "m4",
        "mistake": "Bouncing off the pins",
        "fix": "Pause on the pins each rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈36° with the bar on the pins",
        "peak": "≈4° at lockout",
        "norm": "Starting just below the knee leaves only a small knee bend; most of the work is hip extension (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈99° (joint channel); bar 45.7 cm high, 4 cm below the knee joints",
        "peak": "≈5° at lockout",
        "norm": "Partial deadlift range; the conventional deadlift loads the hip and back extensors heavily (Escamilla 2002)",
        "sources": [
          "escamilla2002"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈56° from vertical, back flat",
        "peak": "≈5° at lockout",
        "norm": "Flat back throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar path",
        "setup": "Bar on the safety pins (pin top 44.3 cm); grip 54 cm (handle centres)",
        "peak": "Within 3.1 cm fore-aft, at least 0.8 cm off the legs; lockout height 80.4 cm",
        "norm": "Bar close to the thighs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Set up 0.8 s",
        "peak": "1.6 s up, 0.6 s lockout, 1.8 s down, 0.8 s on the pins",
        "norm": "Controlled; pause on the pins (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Set the safety pins to the same height on both sides and check that the bar sits squarely on them.",
        "Heavy rack pulls load the spine; build up gradually and keep the back flat.",
        "Low-back pain: use lighter hip-hinge work first.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Grip: lifting straps for heavy sets.",
        "Higher pins for a shorter range."
      ],
      "regressions": [
        "Dumbbell Romanian deadlift.",
        "Kettlebell deadlift.",
        "Hip hinge with a dowel."
      ],
      "progressions": [
        "Lower pins.",
        "Pause just off the pins.",
        "Full deadlift from the floor."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Drives the hips through to lockout; the top half of the deadlift is mostly hip extension.",
      "glute_max_l": "Drives the hips through to lockout; the top half of the deadlift is mostly hip extension.",
      "spinal_extensors_r": "Hold the back flat against a heavy bar (Escamilla 2002 on deadlift back loading).",
      "spinal_extensors_l": "Hold the back flat against a heavy bar (Escamilla 2002 on deadlift back loading).",
      "hamstrings_r": "Extend the hips with the knees almost straight.",
      "hamstrings_l": "Extend the hips with the knees almost straight.",
      "upper_traps_r": "Hold the shoulders against the heavy bar; no shrug at the top.",
      "upper_traps_l": "Hold the shoulders against the heavy bar; no shrug at the top.",
      "rhomboids_midtrap_r": "Keep the shoulder blades set.",
      "rhomboids_midtrap_l": "Keep the shoulder blades set.",
      "lats_r": "Keep the bar against the thighs.",
      "lats_l": "Keep the bar against the thighs.",
      "forearm_flexors_r": "Grip is often the limit with heavy rack pulls.",
      "forearm_flexors_l": "Grip is often the limit with heavy rack pulls.",
      "quads_r": "Finish the small knee extension off the pins.",
      "quads_l": "Finish the small knee extension off the pins.",
      "adductors_r": "Help extend the hips.",
      "adductors_l": "Help extend the hips.",
      "core": "Brace before the bar leaves the pins.",
      "obliques_r": "Part of the brace.",
      "obliques_l": "Part of the brace."
    },
