        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the shoulder, numbness or tingling occurs.",
        "Check the band for nicks or tears and loop it securely round the upright; a band that slips or snaps can hit the face.",
        "Band tension is user-chosen: pick one you can sweep to a T with straight arms.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: sweep a little lower, at chest height, and stop short of the T.",
        "Cannot keep the arms straight: soften the elbows a little more or use a lighter band."
      ],
      "regressions": [
        "Lighter band or a step closer to the rack.",
        "Band pull-apart.",
        "Partial range, stopping with the hands in line with the shoulders."
      ],
      "progressions": [
        "Stronger band or a step further back.",
        "2 s squeeze at the T.",
        "Bent-over dumbbell reverse fly."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover: horizontal abduction of the straight arm against the band. Prone horizontal abduction reached about 87% MVIC in the posterior deltoid (Reinold 2007); a neutral grip gave more posterior deltoid activity than a pronated grip on a reverse fly (Schoenfeld 2013).",
      "post_deltoid_l": "Prime mover: horizontal abduction of the straight arm against the band. Prone horizontal abduction reached about 87% MVIC in the posterior deltoid (Reinold 2007); a neutral grip gave more posterior deltoid activity than a pronated grip on a reverse fly (Schoenfeld 2013).",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together at the end. In prone retraction exercises the middle trapezius reached up to about 77% of maximal activity with the arms raised (Oyama 2010); the rhomboids could not be measured with surface EMG.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together at the end. In prone retraction exercises the middle trapezius reached up to about 77% of maximal activity with the arms raised (Oyama 2010); the rhomboids could not be measured with surface EMG.",
      "infraspinatus_r": "External rotator that works with the posterior deltoid; higher with a neutral grip (Schoenfeld 2013).",
      "infraspinatus_l": "External rotator that works with the posterior deltoid; higher with a neutral grip (Schoenfeld 2013).",
      "lat_deltoid_r": "Holds the arm up at shoulder height; prone horizontal abduction also gave about 63% MVIC in the middle deltoid (Reinold 2007).",
      "lat_deltoid_l": "Holds the arm up at shoulder height; prone horizontal abduction also gave about 63% MVIC in the middle deltoid (Reinold 2007).",
      "triceps_r": "Keeps the elbow straight.",
      "triceps_l": "Keeps the elbow straight.",
      "forearm_flexors_r": "Grip the band.",
      "forearm_flexors_l": "Grip the band.",
      "upper_traps_r": "Steadies the shoulder blade; shrugging shifts work here.",
      "upper_traps_l": "Steadies the shoulder blade; shrugging shifts work here.",
      "core": "Keeps the ribs down so the low back does not arch."
    }
  },
