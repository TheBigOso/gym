    "id": "band-reverse-fly",
    "name": "Band Reverse Fly",
    "aliases": [
      "Standing band reverse fly",
      "Anchored band reverse fly",
      "Resistance band rear delt fly"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "13781",
      "title": "Band Reverse fly",
      "url": "https://gymvisual.com/videos/13781-band-reverse-fly.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment, so the data sheet was not read)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (posterior deltoid)",
    "secondaryBodyParts": [
      "Upper back (middle trapezius, rhomboids)"
    ],
    "equipment": [
      "Resistance band",
      "Power rack (anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "triceps_r",
        "triceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "upper_traps_r",
        "upper_traps_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the arms sweep out, breathe in as they come back together.",
      "cadence": "About 1 s out, short squeeze, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1-0.5-2-0.5 (out-squeeze-back-pause, seconds)",
      "rest": "45-75 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: light enough to reach the T with straight arms",
      "progression": "More reps, a longer squeeze, a step further from the rack or a stronger band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop the band round a rack upright at shoulder height. Face it, feet hip width, a strand in each hand, palms facing each other, arms straight in front at shoulder height."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and sweep the straight arms out and back, leading with the backs of the hands."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Stop with the arms in a T, in line with the shoulders; squeeze the shoulder blades together, shoulders down, ribs down."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and bring the arms back in front slowly, keeping the band tight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause in front, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the elbows to finish (turning it into a row)",
        "fix": "Keep the arms long; use a lighter band or step closer."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the shoulders down away from the ears."
      },
      {
        "id": "m3",
        "mistake": "Swinging the arms back past the shoulders and arching the back",
        "fix": "Stop at the T, ribs down."
      },
      {
        "id": "m4",
        "mistake": "Letting the band pull the arms forward fast",
        "fix": "Return slowly, about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Horizontal abduction",
        "setup": "Arms ≈91° in front of the frontal plane, wrists 38 cm apart",
        "peak": "Arms ≈-1° from the frontal plane (a T)",
        "norm": "From arms straight in front to a T in line with the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arm height",
        "setup": "≈80° of elevation, hands at shoulder height",
        "peak": "≈86°",
        "norm": "About shoulder height, near 90 degrees of elevation; prone horizontal abduction was tested at about 100 degrees of abduction (Reinold 2007)",
        "sources": [
          "reinold2007"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈5°",
        "peak": "≈6°",
        "norm": "Arms straight, elbows soft (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blades",
        "setup": "Slightly forward (protraction 6°)",
        "peak": "Squeezed together (retraction 14°)",
        "norm": "Retract (squeeze together) at the end; in prone retraction exercises the middle trapezius reached up to about 77% of maximal activity with the arms raised (Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Neutral, palms facing each other",
        "peak": "Palms facing forward at the T",
        "norm": "Neutral (palms facing each other) gave more posterior deltoid activity than a pronated grip on a reverse fly (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Band",
        "setup": "Looped round the upright 133.4 cm high (shoulder height), 117 cm in front of the shoulders; strands 61.2 cm",
        "peak": "Strands 142.6 cm at the T",
        "norm": "Anchored in front, the band pulls the arms forward through the whole arc, and its tension rises as it stretches; at matched effort elastic tubing and dumbbells gave similar activity in shoulder exercises (Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s in front",
        "peak": "1 s out, 0.5 s squeeze, 1.8 s back",
        "norm": "About 1 s apart, 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #13781, Band Reverse fly, video (movement reference)",
