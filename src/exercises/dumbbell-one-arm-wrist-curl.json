  "exercise": {
    "id": "dumbbell-one-arm-wrist-curl",
    "name": "Dumbbell One Arm Wrist Curl",
    "aliases": [
      "Single-arm wrist curl",
      "One-arm seated wrist curl",
      "Unilateral palms-up wrist curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5048",
      "title": "Dumbbell One arm Wrist Curl",
      "url": "https://gymvisual.com/videos/5048-dumbbell-one-arm-wrist-curl.html",
      "listing": "Page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Forearms",
    "secondaryBodyParts": [],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (wrist)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "forearm_flexors_r"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_extensors_r",
        "biceps_r",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the hands curl up, inhale as they lower.",
      "cadence": "About 1 s up, 0.4 s squeeze, 1.7 s down"
    },
    "prescription": {
      "sets": "2-3 per arm",
      "reps": "12-20",
      "load": "Dumbbell load is user-chosen: pick a weight you can control through the full range for every rep with 1-3 reps in reserve (RPE 7-9). Wrist curls need a light dumbbell.",
      "tempo": "1-0-2-0 (up, pause, down, pause)",
      "frequency": "2-3 times a week",
      "progression": "More reps, then a slower lowering, then a heavier dumbbell (small steps)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the end of the bench, feet flat. Rest the right forearm along the thigh, palm up, wrist just past the knee; the left forearm rests on the other thigh."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the hand up toward you, bending only at the wrist."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze at the top; the forearm stays flat on the thigh."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the wrist is bent back."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep a firm grip at the bottom; repeat, then switch arms."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Forearms lifting off the thighs",
        "fix": "Keep the forearms pinned to the thighs; only the hands move."
      },
      {
        "id": "m2",
        "mistake": "Bouncing at the bottom",
        "fix": "Lower slowly and pause before curling."
      },
      {
        "id": "m3",
        "mistake": "Too heavy, short range",
        "fix": "Use a weight you can move through the whole range."
      },
      {
        "id": "m4",
        "mistake": "Rounded, slumped back",
        "fix": "Lean forward from the hips with a long back."
      }
    ],
    "kinematics": [
      {
        "measure": "Wrist flexion/extension",
        "setup": "55° extension",
        "peak": "58° flexion (arc ≈113°)",
        "norm": "Healthy adults used up to about 54 degrees of wrist flexion and 60 degrees of extension in daily tasks, functional range about 40 each way (Ryu 1991); a curl goes a little further, to a comfortable end range without pain (clinical opinion)",
        "sources": [
          "ryu1991"
        ]
      },
      {
        "measure": "Forearm on the thigh",
        "setup": "Elbow at 62% of the thigh, wrist at 122% (just past the knee); elbow ≈48°",
        "peak": "Forearm still (elbow and wrist move 0 cm over the loop)",
        "norm": "Forearms rest along the thighs and stay still; only the hands move, the wrists just past the knees so the hands move freely (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk lean",
        "setup": "≈11° forward from vertical",
        "peak": "Unchanged",
        "norm": "Lean forward from the hips with a long back so the forearms lie flat on the thighs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Free arm",
        "setup": "Left forearm resting in the mirrored position, no dumbbell",
        "peak": "Unchanged (constant channels)",
        "norm": "The other forearm rests on its thigh to keep the trunk square; some lifters press it on the working forearm to pin it (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bottom 0.5 s",
        "peak": "1 s up, 0.4 s squeeze, 1.7 s down, 0.4 s at the bottom",
        "norm": "Slow and controlled, about 1 s up, a short squeeze and 1.5-2 s down (clinical opinion); resistance programmes for the wrist extensors in tendinopathy used 1-4 sets of about 15 reps, with no optimal dose defined (J Hand Ther 2012)",
        "sources": [
          "jht2012"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual Dumbbell One arm Wrist Curl, video page (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/5048-dumbbell-one-arm-wrist-curl.html"
      },
      {
        "id": "ryu1991",
        "title": "Ryu, Cooney, Askew, An and Chao 1991, functional ranges of motion of the wrist joint (J Hand Surg Am 16(3):409-419; 40 adults, biaxial wrist electrogoniometer)",
        "url": "https://mayoclinic.elsevierpure.com/en/publications/functional-ranges-of-motion-of-the-wrist-joint/"
      },
      {
        "id": "szymanski2004",
        "title": "Szymanski, Szymanski, Molloy and Pascoe 2004, effect of 12 weeks of wrist and forearm training on high school baseball players (J Strength Cond Res 18(3):432-440; PubMed 15320673; 43 players)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/15320673/"
      },
      {
        "id": "jht2012",
        "title": "Effectiveness of different methods of resistance exercises in lateral epicondylosis, a systematic review (J Hand Ther 2012;25(1):5-25; PubMed 22075055; 12 studies)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/22075055/"
      }
    ],
    "safety": {
      "cautions": [
        "Wrist pain or carpal tunnel symptoms: shorten the range at the bottom and use a lighter dumbbell (clinical opinion).",
        "Wrist or elbow pain: use a lighter dumbbell and a shorter range; stop if pain persists (clinical opinion).",
        "Keep the forearm on the thigh so the elbow and shoulder stay out of it.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Forearm on a flat bench instead of the thigh (kneeling beside it).",
        "Both arms together once the movement feels steady."
      ],
      "regressions": [
        "Lighter dumbbell, smaller range.",
        "Band wrist curl."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Slower lowering (3 s).",
        "Pause at the top."
      ]
    },
    "muscleNotes": {
      "forearm_flexors_r": "The wrist flexors (flexor carpi radialis and ulnaris, palmaris longus) curl the hand up; the finger flexors hold the handle. Added wrist and forearm work gave greater wrist and forearm strength gains than the same programme without it (Szymanski 2004).",
      "forearm_extensors_r": "Work lightly to steady the wrist at the bottom and control the lowering (clinical opinion).",
      "biceps_r": "Holds the elbow bent at about a right angle while the forearm rests on the thigh (clinical opinion).",
      "core": "Holds the forward lean with a long back."
    }
  },
