  "exercise": {
    "id": "reverse-crunch",
    "name": "Reverse Crunch",
    "aliases": [
      "Reverse curl-up",
      "Lying hip curl",
      "Pelvic curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "087212",
      "title": "Reverse Crunch",
      "url": "https://gymvisual.com/videos/914-reverse-crunch.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (posterior pelvic tilt and lumbar flexion, hips flexed)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl the hips up, inhale as you lower slowly.",
      "cadence": "About 1.2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-15",
      "tempo": "About 1 s up, brief pause, 2 s down; no swinging",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering, then on a decline bench, then hanging knee raises"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms by your sides palms down, hips and knees bent about 90 degrees (shins level)."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the hips off the mat, bringing the knees toward the chest. Lift with the abs, not a leg swing."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause briefly with the tailbone off the mat; shoulders and head stay down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and roll the pelvis down slowly, one vertebra at a time, back to 90/90."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the knee angle fixed; repeat without dropping the legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the legs for momentum",
        "fix": "Slow down; curl the pelvis up and lower for about 2 s."
      },
      {
        "id": "m2",
        "mistake": "Pushing hard through the hands",
        "fix": "Hands rest lightly for balance; the abs lift the hips."
      },
      {
        "id": "m3",
        "mistake": "Opening the knees on the way down (legs drop toward the floor)",
        "fix": "Keep the knees bent about 90 degrees and stop when the thighs are vertical."
      },
      {
        "id": "m4",
        "mistake": "Rolling up onto the neck",
        "fix": "Lift only the pelvis and low back; the shoulder blades stay on the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Pelvis roll (posterior tilt)",
        "setup": "Pelvis resting",
        "peak": "≈38° posterior tilt",
        "norm": "Pelvis curls up until the tailbone and low back peel off the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈2° (L5 and T12 segments, slight lordosis)",
        "peak": "≈40° (+38°)",
        "norm": "Low back curls; no study reports the angle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈89° (thighs ≈90° from the floor)",
        "peak": "≈99° (thighs ≈138°, knees toward the chest)",
        "norm": "Thighs vertical at the start (hips about 90 degrees), knees drawn toward the chest at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈90°",
        "peak": "≈96°",
        "norm": "About 90 degrees, held (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip lift",
        "setup": "Buttocks on the mat (0.5 cm)",
        "peak": "Buttocks 8.1 cm off the mat; T6 and shoulders fixed (0 cm)",
        "norm": "Pelvis rises a few centimetres off the mat; the upper back stays down (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "90/90 hold 0.8 s",
        "peak": "1.2 s up, 0.5 s pause, 2.1 s down, 1.4 s reset",
        "norm": "About 1 s up, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
