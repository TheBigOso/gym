    "id": "lying-rear-lateral-raise",
    "name": "Lying Rear Lateral Raise",
    "aliases": [
      "Chest-supported rear delt raise",
      "Incline prone rear lateral raise",
      "Prone dumbbell reverse fly"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14677",
      "title": "Lying Rear Lateral Raise",
      "url": "https://gymvisual.com/videos/14677-lying-rear-lateral-raise.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the network proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (posterior deltoid)",
    "secondaryBodyParts": [
      "Upper back (rhomboids, mid trapezius)"
    ],
    "equipment": [
      "Dumbbell (pair)",
      "Adjustable bench (incline, chest-supported)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder horizontal abduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise the arms, breathe in as you lower; keep the trunk braced.",
      "cadence": "About 1.5 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0.5-1.5-0 (down-squeeze-up-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbells; light, so the back stays flat",
      "progression": "Add reps, then weight; chest-supported rear fly on an incline bench"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the bench to about 40 degrees. Lie chest-down, chin over the top, balls of the feet on the floor; dumbbells hang under the shoulders, palms facing."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and sweep the arms out to the sides with soft elbows, leading with the back of the hands."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the shoulder blades together with the arms about level with the back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to the hang."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Let the arms settle without dropping the shoulders; chest stays on the pad."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the chest off the pad to swing the weights up",
        "fix": "Keep the chest on the pad; use a lighter pair."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbows into a row",
        "fix": "Fix a slight elbow bend and keep it."
      },
      {
        "id": "m3",
        "mistake": "Shrugging toward the ears",
        "fix": "Shoulders down and back; lead with the elbows out to the sides."
      },
      {
        "id": "m4",
        "mistake": "Dropping the weights on the way down",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "40° back pad, chest on the pad; trunk ≈37° above horizontal",
        "peak": "Unchanged (the chest stays on the pad)",
        "norm": "Low incline (about 30-45 degrees) keeps the trunk supported and the arms free (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Horizontal abduction",
        "setup": "Arms hanging (upper arm ≈8° from vertical)",
        "peak": "Upper arm ≈97° from the trunk line, out to the side about level with the back",
        "norm": "From arms hanging to about level with the back; prone horizontal abduction tested at about 100 degrees of abduction (Reinold 2007)",
        "sources": [
          "reinold2007"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈18°",
        "norm": "Slight, fixed bend (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral, palms facing each other",
        "peak": "Palms down, thumbs toward the head",
        "norm": "Neutral (palms facing each other) gave more posterior deltoid and infraspinatus activity than pronated (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.8 s",
        "peak": "1.5 s up, 0.5 s squeeze, 2.0 s down",
        "norm": "Controlled, no swing (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #14677, Lying Rear Lateral Raise, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/14677-lying-rear-lateral-raise.html"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "reinold2007",
        "title": "Reinold et al. 2007, electromyographic analysis of the supraspinatus and deltoid muscles during 3 common rehabilitation exercises (J Athl Train 42(4):464-469)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2140071/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Shoulder pain or impingement: keep the weight light and stop below shoulder height.",
        "Mount and dismount the bench with the dumbbells on the floor beside it."
      ],
      "modify": [
        "Lighter dumbbells or a shorter range.",
        "Steeper pad if the dumbbells touch the floor."
      ],
      "regressions": [
        "No weight (arms only).",
        "Band pull-apart."
      ],
      "progressions": [
        "Slower lowering with a 1 s squeeze.",
        "Bent-over rear delt fly (no chest support)."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover (horizontal abduction). A neutral grip gave more posterior deltoid activity than a pronated grip on a reverse fly (Schoenfeld 2013); prone horizontal abduction reached about 87% MVIC in the posterior deltoid (Reinold 2007).",
      "post_deltoid_l": "Prime mover (horizontal abduction). A neutral grip gave more posterior deltoid activity than a pronated grip on a reverse fly (Schoenfeld 2013); prone horizontal abduction reached about 87% MVIC in the posterior deltoid (Reinold 2007).",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together at the top.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together at the top.",
      "infraspinatus_r": "External rotator that works with the posterior deltoid; higher with a neutral grip (Schoenfeld 2013).",
      "infraspinatus_l": "External rotator that works with the posterior deltoid; higher with a neutral grip (Schoenfeld 2013).",
      "lat_deltoid_r": "Helps lift the arm; prone horizontal abduction also gave about 63% MVIC in the middle deltoid (Reinold 2007).",
      "lat_deltoid_l": "Helps lift the arm; prone horizontal abduction also gave about 63% MVIC in the middle deltoid (Reinold 2007).",
      "spinal_extensors_r": "Light work: the chest pad carries the trunk, so the back extensors only keep it steady (clinical opinion).",
      "spinal_extensors_l": "Light work: the chest pad carries the trunk, so the back extensors only keep it steady (clinical opinion).",
      "core": "Light bracing on the pad (clinical opinion)."
    }
  },
