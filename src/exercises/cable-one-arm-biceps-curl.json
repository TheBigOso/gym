    "name": "Cable One Arm Biceps Curl",
    "aliases": [
      "Single-arm cable curl",
      "One-arm cable curl",
      "Cable single arm biceps curl",
      "D-handle cable curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14790",
      "title": "Cable One Arm Biceps Curl (version 2)",
      "url": "https://gymvisual.com/videos/14790-cable-one-arm-biceps-curl-version-2.html",
      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read; the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper Arms",
    "secondaryBodyParts": [
      "Forearms"
    ],
    "equipment": [
      "Cable machine",
      "D-handle attachment"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "biceps_r"
      ],
      "synergist": [
        "forearm_flexors_r"
      ],
      "stabilizer": [
        "ant_deltoid_r",
        "forearm_extensors_r",
        "core",
        "obliques_l"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe out as you curl the handle up, breathe in as you lower it.",
      "cadence": "About 1 s up, short squeeze, 2-3 s down"
    },
    "prescription": {
      "sets": "2-4 per arm",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.3-2.4-0.5 (up-squeeze-down-pause, seconds)",
      "rest": "60-90 s (or work the other arm in between)",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can curl with the elbow still at your side for every rep.",
      "progression": "Add reps, then one plate on the stack; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Face the low pulley, feet hip width, knees soft; hold the D-handle in the right hand, palm forward, arm straight and the elbow at your side. Left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the handle toward the shoulder, moving only at the elbow."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the biceps with the palm facing up and back; the elbow stays by your ribs."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the arm is straight again, keeping tension on the cable."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the arm straight, trunk still, then repeat. Switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbow drifting forward as the hand rises",
        "fix": "Keep the elbow pinned to your side; stop the curl when the forearm can go no higher without the elbow moving."
      },
      {
        "id": "m2",
        "mistake": "Leaning back or twisting to swing the handle up",
        "fix": "Stand tall with the hips square to the pulley; lighten the stack."
      },
      {
        "id": "m3",
        "mistake": "Letting the handle snap back down",
        "fix": "Lower over 2-3 s to a straight arm, keeping the cable taut."
      },
      {
        "id": "m4",
        "mistake": "Bending the wrist to finish the curl",
        "fix": "Keep the wrist straight in line with the forearm."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (arm nearly straight)",
        "peak": "≈134° at the top (range ≈128°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Upper arm",
        "setup": "≈1° forward of vertical, elbow at the side",
        "peak": "Unchanged (elbow moves 0.00 cm over the loop)",
        "norm": "Elbow stays near the side; a big forward swing shifts work to the front deltoid (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm rotation",
        "setup": "Palm forward (wrist pron 2.4°)",
        "peak": "Palm up / toward the shoulder (pron -3.9°)",
        "norm": "The supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Cable",
        "setup": "Low pulley 52 cm in front of the hand, 14 cm high, in line with the hand",
        "peak": "Clear of the body by at least 5.37 cm over the loop",
        "norm": "Low pulley in front of the athlete, cable in line with the working hand (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arm straight 0.5 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable One Arm Biceps Curl (version 2), video (movement reference)",
        "url": "https://gymvisual.com/videos/14790-cable-one-arm-biceps-curl-version-2.html"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "parpa2025",
        "title": "Parpa, Vasiliou, Michaelides, Govindasamy, Chernov and Intziegianni 2025, biceps brachii EMG during traditional dumbbell versus Bayesian cable curls, with a review of curl EMG studies (Muscles 4:45)",
        "url": "https://knowledge.lancashire.ac.uk/id/eprint/57119/1/57119%20Parpa%20et%20al.%20VOR.pdf"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain in the elbow or shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can control for every rep with the elbow still.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Elbow pain at the bottom: stop a little short of a fully straight arm (clinical opinion).",
        "Wrist discomfort: use a neutral (hammer) grip on a rope end instead of the D-handle."
      ],
      "regressions": [
        "Lighter load.",
        "Two-arm cable curl with a straight bar.",
        "Band curl."
      ],
      "progressions": [
        "Slower 3 s lowering.",
        "Bayesian cable curl (facing away from the pulley, arm behind the body; compared with dumbbell curls by Parpa 2025).",
        "Heavier load for 6-10 reps."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Prime mover: bends the elbow and turns the palm up against the cable. The cable keeps some tension at the bottom, where a dumbbell's load is small.",
      "forearm_flexors_r": "Grip the handle and help bend the elbow (brachioradialis share rises with a neutral grip, Coratella 2023).",
      "ant_deltoid_r": "Holds the upper arm still so the elbow does not swing forward.",
      "forearm_extensors_r": "Hold the wrist straight.",
      "core": "Keeps the trunk upright against the one-sided pull.",
      "obliques_l": "Resist the cable's pull rotating and bending the trunk toward the working side."
    }
  },
