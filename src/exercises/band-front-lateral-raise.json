  "exercise": {
    "id": "band-front-lateral-raise",
    "name": "Band Front Lateral Raise",
    "aliases": [
      "Band diagonal raise",
      "Band anterolateral raise",
      "Band raise between front and side"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9226",
      "title": "Band front lateral raise",
      "url": "https://gymvisual.com/videos/9226-band-front-lateral-raise.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (the proxy refused gymvisual.com), so the movement follows the name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (anterior and lateral deltoid)",
    "secondaryBodyParts": [
      "Upper back (trapezius, serratus anterior)"
    ],
    "equipment": [
      "Resistance band"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Multiplanar",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "pec_r",
        "pec_l",
        "serratus_r",
        "serratus_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "core",
        "forearm_extensors_r",
        "forearm_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 0-3 reps short of failure (RIR 0-3)",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen; the band is hardest at the top, where it is stretched most",
      "progression": "More reps, a slower lowering, a stronger band, or the feet wider on the band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the middle of the band, feet hip width, knees soft; hold an end in each hand in front of the thighs, thumbs forward, elbows soft."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the arms forward and out on the diagonal, halfway between a front and a side raise, thumbs up."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at shoulder height; shoulders down, no leaning back. The band is tightest here."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause in front of the thighs, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back and swinging the arms up",
        "fix": "Brace the trunk and use a lighter band."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders toward the ears",
        "fix": "Keep the shoulders down; stop at shoulder height."
      },
      {
        "id": "m3",
        "mistake": "Drifting into a straight front raise or a side raise",
        "fix": "Keep the hands on the diagonal, about halfway between the two."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the arms down",
        "fix": "Control the lowering, about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder elevation",
        "setup": "≈12° (hands in front of the thighs)",
        "peak": "≈86° (hands at shoulder height)",
        "norm": "Up to about 90 degrees, shoulder height (the range tested by Coratella 2020)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈58° in front of the frontal plane",
        "peak": "≈61°",
        "norm": "Diagonal, between the front raise (about 80-90 degrees in front of the frontal plane) and the scapular-plane lateral raise (about 30-40 degrees, Tsuruike 2019); the frontal raise loads the anterior deltoid most, the lateral raise the medial deltoid (Coratella 2020)",
        "sources": [
          "coratella2020",
          "tsuruike2019"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12°",
        "peak": "≈11°",
        "norm": "Slight, constant bend (Coratella 2020)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Band",
        "setup": "One band per hand, under the ball of each foot; strand 79.6 cm at the bottom",
        "peak": "Strand 144.6 cm at the top (most stretch, most tension)",
        "norm": "Elastic tension rises as the band stretches, so the load is highest where the band is longest; at matched effort, elastic tubing and dumbbells gave similar muscle activity in upper-body exercises (Andersen 2010); with the band under the feet the load is highest at shoulder height",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the thighs",
        "peak": "1.8 s up, 0.4 s at the top, 2.0 s down",
        "norm": "About 2 s up, 0.5 s pause, 2 s down (Coratella 2020 used this tempo with dumbbells)",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #9226, Band front lateral raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/9226-band-front-lateral-raise.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7706677/"
      },
      {
        "id": "tsuruike2019",
        "title": "Tsuruike & Ellenbecker 2019, scapular muscle electromyographic activity during abduction exercises in the scapular plane in three positions (Int J Sports Phys Ther 14(6):935-944)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6878867/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "Check the band for nicks or tears and stand firmly on its middle so it cannot slip out from under the feet.",
        "Band tension is user-chosen: pick one you can control through the whole range.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder pinch near the top: stop a little below shoulder height.",
        "Too hard at the top: step on the band with one foot, or hold the band further down."
      ],
      "regressions": [
        "Lighter band.",
        "One arm at a time."
      ],
      "progressions": [
        "Stronger band or feet wider on the band.",
        "Slower 3-4 s lowering.",
        "Dumbbell raise on the same diagonal."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Prime mover with the arm forward of the side; the frontal raise gave the highest anterior deltoid activity among the raises tested (Coratella 2020).",
      "ant_deltoid_l": "Prime mover with the arm forward of the side; the frontal raise gave the highest anterior deltoid activity among the raises tested (Coratella 2020).",
      "lat_deltoid_r": "Prime mover with the arm out to the side; the lateral raise gave the highest medial deltoid activity (Campos 2020). On the diagonal both heads share the work (clinical opinion).",
      "lat_deltoid_l": "Prime mover with the arm out to the side; the lateral raise gave the highest medial deltoid activity (Campos 2020). On the diagonal both heads share the work (clinical opinion).",
      "pec_r": "The clavicular head helps raise the arm forward (Coratella 2020).",
      "pec_l": "The clavicular head helps raise the arm forward (Coratella 2020).",
      "serratus_r": "Turns the shoulder blade up as the arm rises.",
      "serratus_l": "Turns the shoulder blade up as the arm rises.",
      "upper_traps_r": "Supports the shoulder blade; shrugging shifts work here.",
      "upper_traps_l": "Supports the shoulder blade; shrugging shifts work here.",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred.",
      "core": "Keeps the trunk still so the arms are not swung up.",
      "forearm_extensors_r": "Hold the wrists straight against the band.",
      "forearm_extensors_l": "Hold the wrists straight against the band."
    }
