    "breathing": {
      "pattern": "Brace in the hinge, breathe out as the bar comes up, in as it lowers.",
      "cadence": "About 1.1 s up, 0.4 s squeeze, 2 s down"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "60-90 s between arms",
      "sets": "3",
      "reps": "8-12 per arm",
      "tempo": "1 s up, short squeeze, 2 s down",
      "load": "Barbell load is user-chosen: the long bar must stay level in the hand, so start with an empty or light bar.",
      "progression": "Add 1.25-2.5 kg per side once the bar stays level and the trunk still for every rep."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet a little wider than the hips, knees soft, hinge forward with a flat back; left hand braced on the left thigh above the knee. Grip the bar in the middle with the right hand, palm facing in, bar pointing front to back beside the right leg."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Drive the right elbow up and back past the ribs, keeping the bar level."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the shoulder blade back for a moment; the trunk does not twist."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly to a straight arm, plates clear of the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hinge and the brace; do all reps, then switch arms."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bar tipping front or back",
        "fix": "Grip exactly at the middle (the balance point) and squeeze hard; lighter plates help."
      },
      {
        "id": "m2",
        "mistake": "Twisting the trunk to lift",
        "fix": "Keep the shoulders and hips square to the floor; lighter load."
      },
      {
        "id": "m3",
        "mistake": "Elbow flaring out",
        "fix": "Drive the elbow back toward the hip."
      },
      {
        "id": "m4",
        "mistake": "Rounding the back",
        "fix": "Press the free hand into the thigh and keep the chest proud."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk angle",
        "setup": "≈32° above level (hip channel ≈94°), spine neutral",
        "peak": "Unchanged (no twist)",
        "norm": "Hinged trunk held still; rows load the low back and trunk muscles (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈24°",
        "peak": "Unchanged",
        "norm": "Soft knees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈9°",
        "peak": "≈93°, elbow -0.8 cm above the shoulder joint, shoulder blade retracted (clavicle 8° to -16°)",
        "norm": "About 80-100 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar balance",
        "setup": "Held at its middle, neutral grip, bar fore-aft beside the right leg, plates 17.4 cm off the floor",
        "peak": "Bar within 5.6° of level through the rep",
        "norm": "Held at its middle, bar level; one-sided loading asks more of the trunk to resist rotation (Saeterbakken 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s",
        "peak": "1.1 s up, 0.4 s squeeze, 2 s down, 1.2 s reset",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Clear space in front of and behind you for the long bar.",
        "Start with an empty or lightly loaded bar; a tipping bar strains the wrist.",
        "Low-back pain: use a bench-supported dumbbell row instead.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Grip: shorter bar or a landmine handle.",
        "Lower back: one-arm dumbbell row on a bench."
      ],
      "regressions": [
        "One-arm dumbbell row on a bench.",
        "Seated one-arm cable row."
      ],
      "progressions": [
        "Pause at the top.",
        "Slower lowering.",
        "More plates once the bar stays level."
      ]
    },
    "muscleNotes": {
      "lats_r": "Pull the elbow back past the trunk.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blade back at the top.",
      "biceps_r": "Bend the elbow; the neutral grip shares the work with brachialis.",
      "post_deltoid_r": "Extends the shoulder behind the trunk.",
      "forearm_flexors_r": "Hold the bar.",
      "forearm_extensors_r": "With the flexors, stop the long bar tipping in the hand.",
      "spinal_extensors_r": "Hold the hinged back flat (Fenwick 2009).",
      "spinal_extensors_l": "Hold the hinged back flat (Fenwick 2009).",
      "obliques_r": "Resist the trunk twisting toward the bar (Saeterbakken 2012).",
      "obliques_l": "Resist the trunk twisting toward the bar (Saeterbakken 2012).",
      "hamstrings_r": "Hold the hips in the hinge.",
      "hamstrings_l": "Hold the hips in the hinge.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Bracing keeps the trunk still."
    },
