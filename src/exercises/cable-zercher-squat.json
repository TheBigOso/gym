      },
      {
        "id": "zawadka2020",
        "title": "Zawadka et al. 2020, How are squat timing and kinematics in the sagittal plane related to squat depth? (J Sports Sci Med 19:500-507)",
        "url": "https://www.jssm.org/jssm-19-500.xml-Fulltext"
      },
      {
        "id": "straub2024",
        "title": "Straub and Powers 2024, a biomechanical review of the squat exercise: implications for clinical practice (Int J Sports Phys Ther)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10987311/"
      },
      {
        "id": "frontsquat2009",
        "title": "Gullett, Tillman, Gutierrez & Chow 2009, a biomechanical comparison of back and front squats in healthy trained individuals (J Strength Cond Res 23(1):284-292; PubMed 19002072)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19002072/"
      }
    ],
    "safety": {
      "cautions": [
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "The bar presses into the elbow crooks: use a pad or a towel, and stop if the elbows hurt.",
        "Knee pain: squat to a comfortable depth.",
        "Low-back pain: keep the chest up; a front load that drags you forward means the weight is too heavy.",
        "Step back from the pulley carefully and return the bar under control."
      ],
      "modify": [
        "Shallower squat (to a box).",
        "Goblet squat with a dumbbell."
      ],
      "regressions": [
        "Bodyweight squat.",
        "Dumbbell goblet squat."
      ],
      "progressions": [
        "Pause at the bottom.",
        "More weight.",
        "Barbell Zercher squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Main knee extensors through the squat (clinical opinion); front-loaded squats keep the trunk more upright with similar leg demand (Gullett 2009, front squat).",
      "quads_l": "Main knee extensors through the squat (clinical opinion); front-loaded squats keep the trunk more upright with similar leg demand (Gullett 2009, front squat).",
      "glute_max_r": "Extends the hips out of the bottom (clinical opinion).",
      "glute_max_l": "Extends the hips out of the bottom (clinical opinion).",
      "adductors_r": "Help extend the hips from the deep, wide position (clinical opinion).",
      "adductors_l": "Help extend the hips from the deep, wide position (clinical opinion).",
      "hamstrings_r": "Assist hip extension and steady the knee (clinical opinion).",
      "hamstrings_l": "Assist hip extension and steady the knee (clinical opinion).",
      "spinal_extensors_r": "Hold the back flat against the forward pull of the bar (clinical opinion).",
      "spinal_extensors_l": "Hold the back flat against the forward pull of the bar (clinical opinion).",
      "core": "Brace the trunk under the front load (clinical opinion).",
      "biceps_r": "Hold the elbows bent around the bar (clinical opinion).",
      "biceps_l": "Hold the elbows bent around the bar (clinical opinion).",
      "upper_traps_r": "Hold the shoulders up under the load (clinical opinion).",
      "upper_traps_l": "Hold the shoulders up under the load (clinical opinion).",
      "rhomboids_midtrap_r": "Keep the upper back from rounding (clinical opinion).",
      "rhomboids_midtrap_l": "Keep the upper back from rounding (clinical opinion).",
      "calves_r": "Steady the ankles (clinical opinion).",
      "calves_l": "Steady the ankles (clinical opinion).",
      "ant_deltoid_r": "Holds the upper arms forward (clinical opinion).",
      "ant_deltoid_l": "Holds the upper arms forward (clinical opinion)."
    }
