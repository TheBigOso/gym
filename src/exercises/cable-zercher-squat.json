      "Biceps (holding)"
    ],
    "equipment": [
      "Cable"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (squat with a front-loaded Zercher hold)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
