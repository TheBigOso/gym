        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace before you lower; breathe out through the sticking point on the way up.",
      "cadence": "About 2 s down, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-12",
      "tempo": "2-0-1 (about 2 s down, about 1 s up)",
      "load": "User-chosen cable weight; the elbows and upper back limit the load before the legs do",
      "frequency": "1-2 times a week",
      "progression": "More reps, then more weight; a pad on the bar if the elbow crooks get sore"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Cradle the cable bar in the crooks of the elbows, hands clasped in front of the chest; step back from the low pulley, feet about shoulder width, toes out."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Sit down between the heels, chest tall, elbows forward; knees track over the toes."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs at or a little below parallel; elbows just inside the knees; back flat."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive up through the whole foot, keeping the chest up and the bar tight to the body."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, re-brace."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the upper back as the bar pulls forward",
        "fix": "Chest proud, elbows up a little; lighter weight."
      },
      {
        "id": "m2",
        "mistake": "Heels lifting",
        "fix": "Sit back between the heels; weight over the mid-foot."
      },
      {
        "id": "m3",
        "mistake": "Knees caving in",
        "fix": "Push the knees out over the toes."
      },
      {
        "id": "m4",
        "mistake": "Bar sliding down the forearms",
        "fix": "Keep the elbows bent hard and the hands clasped high."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "40 cm (≈1.0x the rig's 40 cm shoulder width), toes out 18°",
        "peak": "Unchanged",
        "norm": "About shoulder width, toes out about 15-20 degrees (common coaching; Zawadka 2020 used shoulder width)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈4°",
        "peak": "≈113°",
        "norm": "About 100-120 degrees with the thighs at parallel or a bit below (clinical opinion); depth is driven mostly by knee range (Zawadka 2020)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈2°",
        "peak": "≈111° (joint channel, as in the HUD)",
        "norm": "Not specified by the sources for this depth",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈19° forward",
        "norm": "More upright than a back squat because the load is in front (clinical opinion); more lean moves demand from knee to hip (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Zercher hold",
        "setup": "Bar in the elbow crooks, elbows bent ≈110°, hands clasped 2 cm from shoulder height",
        "peak": "Unchanged; bar ≥3.48 cm off the trunk and thighs, cable ≥4.48 cm off the legs",
        "norm": "Bar in the elbow crooks, elbows bent, hands clasped in front of the chest (common coaching; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "About 2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #21628, Cable Zercher Squat (male), video (movement reference)",
