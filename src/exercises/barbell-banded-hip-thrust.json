        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "glute_med_r",
        "glute_med_l",
        "hamstrings_r",
        "hamstrings_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
