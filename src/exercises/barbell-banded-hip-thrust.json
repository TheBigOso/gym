    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a bar pad and collars; roll the bar into place sitting on the floor.",
        "Stop if the low back takes over."
      ],
      "modify": [
        "Lighter bar, or dumbbell hip thrust."
      ],
      "regressions": [
        "Hip thrust without load.",
        "Glute bridge."
      ],
      "progressions": [
        "Heavier bar.",
        "Pause at the top."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "The barbell hip thrust excites the gluteus maximus more than the back squat (Contreras 2015).",
      "glute_max_l": "The barbell hip thrust excites the gluteus maximus more than the back squat (Contreras 2015).",
      "glute_med_r": "Pushes the knees out against the band (Macadam 2015).",
