        "forearm_flexors_l"
      ],
      "lengthened": [
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Brace and exhale on the way up, inhale on the way down.",
      "cadence": "About 1.2 s up, 0.8 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "1-1-2-0",
      "frequency": "2-3 times a week",
      "rest": "90-120 s",
      "progression": "Add load to the bar; stronger band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Shoulder blades on the bench edge, band above the knees, bar across the hip crease, feet flat about hip width."
      },
      {
        "id": "c2",
        "phase": "up",
        "text": "Drive through the heels and push the knees out; hips up until the trunk is level."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the glutes, chin tucked, ribs down."
      },
      {
        "id": "c4",
        "phase": "down",
        "text": "Lower the hips with control, knees still pressing out."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch the hips down lightly; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Knees caving in",
        "fix": "Keep pushing the knees out into the band."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back at the top",
        "fix": "Stop at a level trunk; ribs down, chin tucked."
      },
      {
        "id": "m3",
        "mistake": "Feet too far out or too close",
        "fix": "Shins vertical at the top."
      },
      {
        "id": "m4",
        "mistake": "Bar rolling toward the stomach",
        "fix": "Hold it on the hip crease; use a pad."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench height",
        "setup": "42 cm",
        "peak": "Upper back pivots on the bench edge",
        "norm": "About 40-45 cm, edge under the shoulder blades (standard setup)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈99° at the bottom",
        "peak": "≈-4°",
        "norm": "From about 70-90 degrees to neutral (Contreras 2015)",
        "sources": [
          "contreras2015"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈107° at the bottom",
        "peak": "≈90° (shins vertical), feet 26 cm apart",
        "norm": "About 90 degrees at the top, shins vertical (standard setup)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈57° (hips below the shoulders)",
        "peak": "≈2° (level)",
        "norm": "Level at the top (standard technique)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Above both knees (30 cm apart)",
        "peak": "Stretched to 35 cm",
        "norm": "Mini loop above the knees; knees pushed out (Macadam 2015)",
        "sources": [
          "macadam2015"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hips down 0.8 s",
        "peak": "1.2 s up, 0.8 s squeeze, 2.0 s down, 1.2 s reset",
        "norm": "Controlled, squeeze at the top (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #22730, Barbell Banded Hip Thrust, video (movement reference)",
