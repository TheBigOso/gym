    "breathing": {
      "pattern": "Big breath in and brace at the top, hold it on the way down and through the bottom, breathe out as you pass the hardest part of the rise or at the top.",
      "cadence": "About 2 s down, a short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "5-10",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Barbell load is user-chosen: pick a weight you can squat to full depth with the form shown, leaving about 2-3 reps in reserve (RPE 7-8).",
      "rest": "2-3 minutes between sets",
      "progression": "Add 2.5-5 kg when every rep of every set reaches full depth with good form."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar on the upper traps just below the bony bump at the base of the neck, hands just outside the shoulders. Feet a little in front of the bar, a little wider than the hips, toes turned out; unhook the bar by turning it off the pegs."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Big breath, brace, then sit down and slightly back: the rails carry the bar straight down, so let the hips travel back while the chest stays tall."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs at or a little below parallel, heels flat, back flat; no bounce at the bottom."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Push the floor away and drive the bar straight up the rails, knees pushing out over the toes. Breathe out as you pass the hardest part."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall with straight hips and knees, take a new breath and brace. After the last rep, turn the bar back onto the pegs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Feet directly under the bar, so the knees shoot far forward and the heels lift",
        "fix": "Set the feet a little in front of the bar so the shins stay closer to vertical and the heels stay down."
      },
      {
        "id": "m2",
        "mistake": "Feet too far forward, leaning back against the bar",
        "fix": "Bring the feet back until the trunk stays nearly upright and the weight is over mid-foot at the bottom."
      },
      {
        "id": "m3",
        "mistake": "Knees caving in on the way up",
        "fix": "Push the knees out over the toes; use a lighter load."
      },
      {
        "id": "m4",
        "mistake": "Bar on the neck",
        "fix": "Squeeze the shoulder blades together and set the bar on the muscle of the upper traps."
      },
      {
        "id": "m5",
        "mistake": "Rounding the lower back at the bottom",
        "fix": "Stop just above the depth where the pelvis tucks under, and brace harder before each rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Foot position",
        "setup": "Mid-foot 28.1 cm in front of the bar line",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet slightly in front of the bar line so the knees and hips share the work; a fixed vertical bar path lets the trunk stay more upright than in a free squat (common coaching; Schwanbeck 2009 compared Smith and free squats)",
        "sources": [
          "schwanbeck2009"
        ]
      },
      {
        "measure": "Stance width (ankle centres)",
        "setup": "44 cm between the ankle centres, toes out 25°",
        "peak": "Unchanged (feet planted)",
        "norm": "About hip to shoulder width with the toes out about 20-30 degrees (Lorenzetti 2018; Sinclair 2022); wider stances moved demand toward the hip (Paoli 2009)",
        "sources": [
          "lorenzetti2018",
          "paoli2009"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈4°",
        "peak": "≈112°; hip joints 15.5 cm below the knee joints",
        "norm": "A full squat takes the hip crease below the top of the knee, about 115-130 degrees of knee flexion (clinical opinion; Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈22° forward of vertical",
        "norm": "More upright than a free back squat because the rails take over balance (common coaching)",
        "sources": []
      },
      {
        "measure": "Bar path",
        "setup": "Vertical rails at x -9.1 cm; bar centre 137.9 cm high standing",
        "peak": "82.1 cm at the bottom (55.8 cm of travel); bar seat on the traps within 0.1 cm of the rail line",
        "norm": "Fixed by the rails (vertical on this machine)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
