    "safety": {
      "cautions": [
        "Set the safety stops just below the bottom position before the first rep; the bar cannot go lower than them.",
        "Practise hooking the bar back on the pegs (a small turn of the wrists) with an empty bar first.",
        "The fixed bar path does not adapt to you: place the feet so the movement feels natural for the knees and back, and do not force depth.",
        "Keep the bar on the muscle of the upper back, never on the bones of the neck.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee or hip pain: squat to a pain-free depth, with the safety stops set there.",
        "Limited ankle mobility: feet a little further forward, or a slightly wider stance."
      ],
      "regressions": [
        "Bodyweight squat.",
        "Goblet squat with a dumbbell.",
        "Box squat."
      ],
      "progressions": [
        "Heavier load in small steps.",
        "Pause squat (2 s at the bottom).",
        "Free barbell back squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Knee extensors control the descent and drive the rise, working hardest near the bottom (Straub 2024). Free squats showed somewhat higher quadriceps activity than Smith squats at the same relative load (Schwanbeck 2009).",
      "quads_l": "Knee extensors control the descent and drive the rise, working hardest near the bottom (Straub 2024). Free squats showed somewhat higher quadriceps activity than Smith squats at the same relative load (Schwanbeck 2009).",
      "glute_max_r": "Main hip extensor, working hardest out of the bottom of a full squat (clinical opinion; Straub 2024).",
      "glute_max_l": "Main hip extensor, working hardest out of the bottom of a full squat (clinical opinion; Straub 2024).",
      "adductors_r": "Adductor magnus helps extend the hip from deep flexion; wider stances raised adductor activity (Paoli 2009).",
      "adductors_l": "Adductor magnus helps extend the hip from deep flexion; wider stances raised adductor activity (Paoli 2009).",
      "hamstrings_r": "Assist hip extension; their length changes little in a squat, so activity stays moderate (Contreras 2015).",
      "hamstrings_l": "Assist hip extension; their length changes little in a squat, so activity stays moderate (Contreras 2015).",
      "spinal_extensors_r": "Hold the back flat; the more upright trunk on the Smith machine asks a little less of them than a free squat.",
      "spinal_extensors_l": "Hold the back flat; the more upright trunk on the Smith machine asks a little less of them than a free squat.",
      "calves_r": "Control the forward travel of the knees over the planted feet. Free squats showed higher calf activity than Smith squats (Schwanbeck 2009).",
      "calves_l": "Control the forward travel of the knees over the planted feet. Free squats showed higher calf activity than Smith squats (Schwanbeck 2009).",
      "core": "Bracing (breath held against a tight midsection) stiffens the trunk under the bar.",
      "obliques_r": "Part of the brace around the trunk.",
      "obliques_l": "Part of the brace around the trunk.",
      "glute_med_r": "Keeps the knee tracking over the foot and the pelvis level.",
      "glute_med_l": "Keeps the knee tracking over the foot and the pelvis level.",
      "upper_traps_r": "The muscle shelf the bar rests on.",
      "upper_traps_l": "The muscle shelf the bar rests on.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together so the upper traps form the shelf.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together so the upper traps form the shelf.",
      "lats_r": "Pull the bar down into the back and help keep the upper back tight.",
      "lats_l": "Pull the bar down into the back and help keep the upper back tight.",
      "forearm_flexors_r": "Grip the bar to hold it on the back and turn it on and off the pegs.",
      "forearm_flexors_l": "Grip the bar to hold it on the back and turn it on and off the pegs."
    }
