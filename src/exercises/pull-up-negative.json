        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in at the top, breathe out slowly as you lower, breathe in as you land and jump back up.",
      "cadence": "About 4 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "3-6",
      "tempo": "Jump to the top, brief hold, 3-5 s lowering",
      "load": "Body weight",
      "frequency": "2-3 times a week",
      "progression": "Longer lowering (up to 8 s), pauses on the way down, then the first full pull-ups"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "top",
        "text": "Start at the top: chin over the bar, overhand grip a little wider than the shoulders, shoulders down, legs bent so the feet are off the floor."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Lower as slowly as you can, about 4 seconds, keeping the shoulders down and the body still."
      },
      {
        "id": "c3",
        "phase": "hang",
        "text": "Reach straight arms; keep the shoulder blades lightly set."
      },
      {
        "id": "c4",
        "phase": "land",
        "text": "Put the feet down under the bar, knees bent, still holding the bar."
      },
      {
        "id": "c5",
        "phase": "jump",
        "text": "Jump and pull straight back to the top for the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping quickly through the bottom half",
        "fix": "Keep the same slow speed all the way to straight arms."
      },
      {
        "id": "m2",
        "mistake": "Shrugging up at the top",
        "fix": "Shoulders down away from the ears before you start lowering."
      },
      {
        "id": "m3",
        "mistake": "Swinging after the jump",
        "fix": "Settle at the top before you start lowering."
      },
      {
        "id": "m4",
        "mistake": "Letting the chin poke over the bar",
        "fix": "Pull the chest up; keep the neck long."
      },
      {
        "id": "m5",
        "mistake": "Landing hard",
        "fix": "Land softly with the knees bent."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈142° at the top",
        "peak": "≈12° in the hang",
        "norm": "From well bent at the top to nearly straight; eccentric pull-ups build toward the full pull-up (common coaching standard; elbow range as in Youdas 2010)",
        "sources": [
          "youdas2010"
        ]
      },
      {
        "measure": "Lowering time",
        "setup": "Top hold 0.8 s",
        "peak": "4.2 s from the top to straight arms; land 0.6 s, jump 0.8 s",
        "norm": "3-5 s or longer (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Chin height",
        "setup": "Chin 2.9 cm above the bar at the top",
        "peak": "Body lowers 52 cm",
        "norm": "Chin over the bar at the start (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Grip width",
        "setup": "Overhand, grip points 52 cm apart (shoulder joints 39 cm)",
        "peak": "Unchanged (hands planted on the bar)",
        "norm": "Overhand, a little wider than the shoulders (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Bar height",
        "setup": "Bar 190 cm",
        "peak": "Feet reach the floor with the knees ≈42° when landing; 4.4 cm clear in the hang",
        "norm": "Low enough to jump to the top, high enough to hang with the knees bent (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
