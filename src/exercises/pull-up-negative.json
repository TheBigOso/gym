      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Check the bar is secure and can take your weight before hanging from it.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Eccentric work makes muscles sore for a few days at first: start with few reps.",
        "Land softly with bent knees; use a box to reach the top if the jump is hard."
      ],
      "modify": [
        "Step up from a box instead of jumping.",
        "Shorter lowering time at first."
      ],
      "regressions": [
        "Scapula pull-ups.",
        "Inverted row.",
        "Flexed-arm hang at the top."
      ],
      "progressions": [
        "Longer lowering (6-8 s).",
        "Pauses at three heights on the way down.",
        "Full pull-ups."
      ]
    },
    "muscleNotes": {
      "lats_r": "Control the arms upward as the body lowers (eccentric work).",
      "lats_l": "Control the arms upward as the body lowers (eccentric work).",
      "biceps_r": "Let the elbows open slowly.",
      "biceps_l": "Let the elbows open slowly.",
