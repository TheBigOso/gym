    "bodyPart": "Back (lats) and arms",
    "secondaryBodyParts": [
      "Arms (biceps, brachialis, forearms)",
      "Mid-back",
      "Core"
    ],
    "equipment": [
      "Pull-up bar"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (eccentric shoulder extension and elbow flexion under control)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
