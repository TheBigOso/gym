    "breathing": {
      "pattern": "Inhale as the dumbbells lower behind the head, exhale as you straighten the arms.",
      "cadence": "About 2.2 s down, 0.3 s pause, 1.4 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "tempo": "2-0-1-1",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "More reps, then the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the back pad to 30 degrees; glutes in the crease, upper back and head on the pad, feet planted. Hold the dumbbells straight up over the shoulders (arms about vertical), palms facing each other."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Keep the upper arms still and breathe in as you bend the elbows, lowering the dumbbells back beside the head."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbells beside the head, elbows bent a little past 90 degrees, a stretch in the back of the arms."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbows to bring the dumbbells back up."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight, squeeze the triceps, then go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arms swinging back and forth",
        "fix": "Keep the elbows pointing at the same spot; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows about shoulder-width apart."
      },
      {
        "id": "m3",
        "mistake": "Lowering too fast toward the head",
        "fix": "Lower under control beside the head; keep the dumbbell clear of the face."
      },
      {
        "id": "m4",
        "mistake": "Locking out hard",
        "fix": "Straighten the elbows without snapping them."
      },
      {
        "id": "m5",
        "mistake": "Bench too steep",
        "fix": "Use about 30-45 degrees; steeper turns it into a seated overhead extension."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "30° back pad, flat seat",
        "peak": "Glutes in the crease, upper back and head on the pad (skinned-mesh offsets from b2/chest_mesh.mjs)",
        "norm": "Back pad at 30 degrees (30-45 is common; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (straight, not locked)",
        "peak": "≈98° at the bottom",
        "norm": "From straight to a little past 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm angle",
        "setup": "5° forward of vertical (dumbbells clear the pad): ≈104° of shoulder flexion relative to the trunk",
        "peak": "Unchanged: shoulder channels constant (max 0.0° drift)",
        "norm": "Upper arms about vertical over the shoulders and still; on a 30-degree incline that is roughly 100-120 degrees of shoulder flexion relative to the trunk, more than on a flat bench (clinical opinion; long-length triceps training: Maeo and Kanehisa)",
        "sources": [
          "maeo_desc"
        ]
      },
      {
        "measure": "Dumbbell clearance",
        "setup": "Over the shoulders",
        "peak": "Closest approach to the body 3.2 cm (rig shapes), to the pad 1.4 cm",
        "norm": "Dumbbells beside the head, clear of the head and the pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.2 s down, 0.3 s pause, 1.4 s up, 0.5 s at the top",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #033012, Dumbbell Incline Triceps Extension, video (movement reference)",
        "url": "https://gymvisual.com/videos/7616-dumbbell-incline-triceps-extension.html"
      },
      {
        "id": "maeo_desc",
        "title": "Maeo and Kanehisa, triceps hypertrophy after 12 weeks of elbow extension training with the shoulder at 180 versus 0 degrees of flexion (Descente Sports Science vol 41; full paper: Maeo et al. 2023, Eur J Sport Sci 23(7):1240-1250, PubMed 35819335)",
        "url": "https://www.shinshu-u.ac.jp/faculty/textiles/db/seeds/descente_sports41_21.pdf"
      },
      {
        "id": "boehler2011",
        "title": "Boehler 2011, electromyographic analysis of the triceps brachii muscle during a variety of triceps exercises (MS thesis, University of Wisconsin-La Crosse)",
        "url": "https://minds.wisc.edu/items/4876923b-3a14-47c3-9a69-decf731bd027"
      }
    ],
    "safety": {
      "cautions": [
        "Get into position safely: sit on the end of the bench with the dumbbells on the thighs, then lie back and kick them up one knee at a time; at the end of the set bring them back to the thighs or lower them to the floor beside the bench rather than dropping them (clinical opinion).",
        "Lower beside the head, never toward the face; use fixed-plate dumbbells.",
        "Elbow pain: shorten the range and use lighter dumbbells (clinical opinion).",
        "Keep the wrists straight over the forearms; bent-back wrists under a heavy dumbbell strain the wrist.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort overhead: lower the bench to flat (skull crusher).",
        "Elbow discomfort: lighter dumbbells, shorter range."
      ],
      "regressions": [
        "Flat dumbbell skull crusher.",
        "Band pushdown."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Slower lowering with a pause in the stretch.",
        "Single-arm incline extension."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Only mover: straightens the elbow while the upper arm stays still. All three heads work; the long head is stretched more the higher the arm is raised: 12 weeks of extensions with the shoulder at 180 degrees grew the long head about 33% vs 21% with the arm at the side (Maeo and Kanehisa). On the incline the upper arms are raised further overhead than on a flat bench, so the long head works at a longer length (clinical opinion).",
      "triceps_l": "Only mover: straightens the elbow while the upper arm stays still. All three heads work; the long head is stretched more the higher the arm is raised: 12 weeks of extensions with the shoulder at 180 degrees grew the long head about 33% vs 21% with the arm at the side (Maeo and Kanehisa). On the incline the upper arms are raised further overhead than on a flat bench, so the long head works at a longer length (clinical opinion).",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "ant_deltoid_r": "Holds the upper arm still against the dumbbell.",
      "ant_deltoid_l": "Holds the upper arm still against the dumbbell.",
      "post_deltoid_r": "Holds the upper arm still as the dumbbell lowers behind the elbow.",
      "post_deltoid_l": "Holds the upper arm still as the dumbbell lowers behind the elbow.",
      "rhomboids_midtrap_r": "Keep the shoulder blades set on the pad.",
      "rhomboids_midtrap_l": "Keep the shoulder blades set on the pad.",
      "core": "Keeps the trunk still on the bench."
    }
