    "id": "cable-lateral-raise",
    "name": "Cable Lateral Raise",
    "aliases": [
      "One-arm cable lateral raise",
      "Single-arm cable side raise",
      "Cross-body cable lateral raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "",
      "title": "Cable Lateral Raise",
      "url": "https://gymvisual.com/videos/5015-cable-lateral-raise.html",
      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (lateral deltoid)",
    "secondaryBodyParts": [
      "Upper back (trapezius)",
      "Core"
    ],
    "equipment": [
      "Cable machine",
      "D-handle"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "obliques_r",
        "obliques_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4 per arm",
      "reps": "10-20",
      "effort": "Stop 0-3 reps short of failure (RIR 0-3)",
      "tempo": "2-0.4-2-0.6 (up-pause-down-pause, seconds)",
      "rest": "30-60 s between arms",
      "frequency": "2-3 times a week",
      "load": "Cable stack load is user-chosen; light: the arm is a long lever",
      "progression": "Add reps, then one plate on the stack; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand side-on to a low pulley on your left, feet hip width, knees soft. Hold the D-handle in the right hand in front of the hips, so the cable crosses in front of the body; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the arm out to the side, a little in front of the body, elbow soft, thumb forward."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at about shoulder height; shoulder down, away from the ear."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s back across the front of the hips; do not let the cable pull the arm down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with tension still on the cable, then repeat; switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning away from the stack and swinging the handle up",
        "fix": "Stand tall, brace the side of the trunk and lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulder toward the ear",
        "fix": "Reach the hand long and out; keep the shoulder blade down."
      },
      {
        "id": "m3",
        "mistake": "Raising well above shoulder height",
        "fix": "Stop at about 90 degrees; lateral raises above 90 degrees were linked to impingement signs (impingement study 2014)."
      },
      {
        "id": "m4",
        "mistake": "Bending the elbow more as the arm rises",
        "fix": "Keep the same soft elbow from bottom to top."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "≈20° (handle in front of the hips, 3 cm from the midline)",
        "peak": "≈88° (elbow at shoulder height, 1 cm)",
        "norm": "From in front of the hips to about 90 degrees (the range used by Coratella 2020 for the dumbbell raise); raises above 90 degrees were associated with impingement signs (impingement study 2014)",
        "sources": [
          "coratella2020",
          "impinge2014"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈117° in front of the frontal plane (across the body)",
        "peak": "≈34°",
        "norm": "Starts across the front of the body (the cable pulls the hand toward the stack) and finishes about 30 degrees in front of the frontal plane (scapular plane; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈18°",
        "norm": "Elbow soft, about 10-20 degrees, held nearly constant (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Low pulley 50 cm to the left, 22 cm in front, 15 cm high; cable in front of the hips",
        "peak": "Cable clear of the body by at least 3.38 cm over the loop",
        "norm": "The cable crosses in front of the body from the low pulley to the hand and keeps tension on the arm at the bottom, where a dumbbell gives almost none (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Upright, left hand on the hip",
        "peak": "Unchanged (no lean away)",
        "norm": "Upright, no lean away from the stack (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s in front of the hips",
        "peak": "1.8 s up, 0.4 s at the top, 2.0 s down",
        "norm": "About 2 s up, a short pause, 2 s down (clinical opinion; Coratella 2020 used 2-0.5-2 with dumbbells)",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Lateral Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/5015-cable-lateral-raise.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7706677/"
      },
      {
        "id": "impinge2014",
        "title": "Characteristics of shoulder impingement in the recreational weight-training population (J Strength Cond Res 2014;28(4):1081-1089, PubMed 24077379)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/24077379/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can control for every rep with good form.",
        "Return the handle to the pulley under control at the end of the set; do not let go with the stack lifted.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Pinching at the top: raise only to about 70-80 degrees and keep the arm a little further forward.",
        "Balance: hold the cable tower with the free hand."
      ],
      "regressions": [
        "Lighter stack.",
        "Single-arm dumbbell lateral raise.",
        "Bent-arm lateral raise (shorter lever)."
      ],
      "progressions": [
        "Lean-away cable lateral raise holding the tower.",
        "Slower lowering (3 s) or a 2 s hold at the top.",
        "Cable Y-raise."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Prime mover: abducts the arm against the cable. The lateral raise gave the highest medial deltoid activity among the tested exercises (Campos 2020, dumbbells); a neutral humerus (thumb forward) gave the most in the lifting phase (Coratella 2020).",
      "lat_deltoid_l": "Prime mover on the other side when you switch arms.",
      "ant_deltoid_r": "Helps, more so if the arm drifts forward or the thumb turns up (Coratella 2020).",
      "ant_deltoid_l": "Helps on the other side when you switch arms.",
      "post_deltoid_r": "Assists abduction; the start across the body puts it under a little more stretch.",
      "post_deltoid_l": "Assists on the other side when you switch arms.",
      "upper_traps_r": "Upward rotation of the shoulder blade; shrugging shifts work here.",
      "upper_traps_l": "Upward rotation on the other side when you switch arms.",
      "serratus_r": "Upward rotation of the shoulder blade as the arm rises.",
      "serratus_l": "Upward rotation on the other side when you switch arms.",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred.",
      "infraspinatus_l": "Rotator cuff on the other side when you switch arms.",
      "obliques_r": "Resist the pull of the cable and the lean away from the stack.",
      "obliques_l": "Resist the pull of the cable and the lean away from the stack.",
      "core": "Keeps the trunk still so the handle is not swung up.",
      "forearm_flexors_r": "Grip the D-handle.",
      "forearm_flexors_l": "Grip the D-handle on the other side when you switch arms."
    }
  },
