  },
  "exercise": {
    "id": "incline-leg-hip-raise-leg-straight",
    "name": "Incline Leg Hip Raise (leg straight)",
    "aliases": [
      "Incline straight-leg raise with hip lift",
      "Incline bench leg and hip raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "005063",
      "title": "Incline Leg Hip Raise (leg straight)",
      "url": "https://gymvisual.com/videos/5063-incline-leg-hip-raise-leg-straight.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Decline / incline bench (holding the roller behind the head)"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (hip flexion, then posterior pelvic tilt)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl the hips up, inhale as you lower.",
      "cadence": "About 1.5 s up, a short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-12",
      "tempo": "1.5 s up, brief pause, 2 s down",
      "frequency": "2 times a week",
      "progression": "Bent-knee version first, then straight legs, then a steeper bench"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie head-up on the incline bench, hands gripping the roller behind the head, legs straight and just off the board."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out, raise the straight legs to vertical, then lift the hips off the board pushing the feet toward the ceiling."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause with the hips lifted and the legs straight."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in, lower the hips, then the legs, slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Legs just off the board; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the legs up",
        "fix": "Lift slowly; pause at vertical before the hip lift."
      },
      {
        "id": "m2",
        "mistake": "Bending the knees",
        "fix": "Keep the legs straight."
      },
      {
        "id": "m3",
        "mistake": "Letting the low back arch as the legs lower",
        "fix": "Keep the low back pressed to the board."
      },
      {
        "id": "m4",
        "mistake": "Pulling with the arms",
        "fix": "The hands only anchor you."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈14° (legs just off the board)",
        "peak": "≈89° with the hips lifted",
        "norm": "From legs low to past vertical with the hip lift (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈4° (straight)",
        "peak": "≈4°",
        "norm": "Legs straight throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvic curl",
        "setup": "Pelvis on the board",
        "peak": "Lumbar flexion +27°; buttocks up to 7 cm off the board",
        "norm": "The pelvis rolls off the board at the top (Sarti 1996)",
        "sources": [
          "sarti1996"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #005063, Incline Leg Hip Raise (leg straight), video (movement reference)",
        "url": "https://gymvisual.com/videos/5063-incline-leg-hip-raise-leg-straight.html"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises: implications for rehabilitation and training (Phys Ther 86(5):656-671; PubMed 16649890)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/16649890/"
      },
      {
        "id": "sarti1996",
        "title": "Sarti et al. 1996, muscle activity in upper and lower rectus abdominis during abdominal exercises (Arch Phys Med Rehabil 77(12):1293-1297; PMID 8976314)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/8976314/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Lying on a slope with the head up; get on and off the bench carefully and keep a firm grip on the roller.",
        "Low-back pain: the hip flexors pull on the lumbar spine with long legs; start bent-kneed and with a small range (clinical opinion).",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Smaller range: no hip lift."
      ],
      "regressions": [
        "Floor reverse crunch."
      ],
      "progressions": [
        "Steeper bench.",
        "Slow 3 s lowering."
      ]
    },
    "muscleNotes": {
      "core": "The hip lift at the end curls the pelvis and works the lower abdominals hard (Sarti 1996).",
      "hip_flexors": "Iliopsoas and rectus femoris lift the long, straight legs: a long lever."
    }
  },
