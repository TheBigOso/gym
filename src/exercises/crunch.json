  "exercise": {
    "id": "crunch",
    "name": "Crunch",
    "aliases": [
      "Floor crunch",
      "Abdominal crunch",
      "Curl-up (hands behind head)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "027412",
      "title": "Crunch Floor (male)",
      "url": "https://gymvisual.com/videos/7988-crunch-floor-male.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (spinal flexion, mostly thoracic)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower. Do not hold the breath at the top.",
      "cadence": "About 1 s up, a short squeeze, about 1.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-20",
      "tempo": "About 1 s up, brief pause, 1.5-2 s down",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering and a 2 s hold, then arms overhead, then a light plate on the chest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent about 90 degrees, feet flat and hip width. Fingertips lightly behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the head, shoulders and shoulder blades off the mat; ribs toward the hips."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Short squeeze at the top. Low back stays on the mat; the hands only support the head."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, shoulder blades first, head last."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Head rests briefly; repeat without bouncing."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling on the neck with the hands",
        "fix": "Fingertips only and elbows wide; or cross the arms on the chest."
      },
      {
        "id": "m2",
        "mistake": "Chin jammed to the chest",
        "fix": "Keep a fist-sized gap under the chin and look up toward the knees."
      },
      {
        "id": "m3",
        "mistake": "Sitting all the way up (hip flexors take over)",
        "fix": "Stop once the shoulder blades clear the mat; the low back stays down."
      },
      {
        "id": "m4",
        "mistake": "Bouncing and rushing",
        "fix": "Control the lowering for about 1.5-2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk (T12 to C7) from the floor",
        "setup": "≈-1°",
        "peak": "≈29° (upper back 9.7 cm off the mat; C7 up 14.2 cm)",
        "norm": "Head, shoulders and shoulder blades clear the mat; no study fixes the angle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈-5° (slight lordosis)",
        "peak": "≈-3° (+2°, low back stays on the mat)",
        "norm": "Small: about 3 degrees of lumbar flexion in a crunch, cited by Escamilla 2016 from earlier work",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈17° (resting curve)",
        "peak": "≈52° (+36°)",
        "norm": "Most of the curl happens here (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip and knee",
        "setup": "Hip ≈30°, knee ≈90°",
        "peak": "Unchanged (pelvis and feet still)",
        "norm": "Knees about 90 degrees, feet flat; the pelvis and legs do not move (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Neck",
        "setup": "≈11° (head resting in the hands)",
        "peak": "≈30°",
        "norm": "Neck flexes with the trunk; hands do not pull (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.0 s up, 0.5 s squeeze, 1.6 s down, 1.1 s rest",
        "norm": "Controlled, about 1 s up and 1.5-2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #027412, Crunch Floor (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/7988-crunch-floor-male.html"
      },
      {
        "id": "escamilla2016",
        "title": "Escamilla et al. 2016, muscle activation among supine, prone and side position exercises with and without a Swiss ball (Sports Health 8(4):372-379; PMC4922527)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4922527"
      },
      {
        "id": "konrad2001",
        "title": "Konrad, Schmitz and Denner 2001, neuromuscular evaluation of trunk-training exercises (J Athl Train 36(2):109-118; PMC155519)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC155519"
      },
      {
        "id": "sarti1996",
        "title": "Sarti et al. 1996, muscle activity in upper and lower rectus abdominis during abdominal exercises (Arch Phys Med Rehabil 77(12):1293-1297; PMID 8976314)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/8976314/"
      },
      {
        "id": "axler1997",
        "title": "Axler and McGill 1997, low-back loads over a variety of abdominal exercises: searching for the safest abdominal challenge (Med Sci Sports Exerc 29(6):804-811)",
        "url": "https://acnpsearch.tweb-dev.unibo.it/singlejournalindex/7588015"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain, disc problems or flexion intolerance: start with a McGill-style curl-up, dead bug or plank; partial curl-ups gave the best abdominal challenge for the least spine compression in one model study (Axler and McGill 1997).",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion or straight-leg work.",
        "Osteoporosis or vertebral fracture: avoid repeated loaded spinal flexion."
      ],
      "modify": [
        "Neck pain: cross the arms on the chest or rest the head on a folded towel; reduce the range.",
        "Keep total flexion reps moderate across a session."
      ],
      "regressions": [
        "McGill curl-up (one knee bent, hands under the low back, head and shoulders lift only a little).",
        "Smaller range: head and shoulders only."
      ],
      "progressions": [
        "Arms overhead (longer lever).",
        "Slow 3 s lowering with a 2 s hold.",
        "Light plate held on the chest."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the ribs toward the pelvis: about 53% MVIC upper and 39% lower rectus in a crunch (Escamilla 2016); about 52% MVC in a straight curl-up (Konrad 2001). The curl-up favoured the upper portion in people who performed it correctly (Sarti 1996).",
      "obliques_r": "External and internal obliques assist trunk flexion (about 28% and 33% MVIC in a crunch, Escamilla 2016).",
      "obliques_l": "External and internal obliques assist trunk flexion (about 28% and 33% MVIC in a crunch, Escamilla 2016).",
      "hip_flexors_r": "Stay quiet: rectus femoris was only about 6% MVIC in a crunch (Escamilla 2016), and curl-ups gave the lowest psoas challenge of the tasks McGill compared (McGill 1998). They only steady the bent legs.",
      "hip_flexors_l": "Stay quiet: rectus femoris was only about 6% MVIC in a crunch (Escamilla 2016), and curl-ups gave the lowest psoas challenge of the tasks McGill compared (McGill 1998). They only steady the bent legs."
    }
  },
