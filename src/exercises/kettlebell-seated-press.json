      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (deltoids)",
    "secondaryBodyParts": [
      "Upper arms (triceps)",
      "Core (obliques)"
    ],
    "equipment": [
      "Kettlebell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "triceps_r",
        "triceps_l",
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the shoulder, breathe out as you press, breathe in as you lower.",
      "cadence": "About 1.4 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-10 per arm",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0-1.5-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s between arms",
      "frequency": "1-2 times a week",
      "load": "User-chosen kettlebell; one bell",
      "progression": "Add reps, then a heavier bell; then standing one-arm press"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench, feet flat. Kettlebell racked at the right shoulder, forearm vertical, palm facing in; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press straight up without leaning back or away from the bell."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arm nearly straight, biceps by the ear, wrist straight over the shoulder."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower under control to the shoulder in about 2 s."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brace and repeat; switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back to finish the press",
        "fix": "Keep the ribs down and the trunk tall; use a lighter bell."
      },
      {
        "id": "m2",
        "mistake": "Leaning away from the bell",
        "fix": "Stay square; a unilateral load asks the obliques to hold you upright."
      },
      {
        "id": "m3",
        "mistake": "Pressing out in front of the head",
        "fix": "Finish with the bell over the shoulder, biceps near the ear."
      },
      {
        "id": "m4",
        "mistake": "Wrist bent back under the bell",
        "fix": "Keep the wrist straight and the forearm vertical."
      }
    ],
    "kinematics": [
      {
        "measure": "Seat",
        "setup": "Sitting tall on a 45 cm flat bench, hips 84°, knees 80°, feet flat",
        "peak": "Unchanged",
        "norm": "Sitting tall on a flat bench, hips and knees about 90 degrees, feet flat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation (humerus)",
        "setup": "≈75°",
        "peak": "≈169°",
        "norm": "Upper arm about level at the bottom to about 160-170 degrees overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈106°",
        "peak": "≈7°",
        "norm": "About 90 degrees or more at the bottom (forearm vertical), nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm",
        "setup": "8° off vertical at the shoulder",
        "peak": "1° off vertical at the top",
        "norm": "Vertical under the bell through the press (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk lean",
        "setup": "vertical",
        "peak": "vertical (held)",
        "norm": "Trunk stays vertical; seated presses gave lower deltoid activity than standing ones but remove the leg drive (Saeterbakken 2013); a unilateral load raises oblique activity (Saeterbakken 2012)",
        "sources": [
          "saeterbakken2013",
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Brace 0.8 s at the shoulder",
        "peak": "1.4 s up, 0.4 s at the top, 2.0 s down",
        "norm": "Controlled, about 1.5 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 13776, Kettlebell Seated Press, video (movement reference)",
