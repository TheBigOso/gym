        "forearm_flexors_l"
      ],
      "lengthened": [
        "obliques_r",
        "obliques_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you twist, breathe in as you return.",
      "cadence": "About 1.3 s across, short hold, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 each side",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "45-75 s",
      "frequency": "1-2 times a week",
      "tempo": "1.3-0.5-2-0.5 (twist-hold-return-pause, seconds)",
      "load": "Load is user-chosen: light; twist smoothly through the ribs, hips square.",
      "progression": "Add reps, then load"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel tall on the pad with the hips square and the arms in front at chest height, both hands on the handles."
      },
      {
        "id": "c2",
        "phase": "work",
        "text": "Breathe out and turn the chest and shoulders to the right, arms staying in front of the chest."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold the turn with the hips still facing forward."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and turn back to the centre under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause facing forward; switch sides after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Turning the hips with the chest",
        "fix": "Keep the hips square; rotate through the ribs."
      },
      {
        "id": "m2",
        "mistake": "Jerking into the turn",
        "fix": "Turn smoothly and stop before the end of range."
      },
      {
        "id": "m3",
        "mistake": "Bending the arms to pull",
        "fix": "Keep the arms still in front of the chest."
      },
      {
        "id": "m4",
        "mistake": "Slumping",
        "fix": "Kneel tall with the chest up."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk rotation",
        "setup": "Facing forward",
        "peak": "≈40° to the right (lumbar 4°, thoracic 36°)",
        "norm": "From facing forward to about 35-45 degrees of upper-trunk rotation (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "Kneeling tall on the 10 cm pad, hips square",
        "peak": "Unchanged",
        "norm": "Hips square and still on the knee pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Hands on vertical handles 26 cm apart in front of the chest",
        "peak": "Unchanged relative to the trunk",
        "norm": "Held in front of the chest; they turn with the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lever",
        "setup": "Axle above the head, lined up with the spine",
        "peak": "Arm turns 40°; handles within 0.01 cm of the hands",
        "norm": "The handles turn about a vertical axle lined up with the spine (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Torso machine EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Torso-twist exercise on a training machine activated the obliques well (Scientifica 2015 torso-twist study)",
