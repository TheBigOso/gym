    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Abdominals"
    ],
    "equipment": [
      "Rotary torso lever (handles on an arm turning about a vertical axle, knee pad)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk rotation)",
    "plane": "Transverse",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "core"
      ],
      "stabilizer": [
        "spinal_extensors_r",
