    "breathing": {
      "pattern": "Breathe in at the bottom and brace, breathe out as you press up; breathe in as you lower.",
      "cadence": "About 1.5 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-12",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0-1.5-0 (down-pause-up-pause, seconds)",
      "rest": "90-120 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; the EMG studies used 60-80% of 1RM (Campos 2020; Saeterbakken 2013)",
      "progression": "Add reps, then weight; standing dumbbell press for more deltoid and core demand"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Back pad nearly upright, back against the pad, head neutral, feet flat and wide. Dumbbells at shoulder height, palms forward, elbows under the wrists."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press the dumbbells up and slightly in, over the shoulders."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms nearly straight overhead, dumbbells close but not clanging; keep the ribs down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower under control in about 2 s, elbows tracking under the wrists, a little in front of the body."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the dumbbells at shoulder height and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back off the pad",
        "fix": "Keep the back on the pad and the ribs down; use a lighter weight."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring straight out to the sides or drifting behind the body",
        "fix": "Keep the elbows a little in front of the shoulders (scapular plane) and under the wrists."
      },
      {
        "id": "m3",
        "mistake": "Half reps that stop at the forehead",
        "fix": "Lower until the dumbbells reach about shoulder height, then press to nearly straight arms."
      },
      {
        "id": "m4",
        "mistake": "Wrists bent back",
        "fix": "Stack the wrist over the forearm with the handle across the base of the palm."
      }
    ],
    "kinematics": [
      {
        "measure": "Back pad angle",
        "setup": "85° from the floor; back and buttocks on the pad",
        "peak": "unchanged (trunk still)",
        "norm": "Seated presses are usually done with the back pad at 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation (humerus)",
        "setup": "≈77° (upper arm vs trunk)",
        "peak": "≈162°",
        "norm": "From about 80-90 degrees at the bottom (upper arm about level) to about 160-170 degrees overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈98°, forearm vertical",
        "peak": "≈12° (nearly straight)",
        "norm": "About 90 degrees at the bottom (forearm vertical) to nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Plane of elevation",
        "setup": "elbows ≈30° in front of the frontal plane",
        "peak": "≈40°",
        "norm": "Elbows about 20-40 degrees in front of the frontal plane (scapular plane, about 40 degrees in Tsuruike 2019) rather than straight out to the sides (clinical opinion)",
        "sources": [
          "tsuruike2019"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.8 s at the shoulders",
        "peak": "1.5 s up, 0.4 s at the top, 2.0 s down",
        "norm": "Controlled, about 2 s down and 1-2 s up (clinical opinion)",
        "sources": []
      }
    ],
