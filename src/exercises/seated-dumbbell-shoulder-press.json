    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Get the dumbbells to the shoulders by resting them on the thighs and kicking them up one at a time; lower them back to the thighs at the end of the set."
      ],
      "modify": [
        "Shoulder pain overhead: press with palms facing each other (neutral grip) and the elbows further forward, and stop the press short of full overhead.",
        "Low-back discomfort: keep the pad upright and the back against it; do not lean back to finish reps."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "One arm at a time with the other hand on the thigh.",
        "Machine shoulder press."
      ],
      "progressions": [
        "Standing dumbbell shoulder press (higher deltoid and core activity, Saeterbakken 2013 and 2012).",
        "Arnold press.",
        "Single-arm standing press."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main shoulder flexor-abductor of the press. The shoulder press gave the highest anterior deltoid activity of four common upper-body exercises (Campos 2020); dumbbells gave more anterior deltoid activity than a barbell (Saeterbakken 2013).",
      "ant_deltoid_l": "Main shoulder flexor-abductor of the press. The shoulder press gave the highest anterior deltoid activity of four common upper-body exercises (Campos 2020); dumbbells gave more anterior deltoid activity than a barbell (Saeterbakken 2013).",
      "lat_deltoid_r": "Lifts the upper arm out and up. Medial deltoid activity in the press was close to that in the lateral raise (Campos 2020); seated was about 15% lower than standing with dumbbells (Saeterbakken 2013).",
      "lat_deltoid_l": "Lifts the upper arm out and up. Medial deltoid activity in the press was close to that in the lateral raise (Campos 2020); seated was about 15% lower than standing with dumbbells (Saeterbakken 2013).",
      "triceps_r": "Straightens the elbow in the top half of the press.",
      "triceps_l": "Straightens the elbow in the top half of the press.",
      "upper_traps_r": "Upward rotation and elevation of the shoulder blade as the arms go overhead.",
      "upper_traps_l": "Upward rotation and elevation of the shoulder blade as the arms go overhead.",
      "serratus_r": "Upward rotation and protraction of the shoulder blade, so the arm can reach fully overhead.",
      "serratus_l": "Upward rotation and protraction of the shoulder blade, so the arm can reach fully overhead.",
      "pec_r": "The clavicular head helps the anterior deltoid at the bottom, when the elbows are forward.",
      "pec_l": "The clavicular head helps the anterior deltoid at the bottom, when the elbows are forward.",
      "post_deltoid_r": "Steadies the shoulder; much less active than the front and side heads, and lower seated than standing (Saeterbakken 2013).",
      "post_deltoid_l": "Steadies the shoulder; much less active than the front and side heads, and lower seated than standing (Saeterbakken 2013).",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred in the socket as the arm rises.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred in the socket as the arm rises.",
      "core": "Holds the trunk still against the pad. Core activity was lower seated than standing (Saeterbakken 2012)."
    }
  },
