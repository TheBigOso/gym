        "infraspinatus_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Brace and breathe out as you press up, breathe in as the hands come back to the shoulders.",
      "cadence": "About 1 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1 (2 s down, 1 s up, 1 s at the top)",
      "progression": "More reps, a slower lowering, a wider stance on the band (more stretch), then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the bands with the feet a little wider than hip width, knees soft. A band end in each hand at the front of the shoulders, palms forward, elbows under the hands."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Brace, breathe out and press the hands straight up until the arms are straight over the shoulders, the head moving slightly through as the hands pass the face."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Arms straight, biceps beside the ears, ribs down; do not lean back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and bring the hands back to the shoulders under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the band still taut, then press again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back to finish the press",
        "fix": "Squeeze the glutes and keep the ribs down; use a lighter band."
      },
      {
        "id": "m2",
        "mistake": "Pressing forward of the head",
        "fix": "Finish with the hands over the shoulders, not in front of the face."
      },
      {
        "id": "m3",
        "mistake": "Elbows flaring straight out at the bottom",
        "fix": "Start with the elbows slightly forward of the body, under the hands."
      },
      {
        "id": "m4",
        "mistake": "Letting the bands snap the hands down",
        "fix": "Lower for about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder elevation",
        "setup": "≈22° with the hands at the shoulders",
        "peak": "≈162° at lockout",
        "norm": "About 80-90 degrees with the hands at the shoulders to about 165-175 degrees at lockout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈132°",
        "peak": "≈9° (nearly straight)",
        "norm": "About 90-110 degrees at the bottom to nearly straight overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Standing tall (≈5° from vertical), feet 34 cm apart, knees soft",
        "peak": "Unchanged (no lean back)",
        "norm": "Standing tall without leaning back; standing presses demand more trunk muscle activity than seated ones (Saeterbakken and Fimland 2013).",
        "sources": [
          "saeterbakken2013"
        ]
      },
      {
        "measure": "Band",
        "setup": "One band per hand under the ball of each foot; strands 140.8 cm",
        "peak": "Strands 193.7 cm at lockout; at least 0.8 cm from the body",
        "norm": "Each band anchored under the ball of its own foot, so the tension rises toward lockout; elastic resistance can give muscle activity comparable to free weights (Andersen 2010).",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the shoulders",
        "peak": "1.1 s up, 0.4 s lockout, 1.8 s down, 0.4 s pause",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
