    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Keep the band securely under the ball of each foot; a band that slips out can whip up toward the face.",
        "Shoulder pain overhead: press with the palms facing each other and stop short of full lockout (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: neutral grip (palms facing).",
        "Low back discomfort: press seated on a bench."
      ],
      "regressions": [
        "Lighter band.",
        "One arm at a time.",
        "Band seated shoulder press."
      ],
      "progressions": [
        "Stronger band or a wider stance on the band.",
        "Slower 3 s lowering.",
        "Dumbbell or barbell standing press."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover of the press, flexing the shoulder (Campos 2020 compared deltoid portions across shoulder exercises).",
      "ant_deltoid_l": "Main mover of the press, flexing the shoulder (Campos 2020 compared deltoid portions across shoulder exercises).",
      "lat_deltoid_r": "Abducts the arm as the elbows travel out and up.",
      "lat_deltoid_l": "Abducts the arm as the elbows travel out and up.",
      "triceps_r": "Straightens the elbows to lock out.",
      "triceps_l": "Straightens the elbows to lock out.",
      "upper_traps_r": "Rotate the shoulder blades upward and elevate them as the arms go overhead.",
      "upper_traps_l": "Rotate the shoulder blades upward and elevate them as the arms go overhead.",
      "serratus_r": "Rotates the shoulder blades upward with the trapezius.",
      "serratus_l": "Rotates the shoulder blades upward with the trapezius.",
      "obliques_r": "Resist leaning back as the band tightens.",
      "obliques_l": "Resist leaning back as the band tightens.",
      "core": "Braces the trunk: standing presses load the trunk more than seated ones (Saeterbakken and Fimland 2013).",
      "spinal_extensors_r": "Hold the trunk tall.",
      "spinal_extensors_l": "Hold the trunk tall.",
      "infraspinatus_r": "Rotator cuff: centres the head of the upper arm overhead (clinical opinion).",
      "infraspinatus_l": "Rotator cuff: centres the head of the upper arm overhead (clinical opinion).",
      "forearm_flexors_r": "Grip the band.",
      "forearm_flexors_l": "Grip the band."
    }
