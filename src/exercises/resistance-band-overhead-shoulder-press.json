    },
    "type": "Strength",
    "bodyPart": "Shoulders (anterior and lateral deltoid)",
    "secondaryBodyParts": [
      "Triceps",
      "Upper trapezius",
      "Core"
    ],
    "equipment": [
      "Resistance band (two, or one long band under both feet)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "lat_deltoid_r",
