  "exercise": {
    "id": "v-up",
    "name": "V-up",
    "aliases": [
      "V-sit-up",
      "Jackknife sit-up",
      "Pike-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "362212",
      "title": "V-up (male)",
      "url": "https://gymvisual.com/videos/8007-v-up-male.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (trunk flexion and hip flexion together)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you fold up, inhale as you lower.",
      "cadence": "About 1.2 s up, short balance, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-12",
      "tempo": "About 1 s up, brief balance, 2 s down",
      "frequency": "1-3 times a week",
      "progression": "Tuck-up first, then V-up, then a slower lowering or a hold at the top (V-sit)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, legs straight and together, arms straight overhead on the mat."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and lift the arms and legs together, folding at the hips."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Balance on the hips with the hands reaching toward the shins; chest lifted, legs straight."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower both ends slowly; keep the low back from arching as the legs come down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch down lightly, arms overhead, and go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arms reach but legs stay low (or the reverse)",
        "fix": "Lift both ends at the same time so they meet over the hips."
      },
      {
        "id": "m2",
        "mistake": "Crashing down",
        "fix": "Lower in about 2 s; stop just above the mat if you can."
      },
      {
        "id": "m3",
        "mistake": "Low back arching off the mat as the legs lower",
        "fix": "Brace and shorten the range, or bend the knees (tuck-up)."
      },
      {
        "id": "m4",
        "mistake": "Bent knees and floppy legs",
        "fix": "Squeeze the thighs together and keep the knees soft but long."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from the floor",
        "setup": "≈-5°",
        "peak": "≈52° (balanced on the buttock)",
        "norm": "Trunk and legs meet over the hips; no study defines the angles (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Legs from the floor",
        "setup": "≈0° (resting)",
        "peak": "≈58°",
        "norm": "Legs straight, rising to meet the hands (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈2°",
        "peak": "≈99° (trunk-to-leg angle ≈70°)",
        "norm": "Deep hip flexion at the top: the V (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Spine flexion",
        "setup": "≈2° (resting curve)",
        "peak": "≈32° (+30°)",
        "norm": "Upper back curls, chest stays fairly long (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Straight overhead, resting on the mat about shoulder width",
        "peak": "Reaching toward the shins (fingertips 14.6 cm from the shin line)",
        "norm": "From overhead on the mat to reaching toward the shins (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Lie 0.8 s",
        "peak": "1.2 s up, 0.5 s balance, 2.0 s down, 1.5 s reset",
        "norm": "About 1 s up, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
