    "id": "cable-standing-side-bend",
    "name": "Cable Standing Side Bend",
    "aliases": [
      "Cable side bend",
      "Standing cable side bend",
      "Low pulley side bend",
      "Cable oblique side bend"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "24422",
      "title": "Cable Standing Side Bend (version 3)",
      "url": "https://gymvisual.com/videos/24422-cable-standing-side-bend-version-3.html",
      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read; the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Core",
      "Lower back"
    ],
    "equipment": [
      "Cable machine",
      "D-handle attachment"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (lateral flexion of the trunk)",
    "plane": "Frontal",
    "laterality": "Unilateral load (one side at a time)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_l",
        "spinal_extensors_l"
      ],
      "synergist": [
        "obliques_r",
        "core"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "upper_traps_r",
        "glute_med_r",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you bend toward the pulley, exhale as you pull back up.",
      "cadence": "About 1.5 s down, short pause, about 1.5 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 per side",
      "tempo": "About 1.5 s down, brief pause, 1.5 s up",
      "rest": "45-90 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set.",
      "progression": "Add reps, then one plate on the stack. Many coaches prefer suitcase carries for the same muscles with less spine bending."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand side-on to the low pulley, feet hip width, a D-handle in the right (near) hand at your side, palm facing the thigh; left fingertips lightly behind the head. Step far enough away that the cable is taut."
      },
      {
        "id": "c2",
        "phase": "down",
        "text": "Breathe in and let the cable draw you straight sideways toward the pulley; the handle slides down the outside of the thigh."
      },
      {
        "id": "c3",
        "phase": "pause",
        "text": "Short pause at a comfortable stretch; no leaning forward or twisting."
      },
      {
        "id": "c4",
        "phase": "up",
        "text": "Breathe out and pull the trunk back up with the opposite side of the waist, just past upright."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall; finish the set, then turn around and work the other side."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning forward or twisting toward the stack",
        "fix": "Move in a flat side plane, chest facing forward."
      },
      {
        "id": "m2",
        "mistake": "Pulling the handle up with the arm",
        "fix": "Arm long and relaxed; the waist does the work."
      },
      {
        "id": "m3",
        "mistake": "Letting the cable yank you into the bottom",
        "fix": "Lower over about 1.5 s against the cable."
      },
      {
        "id": "m4",
        "mistake": "Standing so close that the cable goes slack at the bottom",
        "fix": "Step away until the stack lifts slightly at the start."
      }
    ],
    "kinematics": [
      {
        "measure": "Lateral flexion (pelvis to C7)",
        "setup": "Upright (≈0°)",
        "peak": "≈21° toward the pulley (pelvis to C7); spine segments ≈33° (lumbar ≈13°, thoracic ≈21°); back up to ≈5° past upright",
        "norm": "A comfortable side bend toward the pulley and back to just past upright; no study fixes the range (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Handle path",
        "setup": "Handle beside the thigh, wrist 83 cm above the floor",
        "peak": "Slides 14 cm down the outside of the thigh (arm stays vertical, ≈9° max off vertical)",
        "norm": "Slides down the outside of the thigh, arm vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Low pulley 34 cm out to the right of the handle, 14 cm high",
        "peak": "Runs down the outside of the leg, clear of the body by at least 4.34 cm",
        "norm": "Low pulley out to the side, so the cable pulls the trunk toward it through the whole range (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "Hips square, feet planted",
        "peak": "Pelvis shifts 2.6 cm away from the bend; no twisting or forward lean",
        "norm": "Square, with a small shift away from the bend (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.7 s",
        "peak": "1.6 s down, 0.5 s pause, 1.5 s up, 0.5 s past upright, 1.1 s reset",
        "norm": "About 1.5 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Standing Side Bend (version 3), video (movement reference)",
        "url": "https://gymvisual.com/videos/24422-cable-standing-side-bend-version-3.html"
      },
      {
        "id": "konrad2001",
