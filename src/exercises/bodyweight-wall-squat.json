  },
  "exercise": {
    "id": "bodyweight-wall-squat",
    "name": "Bodyweight Wall Squat",
    "aliases": [
      "Wall sit",
      "Wall squat",
      "Isometric wall squat"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "154612",
      "title": "Bodyweight Wall Squat",
      "url": "https://gymvisual.com/videos/11206-bodyweight-wall-squat.html",
      "listing": "Video; data sheet: body part Thighs, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Hips (glutes)"
    ],
    "equipment": [
      "Body weight",
      "Wall"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound, isometric hold (hip and knee)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "hamstrings_r",
        "hamstrings_l",
        "calves_r",
        "calves_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily throughout the hold. Do not hold your breath: isometric holds raise blood pressure (Goldring 2014).",
      "cadence": "Slow, even breaths, about 3-4 s each"
    },
    "prescription": {
      "sets": "2-4",
      "holds": "20-60 s",
      "rest": "1-2 min",
      "frequency": "2-3 times a week",
      "progression": "Longer holds, then a deeper knee angle toward 90 degrees (Goldring 2014: intensity is set by the knee angle)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Back flat on the wall, feet shoulder width and about a thigh length out from it."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Slide down the wall until the thighs are about parallel and the shins vertical."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold: knees over the ankles, weight in the heels, keep breathing."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Push through the heels and slide back up."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand against the wall and reset."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Feet too close to the wall (knees far past the toes)",
        "fix": "Walk the feet out until the shins are vertical at the bottom."
      },
      {
        "id": "m2",
        "mistake": "Holding the breath",
        "fix": "Breathe in and out steadily the whole hold."
      },
      {
        "id": "m3",
        "mistake": "Pushing the hands on the thighs",
        "fix": "Let the arms hang or rest them lightly; the legs do the work."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈32° (leaning on the wall)",
        "peak": "≈90° held for 5 s",
        "norm": "About 90 degrees at the hold; 45 degrees used as a gentler rehab angle (Biscarini 2022); intensity rises from 135 to 90 degrees included angle (Goldring 2014)",
        "sources": [
          "goldring2014",
          "biscarini2022"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈48°",
        "peak": "≈93° (joint channel)",
        "norm": "About 90 degrees with the back upright on the wall",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈5° (upright on the wall)",
        "norm": "Upright against the wall",
        "sources": [
          "biscarini2022"
        ]
      },
      {
        "measure": "Feet from the wall",
        "setup": "Ankles 50.2 cm in front of the wall face (thigh 40.6 cm)",
        "peak": "Unchanged",
        "norm": "0.5-1 thigh length tested (Biscarini 2022); about one thigh length gives vertical shins at 90 degrees",
        "sources": [
          "biscarini2022"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "On the wall 1 s",
        "peak": "2 s down, 5 s hold, 1.5 s up",
        "norm": "Holds of 2 min used in blood-pressure studies (Goldring 2014); 20-60 s typical for training (clinical opinion)",
        "sources": [
          "goldring2014"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #154612, Bodyweight Wall Squat, video (movement reference)",
        "url": "https://gymvisual.com/videos/11206-bodyweight-wall-squat.html"
      },
      {
        "id": "goldring2014",
        "title": "Goldring, Wiles and Coleman 2014, isometric wall squat: intensity set by knee angle, heart rate and blood pressure responses (J Sports Sci 32:129-136)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23879248/"
      },
      {
        "id": "biscarini2022",
        "title": "Biscarini et al. 2022, forefoot-rearfoot and pelvic-scapular weight shifts during static wall-squat exercises (Appl Sci 12:4037)",
        "url": "https://www.mdpi.com/2076-3417/12/8/4037"
      },
      {
        "id": "isosquat2016",
        "title": "Isometric squat at 20, 90 and 140 degrees: muscle activation by knee angle (PMC4967668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4967668"
      },
      {
        "id": "lee2022",
        "title": "Lee et al. 2022, comparison of quadriceps and hamstring activity in the general, wall and Spanish squat (BMC Sports Sci Med Rehabil 14:12)",
        "url": "https://link.springer.com/doi/10.1186/s13102-022-00404-6"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Isometric holds raise heart rate and blood pressure (Goldring 2014): people with uncontrolled high blood pressure should ask a clinician first."
      ],
      "modify": [
        "Knee pain: hold a shallower angle (about 45 degrees)."
      ],
      "regressions": [
        "Shallower angle.",
        "Shorter holds."
      ],
      "progressions": [
        "Longer holds.",
        "Deeper angle toward 90 degrees.",
        "Single-leg wall squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Hold the knee bend against body weight. Isometric quadriceps activity was higher at about 90 degrees of knee flexion than at shallower angles (PMC4967668), and intensity rises as the knee angle closes (Goldring 2014).",
      "quads_l": "Hold the knee bend against body weight. Isometric quadriceps activity was higher at about 90 degrees of knee flexion than at shallower angles (PMC4967668), and intensity rises as the knee angle closes (Goldring 2014).",
      "glute_max_r": "Helps hold the hips; low activity in shallow wall squats (Biscarini 2022).",
      "glute_max_l": "Helps hold the hips; low activity in shallow wall squats (Biscarini 2022).",
      "adductors_r": "Help keep the knees in line over the feet.",
      "adductors_l": "Help keep the knees in line over the feet.",
      "hamstrings_r": "Low activity; Biscarini 2022 judged the shallow (45 degree) wall squat ineffective for hamstring and glute strengthening.",
      "hamstrings_l": "Low activity; Biscarini 2022 judged the shallow (45 degree) wall squat ineffective for hamstring and glute strengthening.",
      "calves_r": "Keep the shins steady over flat feet.",
      "calves_l": "Keep the shins steady over flat feet.",
      "core": "Keeps the back flat against the wall."
    }
  },
