      }
    ],
    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Keep the bands securely under the feet; a band that slips can whip up toward the face.",
        "Elbow or wrist pain with the close grip: widen the hands to shoulder width (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrist discomfort: hammer grip (palms facing)."
      ],
      "regressions": [
        "Lighter band.",
        "One arm at a time."
      ],
      "progressions": [
        "Stronger band or a wider stance on the band.",
        "Pause 2 s at the top.",
        "Dumbbell close grip curl."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main mover: bends the elbow and keeps the forearm turned palm-up; the supinated grip gives the highest biceps activity (Coratella 2023; Marcolin 2018).",
      "biceps_l": "Main mover: bends the elbow and keeps the forearm turned palm-up; the supinated grip gives the highest biceps activity (Coratella 2023; Marcolin 2018).",
      "forearm_flexors_r": "Grip the band and assist elbow flexion (brachioradialis).",
      "forearm_flexors_l": "Grip the band and assist elbow flexion (brachioradialis).",
      "forearm_extensors_r": "Steady the wrist.",
      "forearm_extensors_l": "Steady the wrist.",
      "ant_deltoid_r": "Holds the upper arm still as the band pulls the hand down.",
      "ant_deltoid_l": "Holds the upper arm still as the band pulls the hand down.",
      "upper_traps_r": "Steady the shoulders.",
      "upper_traps_l": "Steady the shoulders.",
      "core": "Keeps the trunk still."
    }
