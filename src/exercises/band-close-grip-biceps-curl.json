      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
