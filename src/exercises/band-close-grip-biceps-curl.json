      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Biceps",
    "secondaryBodyParts": [
      "Forearms (brachioradialis)"
    ],
    "equipment": [
      "Resistance band (two, or one long band under both feet)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "forearm_extensors_r",
        "forearm_extensors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl up, breathe in as you lower.",
      "cadence": "About 1 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1",
      "progression": "More reps, a slower lowering, a wider stance on the band, then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the bands with the feet close together, knees soft. A band end in each hand in front of the thighs, hands close together (narrower than the hips), palms forward, elbows by the sides."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the hands up toward the chest, keeping the elbows at the sides and the hands close."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the biceps at the top, where the band is most stretched; elbows still by the sides."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower against the band to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the arms straight and the band taut, then curl again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows drifting forward or flaring out",
        "fix": "Pin the elbows to the sides of the ribs."
      },
      {
        "id": "m2",
        "mistake": "Swinging the trunk",
        "fix": "Stand tall, knees soft; use a lighter band."
      },
      {
        "id": "m3",
        "mistake": "Hands drifting apart",
        "fix": "Keep the hands close, narrower than the hips."
      },
      {
        "id": "m4",
        "mistake": "Dropping the hands quickly",
        "fix": "Lower for about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈23° (arms nearly straight)",
        "peak": "≈128° at the top",
        "norm": "Nearly straight to about 130 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm rotation",
        "setup": "-0.7° (palm forward)",
        "peak": "0° (palm up and in)",
        "norm": "Palms forward (supinated); a supinated grip gives the highest biceps activity among curl grips (Coratella 2023; Marcolin 2018).",
        "sources": [
          "coratella2023",
          "marcolin2018"
        ]
      },
      {
        "measure": "Upper arm",
        "setup": "≈0° from the trunk line",
        "peak": "≈8° (elbows drift a little forward)",
        "norm": "Upper arms stay beside the trunk, drifting forward only a little at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hand spacing",
        "setup": "Grip points 21.3 cm apart (hips 20.8 cm)",
        "peak": "22.2 cm apart at the top",
        "norm": "Hands narrower than the hips (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "One band per hand under the ball of each foot, feet 20 cm apart; strands 81.3 cm",
        "peak": "Strands 136.8 cm at the top; at least 5.4 cm from the body",
        "norm": "Each band under the ball of its own foot; tension rises toward the top. Elastic resistance can match free weights (Andersen 2010).",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s with the arms straight",
        "peak": "1.1 s up, 0.4 s squeeze, 1.8 s down, 0.4 s pause",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Close Grip Biceps Curl, video (movement reference)",
