  "exercise": {
    "id": "lying-around-the-world",
    "name": "Lying Around the World",
    "aliases": [
      "Lying leg circles (both legs)",
      "Supine double leg circles",
      "Around the world leg circles",
      "Leg rainbows (lying)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9012",
      "title": "Lying Around the World",
      "url": "https://gymvisual.com/videos/9012-lying-around-the-world.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Obliques"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isometric trunk, dynamic hips",
    "plane": "Multiplanar",
    "laterality": "Bilateral (legs together), both directions",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "adductors_r",
        "adductors_l",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily; exhale as the legs pass the low side of the circle.",
      "cadence": "One breath per circle, about 3 s"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "4-6 circles each direction",
      "tempo": "About 3 s per circle",
      "frequency": "2-3 times a week",
      "progression": "Bigger circles, lower bottom point, slower circles"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms by your sides, palms down. Lift both straight legs together."
      },
      {
        "id": "c2",
        "phase": "circle",
        "text": "Draw a big circle with the feet: up, out to one side, down, across, and back up."
      },
      {
        "id": "c3",
        "phase": "circle",
        "text": "Keep the legs glued together and the pelvis and shoulders still on the mat."
      },
      {
        "id": "c4",
        "phase": "reverse",
        "text": "Circle the other way."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Lower the legs together with control."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pelvis rolling with the legs",
        "fix": "Make the circle smaller; press the palms and the back of the shoulders into the mat."
      },
      {
        "id": "m2",
        "mistake": "Low back arching at the bottom of the circle",
        "fix": "Keep the bottom of the circle higher."
      },
      {
        "id": "m3",
        "mistake": "Legs drifting apart",
        "fix": "Squeeze the knees and ankles together."
      },
      {
        "id": "m4",
        "mistake": "Rushing",
        "fix": "Slow, even circles, about 3 s each."
      }
    ],
    "kinematics": [
      {
        "measure": "Leg height",
        "setup": "Legs on the mat",
        "peak": "Circle from ≈21° to ≈61° above the floor (hip ≈24°-≈64°); heels 19 cm off the mat at the bottom",
        "norm": "Circle centred well off the floor; the bottom stays high enough for a flat low back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Side sweep",
        "setup": "–",
        "peak": "≈24° to each side (right hip abduction ≈19°, left hip adduction ≈22°)",
        "norm": "Legs swing about 20-25 degrees to each side with the pelvis still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Still on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.6 s, lift 0.8 s",
        "peak": "2.8 s per circle, one each way, lower 0.8 s",
        "norm": "About 3 s per circle (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
