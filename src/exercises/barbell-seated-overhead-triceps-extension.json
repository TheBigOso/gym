    "safety": {
      "cautions": [
        "Shoulder pain overhead: switch to a cable or a lying extension (clinical opinion).",
        "Start light: the bar travels behind the head, close to the neck.",
        "Get the bar overhead from a clean press or a partner; never swing it up behind the neck.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower back arching: use a bench with an upright back pad.",
        "Wrist discomfort: an EZ bar."
      ],
      "regressions": [
        "Seated dumbbell overhead triceps extension.",
        "Cable overhead triceps extension."
      ],
      "progressions": [
        "Heavier bar in small steps.",
        "Standing version (more core work)."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Does the work with the arm overhead, where the long head is lengthened. Twelve weeks of overhead elbow extensions grew the long head about 1.5 times and the whole triceps about 1.4 times more than the same training with the arm at the side (Eur J Sport Sci, PubMed 35819335).",
      "triceps_l": "Does the work with the arm overhead, where the long head is lengthened. Twelve weeks of overhead elbow extensions grew the long head about 1.5 times and the whole triceps about 1.4 times more than the same training with the arm at the side (Eur J Sport Sci, PubMed 35819335).",
      "ant_deltoid_r": "Holds the upper arms up beside the head (clinical opinion).",
      "ant_deltoid_l": "Holds the upper arms up beside the head (clinical opinion).",
      "lat_deltoid_r": "Helps hold the arms overhead (clinical opinion).",
      "lat_deltoid_l": "Helps hold the arms overhead (clinical opinion).",
      "upper_traps_r": "Rotate the shoulder blades upward to keep the arms overhead (clinical opinion).",
      "upper_traps_l": "Rotate the shoulder blades upward to keep the arms overhead (clinical opinion).",
      "serratus_r": "Works with the upper trapezius to hold the shoulder blades in upward rotation (clinical opinion).",
      "serratus_l": "Works with the upper trapezius to hold the shoulder blades in upward rotation (clinical opinion).",
      "forearm_flexors_r": "Grip the bar.",
      "forearm_flexors_l": "Grip the bar.",
      "core": "Keeps the ribs down so the lower back does not arch."
    }
