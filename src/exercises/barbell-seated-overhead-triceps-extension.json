    "breathing": {
      "pattern": "Inhale as the bar lowers behind the head, exhale as you straighten the arms.",
      "cadence": "About 2.3 s down, short pause, about 1.4 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "load": "Barbell load is user-chosen: pick a weight you can control for every rep with 1-3 reps in reserve (RPE 7-9). Expect to use less than for pushdowns: overhead loads were 34-39% lower in the training study (PubMed 35819335).",
      "rest": "60-120 s",
      "progression": "More reps, then 1-2.5 kg more; the training study used 5 sets of 10 at 70% 1RM twice a week"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench, feet flat. Hold the bar overhead with straight arms, overhand grip a little narrower than shoulder width."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows, lowering the bar behind the head; elbows point up and stay close to the head."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Bar behind the head at about neck height, upper arms beside the ears, trunk tall."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbows to press the bar back overhead."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked, ribs down; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring wide",
        "fix": "Keep the elbows pointing up, about head width apart."
      },
      {
        "id": "m2",
        "mistake": "Upper arms dropping forward as you press",
        "fix": "Keep the upper arms beside the head; only the forearms move."
      },
      {
        "id": "m3",
        "mistake": "Lower back arching",
        "fix": "Brace the abs and keep the ribs down; use a lighter bar."
      },
      {
        "id": "m4",
        "mistake": "Head pushed forward",
        "fix": "Keep the head neutral; the bar travels behind it."
      },
      {
        "id": "m5",
        "mistake": "Bar hitting the back of the head or neck",
        "fix": "Lower only as far as you can control, with the elbows high."
      }
    ],
    "kinematics": [
      {
        "measure": "Grip width",
        "setup": "30 cm between the handle centres (shoulder joints 40.5 cm apart)",
        "peak": "Constant (29.93-30.1 cm over the loop)",
        "norm": "A little narrower than shoulder width (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12° (arms straight overhead, not locked)",
        "peak": "≈128° with the bar behind the head",
        "norm": "Straight but not locked at the top; lower until the bar is behind the head, about 100-120 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation",
        "setup": "Upper arms ≈164° from the trunk line (pointing up, 8° forward), elbows 32 cm apart",
        "peak": "Held: at most 0.3° of drift over the loop",
        "norm": "Arm overhead: the long head is lengthened, which gave more triceps growth than the arm at the side (PubMed 35819335); at 135-180 degrees of shoulder elevation the medial head carried the most force (Kholinne 2018)",
        "sources": [
          "overhead2022",
          "kholinne2018"
        ]
      },
      {
        "measure": "Bar clearance",
        "setup": "Bar 53.8 cm above the shoulder joints",
        "peak": "11.6 cm from the ear_l at the closest (rig shapes); bar 23.4 cm behind the shoulder joints, 10.3 cm above them",
        "norm": "The bar passes behind the head without touching it (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Seat",
        "setup": "Bench end, seat 45 cm; trunk ≈5° from vertical, knees ≈88°",
        "peak": "Unchanged (trunk and pelvis still)",
        "norm": "Tall on the end of a flat bench, feet flat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Overhead 0.6 s",
        "peak": "2.3 s down, 0.3 s pause, 1.4 s up, 0.6 s at the top",
        "norm": "Controlled, about 2 s lowering and 1-1.5 s pressing (clinical opinion); the EMG comparison used sets of 7 reps at 70% of 1RM (Boehler 2011)",
        "sources": [
          "boehler2011"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Barbell Seated Overhead Triceps Extension, video (movement reference)",
