        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10987311/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Heels lift or knees ache: squat to a shallower depth or a box.",
        "Tight ankles: a small heel raise or a slightly wider stance."
      ],
      "regressions": [
        "Bodyweight narrow squat.",
        "Dumbbell squat to a box."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "2 s pause at the bottom.",
        "Heels-elevated goblet squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Knee extensors lower and drive the squat; the narrow stance and forward knee travel keep the load on the quadriceps (clinical opinion).",
      "quads_l": "Knee extensors lower and drive the squat; the narrow stance and forward knee travel keep the load on the quadriceps (clinical opinion).",
      "glute_max_r": "Hip extensor, working hardest out of the bottom (clinical opinion).",
      "glute_max_l": "Hip extensor, working hardest out of the bottom (clinical opinion).",
      "adductors_r": "Help extend the hip out of the bottom and keep the knees in line (clinical opinion).",
      "adductors_l": "Help extend the hip out of the bottom and keep the knees in line (clinical opinion).",
      "hamstrings_r": "Co-contract around the knee and assist hip extension out of the bottom (clinical opinion).",
      "hamstrings_l": "Co-contract around the knee and assist hip extension out of the bottom (clinical opinion).",
      "calves_r": "Steady the shins as the knees travel forward over the toes.",
      "calves_l": "Steady the shins as the knees travel forward over the toes.",
      "core": "Braces against the load held in front of the body.",
      "spinal_extensors_r": "Keep the back flat as the trunk leans a little forward (clinical opinion).",
      "spinal_extensors_l": "Keep the back flat as the trunk leans a little forward (clinical opinion).",
      "glute_med_r": "Keeps the knees tracking over the toes (clinical opinion).",
      "glute_med_l": "Keeps the knees tracking over the toes (clinical opinion).",
      "forearm_flexors_r": "Grip the dumbbell handle for the whole set (clinical opinion).",
      "forearm_flexors_l": "Grip the dumbbell handle for the whole set (clinical opinion).",
      "upper_traps_r": "Hold the shoulders level against the hanging dumbbells (clinical opinion).",
      "upper_traps_l": "Hold the shoulders level against the hanging dumbbells (clinical opinion)."
    }
