        "upper_traps_r",
        "upper_traps_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the top, lower; breathe out as you pass the hardest part of the rise.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbells, a 2 s pause at the bottom. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet close together, toes forward or slightly out; a dumbbell in each hand at the sides, palms in, arms long."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, brace, bend the knees forward over the toes and sit down between the heels; the dumbbells hang straight down."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs about parallel, heels down, chest up."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the floor away and stand tall; breathe out near the top."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, shoulders set, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Heels lifting",
        "fix": "Sit back a little more and stop at the depth where the heels stay down."
      },
      {
        "id": "m2",
        "mistake": "Knees drifting together",
        "fix": "Keep the knees pointing the same way as the toes."
      },
      {
        "id": "m3",
        "mistake": "Shrugging or swinging the dumbbells",
        "fix": "Arms long and relaxed, shoulders down; the dumbbells just hang."
      },
      {
        "id": "m4",
        "mistake": "Rounding the back at the bottom",
        "fix": "Stop above the depth where the pelvis tucks; keep the chest up."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "16 cm between ankle centres (≈0.4x the rig's 40 cm shoulder width), toes out 6°",
        "peak": "Unchanged",
        "norm": "Feet close together, narrower than hip width (common coaching)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈106°, ankle dorsiflexion ≈30°",
        "norm": "About 100-110 degrees with the thighs near parallel (clinical opinion); a narrow stance needs more ankle dorsiflexion for the same depth (clinical opinion; Zawadka 2020 on depth and knee range)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈2°",
        "peak": "≈111° (joint channel, as in the HUD)",
        "norm": "Not specified by the sources for this depth",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈26° forward",
        "norm": "A little more lean than a hip-width squat (clinical opinion); more lean moves demand from knee to hip (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Dumbbells",
        "setup": "Hanging at the sides, palms in",
        "peak": "Straight down beside the legs (≥1.35 cm from the body on the rig shapes, 25.5 cm off the floor at the lowest)",
        "norm": "Hanging straight down at the sides (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "About 2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #19810, Dumbbell Narrow Squat, video (movement reference)",
