    "id": "lying-crunch-straight-legs",
    "name": "Lying Crunch (Straight Legs)",
    "aliases": [
      "Straight-leg crunch",
      "Flat-leg crunch",
      "Legs-extended curl-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15139",
      "title": "Lying Crunch (straight legs) (male)",
