      "listing": "Page could not be read (gymvisual.com is blocked by the network proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (spinal flexion, mostly thoracic)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower. Do not hold the breath at the top.",
      "cadence": "About 1 s up, a short squeeze, about 1.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-20",
      "tempo": "About 1 s up, brief pause, 1.5-2 s down",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering and a 2 s hold, then arms overhead, then a light plate on the chest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back with both legs straight and together on the mat. Fingertips lightly behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the head, shoulders and shoulder blades off the mat; ribs toward the hips."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Short squeeze at the top. Heels, pelvis and low back stay down; the hands only support the head."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, shoulder blades first, head last."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Head rests briefly; repeat without bouncing."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling on the neck with the hands",
        "fix": "Fingertips only and elbows wide; or cross the arms on the chest."
      },
      {
        "id": "m2",
        "mistake": "Low back arching off the mat",
        "fix": "Gently flatten the low back before each curl; bend the knees if it will not stay down."
      },
      {
        "id": "m3",
        "mistake": "Heels lifting or legs tensing to help",
        "fix": "Let the legs stay relaxed and long on the mat."
      },
      {
        "id": "m4",
        "mistake": "Bouncing and rushing",
        "fix": "Control the lowering for about 1.5-2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk (T12 to C7) from the floor",
        "setup": "≈0°",
        "peak": "≈31° (upper back 9.9 cm off the mat; C7 up 17.2 cm)",
        "norm": "Head, shoulders and shoulder blades clear the mat; no study fixes the angle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈-4° (slight lordosis)",
        "peak": "≈-2° (+2°, low back stays on the mat)",
        "norm": "Small: about 3 degrees of lumbar flexion in a crunch, cited by Escamilla 2016 from earlier work",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈6° (resting curve)",
        "peak": "≈42° (+36°)",
        "norm": "Most of the curl happens here (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip and knee",
        "setup": "Hip ≈2°, knee ≈2° (legs long on the mat)",
        "peak": "Unchanged (heels 0.2-0.2 cm off the mat)",
        "norm": "Legs straight on the mat; the pelvis and legs do not move (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Neck",
        "setup": "≈-25° (head resting in the hands)",
        "peak": "≈30°",
        "norm": "Neck flexes with the trunk; hands do not pull (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.0 s up, 0.5 s squeeze, 1.6 s down, 1.1 s rest",
        "norm": "Controlled, about 1 s up and 1.5-2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
