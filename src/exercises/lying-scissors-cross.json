  "exercise": {
    "id": "lying-scissors-cross",
    "name": "Lying Scissors Cross",
    "aliases": [
      "Horizontal scissors",
      "Cross scissors",
      "Lying leg crossovers",
      "Scissor crossovers"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15532",
      "title": "Lying Scissors Cross",
      "url": "https://gymvisual.com/videos/15532-lying-scissors-cross-male.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Inner thighs",
      "Outer hips"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isometric trunk, dynamic hips",
    "plane": "Frontal",
    "laterality": "Bilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "glute_med_r",
        "glute_med_l"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Short, steady breaths; exhale as the legs cross.",
      "cadence": "About one breath per two crosses"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-20 crosses (count each cross)",
      "tempo": "About 0.8 s per open-and-cross",
      "frequency": "2-3 times a week",
      "progression": "Lower the legs, add crosses, then hold the hollow position with the shoulders up"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms by your sides. Lift both straight legs a little off the mat."
      },
      {
        "id": "c2",
        "phase": "scissor",
        "text": "Open the legs out to the sides."
      },
      {
        "id": "c3",
        "phase": "scissor",
        "text": "Cross the right leg over the left, open, then cross the left over the right."
      },
      {
        "id": "c4",
        "phase": "scissor",
        "text": "Keep the low back pressed down and the pelvis still."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Bring the legs together and lower them."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching",
        "fix": "Raise the legs higher."
      },
      {
        "id": "m2",
        "mistake": "Pelvis rocking side to side",
        "fix": "Smaller openings and crosses."
      },
      {
        "id": "m3",
        "mistake": "Legs bending",
        "fix": "Long legs, toes pointed."
      },
      {
        "id": "m4",
        "mistake": "Holding the breath",
        "fix": "Breathe out on each cross."
      }
    ],
    "kinematics": [
      {
        "measure": "Leg height",
        "setup": "Legs on the mat",
        "peak": "Legs ≈21° off the floor (hip ≈24°); heels 19 cm up",
        "norm": "Legs low but with the low back flat; higher is easier (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Opening and cross",
        "setup": "–",
        "peak": "Open ≈16° per leg (ankles 67 cm apart); cross ≈9° past the midline, ankles crossed by 5 cm, upper leg 19 cm higher",
        "norm": "Each leg opens to the side and crosses just past the midline, one leg passing over the other (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Still on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.6 s, lift 0.6 s",
        "peak": "0.4 s per open or cross (four crosses in 4 s), lower 0.8 s",
        "norm": "Brisk but controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15532, Lying Scissors Cross, video (movement reference; page not readable here)",
