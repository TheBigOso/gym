      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      },
      {
        "id": "drysdale2004",
        "title": "Drysdale, Earl and Hertel 2004, surface EMG of the abdominal muscles during pelvic-tilt and abdominal-hollowing exercises (J Athl Train 39(1):32-36)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC385259/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "If the low back arches off the mat, the legs are too low for your strength: raise them or bend the knees."
      ],
      "modify": [
        "Hands under the buttocks help keep the pelvis tilted and the low back down.",
        "Bend the knees a little to shorten the lever.",
        "Pregnancy, postpartum or diastasis recti: get cleared first, and avoid long supine work later in pregnancy."
      ],
      "regressions": [
        "Legs higher (toward vertical).",
        "Hands under the buttocks."
      ],
      "progressions": [
        "Lower legs.",
        "Shoulder blades lifted (hollow position)."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis and transversus abdominis keep the pelvis from tipping forward and the low back from arching while the legs move (Drysdale 2004: highest abdominal activity in pelvic-tilt work with the legs unsupported).",
      "hip_flexors_r": "Iliopsoas and rectus femoris hold the legs up against gravity (clinical opinion; hip flexor EMG rises with leg-lowering work, Andersson 1997).",
      "hip_flexors_l": "Iliopsoas and rectus femoris hold the legs up against gravity (clinical opinion; hip flexor EMG rises with leg-lowering work, Andersson 1997).",
      "adductors_r": "Draw each leg across the midline into the cross (clinical opinion).",
      "adductors_l": "Draw each leg across the midline into the cross (clinical opinion).",
      "glute_med_r": "Opens the legs back out to the sides between crosses (clinical opinion).",
      "glute_med_l": "Opens the legs back out to the sides between crosses (clinical opinion).",
      "obliques_r": "The obliques help keep the pelvis level and the ribs down as the legs move off the midline (clinical opinion).",
      "obliques_l": "The obliques help keep the pelvis level and the ribs down as the legs move off the midline (clinical opinion).",
      "quads_r": "Keep the knees straight and the legs long (clinical opinion).",
      "quads_l": "Keep the knees straight and the legs long (clinical opinion)."
    }
