      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Hamstrings",
      "Lower back"
    ],
    "equipment": [
      "Resistance band",
      "Squat rack upright (band anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip hinge)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core",
        "lats_r",
        "lats_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace as the hips go back, breathe out as you drive the hips forward to stand tall.",
      "cadence": "About 1.4 s down, 1 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 2-3 reps short of failure (clinical opinion)",
      "tempo": "1.4-0.3-1-0.5 (hinge-pause-drive-squeeze, seconds)",
      "rest": "45-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: step farther from the anchor for more tension",
      "progression": "Stronger band, a longer squeeze at the top, then a cable pull-through or a kettlebell swing"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing away from the anchor, band tied low behind you and running between the legs. Feet wider than the hips, toes slightly out, both hands on the band in front of the hips, arms long."
      },
      {
        "id": "c2",
        "phase": "hinge",
        "text": "Breathe in, soften the knees and push the hips back; let the band draw the hands back between the thighs. Flat back, long arms."
      },
      {
        "id": "c3",
        "phase": "pause",
        "text": "Stop when the hamstrings are stretched and the trunk is well inclined; back still flat."
      },
      {
        "id": "c4",
        "phase": "drive",
        "text": "Breathe out and drive the hips forward to stand tall; the arms just hang on to the band."
      },
      {
        "id": "c5",
        "phase": "squeeze",
        "text": "Squeeze the glutes at the top without leaning back."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Squatting down instead of hinging",
        "fix": "Hips go back, shins stay nearly vertical, knees only soft."
      },
      {
        "id": "m2",
        "mistake": "Pulling with the arms",
        "fix": "Arms are just hooks; the hips do the work."
      },
      {
        "id": "m3",
        "mistake": "Rounding the back at the bottom",
        "fix": "Shorten the range and keep the chest proud."
      },
      {
        "id": "m4",
        "mistake": "Leaning back or arching at the top",
        "fix": "Finish tall with the ribs down and the glutes squeezed."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈3° standing tall",
        "peak": "≈93° (joint channel), trunk ≈53° forward",
        "norm": "Hinge with a flat back to a hamstring stretch, as in other hip-hinge exercises (McAllister 2014 compared hinge exercises; clinical opinion for the band version)",
        "sources": [
          "mcallister2014"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈6°",
        "peak": "≈22°",
        "norm": "Soft knees, hinge-dominant (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hands",
        "setup": "In front of the hips, 77 cm high; band tied 22 cm up an upright 95 cm behind the heels",
        "peak": "Drawn back between the thighs, -8 cm from the ankles (forward +), 48 cm high",
        "norm": "Arms long, hands travel back between the thighs and return to the front of the hips (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance",
        "setup": "Ankles 52 cm apart, toes out",
        "peak": "Unchanged",
        "norm": "Wider than the hips so the band runs between the legs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.6 s",
        "peak": "1.4 s down, 0.3 s pause, 1 s up, 0.5 s squeeze",
        "norm": "Controlled hinge, forceful hip drive (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band pull through, video (movement reference)",
        "url": "https://gymvisual.com/videos/9055-band-pull-through.html"
      },
      {
        "id": "mcallister2014",
        "title": "McAllister, Hammond, Schilling, Ferreria, Reed & Weiss 2014, muscle activation during various hamstring exercises (J Strength Cond Res 28(6):1573-1580)",
        "url": "https://digitalcommons.memphis.edu/facpubs/9934"
      },
      {
        "id": "mcgill2012",
        "title": "McGill & Marshall 2012, kettlebell swing, snatch, and bottoms-up carry: back and hip muscle activation, motion, and low back loads (J Strength Cond Res)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21997449/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Check the band and the anchor before each set: a band that slips or snaps can whip forward between the legs.",
        "Keep the back flat; stop the hinge before the low back rounds.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low back discomfort: shorter range, more knee bend.",
        "Hamstring tightness: hinge only as far as the back stays flat."
      ],
      "regressions": [
        "Lighter band or stand closer to the anchor.",
        "Hip hinge with a dowel along the back.",
        "Glute bridge."
      ],
      "progressions": [
        "Stronger band.",
        "Pause 2 s at the bottom.",
        "Cable pull-through or kettlebell swing."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Prime mover: hip extension from the hinge to standing tall, hardest near lockout where the band is most stretched (clinical opinion).",
      "glute_max_l": "Prime mover: hip extension from the hinge to standing tall (clinical opinion).",
      "hamstrings_r": "Extend the hip with the glutes and lengthen at the bottom of the hinge (hinge exercises load the hamstrings, McAllister 2014).",
      "hamstrings_l": "Extend the hip with the glutes and lengthen at the bottom of the hinge (McAllister 2014).",
      "adductors_r": "Adductor magnus helps extend the hip in the wide stance (clinical opinion).",
      "adductors_l": "Adductor magnus helps extend the hip in the wide stance (clinical opinion).",
      "spinal_extensors_r": "Hold the back flat through the hinge (clinical opinion; back extensors work isometrically in hinge patterns, McGill 2012).",
      "spinal_extensors_l": "Hold the back flat through the hinge (clinical opinion).",
      "core": "Brace so the ribs stay down at lockout (clinical opinion).",
      "lats_r": "Keep the arms close to the body (clinical opinion).",
      "lats_l": "Keep the arms close to the body (clinical opinion).",
      "forearm_flexors_r": "Grip the band (clinical opinion).",
      "forearm_flexors_l": "Grip the band (clinical opinion)."
    }
