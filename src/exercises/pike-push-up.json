        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the head lowers toward the floor, exhale as you press back up.",
      "cadence": "About 1.9 s down, 0.3 s pause, 1.1 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "5-12 (stop 1-2 reps before form breaks)",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, then feet on a box or bench (elevated pike), then wall handstand push-up work"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Start in a downward V: hands shoulder width, hips high, legs straight, on the balls of the feet; head between the arms."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows back toward the feet, lowering the top of the head toward the floor a little in front of the hands."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Head just above the floor, hips still high: hands and head form a triangle."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the floor away until the arms are straight, pushing the hips back up."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hips high and the heels reaching back, then go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips dropping into a regular push-up",
        "fix": "Keep the hips stacked high over the shoulders; the movement is a vertical press."
      },
      {
        "id": "m2",
        "mistake": "Head going straight down between the hands",
        "fix": "Lower the head slightly in front of the hands so head and hands form a triangle; the forearms stay near vertical."
      },
      {
        "id": "m3",
        "mistake": "Elbows flaring straight out to the sides",
        "fix": "Let the elbows bend back toward the feet at about 45 degrees."
      },
      {
        "id": "m4",
        "mistake": "Bending the knees to reach the position",
        "fix": "Walk the feet a little further back or allow a small bend only if the hamstrings are tight."
      },
      {
        "id": "m5",
        "mistake": "Dropping fast onto the head",
        "fix": "Lower slowly and stop with the head just above the floor."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip angle (trunk to legs)",
        "setup": "≈87° between trunk and legs",
        "peak": "≈95° at the bottom (hips stay high)",
        "norm": "Hips flexed so the body forms an inverted V, about 70-100 degrees between trunk and legs (clinical opinion; no measured norm found)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈16° on the drawn arm (straight; the rig elbow channel reads ≈75° because the skinned arm is shorter)",
        "peak": "≈96° drawn (≈121° rig) at the bottom",
        "norm": "Arms straight but not locked at the top; elbows bend to about 90 degrees or more at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk angle",
        "setup": "Trunk ≈40° below horizontal (head down)",
        "peak": "≈45° at the bottom",
        "norm": "Trunk steep (about 45-70 degrees from horizontal) so the press is close to vertical, like an overhead press (clinical opinion; Saeterbakken 2013 for vertical-press muscle activity)",
        "sources": [
          "saeterbakken2013"
        ]
      },
      {
        "measure": "Head position at the bottom",
        "setup": "Head between the arms",
        "peak": "Lowest head point 4.9 cm above the floor, 10 cm in front of the wrists",
        "norm": "Top of the head a few cm above the floor, slightly in front of the hands (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hand width",
        "setup": "Wrists 42 cm apart (shoulder joints 37 cm); feet 18 cm apart, balls 92 cm behind the hands",
        "peak": "Unchanged (hands and feet planted)",
        "norm": "About shoulder width (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.9 s down, 0.3 s pause, 1.1 s up, 0.9 s at the top",
        "norm": "Controlled: about 2 s down and 1 s up (clinical opinion; lab push-up studies used 2-2.5 s per repetition, Marcolin 2015)",
        "sources": [
          "marcolin2015"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #292112, Pike Push-up, video (movement reference)",
        "url": "https://gymvisual.com/videos/7846-pike-push-up.html"
      },
      {
        "id": "saeterbakken2013",
        "title": "Saeterbakken and Fimland 2013, effects of body position and loading modality on muscle activity and strength in shoulder presses (J Strength Cond Res 27(7):1824-1831; a vertical-press study, not a pike push-up study)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23096062/"
      },
      {
        "id": "marcolin2015",
        "title": "Marcolin, Petrone, Moro, Battaglia, Bianco and Paoli 2015, selective activation of shoulder, trunk and arm muscles: a comparative analysis of different push-up variants (J Athl Train 50(11):1126-1132)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26488636/"
      }
    ],
    "safety": {
      "cautions": [
        "Wrist pain: the planted palm bends the wrist back about 80-90 degrees; use push-up handles or hex dumbbells to keep the wrists straight, or stop if pain persists (clinical opinion).",
        "Shoulder pain: keep the elbows tucked rather than flared out to the sides, and shorten the range if needed (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Neck: never let the head take weight on the floor; stop a few cm above it.",
        "Avoid with uncontrolled high blood pressure or glaucoma (head-down position) unless cleared by a clinician."
      ],
      "modify": [
        "Tight hamstrings: bend the knees slightly or widen the feet.",
        "Too hard: put the hands on a low step (smaller head-down angle) or do a seated dumbbell press."
      ],
      "regressions": [
        "Hands-elevated pike push-up.",
        "Downward-dog hold.",
        "Seated dumbbell shoulder press."
      ],
      "progressions": [
        "Feet-elevated pike push-up (feet on a bench).",
        "Deficit pike push-up (hands on blocks).",
        "Wall handstand push-up."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover: with the hips high the push is close to vertical, so the front of the shoulder does most of the pressing, as in an overhead press (clinical opinion; Saeterbakken 2013 measured high anterior deltoid activity in shoulder presses).",
      "ant_deltoid_l": "Main mover: with the hips high the push is close to vertical, so the front of the shoulder does most of the pressing, as in an overhead press (clinical opinion; Saeterbakken 2013 measured high anterior deltoid activity in shoulder presses).",
      "triceps_r": "Straightens the elbows from the bottom position.",
      "triceps_l": "Straightens the elbows from the bottom position.",
      "lat_deltoid_r": "Helps press with the arms overhead and keeps the elbows from collapsing inward.",
      "lat_deltoid_l": "Helps press with the arms overhead and keeps the elbows from collapsing inward.",
      "pec_r": "Upper (clavicular) fibres assist the shoulder flexion; less than in a flat push-up because the trunk is steep (clinical opinion).",
      "pec_l": "Upper (clavicular) fibres assist the shoulder flexion; less than in a flat push-up because the trunk is steep (clinical opinion).",
      "upper_traps_r": "Rotate the shoulder blades upward with the arms overhead.",
      "upper_traps_l": "Rotate the shoulder blades upward with the arms overhead.",
      "serratus_r": "Rotates the shoulder blades upward and holds them on the rib cage.",
      "serratus_l": "Rotates the shoulder blades upward and holds them on the rib cage.",
      "core": "Holds the hips high and the spine long.",
      "infraspinatus_r": "Centres the head of the upper arm under load overhead.",
      "infraspinatus_l": "Centres the head of the upper arm under load overhead.",
      "quads_r": "Keep the knees straight.",
      "quads_l": "Keep the knees straight.",
      "hamstrings_r": "Lengthen to let the hips stay high; tight hamstrings make the knees bend.",
      "hamstrings_l": "Lengthen to let the hips stay high; tight hamstrings make the knees bend."
    }
  },
