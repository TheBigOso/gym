        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl and sit up, inhale as you lower under control.",
      "cadence": "About 1.6 s up, a short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-12 per side",
      "tempo": "About 1.5 s up, brief pause, 2 s down; no jerking with the arms",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering, then a pause at the knee, then a light plate on the chest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent about 90 degrees, feet flat and anchored. Fingertips lightly behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "upA",
        "text": "Breathe out, curl up and sit up, turning the trunk so the right elbow meets the left knee."
      },
      {
        "id": "c3",
        "phase": "downA",
        "text": "Breathe in and roll back down: low back first, head last."
      },
      {
        "id": "c4",
        "phase": "upB",
        "text": "Sit up again, turning the other way: left elbow to the right knee."
      },
      {
        "id": "c5",
        "phase": "downB",
        "text": "Roll down under control and keep alternating."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Yanking the head with the hands to reach the knee",
        "fix": "Fingertips only; turn the shoulder, not the neck."
      },
      {
        "id": "m2",
        "mistake": "Twisting only at the top with a flat back",
        "fix": "Curl first, then turn as you rise."
      },
      {
        "id": "m3",
        "mistake": "Dropping back to the floor",
        "fix": "Lower for about 2 s, one vertebra at a time."
      },
      {
        "id": "m4",
        "mistake": "Feet lifting or knees falling open",
        "fix": "Anchor the feet and keep the knees hip width."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk (pelvis to C7) from the floor",
        "setup": "Lying (shoulder blades on the mat)",
        "peak": "≈71° from the floor",
        "norm": "From lying to sitting most of the way up (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk rotation",
        "setup": "Facing the ceiling",
        "peak": "≈47° toward the opposite knee (mostly thoracic); elbow 3.8 cm from the knee at the closest",
        "norm": "Turn toward the opposite knee, mostly thoracic (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Spinal flexion",
        "setup": "≈3° (resting curve)",
        "peak": "≈80° (rounded)",
        "norm": "Rounded through the rise (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈44°",
        "peak": "≈87° (pelvis rolled toward the thighs)",
        "norm": "Most of the second half of the rise is hip flexion (Andersson 1997)",
        "sources": [
          "andersson1997"
        ]
      },
      {
        "measure": "Knee",
        "setup": "≈88°",
        "peak": "≈88°, feet unchanged",
        "norm": "About 90 degrees, feet anchored and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.5 s",
        "peak": "1.5 s up and turn, 0.4 s pause, 2 s roll down per side; 8.8 s loop",
        "norm": "Controlled, about 1.5 s up and 2 s down (clinical opinion)",
        "sources": []
