      "Body weight",
      "Exercise mat (optional)",
      "Foot anchor (partner, strap or a fixed support)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk flexion, then hip flexion)",
    "plane": "Multiplanar",
    "laterality": "Bilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "obliques_r",
        "obliques_l",
        "hip_flexors_r",
