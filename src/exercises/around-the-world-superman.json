{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "around-the-world-superman",
    "name": "Around the World Superman",
    "aliases": [
      "Superman arm sweeps",
      "Prone swimmer sweeps",
      "Superman around the world"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "20136",
      "title": "Around the World Superman",
      "url": "https://gymvisual.com/videos/20136-around-the-world-superman-male.html",
      "listing": "Video (movement reference; page could not be read at authoring time, movement taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (spinal extensors)",
    "secondaryBodyParts": [
      "Shoulders (rear and middle deltoids)",
      "Upper back",
      "Hips (glutes)"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (held spine and hip extension with a wide shoulder arc)",
    "plane": "Multiplanar",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "lat_deltoid_r",
        "lat_deltoid_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "stabilizer": [
        "hamstrings_r",
        "hamstrings_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "lats_r",
        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale to lift, breathe steadily through the sweeps.",
      "cadence": "About 1.5 s per half circle"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "5-8 circles",
      "tempo": "Slow sweeps, about 3 s per circle",
      "frequency": "2-3 times a week",
      "progression": "More circles per set, then light plates or small dumbbells in the hands"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down, arms straight overhead, legs long, forehead toward the mat."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Lift the arms, chest and legs a few centimetres; neck long."
      },
      {
        "id": "c3",
        "phase": "sweepOut",
        "text": "Sweep the straight arms out wide and down toward the hips, hands just off the mat."
      },
      {
        "id": "c4",
        "phase": "sweepBack",
        "text": "Sweep them back out and overhead, staying lifted."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Lower everything to the mat and rest."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Cranking the head up",
        "fix": "Keep the eyes on the mat a little ahead."
      },
      {
        "id": "m2",
        "mistake": "Arms dragging on the floor",
        "fix": "Keep the hands just off the mat; make the arc smaller if needed."
      },
      {
        "id": "m3",
        "mistake": "Bending the elbows",
        "fix": "Arms long through the whole arc."
      },
      {
        "id": "m4",
        "mistake": "Over-arching the low back",
        "fix": "Lift only a few centimetres; squeeze the glutes."
      }
    ],
    "kinematics": [
      {
        "measure": "Chest lift",
        "setup": "Chest on the mat (0 cm)",
        "peak": "4 cm off the mat",
        "norm": "A few centimetres off the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Spine extension",
        "setup": "0°",
        "peak": "≈20° (sum of segments)",
        "norm": "Small held extension (clinical opinion; Kim 2014 for prone paraspinal work)",
        "sources": [
          "kim2014"
        ]
      },
      {
        "measure": "Shoulder arc",
        "setup": "Arms overhead resting on the mat",
        "peak": "Overhead (elev ≈147°) to the side (plane ≈11°, elev ≈80°) to beside the hips (elev ≈25°); hands at least 5 cm off the mat",
        "norm": "Arms sweep from overhead to beside the hips (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension",
        "setup": "≈-3°",
        "peak": "≈12°",
        "norm": "Legs lifted a few degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s relaxed",
        "peak": "0.7 s up, 1.5 s to the hips, 1.5 s back overhead, 0.5 s hold, 0.7 s down",
        "norm": "About 3 s per circle (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #20136, Around the World Superman, video (movement reference)",
        "url": "https://gymvisual.com/videos/20136-around-the-world-superman-male.html"
      },
      {
        "id": "kim2014",
        "title": "Kim et al. 2014, selective activation of lumbar paraspinal muscles during exercises in the prone position (J Phys Ther Sci 26(8):1223-1224)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4155224/"
      },
      {
        "id": "callaghan1998",
        "title": "Callaghan, Gunning and McGill 1998, the relationship between lumbar spine load and muscle activity during extensor exercises (Phys Ther 78(1):8-18)",
        "url": "https://doi.org/10.1093/ptj/78.1.8"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Prone extension raises lumbar compression (Callaghan 1998); keep the lift small with a sore back.",
        "Shoulder pain overhead: shorten the arc to the side position."
      ],
      "modify": [
        "Legs stay on the mat.",
        "Smaller arc."
      ],
      "regressions": [
        "Superman.",
        "Prone Y raises."
      ],
      "progressions": [
        "Light weights in the hands.",
        "Longer sets."
      ]
    },
    "muscleNotes": {
      "spinal_extensors_r": "Erector spinae and multifidus hold the chest up through the set (Kim 2014; Callaghan 1998).",
      "spinal_extensors_l": "Same on the left.",
      "post_deltoid_r": "Sweeps the arm back toward the hip in the low part of the arc.",
      "post_deltoid_l": "Same on the left.",
      "lat_deltoid_r": "Carries the arm at shoulder height through the side of the arc.",
      "lat_deltoid_l": "Same on the left.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades as the arms pass the sides (clinical opinion).",
      "rhomboids_midtrap_l": "Same on the left.",
      "glute_max_r": "Lift and hold the legs.",
      "glute_max_l": "Lift and hold the legs.",
      "hamstrings_r": "Help hold the legs up.",
      "hamstrings_l": "Help hold the legs up.",
      "infraspinatus_r": "Rotate the arm through the arc.",
      "infraspinatus_l": "Rotate the arm through the arc.",
      "lats_r": "Bring the arms down to the hips.",
      "lats_l": "Bring the arms down to the hips."
    }
  },
