    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press up.",
      "cadence": "About 1.8 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "6-20 (stop 1-2 reps before form breaks)",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, then slower lowering, then feet elevated or a weighted vest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "High plank: hands a little wider than the shoulders, palms flat, fingers forward, on the balls of the feet, body in one line."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows back at about 45 degrees, lowering the whole body as one piece."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Chest a few centimetres above the floor, elbows tucked, hips level with the shoulders."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and push the floor away until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "At the top, spread the shoulder blades slightly, keep bracing, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging (lower back arching)",
        "fix": "Brace the abs and squeeze the glutes so the body stays one straight line from head to heels."
      },
      {
        "id": "m2",
        "mistake": "Hips piking up",
        "fix": "Lower the hips into line with the shoulders and ankles."
      },
      {
        "id": "m3",
        "mistake": "Elbows flared straight out to the sides (a \"T\")",
        "fix": "Tuck the elbows to about 30-45 degrees from the body, pointing back toward the hips."
      },
      {
        "id": "m4",
        "mistake": "Head dropping or chin poking forward",
        "fix": "Keep the neck long; look at the floor a little ahead of the hands."
      },
      {
        "id": "m5",
        "mistake": "Half reps",
        "fix": "Lower until the chest is close to the floor (or the edge), then press to straight arms."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈7° (straight, not locked)",
        "peak": "≈130° at the bottom (chest 11 cm above the floor, shoulder joint 23 cm)",
        "norm": "Arms straight but not locked at the top. Many lab protocols standardise the bottom at 90 degrees of elbow flexion (Zhang 2023); lowering the chest to a few cm from the floor takes the elbows further (clinical opinion)",
        "sources": [
          "zhang2023"
        ]
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "≈17° (arms near vertical)",
        "peak": "≈28°",
        "norm": "About 30-45 degrees from the body at the bottom (clinical opinion; no measured norm found)",
        "sources": []
      },
      {
        "measure": "Hand width",
        "setup": "Wrists 50 cm apart (shoulder joints 40 cm): about 124% of shoulder width",
        "peak": "Unchanged (hands planted)",
        "norm": "Shoulder width (100% of the acromion distance) or a little wider; 150% raised serratus and lowered pectoralis and triceps activity versus 100% (Kim 2016)",
        "sources": [
          "kim2016",
          "marcolin2015"
        ]
      },
      {
        "measure": "Body line",
        "setup": "Trunk ≈23° above horizontal; trunk-to-leg bend -0.0°",
        "peak": "Trunk ≈9° above horizontal; bend -0.1°",
        "norm": "Head, trunk, hips and ankles in one straight line throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Wrist extension",
        "setup": "≈86°",
        "peak": "≈46° at the bottom",
        "norm": "Palms flat; the wrist is bent back about 90 degrees with the forearm vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Load on the hands",
        "setup": "About 64% of body mass (measured, Wurm et al.)",
        "peak": "–",
        "norm": "Peak hand force about 64% of body mass for a floor push-up, 55% with hands on a 30 cm box and 41% on a 61 cm box (Wurm et al., Ebben lab)",
        "sources": [
          "wurm2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up; lab studies used 2-2.5 s per repetition (Wurm et al.; Marcolin 2015)",
        "sources": [
          "wurm2010",
          "marcolin2015"
        ]
      }
    ],
    "sources": [
