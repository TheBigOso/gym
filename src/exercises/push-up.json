    ],
    "safety": {
      "cautions": [
        "Wrist pain: the top of a push-up needs about 90 degrees of wrist extension; use push-up handles, fists or a raised surface, or stop if pain persists.",
        "Shoulder pain: keep the elbows tucked (about 30-45 degrees from the body) rather than flared out to the sides, and shorten the range if needed (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrist pain: hold push-up handles or dumbbells so the wrists stay straight.",
        "Too hard to keep the body straight: put the hands on a bench (incline push-up) or drop to the knees."
      ],
      "regressions": [
        "Incline push-up (hands on a bench or box).",
        "Knee push-up.",
        "Wall push-up."
      ],
      "progressions": [
        "Feet-elevated push-up.",
        "Weighted vest or band push-up.",
        "Push-up plus (extra shoulder-blade spread at the top)."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher: lowers the body under control and drives it back up. Activity was higher with hands at or inside shoulder width than with hands at 150% of shoulder width (Kim 2016).",
      "pec_l": "Main pusher: lowers the body under control and drives it back up. Activity was higher with hands at or inside shoulder width than with hands at 150% of shoulder width (Kim 2016).",
      "triceps_r": "Straightens the elbows on the way up and brakes the elbows on the way down; more active with narrower hands (Kim 2016; Marcolin 2015).",
      "triceps_l": "Straightens the elbows on the way up and brakes the elbows on the way down; more active with narrower hands (Kim 2016; Marcolin 2015).",
      "ant_deltoid_r": "Flexes the shoulder with the chest muscles; hand width made little difference to it (Kim 2016; Marcolin 2015).",
      "ant_deltoid_l": "Flexes the shoulder with the chest muscles; hand width made little difference to it (Kim 2016; Marcolin 2015).",
      "serratus_r": "Holds the shoulder blades on the rib cage and spreads them at the top; the push-up plus gave the highest serratus activity of the push-up variants tested (Ludewig 2004), and it was higher with wider hands (Kim 2016).",
      "serratus_l": "Holds the shoulder blades on the rib cage and spreads them at the top; the push-up plus gave the highest serratus activity of the push-up variants tested (Ludewig 2004), and it was higher with wider hands (Kim 2016).",
      "core": "Bracing keeps the hips from sagging or piking: the body moves as one plank.",
      "obliques_r": "Help hold the trunk rigid and level.",
      "obliques_l": "Help hold the trunk rigid and level.",
      "rhomboids_midtrap_r": "Control the shoulder blades as they draw together on the way down.",
      "rhomboids_midtrap_l": "Control the shoulder blades as they draw together on the way down.",
      "infraspinatus_r": "Keeps the head of the upper arm centred as the elbows bend.",
      "infraspinatus_l": "Keeps the head of the upper arm centred as the elbows bend.",
      "glute_max_r": "Squeezed lightly to keep the pelvis in line (no sag).",
      "glute_max_l": "Squeezed lightly to keep the pelvis in line (no sag).",
      "quads_r": "Keep the knees straight so the legs stay part of the plank.",
      "quads_l": "Keep the knees straight so the legs stay part of the plank.",
      "spinal_extensors_r": "Hold a long, neutral spine and neck.",
      "spinal_extensors_l": "Hold a long, neutral spine and neck."
    }
  },
