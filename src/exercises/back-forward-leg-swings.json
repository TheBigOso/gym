{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "back-forward-leg-swings",
    "name": "Back Forward Leg Swings",
    "aliases": [
      "Front-to-back leg swings",
      "Forward and backward leg swings",
      "Pendulum leg swings"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "12544",
      "title": "Back Forward Leg Swings (male)",
      "url": "https://gymvisual.com/videos/12544-back-forward-leg-swings-male.html",
      "listing": "GymVisual page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching knowledge",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Mobility / activation (dynamic warm-up)",
    "bodyPart": "Hips",
    "secondaryBodyParts": [
      "Thighs (hamstrings, quadriceps)",
      "Core (balance)"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Dynamic hip flexion and extension on one leg",
    "plane": "Sagittal",
    "laterality": "Unilateral (swing the other leg after the set)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "glute_max_r"
      ],
      "synergist": [
        "quads_r",
        "hamstrings_r",
        "core"
      ],
      "stabilizer": [
        "glute_med_l",
        "calves_l",
        "quads_l",
        "obliques_r",
        "obliques_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hip_flexors_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe naturally with the rhythm of the swing.",
      "cadence": "About 1.6 s per full swing"
    },
    "prescription": {
      "sets": "1-2",
      "reps": "10-15 swings per leg",
      "tempo": "Rhythmic, about 1.5 s per swing; let the range grow gradually",
      "frequency": "As a warm-up before running, jumping or lower-body training",
      "progression": "Larger range as the hips warm up; then without a hand support"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall on the left leg, hands on the hips (or one hand on a wall for balance), right leg relaxed."
      },
      {
        "id": "c2",
        "phase": "swing",
        "text": "Swing the straight right leg forward and up, then back behind you like a pendulum; the trunk stays tall and the standing knee soft."
      },
      {
        "id": "c3",
        "phase": "settle",
        "text": "Let the swing die down and bring the foot back beside the left."
      },
      {
        "id": "c4",
        "phase": "reset",
        "text": "Swap legs after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning the trunk back on the forward swing or forward on the back swing",
        "fix": "Stay tall; let the range come from the hip."
      },
      {
        "id": "m2",
        "mistake": "Kicking hard at the end range",
        "fix": "Smooth pendulum swings; build the range gradually."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back on the back swing",
        "fix": "Ribs down, squeeze the glute, keep the back swing small."
      },
      {
        "id": "m4",
        "mistake": "Locking the standing knee",
        "fix": "Keep a soft standing knee."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion (forward swing)",
        "setup": "≈3°",
        "peak": "≈66° on the third swing (thigh ≈72° forward of vertical)",
        "norm": "Progressively higher, about 60-80 degrees once warm (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension (back swing)",
        "setup": "Neutral",
        "peak": "≈13° (rig limit 20°), thigh ≈18° behind vertical with the pelvis tip",
        "norm": "About 10-20 degrees; past that the low back arches (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "Standing knee ≈5°",
        "peak": "Swinging knee ≈6-35° (bends a little as the foot passes under the hip)",
        "norm": "Swinging leg nearly straight; standing knee soft (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Tall",
        "peak": "Within ≈9° of vertical",
        "norm": "Tall, small lean only (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "Three swings of about 1.6 s, building the range",
        "norm": "About 1.5 s per full swing (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #12544, Back Forward Leg Swings (male), video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/12544-back-forward-leg-swings-male.html"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp pain in the hip, groin or back of the thigh.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "A dynamic warm-up: build the range gradually rather than kicking to the limit.",
        "Balance problems: hold a wall or a rack upright with one hand."
      ],
      "modify": [
        "Smaller swings.",
        "One hand on a wall or a sturdy support."
      ],
      "regressions": [
        "Standing knee raises and standing hip extensions, done slowly."
      ],
      "progressions": [
        "Larger range.",
        "Side-to-side leg swings."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas and rectus femoris drive the forward swing; they are stretched at the end of the back swing (clinical opinion).",
      "glute_max_r": "Gluteus maximus and hamstrings drive the back swing and brake the forward swing (clinical opinion).",
      "glute_med_l": "Standing-side gluteus medius keeps the pelvis level on one leg (clinical opinion).",
      "core": "Abdominals stop the low back arching on the back swing (clinical opinion; McGill 1998 on keeping the spine neutral)."
    }
  },
