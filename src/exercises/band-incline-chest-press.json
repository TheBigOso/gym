    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a heavy bench frame or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is lightest at the start and heaviest at the end of the push; let it return under control rather than snapping back.",
        "Shoulder pain: shorten the range at the chest (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: palms facing each other and the elbows a little more tucked.",
        "Balance: widen the staggered stance."
      ],
      "regressions": [
        "Lighter band or step closer to the anchor.",
        "Incline push-up."
      ],
      "progressions": [
        "Stronger band or step farther from the anchor.",
        "Slower 3 s return with a pause at the chest.",
        "Band incline bench press or incline dumbbell press."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher, with a shift toward the upper (clavicular) fibres: a 30-degree incline gave the highest upper-pectoralis activity, while the middle and lower fibres fell as the bench was raised (Rodríguez-Ridao 2020, barbell); Lauver 2016 also recommends a 30-degree incline for the pectoralis major.",
      "pec_l": "Main pusher, with a shift toward the upper (clavicular) fibres: a 30-degree incline gave the highest upper-pectoralis activity, while the middle and lower fibres fell as the bench was raised (Rodríguez-Ridao 2020, barbell); Lauver 2016 also recommends a 30-degree incline for the pectoralis major.",
      "ant_deltoid_r": "Works harder as the bench rises: at 30 degrees it was about as active as the upper chest, and it became the most active muscle at 45 and 60 degrees (Rodríguez-Ridao 2020).",
      "ant_deltoid_l": "Works harder as the bench rises: at 30 degrees it was about as active as the upper chest, and it became the most active muscle at 45 and 60 degrees (Rodríguez-Ridao 2020).",
      "triceps_r": "Straightens the elbows; triceps activity did not change with bench angle (Rodríguez-Ridao 2020) and is lower with dumbbells than with a barbell (Saeterbakken 2011).",
      "triceps_l": "Straightens the elbows; triceps activity did not change with bench angle (Rodríguez-Ridao 2020) and is lower with dumbbells than with a barbell (Saeterbakken 2011).",
      "serratus_r": "Holds the shoulder blades against the rib cage while each arm moves on its own.",
      "serratus_l": "Holds the shoulder blades against the rib cage while each arm moves on its own.",
      "biceps_r": "Works as a stabiliser: biceps activity rose with the stability demand, highest with dumbbells (Saeterbakken 2011).",
      "biceps_l": "Works as a stabiliser: biceps activity rose with the stability demand, highest with dumbbells (Saeterbakken 2011).",
      "forearm_flexors_r": "Grip the band handle.",
      "forearm_flexors_l": "Grip the band handle.",
      "infraspinatus_r": "Rotator cuff: centres the head of the upper arm while the band handles move freely (clinical opinion).",
      "infraspinatus_l": "Rotator cuff: centres the head of the upper arm while the band handles move freely (clinical opinion).",
      "rhomboids_midtrap_r": "Keep the shoulder blades drawn back and down on the bench.",
      "rhomboids_midtrap_l": "Keep the shoulder blades drawn back and down on the bench.",
      "core": "Keeps the trunk upright so the band does not pull it back or arch the low back (clinical opinion)."
    }
  },
