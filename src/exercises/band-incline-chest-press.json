    "breathing": {
      "pattern": "Breathe out as you press forward and up, breathe in as the band draws the hands back.",
      "cadence": "About 1 s press, short hold, about 2 s back"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-15",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; stand or sit farther from the anchor, or choke up on the band, for more tension.",
      "progression": "More reps, a slower return, more distance from the anchor (more stretch), then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop a band around each upright of a rack behind you, a little below shoulder height. Staggered stance, knees soft, ribs down; a handle in each hand beside the chest, palms down, elbows back and out about 45-60 degrees."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press forward and up, about 30 degrees above horizontal, until the arms are nearly straight."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hands about forehead height in front, shoulders down; do not let the band pull the trunk back."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the hands come back to the chest slowly along the same line."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause at the chest with the band still taut, then press again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back or arching the low back as the band tightens",
        "fix": "Ribs down, glutes lightly braced, weight over the front foot; use a lighter band."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders up toward the ears at the top",
        "fix": "Reach forward and up but keep the shoulders down."
      },
      {
        "id": "m3",
        "mistake": "Elbows flared straight out at 90 degrees",
        "fix": "Keep the elbows about 45-60 degrees from the body."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the hands back",
        "fix": "Return for about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Press angle",
        "setup": "Hands beside the chest, -14.7 cm from shoulder height",
        "peak": "Hands travel ≈32° above horizontal to 10.6 cm above the shoulders",
        "norm": "Hands travel forward and up about 30 degrees above horizontal, the angle of a 30-degree incline press, which gave the highest upper-pectoralis activity on the bench (Rodríguez-Ridao 2020, barbell; clinical opinion for the standing band version)",
        "sources": [
          "rodriguez2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈135° at the chest",
        "peak": "≈11° (nearly straight)",
        "norm": "About 90-110 degrees at the chest to nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare",
        "setup": "Upper arm ≈26° out from the side (front view)",
        "peak": "Arms reach forward and up",
        "norm": "About 45-60 degrees from the body at the chest, not a 90-degree \"T\" (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped around the rack uprights 50 cm behind, 118 cm up, 150 cm apart; strands 86 cm",
        "peak": "Strands 129.4 cm at the top; at least 4.7 cm from the body",
        "norm": "Anchored behind, a little below the shoulders, so it resists the forward-and-up press; tension is highest at the top. Elastic resistance can give muscle activity comparable to free weights (Andersen 2010; Calatayud 2015, band push-ups vs bench press)",
        "sources": [
          "andersen2010",
          "calatayud2015"
        ]
      },
      {
        "measure": "Stance",
        "setup": "Staggered: right foot 24 cm forward, left 22 cm back, knees soft",
        "peak": "Unchanged (trunk still)",
        "norm": "Staggered stance, knees soft, so the band does not pull you backward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the chest",
        "peak": "1.1 s press, 0.4 s hold, 1.8 s return",
        "norm": "Controlled, about 1 s press and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
