    "muscleNotes": {
      "core": "Rectus abdominis is the main mover: about 40% MVIC (upper rectus) in a bent-knee sit-up vs 53% in a crunch (Escamilla 2016). Curls the ribs toward the pelvis and then holds the trunk curled. Transversus abdominis braces (clinical opinion).",
      "obliques_r": "External and internal obliques help flex the trunk (about 36% and 31% MVIC in a bent-knee sit-up, Escamilla 2016).",
      "obliques_l": "Same as the right side; the movement is symmetric.",
      "hip_flexors_r": "Iliopsoas lifts the curled trunk toward the thighs in the upper part of the rep. All sit-up forms used more psoas than a curl-up (about 15-35% vs about 10% MVC, Juker 1998). Bent knees do not switch it off (McGill 1998).",
      "hip_flexors_l": "Same as the right side.",
      "quads_r": "Rectus femoris assists hip flexion (about 23% MVIC in a bent-knee sit-up vs 6% in a crunch, Escamilla 2016).",
      "quads_l": "Same as the right side.",
      "spinal_extensors_r": "Stay quiet (about 5-8% MVIC) and lengthen as the spine curls; they control the lowering only lightly.",
      "spinal_extensors_l": "Same as the right side."
    },
    "breathing": {
      "pattern": "Exhale through the mouth as you curl up; inhale as you lower under control. Keep breathing at the top; do not hold the breath.",
      "cadence": "About 2 s up, a brief pause, about 2.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-15 (untrained: about 2 x 15 or fewer)",
      "tempo": "About 2 s up, brief pause, about 2-2.5 s down; no bouncing",
      "sessionCap": "About 60 spinal-flexion reps per session across all flexion exercises (expert opinion)",
      "frequency": "48 hours or more between dynamic flexion sessions",
      "timing": "Avoid in the first hour after waking; walk a few minutes after long sitting first",
      "progression": "Crunch / curl-up, then 3/4 sit-up, then full sit-up or added load"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent about 90 degrees, feet flat and hip-width. Fingertips lightly behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Brace lightly and breathe out: chin slightly tucked, curl the head and shoulders up first."
      },
      {
        "id": "c3",
        "phase": "rise",
        "text": "Keep peeling the spine up, ribs toward the hips, until the trunk is about three-quarters of the way up (about 60-70 degrees). Feet stay down."
      },
      {
        "id": "c4",
        "phase": "hold",
        "text": "Pause briefly short of vertical. Elbows stay wide; the hands only cradle the head."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Breathe in and lower slowly: low back to the mat first, then the upper back, head last."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Reset briefly between reps; no bouncing off the floor."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling on the head with the hands (neck strain)",
        "fix": "Fingertips only, elbows wide; or cross the arms on the chest."
      },
      {
        "id": "m2",
        "mistake": "Jerking up with momentum, then flopping down",
        "fix": "About 2 s up and a controlled lowering; reduce the range or regress to a crunch if needed."
      },
      {
        "id": "m3",
        "mistake": "Feet lifting or sliding",
        "fix": "Reduce the range; regress rather than anchor the feet. Anchoring lets the hip flexors pull harder."
      },
      {
        "id": "m4",
        "mistake": "Heaving up with a flat, stiff back (hip flexors doing the lift)",
        "fix": "Curl the head and shoulders first and stop at the 3/4 point. Hip flexion without trunk curl is cited as the main shear risk."
      },
      {
        "id": "m5",
        "mistake": "Going all the way to vertical or past it",
        "fix": "Stop at about 60-70 degrees; the top of the rep adds hip-flexor work and spine load without extra abdominal benefit."
      },
      {
        "id": "m6",
        "mistake": "Holding the breath",
        "fix": "Exhale on the way up, inhale on the way down."
      },
      {
        "id": "m7",
        "mistake": "Too many reps (100+ per set)",
        "fix": "Cap total flexion reps per session; add difficulty or load instead."
      }
    ],
