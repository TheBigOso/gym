    "id": "one-arm-dumbbell-row",
    "name": "One-Arm Dumbbell Row",
    "aliases": [
      "Single-arm dumbbell row",
      "Dumbbell single-arm bent-over row",
      "Bench-supported dumbbell row"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "483712",
      "title": "Dumbbell Single Arm Bent Over Row",
      "url": "https://gymvisual.com/videos/17487-dumbbell-single-arm-bent-over-row.html",
      "listing": "Video; data sheet: body part Back, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lats and mid-back)",
    "secondaryBodyParts": [
      "Shoulders (rear deltoid)",
      "Upper arms (biceps)"
    ],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder extension, scapular retraction, elbow flexion)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "lats_r",
        "rhomboids_midtrap_r"
      ],
      "synergist": [
        "post_deltoid_r",
        "biceps_r",
        "forearm_flexors_r"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you row, inhale as you lower.",
      "cadence": "About 1 s up, 0.5 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "3 per arm",
      "reps": "8-12",
      "tempo": "1-1-2 (up, squeeze, down)",
      "load": "User-chosen dumbbell; stop about 1-3 reps short of failure (RIR 1-3)",
      "frequency": "2-3 times a week",
      "progression": "Add load or reps; add a pause at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Left knee and left hand on the bench, right foot on the floor, back flat and about level, right arm hanging straight."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and drive the elbow up and back toward the hip, close to the body."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the shoulder blade back; the dumbbell reaches the side of the lower ribs."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower under control until the arm is straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Let the shoulder blade glide forward a little, keep the back flat, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting the trunk open to lift the weight",
        "fix": "Keep both shoulders level; use a lighter dumbbell."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back or shrugging the shoulder to the ear",
        "fix": "Keep a flat back and pull the elbow toward the hip, not up to the ear."
      },
      {
        "id": "m3",
        "mistake": "Flaring the elbow out wide",
        "fix": "Keep the elbow close to the body for the lat-focused row."
      },
      {
        "id": "m4",
        "mistake": "Jerking the weight up",
        "fix": "Row smoothly and lower slowly."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk angle",
        "setup": "≈23° above horizontal, spine neutral",
        "peak": "Unchanged (no twist)",
        "norm": "Back flat, roughly parallel to the floor, supported by the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion (working arm)",
        "setup": "≈11°",
        "peak": "≈95°",
        "norm": "From nearly straight to about 90 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder extension",
        "setup": "Arm hanging straight down",
        "peak": "Elbow -3.2 cm above the shoulder joint, shoulder blade retracted (clavicle 8° to -16°)",
        "norm": "Elbow passes the line of the back with the upper arm close to the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s",
        "peak": "1.1 s up, 0.5 s squeeze, 2.0 s down, 1.1 s reset",
        "norm": "Controlled, about 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #483712, Dumbbell Single Arm Bent Over Row, video (movement reference)",
        "url": "https://gymvisual.com/videos/17487-dumbbell-single-arm-bent-over-row.html"
      },
      {
        "id": "fenwick2009",
        "title": "Fenwick, Brown & McGill 2009, comparison of different rowing exercises: trunk muscle activation and lumbar spine motion, load and stiffness (J Strength Cond Res 23(2):350-358)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19197209/"
      },
      {
        "id": "lehman2004",
        "title": "Lehman et al. 2004, variations in muscle activation levels during traditional latissimus dorsi weight training exercises (Dynamic Medicine 3:4)",
        "url": "https://link.springer.com/article/10.1186/1476-5918-3-4"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: the bench support usually makes this row easier on the back than a free-standing bent-over row (Fenwick 2009 measured the highest lumbar load in the standing bent-over row)."
      ],
      "modify": [
        "Shoulder pain: shorten the range at the top and keep the elbow close.",
        "Wrist discomfort on the support hand: make a fist on the bench or rest on the forearm."
      ],
      "regressions": [
        "Lighter dumbbell.",
        "Chest-supported dumbbell row."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Pause at the top.",
        "Free-standing (staggered stance) one-arm row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Main shoulder extensor: pulls the elbow from in front of the shoulder back to the side of the trunk.",
      "rhomboids_midtrap_r": "Retract the shoulder blade at the top. Rows gave the highest middle trapezius/rhomboid activity of the pulls tested by Lehman 2004.",
      "post_deltoid_r": "Helps extend the shoulder as the elbow passes the trunk.",
      "biceps_r": "Flexes the elbow to about 90 degrees; neutral grip shares the work with brachialis and brachioradialis.",
      "forearm_flexors_r": "Grip the handle.",
      "core": "Brace so the trunk does not twist toward the working side. A one-armed (cable) row challenged the torsional capacity of the trunk muscles with a low lumbar load (Fenwick 2009).",
      "obliques_r": "Resist trunk rotation as the weight comes up on one side (Fenwick 2009).",
      "obliques_l": "Resist trunk rotation as the weight comes up on one side (Fenwick 2009).",
      "spinal_extensors_r": "Hold the flat back; the bench takes much of the load off the low back.",
      "spinal_extensors_l": "Hold the flat back; the bench takes much of the load off the low back.",
      "triceps_l": "The support arm stays straight and pushes into the bench."
    }
  },
