  "exercise": {
    "id": "single-leg-hip-thrust",
    "name": "Single Leg Hip Thrust",
    "aliases": [
      "Single-leg hip thrust",
      "One-leg hip thrust",
      "Unilateral hip thrust",
      "Bench single-leg glute bridge"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "207112",
      "title": "Single Leg Hip Thrust",
      "url": "https://gymvisual.com/videos/11447-single-leg-hip-thrust.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (hamstrings)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip extension on one leg)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r"
      ],
      "synergist": [
        "hamstrings_r",
        "adductors_r"
      ],
      "stabilizer": [
        "glute_med_r",
        "quads_r",
        "obliques_r",
        "obliques_l",
        "core",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you drive the hips up, inhale as you lower.",
      "cadence": "About 1.2 s up, 0.8 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "8-12",
      "tempo": "1-1-2-0",
      "frequency": "2-3 times a week",
      "progression": "Pause at the top, then a dumbbell on the hip, then a barbell hip thrust"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Shoulder blades on the bench edge, arms spread on the bench, right foot flat, left knee lifted."
      },
      {
        "id": "c2",
        "phase": "drive",
        "text": "Breathe out and drive through the right heel to lift the hips."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Hips level with the shoulders, shin vertical, chin tucked. Squeeze the glute."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the hips toward the floor under control, pelvis level."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay on the bench and repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to get higher",
        "fix": "Stop when the trunk is level; keep the ribs down and the chin tucked."
      },
      {
        "id": "m2",
        "mistake": "Pelvis dropping toward the free leg",
        "fix": "Keep the hips level; brace and shorten the range if needed."
      },
      {
        "id": "m3",
        "mistake": "Foot too far out (hamstrings cramp) or too close (knee strain)",
        "fix": "Place the foot so the shin is vertical at the top."
      },
      {
        "id": "m4",
        "mistake": "Back sliding along the bench",
        "fix": "Pivot on the shoulder blades; the bench edge stays under the same spot."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench height",
        "setup": "42 cm",
        "peak": "Upper back pivots on the bench edge",
        "norm": "Knee height bench, about 40-45 cm (common setup; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Working hip flexion",
        "setup": "≈101° at the bottom",
        "peak": "≈-6°",
        "norm": "Hip reaches neutral at the top, trunk level with the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Working knee flexion",
        "setup": "≈110° at the bottom",
        "peak": "≈90° (shin vertical)",
        "norm": "About 90 degrees at the top (shin vertical); single-leg bridges at 90 degrees load the hamstrings more than at 135 degrees (Lehecka 2017)",
        "sources": [
          "lehecka2017"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈57° (hips below the shoulders)",
        "peak": "≈0° (level)",
        "norm": "Level at the top; the trunk pivots on the shoulder blades (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hips down 0.8 s",
        "peak": "1.2 s up, 0.8 s squeeze, 2.0 s down, 1.2 s reset",
        "norm": "About 1 s up, a short pause, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #207112, Single Leg Hip Thrust, video (movement reference)",
        "url": "https://gymvisual.com/videos/11447-single-leg-hip-thrust.html"
      },
      {
        "id": "contreras2015",
        "title": "Contreras et al. 2015, gluteus maximus, biceps femoris and vastus lateralis EMG in the back squat and barbell hip thrust (J Appl Biomech 31(6))",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26214739/"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      },
      {
        "id": "lehecka2017",
        "title": "Lehecka et al. 2017, building a better gluteal bridge: EMG of hip muscles during modified single-leg bridges (Int J Sports Phys Ther 12(4):543-549; PMC5534144)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5534144/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Make sure the bench cannot slide; set it against a wall."
      ],
      "modify": [
        "Low back discomfort: lift less high and brace first.",
        "Hard to keep the pelvis level: use both feet."
      ],
      "regressions": [
        "Two-leg hip thrust on the bench.",
        "Glute bridge on the floor."
      ],
      "progressions": [
        "Pause at the top.",
        "Dumbbell on the working hip.",
        "Barbell hip thrust."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Working-leg hip extensor. The barbell hip thrust gave about twice the mean gluteus maximus activity of the back squat (Contreras 2015), and single-leg versions generally excited the gluteus maximus more than two-leg versions (Macadam 2019).",
      "hamstrings_r": "Assist hip extension; the knee at about 90 degrees keeps them working hard (Lehecka 2017 measured biceps femoris near 75% MVIC in a single-leg bridge at 90 degrees).",
      "adductors_r": "Adductor magnus assists hip extension and steadies the thigh (clinical opinion).",
      "glute_med_r": "Keeps the pelvis level on the narrow one-foot base.",
      "quads_r": "Hold the knee angle and press the foot into the floor (clinical opinion).",
      "obliques_r": "Resist the pelvis rotating toward the free leg.",
      "obliques_l": "Resist the pelvis rotating toward the free leg.",
      "core": "Holds the ribs down so the lift comes from the hip, not the low back.",
      "hip_flexors_l": "Hold the free knee up (clinical opinion)."
    }
  },
