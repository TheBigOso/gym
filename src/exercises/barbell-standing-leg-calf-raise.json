    "breathing": {
      "pattern": "Exhale as the heels rise, inhale as they lower.",
      "cadence": "About 1 s up, 0.8 s pause, 1.8 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-20",
      "tempo": "1-1-2-0",
      "frequency": "2-3 times a week",
      "load": "Barbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) with a full rise every rep.",
      "rest": "60-90 s between sets",
      "progression": "Heavier bar, then the balls of the feet on a low step for a deeper stretch."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar on the upper traps, hands just outside the shoulders, shoulder blades squeezed. Feet hip width, toes forward, knees straight but soft."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Push through the balls of the feet and lift both heels as high as you can, ankles straight up, body tall."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the top and squeeze the calves."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the heels slowly all the way to the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Heels down, re-brace before the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bouncing out of the bottom",
        "fix": "Lower under control and pause briefly with the heels down."
      },
      {
        "id": "m2",
        "mistake": "Rolling onto the little toes",
        "fix": "Press through the big-toe side; keep the ankles in line with the knees."
      },
      {
        "id": "m3",
        "mistake": "Bending the knees to help",
        "fix": "Keep the knees straight but soft the whole rep."
      },
      {
        "id": "m4",
        "mistake": "Leaning forward with the hips",
        "fix": "Stand tall; the body rises straight up over the balls of the feet."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle plantarflexion",
        "setup": "≈-6° (feet flat)",
        "peak": "≈22° (feet 30° heel-up)",
        "norm": "Full heel rise, about 30-40 degrees of plantarflexion past neutral (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Heel height",
        "setup": "0 cm (heels down)",
        "peak": "≈9.5 cm",
        "norm": "As high as the ankle allows (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈4° (straight but soft)",
        "peak": "≈4°",
        "norm": "Straight knees bias the gastrocnemius (Hébert-Losier 2012)",
        "sources": [
          "heberlosier2012"
        ]
      },
      {
        "measure": "Stance",
        "setup": "Feet hip width (22 cm between the ankle centres), toes out 5°",
        "peak": "Unchanged; the balls of the feet stay put",
        "norm": "Hip width, toes forward (common coaching)",
        "sources": []
      },
      {
        "measure": "Bar position",
        "setup": "High bar on the upper traps, 80 cm grip; body + bar centre of mass 5 cm ahead of the ankles",
        "peak": "Centre of mass 1.5 cm behind the balls of the feet at the top",
        "norm": "High bar on the upper trapezius; centre of mass over the balls of the feet at the top (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.0 s up, 0.8 s pause, 1.8 s down, 0.6 s reset",
        "norm": "Pause at the top, slow lowering (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
