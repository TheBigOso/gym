    "safety": {
      "cautions": [
        "Take the bar from a rack at about shoulder height and re-rack it after the set; the rack drawn here shows only the J-hooks.",
        "Balance limits the load: stand near the rack or use a light bar first.",
        "Keep the bar on the muscle of the upper back, never on the neck.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Achilles or calf pain: smaller range, slower lowering, lighter bar.",
        "Balance issues: dumbbell calf raise with one hand on support."
      ],
      "regressions": [
        "Bodyweight standing calf raise.",
        "Single-leg dumbbell calf raise with a hand on the wall."
      ],
      "progressions": [
        "Balls of the feet on a low step for a deeper stretch.",
        "Barbell standing single leg calf raise.",
        "Heavier bar."
      ]
    },
    "muscleNotes": {
      "calves_r": "Gastrocnemius and soleus lift the heels; with the knees straight the gastrocnemius shares more of the work (Hébert-Losier 2012); standing calf raises grew the gastrocnemius more than seated ones (Kinoshita 2023).",
      "calves_l": "Gastrocnemius and soleus lift the heels; with the knees straight the gastrocnemius shares more of the work (Hébert-Losier 2012); standing calf raises grew the gastrocnemius more than seated ones (Kinoshita 2023).",
      "core": "Keeps the trunk tall under the bar.",
      "spinal_extensors_r": "Hold the trunk upright under the bar.",
      "spinal_extensors_l": "Hold the trunk upright under the bar.",
      "glute_med_r": "Keeps the pelvis level and the knees from caving.",
      "glute_med_l": "Keeps the pelvis level and the knees from caving.",
      "quads_r": "Hold the knees straight but soft.",
      "quads_l": "Hold the knees straight but soft.",
      "upper_traps_r": "The muscle shelf the bar rests on.",
      "upper_traps_l": "The muscle shelf the bar rests on.",
