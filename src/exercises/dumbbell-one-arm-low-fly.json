    "name": "Dumbbell One Arm Low Fly",
    "aliases": [
      "Single-arm low dumbbell fly",
      "One-arm dumbbell fly toward the hip",
      "Lower-chest dumbbell fly (one arm)"
    ],
    "reference": {
      "source": "GymVisual",
