        "url": "https://doaj.org/article/0e2bf09a93e84781b25d9d76faf65cd2"
      }
    ],
    "safety": {
      "cautions": [
        "Wrist pain: the planted palm bends the wrist back about 80-90 degrees; use push-up handles or hex dumbbells to keep the wrists straight, or stop if pain persists (clinical opinion).",
        "Shoulder pain: keep the elbows tucked rather than flared out to the sides, and shorten the range if needed (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Elbow pain: narrow hands put more load through the elbows; widen the hands a little or regress to an incline (clinical opinion)."
      ],
      "modify": [
        "Wrist or elbow discomfort: hands slightly wider, or hold hex dumbbells.",
        "Too hard: hands on a bench (incline close-grip push-up) or knees down."
      ],
      "regressions": [
        "Incline close-grip push-up.",
        "Close-grip push-up on the knees."
      ],
      "progressions": [
        "Diamond push-up.",
        "Feet-elevated close-grip push-up.",
        "Weighted vest."
      ]
    },
    "muscleNotes": {
      "pec_r": "Still a main pusher: pectoralis activity was higher with hands at or inside shoulder width than at 150% (Kim 2016) and highest with diamond hands (Intziegianni 2026).",
      "pec_l": "Still a main pusher: pectoralis activity was higher with hands at or inside shoulder width than at 150% (Kim 2016) and highest with diamond hands (Intziegianni 2026).",
      "triceps_r": "Main target: narrowing the hands raised triceps activity versus shoulder-width and wide push-ups (Kim 2016; Marcolin 2015), and diamond hands gave the highest relative triceps and chest activation in Intziegianni 2026.",
      "triceps_l": "Main target: narrowing the hands raised triceps activity versus shoulder-width and wide push-ups (Kim 2016; Marcolin 2015), and diamond hands gave the highest relative triceps and chest activation in Intziegianni 2026.",
      "ant_deltoid_r": "Flexes the shoulder with the chest muscles.",
      "ant_deltoid_l": "Flexes the shoulder with the chest muscles.",
      "serratus_r": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "serratus_l": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "core": "Bracing keeps the hips from sagging or piking: the body moves as one plank.",
      "obliques_r": "Help hold the trunk rigid and level.",
      "obliques_l": "Help hold the trunk rigid and level.",
      "rhomboids_midtrap_r": "Control the shoulder blades as they draw together on the way down.",
      "rhomboids_midtrap_l": "Control the shoulder blades as they draw together on the way down.",
      "infraspinatus_r": "Keeps the head of the upper arm centred as the elbows bend.",
      "infraspinatus_l": "Keeps the head of the upper arm centred as the elbows bend.",
      "glute_max_r": "Squeezed lightly to keep the pelvis in line (no sag).",
      "glute_max_l": "Squeezed lightly to keep the pelvis in line (no sag).",
      "quads_r": "Keep the knees straight so the legs stay part of the plank.",
      "quads_l": "Keep the knees straight so the legs stay part of the plank.",
      "spinal_extensors_r": "Hold a long, neutral spine and neck.",
      "spinal_extensors_l": "Hold a long, neutral spine and neck."
    }
