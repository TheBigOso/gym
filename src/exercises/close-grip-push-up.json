    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press up.",
      "cadence": "About 1.8 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-15 (stop 1-2 reps before form breaks)",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, then slower lowering, then feet elevated or a weighted vest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "High plank with the hands under the chest, closer than shoulder width (index fingers about a hand apart), body in one line."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower with the elbows brushing back along the ribs."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Chest just above the hands, elbows pointing back toward the feet."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and push through the palms until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Lock in the plank at the top and go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring out to the sides",
        "fix": "Keep the elbows tight to the ribs, pointing back toward the feet."
      },
      {
        "id": "m2",
        "mistake": "Hands too far forward (under the face)",
        "fix": "Place the hands under the lower chest so the forearms stay close to vertical at the bottom."
      },
      {
        "id": "m3",
        "mistake": "Hips sagging",
        "fix": "Brace the abs and squeeze the glutes."
      },
      {
        "id": "m4",
        "mistake": "Half reps",
        "fix": "Lower until the chest is close to the hands."
      },
      {
        "id": "m5",
        "mistake": "Wrists twisting inward painfully",
        "fix": "Turn the fingers slightly out or widen the hands a little."
      }
    ],
    "kinematics": [
      {
        "measure": "Hand width",
        "setup": "Wrists 22 cm apart (shoulder joints 40 cm): about 55% of shoulder width",
        "peak": "Unchanged (hands planted)",
        "norm": "Inside shoulder width; 50% of shoulder width raised triceps activity versus 100% and 150% (Kim 2016); diamond hands (thumbs and index fingers touching) gave the highest activation (Intziegianni 2026)",
        "sources": [
          "kim2016",
          "intziegianni2026"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈16° on the drawn arm (straight, not locked; rig channel ≈45°)",
        "peak": "≈122° at the bottom (chest 12 cm above the floor)",
        "norm": "Arms straight but not locked at the top; elbows bend to about 90 degrees or more at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "≈-12° (arms near vertical)",
        "peak": "≈-5° at the bottom",
        "norm": "Elbows close to the ribs, about 10-25 degrees from the body at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line",
        "setup": "Trunk ≈21° above horizontal; trunk-to-leg bend 0.0°",
        "peak": "Trunk ≈9°; bend 0.1°",
        "norm": "Head, trunk, hips and ankles in one straight line throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Wrist extension",
        "setup": "≈71°",
        "peak": "≈44° at the bottom",
        "norm": "Palms flat; the wrist bends back about 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up; lab studies used 2-2.5 s per repetition (Marcolin 2015)",
        "sources": [
          "marcolin2015"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #025912, Close Grip Push-up, video (movement reference)",
