    "breathing": {
      "pattern": "Breathe in and brace at the top, lower; breathe out as you pass the hardest part of the rise.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbell, a 2 s pause at the bottom, then a heels-elevated front squat. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Heels on a low board, balls of the feet on the floor, feet a little narrower than shoulder width. Hold one dumbbell upright against the chest, hands cupping the top plate, elbows down."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, brace and sit straight down; let the knees travel forward over the toes, chest tall."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs below parallel, trunk upright, heels pressed into the board."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive up through the whole foot and stand tall; breathe out near the top."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, reset the brace, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Heels sliding off the board",
        "fix": "Set the board under the heels only; the balls of the feet stay on the floor."
      },
      {
        "id": "m2",
        "mistake": "Knees caving inward",
        "fix": "Keep the knees tracking over the second toe as they travel forward."
      },
      {
        "id": "m3",
        "mistake": "Leaning forward anyway",
        "fix": "The raised heels are there so you can stay upright: keep the dumbbell on the sternum and the chest tall."
      },
      {
        "id": "m4",
        "mistake": "Bouncing out of the bottom",
        "fix": "Control the descent and pause briefly before driving up."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "34 cm between ankle centres (≈0.8x the rig's 40 cm shoulder width), toes out 12°",
        "peak": "Unchanged",
        "norm": "About hip to shoulder width, toes slightly out (common coaching)",
        "sources": []
      },
      {
        "measure": "Heel elevation",
        "setup": "Heels on a 3.3 cm board, feet pitched 12° heel-up, balls of the feet on the floor",
        "peak": "Unchanged (heels stay on the board)",
        "norm": "About 2-5 cm under the heels (a plate or slant board; common coaching). Raising the heels lets the knees travel further forward for the same ankle range, so the trunk stays more upright and the knee bends deeper (common coaching; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈128°",
        "norm": "About 120-135 degrees in a deep heel-raised squat (clinical opinion); depth is driven mostly by knee range (Zawadka 2020)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈3°",
        "peak": "≈116° (joint channel, as in the HUD)",
        "norm": "Not specified by the sources for this depth",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈15° forward",
        "norm": "More upright than a flat-footed squat; more lean moves demand from knee to hip (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Dumbbell",
        "setup": "Upright at the sternum, hands cupping the top plate",
        "peak": "Clear of the chest and thighs (≥2.71 cm on the rig shapes)",
        "norm": "Held upright at the sternum, elbows down (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "About 2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
