    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee pain: squat to a shallower depth or lower the board.",
        "Feeling unstable: use a wider board so the whole heel is supported."
      ],
      "regressions": [
        "Goblet squat with the feet flat.",
        "Heels-elevated bodyweight squat."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "2 s pause at the bottom.",
        "Heels-elevated front squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Knee extensors lower and drive the squat; the raised heels let the knees travel forward and bend deeper, shifting work toward the quadriceps (clinical opinion). Quadriceps activity was higher in the goblet squat than in the landmine squat (Collins 2021).",
      "quads_l": "Knee extensors lower and drive the squat; the raised heels let the knees travel forward and bend deeper, shifting work toward the quadriceps (clinical opinion). Quadriceps activity was higher in the goblet squat than in the landmine squat (Collins 2021).",
      "glute_max_r": "Hip extensor, working hardest out of the bottom (clinical opinion).",
      "glute_max_l": "Hip extensor, working hardest out of the bottom (clinical opinion).",
      "adductors_r": "Adductor magnus assists hip extension in the deep squat; the knees pushing out keeps the thighs over the feet (clinical opinion).",
      "adductors_l": "Adductor magnus assists hip extension in the deep squat; the knees pushing out keeps the thighs over the feet (clinical opinion).",
      "hamstrings_r": "Co-contract around the knee and assist hip extension (Collins 2021 measured biceps femoris and semitendinosus in both squats).",
      "hamstrings_l": "Co-contract around the knee and assist hip extension (Collins 2021 measured biceps femoris and semitendinosus in both squats).",
      "calves_r": "Steady the shins as the knees travel forward over the toes.",
      "calves_l": "Steady the shins as the knees travel forward over the toes.",
      "core": "Braces against the load held in front of the body.",
      "spinal_extensors_r": "Keep the chest up and the back flat under the front load (clinical opinion). A front-loaded squat needed less knee compression than a back squat for similar muscle recruitment (front vs back squat, 2009).",
      "spinal_extensors_l": "Keep the chest up and the back flat under the front load (clinical opinion). A front-loaded squat needed less knee compression than a back squat for similar muscle recruitment (front vs back squat, 2009).",
      "glute_med_r": "Keeps the knees tracking over the toes (clinical opinion).",
      "glute_med_l": "Keeps the knees tracking over the toes (clinical opinion).",
      "forearm_flexors_r": "Cup the top plate and keep the dumbbell from slipping (clinical opinion).",
      "forearm_flexors_l": "Cup the top plate and keep the dumbbell from slipping (clinical opinion).",
      "biceps_r": "Hold the elbows bent and the dumbbell against the chest (clinical opinion).",
      "biceps_l": "Hold the elbows bent and the dumbbell against the chest (clinical opinion)."
    }
