    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen; the band is hardest at the top of the curl, where it is stretched most",
      "progression": "Band tension is user-chosen: pick a band you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then a stronger band or a shorter grip on the band."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a bench, feet flat about hip width and well out in front, the middle of the band under the feet; hold an end in each hand, arms straight beside the bench, palms forward."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl both hands up, elbows by your sides."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze at the top, where the band is tightest; wrists straight, shoulders down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly against the band to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Sit tall, a little tension left in the band; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rocking the trunk back to stretch the band",
        "fix": "Sit tall and still; use a lighter band."
      },
      {
        "id": "m2",
        "mistake": "Elbows drifting forward",
        "fix": "Keep the elbows by the sides; only the forearms move."
      },
      {
        "id": "m3",
        "mistake": "Letting the band snap the hands down",
        "fix": "Take 2-3 s to lower all the way to straight arms."
      },
      {
        "id": "m4",
        "mistake": "Slumping the lower back",
        "fix": "Sit up on the sit bones, chest up."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈8° (arm straight)",
        "peak": "≈135° at the top (range ≈127°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "6° (palm forward/up)",
        "peak": "0° (palm forward/up)",
        "norm": "The supinated grip gave the highest biceps activity in the lifting phase; neutral grips shift work toward the brachioradialis (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈0°",
        "peak": "≈12° (elbow forward)",
        "norm": "Elbows stay near the sides; a small forward drift at the top is normal, a big swing shifts work to the front deltoid (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "One band per hand, under the ball of each foot; strand 67.4 cm with the arms straight",
        "peak": "Strand 112.3 cm at the top of the curl (most stretch, most tension)",
        "norm": "Elastic tension rises as the band stretches, so the load is highest where the band is longest; at matched effort, elastic tubing and dumbbells gave similar muscle activity in upper-body exercises (Andersen 2010); with the band under the feet in front, the load rises toward the top of the curl",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Arms straight 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
