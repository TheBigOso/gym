    "safety": {
      "cautions": [
        "Elbow or shoulder pain: use a lighter band and shorten the range; stop if pain is sharp (clinical opinion).",
        "Check the band for nicks or tears before each set and make sure it cannot slip off its anchor (under the feet, round the upright). Keep both feet firmly on the band so it cannot slip out and snap up.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrist or elbow pain with the palms up: turn to a neutral (hammer) grip.",
        "Too hard at the top: move the feet closer to the bench to slacken the band."
      ],
      "regressions": [
        "Lighter band.",
        "One arm at a time."
      ],
      "progressions": [
        "Stronger band, or the feet further forward.",
        "Slower lowering.",
        "Seated dumbbell curl."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor and forearm supinator; with a supinated grip it worked harder than with neutral (+12%) or pronated (+19%) grips in the lifting phase (Coratella 2023).",
      "biceps_l": "Main elbow flexor and forearm supinator; with a supinated grip it worked harder than with neutral (+12%) or pronated (+19%) grips in the lifting phase (Coratella 2023).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_flexors_r": "Wrist and finger flexors hold the band and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the band and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder so the upper arm stays put; it rises if the elbow drifts forward.",
      "ant_deltoid_l": "Steadies the shoulder so the upper arm stays put; it rises if the elbow drifts forward.",
      "core": "Holds the unsupported trunk tall; sitting takes the legs and hips out so the weight cannot be swung up.",
      "spinal_extensors_r": "Keep the back tall without a backrest.",
      "spinal_extensors_l": "Keep the back tall without a backrest."
    }
