    "name": "Dumbbell Seated One Leg Calf Raise",
    "aliases": [
      "Single-leg seated dumbbell calf raise",
      "Seated one-leg heel raise with dumbbell",
      "Seated single calf raise"
    ],
    "reference": {
      "source": "GymVisual",
