        "url": "https://www.frontiersin.org/articles/10.3389/fphys.2023.1272106/full"
      }
    ],
    "safety": {
      "cautions": [
        "Use a towel or pad under the dumbbell if the handle presses into the thigh.",
        "Keep the dumbbell steady with the hand so it cannot roll off the thigh onto the foot.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Achilles or calf discomfort: shorten the range and slow down."
      ],
      "regressions": [
        "Seated calf raise without weight.",
        "Seated dumbbell calf raise (both legs)."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Ball of the foot on a plate or step for more range."
      ]
    },
    "muscleNotes": {
      "calves_r": "Lifts the heel; with the knee bent the soleus contributes more than the gastrocnemius (Hébert-Losier 2012). Seated calf-raise training grew the soleus but not the gastrocnemius in Kinoshita 2023.",
      "forearm_flexors_r": "Hold the dumbbell steady on the thigh.",
      "core": "Keeps the trunk upright on the bench."
    }
