    "type": "Strength",
    "bodyPart": "Calves",
    "secondaryBodyParts": [],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (ankle)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "calves_r"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_flexors_r",
        "core"
      ],
      "lengthened": [
        "calves_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the heel rises, inhale as it lowers.",
      "cadence": "About 1.0 s up, 0.8 s pause, 1.8 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "12-20 per leg",
      "tempo": "1-1-2-0 (1 s up, 1 s pause, 2 s down)",
      "frequency": "2-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3). One leg takes the whole dumbbell, so start lighter than half of your two-leg seated load times two.",
      "progression": "Add reps, then a heavier dumbbell; a plate under the ball of the foot adds range."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a bench, feet flat, shins vertical; rest a dumbbell across the lower right thigh just behind the knee and hold it there, left hand on the left thigh."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Breathe out and push through the ball of the right foot, lifting the heel as high as you can."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the top and squeeze the calf; keep the pressure over the big toe."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the heel slowly until the foot is flat."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Heel down, brief reset; switch legs after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bouncing the heel",
        "fix": "Lower slowly and pause at both ends."
      },
      {
        "id": "m2",
        "mistake": "Pushing the dumbbell up with the arm",
        "fix": "The hand only steadies the dumbbell; the calf lifts it."
      },
      {
        "id": "m3",
        "mistake": "Rolling onto the outside of the foot",
        "fix": "Keep the pressure over the big toe."
      },
      {
        "id": "m4",
        "mistake": "Cutting the range short",
        "fix": "Rise as high as you can and lower until the foot is flat."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle plantarflexion",
        "setup": "≈-1° (foot flat)",
        "peak": "≈36° (right foot 30° heel-up)",
        "norm": "Full range from the flat foot to the highest heel position (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Heel height",
        "setup": "0 cm (heel down)",
        "peak": "≈9.5 cm",
        "norm": "Several centimetres of heel rise; as high as you can (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈90°, shins vertical",
        "peak": "≈92° (right knee 5.9 cm higher)",
        "norm": "Knee bent about 90 degrees: with the knee bent the soleus does more of the work than the gastrocnemius (Hébert-Losier 2012)",
        "sources": [
          "heberlosier2012"
        ]
      },
      {
        "measure": "Dumbbell",
        "setup": "Across the lower right thigh (80% of the way to the knee), held by the handle; left hand on the left thigh",
        "peak": "Rides up with the knee (3.6 cm)",
        "norm": "Across the lower thigh just behind the knee, steadied by the hand (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Heel down 0.8 s",
        "peak": "1.0 s up, 0.8 s pause, 1.8 s down, 0.6 s reset",
        "norm": "About 1 s up, a short pause, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
