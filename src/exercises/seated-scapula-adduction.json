    "id": "seated-scapula-adduction",
    "name": "Seated Scapula Adduction",
    "aliases": [
      "Seated scapular retraction",
      "Seated shoulder blade squeeze",
      "Scapular squeeze"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "691312",
      "title": "Sitting Scapula Adduction (male)",
      "url": "https://gymvisual.com/videos/17080-sitting-scapula-adduction-male.html",
      "listing": "Video; data sheet: body part Back, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Mobility / activation",
    "bodyPart": "Upper back (rhomboids, middle trapezius)",
    "secondaryBodyParts": [
      "Shoulders (posterior deltoid)"
    ],
    "equipment": [
      "Bench (flat)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder blades)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you squeeze, breathe normally through the hold, breathe in as you release.",
      "cadence": "About 1 s in, 3 s hold, 1 s out"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 (3 s hold each)",
      "effort": "Easy to moderate (RPE 3-6)",
      "tempo": "1-3-1-1 (squeeze-hold-release-rest, seconds)",
      "rest": "30-60 s",
      "frequency": "Daily or in a warm-up",
      "load": "Body weight",
      "progression": "Longer holds (5-10 s); prone or band versions"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a bench, feet flat. Elbows bent about 90 degrees and a little out from the sides, palms facing in, shoulders relaxed and down."
      },
      {
        "id": "c2",
        "phase": "squeeze",
        "text": "Breathe out and squeeze the shoulder blades back and together; the elbows travel back a little."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold about 3 s; neck long, chest proud but ribs down, no shrug."
      },
      {
        "id": "c4",
        "phase": "release",
        "text": "Release slowly to the start."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Relax a moment and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the shoulders down away from the ears; squeeze back, not up."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back",
        "fix": "Keep the ribs down; move only the shoulder blades."
      },
      {
        "id": "m3",
        "mistake": "Pulling the elbows back without moving the shoulder blades",
        "fix": "Think of pinching a pencil between the shoulder blades."
      },
      {
        "id": "m4",
        "mistake": "Poking the chin forward",
        "fix": "Keep the head stacked over the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder blade retraction",
        "setup": "clavicle protraction 4° (relaxed)",
        "peak": "-16° (20° of retraction); shoulder joint moves back 6.6 cm",
        "norm": "With 45 degrees of abduction and the elbow bent 90 degrees, the clavicle retracted about 15 degrees from neutral stance (prone, Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Arm position",
        "setup": "elbow ≈86°, upper arm ≈33° from the trunk",
        "peak": "elbows 13.9 cm further back",
        "norm": "Elbows bent about 90 degrees, upper arms a little out from the sides (Oyama 2010 exercise 5 used 45 degrees of abduction)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Trunk",
        "setup": "upright on the bench (hip 90°)",
        "peak": "unchanged",
        "norm": "Upright and still on the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Relax 1.0 s",
        "peak": "1.2 s in, 3.0 s hold, 1.2 s out",
        "norm": "About 1 s in, 3 s hold, 1 s out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #691312, Sitting Scapula Adduction (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/17080-sitting-scapula-adduction-male.html"
      },
      {
        "id": "oyama2010",
        "title": "Oyama, Myers, Wassinger and Lephart 2010, three-dimensional scapular and clavicular kinematics and scapular muscle activity during retraction exercises (J Orthop Sports Phys Ther 40(3):169-179)",
        "url": "https://chs.uky.edu/sites/default/files/2023-12/Oyama_2010_Three-Dimensional%20Scapular%20and%20Clavicular%20Kinematics.pdf"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Oyama 2010 tested prone exercises in healthy young adults; seated values are inferred."
      ],
      "modify": [
        "Neck tension: let the arms hang and only squeeze the shoulder blades.",
        "Low back aches when sitting: sit with the back against a wall or the bench pad upright."
      ],
      "regressions": [
        "Arms hanging by the sides.",
        "Fewer, shorter holds."
      ],
      "progressions": [
        "Band pull-aparts or seated band rows.",
        "Prone T or Y raises (Oyama 2010).",
        "Dumbbell rear delt row."
      ]
    },
    "muscleNotes": {
      "rhomboids_midtrap_r": "Pull the shoulder blades back toward the spine. In prone retraction exercises the middle trapezius reached up to about 77% of maximal activity with the arms raised (Oyama 2010); the rhomboids could not be measured with surface EMG.",
      "rhomboids_midtrap_l": "Pull the shoulder blades back toward the spine. In prone retraction exercises the middle trapezius reached up to about 77% of maximal activity with the arms raised (Oyama 2010); the rhomboids could not be measured with surface EMG.",
      "post_deltoid_r": "Draws the elbows back as the shoulder blades squeeze.",
      "post_deltoid_l": "Draws the elbows back as the shoulder blades squeeze.",
      "infraspinatus_r": "Holds the upper arms turned out slightly.",
      "infraspinatus_l": "Holds the upper arms turned out slightly.",
      "spinal_extensors_r": "Keep the upper back tall so the squeeze comes from the shoulder blades, not an arch.",
      "spinal_extensors_l": "Keep the upper back tall so the squeeze comes from the shoulder blades, not an arch.",
      "core": "Keeps the ribs down and the low back neutral."
    }
  },
