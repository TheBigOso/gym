  "exercise": {
    "id": "glute-ham-raise",
    "name": "Glute Ham Raise",
    "aliases": [
      "GHR",
      "Glute-ham developer raise",
      "GHD raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "011225",
      "title": "Glute Ham Raise",
      "url": "https://gymvisual.com/videos/11225-glute-ham-raise-version-2.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (hamstrings) and glutes",
    "secondaryBodyParts": [
      "Glutes",
      "Calves"
    ],
    "equipment": [
      "Glute-ham developer (GHD)"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (knee flexion with the hips extended)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hamstrings_r",
        "hamstrings_l"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Brace and exhale as you rise, inhale as you lower.",
      "cadence": "About 1.6 s up, a short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "4-8",
      "tempo": "1.5 s up, brief pause, 2-3 s down",
      "frequency": "1-2 times a week",
      "progression": "Hands pushing off a box for help, then full reps, then a plate at the chest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the pad under the lower thighs, feet flat on the plate between the rollers, body straight and horizontal, arms crossed on the chest."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Drive the toes into the plate and curl the body up by bending the knees; keep the hips straight."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause upright over the knees."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly back to horizontal, hips still straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Body horizontal; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending at the hips (turns it into a back extension)",
        "fix": "Squeeze the glutes and keep knee, hip and shoulder in line."
      },
      {
        "id": "m2",
        "mistake": "Pad too far back (on the knees)",
        "fix": "Set it under the lower thighs so the knees can bend."
      },
      {
        "id": "m3",
        "mistake": "Dropping on the way down",
        "fix": "Lower in 2-3 s."
      },
      {
        "id": "m4",
        "mistake": "Arching the low back",
        "fix": "Brace the trunk."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈1° (body horizontal over the pad)",
        "peak": "≈89° at the top",
        "norm": "From nearly straight with the body horizontal to about 90 degrees upright (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip",
        "setup": "Extended (knee, hip and shoulder in one line)",
        "peak": "Slight bend mid-rep (up to 10°), straight at the top",
        "norm": "Hips extended through the rep (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line",
        "setup": "≈3° from horizontal",
        "peak": "≈90° from horizontal (upright)",
        "norm": "Knee to shoulder in one line from horizontal to upright (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pad",
        "setup": "Lower thighs on the round pad, knees just behind it",
        "peak": "Shins fixed (knee drift ≤0.6 cm)",
        "norm": "The glute-ham raise loaded the hamstrings more than the good morning (McAllister 2014)",
        "sources": [
          "mcallister2014"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #011225, Glute Ham Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/11225-glute-ham-raise-version-2.html"
      },
      {
        "id": "mcallister2014",
        "title": "McAllister, Hammond, Schilling, Ferreria, Reed & Weiss 2014, muscle activation during various hamstring exercises (J Strength Cond Res 28(6):1573-1580)",
        "url": "https://digitalcommons.memphis.edu/facpubs/9934"
      }
    ],
    "safety": {
      "cautions": [
        "Hamstring strain risk is highest when lowering; build up the volume slowly and stop at any sharp pain at the back of the thigh.",
        "Knee pain on the pad: move the pad a little higher up the thighs.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Push off a box or the frame with the hands at the bottom."
      ],
      "regressions": [
        "Nordic curl with band help.",
        "Lying or seated leg curl."
      ],
      "progressions": [
        "Slower lowering.",
        "Plate held at the chest."
      ]
    },
    "muscleNotes": {
      "hamstrings": "The glute-ham raise gave high hamstring activity, more than the good morning in McAllister 2014; the hamstrings flex the knee against body weight with the hip extended.",
      "glute_max": "Gluteus maximus keeps the hips straight so the body moves as one piece.",
      "calves": "Gastrocnemius helps flex the knee with the feet fixed on the plate."
    }
  },
