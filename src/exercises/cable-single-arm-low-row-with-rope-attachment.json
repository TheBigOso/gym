    "muscles": {
      "target": [
        "lats_r",
        "rhomboids_midtrap_r"
      ],
      "synergist": [
        "post_deltoid_r",
        "biceps_r",
        "forearm_flexors_r"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
