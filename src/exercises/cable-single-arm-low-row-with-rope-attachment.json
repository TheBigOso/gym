        "upper_traps_r"
      ],
      "lengthened": [
        "lats_r",
        "rhomboids_midtrap_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row, breathe in as the arm reaches forward.",
      "cadence": "About 1.3 s pull, short squeeze, about 2 s return"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-12 per side",
      "tempo": "1-1-2-0",
      "load": "A stack setting you can row with 1-3 reps in reserve (RIR 1-3, clinical opinion)",
      "frequency": "2 times a week",
      "progression": "Add load in small steps"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit facing a low pulley, feet braced; hold one end of the rope in the right hand, thumb up, arm long, chest tall; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and row the rope to the side of the stomach, elbow close to the body."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Draw the right shoulder blade back; keep the chest square."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the arm reach forward under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arm long, shoulder blade forward; repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting the trunk to pull",
        "fix": "Keep the chest square to the pulley; the arm and shoulder blade do the work."
      },
      {
        "id": "m2",
        "mistake": "Leaning far back",
        "fix": "Stay close to upright through the pull."
      },
      {
        "id": "m3",
        "mistake": "Elbow flaring",
        "fix": "Keep the elbow close to the ribs."
      },
      {
        "id": "m4",
        "mistake": "Letting the stack slam",
        "fix": "Control the return."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk lean",
        "setup": "≈7° forward of upright",
        "peak": "≈-7° (upright)",
        "norm": "About 10-15 degrees forward at the reach, upright at the finish (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈19° (arm long)",
        "peak": "≈102°",
        "norm": "From nearly straight to about 90-110 degrees at the finish (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blade",
        "setup": "Protracted, reaching forward (shoulder line ≈13° off square)",
        "peak": "Retracted; shoulder line ≈13° off square",
        "norm": "Protracted at the reach, retracted at the finish (Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Grip",
        "setup": "One rope end in the right fist, thumb up; left hand on the hip",
        "peak": "The rope end finishes beside the stomach",
        "norm": "Neutral grip on one rope end; one-arm work raises the trunk anti-rotation demand (Saeterbakken 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stretch 0.5 s at full reach",
        "peak": "1.3 s pull, 0.4 s squeeze, 2 s return",
        "norm": "About 1.3 s pull, 2 s return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
