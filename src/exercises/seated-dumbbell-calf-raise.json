    "id": "seated-dumbbell-calf-raise",
    "name": "Seated Dumbbell Calf Raise",
    "aliases": [
      "Dumbbell seated calf raise",
      "Seated heel raise with dumbbells",
      "Bench seated calf raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "137912",
      "title": "Dumbbell Seated Calf Raise",
      "url": "https://gymvisual.com/videos/8714-dumbbell-seated-calf-raise.html",
      "listing": "Video; data sheet: body part Calves, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Calves",
    "secondaryBodyParts": [],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (ankle plantarflexion, knees bent)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "calves_r",
        "calves_l"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the heels rise, inhale as they lower.",
      "cadence": "About 1 s up, 0.8 s pause, 1.8 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "12-20",
      "tempo": "1-1-2-0 (up, pause, down)",
      "frequency": "2-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set.",
      "progression": "Heavier dumbbells, then balls of the feet on a plate or step for a deeper stretch, then single-leg"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the end of the bench, feet flat a little wider than the hips, shins vertical; lay a dumbbell across each lower thigh just behind the knee and hold it there."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Breathe out and press through the balls of the feet, lifting the heels and the dumbbells as high as you can."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the top; weight over the big and second toes, ankles straight (no rolling out)."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the heels slowly to the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch down without bouncing and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bouncing through short reps",
        "fix": "Full range: heels all the way down, pause at the top, slow lowering."
      },
      {
        "id": "m2",
        "mistake": "Feet rolling out onto the little toes",
        "fix": "Keep the pressure on the big and second toes."
      },
      {
        "id": "m3",
        "mistake": "Pushing the dumbbells up with the arms",
        "fix": "The hands only hold the dumbbells in place; the calves lift them."
      },
      {
        "id": "m4",
        "mistake": "Feet too far forward",
        "fix": "Shins vertical, knees over the ankles, so the load sits over the balls of the feet."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle plantarflexion",
        "setup": "≈-1° (feet flat)",
        "peak": "≈36° (feet 30° heel-up)",
        "norm": "Full range from heels down to as high as possible; the seated knee-90 position biases the soleus (Kinoshita 2023)",
        "sources": [
          "kinoshita2023"
        ]
      },
      {
        "measure": "Heel height",
        "setup": "0 cm (heels down)",
        "peak": "≈9.5 cm",
        "norm": "Lift as high as possible each rep (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈90°, shins vertical",
        "peak": "≈92° (knees 5.9 cm higher)",
        "norm": "About 90 degrees, as in the seated training condition of Kinoshita 2023; the knee rises with the heel",
        "sources": [
          "kinoshita2023"
        ]
      },
      {
        "measure": "Dumbbells",
        "setup": "Across the lower thighs (80% of the way to the knee), held by the handles",
        "peak": "Ride up with the knees (3.6 cm)",
        "norm": "Across the lower thighs just behind the knees, held in place by the hands (common setup; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Heels down 0.8 s",
        "peak": "1.0 s up, 0.8 s pause, 1.8 s down, 0.6 s reset",
        "norm": "About 1-2 s up and 2 s down; Kinoshita 2023 trained at 2 s up, 2 s down",
        "sources": [
          "kinoshita2023"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #137912, Dumbbell Seated Calf Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/8714-dumbbell-seated-calf-raise.html"
      },
      {
        "id": "kinoshita2023",
        "title": "Kinoshita, Maeo et al. 2023, triceps surae muscle hypertrophy is greater after standing versus seated calf-raise training (Front Physiol 14:1272106)",
        "url": "https://www.frontiersin.org/articles/10.3389/fphys.2023.1272106/full"
      },
      {
        "id": "zellers2019",
        "title": "Zellers et al. 2019, seated and standing heel raises and triceps surae activation after Achilles tendon rupture (Transl Sports Med 3(1):3-8; PMC7236791)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7236791/"
      },
      {
        "id": "heberlosier2012",
        "title": "Hébert-Losier, Schneiders, García, Sullivan & Simoneau 2012, influence of knee flexion angle and age on triceps surae muscle fatigue during heel raises (J Strength Cond Res 26(11))",
        "url": "https://epublications.marquette.edu/phys_therapy_fac/29"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Rest the dumbbells on the thigh muscle just behind the kneecap, not on the kneecap itself."
      ],
      "modify": [
        "Achilles or plantar heel pain: smaller range and lighter load, slow tempo.",
        "Knee discomfort under the dumbbells: fold a towel over the thighs."
      ],
      "regressions": [
        "No dumbbells (bodyweight seated heel raise).",
        "Lighter dumbbells, partial range."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Balls of the feet on a plate or step for a deeper stretch.",
        "Single-leg seated raise with one heavier dumbbell."
      ]
    },
    "muscleNotes": {
      "calves_r": "Soleus-biased plantarflexion: with the knee bent 90 degrees the two-joint gastrocnemius is slack. In a 12-week trial seated (knee 90 degrees) calf raises grew the soleus as much as standing raises (2.9% vs 2.1%) but barely changed the gastrocnemius (0.6-1.7% vs 9-12% standing; Kinoshita 2023).",
      "calves_l": "Soleus-biased plantarflexion: with the knee bent 90 degrees the two-joint gastrocnemius is slack. In a 12-week trial seated (knee 90 degrees) calf raises grew the soleus as much as standing raises (2.9% vs 2.1%) but barely changed the gastrocnemius (0.6-1.7% vs 9-12% standing; Kinoshita 2023).",
      "forearm_flexors_r": "Grip holds the dumbbells in place across the knees (clinical opinion).",
      "forearm_flexors_l": "Grip holds the dumbbells in place across the knees (clinical opinion).",
      "core": "Keeps the trunk tall on the bench (clinical opinion)."
    }
  },
