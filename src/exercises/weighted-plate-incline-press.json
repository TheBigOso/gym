    "id": "weighted-plate-incline-press",
    "name": "Weighted Plate Incline Press",
    "aliases": [
      "Incline plate press",
      "Plate press on incline bench",
      "Incline weight plate chest press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "25624",
      "title": "Weighted Plate Incline Press",
      "url": "https://gymvisual.com/videos/25624-weighted-plate-incline-press.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest (upper)",
    "secondaryBodyParts": [
      "Front shoulders",
      "Triceps"
    ],
    "equipment": [
      "Weight plate",
      "Adjustable bench (incline)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "triceps_r",
        "triceps_l"
      ],
      "stabilizer": [
        "serratus_r",
        "serratus_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core",
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "lengthened": [
        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the plate comes down to the chest, breathe out as you press it up.",
      "cadence": "About 2 s down, 1 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "tempo": "2-0-1-1",
      "load": "A 10-20 kg plate you can grip securely (RIR 1-3, clinical opinion)",
      "frequency": "2 times a week",
      "progression": "Heavier plate, then a pause at the chest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a bench set to about 30-45 degrees, feet flat; hold a plate by its rim at 3 and 9 o'clock, palms facing in, thumbs toward the head, the plate flat over the upper chest with the arms long."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the plate to the upper chest, elbows about 45 degrees from the body."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Plate just above the chest; squeeze the rim."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the plate back up over the shoulders."
      },
      {
        "id": "c5",
        "phase": "top",
        "text": "Arms long; keep the shoulder blades on the bench."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Loose grip on the rim",
        "fix": "Squeeze the plate hard the whole set; use a plate with a lip."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring to 90 degrees",
        "fix": "Keep them about 45 degrees from the body."
      },
      {
        "id": "m3",
        "mistake": "Bouncing off the chest",
        "fix": "Stop just above the chest."
      },
      {
        "id": "m4",
        "mistake": "Arching off the bench",
        "fix": "Keep the upper back and hips on the bench."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "30° back pad, flat seat",
        "peak": "Glutes on the seat, upper back and head on the pad",
        "norm": "About 30 degrees maximised upper-pectoralis activity in Rodriguez-Ridao 2020",
        "sources": [
          "rodriguez2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14° (arms long)",
        "peak": "≈124° at the bottom, elbows ≈55° from the trunk",
        "norm": "From nearly straight to about 110-125 degrees with the plate just over the chest; the narrow rim grip bends the elbows more than a bar press (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Rim at 3 and 9 o'clock, 37 cm between the grip points (40 cm plate)",
        "peak": "Steady within 1.1 cm; plate at least 5.5 cm off the body",
        "norm": "Rim held at 3 and 9 o'clock, palms in (about 37 cm apart for a 40 cm plate); the squeeze adds a pressing-in effort (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms long 0.6 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up",
        "norm": "About 2 s down, 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #25624, Weighted Plate Incline Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/25624-weighted-plate-incline-press.html"
      },
      {
        "id": "rodriguez2020",
        "title": "Rodríguez-Ridao, Antequera-Vique, Martín-Fuentes and Muyor 2020, effect of five bench inclinations on the electromyographic activity of the pectoralis major, anterior deltoid and triceps brachii during the bench press exercise (Int J Environ Res Public Health 17(19):7339; PMC7579505)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7579505/"
      },
      {
        "id": "calatayud2015",
        "title": "Calatayud, Borreani, Colado, Martin, Tella and Andersen 2015, bench press and push-up at comparable levels of muscle activity results in similar strength gains (J Strength Cond Res 29(1):246-253; elastic-band push-ups)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Calatayud+2015+bench+press+push-up+comparable+levels+muscle+activity"
      }
    ],
    "safety": {
      "cautions": [
        "Use a plate with a lip you can grip securely; never press it over the face.",
        "Shoulder pain: shorten the range (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Dumbbell hammer press on the same bench."
      ],
      "regressions": [
        "Flat floor plate press."
      ],
      "progressions": [
        "Heavier plate.",
        "Pause at the chest."
      ]
    },
    "muscleNotes": {
      "pec_r": "Brings the upper arm across and forward (pressing).",
      "pec_l": "Brings the upper arm across and forward (pressing).",
      "ant_deltoid_r": "Raises the upper arm forward.",
      "ant_deltoid_l": "Raises the upper arm forward.",
      "triceps_r": "Straightens the elbow.",
      "triceps_l": "Straightens the elbow.",
      "serratus_r": "Moves the shoulder blade forward around the ribs and holds it to the chest wall.",
      "serratus_l": "Moves the shoulder blade forward around the ribs and holds it to the chest wall.",
      "forearm_flexors_r": "Grip.",
      "forearm_flexors_l": "Grip.",
      "core": "Braces the trunk so the body stays in one line.",
      "infraspinatus_r": "Turns the upper arm out and steadies the shoulder.",
      "infraspinatus_l": "Turns the upper arm out and steadies the shoulder."
    }
