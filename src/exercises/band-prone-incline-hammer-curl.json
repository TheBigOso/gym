    },
    "type": "Strength",
    "bodyPart": "Biceps",
    "secondaryBodyParts": [
      "Forearms (brachioradialis)"
    ],
    "equipment": [
      "Resistance band (two)",
      "Adjustable bench",
      "Rack (band anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
