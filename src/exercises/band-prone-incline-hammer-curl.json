    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Chest or neck discomfort on the pad: lower the bench angle a little or pad the edge (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Neck discomfort: rest the chin on a folded towel at the top of the pad."
      ],
      "regressions": [
        "Lighter band.",
        "Standing band hammer curl."
      ],
      "progressions": [
        "Stronger band.",
        "Pause 2 s at the top.",
        "Dumbbell prone incline curl."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Bends the elbow with the upper arm in front of the trunk, where the biceps works hardest near the top of the curl (clinical opinion; Oliveira 2009 tested shoulder positions in curls); the hammer grip shares the work with the brachioradialis (Coratella 2023).",
      "biceps_l": "Bends the elbow with the upper arm in front of the trunk, where the biceps works hardest near the top of the curl (clinical opinion; Oliveira 2009 tested shoulder positions in curls); the hammer grip shares the work with the brachioradialis (Coratella 2023).",
      "forearm_flexors_r": "Brachioradialis is strongly involved with the neutral grip (Coratella 2023; Marcolin 2018), and the hand grips the band.",
      "forearm_flexors_l": "Brachioradialis is strongly involved with the neutral grip (Coratella 2023; Marcolin 2018), and the hand grips the band.",
      "forearm_extensors_r": "Steady the wrist in neutral.",
      "forearm_extensors_l": "Steady the wrist in neutral.",
      "ant_deltoid_r": "Holds the upper arm vertical as the forearm rises.",
      "ant_deltoid_l": "Holds the upper arm vertical as the forearm rises.",
      "post_deltoid_r": "Stops the upper arm swinging forward.",
      "post_deltoid_l": "Stops the upper arm swinging forward.",
      "rhomboids_midtrap_r": "Hold the shoulder blades steady on the pad.",
      "rhomboids_midtrap_l": "Hold the shoulder blades steady on the pad.",
      "core": "Holds the trunk on the pad."
    }
