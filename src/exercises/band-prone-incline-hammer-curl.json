    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl up, breathe in as you lower.",
      "cadence": "About 1 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1",
      "progression": "More reps, a longer squeeze, a stronger band."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie chest-down on a bench set to about 40 degrees, chin just over the top, balls of the feet on the floor behind. A rack stands under the hands with a band looped low round each upright; hold a band end in each hand, arms hanging straight down, palms facing in."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl both hands up toward the shoulders, thumbs leading, upper arms still and vertical."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze at the top; chest stays on the pad."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly against the band to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the arms hanging straight, then curl again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arms swinging back to help the curl",
        "fix": "Keep the upper arms vertical and still."
      },
      {
        "id": "m2",
        "mistake": "Lifting the chest off the pad",
        "fix": "Keep the chest on the pad and the neck long."
      },
      {
        "id": "m3",
        "mistake": "Turning the palms up",
        "fix": "Keep the thumbs leading and the palms facing in throughout."
      },
      {
        "id": "m4",
        "mistake": "Stopping short of straight arms",
        "fix": "Lower all the way down each rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈5° (arms hanging straight)",
        "peak": "≈128° at the top",
        "norm": "From straight to about 125-135 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm rotation",
        "setup": "84° (neutral, thumb forward)",
        "peak": "84.6° (neutral, thumb back toward the shoulder)",
        "norm": "Neutral (thumbs up) throughout; the hammer grip shifts work to the brachioradialis (Coratella 2023; Marcolin 2018).",
        "sources": [
          "coratella2023",
          "marcolin2018"
        ]
      },
      {
        "measure": "Upper arm",
        "setup": "≈7° from vertical (hanging), ≈54° from the trunk line",
        "peak": "Unchanged (moves ≈0°)",
        "norm": "Vertical and still, in front of the trunk line: the shortened-biceps position of the prone (spider) curl (Oliveira 2009 tested shoulder positions in curls).",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Chest on the pad",
        "setup": "Chest on the 40° pad (80 cm), seat 45 cm; head 5.6 cm past the top edge",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "Chest supported on the pad so the trunk cannot swing (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "One band per hand, looped round the rack uprights 10 cm off the floor, 96 cm apart, 25 cm behind the hands; strands 43.9 cm",
        "peak": "Strands 97.8 cm at the top",
        "norm": "Looped low round the rack uprights, so the strands run down and back from the hands and resist the whole curl (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.6 s",
        "peak": "1.1 s up, 0.4 s squeeze, 1.8 s down, 0.4 s pause",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Prone Incline Hammer Curl, video (movement reference)",
