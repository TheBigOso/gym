  "exercise": {
    "id": "dip-on-floor-with-chair",
    "name": "Dip on Floor with Chair",
    "aliases": [
      "Chair dip",
      "Chair triceps dip"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "012539",
      "title": "Dip on Floor with Chair",
      "url": "https://gymvisual.com/videos/12539-dip-on-floor-with-chair.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper arms (triceps)",
    "secondaryBodyParts": [
      "Front shoulders",
      "Chest"
    ],
    "equipment": [
      "Chair (stable, against a wall)",
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (elbow extension, shoulder extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "pec_r",
        "pec_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale on the way down, exhale as you press up.",
      "cadence": "About 2 s down, a short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "2 s down, brief pause, 1-1.5 s up",
      "frequency": "2-3 times a week",
      "progression": "Feet further away, then a pause at the bottom, then a slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hands on the front edge of a stable chair behind you, fingers forward; walk the feet out with the legs nearly straight, heels on the floor, arms straight."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows straight back, lowering the hips."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause at the bottom without sitting down."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Press back up until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Shoulders down; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shrugging the shoulders to the ears",
        "fix": "Keep the shoulders down and back."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Point the elbows straight back."
      },
      {
        "id": "m3",
        "mistake": "Pushing with the legs",
        "fix": "Let the arms do the work."
      },
      {
        "id": "m4",
        "mistake": "Going too deep",
        "fix": "Stop when the shoulders feel a stretch, about parallel upper arms at most."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈10° (straight, not locked)",
        "peak": "≈110° at the bottom",
        "norm": "Arms straight but not locked at the top to about 90 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder extension",
        "setup": "≈20° (upper arm behind the trunk line)",
        "peak": "≈86° at the bottom",
        "norm": "Bench dips reached about 101% of the maximal shoulder extension range (McKenzie 2022); keep the range comfortable",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Upper arm angle to the floor",
        "setup": "≈66° (arm pointing down and back)",
        "peak": "≈0° at the bottom",
        "norm": "Stop with the upper arms at or above parallel (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip travel",
        "setup": "Hips 56 cm above the floor",
        "peak": "23 cm down (buttocks 25 cm off the floor at the lowest)",
        "norm": "Hips move straight down and up close to the hands (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #012539, Dip on Floor with Chair, video (movement reference)",
        "url": "https://gymvisual.com/videos/12539-dip-on-floor-with-chair.html"
      },
      {
        "id": "mckenzie2022",
        "title": "McKenzie, Crowley-McHattan, Meir, Whitting and Volschenk 2022, bench, bar, and ring dips: do kinematics and muscle activity differ? (Int J Environ Res Public Health 19(20):13211; PMC9603242)",
        "url": "https://www.mdpi.com/1660-4601/19/20/13211"
      },
      {
        "id": "boehler2011",
        "title": "Boehler 2011, electromyographic analysis of the triceps brachii muscle during a variety of triceps exercises (MS thesis, University of Wisconsin-La Crosse)",
        "url": "https://minds.wisc.edu/items/4876923b-3a14-47c3-9a69-decf731bd027"
      }
    ],
    "safety": {
      "cautions": [
        "Use a chair that cannot slide or tip: put it against a wall.",
        "Shoulder: dips with the hands behind take the shoulder to the end of its extension range (McKenzie 2022); stop if the front of the shoulder hurts.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Bend the knees to make it easier."
      ],
      "regressions": [
        "Bench dip on the floor."
      ],
      "progressions": [
        "Feet on a second chair."
      ]
    },
    "muscleNotes": {
      "triceps": "Triceps straighten the elbows to lift the body; bench-style dips take the shoulder far into extension (McKenzie 2022)."
    }
  },
