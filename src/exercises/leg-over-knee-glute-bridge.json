        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5534144/"
      },
      {
        "id": "ekstrom2007",
        "title": "Electromyographic analysis of core trunk, hip and thigh muscles during 9 rehabilitation exercises (J Orthop Sports Phys Ther 2007; PubMed 18560185)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/18560185/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      }
    ],
    "safety": {
      "cautions": [
        "Hip or knee discomfort in the crossed position: uncross and do a single-leg bridge with the free knee held up.",
        "Low back discomfort: lift less high and brace first.",
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Too hard: both feet down (glute bridge) with the crossed leg resting lightly."
      ],
      "regressions": [
        "Glute bridge.",
        "Glute bridge march."
      ],
      "progressions": [
        "Single-leg bridge.",
        "Single-leg hip thrust."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main target: lifts the pelvis on one leg; single-leg bridging is one of the higher gluteus maximus exercises (Ekstrom 2007; Boren 2011).",
      "hamstrings_r": "Assist hip extension on the working side.",
      "glute_med_r": "Keeps the pelvis level on one leg (Boren 2011 ranked single-leg bridging high for gluteus medius).",
      "adductors_r": "Assist hip extension.",
      "quads_r": "Hold the working knee angle.",
      "core": "Bracing resists pelvic rotation.",
      "obliques_r": "Stop the crossed side from dropping.",
      "obliques_l": "Stop the crossed side from dropping.",
      "spinal_extensors_r": "Hold the trunk straight without over-arching.",
      "spinal_extensors_l": "Hold the trunk straight without over-arching.",
      "glute_max_l": "Lengthened by the figure-4 crossed position.",
      "glute_med_l": "Lengthened by the figure-4 crossed position."
    }
