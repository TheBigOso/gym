  "exercise": {
    "id": "leg-over-knee-glute-bridge",
    "name": "Leg Over Knee Glute Bridge",
    "aliases": [
      "Figure-4 glute bridge",
      "Crossed-leg glute bridge",
      "Single-leg figure-four bridge"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "10854",
      "title": "Leg Over Knee Glute Bridge (male)",
      "url": "https://gymvisual.com/videos/10854-leg-over-knee-glute-bridge-male.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (hamstrings)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (single-leg hip extension)",
    "plane": "Sagittal",
    "laterality": "Unilateral (right leg works; left ankle crossed over the right knee)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r"
      ],
      "synergist": [
        "hamstrings_r",
        "glute_med_r",
        "adductors_r"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "quads_r",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "lengthened": [
        "glute_max_l",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you drive up through the planted heel, inhale as you lower.",
      "cadence": "About 1.5 s up, 1 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per side",
      "tempo": "1.5-1-2-0",
      "frequency": "2-3 times a week",
      "progression": "Longer squeeze, then single-leg bridge with the free leg straight, then single-leg hip thrust"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, right foot flat, left ankle crossed over the right knee (figure 4), arms by your sides."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out, press through the right heel and drive the hips up."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Knee, hip and shoulder in one line; keep the pelvis level, do not let the crossed side drop."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch down lightly, repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pelvis dropping or twisting toward the crossed leg",
        "fix": "Brace and squeeze the working glute; keep both hip bones level."
      },
      {
        "id": "m2",
        "mistake": "Pushing through the toes",
        "fix": "Drive through the heel of the planted foot."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back",
        "fix": "Ribs down, stop at a straight line."
      },
      {
        "id": "m4",
        "mistake": "Ankle resting on the kneecap",
        "fix": "Rest the outer ankle just above the knee on the thigh."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "Right ≈54° (lying)",
        "peak": "Right ≈-5° (line 180°)",
        "norm": "Working hip extends to about neutral at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "Right ≈106°",
        "peak": "Right ≈90° at the top",
        "norm": "About 90 degrees on the working leg at the top (Lehecka 2017 traditional bridge position)",
        "sources": [
          "lehecka2017"
        ]
      },
      {
        "measure": "Crossed leg",
        "setup": "Left hip flex 105°, abduction 26°, rotation -38°, knee 129°",
        "peak": "At the top: hip flex 45°, abduction 27°, rotation -38°, knee 129°; shin resting on the right thigh (gap 0.3 to 0.4 cm)",
        "norm": "Outer ankle rests on the thigh just above the knee; the crossed hip turns out (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip height",
        "setup": "Hip joint 8.6 cm above the floor",
        "peak": "29.4 cm (+20.8 cm)",
        "norm": "Pelvis lifts until the working knee, hip and shoulder line up (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Lying 0.8 s",
        "peak": "1.5 s up, 1.0 s squeeze, 2.0 s down, 0.7 s reset",
        "norm": "About 1.5 s up, a 1 s squeeze, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #10854, Leg Over Knee Glute Bridge (male) (movement reference only)",
        "url": "https://gymvisual.com/videos/10854-leg-over-knee-glute-bridge-male.html"
      },
      {
        "id": "lehecka2017",
