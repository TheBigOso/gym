    "breathing": {
      "pattern": "Breathe in and brace at the top, lower; breathe out as you pass the hardest part of the rise.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbell, a 2 s pause at the bottom, then a front squat. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hold one dumbbell upright against the chest, both hands cupping the top plate, elbows down. Feet about shoulder width, toes slightly out."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, brace, sit down between the heels; knees follow the toes, chest stays up."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs parallel or a bit lower, elbows just inside the knees, heels down."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the floor away and stand tall; breathe out near the top."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, reset the brace, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dumbbell drifting away from the chest",
        "fix": "Keep it touching the sternum; the elbows stay under it."
      },
      {
        "id": "m2",
        "mistake": "Knees caving inward",
        "fix": "Push the knees out over the toes; the elbows can nudge them at the bottom."
      },
      {
        "id": "m3",
        "mistake": "Heels lifting",
        "fix": "Sit back between the heels; shorten the depth or widen the stance slightly."
      },
      {
        "id": "m4",
        "mistake": "Rounding the back at the bottom",
        "fix": "Stop above the depth where the pelvis tucks; keep the chest up."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "39 cm (≈1.0x the rig's 40 cm shoulder width), toes out 18°",
        "peak": "Unchanged",
        "norm": "About shoulder width, toes out about 15-20 degrees (common coaching; Zawadka 2020 used shoulder width)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈1°",
        "peak": "≈118°",
        "norm": "About 100-120 degrees with the thighs at parallel or a bit below (clinical opinion); depth is driven mostly by knee range (Zawadka 2020)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈0°",
        "peak": "≈124° (joint channel, as in the HUD)",
        "norm": "Not specified by the sources for this depth",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈23° forward",
        "norm": "More upright than a back squat because the load is in front (clinical opinion); more lean moves demand from knee to hip (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Dumbbell",
        "setup": "Upright at the sternum, hands cupping the top plate",
        "peak": "Clear of the chest and thighs (≥2.71 cm on the rig shapes); elbows 7.4 cm inside the knee joint centres",
        "norm": "Held upright at the sternum, elbows down (common coaching; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "About 2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
