      "Flat bench",
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip extension with the hips abducted and turned out)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
