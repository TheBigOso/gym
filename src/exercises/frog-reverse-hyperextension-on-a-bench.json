      ]
    },
    "breathing": {
      "pattern": "Exhale as you lift, inhale as you lower.",
      "cadence": "About 1.2 s up, a short squeeze, about 1.8 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "tempo": "1 s up, 1 s squeeze, 2 s down",
      "frequency": "2-3 times a week",
      "progression": "Pause at the top, then ankle weights or a band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down on a flat bench with the hips at the end, legs hanging off it; knees bent and out, heels together; hold the sides of the bench."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Squeeze the glutes and lift the thighs to about level with the bench, heels together."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Hold briefly without arching the low back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the legs slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Legs hang; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to lift higher",
        "fix": "Stop with the thighs about level with the bench."
      },
      {
        "id": "m2",
        "mistake": "Swinging the legs",
        "fix": "Lift and lower under control."
      },
      {
        "id": "m3",
        "mistake": "Heels drifting apart",
        "fix": "Keep the heels pressed together."
      },
      {
        "id": "m4",
        "mistake": "Hips sliding off the bench",
        "fix": "Hold the bench firmly; hip crease at the edge."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip extension",
        "setup": "≈62° of hip flexion (legs hanging off the bench)",
        "peak": "≈-6° (thighs about level with the bench)",
        "norm": "From hanging (about 60 degrees of hip flexion) to about level (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Frog position",
        "setup": "Hips abducted 30° and turned out (39°), knees ≈110°, ankles 3 cm apart",
        "peak": "Unchanged through the lift",
        "norm": "Hips abducted and externally rotated, knees bent, heels together (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk on the bench",
        "setup": "Chest and stomach on the pad, hands holding its sides",
        "peak": "Trunk still",
        "norm": "Hip extension variations load the glutes (Contreras 2015)",
        "sources": [
          "contreras2015"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #009995, Frog Reverse Hyperextension (on a bench), animated GIF (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/9995-frog-reverse-hyperextension-on-a-bench-male.html"
      },
      {
        "id": "contreras2015",
        "title": "Contreras, Vigotsky, Schoenfeld, Beardsley & Cronin 2015, a comparison of gluteus maximus, biceps femoris and vastus lateralis EMG in the back squat and barbell hip thrust (J Appl Biomech 31(6):452-458)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26214739/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Low-back pain: keep the lift small and avoid arching.",
        "Hip pain in the frog position: narrow the knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Smaller lift."
      ],
      "regressions": [
        "Prone frog pumps on the floor."
      ],
      "progressions": [
        "Ankle weights.",
        "Longer squeeze."
      ]
    },
    "muscleNotes": {
      "glute_max": "Hip extension with the hips turned out and abducted (frog position) favours gluteus maximus over the hamstrings (Contreras 2015 on hip extension variations; clinical opinion for the frog stance).",
      "hamstrings": "Bent knees shorten the hamstrings so they contribute less."
    }
