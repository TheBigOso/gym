{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "band-lying-leg-curl",
    "name": "Band Lying Leg Curl",
    "aliases": [
      "Prone mini band hamstring curl",
      "Banded lying leg curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "22589",
      "title": "Band Lying Leg Curl",
      "url": "https://gymvisual.com/videos/22589-band-lying-leg-curl.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (hamstrings)",
    "secondaryBodyParts": [
      "Calves"
    ],
    "equipment": [
      "Resistance band (mini loop around the ankles)",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (knee flexion)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "hamstrings_r"
      ],
      "synergist": [
        "calves_r"
      ],
      "stabilizer": [
        "glute_max_r",
        "core"
      ],
      "lengthened": [
        "quads_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the heel curls in, inhale as it lowers.",
      "cadence": "About 1.2 s in, 0.5 s hold, 1.8 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Stronger band, or a longer squeeze"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down, band around both ankles, arms resting overhead, legs long."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the right heel toward the glutes, foot flexed."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the hamstrings; hips stay on the mat."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the leg slowly against the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stop just before the foot touches; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the hips",
        "fix": "Press the hip bones into the mat."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back",
        "fix": "Brace the abs; only the knee moves."
      },
      {
        "id": "m3",
        "mistake": "Pointing the toes",
        "fix": "Keep the foot flexed so the hamstrings lead."
      },
      {
        "id": "m4",
        "mistake": "Dropping the leg",
        "fix": "Lower over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈16° (foot just off the mat)",
        "peak": "≈112°",
        "norm": "From near straight to about 100-120 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hips",
        "setup": "Pelvis and thighs on the mat",
        "peak": "Unchanged (only the knee moves)",
        "norm": "Pelvis and thighs stay on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Around both ankles (30 cm apart)",
        "peak": "Stretched to 66 cm",
        "norm": "Mini loop around both ankles; the resting leg anchors it (elastic resistance, Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Lie 0.8 s",
        "peak": "1.2 s in, 0.5 s hold, 1.8 s down",
        "norm": "Controlled, slower down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #22589, Band Lying Leg Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/22589-band-lying-leg-curl.html"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjørnlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Andersen+2010+muscle+activation+perceived+loading+dumbbells+elastic+resistance"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the band for nicks before use.",
        "Hamstring cramp: stop, stretch, use a lighter band."
      ],
      "modify": [
        "Low-back discomfort: a folded towel under the hips."
      ],
      "regressions": [
        "Leg curl without a band."
      ],
      "progressions": [
        "Heavier band.",
        "Dumbbell lying femoral."
      ]
    },
    "muscleNotes": {
      "hamstrings_r": "Flex the knee against the band (clinical opinion).",
      "calves_r": "Gastrocnemius assists knee flexion (clinical opinion).",
      "glute_max_r": "Keeps the hip pressed into the mat (clinical opinion).",
      "core": "Stops the low back arching (clinical opinion).",
      "quads_r": "Lengthen as the heel nears the glutes (clinical opinion)."
    }
  },
