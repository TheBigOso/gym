    "id": "barbell-standing-single-leg-calf-raise",
    "name": "Barbell Standing Single Leg Calf Raise",
    "aliases": [
      "Single-leg barbell calf raise",
      "One-leg barbell calf raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "22219",
      "title": "Barbell Standing Single Leg Calf Raise",
      "url": "https://gymvisual.com/videos/22219-barbell-standing-single-leg-calf-raise.html",
      "listing": "Video (title from the listing URL; the page could not be fetched from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Calves",
    "secondaryBodyParts": [],
    "equipment": [
      "Barbell",
      "Squat rack"
    ],
    "difficulty": "Advanced",
    "mechanics": "Isolation (ankle)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "calves_r"
      ],
      "synergist": [],
      "stabilizer": [
        "glute_med_r",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "hamstrings_l",
        "upper_traps_r",
        "upper_traps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the heel rises, inhale as it lowers.",
      "cadence": "About 1 s up, 0.8 s pause, 1.8 s down"
    },
    "prescription": {
      "sets": "3 per leg",
      "reps": "8-15",
      "tempo": "1-1-2-0",
      "frequency": "2-3 times a week",
      "load": "Barbell load is user-chosen and light: balance limits it before the calf does. Pick a weight that leaves about 2-3 reps in reserve (RPE 7-8).",
      "progression": "Heavier bar, then the ball of the foot on a low step for a deeper range"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Take the bar out of the rack onto the upper back (as for a back squat), hands just outside the shoulders. Stand on the right foot, left foot lifted behind with the knee bent, body tall."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Breathe out and rise as high as you can onto the ball of the right foot."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the top; stand tall, ankle straight, weight over the big toe."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the heel slowly to the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch down lightly and repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Losing balance with a heavy bar",
        "fix": "Go lighter, stand inside a rack with the safeties set, or hold a support with one hand and use dumbbells instead."
      },
      {
        "id": "m2",
        "mistake": "Ankle rolling out",
        "fix": "Keep the pressure through the big and second toes."
      },
      {
        "id": "m3",
        "mistake": "Bending the knee to bounce",
        "fix": "Knee straight but soft; slow lowering, pause at the top."
      },
      {
        "id": "m4",
        "mistake": "Hips swaying to the side",
        "fix": "Squeeze the glutes and keep the pelvis level over the standing foot."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle plantarflexion",
        "setup": "≈-8° (foot flat)",
        "peak": "≈20° (foot 30° heel-up)",
        "norm": "Full range to as high as possible (clinical opinion); the heel-rise test counts only full-height rises (Hébert-Losier 2017)",
        "sources": [
          "heberlosier2017"
        ]
      },
      {
        "measure": "Heel height",
        "setup": "0 cm (heel down)",
        "peak": "≈9.5 cm",
        "norm": "As high as possible each rep (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "Standing knee ≈4°, free knee ≈80° (foot lifted behind)",
        "peak": "Standing knee ≈4°",
        "norm": "Straight but not locked (clinical opinion); knee angle did not change triceps surae fatigue in single-leg heel raises at 0 vs 45 degrees (Hébert-Losier 2012)",
        "sources": [
          "heberlosier2012"
        ]
      },
      {
        "measure": "Bar position",
        "setup": "High bar on the upper traps, 80 cm grip (handle centres); body + bar centre of mass 5 cm ahead of the ankle",
        "peak": "Centre of mass 1.5 cm behind the ball of the foot at the top (pelvis shifted 10.9 cm over the standing foot)",
        "norm": "High on the upper back as in a back squat, hands just outside the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.0 s up, 0.8 s pause, 1.8 s down, 0.6 s reset",
        "norm": "About 1 s up, a short pause, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Barbell Standing Single Leg Calf Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/22219-barbell-standing-single-leg-calf-raise.html"
      },
      {
        "id": "heberlosier2017",
        "title": "Hébert-Losier, Wessman, Alricsson & Svantesson 2017, updated reliability and normative values for the standing heel-rise test in healthy adults (Physiotherapy; doi 10.1016/j.physio.2017.03.002; PubMed 28886865)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/28886865/"
      },
      {
        "id": "heberlosier2012",
        "title": "Hébert-Losier, Schneiders, García, Sullivan & Simoneau 2012, influence of knee flexion angle and age on triceps surae muscle fatigue during heel raises (J Strength Cond Res 26(11))",
        "url": "https://epublications.marquette.edu/phys_therapy_fac/29"
      },
      {
        "id": "kinoshita2023",
        "title": "Kinoshita, Maeo et al. 2023, triceps surae muscle hypertrophy is greater after standing versus seated calf-raise training (Front Physiol 14:1272106)",
        "url": "https://www.frontiersin.org/articles/10.3389/fphys.2023.1272106/full"
      }
    ],
    "safety": {
      "cautions": [
        "Balance on one leg with a bar on the back is the hard part: start very light, work inside a rack with the safety arms set at shoulder height, and stop the set if you wobble.",
        "Unrack and re-rack the bar with both feet on the floor.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Balance trouble: hold a dumbbell in one hand and steady yourself on a wall or rack with the other.",
        "Achilles pain: smaller range and lighter load, slow tempo."
      ],
      "regressions": [
        "Single-leg dumbbell calf raise with a hand on the wall.",
        "Two-leg barbell calf raise."
      ],
      "progressions": [
        "Heavier bar.",
        "Ball of the foot on a low step for a deeper stretch."
      ]
    },
    "muscleNotes": {
      "calves_r": "Whole triceps surae with the knee straight; one leg carries the body weight plus the bar. Standing (knee straight) training grew the gastrocnemius far more than seated training (Kinoshita 2023).",
      "glute_med_r": "Keeps the pelvis level on one leg (clinical opinion).",
      "core": "Holds the trunk tall and stiff under the bar (clinical opinion).",
      "spinal_extensors_r": "Keep the back upright under the bar (clinical opinion).",
      "spinal_extensors_l": "Keep the back upright under the bar (clinical opinion).",
      "hamstrings_l": "Hold the free knee bent behind (clinical opinion).",
      "upper_traps_r": "The shelf the bar rests on (clinical opinion).",
      "upper_traps_l": "The shelf the bar rests on (clinical opinion)."
    }
  },
