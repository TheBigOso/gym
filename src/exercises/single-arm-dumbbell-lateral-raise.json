      "url": "https://gymvisual.com/videos/9224-dumbbell-one-arm-lateral-raise.html",
      "listing": "Video; data sheet: body part Shoulders, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (lateral deltoid)",
    "secondaryBodyParts": [
      "Upper back (trapezius)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "obliques_r",
        "obliques_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down (Coratella 2020 used 2-0.5-2)"
    },
    "prescription": {
      "sets": "2-4 per arm",
      "reps": "10-20",
      "effort": "Stop 0-3 reps short of failure (RIR 0-3)",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds; Coratella 2020)",
      "rest": "30-60 s between arms",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbell; light: the arm is a long lever",
      "progression": "Add reps, then 1-2 kg; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet about hip width, knees soft, ribs down and glutes lightly braced. Dumbbell beside the right thigh, palm in, elbow soft; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the arm out to the side, a little in front of the body, thumb forward."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at about shoulder height, elbow level with the hand; shoulder down, away from the ear."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s; no leaning or swinging."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause at the side and repeat; switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning away and swinging the weight up",
        "fix": "Stand tall, brace the side of the trunk, use a lighter dumbbell."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulder toward the ear",
        "fix": "Reach the hand long and out; keep the shoulder blade down."
      },
      {
        "id": "m3",
        "mistake": "Raising well above shoulder height",
        "fix": "Stop at about 90 degrees; lateral raises above 90 degrees were linked to impingement signs (impingement study 2014)."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "≈8° (dumbbell clear of the thigh)",
        "peak": "≈88° (elbow at shoulder height, 1 cm)",
        "norm": "From the side to about 90 degrees (the range used by Coratella 2020); raises above 90 degrees were associated with impingement signs (impingement study 2014)",
        "sources": [
          "coratella2020",
          "impinge2014"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈32° in front of the frontal plane",
        "peak": "≈34°",
        "norm": "About 30 degrees in front of the frontal plane (scapular plane; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈18°",
        "norm": "Elbow soft, about 10-20 degrees, held constant (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "upright, left hand on the hip",
        "peak": "unchanged (no lean away)",
        "norm": "Upright, no lean away from the dumbbell (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the side",
        "peak": "1.8 s up, 0.4 s at the top, 2.0 s down",
        "norm": "2 s up, 0.5 s pause, 2 s down in Coratella 2020",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #035512, Dumbbell One Arm Lateral Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/9224-dumbbell-one-arm-lateral-raise.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://johk.pl/?p=5707"
      },
      {
        "id": "impinge2014",
        "title": "Characteristics of shoulder impingement in the recreational weight-training population (J Strength Cond Res 2014;28(4):1081-1089, PubMed 24077379)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/24077379/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Pinching at the top: raise only to about 70-80 degrees and keep the thumb up a little.",
        "Balance: hold a post or rack with the free hand."
      ],
      "regressions": [
        "Lighter dumbbell.",
        "Bent-arm lateral raise (shorter lever).",
        "Seated lateral raise."
      ],
      "progressions": [
        "Lean-away lateral raise holding a post.",
        "Slower lowering (3 s) or a 2 s hold at the top.",
        "Cable lateral raise."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Main mover. The lateral raise gave the highest medial deltoid activity of the exercises tested (Campos 2020); a neutral humerus (\"thumbs forward\") gave the highest medial deltoid activity in the lifting phase (Coratella 2020).",
      "lat_deltoid_l": "Main mover. The lateral raise gave the highest medial deltoid activity of the exercises tested (Campos 2020); a neutral humerus (\"thumbs forward\") gave the highest medial deltoid activity in the lifting phase (Coratella 2020).",
      "ant_deltoid_r": "Helps, more so if the arm drifts forward or the thumb turns up (Coratella 2020).",
      "ant_deltoid_l": "Helps, more so if the arm drifts forward or the thumb turns up (Coratella 2020).",
      "post_deltoid_r": "Helps lift the arm; the lateral raise also gave the highest posterior deltoid activity of the exercises tested (Campos 2020).",
      "post_deltoid_l": "Helps lift the arm; the lateral raise also gave the highest posterior deltoid activity of the exercises tested (Campos 2020).",
      "upper_traps_r": "Upward rotation of the shoulder blade near the top; shrugging adds more trapezius and less deltoid (clinical opinion).",
      "upper_traps_l": "Upward rotation of the shoulder blade near the top; shrugging adds more trapezius and less deltoid (clinical opinion).",
      "serratus_r": "Upward rotation of the shoulder blade.",
      "serratus_l": "Upward rotation of the shoulder blade.",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred.",
      "obliques_r": "Keep the trunk from leaning away from the dumbbell (clinical opinion).",
      "obliques_l": "Keep the trunk from leaning away from the dumbbell (clinical opinion).",
      "core": "Keeps the trunk still."
    }
  },
