  "exercise": {
    "id": "donkey-calf-raise",
    "name": "Donkey Calf Raise",
    "aliases": [
      "Bent-over calf raise",
      "Hip-hinged calf raise",
      "Donkey heel raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "028412",
      "title": "Donkey Calf Raise",
      "url": "https://gymvisual.com/videos/8707-donkey-calf-raise.html",
      "listing": "Video; data sheet: body part Calves, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Calves",
    "secondaryBodyParts": [],
    "equipment": [
      "Body weight",
      "Bench (hand support)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (ankle plantarflexion, knees straight, hips hinged)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "calves_r",
        "calves_l"
      ],
      "synergist": [],
      "stabilizer": [
        "hamstrings_r",
        "hamstrings_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the heels rise, inhale as they lower.",
      "cadence": "About 1 s up, 0.8 s pause, 1.8 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "15-20",
      "tempo": "1-1-2-0",
      "frequency": "2-3 times a week",
      "progression": "Balls of the feet on a step, then single-leg, then a weight belt or a partner on the hips"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hands on a bench, hinge at the hips until the back is nearly level; feet hip width under the hips, knees straight but soft."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Breathe out and rise as high as you can onto the balls of the feet."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the top; back flat, hips stay hinged."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the heels slowly to the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch down and repeat without bouncing."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the knees to push up",
        "fix": "Knees stay straight but soft; the ankles do the work."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back",
        "fix": "Hinge from the hips with a flat back; raise the hands on a higher support if the hamstrings are tight."
      },
      {
        "id": "m3",
        "mistake": "Rocking the body forward instead of rising",
        "fix": "Rise straight up over the balls of the feet; the hands only steady you."
      },
      {
        "id": "m4",
        "mistake": "Short bouncy reps",
        "fix": "Full range with a pause at the top."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle plantarflexion",
        "setup": "≈0° (feet flat)",
        "peak": "≈32° (feet 32° heel-up)",
        "norm": "Full range from heels down to as high as possible (clinical opinion); knee-straight raises bias the gastrocnemius (Kinoshita 2023)",
        "sources": [
          "kinoshita2023"
        ]
      },
      {
        "measure": "Heel height",
        "setup": "0 cm (heels down)",
        "peak": "≈10 cm",
        "norm": "As high as possible each rep (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip hinge",
        "setup": "Hip ≈85° flexion, trunk ≈11° above level",
        "peak": "Hip ≈91°, trunk ≈5° above level (shoulders keep their distance to the hands)",
        "norm": "Trunk near level, hips flexed about 80-90 degrees (traditional donkey position; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈5°",
        "peak": "≈5°",
        "norm": "Straight but not locked, as in the standing training condition of Kinoshita 2023",
        "sources": [
          "kinoshita2023"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Heels down 0.8 s",
        "peak": "1.0 s up, 0.8 s pause, 1.8 s down, 0.6 s reset",
        "norm": "About 1-2 s up and 2 s down (Kinoshita 2023 used 2 s each way)",
        "sources": [
          "kinoshita2023"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #028412, Donkey Calf Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/8707-donkey-calf-raise.html"
      },
      {
        "id": "kinoshita2023",
        "title": "Kinoshita, Maeo et al. 2023, triceps surae muscle hypertrophy is greater after standing versus seated calf-raise training (Front Physiol 14:1272106)",
        "url": "https://www.frontiersin.org/articles/10.3389/fphys.2023.1272106/full"
      },
      {
        "id": "heberlosier2012",
        "title": "Hébert-Losier, Schneiders, García, Sullivan & Simoneau 2012, influence of knee flexion angle and age on triceps surae muscle fatigue during heel raises (J Strength Cond Res 26(11))",
        "url": "https://epublications.marquette.edu/phys_therapy_fac/29"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Make sure the bench cannot slide away from the hands."
      ],
      "modify": [
        "Tight hamstrings or low back discomfort: hands on a higher support, less hinge.",
        "Achilles pain: smaller range, slower tempo."
      ],
      "regressions": [
        "Standing calf raise with hands on a wall.",
        "Partial range."
      ],
      "progressions": [
        "Balls of the feet on a step for a deeper stretch.",
        "Single-leg donkey calf raise.",
        "Weight belt or a partner sitting on the hips."
      ]
    },
    "muscleNotes": {
      "calves_r": "Straight knees keep the gastrocnemius long and working with the soleus. Standing (knee straight) calf raises grew the gastrocnemius far more than seated raises (9-12% vs about 1-2%) in Kinoshita 2023. The hip hinge itself is not studied there; that it loads the gastrocnemius at a longer length is clinical opinion.",
      "calves_l": "Straight knees keep the gastrocnemius long and working with the soleus. Standing (knee straight) calf raises grew the gastrocnemius far more than seated raises (9-12% vs about 1-2%) in Kinoshita 2023. The hip hinge itself is not studied there; that it loads the gastrocnemius at a longer length is clinical opinion.",
      "hamstrings_r": "Lengthened and holding the hinge with straight knees (clinical opinion).",
      "hamstrings_l": "Lengthened and holding the hinge with straight knees (clinical opinion).",
      "spinal_extensors_r": "Hold a flat back over the hips (clinical opinion).",
      "spinal_extensors_l": "Hold a flat back over the hips (clinical opinion).",
      "core": "Braces the trunk while the hands support part of the body weight (clinical opinion).",
      "triceps_r": "Keep the elbows straight on the bench (clinical opinion).",
      "triceps_l": "Keep the elbows straight on the bench (clinical opinion)."
    }
  },
