      },
      {
        "id": "swinton2011",
        "title": "Swinton et al. 2011, a biomechanical analysis of straight and hexagonal barbell deadlifts using submaximal loads (J Strength Cond Res 25(7):2000-2009)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21659894/"
      },
      {
        "id": "stewart2008",
        "title": "Stewart & Stewart-Menteth 2008, comparative kinematic analysis of the deadlift with an Olympic bar and a Troy-Hex bar (J Sports Sci 26(2))",
        "url": "https://researchportal.northumbria.ac.uk/en/publications/a-comparative-kinematic-analysis-of-the-deadlift-performed-using-/"
      },
      {
        "id": "lee2018",
        "title": "Lee et al. 2018, an electromyographic and kinetic comparison of conventional and Romanian deadlifts (J Exerc Sci Fit; PMC6323186)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/30662500/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: keep the range above pain and the back flat; seek advice if pain persists."
      ],
      "modify": [
        "Limited hip or ankle mobility: touch the dumbbells to a low step or blocks.",
        "Knee pain: hinge a little more and bend the knees a little less."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Touch down on a low step.",
        "Bodyweight hip hinge."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Trap-bar deadlift.",
        "Dumbbell Romanian deadlift for the hamstrings."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Hip extensor: drives the hips through as you stand.",
      "glute_max_l": "Hip extensor: drives the hips through as you stand.",
      "quads_r": "Extend the knees off the floor; dumbbells beside the feet (like a hex bar) shift more of the lift to the knees than a straight-bar deadlift (Swinton 2011).",
      "quads_l": "Extend the knees off the floor; dumbbells beside the feet (like a hex bar) shift more of the lift to the knees than a straight-bar deadlift (Swinton 2011).",
      "hamstrings_r": "Hip extensors with the glutes.",
      "hamstrings_l": "Hip extensors with the glutes.",
      "spinal_extensors_r": "Keep the back flat under load. A hex-bar style deadlift allowed a more upright trunk and lower erector spinae activity than a straight bar (Stewart 2008).",
      "spinal_extensors_l": "Keep the back flat under load. A hex-bar style deadlift allowed a more upright trunk and lower erector spinae activity than a straight bar (Stewart 2008).",
      "adductors_r": "Adductor magnus assists hip extension.",
      "adductors_l": "Adductor magnus assists hip extension.",
      "forearm_flexors_r": "Grip the dumbbells.",
      "forearm_flexors_l": "Grip the dumbbells.",
      "upper_traps_r": "Hold the shoulders against the pull of the dumbbells.",
      "upper_traps_l": "Hold the shoulders against the pull of the dumbbells.",
      "lats_r": "Keep the arms close to the body.",
      "lats_l": "Keep the arms close to the body.",
      "core": "Brace the trunk."
    }
