    "id": "dumbbell-deadlift",
    "name": "Dumbbell Deadlift",
    "aliases": [
      "DB deadlift",
      "Dumbbell suitcase-style deadlift (two dumbbells)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "030012",
      "title": "Dumbbell Deadlift",
      "url": "https://gymvisual.com/videos/9371-dumbbell-deadlift.html",
      "listing": "Video; data sheet: body part Hips, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes) and thighs",
    "secondaryBodyParts": [
      "Lower back",
      "Hamstrings",
      "Forearms (grip)",
      "Upper back"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip and knee extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "upper_traps_r",
        "upper_traps_l",
        "lats_r",
        "lats_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the top, hold the brace on the way down and up, breathe out at the top.",
      "cadence": "About 2 s down, a light touch, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-10",
      "tempo": "2-0-1-1",
      "load": "User-chosen dumbbells; stop about 2 reps short of failure (RIR 2)",
      "frequency": "1-2 times a week",
      "progression": "Add load, then progress to a trap-bar or barbell deadlift"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, a dumbbell beside each foot, palms facing in."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Push the hips back and bend the knees, back flat, chest up, until the dumbbells touch the floor beside your feet."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Light touch on the floor; keep the brace and the flat back."
      },
      {
        "id": "c4",
        "phase": "lift",
        "text": "Push the floor away and stand tall, hips and shoulders rising together."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the glutes at the top without leaning back; breathe and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back to reach the floor",
        "fix": "Bend the knees more, or touch the dumbbells to a low step."
      },
      {
        "id": "m2",
        "mistake": "Hips shooting up first",
        "fix": "Raise the hips and shoulders together."
      },
      {
        "id": "m3",
        "mistake": "Leaning back at the top",
        "fix": "Finish tall with the hips under the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈115° at the bottom",
        "norm": "Deeper knee bend than a straight-bar deadlift because the load sits beside the feet, as with a hex bar (Swinton 2011, higher knee moment)",
        "sources": [
          "swinton2011"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈0°",
        "peak": "≈139° (joint channel); hips 43.8 cm high, knees 44.4 cm",
        "norm": "Hips well above the knees and below the shoulders at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈40° from vertical, spine neutral",
        "norm": "More upright than a straight-bar deadlift (Stewart 2008, Troy-Hex bar)",
        "sources": [
          "stewart2008"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.3 s touch, 1.3 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #030012, Dumbbell Deadlift, video (movement reference)",
