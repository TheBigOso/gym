    "breathing": {
      "pattern": "Breathe in and brace at the top, lower; breathe out as you pass the hardest part of the rise.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-10",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbells, a 2 s pause at the bottom, then a barbell front squat. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Rest one end of each dumbbell on the front of the shoulders, palms facing in, elbows forward. Feet about shoulder width, toes slightly out."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, brace, sit straight down; knees follow the toes, elbows stay up."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs about parallel or a bit lower, chest tall, heels down."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the floor away and stand tall without letting the elbows drop; breathe out near the top."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, reset the brace, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows dropping and the dumbbells sliding off the shoulders",
        "fix": "Keep the elbows pointing forward and the chest up all the way down."
      },
      {
        "id": "m2",
        "mistake": "Knees caving inward",
        "fix": "Push the knees out over the 2nd-3rd toes."
      },
      {
        "id": "m3",
        "mistake": "Heels lifting",
        "fix": "Sit between the heels; widen the stance slightly or shorten the depth."
      },
      {
        "id": "m4",
        "mistake": "Rounding the upper back under the load",
        "fix": "Brace before each rep and keep the chest proud."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "39 cm (≈1.1x the rig's 37 cm shoulder width), toes out 15°",
        "peak": "Unchanged",
        "norm": "About shoulder width, toes out about 15-20 degrees (common coaching; Zawadka 2020 used shoulder width)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈1°",
        "peak": "≈116°",
        "norm": "About 100-120 degrees with the thighs at parallel or a bit below (clinical opinion); depth is driven mostly by knee range (Zawadka 2020)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈0°",
        "peak": "≈113° (joint channel, as in the HUD)",
        "norm": "Not specified by the sources for this depth",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈21° forward",
        "norm": "More upright than a back squat because the load is in front (Gullett 2009; Straub 2024)",
        "sources": [
          "frontsquat2009",
          "straub2024"
        ]
      },
      {
        "measure": "Dumbbells",
        "setup": "Racked on the front of the shoulders, palms in, elbows forward",
        "peak": "Stay on the shoulders (clearance to the body ≥5.92 cm on the rig shapes, dbR-chest)",
        "norm": "Racked on the front of the shoulders, palms in, elbows forward (common coaching; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "About 2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #296612, Dumbbell Front Squat, video (movement reference)",
