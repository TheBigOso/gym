      },
      {
        "id": "frontsquat2009",
        "title": "Gullett, Tillman, Gutierrez & Chow 2009, a biomechanical comparison of back and front squats in healthy trained individuals (J Strength Cond Res 23(1):284-292; PubMed 19002072)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19002072/"
      },
      {
        "id": "zawadka2020",
        "title": "Zawadka et al. 2020, How are squat timing and kinematics in the sagittal plane related to squat depth? (J Sports Sci Med 19:500-507)",
        "url": "https://www.jssm.org/jssm-19-500.xml-Fulltext"
      },
      {
        "id": "straub2024",
        "title": "Straub and Powers 2024, a biomechanical review of the squat exercise: implications for clinical practice (Int J Sports Phys Ther)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10987311/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee pain: squat to a box or a shallower depth.",
        "Wrist or shoulder discomfort in the rack: hold one dumbbell as a goblet squat instead."
      ],
      "regressions": [
        "Dumbbell goblet squat.",
        "Bodyweight squat."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "2 s pause at the bottom.",
        "Dumbbell thruster."
      ]
    },
    "muscleNotes": {
      "quads_r": "Knee extensors lower and drive the squat. With the load in front, the front squat recruited the muscles about as much as the back squat with less knee compressive force (Gullett 2009).",
      "quads_l": "Knee extensors lower and drive the squat. With the load in front, the front squat recruited the muscles about as much as the back squat with less knee compressive force (Gullett 2009).",
      "glute_max_r": "Hip extensor, working hardest out of the bottom (clinical opinion).",
      "glute_max_l": "Hip extensor, working hardest out of the bottom (clinical opinion).",
      "adductors_r": "Adductor magnus assists hip extension in the deep squat (clinical opinion).",
      "adductors_l": "Adductor magnus assists hip extension in the deep squat (clinical opinion).",
      "hamstrings_r": "Co-contract around the knee and assist hip extension (clinical opinion).",
      "hamstrings_l": "Co-contract around the knee and assist hip extension (clinical opinion).",
      "calves_r": "Steady the shins as the knees travel forward over the toes.",
      "calves_l": "Steady the shins as the knees travel forward over the toes.",
      "core": "Braces the trunk under a load carried in front of the spine.",
      "spinal_extensors_r": "Hold the chest up; the front load keeps the trunk more upright than a back squat (Gullett 2009 measured trunk angle in both squats).",
      "spinal_extensors_l": "Hold the chest up; the front load keeps the trunk more upright than a back squat (Gullett 2009 measured trunk angle in both squats).",
      "upper_traps_r": "Hold the shoulders up as a shelf for the dumbbells (clinical opinion).",
      "upper_traps_l": "Hold the shoulders up as a shelf for the dumbbells (clinical opinion).",
      "ant_deltoid_r": "Keeps the elbows forward so the dumbbells stay on the shoulders (clinical opinion).",
      "ant_deltoid_l": "Keeps the elbows forward so the dumbbells stay on the shoulders (clinical opinion).",
      "forearm_flexors_r": "Grip the dumbbell handles; the hands stay closed all set (clinical opinion).",
      "forearm_flexors_l": "Grip the dumbbell handles; the hands stay closed all set (clinical opinion).",
      "biceps_r": "Hold the elbows bent with the dumbbells on the shoulders (clinical opinion).",
      "biceps_l": "Hold the elbows bent with the dumbbells on the shoulders (clinical opinion)."
    }
