    "breathing": {
      "pattern": "Breathe out as you pull the elbows up and out, breathe in as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1-0.5-2-0.5 (up-squeeze-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-3 times a week",
      "load": "User-chosen dumbbells; lighter than for a regular bent-over row (clinical opinion)",
      "progression": "Add reps, then weight; slower lowering; chest-supported version to remove the low-back demand"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet hip width, knees soft. Hinge at the hips with a flat back until the chest is close to parallel with the floor. Dumbbells hang under the shoulders, palms facing back (toward the legs)."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and pull the elbows up and out to the sides, wide of the body, like rowing to the chest."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Upper arms about level with the back, elbows bent about 90 degrees; squeeze the backs of the shoulders and the shoulder blades."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower under control in about 2 s back to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the hinge and the flat back; repeat without standing up between reps."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows tucked in to the ribs",
        "fix": "That is a regular row (more lats). Keep the elbows out wide, about 60-90 degrees from the body."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back or standing up as you pull",
        "fix": "Hold the hinge still; use a lighter weight."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulders toward the ears",
        "fix": "Keep the neck long and pull the elbows out, not up to the ears."
      },
      {
        "id": "m4",
        "mistake": "Swinging the dumbbells up",
        "fix": "Pause at the bottom and lift with the shoulders only."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk inclination",
        "setup": "≈20° above horizontal",
        "peak": "unchanged (held)",
        "norm": "Hip hinge with the trunk well forward, about 15-30 degrees above horizontal, held still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare",
        "setup": "arms hanging under the shoulders",
        "peak": "upper arm ≈79° from the trunk line (head direction), elbow 2 cm from shoulder height",
        "norm": "Upper arm about 60-90 degrees out from the trunk so the pull is a horizontal abduction; horizontal abduction loads the posterior deltoid more than a close row (Franke 2015)",
        "sources": [
          "franke2015"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈9°",
        "peak": "≈96°",
        "norm": "Nearly straight at the bottom, about 90 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "pronated, palms facing back",
        "peak": "pronated (held)",
        "norm": "Pronated (palms back) is the usual rear delt row grip; on a reverse fly a neutral grip gave more posterior deltoid activity than pronated (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈24°",
        "peak": "unchanged",
        "norm": "Soft knees, about 15-30 degrees, so the hips can hinge (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold the hinge 0.8 s",
        "peak": "1.2 s up, 0.4 s squeeze, 2.0 s down",
        "norm": "Controlled, about 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #037712, Dumbbell Rear Delt Row, video (movement reference)",
        "url": "https://gymvisual.com/videos/5276-dumbbell-rear-delt-row.html"
      },
      {
        "id": "franke2015",
        "title": "de Azevedo Franke, Botton, Rodrigues, Pinto and Lima 2015, analysis of anterior, middle and posterior deltoid activation during single and multijoint exercises (J Sports Med Phys Fitness 55(7-8):714-721)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/24947920/"
      },
      {
        "id": "botton2013",
        "title": "Botton, Wilhelm, Ughini, Pinto and Lima 2013, electromyographical analysis of the deltoid between different strength training exercises (Medicina Sportiva 17(2):67-71)",
        "url": "https://www.bisp-surf.de/Record/PU201312008451"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The bent-over position loads the low back; keep the back flat and stop if it rounds or aches."
      ],
      "modify": [
        "Low-back discomfort: lie face down on an incline bench (chest-supported rear delt row) or rest the head on a bench.",
        "Shoulder pinch at the top: stop the pull when the upper arms are just short of level with the back."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Chest-supported rear delt row on an incline bench.",
        "Seated bent-over rear delt row."
      ],
      "progressions": [
        "Slower lowering (3 s).",
        "Pause 2 s at the top.",
        "Bent-over rear delt fly (straighter arms, longer lever)."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover: with the elbows out wide the row becomes a horizontal abduction (a bent-arm reverse fly). Horizontal abduction (reverse peck deck) gave much higher posterior deltoid activity than a close-elbow seated row (Franke 2015; Botton 2013).",
      "post_deltoid_l": "Prime mover: with the elbows out wide the row becomes a horizontal abduction (a bent-arm reverse fly). Horizontal abduction (reverse peck deck) gave much higher posterior deltoid activity than a close-elbow seated row (Franke 2015; Botton 2013).",
      "rhomboids_midtrap_r": "Pull the shoulder blades together at the top of the row.",
      "rhomboids_midtrap_l": "Pull the shoulder blades together at the top of the row.",
      "infraspinatus_r": "External rotator that works with the posterior deltoid in horizontal abduction (Schoenfeld 2013).",
      "infraspinatus_l": "External rotator that works with the posterior deltoid in horizontal abduction (Schoenfeld 2013).",
      "lat_deltoid_r": "Helps hold the upper arm out from the body as it rises.",
      "lat_deltoid_l": "Helps hold the upper arm out from the body as it rises.",
      "biceps_r": "Holds the elbow bend; less involved than in a close row because the elbows lead.",
      "biceps_l": "Holds the elbow bend; less involved than in a close row because the elbows lead.",
      "spinal_extensors_r": "Hold the flat back in the hinge for the whole set.",
      "spinal_extensors_l": "Hold the flat back in the hinge for the whole set.",
      "hamstrings_r": "Hold the hip hinge isometrically.",
      "hamstrings_l": "Hold the hip hinge isometrically.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Braces the trunk so it does not rock as the arms move.",
      "forearm_flexors_r": "Grip the dumbbells.",
      "forearm_flexors_l": "Grip the dumbbells."
    }
