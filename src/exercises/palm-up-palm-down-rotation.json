  "exercise": {
    "id": "palm-up-palm-down-rotation",
    "name": "Palm Up - Palm Down Rotation",
    "aliases": [
      "Arm rotations palms up and down",
      "Standing forearm and shoulder rotation",
      "T-arm palm flips"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11810",
      "title": "Palm up - Palm down Rotation (male)",
      "url": "https://gymvisual.com/videos/11810-palm-up-palm-down-rotation-male.html",
      "listing": "GymVisual page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching knowledge",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Mobility / activation",
    "bodyPart": "Shoulders and forearms",
    "secondaryBodyParts": [
      "Forearms (pronators and supinators)",
      "Upper back"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder rotation with forearm pronation and supination, arms held out)",
    "plane": "Transverse",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "synergist": [
        "biceps_r",
        "biceps_l",
        "forearm_extensors_r",
        "forearm_extensors_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "upper_traps_r",
        "upper_traps_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "stabilizer": [
        "core",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe naturally and steadily.",
      "cadence": "About 0.8 s per turn"
    },
    "prescription": {
      "sets": "1-2",
      "reps": "10-15 turns each way",
      "tempo": "Smooth, about 1 s per turn",
      "frequency": "Daily or as a warm-up before upper-body training",
      "progression": "Longer sets with the arms held out, then light plates or dumbbells"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width. Raise the straight arms out to the sides to shoulder height, palms down."
      },
      {
        "id": "c2",
        "phase": "rotate",
        "text": "Turn the palms up to the ceiling, then back down to the floor, rotating the whole arm from the shoulder; arms stay level and long."
      },
      {
        "id": "c3",
        "phase": "lower",
        "text": "Lower the arms to the sides under control."
      },
      {
        "id": "c4",
        "phase": "reset",
        "text": "Shake out the arms; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the arms drift down",
        "fix": "Keep the hands at shoulder height through the set."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders",
        "fix": "Shoulders down and relaxed; long neck."
      },
      {
        "id": "m3",
        "mistake": "Bending the elbows",
        "fix": "Keep the arms long; turn from the shoulder and forearm."
      },
      {
        "id": "m4",
        "mistake": "Arching the low back",
        "fix": "Ribs down, stand tall."
      }
    ],
    "kinematics": [
      {
        "measure": "Arm elevation",
        "setup": "Hanging by the sides",
        "peak": "≈89° out to the sides (hands at shoulder height)",
        "norm": "About 90 degrees out to the sides (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arm rotation",
        "setup": "Palms down (palm 1° from facing the floor)",
        "peak": "Palms up (180° turned): shoulder rotation 60°, forearm 120°",
        "norm": "Palms from facing the floor to facing the ceiling: shoulder external rotation with forearm supination, and back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow",
        "setup": "Soft",
        "peak": "≈4° (nearly straight)",
        "norm": "Straight or nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Tall",
        "peak": "Unchanged",
        "norm": "Tall and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "1 s to raise the arms",
        "peak": "Three palm-up and palm-down turns of 1.6 s, 1 s to lower",
        "norm": "About 0.8-1 s per turn (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
