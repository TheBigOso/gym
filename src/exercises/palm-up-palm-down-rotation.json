    "safety": {
      "cautions": [
        "Stop if you feel shoulder pain, clicking with pain, or tingling down the arm.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "A mobility and warm-up drill: low load."
      ],
      "modify": [
        "Shoulder discomfort: lower the arms to about 60 degrees.",
        "Fatigue: do it one arm at a time."
      ],
      "regressions": [
        "Elbows bent at the sides, forearm rotations only."
      ],
      "progressions": [
        "Longer holds with the arms out.",
        "Light plates in the hands."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Middle deltoids hold the arms out at shoulder height through the whole set (clinical opinion).",
      "lat_deltoid_l": "Middle deltoids hold the arms out at shoulder height through the whole set (clinical opinion).",
      "infraspinatus_r": "Infraspinatus and teres minor rotate the arm outward as the palms turn up (clinical opinion).",
      "infraspinatus_l": "Infraspinatus and teres minor rotate the arm outward as the palms turn up (clinical opinion).",
      "biceps_r": "Biceps and supinator turn the forearm palm up (clinical opinion).",
      "biceps_l": "Biceps and supinator turn the forearm palm up (clinical opinion).",
      "upper_traps_r": "Upper trapezius helps hold the arms up (Ekstrom 2003 for arm elevation).",
      "upper_traps_l": "Upper trapezius helps hold the arms up (Ekstrom 2003 for arm elevation)."
    }
