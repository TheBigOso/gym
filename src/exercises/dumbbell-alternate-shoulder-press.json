    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Kick the dumbbells up from the thighs one at a time to start, and lower them back to the thighs at the end of the set."
      ],
      "modify": [
        "Shoulder pain overhead: press with palms facing in and the elbows further forward.",
        "Low-back discomfort: keep the pad upright and the back against it."
      ],
      "regressions": [
        "Seated single-arm press with the free hand on the thigh.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Standing alternating press.",
        "Seated bilateral press with heavier loads.",
        "Z press."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover of the pressing arm; the other arm holds the dumbbell at the shoulder (isometric). Pressing gave the highest anterior deltoid activity of four exercises (Campos 2020).",
      "ant_deltoid_l": "Main mover of the pressing arm; the other arm holds the dumbbell at the shoulder (isometric). Pressing gave the highest anterior deltoid activity of four exercises (Campos 2020).",
      "lat_deltoid_r": "Lifts the pressing arm up and out (Campos 2020); stays working in the holding arm.",
      "lat_deltoid_l": "Lifts the pressing arm up and out (Campos 2020); stays working in the holding arm.",
      "triceps_r": "Straightens the pressing elbow.",
      "triceps_l": "Straightens the pressing elbow.",
      "upper_traps_r": "Upward rotation and elevation of the shoulder blade overhead.",
      "upper_traps_l": "Upward rotation and elevation of the shoulder blade overhead.",
      "serratus_r": "Upward rotation of the shoulder blade.",
      "serratus_l": "Upward rotation of the shoulder blade.",
      "post_deltoid_r": "Steadies the shoulders; lower seated than standing (Saeterbakken 2013).",
      "post_deltoid_l": "Steadies the shoulders; lower seated than standing (Saeterbakken 2013).",
      "infraspinatus_r": "Rotator cuff: centres the ball of the shoulder.",
      "infraspinatus_l": "Rotator cuff: centres the ball of the shoulder.",
      "obliques_r": "Resist the side-to-side load: seated unilateral presses gave far more external oblique activity than seated bilateral (Saeterbakken 2012).",
      "obliques_l": "Resist the side-to-side load: seated unilateral presses gave far more external oblique activity than seated bilateral (Saeterbakken 2012).",
      "core": "Holds the trunk against the pad; seated unilateral presses raised rectus abdominis activity over bilateral (Saeterbakken 2012)."
    }
