    "breathing": {
      "pattern": "Breathe out on each press, breathe in as that arm lowers.",
      "cadence": "About 1.5 s up, short pause, about 1.8 s down per arm"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-10 per arm",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1.8-0-1.5-0.3 per arm (down-pause-up-pause, seconds)",
      "rest": "90 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; the EMG studies used 80% of 1RM (Saeterbakken 2012)",
      "progression": "Add reps, then weight; standing alternating press"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Back pad nearly upright, back on the pad, feet flat. Both dumbbells at shoulder height, palms forward, elbows under the wrists."
      },
      {
        "id": "c2",
        "phase": "pressR",
        "text": "Breathe out and press the right dumbbell up while the left stays at the shoulder."
      },
      {
        "id": "c3",
        "phase": "topR",
        "text": "Right arm nearly straight overhead; trunk does not tilt."
      },
      {
        "id": "c4",
        "phase": "lowerR",
        "text": "Lower the right dumbbell in about 2 s back to shoulder height."
      },
      {
        "id": "c5",
        "phase": "pressL",
        "text": "Now press the left dumbbell while the right holds at the shoulder."
      },
      {
        "id": "c6",
        "phase": "lowerL",
        "text": "Lower the left dumbbell under control; keep alternating."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning toward the holding arm",
        "fix": "Keep the back on the pad and the shoulders level."
      },
      {
        "id": "m2",
        "mistake": "Letting the holding dumbbell sag",
        "fix": "Keep the waiting dumbbell at shoulder height, elbow under the wrist."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back off the pad",
        "fix": "Ribs down; lighter dumbbells."
      }
    ],
    "kinematics": [
      {
        "measure": "Back pad angle",
        "setup": "85° from the floor; back and buttocks on the pad",
        "peak": "unchanged (trunk still)",
        "norm": "Seated presses are usually done with the back pad at 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation",
        "setup": "≈80° (upper arm vs trunk)",
        "peak": "≈167° (pressing arm)",
        "norm": "Pressing arm from about 80-90 degrees to about 160-170 degrees overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈98°, forearm vertical",
        "peak": "≈12° (nearly straight)",
        "norm": "About 90 degrees at the bottom, nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Opposite arm",
        "setup": "both dumbbells at shoulder height",
        "peak": "holds at the shoulder (elbow ≈98°)",
        "norm": "Holds the dumbbell at shoulder height (isometric); unilateral loading raises oblique and abdominal activity when seated (Saeterbakken 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.7 s, both at the shoulders",
        "peak": "1.5 s up, 0.3 s at the top, 1.8 s down per arm, 0.6 s between arms",
        "norm": "Controlled, one arm at a time (clinical opinion)",
        "sources": []
      }
    ],
