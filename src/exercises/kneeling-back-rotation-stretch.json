    "id": "kneeling-back-rotation-stretch",
    "name": "Kneeling Back Rotation Stretch",
    "aliases": [
      "Quadruped thoracic rotation (reach)",
      "Quadruped T-spine rotation",
      "Open-book reach from all fours"
    ],
    "reference": {
      "source": "GymVisual",
