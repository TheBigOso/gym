      "listing": "First item on https://gymvisual.com/13-media-content (sorted A to Z), viewed 2026-11-26",
      "note": "Used only to identify the movement. This rig, model and animation are original."
    },
    "type": "Stretching / dynamic mobility",
    "bodyPart": "Back (thoracic spine)",
    "secondaryBodyParts": [
      "Shoulders",
      "Chest",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (spinal mobility)",
    "plane": "Transverse",
    "laterality": "Unilateral (alternate sides)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "post_deltoid_r",
        "infraspinatus_r"
      ],
      "stabilizer": [
        "serratus_l",
        "triceps_l",
        "core",
