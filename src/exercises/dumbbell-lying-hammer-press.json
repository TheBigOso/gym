    "breathing": {
      "pattern": "Inhale as you lower the dumbbells, exhale as you press them up.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "Add reps up to the top of the range, then move to the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the flat bench, glutes on the seat, upper back and head on the pad, feet planted; dumbbells straight up over the shoulders with the palms facing each other."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the dumbbells beside the chest, elbows tucked about 30 degrees from the sides, forearms vertical."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Handles beside the lower chest, upper arms just below the bench line; brief pause, no bounce."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press straight up, palms still facing, until the arms are straight over the shoulders."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the shoulder blades pinned to the bench, then lower again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring out wide",
        "fix": "Keep the elbows tucked close to the ribs; the neutral grip makes this natural."
      },
      {
        "id": "m2",
        "mistake": "Wrists turning so the dumbbells tip",
        "fix": "Keep the handles parallel to the body and the wrists straight."
      },
      {
        "id": "m3",
        "mistake": "Bouncing out of the bottom",
        "fix": "Lower under control and pause beside the chest."
      },
      {
        "id": "m4",
        "mistake": "Hips lifting off the bench",
        "fix": "Keep the glutes down and drive through planted feet."
      },
      {
        "id": "m5",
        "mistake": "Dumbbells drifting over the face",
        "fix": "Press straight up over the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Grip",
        "setup": "Neutral: handles along the trunk, dumbbell centres 39.2 cm apart at the top",
        "peak": "Neutral beside the chest, centres 59 cm apart",
        "norm": "Neutral grip: palms facing each other, handles along the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈4° (arms straight, not locked)",
        "peak": "≈101° at the bottom",
        "norm": "Arms straight but not locked at the top; about 90-110 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck",
        "setup": "Arms vertical over the shoulders",
        "peak": "≈30° from the trunk at the bottom; upper arm ≈16° below the back plane",
        "norm": "About 20-40 degrees from the trunk at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
