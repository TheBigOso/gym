        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 85-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up, 0.7 s squeeze at the top",
        "norm": "About 2 s down, 1 s up and a squeeze at the top (clinical opinion)",
        "sources": []
