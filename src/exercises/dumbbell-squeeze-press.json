    "safety": {
      "cautions": [
        "Get into position safely: sit on the end of the bench with the dumbbells on the thighs, lie back with them held together at the chest, and bring them back to the thighs at the end (clinical opinion).",
        "Keep the dumbbells over the chest, never over the face.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorten the range at the bottom.",
        "Hex dumbbells stay together more easily than round ones."
      ],
      "regressions": [
        "Dumbbell floor press.",
        "Close-grip push-up."
      ],
      "progressions": [
        "Incline squeeze press.",
        "Pause with the dumbbells just above the chest.",
        "Heavier dumbbells."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main mover: presses the weight up and, by squeezing the dumbbells together the whole time, adds a constant inward (adduction) effort (clinical opinion; no EMG study of the squeeze press found). Dumbbell presses activated the pectoralis about as much as barbell presses (Saeterbakken 2011).",
      "pec_l": "Main mover: presses the weight up and, by squeezing the dumbbells together the whole time, adds a constant inward (adduction) effort (clinical opinion; no EMG study of the squeeze press found). Dumbbell presses activated the pectoralis about as much as barbell presses (Saeterbakken 2011).",
      "triceps_r": "Straightens the elbows; with the elbows tucked close to the body the triceps does a large share (clinical opinion).",
      "triceps_l": "Straightens the elbows; with the elbows tucked close to the body the triceps does a large share (clinical opinion).",
      "ant_deltoid_r": "Flexes the shoulder as the arms press up from the chest.",
      "ant_deltoid_l": "Flexes the shoulder as the arms press up from the chest.",
      "serratus_r": "Spreads the shoulder blades slightly at the top.",
      "serratus_l": "Spreads the shoulder blades slightly at the top.",
      "forearm_flexors_r": "Grip the handles and squeeze the dumbbells together.",
      "forearm_flexors_l": "Grip the handles and squeeze the dumbbells together.",
      "biceps_r": "Steadies the elbows.",
      "biceps_l": "Steadies the elbows.",
      "rhomboids_midtrap_r": "Keep the shoulder blades set on the bench.",
      "rhomboids_midtrap_l": "Keep the shoulder blades set on the bench.",
      "core": "Keeps the ribs down and the glutes on the seat."
    }
