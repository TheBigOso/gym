        "core"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower the dumbbells to the chest, exhale as you press, squeezing them together throughout.",
      "cadence": "About 2 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "tempo": "2-1-1-1 (squeeze hard at the top)",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9). Use lighter dumbbells than for the regular press.",
      "progression": "More reps, then a longer squeeze at the top, then the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench, feet planted; hold the dumbbells over the chest with palms facing each other and press them firmly together."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower them to the middle of the chest, still squeezing, elbows close to the sides."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbells just above the chest, touching each other, elbows about 30-45 degrees from the body."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press straight up while squeezing the dumbbells together."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze hard at the top for a second, then lower again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the dumbbells drift apart",
        "fix": "Push them together with the palms the whole time; that inward squeeze is the point of the exercise."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows close to the body, about 30-45 degrees."
      },
      {
        "id": "m3",
        "mistake": "Dumbbells crashing onto the chest",
        "fix": "Stop a few centimetres above the sternum."
      },
      {
        "id": "m4",
        "mistake": "Pressing toward the face",
        "fix": "Press straight up over the lower chest."
      },
      {
        "id": "m5",
        "mistake": "Hips lifting off the bench",
        "fix": "Keep the glutes on the seat and the feet planted."
      }
    ],
    "kinematics": [
      {
        "measure": "Dumbbell contact",
        "setup": "Plates 1.2 cm apart (pressed together), handles along the body",
        "peak": "Closest plate gap through the loop -0.22 cm",
        "norm": "Dumbbells touch (or nearly touch) for the whole rep, palms facing each other (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈8° (straight, not locked)",
        "peak": "≈124° at the bottom, plates 4 cm above the chest",
        "norm": "Arms straight but not locked at the top; at the bottom the elbows bend to about 90-100 degrees with the dumbbells just above the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "Arms vertical over the chest",
        "peak": "≈52° from the trunk at the bottom",
        "norm": "About 30-45 degrees from the body at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bench angle",
        "setup": "Flat (0°)",
