    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press up.",
      "cadence": "About 1.8 s down, 0.4 s pause on the floor, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-12",
      "tempo": "2-1-1-0 (2 s down, 1 s pause on the floor, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "Add reps to the top of the range, then the next dumbbell (1-2.5 kg per hand)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the mat, knees bent and feet flat; dumbbells pressed up over the chest, palms toward the feet, shoulder blades back and down."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the dumbbells with the elbows about 45 degrees out from the sides, forearms vertical."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Upper arms rest on the floor for a moment; dumbbells beside the chest."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press up and slightly in until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Dumbbells a few centimetres apart over the chest, then go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flared straight out at 90 degrees",
        "fix": "Bring the elbows to about 45 degrees from the body so the upper arms land on the floor angled toward the hips."
      },
      {
        "id": "m2",
        "mistake": "Bouncing the elbows off the floor",
        "fix": "Touch the floor softly, pause for a moment, then press."
      },
      {
        "id": "m3",
        "mistake": "Wrists bent back, dumbbells drifting toward the face",
        "fix": "Keep the forearms vertical and the wrists straight."
      },
      {
        "id": "m4",
        "mistake": "Bridging the hips up to press",
        "fix": "Keep the glutes on the floor; drive through the feet only to brace."
      },
      {
        "id": "m5",
        "mistake": "Dumbbells clashing at the top",
        "fix": "Press up and slightly in, stopping a few centimetres apart."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈7° (arm straight, not locked)",
        "peak": "≈104° with the upper arm on the floor",
        "norm": "Arms straight but not locked at the top; at the bottom the upper arms rest on the floor with the elbows at about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare (upper arm from the trunk)",
        "setup": "Arm vertical over the shoulder",
        "peak": "≈45° from the trunk at the bottom",
        "norm": "About 45 degrees from the body when the upper arm touches the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Range of motion",
        "setup": "Dumbbell centre 67.1 cm above the floor at the top",
        "peak": "36.9 cm at the bottom: 30.2 cm of travel; upper arm ≈15° below the back plane",
        "norm": "Shorter than a bench press: the floor stops the elbows about level with the back. Bench press 1RM rose as the range was shortened, mainly by avoiding the sticking region (Martínez-Cava 2019, Smith machine)",
        "sources": [
          "martinezcava2019"
        ]
      },
      {
        "measure": "Upper arm on the floor",
        "setup": "–",
        "peak": "Arm shapes 0 cm above the floor (resting)",
        "norm": "Back of the upper arm rests briefly on the floor at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈80°, feet 32 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat, knees bent about 70-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.8 s down, 0.4 s pause on the floor, 1.2 s up, 0.8 s at the top",
        "norm": "About 2 s down, a short pause with the arms on the floor, 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
