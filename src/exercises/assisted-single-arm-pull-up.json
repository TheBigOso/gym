    "id": "assisted-single-arm-pull-up",
    "name": "Assisted Single Arm Pull-up",
    "aliases": [
      "One-arm assisted pull-up (machine)",
      "Single-arm counterweight pull-up",
      "Assisted one-arm pull-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "17154",
      "title": "Assisted Single Arm Pull-up",
      "url": "https://gymvisual.com/videos/17154-assisted-single-arm-pull-up-male.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (gymvisual.com refused the request), so the data sheet was not read and the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back",
    "secondaryBodyParts": [
      "Biceps",
      "Obliques",
      "Forearms"
    ],
    "equipment": [
      "Assisted pull-up machine (counterweighted knee pad, overhead handles)"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (pull, vertical), unilateral",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "lats_r"
      ],
      "synergist": [
        "biceps_r",
        "rhomboids_midtrap_r",
        "post_deltoid_r"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "obliques_r",
        "obliques_l",
        "core"
      ],
      "lengthened": [
        "lats_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull up, breathe in as you lower.",
      "cadence": "About 1.3 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "4-8 each side",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "tempo": "1.3-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
      "load": "Assistance is user-chosen: one arm needs much more counterweight than two; start with plenty.",
      "progression": "Add reps, then reduce the counterweight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel on the pad and take one handle overhead with the right hand, palm forward; the left hand rests on the left thigh. Hang with the arm nearly straight."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Set the right shoulder blade down, breathe out and pull the chest up toward the hand, elbow driving down to the side."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Pause with the chin beside the hand; keep the body from twisting."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and lower under control on the counterweighted pad."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Reach a full hang; switch sides after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting toward the working arm",
        "fix": "Brace the trunk and keep the hips square."
      },
      {
        "id": "m2",
        "mistake": "Too little assistance",
        "fix": "Add counterweight until every rep reaches the top with control."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the bottom",
        "fix": "Set the shoulder blade down first."
      },
      {
        "id": "m4",
        "mistake": "Dropping on the way down",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈8° in the hang",
        "peak": "≈126° at the top",
        "norm": "From nearly straight at the bottom to well bent with the chin over the handles (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Right hand overhand, 14 cm right of centre; left hand on the left thigh",
        "peak": "Unchanged (hand planted on the bar)",
        "norm": "One hand, pronated (palm forward) (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body path",
        "setup": "Kneeling on the pad, pelvis under the working hand",
        "peak": "Body rises 58.4 cm; chin 14.6 cm from the bar",
        "norm": "The body rises nearly straight up; the knees ride the counterweighted pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Assistance",
        "setup": "Counterweighted knee pad (one arm needs much more help)",
        "peak": "Lever swings 23.8°; pad within 1.36 cm of the shins",
        "norm": "The counterweight under the knees takes part of body weight, so the pull is lighter than a free pull-up (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pull-up EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Pull-up and chin-up variations load the latissimus heavily; the chin-up adds biceps (Youdas 2010)",
        "sources": [
          "youdas2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s",
        "peak": "1.3 s up, 0.4 s hold, 2 s down",
        "norm": "About 1.3 s up, short pause, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #17154, Assisted Single Arm Pull-up, video (movement reference)",
        "url": "https://gymvisual.com/videos/17154-assisted-single-arm-pull-up-male.html"
      },
      {
        "id": "youdas2010",
        "title": "Youdas et al. 2010, surface EMG activation patterns and elbow joint motion during a pull-up, chin-up, or perfect-pullup rotational exercise (J Strength Cond Res 24(12):3404-3414)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21068680/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Step onto the knee pad one knee at a time while holding the handles; step off the same way.",
        "More counterweight means more help: start with enough assistance to reach the top with control.",
        "One-arm hanging loads the shoulder and elbow heavily: progress slowly.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort at the bottom: stop just short of a full hang.",
        "Elbow discomfort: use the neutral handles if the machine has them."
      ],
      "regressions": [
        "More counterweight (more help).",
        "Lat pulldown."
      ],
      "progressions": [
        "Less counterweight.",
        "Negative pull-ups, then unassisted pull-ups."
      ]
    },
    "muscleNotes": {
      "lats_r": "Prime mover: pulls the body up to the handles (Youdas 2010 for pull-up and chin-up muscle activity).",
      "biceps_r": "Bends the elbow.",
      "rhomboids_midtrap_r": "Draws the shoulder blades down and together.",
      "post_deltoid_r": "Helps extend the shoulder.",
      "forearm_flexors_r": "Grip the handles.",
      "core": "Keeps the body steady on the knee pad.",
      "infraspinatus_r": "Steadies the shoulder.",
      "obliques_r": "Stop the body twisting under one arm.",
      "obliques_l": "Stop the body twisting under one arm."
    }
