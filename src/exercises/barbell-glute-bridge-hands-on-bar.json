    "breathing": {
      "pattern": "Breathe in on the floor, breathe out as the hips rise, hold briefly at the top, breathe in as you lower.",
      "cadence": "About 1.2 s up, 0.8 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-15",
      "tempo": "1-1-2-0",
      "frequency": "1-3 times a week",
      "load": "Barbell load is user-chosen; use a bar pad and plates big enough to roll the bar over the hips. Leave about 2-3 reps in reserve (RPE 7-8).",
      "rest": "60-90 s between sets",
      "progression": "Heavier bar, then the barbell hip thrust from a bench."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the floor, bar (with a pad) rolled over the hip crease, hands holding the bar just outside the hips. Feet flat about hip width, heels about a foot from the buttocks."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Brace, press through the heels and lift the hips until shoulders, hips and knees line up."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the glutes at the top, ribs down, no arch in the lower back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the hips slowly back to the floor; the plates take the bar."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief reset on the floor."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the lower back at the top",
        "fix": "Stop when the hips line up with the shoulders and knees; ribs down."
      },
      {
        "id": "m2",
        "mistake": "Pushing through the toes",
        "fix": "Press through the heels; move the feet closer if the hamstrings cramp."
      },
      {
        "id": "m3",
        "mistake": "Knees caving in",
        "fix": "Push the knees out over the feet."
      },
      {
        "id": "m4",
        "mistake": "Letting the bar roll",
        "fix": "Hold it on the hip crease with both hands."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈54° (lying)",
        "peak": "≈-5° (knee-hip-shoulder line 179°)",
        "norm": "From about 40-50 degrees on the floor to neutral at the top (Boren 2011)",
        "sources": [
          "boren2011"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈106°",
        "peak": "≈90° (shins about vertical)",
        "norm": "About 90 degrees at the top (common coaching)",
        "sources": []
      },
      {
        "measure": "Hip lift",
        "setup": "Hip joints 8.6 cm above the floor",
        "peak": "29.5 cm (+20.9 cm)",
        "norm": "Shoulders, hips and knees in line at the top (common coaching)",
        "sources": []
      },
      {
        "measure": "Bar position",
        "setup": "68 cm overhand grip; lying, the bar rests on the 45 cm plates just above the hip crease",
        "peak": "Rides on the hip crease at the top (shaft 0.4 cm off the body)",
        "norm": "Bar across the hip crease, padded; large plates leave room to roll under (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Lying 0.8 s",
        "peak": "1.2 s up, 0.8 s squeeze, 2.0 s down, 1.0 s reset",
        "norm": "Pause at the top, slow lowering (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
