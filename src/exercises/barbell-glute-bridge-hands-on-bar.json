    "safety": {
      "cautions": [
        "Use a thick bar pad over the hips and large-diameter plates so the bar rolls over the hips.",
        "Keep the head and shoulders relaxed on the mat.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Hip-bone discomfort: thicker pad, lighter bar.",
        "Hamstring cramps: feet closer to the buttocks."
      ],
      "regressions": [
        "Bodyweight glute bridge.",
        "Dumbbell on the hips."
      ],
      "progressions": [
        "Heavier bar.",
        "Barbell hip thrust from a bench.",
        "Barbell one leg hip thrust."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor; the bridge works the glutes through the top of the hip-extension range (Contreras 2015; Boren 2011).",
      "glute_max_l": "Main hip extensor; the bridge works the glutes through the top of the hip-extension range (Contreras 2015; Boren 2011).",
      "hamstrings_r": "Assist hip extension; less active with the knees bent about 90 degrees at the top.",
      "hamstrings_l": "Assist hip extension; less active with the knees bent about 90 degrees at the top.",
      "quads_r": "Hold the knee angle so the hips, not the knees, do the work.",
      "quads_l": "Hold the knee angle so the hips, not the knees, do the work.",
      "adductors_r": "Help extend the hips and keep the knees from flaring.",
      "adductors_l": "Help extend the hips and keep the knees from flaring.",
      "glute_med_r": "Keeps the pelvis level and the knees over the feet.",
      "glute_med_l": "Keeps the pelvis level and the knees over the feet.",
      "core": "Holds the ribs down so the lower back does not arch at the top.",
      "obliques_r": "Part of the brace.",
      "obliques_l": "Part of the brace.",
      "spinal_extensors_r": "Keep the spine neutral; the movement should come from the hips, not the lower back.",
      "spinal_extensors_l": "Keep the spine neutral; the movement should come from the hips, not the lower back.",
      "forearm_flexors_r": "Hold the bar in place on the hips.",
      "forearm_flexors_l": "Hold the bar in place on the hips.",
      "lats_r": "Help pin the bar to the hips with straight arms.",
      "lats_l": "Help pin the bar to the hips with straight arms.",
      "triceps_r": "Press down on the bar to steady it.",
      "triceps_l": "Press down on the bar to steady it."
    }
