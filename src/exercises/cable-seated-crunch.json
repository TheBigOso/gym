    "id": "cable-seated-crunch",
    "name": "Cable Seated Crunch",
    "aliases": [
      "Seated cable crunch",
      "Seated rope crunch",
      "Bench cable crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5023",
      "title": "Cable Seated Crunch",
      "url": "https://gymvisual.com/videos/5023-cable-seated-crunch.html",
      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read; the movement follows the exercise name and standard coaching; drawn facing the high pulley with the rope at the head)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Cable machine",
      "Rope attachment",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe out as you curl down, breathe in as you come back up.",
      "cadence": "About 1 s down, short squeeze, about 2 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.4-1.9-0.5 (down-squeeze-up-pause, seconds)",
      "rest": "45-90 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can curl down with the hips still for every rep.",
      "progression": "Add reps, then one plate on the stack; slower return"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench facing the high pulley, feet flat a little wider than the hips. Hold the rope ends beside your head at the temples, elbows in front."
      },
      {
        "id": "c2",
        "phase": "crunch",
        "text": "Breathe out and curl the ribs toward the pelvis, bringing the elbows down toward the knees. The hips stay on the bench."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the abdominals at the bottom; the hands stay at the head and do not pull."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and uncurl slowly back to sitting tall, keeping tension on the cable."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rocking the whole trunk forward from the hips",
        "fix": "Keep the pelvis still on the bench; curl the spine one section at a time."
      },
      {
        "id": "m2",
        "mistake": "Pulling the rope down with the arms",
        "fix": "Lock the hands at the head; let the trunk move them."
      },
      {
        "id": "m3",
        "mistake": "Letting the stack pull you upright fast",
        "fix": "Return over about 2 s and stop before the weight touches down."
      },
      {
        "id": "m4",
        "mistake": "Tucking the chin hard to the chest",
        "fix": "Keep a fist-width gap between the chin and chest; the neck follows the trunk."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk",
        "setup": "≈4° forward of vertical (pelvis to C7)",
        "peak": "≈23° forward of vertical",
        "norm": "From sitting tall to the ribs curled toward the pelvis, elbows coming down onto the front of the thighs; no study fixes the angle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Spine flexion",
        "setup": "≈2° (sum of the lumbar and thoracic segments)",
        "peak": "≈46° (lumbar ≈16°, thoracic ≈30°)",
        "norm": "Lumbar and thoracic flexion with the pelvis still (clinical opinion); about 3 degrees of lumbar flexion in a floor crunch, cited by Escamilla 2016 from earlier work, so this curl is larger",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Seat",
        "setup": "Sitting tall on a 45 cm flat bench, hip flexion ≈84°, feet flat",
        "peak": "Pelvis and legs unchanged (the spine does the work)",
        "norm": "Pelvis and legs still on the bench; the seat removes the hip hinge (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hands",
        "setup": "Beside the temples, 28 cm apart",
        "peak": "Unchanged on the head (27.97-28.04 cm); rope knot above the forehead",
        "norm": "Rope held at the head, arms passive (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s at the top",
        "peak": "1.2 s down, 0.4 s squeeze, 1.9 s up",
        "norm": "Controlled, about 1 s down and 2 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Seated Crunch, video (movement reference)",
