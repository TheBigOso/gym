      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain in the back or neck.",
        "The cable load is user-chosen: pick a weight you can control for every rep.",
        "Loaded spine flexion raises low-back compression; people with disc problems may prefer non-flexion core work (McGill 1998, clinical opinion).",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Neck strain: keep the chin a fist width from the chest and the hands still at the head.",
        "Low-back discomfort: smaller range, lighter load."
      ],
      "regressions": [
        "Lighter load.",
        "Floor crunch."
      ],
      "progressions": [
        "Heavier load.",
        "Kneeling cable crunch.",
        "Pause 2 s at the bottom."
      ]
    },
    "muscleNotes": {
      "core": "Prime mover: rectus abdominis curls the ribs toward the pelvis against the cable and controls the return.",
      "obliques_r": "Help flex the trunk and keep it from twisting.",
      "obliques_l": "Help flex the trunk and keep it from twisting.",
      "lats_r": "Hold the upper arms still so the hands stay at the head (clinical opinion).",
      "lats_l": "Hold the upper arms still so the hands stay at the head (clinical opinion).",
      "forearm_flexors_r": "Grip the rope.",
      "forearm_flexors_l": "Grip the rope."
    }
