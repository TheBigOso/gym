    "breathing": {
      "pattern": "Breathe out as the bar comes up, in as it lowers; the pad lets you breathe freely.",
      "cadence": "About 1.1 s up, 0.4 s squeeze, 2 s down"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "2 minutes between sets",
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "1 s up, short squeeze, 2 s down",
      "load": "Barbell load is user-chosen: the chest stays on the pad, about 2 reps in reserve.",
      "progression": "Add 2.5 kg when every rep reaches the pad with a pause."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the bench to about 40 degrees, chest on the pad, chin over the top, feet planted behind; underhand grip about shoulder width, arms hanging."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Drive the elbows back close to the sides and pull the bar up toward the pad."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the shoulder blades together for a moment; the chest stays on the pad."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms long, chest on the pad, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the chest off the pad",
        "fix": "Keep the chest down; lighten the bar."
      },
      {
        "id": "m2",
        "mistake": "Curling the bar",
        "fix": "Think of driving the elbows back; the hands are hooks."
      },
      {
        "id": "m3",
        "mistake": "Shrugging",
        "fix": "Pull the shoulder blades back and down, not up."
      },
      {
        "id": "m4",
        "mistake": "Short range",
        "fix": "Straighten the arms fully at the bottom."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "40° back pad (80 cm), seat 45 cm high",
        "peak": "Trunk ≈53° from vertical, along the pad",
        "norm": "Chest-supported rows remove most of the lower-back load of a bent-over row (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈9°, underhand 46 cm grip (handle centres), arms hanging in front of the pad",
        "peak": "≈132°, elbows 9.8 cm out from the shoulders; the bar stops 0.6 cm under the pad; shoulder blades retracted (clavicle 8° to -16°)",
        "norm": "Underhand grip keeps the elbows close and brings in the biceps (Lehman 2004)",
        "sources": [
          "lehman2004"
        ]
      },
      {
        "measure": "Chest on the pad",
        "setup": "Chest on the pad (gap 0 cm); head 5.6 cm past the top",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "The chest stays on the pad; only the arms and shoulder blades move (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s",
        "peak": "1.1 s up, 0.4 s squeeze, 2 s down, 1.2 s reset",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Lock the bench angle and make sure the bench is stable before loading.",
        "Elbow or biceps pain with the underhand grip: use an overhand or neutral grip.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrists: EZ bar.",
        "Shorter range if the bar meets the bench early."
      ],
      "regressions": [
        "Chest-supported dumbbell row.",
        "Seated cable row."
      ],
      "progressions": [
        "Pause at the top.",
        "Heavier bar in small steps."
      ]
    },
    "muscleNotes": {
      "lats_r": "Drive the elbows back close to the body; the underhand grip keeps the arm path close (Lehman 2004).",
      "lats_l": "Drive the elbows back close to the body; the underhand grip keeps the arm path close (Lehman 2004).",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together at the top.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together at the top.",
      "biceps_r": "Elbow flexor, working harder with the palms up.",
      "biceps_l": "Elbow flexor, working harder with the palms up.",
      "post_deltoid_r": "Extends the shoulder behind the trunk.",
      "post_deltoid_l": "Extends the shoulder behind the trunk.",
      "forearm_flexors_r": "Hold the bar.",
      "forearm_flexors_l": "Hold the bar.",
      "core": "Keeps the chest on the pad.",
      "spinal_extensors_r": "Hold the trunk long; the pad takes most of the load off the back.",
      "spinal_extensors_l": "Hold the trunk long; the pad takes most of the load off the back.",
      "quads_r": "The legs brace against the floor to keep the chest on the pad.",
      "quads_l": "The legs brace against the floor to keep the chest on the pad."
    },
