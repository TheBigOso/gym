  "exercise": {
    "id": "pelvic-tilt",
    "name": "Pelvic Tilt",
    "aliases": [
      "Posterior pelvic tilt",
      "Supine pelvic tilt",
      "Pelvic tilt (lying)",
      "Back flattening"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11667",
      "title": "Pelvic Tilt",
      "url": "https://gymvisual.com/videos/11667-pelvic-tilt.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Glutes",
      "Low back"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (motor control)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l",
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "hamstrings_r",
        "hamstrings_l"
      ],
      "lengthened": [
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you flatten the back and tilt the pelvis; inhale as you release.",
      "cadence": "About 5 s per rep with a short hold"
    },
    "prescription": {
      "sets": "1-3",
      "reps": "10-15",
      "tempo": "1.2 s tilt, 1.5 s hold, 1.3 s release",
      "frequency": "Daily as a warm-up or rehab drill",
      "progression": "Longer holds, then add marching or a glute bridge from the tilted position"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent, feet flat and hip width apart, arms by your sides."
      },
      {
        "id": "c2",
        "phase": "tilt",
        "text": "Breathe out and gently flatten your low back into the mat by rolling the pelvis back (tailbone curls up slightly)."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold for a couple of seconds; keep the buttocks on the mat and the ribs relaxed."
      },
      {
        "id": "c4",
        "phase": "release",
        "text": "Breathe in and let the pelvis roll back to neutral, with a small natural gap under the low back."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the buttocks into a bridge",
        "fix": "Keep the buttocks resting on the mat; the movement is small."
      },
      {
        "id": "m2",
        "mistake": "Pushing with the feet or legs only",
        "fix": "Draw the belly in and let the abdominals do the tilting."
      },
      {
        "id": "m3",
        "mistake": "Holding the breath",
        "fix": "Exhale through the tilt."
      },
      {
        "id": "m4",
        "mistake": "Jamming the head into the mat",
        "fix": "Relax the neck and shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Pelvic tilt",
        "setup": "Neutral (pelvis pitch ≈-2°)",
        "peak": "Posterior tilt ≈10° (hip flexion ≈47° to ≈36°)",
        "norm": "Small posterior tilt, about 5-15 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar curve",
        "setup": "Lumbar segment ≈-4° (small arch; low back 2.6 cm off the mat)",
        "peak": "Lumbar segment ≈10° (flattened; 2.1 cm off the mat)",
        "norm": "Low back flattens toward the mat (Drysdale 2004)",
        "sources": [
          "drysdale2004"
        ]
      },
      {
        "measure": "Buttocks",
        "setup": "On the mat (0.5 cm)",
        "peak": "Still on the mat (1.2 cm); no bridge",
        "norm": "Stay on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Neutral 0.8 s",
        "peak": "1.2 s tilt, 1.5 s hold, 1.3 s release",
        "norm": "Slow, with a 1-2 s hold (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11667, Pelvic Tilt, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/11667-pelvic-tilt.html"
      },
      {
        "id": "drysdale2004",
        "title": "Drysdale, Earl and Hertel 2004, surface EMG of the abdominal muscles during pelvic-tilt and abdominal-hollowing exercises (J Athl Train 39(1):32-36)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC385259/"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises: implications for rehabilitation and training (Phys Ther 86(5):656-671; PubMed 16649890)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/16649890/"
      },
      {
        "id": "oliva2020",
        "title": "Oliva-Lozano and Muyor 2020, core muscle activity during physical fitness exercises: a systematic review (Int J Environ Res Public Health 17(12):4306)",
        "url": "https://www.mdpi.com/1660-4601/17/12/4306"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "A gentle movement: it should not hurt. Stop and get advice if it brings on back or leg pain."
      ],
      "modify": [
        "A folded towel under the head if the neck is uncomfortable.",
        "Do it standing with the back against a wall if lying down is uncomfortable.",
        "Pregnancy, postpartum or diastasis recti: get cleared first, and avoid long supine work later in pregnancy."
      ],
      "regressions": [
        "Smaller tilt.",
        "Hands on the belly to feel the abdominals draw in."
      ],
      "progressions": [
        "Longer holds.",
        "Hold the tilt while marching one foot up at a time.",
        "Glute bridge from the tilt."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the front of the pelvis up toward the ribs and flattens the low back into the mat; in Drysdale 2004 the posterior pelvic tilt drew more rectus abdominis and external oblique activity than abdominal hollowing.",
      "glute_max_r": "Gluteus maximus helps roll the pelvis back (posterior tilt) without lifting the buttocks off the mat (clinical opinion).",
      "glute_max_l": "Gluteus maximus helps roll the pelvis back (posterior tilt) without lifting the buttocks off the mat (clinical opinion).",
      "obliques_r": "External obliques assist the tilt and hold the ribs down (Drysdale 2004).",
      "obliques_l": "External obliques assist the tilt and hold the ribs down (Drysdale 2004).",
      "hamstrings_r": "With the feet planted the hamstrings can help draw the pelvis back (clinical opinion).",
      "hamstrings_l": "With the feet planted the hamstrings can help draw the pelvis back (clinical opinion).",
      "spinal_extensors_r": "The lumbar extensors relax and lengthen a little as the low back flattens (clinical opinion).",
      "spinal_extensors_l": "The lumbar extensors relax and lengthen a little as the low back flattens (clinical opinion)."
    }
  },
