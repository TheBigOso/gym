      },
      {
        "id": "mcgill1996ql",
        "title": "McGill, Juker and Kropf, quantitative intramuscular myoelectric activity of quadratus lumborum during a wide variety of tasks (Clinical Biomechanics)",
        "url": "https://scilit.com/publications/dbf1681bb853bf9dcf2fd6d2c37728bd"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Low-back pain with side bending: try a suitcase hold or carry (no bend) instead (clinical opinion).",
        "Keep the range comfortable; repeated end-range bending under load is not needed."
      ],
      "modify": [
        "Lighter dumbbell, smaller range.",
        "Free hand on the hip instead of behind the head."
      ],
      "regressions": [
        "Bodyweight standing side bend.",
        "Suitcase hold."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Suitcase carry.",
        "Side plank."
      ]
    },
    "muscleNotes": {
      "obliques_l": "The obliques on the side opposite the dumbbell lower the trunk toward the weight under control and pull it back up; side-lying lateral flexion gave about 98% MVC external oblique in Konrad 2001 (no study measured the standing dumbbell version).",
      "spinal_extensors_l": "Quadratus lumborum and the erector spinae opposite the load work with the obliques; quadratus lumborum is a primary lateral stabiliser of the spine (McGill, Juker and Kropf).",
      "obliques_r": "The obliques on the dumbbell side finish the movement just past upright (clinical opinion).",
      "core": "Rectus abdominis and the deep abdominals keep the trunk from leaning forward or twisting (clinical opinion).",
      "forearm_flexors_r": "Grip the dumbbell (clinical opinion).",
      "upper_traps_r": "Keep the loaded shoulder from being pulled down (clinical opinion).",
      "glute_med_r": "Keeps the pelvis level over the feet (clinical opinion).",
      "glute_med_l": "Keeps the pelvis level over the feet (clinical opinion)."
    }
  },
