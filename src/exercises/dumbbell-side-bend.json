    "id": "dumbbell-side-bend",
    "name": "Dumbbell Side Bend",
    "aliases": [
      "Standing dumbbell side bend",
      "Dumbbell lateral flexion",
      "Suitcase side bend"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "040712",
      "title": "Dumbbell Side Bend",
      "url": "https://gymvisual.com/videos/5053-dumbbell-side-bend.html",
      "listing": "Video; data sheet: body part Waist, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Core",
      "Lower back"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (lateral flexion of the trunk)",
    "plane": "Frontal",
    "laterality": "Unilateral load (one side at a time)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_l",
        "spinal_extensors_l"
      ],
      "synergist": [
        "obliques_r",
        "core"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "upper_traps_r",
        "glute_med_r",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you bend toward the dumbbell, exhale as you pull back up.",
      "cadence": "About 1.5 s down, short pause, about 1.5 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 per side",
      "tempo": "About 1.5 s down, brief pause, 1.5 s up",
      "frequency": "1-3 times a week",
      "progression": "Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set. Many coaches prefer suitcase carries for the same muscles with less spine bending."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, dumbbell in the right hand at your side (palm facing the thigh), left fingertips lightly behind the head."
      },
      {
        "id": "c2",
        "phase": "down",
        "text": "Breathe in and bend straight sideways toward the dumbbell; let it slide down the outside of the thigh."
      },
      {
        "id": "c3",
        "phase": "pause",
        "text": "Short pause at a comfortable stretch; no leaning forward or twisting."
      },
      {
        "id": "c4",
        "phase": "up",
        "text": "Breathe out and pull the trunk back up with the opposite side of the waist, just past upright."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall; finish the set, then switch hands."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning forward or twisting as you bend",
        "fix": "Move in a flat side plane, chest facing forward."
      },
      {
        "id": "m2",
        "mistake": "Holding a dumbbell in each hand",
        "fix": "One dumbbell only; two cancel each other out."
      },
      {
        "id": "m3",
        "mistake": "Bending the arm or shrugging the dumbbell up",
        "fix": "Arm long and relaxed; the waist does the work."
      },
      {
        "id": "m4",
        "mistake": "Going too heavy and bouncing out of the bottom",
        "fix": "Use a load you can lower in 1.5 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Lateral flexion (pelvis to C7)",
        "setup": "Upright (≈0°)",
        "peak": "≈21° toward the dumbbell (pelvis to C7); spine segments ≈37° (lumbar ≈14°, thoracic ≈23°); back up to ≈3° past upright",
        "norm": "A comfortable side bend toward the weight and back to just past upright; no study fixes the range (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell path",
        "setup": "Dumbbell beside the thigh, wrist 86 cm above the floor",
        "peak": "Slides 16 cm down the outside of the thigh (arm stays vertical, ≈9° max off vertical)",
        "norm": "Slides down the outside of the thigh, arm vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "Hips square, feet planted",
        "peak": "Pelvis shifts 2.6 cm away from the bend; no twisting or forward lean",
        "norm": "Square, with a small shift away from the bend (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knees",
        "setup": "Knees ≈5° (soft)",
        "peak": "Unchanged",
        "norm": "Soft, unchanged (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.7 s",
        "peak": "1.6 s down, 0.5 s pause, 1.5 s up, 0.5 s past upright, 1.1 s reset",
        "norm": "About 1.5 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #040712, Dumbbell Side Bend, video (movement reference)",
