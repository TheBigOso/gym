    "id": "dumbbell-lying-one-arm-rear-lateral-raise",
    "name": "Dumbbell Lying One Arm Rear Lateral Raise",
    "aliases": [
      "Side-lying rear delt raise",
      "Side-lying reverse fly",
      "Lying one-arm rear delt fly"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5043",
      "title": "Dumbbell Lying One Arm Rear Lateral Raise",
      "url": "https://gymvisual.com/videos/5043-dumbbell-lying-one-arm-rear-lateral-raise.html",
      "listing": "Page not read (gymvisual.com is blocked by the proxy); movement taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (posterior deltoid)",
    "secondaryBodyParts": [
      "Upper back (rhomboids, middle trapezius)",
      "Rotator cuff (infraspinatus)"
    ],
    "equipment": [
      "Dumbbell",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (shoulder horizontal abduction)",
    "plane": "Transverse",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "post_deltoid_r"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "infraspinatus_r",
        "lat_deltoid_r"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "core",
        "forearm_flexors_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the arm rises, breathe in as it lowers.",
      "cadence": "About 1.5 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 per arm",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0.5-1.5-0 (down-pause-up-bottom, seconds)",
      "rest": "45-75 s",
      "frequency": "2-3 times a week",
      "load": "Light dumbbell",
      "progression": "Add reps, then weight; pause at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your left side, knees bent, head resting on the left arm. Hold the dumbbell in the right hand in front of the chest, arm long with a soft elbow, palm facing you and thumb toward your head."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and sweep the straight arm up and back until it points at the ceiling; lead with the back of the hand."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arm vertical over the shoulder; squeeze the shoulder blade back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to in front of the chest."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Hover just above the floor and repeat. Then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rolling the trunk back to swing the weight up",
        "fix": "Stay stacked on your side; only the arm moves."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbow into a row",
        "fix": "Keep the arm long with a fixed soft elbow."
      },
      {
        "id": "m3",
        "mistake": "Going past vertical",
        "fix": "Stop with the arm pointing at the ceiling."
      },
      {
        "id": "m4",
        "mistake": "Dropping the arm fast",
        "fix": "Lower for about two seconds."
      }
    ],
    "kinematics": [
      {
        "measure": "Horizontal abduction",
        "setup": "Arm ≈56° from pointing at the floor, in front of the chest",
        "peak": "Arm ≈11° from vertical (≈113° of sweep)",
        "norm": "From in front of the chest to vertical, about 90 degrees of sweep (clinical opinion); prone horizontal abduction gave high posterior deltoid EMG (Reinold 2007)",
        "sources": [
          "reinold2007"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12°",
        "peak": "≈12°",
        "norm": "Soft, fixed (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral, thumb toward the head",
        "peak": "Unchanged (thumb toward the head)",
        "norm": "Neutral, thumb toward the head throughout; a neutral grip gave more posterior deltoid activity than a pronated one in a horizontal abduction exercise (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Body position",
        "setup": "On the left side, hips ≈45°, knees ≈70°, left hand under the head",
        "peak": "Unchanged (trunk stays stacked)",
        "norm": "Side-lying, knees bent, head on the lower arm (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s",
        "peak": "1.5 s up, 0.5 s at the top, 2.0 s down",
        "norm": "Controlled, short pause at the top (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #5043, Dumbbell Lying One Arm Rear Lateral Raise, video (movement reference only; page not read)",
        "url": "https://gymvisual.com/videos/5043-dumbbell-lying-one-arm-rear-lateral-raise.html"
      },
      {
        "id": "reinold2007",
        "title": "Reinold et al. 2007, electromyographic analysis of the supraspinatus and deltoid muscles during 3 common rehabilitation exercises (J Athl Train 42(4):464-469)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2140071/"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stay stacked on your side so the low back does not twist."
      ],
      "modify": [
        "Shoulder pinching at the top: stop a little before vertical.",
        "Bottom shoulder uncomfortable: put a pillow under the head."
      ],
      "regressions": [
        "No dumbbell (arm only).",
        "Bent elbow (shorter lever)."
      ],
      "progressions": [
        "Two-second pause at the top.",
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover: lifts the arm up and back (horizontal abduction), loaded most when the arm is near horizontal.",
      "rhomboids_midtrap_r": "Draw the shoulder blade back at the top.",
      "infraspinatus_r": "Works with the posterior deltoid.",
      "lat_deltoid_r": "Assists the lift.",
      "obliques_r": "Keep the trunk stacked.",
      "obliques_l": "Keep the trunk stacked.",
      "core": "Holds the trunk still.",
      "forearm_flexors_r": "Hold the dumbbell."
    }
