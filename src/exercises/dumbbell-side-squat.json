      {
        "id": "riemann2013",
        "title": "Riemann et al. 2013, biomechanical comparison of forward and lateral lunges at varying step lengths (J Sports Med Phys Fitness 53:130-138)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23584319/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Patellofemoral stress was higher in the side lunge than the forward lunge at 80-90 degrees of knee flexion (Escamilla 2008): people with kneecap pain can use a shallower depth."
      ],
      "modify": [
        "Groin strain history: smaller step and less depth.",
        "Knee pain: shallower depth."
      ],
      "regressions": [
        "Smaller step.",
        "Hold a support."
      ],
      "progressions": [
        "Goblet lateral lunge.",
        "Cossack squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Squatting-leg knee extensors control the sit and drive the push back. Knee and ankle impulses were greater in lateral than forward lunges (Riemann 2013).",
      "glute_max_r": "Squatting-leg hip extensor; works hardest out of the bottom (clinical opinion).",
      "adductors_r": "Control the wide position of the squatting leg (clinical opinion).",
      "adductors_l": "Stretched along the inner thigh of the straight leg and help pull the body back to the middle (clinical opinion).",
      "hamstrings_r": "Assist hip extension and co-contract around the knee.",
      "glute_med_r": "Steadies the squatting hip.",
      "quads_l": "Hold the trailing knee straight (clinical opinion).",
      "calves_r": "Lateral lunges asked more of the ankle than forward lunges (Riemann 2013).",
      "calves_l": "Steady the straight leg's foot.",
      "core": "Keeps the trunk tall under the dumbbell.",
      "spinal_extensors_r": "Hold the trunk upright as it inclines forward.",
      "spinal_extensors_l": "Hold the trunk upright as it inclines forward.",
      "forearm_flexors_r": "Grip the top plate.",
      "forearm_flexors_l": "Grip the top plate.",
      "ant_deltoid_r": "Hold the dumbbell up at the chest.",
      "ant_deltoid_l": "Hold the dumbbell up at the chest."
    }
