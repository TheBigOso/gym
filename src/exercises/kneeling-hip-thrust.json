      },
      {
        "id": "contreras2015",
        "title": "Contreras, Vigotsky, Schoenfeld, Beardsley & Cronin 2015, a comparison of gluteus maximus, biceps femoris and vastus lateralis EMG in the back squat and barbell hip thrust (J Appl Biomech 31(6):452-458)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26214739/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Knee pain when kneeling: use thick padding, or switch to a standing hip hinge.",
        "Low-back discomfort: shorten the range and keep the back flat."
      ],
      "modify": [
        "Tight knees: sit back less.",
        "Toes uncomfortable tucked: rest the tops of the feet on the mat."
      ],
      "regressions": [
        "Glute bridge.",
        "Partial-range kneeling hip hinge."
      ],
      "progressions": [
        "Band anchored behind the hips.",
        "Hip thrust from a bench."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Drives the hips forward from the hinge; hip-thrust patterns gave high gluteus maximus activity (Contreras 2015, Macadam 2019).",
      "glute_max_l": "Drives the hips forward from the hinge; hip-thrust patterns gave high gluteus maximus activity (Contreras 2015, Macadam 2019).",
      "hamstrings_r": "Assist hip extension and control the hinge back (clinical opinion).",
      "hamstrings_l": "Assist hip extension and control the hinge back (clinical opinion).",
      "adductors_r": "Adductor magnus assists hip extension (clinical opinion).",
      "adductors_l": "Adductor magnus assists hip extension (clinical opinion).",
      "core": "Keeps the ribs down at the top (clinical opinion).",
      "spinal_extensors_r": "Hold the back flat in the hinge (clinical opinion).",
      "spinal_extensors_l": "Hold the back flat in the hinge (clinical opinion).",
      "quads_r": "Control the knee as the hips sit back (clinical opinion).",
      "quads_l": "Control the knee as the hips sit back (clinical opinion).",
      "glute_med_r": "Keeps the pelvis level and the knees from caving (clinical opinion).",
      "glute_med_l": "Keeps the pelvis level and the knees from caving (clinical opinion)."
    }
