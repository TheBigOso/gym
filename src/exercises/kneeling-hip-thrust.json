    "id": "kneeling-hip-thrust",
    "name": "Kneeling Hip Thrust",
    "aliases": [
      "Kneeling hip hinge",
      "Kneeling glute thrust",
      "Tall-kneeling hip extension",
      "Kneeling squat to tall kneel"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15541",
      "title": "Kneeling Hip Thrust (male)",
      "url": "https://gymvisual.com/videos/15541-kneeling-hip-thrust-male.html",
      "listing": "Video (movement reference; the page could not be read at authoring time: gymvisual.com is blocked by the proxy, so the movement comes from the name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (hamstrings)",
      "Back (lower back)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat or knee pad"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip hinge from kneeling; knees and shins fixed)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "quads_r",
        "quads_l",
        "glute_med_r",
        "glute_med_l"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe in as the hips sit back, breathe out as you drive the hips forward to tall kneeling.",
      "cadence": "About 1.8 s back, short pause, 1.3 s forward"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "tempo": "Sit back in about 2 s, pause, drive forward in about 1 s and squeeze",
      "frequency": "2-3 times a week",
      "progression": "A slow 3 s lowering, then a band anchored behind the hips or a weight held at the chest."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel tall on a mat, knees hip width, toes tucked, hands on the hips."
      },
      {
        "id": "c2",
        "phase": "back",
        "text": "Breathe in and sit the hips back toward the heels while the chest tips forward; keep the back flat."
      },
      {
        "id": "c3",
        "phase": "thrust",
        "text": "Breathe out and drive the hips forward until thighs and trunk are upright."
      },
      {
        "id": "c4",
        "phase": "squeeze",
        "text": "Squeeze the glutes at the top without leaning back or arching."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay tall, then sit back again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back as the hips sit back",
        "fix": "Hinge at the hips with the chest proud and the back flat."
      },
      {
        "id": "m2",
        "mistake": "Leaning back and arching at the top",
        "fix": "Finish with the ribs down and the hips under the shoulders."
      },
      {
        "id": "m3",
        "mistake": "Pushing from the low back instead of the glutes",
        "fix": "Think of driving the hips forward; squeeze the glutes hard at the top."
      },
      {
        "id": "m4",
        "mistake": "Knee pain on a hard floor",
        "fix": "Kneel on a thick mat or a folded towel."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈-2° (tall kneeling)",
        "peak": "≈72° sitting back",
        "norm": "Hips flex as they sit back and return to neutral at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Thigh angle",
        "setup": "≈0° from vertical",
        "peak": "≈38° (hips back toward the heels)",
        "norm": "Thighs tilt back toward the heels, knees stay put (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈109° (toes tucked)",
        "peak": "≈147°",
        "norm": "Knees bend further as the hips sit back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈11°",
        "peak": "≈32° forward, back neutral",
        "norm": "Forward hinge with a neutral spine; body-weight hip-extension drills load gluteus maximus (Macadam 2019)",
        "sources": [
          "macadam2019"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Tall kneel 0.8 s",
        "peak": "1.8 s back, 0.4 s pause, 1.3 s thrust, 0.3 s squeeze",
        "norm": "Controlled lowering, brisk drive (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15541, Kneeling Hip Thrust (male), video (movement reference)",
