    "id": "barbell-single-leg-deadlift",
    "name": "Barbell Single Leg Deadlift",
    "aliases": [
      "Barbell single-leg Romanian deadlift",
      "Single-leg barbell RDL",
      "Barbell one-leg deadlift"
    ],
    "reference": {
      "source": "GymVisual",
