      "listing": "Video (title from the listing URL; the page could not be read from this environment, gymvisual.com is blocked by the proxy, so the movement is taken from the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes) and back of the thighs",
    "secondaryBodyParts": [
      "Lower back",
      "Hip stabilisers",
      "Core"
    ],
    "equipment": [
      "Barbell"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (hip, single leg)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "hamstrings_r",
        "glute_max_r"
      ],
      "synergist": [
        "adductors_r",
        "glute_med_r",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "lats_r",
        "lats_l",
        "upper_traps_r",
        "upper_traps_l",
