        "forearm_flexors_l",
        "calves_r",
        "quads_r",
        "glute_max_l",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace while balancing at the top, hold it on the way down and back up, breathe out at the top.",
      "cadence": "About 2.2 s down, a short pause, about 1.4 s up"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "1-2 minutes between legs",
      "sets": "3",
      "reps": "6-10 per leg",
      "tempo": "Slow and balanced: 2 s down, short pause, 1-1.5 s up",
      "load": "Barbell load is user-chosen and well below a two-leg deadlift: balance and a flat back come first (about 3 reps in reserve).",
      "progression": "Add 2.5 kg once every rep stays balanced with the hips square."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the right leg, knee soft, bar in front of the thighs with an overhand grip just outside the hips, left foot just off the floor."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Hinge at the right hip: the chest goes down as the left leg reaches straight back, the bar sliding down the front of the standing leg; hips stay square to the floor."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop with the trunk and the back leg close to one line, near level, back flat."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the right hip forward to stand tall, the back leg swinging down under you."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Find your balance before the next rep; do all reps, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips opening up (the back-leg hip turning toward the ceiling)",
        "fix": "Point the back toes at the floor and keep both hip bones level."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back to reach down",
        "fix": "Go only as low as a flat back allows."
      },
      {
        "id": "m3",
        "mistake": "Squatting with the standing leg",
        "fix": "Keep a soft, fixed knee; the hips move back."
      },
      {
        "id": "m4",
        "mistake": "Rushing and losing balance",
        "fix": "Slow down, look at the floor a metre or two ahead, use a lighter bar."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈4° (standing hip)",
        "peak": "≈101° (joint channel), trunk ≈16° above level",
        "norm": "Hinge until the trunk is near level, flat back (clinical opinion); unilateral barbell work loads the standing-side hip extensors (Mausehund 2019)",
        "sources": [
          "mausehund2019"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈7° (standing knee)",
        "peak": "≈20°",
        "norm": "Standing knee soft, about 15-25 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Free leg",
        "setup": "Hovering beside the standing ankle (toe 9.1 cm up)",
        "peak": "Hip-to-ankle line 177.4° to the trunk line (180 = one straight line), pelvis level",
        "norm": "Back leg in line with the trunk, toes down, pelvis level (common coaching)",
        "sources": []
      },
      {
        "measure": "Bar position",
        "setup": "Overhand, 50 cm grip (handle centres), bar against the thighs",
        "peak": "Bar 41.7 cm up by the standing shin at the bottom; body + bar centre of mass within 0.1 cm of the right mid-foot",
        "norm": "Bar hangs under the shoulders, close to the standing leg (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Balance 0.8 s",
        "peak": "2.2 s down, 0.4 s pause, 1.4 s up, 1.4 s reset",
        "norm": "Slow and controlled for balance (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Clear space around you; the long bar needs room on both sides.",
        "Learn it with a dowel or a light bar; balance first.",
        "Low-back pain: shorten the range or use a kickstand stance.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Balance: lightly touch the back toes down (kickstand) or hold a wall with one hand and a dumbbell in the other.",
        "Tight hamstrings: stop higher."
      ],
      "regressions": [
        "Dumbbell single-leg Romanian deadlift.",
        "Kickstand (B-stance) Romanian deadlift.",
        "Two-leg Romanian deadlift."
      ],
      "progressions": [
        "Slower lowering with a pause at the bottom.",
        "Heavier bar in small steps."
      ]
    },
    "muscleNotes": {
      "hamstrings_r": "Standing-leg hip extensor, lengthened in the hinge (Lee 2018 for the Romanian style).",
      "glute_max_r": "Drives the standing hip forward to stand tall and keeps the pelvis level (Mausehund 2019).",
      "adductors_r": "Adductor magnus assists hip extension.",
      "glute_med_r": "Keeps the pelvis level over one leg.",
      "spinal_extensors_r": "Hold the back flat.",
      "spinal_extensors_l": "Hold the back flat.",
      "core": "Resists rotation of the pelvis over one leg (Saeterbakken 2012 for unilateral work).",
      "obliques_r": "Resist the pelvis twisting open.",
      "obliques_l": "Resist the pelvis twisting open.",
      "lats_r": "Keep the bar close.",
      "lats_l": "Keep the bar close.",
      "upper_traps_r": "Hold the shoulders against the bar.",
      "upper_traps_l": "Hold the shoulders against the bar.",
      "forearm_flexors_r": "Hold the bar.",
      "forearm_flexors_l": "Hold the bar.",
      "calves_r": "Balance on the standing foot.",
      "quads_r": "Hold the soft standing knee.",
      "glute_max_l": "Lifts the back leg in line with the trunk.",
      "hamstrings_l": "Help lift and hold the back leg."
    },
