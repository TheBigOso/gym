      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lats and mid-back)",
    "secondaryBodyParts": [
      "Shoulders (rear deltoid)",
      "Upper arms (biceps)",
      "Core",
      "Legs (bracing)"
    ],
    "equipment": [
      "Cable machine (pulley at waist height)",
      "Straight bar attachment"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder extension, scapular retraction, elbow flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "lengthened": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row the bar to the stomach, breathe in as the arms straighten.",
      "cadence": "About 1.2 s pull, short squeeze, about 2 s return"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen and limited by balance: pick a weight you can row without being pulled forward or leaning back.",
      "progression": "Add reps, then one plate on the stack; add a 1 s squeeze"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing a pulley set at about waist height, feet hip width, knees bent, hips slightly back and the chest tall; hold the bar overhand about shoulder width, arms long, shoulder blades reaching forward."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out; draw the shoulder blades back and row the bar to the upper stomach, elbows travelling back past the trunk."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Bar at the stomach, shoulder blades together, chest up; the legs and trunk stay still."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and straighten the arms under control, letting the shoulder blades slide forward."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief stretch with the arms long, then row again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back and using body weight to move the bar",
        "fix": "Brace with the legs and trunk and keep them still; lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders up",
        "fix": "Pull the shoulder blades back and down."
      },
      {
        "id": "m3",
        "mistake": "Wrists curling or bending back",
        "fix": "Keep the wrists straight; the hands only hold the bar."
      },
      {
        "id": "m4",
        "mistake": "Locked knees, being pulled forward",
        "fix": "Bend the knees and sit the hips back a little to brace."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈20°",
        "peak": "Unchanged (legs braced)",
        "norm": "Knees bent, about 15-25 degrees, to brace against the cable (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈18° (arms long)",
        "peak": "≈124°",
        "norm": "From nearly straight to about 90-110 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blades",
        "setup": "Protracted (reaching forward)",
        "peak": "Retracted (drawn together)",
        "norm": "Protracted with the arms long, retracted at the finish; retraction work drives the middle trapezius and rhomboids (Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Trunk",
        "setup": "≈7° forward of upright, chest tall",
        "peak": "Unchanged (pelvis still)",
        "norm": "Upright and still (clinical opinion); in a comparison of rows the standing cable row needed the trunk to brace against the cable while the bent-over row loaded the low back most (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stretch 0.5 s with the arms long",
        "peak": "1.2 s pull, 0.4 s squeeze, 2 s return",
        "norm": "Controlled, about 1 s pull and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Standing Row, video (movement reference)",
        "url": "https://gymvisual.com/videos/11819-cable-standing-row.html"
      },
      {
        "id": "fenwick2009",
        "title": "Fenwick, Brown & McGill 2009, comparison of different rowing exercises: trunk muscle activation and lumbar spine motion, load and stiffness (J Strength Cond Res 23(2):350-358)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19197209/"
      },
      {
        "id": "oyama2010",
        "title": "Oyama, Myers, Wassinger and Lephart 2010, three-dimensional scapular and clavicular kinematics and scapular muscle activity during retraction exercises (J Orthop Sports Phys Ther 40(3):169-179)",
        "url": "https://chs.uky.edu/sites/default/files/2023-12/Oyama_2010_Three-Dimensional%20Scapular%20and%20Clavicular%20Kinematics.pdf"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain in the back, shoulder or elbow, numbness or tingling occurs.",
        "The cable load is user-chosen and limited by your balance: choose a weight you can row with the body still.",
        "At the end of the set step forward and let the bar back to the stack slowly.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low-back discomfort: use a staggered stance and a lighter load, or switch to a seated cable row (clinical opinion).",
        "Wrist discomfort with the straight bar: use a rope or a neutral-grip handle."
      ],
      "regressions": [
        "Lighter load.",
        "Band standing row anchored at waist height.",
        "Seated cable row."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Pause 1 s at the stomach.",
        "One-arm standing cable row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Prime mover: pulls the upper arm back past the trunk.",
      "lats_l": "Prime mover: pulls the upper arm back past the trunk.",
      "rhomboids_midtrap_r": "Prime mover: draws the shoulder blade back at the finish.",
      "rhomboids_midtrap_l": "Prime mover: draws the shoulder blade back at the finish.",
      "post_deltoid_r": "Helps pull the upper arm back.",
      "post_deltoid_l": "Helps pull the upper arm back.",
      "biceps_r": "Bends the elbow as the bar comes in.",
      "biceps_l": "Bends the elbow as the bar comes in.",
      "forearm_flexors_r": "Grip the bar.",
      "forearm_flexors_l": "Grip the bar.",
      "core": "Braces the trunk so the cable does not pull it forward.",
      "spinal_extensors_r": "Hold the spine upright.",
      "spinal_extensors_l": "Hold the spine upright.",
      "glute_max_r": "Holds the hips back to brace.",
      "glute_max_l": "Holds the hips back to brace.",
      "quads_r": "Hold the bent-knee brace.",
      "quads_l": "Hold the bent-knee brace.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
      "upper_traps_l": "Steadies the shoulder girdle; should not shrug."
