  "exercise": {
    "id": "band-standing-crunch",
    "name": "Band Standing Crunch",
    "aliases": [
      "Standing band crunch",
      "Band standing ab crunch",
      "Banded standing crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "8757",
      "title": "Band standing crunch",
      "url": "https://gymvisual.com/videos/8757-band-standing-crunch.html",
      "listing": "Video (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read; the movement follows the exercise name and standard coaching: facing a high band anchor, hands by the forehead)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Obliques"
    ],
    "equipment": [
      "Resistance band",
      "Pull-up bar (band anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk flexion, standing)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "lats_r",
        "lats_l",
        "triceps_r",
        "triceps_l",
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "lengthened": [
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl down, breathe in as you stand back up.",
      "cadence": "About 1.2 s down, short squeeze, 1.4 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "effort": "Stop 2-3 reps short of failure (clinical opinion)",
      "tempo": "1.2-0.4-1.4-0.4 (curl-squeeze-up-pause, seconds)",
      "rest": "30-60 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: step back from the anchor for more tension",
      "progression": "Stronger band, longer squeeze, slower return"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Face the anchor, band looped high over the bar. Feet hip width, knees soft. Hold the band in both hands by the forehead, elbows forward and down."
      },
      {
        "id": "c2",
        "phase": "crunch",
        "text": "Breathe out and curl the ribs down toward the pelvis, rounding the upper back; the hands stay by the forehead."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the abs at the bottom; hips stay over the feet, knees soft."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and uncurl slowly back to tall standing, controlling the band."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall for a moment, then curl again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hinging at the hips instead of curling the spine",
        "fix": "Think ribs to pelvis; the hips barely move."
      },
      {
        "id": "m2",
        "mistake": "Pulling the band down with the arms",
        "fix": "Keep the hands fixed by the forehead; the trunk does the work."
      },
      {
        "id": "m3",
        "mistake": "Yanking the neck forward",
        "fix": "Keep the chin slightly tucked and the head in line with the upper back."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap you upright",
        "fix": "Control the return; take 1-2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk flexion",
        "setup": "Upright (pelvis to C7 ≈5° from vertical)",
        "peak": "≈46° from vertical; spine channels ≈68° of flexion (L5 15, T12 28, T6 25)",
        "norm": "Curl through the spine (mostly thoracic and upper lumbar), as in the floor curl-up (Escamilla 2016; clinical opinion for the standing version)",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈3°",
        "peak": "≈24° (joint channel)",
        "norm": "Small: the hips stay over the feet (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈6°",
        "peak": "≈14°",
        "norm": "Soft knees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hands",
        "setup": "By the forehead, band up to the bar 218 cm high, 85 cm in front of the hands",
        "peak": "Unchanged relative to the head",
        "norm": "Fixed by the forehead, elbows forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.6 s",
        "peak": "1.2 s down, 0.4 s squeeze, 1.4 s up, 0.4 s pause",
        "norm": "Controlled, with a slower return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band standing crunch, video (movement reference)",
        "url": "https://gymvisual.com/videos/8757-band-standing-crunch.html"
      },
      {
        "id": "escamilla2016",
        "title": "Escamilla et al. 2016, muscle activation among supine, prone and side position exercises with and without a Swiss ball (Sports Health 8(4):372-379)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4922527"
      },
      {
        "id": "oliva2020",
        "title": "Oliva-Lozano and Muyor 2020, core muscle activity during physical fitness exercises: a systematic review (Int J Environ Res Public Health 17(12):4306)",
        "url": "https://www.mdpi.com/1660-4601/17/12/4306"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Check the band and the anchor before each set: the band runs close to the face, and a band that slips or snaps can hit you.",
        "Repeated loaded spinal flexion is a concern for people with disc problems (McGill 1998): keep the range moderate or choose an anti-extension exercise instead.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low back discomfort: smaller curl, more knee bend.",
        "Neck discomfort: keep the hands at the forehead and do not pull the head down."
      ],
      "regressions": [
        "Lighter band.",
        "Floor crunch.",
        "Partial range."
      ],
      "progressions": [
        "Stronger band.",
        "Pause 2 s at the bottom.",
        "Kneeling band crunch for more range."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the ribs toward the pelvis against the band; transversus abdominis braces. Curl-up type exercises put most of their load on the rectus abdominis (Escamilla 2016; Oliva-Lozano 2020 review).",
      "obliques_r": "Help the trunk curl and keep it square (clinical opinion; obliques work with the rectus in curl-ups, Escamilla 2016).",
      "obliques_l": "Help the trunk curl and keep it square (clinical opinion).",
      "hip_flexors_r": "Small hip bend as the trunk curls (clinical opinion).",
      "hip_flexors_l": "Small hip bend as the trunk curls (clinical opinion).",
      "lats_r": "Hold the arms steady against the band (clinical opinion).",
      "lats_l": "Hold the arms steady against the band (clinical opinion).",
      "triceps_r": "Hold the elbows against the band's pull (clinical opinion).",
      "triceps_l": "Hold the elbows against the band's pull (clinical opinion).",
      "quads_r": "Hold the soft knees (clinical opinion).",
      "quads_l": "Hold the soft knees (clinical opinion).",
      "glute_max_r": "Keep the hips under the trunk (clinical opinion).",
      "glute_max_l": "Keep the hips under the trunk (clinical opinion).",
      "spinal_extensors_r": "Lengthen as the spine rounds and control the return (clinical opinion).",
      "spinal_extensors_l": "Lengthen as the spine rounds and control the return (clinical opinion)."
    }
  },
