        "glute_max_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Brace in the hinge, breathe out as the bar comes up, in as it lowers.",
      "cadence": "About 1.2 s up, 0.4 s squeeze, 2 s down"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "60-90 s between sets",
      "sets": "3",
      "reps": "10-15",
      "tempo": "1 s up, short squeeze, 2 s down",
      "load": "Barbell load is user-chosen and light: the rear delts are small; no heaving (about 2-3 reps in reserve).",
      "progression": "Add reps first, then 1-2.5 kg."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Wide overhand grip (well outside the shoulders), knees soft, hinge until the trunk is close to level, back flat, bar hanging under the shoulders."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Lift the elbows out wide, away from the body, until the upper arms are level with the back; the bar comes up toward the upper chest."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the back of the shoulders and the shoulder blades together for a moment."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the hinge; start the next rep without standing up."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows tucked to the body",
        "fix": "Keep the upper arms out wide, about 70-90 degrees from the trunk, so the rear delts do the lifting."
      },
      {
        "id": "m2",
        "mistake": "Heaving with the trunk",
        "fix": "Lighter bar; the trunk stays still."
      },
      {
        "id": "m3",
        "mistake": "Shrugging to the ears",
        "fix": "Keep the shoulders down away from the ears."
      },
      {
        "id": "m4",
        "mistake": "Rounding the back",
        "fix": "Chest proud, brace; hinge only as far as a flat back allows."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk inclination",
        "setup": "≈20° above level",
        "peak": "Unchanged (held)",
        "norm": "Trunk near level so the arms work in horizontal abduction (common coaching); bent-over rows load the low back (Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Elbow flare",
        "setup": "Arms hanging under the shoulders, overhand 83 cm grip (handle centres)",
        "peak": "Upper arm ≈88° from the trunk line (head direction), elbow 9.9 cm from shoulder height",
        "norm": "Upper arms well out from the trunk; a pronated hand position favoured the posterior deltoid in horizontal abduction (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈18°",
        "peak": "≈115°, forearms about vertical; shoulder blades retracted (clavicle protraction 8° to -16°)",
        "norm": "Elbows bend to about 80-100 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.2 s up, 0.4 s squeeze, 2 s down, 1 s reset",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Keep the load light; set the bar down if the back starts to round.",
        "Low-back pain: do it chest-supported on an incline bench.",
        "Shoulder pain at the top: stop the elbows a little lower.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower back: chest-supported version.",
        "Grip width: just wide enough for the elbows to flare."
      ],
      "regressions": [
        "Dumbbell rear delt row.",
        "Band pull-apart.",
        "Face pull."
      ],
      "progressions": [
        "Pause at the top.",
        "Slower 3 s lowering."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Horizontal abduction with a pronated grip (Schoenfeld 2013).",
      "post_deltoid_l": "Horizontal abduction with a pronated grip (Schoenfeld 2013).",
      "rhomboids_midtrap_r": "Pull the shoulder blades together at the top.",
      "rhomboids_midtrap_l": "Pull the shoulder blades together at the top.",
      "infraspinatus_r": "Assists horizontal abduction and holds the humeral head.",
      "infraspinatus_l": "Assists horizontal abduction and holds the humeral head.",
      "upper_traps_r": "Steady the shoulder blades.",
      "upper_traps_l": "Steady the shoulder blades.",
      "lats_r": "Assist shoulder extension.",
      "lats_l": "Assist shoulder extension.",
      "biceps_r": "Bend the elbows.",
      "biceps_l": "Bend the elbows.",
      "spinal_extensors_r": "Hold the hinged back flat (Fenwick 2009).",
      "spinal_extensors_l": "Hold the hinged back flat (Fenwick 2009).",
      "hamstrings_r": "Hold the hips in the hinge.",
      "hamstrings_l": "Hold the hips in the hinge.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "forearm_flexors_r": "Hold the bar.",
