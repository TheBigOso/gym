    },
    "type": "Strength",
    "bodyPart": "Rear shoulders (posterior deltoid)",
    "secondaryBodyParts": [
      "Mid back",
      "Upper back",
      "Lower back"
    ],
    "equipment": [
      "Barbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder horizontal abduction, elbow)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "infraspinatus_r",
        "infraspinatus_l",
        "upper_traps_r",
        "upper_traps_l",
        "lats_r",
        "lats_l",
