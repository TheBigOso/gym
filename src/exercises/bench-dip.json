    "bodyPart": "Upper Arms",
    "secondaryBodyParts": [
      "Chest",
      "Shoulders"
    ],
    "equipment": [
      "Body weight",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "pec_r",
        "pec_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press up.",
      "cadence": "About 2 s down, short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-15 (stop 1-3 reps before form breaks)",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "progression": "More reps, then the feet further out (straighter legs); stop at upper arms parallel to the floor rather than going deeper"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hands on the edge of the bench beside the hips, fingers forward; walk the feet out, knees bent, heels on the floor; arms straight."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows straight back, lowering the hips close to the bench."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop when the upper arms are about parallel to the floor; shoulders down, chest open."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and push through the palms to straighten the arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked; shoulders away from the ears; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Going too deep",
        "fix": "Stop at upper arms about parallel to the floor; the bench dip already takes the shoulder to the end of its extension range (McKenzie 2022)."
      },
      {
        "id": "m2",
        "mistake": "Shoulders shrugging up and rolling forward",
        "fix": "Keep the shoulders down and back, chest open."
      },
      {
        "id": "m3",
        "mistake": "Hips drifting away from the bench",
        "fix": "Keep the back close to the bench edge as you lower."
      },
      {
        "id": "m4",
        "mistake": "Elbows flaring out",
        "fix": "Bend the elbows straight back."
      },
      {
        "id": "m5",
        "mistake": "Pushing with the legs",
        "fix": "Let the arms do the work; the feet only balance."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈10° (straight, not locked)",
        "peak": "≈119° at the bottom",
        "norm": "Arms straight but not locked at the top; with the hands gripping the bench edge the elbows are bent about 100-120 degrees when the upper arms reach parallel (clinical opinion); elbow flexion on the bench dip was less than on the bar dip (McKenzie 2022)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Shoulder extension",
        "setup": "≈20° (upper arm behind the trunk line)",
        "peak": "≈86° at the bottom",
        "norm": "Peak shoulder extension in a self-selected bench dip was about 88 degrees, 101% of the maximal range measured in each lifter, more than bar or ring dips (McKenzie 2022)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Upper arm angle to the floor",
        "setup": "≈66° (arm pointing down and back)",
        "peak": "≈0° (parallel)",
        "norm": "Stop with the upper arms about parallel to the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip travel",
        "setup": "Hips 51 cm above the floor, just in front of the bench",
        "peak": "30 cm down (hips 21 cm)",
        "norm": "Hips move straight down and up close to the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.0 s down, 0.3 s pause, 1.3 s up, 0.8 s at the top",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #012912, Bench Dip (knees bent), video (movement reference)",
        "url": "https://gymvisual.com/videos/14628-bench-dip-knees-bent.html"
      },
      {
        "id": "mckenzie2022",
        "title": "McKenzie, Crowley-McHattan, Meir, Whitting and Volschenk 2022, bench, bar, and ring dips: do kinematics and muscle activity differ? (Int J Environ Res Public Health 19(20):13211; PMC9603242)",
        "url": "https://www.mdpi.com/1660-4601/19/20/13211"
      },
      {
        "id": "boehler2011",
        "title": "Boehler 2011, electromyographic analysis of the triceps brachii muscle during a variety of triceps exercises (MS thesis, University of Wisconsin-La Crosse, ACE-sponsored; 15 women, 8 exercises at 70% 1RM)",
        "url": "https://minds.wisc.edu/items/4876923b-3a14-47c3-9a69-decf731bd027"
      }
    ],
    "safety": {
      "cautions": [
        "Shoulder: the bench dip takes the shoulder to about the end of its extension range, which can strain the front of the shoulder capsule; the study authors advised against it in regular training or rehabilitation (McKenzie 2022). Keep the range short (upper arms parallel at most).",
        "Skip it with a history of shoulder instability or pain at the front of the shoulder.",
        "Use a stable bench that cannot slide or tip.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorten the range, or switch to a close-grip push-up or a cable pushdown.",
        "Wrist discomfort: turn the fingers slightly out."
      ],
      "regressions": [
        "Shorter range.",
        "Feet closer to the bench (more weight on the legs)."
      ],
      "progressions": [
        "Straight legs.",
        "Feet on a second bench.",
        "Bar or parallel dips (less shoulder extension, more triceps; McKenzie 2022)."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Straightens the elbows to lift the body. Peak triceps EMG was lower on the bench dip (0.83 mV) than on bar (1.04) or ring dips (1.05) (McKenzie 2022); in another comparison dips matched kickbacks and triangle push-ups (Boehler 2011).",
      "triceps_l": "Straightens the elbows to lift the body. Peak triceps EMG was lower on the bench dip (0.83 mV) than on bar (1.04) or ring dips (1.05) (McKenzie 2022); in another comparison dips matched kickbacks and triangle push-ups (Boehler 2011).",
      "ant_deltoid_r": "Brings the arms forward from behind the body as you press up; significantly less active than on bar or ring dips (McKenzie 2022).",
      "ant_deltoid_l": "Brings the arms forward from behind the body as you press up; significantly less active than on bar or ring dips (McKenzie 2022).",
      "pec_r": "Helps the front of the shoulder press up, with lower activity than on bar or ring dips (McKenzie 2022).",
      "pec_l": "Helps the front of the shoulder press up, with lower activity than on bar or ring dips (McKenzie 2022).",
      "lats_r": "Keep the shoulders down and back, away from the ears (clinical opinion).",
      "lats_l": "Keep the shoulders down and back, away from the ears (clinical opinion).",
      "rhomboids_midtrap_r": "Hold the shoulder blades back so the chest stays open (clinical opinion).",
      "rhomboids_midtrap_l": "Hold the shoulder blades back so the chest stays open (clinical opinion).",
      "forearm_flexors_r": "Hold the hands on the edge of the bench.",
      "forearm_flexors_l": "Hold the hands on the edge of the bench.",
      "core": "Holds the trunk upright close to the bench.",
      "quads_r": "Hold the bent knees steady; the feet stay planted.",
      "quads_l": "Hold the bent knees steady; the feet stay planted."
    }
  },
