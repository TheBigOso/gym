      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper back and shoulders (lower and middle trapezius, rear and middle deltoid)",
    "secondaryBodyParts": [
      "Low back and hips (holding the hinge)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (shoulder flexion / scaption with scapular upward rotation)",
    "plane": "Multiplanar",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "rhomboids_midtrap_r",
