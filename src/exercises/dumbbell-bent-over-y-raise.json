    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The bent-over position loads the low back; keep the back flat and the weights light.",
        "Raise only as high as you can without pinching at the top of the shoulder."
      ],
      "modify": [
        "Low-back discomfort: do it chest-supported on an incline bench.",
        "Shoulder pinching: raise a little lower or use a smaller Y."
      ],
      "regressions": [
        "Chest-supported Y raise on an incline bench.",
        "No dumbbells (thumbs-up Y with empty hands)."
      ],
      "progressions": [
        "Two-second hold at the top.",
        "Y-T-W sequence."
      ]
    },
    "muscleNotes": {
      "rhomboids_midtrap_r": "Pull the shoulder blades back and down to set the arms; the rig has no separate lower trapezius, which Ekstrom (2003) found most active in the overhead prone raise.",
      "rhomboids_midtrap_l": "Pull the shoulder blades back and down to set the arms; the rig has no separate lower trapezius, which Ekstrom (2003) found most active in the overhead prone raise.",
      "upper_traps_r": "Upwardly rotates the shoulder blades as the arms go overhead.",
      "upper_traps_l": "Upwardly rotates the shoulder blades as the arms go overhead.",
      "post_deltoid_r": "Lifts the arm against gravity in the hinge.",
      "post_deltoid_l": "Lifts the arm against gravity in the hinge.",
      "lat_deltoid_r": "Helps raise the arm out to the side.",
      "lat_deltoid_l": "Helps raise the arm out to the side.",
      "infraspinatus_r": "Turns the arm out (thumbs up).",
      "infraspinatus_l": "Turns the arm out (thumbs up).",
      "serratus_r": "Upwardly rotates the shoulder blades.",
      "serratus_l": "Upwardly rotates the shoulder blades.",
      "spinal_extensors_r": "Hold the flat back in the hinge.",
      "spinal_extensors_l": "Hold the flat back in the hinge.",
      "hamstrings_r": "Hold the hinge at the hips.",
      "hamstrings_l": "Hold the hinge at the hips.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Keeps the trunk still."
    }
