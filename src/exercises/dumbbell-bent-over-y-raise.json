        "glute_max_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the arms rise into the Y, breathe in as you lower.",
      "cadence": "About 1.5 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0.5-1.5-0 (down-pause-up-bottom, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Very light dumbbells (often 1-5 kg); the long lever makes them feel heavy",
      "progression": "Add reps and pauses before adding weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet hip width, knees soft, hinge at the hips until the trunk is nearly parallel to the floor with a flat back. Dumbbells hang under the shoulders, palms facing in."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the straight arms forward and out into a Y, in line with the trunk, thumbs turning up toward the ceiling."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms in line with the back, about 45 degrees out from the head; draw the shoulder blades down and back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly back under the shoulders; keep the trunk still."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the hinge, reset and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shrugging the shoulders up to the ears",
        "fix": "Draw the shoulder blades down and back before you lift."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back to get the arms higher",
        "fix": "Stop where the arms line up with the back; keep the ribs down."
      },
      {
        "id": "m3",
        "mistake": "Bending the elbows and rowing",
        "fix": "Keep the arms long with a soft elbow."
      },
      {
        "id": "m4",
        "mistake": "Too heavy a dumbbell",
        "fix": "Go light: the arm is a long lever at the top."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk inclination",
        "setup": "≈17° above horizontal",
        "peak": "Unchanged",
        "norm": "Nearly parallel to the floor, flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arm elevation",
        "setup": "Arms hanging under the shoulders",
        "peak": "Upper arm ≈31° from the trunk line, hands ≈12° out from the head line, -10.1 cm above shoulder height",
        "norm": "Arms raised in line with the trunk, about 45 degrees out from the head (a Y); prone raise above the head in line with the lower trapezius fibres gave the highest lower trapezius EMG (Ekstrom 2003)",
        "sources": [
          "ekstrom2003"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈8°",
        "norm": "Slight, fixed bend (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Palms facing in",
        "peak": "Thumbs up toward the ceiling",
        "norm": "Palms in at the bottom, thumbs up at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈24°",
        "peak": "Unchanged",
        "norm": "Soft knees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold the hinge 0.8 s",
        "peak": "1.6 s up, 0.5 s hold, 2.0 s down",
        "norm": "Controlled, no swing (clinical opinion)",
        "sources": []
      }
    ],
