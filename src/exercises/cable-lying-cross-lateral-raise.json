  "exercise": {
    "id": "cable-lying-cross-lateral-raise",
    "name": "Cable Lying Cross Lateral Raise",
    "aliases": [
      "Supine cable lateral raise",
      "Lying crossed-cable lateral raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "21699",
      "title": "Cable Lying Cross Lateral Raise",
      "url": "https://gymvisual.com/videos/21699-cable-lying-cross-lateral-raise.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment, so the movement was taken from the exercise name and standard coaching: lying face up, the arm or arms sweeping out from the hips to shoulder level against crossed low-to-mid cables)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (lateral deltoid)",
    "secondaryBodyParts": [
      "Upper back (trapezius)"
    ],
    "equipment": [
      "Two cable towers",
      "D-handles",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "upper_traps_r",
        "upper_traps_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "effort": "Stop 0-3 reps short of failure (RIR 0-3)",
      "tempo": "2-0.4-2-0.6 (up-pause-down-pause, seconds)",
      "rest": "45-75 s",
      "frequency": "2-3 times a week",
      "load": "Cable stack load is user-chosen; light: the arm is a long lever",
      "progression": "Add reps, then one plate on the stack; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face up on a flat bench, feet flat, with cable towers beyond your feet. Cross the cables: the right hand holds the handle from the left tower and the left hand the handle from the right tower, hands beside the hips, elbows soft."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and sweep both arms out to the side along the bench, elbow soft, until the arm is level with the shoulder."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arm out at shoulder level, shoulder blade on the bench, ribs down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and bring the hand back toward the hip slowly; do not let the cable pull it in."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the cable taut, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the shoulder blade off the bench to reach",
        "fix": "Keep the upper back flat on the pad; shorten the range."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbow more as the arm moves out",
        "fix": "Keep the same soft elbow through the sweep."
      },
      {
        "id": "m3",
        "mistake": "Letting the cable snap the arm back",
        "fix": "Return over about 2 s."
      },
      {
        "id": "m4",
        "mistake": "Arching the lower back",
        "fix": "Brace, feet flat, ribs down."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "≈21° from the trunk line (hands beside the hips)",
        "peak": "≈92° (arms out at shoulder level)",
        "norm": "From beside the hips to about 90 degrees (the range used by Coratella 2020 for the dumbbell raise)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈14°",
        "norm": "Elbow soft, about 10-20 degrees, held nearly constant (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Crossed: pulleys 100 and 112 cm high beyond the feet, right hand to the left tower",
        "peak": "Cables clear of the body by at least 7.8 cm and of each other by 3.0 cm",
        "norm": "Lying face up removes most of the gravity load on the sideways sweep, so the crossed cable supplies the resistance and keeps it on at the start (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body on the bench",
        "setup": "Head, upper back and hips on the pad, feet flat",
        "peak": "Unchanged; hands at least 1000000000.0 cm above the pad",
        "norm": "Head, upper back and hips on the pad, feet flat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s, hands beside the hips",
        "peak": "1.8 s out, 0.4 s hold, 2 s back",
        "norm": "About 2 s out, a short pause, 2 s back (clinical opinion; Coratella 2020 used 2-0.5-2 with dumbbells)",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Lying Cross Lateral Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/21699-cable-lying-cross-lateral-raise.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7706677/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: start light; the arm is a long lever.",
        "Get the handles before lying down and hand them back (or let them return slowly) before sitting up.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Pinching near shoulder level: stop at about 70 degrees.",
        "Lower-back discomfort: put the feet on the bench end."
      ],
      "regressions": [
        "Lighter stack.",
        "Standing cable lateral raise.",
        "Side-lying dumbbell lateral raise."
      ],
      "progressions": [
        "Slower 3 s return.",
        "2 s hold at shoulder level."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Prime mover: sweeps the arm out against the cable. The lateral raise gave the highest medial deltoid activity among the tested exercises (Campos 2020, dumbbells).",
      "lat_deltoid_l": "Prime mover: sweeps the arm out against the cable. The lateral raise gave the highest medial deltoid activity among the tested exercises (Campos 2020, dumbbells).",
      "ant_deltoid_r": "Helps the sweep, more if the arm drifts toward the ceiling.",
      "ant_deltoid_l": "Helps the sweep, more if the arm drifts toward the ceiling.",
      "post_deltoid_r": "Assists abduction near the start.",
      "post_deltoid_l": "Assists abduction near the start.",
      "serratus_r": "Upward rotation of the shoulder blade as the arm moves out.",
      "serratus_l": "Upward rotation of the shoulder blade as the arm moves out.",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred.",
      "upper_traps_r": "Supports the shoulder blade; reaching or shrugging shifts work here.",
      "upper_traps_l": "Supports the shoulder blade; reaching or shrugging shifts work here.",
      "core": "Keeps the trunk still on the bench.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle."
    }
