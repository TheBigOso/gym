        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press up.",
      "cadence": "About 1.8 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "5-12 (stop 1-2 reps before form breaks)",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, slower lowering, then feet elevated"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "High plank with the hands together under the chest, thumbs and index fingers touching in a diamond."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the chest toward the diamond; elbows go back and slightly out."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Chest a few centimetres above the hands, body still one line."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press the floor away until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Hold the plank at the top, then go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring straight out to the sides",
        "fix": "Let them travel back at about 30-45 degrees from the body."
      },
      {
        "id": "m2",
        "mistake": "Hands under the face",
        "fix": "Place the diamond under the lower chest (sternum)."
      },
      {
        "id": "m3",
        "mistake": "Hips sagging or piking",
        "fix": "Brace the abs and squeeze the glutes."
      },
      {
        "id": "m4",
        "mistake": "Shortened range",
        "fix": "Lower until the chest nearly touches the hands, or regress to the knees."
      }
    ],
    "kinematics": [
      {
        "measure": "Hand width",
        "setup": "Wrists 25 cm apart, fingers turned in 40° so the thumbs and index fingers meet (shoulder joints 40 cm apart)",
        "peak": "Unchanged (hands planted)",
        "norm": "Thumbs and index fingers touching under the sternum; diamond hands gave the highest triceps and pectoralis activation of the hand positions tested (Intziegianni 2026; ACE triceps study ranked the triangle push-up first)",
        "sources": [
          "intziegianni2026",
          "ace2011"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈8° (arms straight, not locked)",
        "peak": "≈125° at the bottom (chest 11 cm above the floor)",
        "norm": "Arms straight but not locked at the top; elbows bend to about 90 degrees or more at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "≈-13° (arms near vertical)",
        "peak": "≈22° at the bottom",
        "norm": "Elbows close to the ribs, about 10-30 degrees from the body at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line",
        "setup": "Trunk ≈23° above horizontal; trunk-to-leg bend -0.0°",
        "peak": "Trunk ≈9°; bend -0.1°",
        "norm": "Head, trunk, hips and ankles (or knees) in one straight line throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Wrist extension",
        "setup": "≈83°",
        "peak": "≈33° at the bottom",
        "norm": "Palms flat; the wrist bends back about 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up; lab studies used 2-2.5 s per repetition (Marcolin 2015)",
        "sources": [
          "marcolin2015"
        ]
      }
    ],
