  "exercise": {
    "id": "lever-seated-leg-press",
    "name": "Lever Seated Leg Press",
    "aliases": [
      "Seated leg press machine",
      "Plate-loaded seated leg press",
      "Lever leg press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "4359",
      "title": "Lever Seated Leg Press",
      "url": "https://gymvisual.com/videos/4359-lever-seated-leg-press.html",
      "listing": "Video (title from the listing URL; the page could not be fetched from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Hips (glutes)"
    ],
    "equipment": [
      "Seated leg press (plate-loaded lever)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip and knee)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "hamstrings_r",
        "hamstrings_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the plate comes toward you, breathe out as you press it away.",
      "cadence": "About 2 s toward you, a short pause, about 1.2 s press"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-15",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Machine load is user-chosen: pick a weight you can move through the full range shown with good form, leaving about 2-3 reps in reserve (RPE 7-8).",
      "rest": "1.5-2 minutes between sets",
      "progression": "Add a small amount of load when every rep of every set reaches the full range with good form."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with the hips and back flat on the pads and hold the side handles. Feet about hip width in the middle of the plate, toes out a little. Press the plate out to nearly straight legs."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the plate come toward you under control, the knees tracking over the toes."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop when the knee is bent about 90 degrees, before the lower back starts to curl off the pad."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and press the plate away through the whole foot, heel down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Legs nearly straight, knees soft; go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lower back and hips curling off the pad at the bottom",
        "fix": "Stop the plate a little earlier, or set the seat further back."
      },
      {
        "id": "m2",
        "mistake": "Heels lifting off the plate",
        "fix": "Place the foot a little higher and press through the heel and mid-foot."
      },
      {
        "id": "m3",
        "mistake": "Locking the knees hard at the top",
        "fix": "Stop just short of a hard lockout."
      },
      {
        "id": "m4",
        "mistake": "Knees caving in",
        "fix": "Keep the knee in line with the second toe; use a lighter load."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "norm": "From nearly straight to about 90 degrees; knee forces rise with knee flexion in the leg press (Escamilla 1998)",
        "sources": [
          "escamilla1998"
        ],
        "setup": "≈10° at the top",
        "peak": "≈89° at the bottom"
      },
      {
        "measure": "Hip flexion",
        "norm": "Hips flex deeply at the bottom while the pelvis stays on the seat (common coaching)",
        "sources": [],
        "setup": "≈87° at the top",
        "peak": "≈128° at the bottom (back on the pad)"
      },
      {
        "measure": "Ankle",
        "norm": "Heel stays down on the plate; the ankle bends with the knee (common coaching)",
        "sources": [],
        "setup": "≈-11° dorsiflexion at the top",
        "peak": "≈10° at the bottom"
      },
      {
        "measure": "Seat and back",
        "norm": "Hips and back stay on the pads through the rep (machine design)",
        "sources": [],
        "setup": "Seat 46 cm high, back pad 20° back from vertical",
        "peak": "Unchanged (hips and back on the pads)"
      },
      {
        "measure": "Plate travel",
        "norm": "Fixed by the lever: the plate swings on an arc about its pivot",
        "sources": [],
        "setup": "Plate on a 95 cm lever arm",
        "peak": "14.6° of lever swing"
      },
      {
        "measure": "Foot position",
        "norm": "Middle of the plate, about hip width; higher feet bring in more hip, lower feet more knee (common coaching)",
        "sources": [],
        "setup": "Feet 26 cm apart on the plate, toes out 8°",
        "peak": "The ball of the foot stays on the same spot of the plate"
      },
      {
        "measure": "Tempo",
        "norm": "Controlled, about 2 s toward you and 1-1.5 s press (clinical opinion)",
        "sources": [],
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up"
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Lever Seated Leg Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/4359-lever-seated-leg-press.html"
      },
      {
        "id": "escamilla1998",
        "title": "Escamilla et al. 1998, biomechanics of the knee during closed kinetic chain and open kinetic chain exercises (Med Sci Sports Exerc 30(4):556-569; PubMed 9565938)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9565938/"
      }
    ],
    "safety": {
      "cautions": [
        "Set the seat so the knee bends to about 90 degrees without the lower back leaving the pad.",
        "Keep the lower back on the pad; stop the descent where the hips start to curl.",
        "Knee pain: shorten the range or move the foot higher on the plate.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee pain: press through a pain-free range.",
        "Low-back discomfort: shorten the range so the pelvis stays on the seat."
      ],
      "regressions": [
        "Lighter load, shorter range.",
        "Body-weight box squat."
      ],
      "progressions": [
        "Single-leg press.",
        "Pause at the bottom."
      ]
    },
    "muscleNotes": {
      "quads_r": "Prime mover: straightens the knee; open-chain extension works the quadriceps hardest near straight legs (Escamilla et al. 1998).",
      "quads_l": "Prime mover: straightens the knee; open-chain extension works the quadriceps hardest near straight legs (Escamilla et al. 1998).",
      "glute_max_r": "Extends the hip from the deep hip bend at the bottom (clinical opinion).",
      "glute_max_l": "Extends the hip from the deep hip bend at the bottom (clinical opinion).",
      "adductors_r": "Adductor magnus helps extend the hip from deep flexion (clinical opinion).",
      "adductors_l": "Adductor magnus helps extend the hip from deep flexion (clinical opinion).",
      "hamstrings_r": "Lengthen at the top with the knee straight; they do not lift the load.",
      "hamstrings_l": "Lengthen at the top with the knee straight; they do not lift the load.",
      "calves_r": "Keep the ankle steady against the plate.",
      "calves_l": "Keep the ankle steady against the plate.",
      "core": "Keeps the pelvis still on the seat.",
      "forearm_flexors_r": "Hold the side handles to keep the hips down.",
      "forearm_flexors_l": "Hold the side handles to keep the hips down."
    }
  },
