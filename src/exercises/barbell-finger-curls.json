  "exercise": {
    "id": "barbell-finger-curls",
    "name": "Barbell Finger Curls",
    "aliases": [
      "Barbell finger curl",
      "Seated barbell finger roll",
      "Barbell finger roll-up"
    ],
    "reference": {
      "source": "GymVisual",
      "title": "Barbell Finger Curls",
      "url": "https://gymvisual.com/videos/19708-barbell-finger-curls.html",
      "productRef": "19708",
      "listing": "Video (title from the listing URL; the page could not be read from this environment, gymvisual.com is blocked by the proxy, so the movement is taken from the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Forearms (finger flexors)",
    "secondaryBodyParts": [
      "Grip"
    ],
    "equipment": [
      "Barbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (fingers, wrist)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_extensors_r",
        "forearm_extensors_l",
        "biceps_r",
        "biceps_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the bar rolls down, out as you curl it up.",
      "cadence": "About 1.5 s down, 1.4 s up"
    },
    "prescription": {
      "frequency": "2-3 times a week",
      "rest": "45-60 seconds between sets",
      "sets": "2-3",
      "reps": "12-20",
      "tempo": "Slow roll down, short hold, controlled curl, squeeze",
      "load": "Barbell load is user-chosen: light enough to hold at the fingertips without dropping it.",
      "progression": "Add reps, then 1-2.5 kg."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the end of a bench, forearms along the thighs, palms up, wrists just past the knees, bar in a full fist about shoulder width."
      },
      {
        "id": "c2",
        "phase": "roll",
        "text": "Let the wrists bend back and open the fingers so the bar rolls down to the fingertips."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Hold the bar at the fingertips for a moment; do not let it slip."
      },
      {
        "id": "c4",
        "phase": "curl",
        "text": "Curl the fingers to roll the bar back into the palm, then curl the wrists up."
      },
      {
        "id": "c5",
        "phase": "squeeze",
        "text": "Squeeze the fist hard at the top."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Keep the forearms on the thighs for the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the forearms off the thighs",
        "fix": "Keep the forearms pinned; only the hands move."
      },
      {
        "id": "m2",
        "mistake": "Letting the bar slip off the fingertips",
        "fix": "Use a lighter bar and keep the fingertips hooked."
      },
      {
        "id": "m3",
        "mistake": "Bouncing at the bottom",
        "fix": "Pause at the fingertips before curling."
      },
      {
        "id": "m4",
        "mistake": "Short range",
        "fix": "Open the hand fully, then close it fully."
      }
    ],
    "kinematics": [
      {
        "measure": "Wrist position",
        "setup": "20° flexion with a closed fist at the top",
        "peak": "47° extension at the bottom (arc ≈67°)",
        "norm": "Grip is strongest at about 35 degrees of wrist extension and needs at least 25 degrees (O'Driscoll 1992); the wrist bends back to let the bar roll out (clinical opinion)",
        "sources": [
          "odriscoll1992"
        ]
      },
      {
        "measure": "Finger action",
        "setup": "Full fist around the bar",
        "peak": "Not animated: the player keeps a holding hand closed with the bar fixed in it, so the roll to the fingertips is shown by the wrist bending back and by the cues",
        "norm": "Fingers open until the bar sits at the fingertips, then curl it back into a full fist (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm on the thigh",
        "setup": "Elbow at 62% of the thigh, wrist at 122% (just past the knee); grip 47.1 cm between the handle points",
        "peak": "Forearms still (elbows and wrists move 0 cm over the loop); bar at least 6.31 cm off the legs",
        "norm": "Forearms rest along the thighs and stay still; the wrists just past the knees so the hands move freely (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.5 s",
        "peak": "1.5 s roll down, 0.4 s hold, 1.4 s curl up, 0.6 s squeeze",
        "norm": "Slow and controlled with a squeeze in the fist (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Use a light bar: the fingertip position is a weak grip.",
        "Wrist or finger pain, or a recent hand injury: use a band or skip.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Smaller range: roll only to the middle of the fingers."
      ],
      "regressions": [
        "Dumbbell finger curl.",
        "Squeezing a soft ball."
      ],
      "progressions": [
        "Slower lowering.",
        "Barbell seated wrist curl after the finger curl."
      ]
    },
    "muscleNotes": {
      "forearm_flexors_r": "The finger flexors let the bar roll out to the fingertips and curl it back into the palm; the wrist flexors finish the curl.",
      "forearm_flexors_l": "The finger flexors let the bar roll out to the fingertips and curl it back into the palm; the wrist flexors finish the curl.",
      "forearm_extensors_r": "Steady the wrist.",
      "forearm_extensors_l": "Steady the wrist.",
      "biceps_r": "Hold the elbows bent with the forearms on the thighs.",
      "biceps_l": "Hold the elbows bent with the forearms on the thighs.",
      "core": "Holds the forward lean."
    },
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Barbell Finger Curls, video (movement reference)",
