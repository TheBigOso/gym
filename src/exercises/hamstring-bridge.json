{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "hamstring-bridge",
    "name": "Hamstring Bridge",
    "aliases": [
      "Heel bridge",
      "Long-lever bridge",
      "Straight-leg hamstring bridge (bent-knee version)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "19374",
      "title": "Hamstring Bridge (male)",
      "url": "https://gymvisual.com/videos/19374-hamstring-bridge-male.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (hamstrings)",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip extension with the knees only slightly bent)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hamstrings_r",
        "hamstrings_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you dig the heels in and lift, inhale as you lower.",
      "cadence": "About 1.5 s up, 1 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12",
      "tempo": "1.5-1-2-0",
      "frequency": "2-3 times a week",
      "progression": "Feet further out, then single-leg hamstring bridge, then heels on a bench"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back with the heels on the mat well past the knees, toes pulled up, knees slightly bent, arms by your sides."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out, dig the heels into the floor and lift the hips."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Shoulders, hips and knees in one line; feel the backs of the thighs work."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the hips slowly to the mat."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch down lightly and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pushing through the toes",
        "fix": "Toes up, drive through the heels only."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back",
        "fix": "Ribs down, slight pelvic tuck before you lift."
      },
      {
        "id": "m3",
        "mistake": "Feet too close (becomes a glute bridge)",
        "fix": "Keep the heels well past the knees so the knees stay only slightly bent."
      },
      {
        "id": "m4",
        "mistake": "Cramping",
        "fix": "Shorten the lever (feet a little closer) and build up."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈28° (lying)",
        "peak": "≈-5° (line 180°)",
        "norm": "Hips extend to about neutral at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈54°",
        "peak": "≈45° at the top",
        "norm": "Knees only slightly to moderately bent (about 30-50 degrees); less knee bend raises hamstring activity in bridging (Lehecka 2017)",
        "sources": [
          "lehecka2017"
        ]
      },
      {
        "measure": "Ankle",
        "setup": "Toes up 35° off the floor, heel down (ankle ≈-27°)",
        "peak": "Unchanged foot; ankle ≈-22°",
        "norm": "Toes pulled up, weight on the heels (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip height",
        "setup": "Hip joint 8.6 cm above the floor",
        "peak": "20.8 cm (+12.2 cm)",
        "norm": "Pelvis lifts until shoulders, hips and knees line up (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Lying 0.8 s",
        "peak": "1.5 s up, 1.0 s squeeze, 2.0 s down, 0.7 s reset",
        "norm": "About 1.5 s up, a 1 s squeeze, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #19374, Hamstring Bridge (male) (movement reference only)",
        "url": "https://gymvisual.com/videos/19374-hamstring-bridge-male.html"
      },
      {
        "id": "lehecka2017",
        "title": "Lehecka et al. 2017, building a better gluteal bridge: EMG of hip muscles during modified single-leg bridges (Int J Sports Phys Ther 12(4):543-549; PMC5534144)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5534144/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      }
    ],
    "safety": {
      "cautions": [
        "Hamstring cramps: lower, rest and bring the feet a little closer.",
        "Low back discomfort: lift less high and brace first.",
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Cramping: knees more bent."
      ],
      "regressions": [
        "Glute bridge."
      ],
      "progressions": [
        "Single-leg hamstring bridge.",
        "Heels on a bench.",
        "Slider hamstring curls."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor holding the pelvis up.",
      "glute_max_l": "Main hip extensor holding the pelvis up.",
      "hamstrings_r": "Main target: with the knees nearly straight the hamstrings do most of the hip extension (Lehecka 2017 found more hamstring activity with less knee bend).",
      "hamstrings_l": "Main target: with the knees nearly straight the hamstrings do most of the hip extension (Lehecka 2017 found more hamstring activity with less knee bend).",
      "adductors_r": "Assist hip extension and keep the knees from drifting apart.",
      "adductors_l": "Assist hip extension and keep the knees from drifting apart.",
      "glute_med_r": "Keeps the pelvis level, most of all when one foot is off the floor.",
      "glute_med_l": "Keeps the pelvis level, most of all when one foot is off the floor.",
      "quads_r": "Hold the knee angle.",
      "quads_l": "Hold the knee angle.",
      "core": "Bracing keeps the ribs down and the pelvis from rotating.",
      "obliques_r": "Resist pelvic rotation when one leg lifts.",
      "obliques_l": "Resist pelvic rotation when one leg lifts.",
      "spinal_extensors_r": "Hold the trunk straight without over-arching.",
      "spinal_extensors_l": "Hold the trunk straight without over-arching.",
      "hip_flexors_r": "Lift the knee of the free leg.",
      "hip_flexors_l": "Lift the knee of the free leg.",
      "calves_r": "Hold the heels down with the toes pulled up.",
      "calves_l": "Hold the heels down with the toes pulled up."
    }
  },
