  "exercise": {
    "id": "landmine-press",
    "name": "Landmine Press",
    "aliases": [
      "Standing landmine press",
      "Single-arm landmine press",
      "Landmine shoulder press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11804",
      "title": "Landmine Press",
      "url": "https://gymvisual.com/videos/11804-landmine-press.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (front deltoid)",
    "secondaryBodyParts": [
      "Upper chest",
      "Triceps",
      "Core"
    ],
    "equipment": [
      "Landmine (barbell in a floor pivot)",
      "Weight plate"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "ant_deltoid_r",
        "pec_r"
      ],
      "synergist": [
        "lat_deltoid_r",
        "triceps_r",
        "serratus_r",
        "upper_traps_r"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "core",
        "glute_max_r",
        "glute_max_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "quads_r",
        "quads_l",
        "infraspinatus_r"
      ],
      "lengthened": [
        "ant_deltoid_r",
        "pec_r"
      ]
    },
    "breathing": {
      "pattern": "Brace at the shoulder, breathe out as you press, breathe in as the bar comes back.",
      "cadence": "About 1.4 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12 per side",
      "tempo": "2-0-1-1",
      "load": "A load you can press with 1-3 reps in reserve (RIR 1-3, clinical opinion)",
      "frequency": "2 times a week",
      "progression": "Add plates in small steps"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing the landmine, left foot a little forward; hold the end of the bar in the right hand in front of the right shoulder, left hand on the hip, ribs down."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press the bar up and forward along its arc until the arm is long."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Reach a little at the top so the shoulder blade moves around the ribs; do not lean back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the bar back to the shoulder under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Re-brace; repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back to finish the press",
        "fix": "Brace the abs and squeeze the glutes; the trunk stays tall."
      },
      {
        "id": "m2",
        "mistake": "Elbow flaring wide",
        "fix": "Keep the elbow in front of the body, about 30-45 degrees from the trunk."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the top",
        "fix": "Reach forward along the bar, not up into the ear."
      },
      {
        "id": "m4",
        "mistake": "Twisting the trunk",
        "fix": "Keep the hips and shoulders square to the bar."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance",
        "setup": "Staggered: left foot 36 cm ahead of the right, feet 24 cm apart, soft knees; pivot 187.7 cm in front of the front foot",
        "peak": "Unchanged; trunk ≈0° forward into the bar",
        "norm": "Staggered stance, opposite foot forward, for a stable base (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation",
        "setup": "≈24°",
        "peak": "≈82°",
        "norm": "The landmine arc tops out below vertical, a shoulder-friendly press for limited overhead mobility (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈139°",
        "peak": "≈73°",
        "norm": "From about 100-120 degrees at the shoulder to nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar angle",
        "setup": "≈33° above the floor at the shoulder",
        "peak": "≈43° at the top; the hand travels 38.2 cm along the arc",
        "norm": "The hand rides the bar's arc; the bar rises from about 20-25 to 40-45 degrees above the floor (geometry)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Brace 0.8 s at the shoulder",
        "peak": "1.4 s up, 0.4 s at the top, 2 s down",
        "norm": "About 1.5 s up, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11804, Landmine Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/11804-landmine-press.html"
      },
      {
        "id": "saeterbakken2012",
        "title": "Saeterbakken & Fimland 2012, muscle activity of the core during bilateral, unilateral, seated and standing resistance exercise (Eur J Appl Physiol 112:1671-1678)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21877146/"
      },
      {
        "id": "collins2021",
        "title": "Collins, Klawitter, Waldera, Mahoney & Christensen 2021, differences in muscle activity and kinetics between the goblet squat and landmine squat in men and women (J Strength Cond Res 35(10):2661-2668)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/34341315/"
      }
    ],
    "safety": {
      "cautions": [
        "Seat the bar end firmly in the landmine pivot before loading.",
        "Shoulder pain: shorten the range and press more forward than up (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Half-kneeling or tall-kneeling for less trunk demand."
      ],
      "regressions": [
        "Tall-kneeling landmine press.",
        "Lighter load."
      ],
      "progressions": [
        "Heavier load.",
        "Landmine push press."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Raises the upper arm forward.",
      "pec_r": "Brings the upper arm across and forward (pressing).",
      "lat_deltoid_r": "Raises the upper arm out to the side.",
      "triceps_r": "Straightens the elbow.",
      "serratus_r": "Moves the shoulder blade forward around the ribs and holds it to the chest wall.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
      "obliques_r": "Turn and brace the trunk.",
      "obliques_l": "Turn and brace the trunk.",
      "core": "Braces the trunk so the body stays in one line.",
      "glute_max_r": "Keeps the hips extended in line with the body.",
      "glute_max_l": "Keeps the hips extended in line with the body.",
      "spinal_extensors_r": "Hold the spine long.",
      "spinal_extensors_l": "Hold the spine long.",
      "quads_r": "Keep the knees straight.",
      "quads_l": "Keep the knees straight.",
      "infraspinatus_r": "Turns the upper arm out and steadies the shoulder."
    }
  },
