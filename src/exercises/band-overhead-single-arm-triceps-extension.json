    "breathing": {
      "pattern": "Inhale as the band draws the hand down behind the head, exhale as you straighten the arm.",
      "cadence": "About 2.3 s down, short pause, about 1.4 s up"
    },
    "prescription": {
      "sets": "2-3 per arm",
      "reps": "8-12",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "progression": "More reps, a slower return, a shorter band length (more stretch), then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop the band low around a rack upright and stand with your back to it, feet hip width, knees soft; the band runs up behind you to the handle in the right hand, arm straight overhead, palm facing in; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbow, letting the band draw the hand down behind the head; the elbow points up."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Hand behind the head, upper arm beside the ear; keep the band taut."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbow against the band, pressing the hand back overhead."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arm straight but not locked; trunk tall; repeat, then switch arms."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbow drifting forward or out to the side",
        "fix": "Keep the elbow pointing up beside the head."
      },
      {
        "id": "m2",
        "mistake": "Leaning forward to make the band easier",
        "fix": "Stand tall; step closer to the anchor instead."
      },
      {
        "id": "m3",
        "mistake": "Letting the band snap the hand down",
        "fix": "Lower for about 2 s, hand behind (not onto) the head."
      },
      {
        "id": "m4",
        "mistake": "Lower back arching",
        "fix": "Brace, ribs down."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (straight, not locked)",
        "peak": "≈112° at the bottom",
        "norm": "Straight but not locked at the top; lower until the hand is behind the head, about 100-120 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation (upper arm)",
        "setup": "≈167° from the trunk line, elbow 15 cm from the midline",
        "peak": "Unchanged (upper arm drifts at most 0.0° over the loop)",
        "norm": "Upper arm overhead beside the head and still: the long head works lengthened, which gave more triceps growth than training with the arm at the side (PubMed 35819335)",
        "sources": [
          "overhead2022"
        ]
      },
      {
        "measure": "Band",
        "setup": "Looped around the rack upright 60 cm behind, 40 cm up, in line with the right shoulder; strand 108.9 cm with the hand behind the head",
        "peak": "Strand 160.3 cm with the arm straight; at least 9.7 cm from the body (closest: biceps_r), handle 20.6 cm from the head",
        "norm": "Anchored low behind the body so it runs up behind the back and pulls the hand down behind the head; tension is highest with the arm straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Standing tall (≈5° from vertical), feet 24 cm apart, left hand on the hip",
        "peak": "Unchanged",
        "norm": "Standing tall and square, feet about hip width (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.3 s down, 0.3 s pause, 1.4 s up, 0.6 s at the top",
        "norm": "Controlled, about 2 s lowering and 1-1.5 s pressing (clinical opinion); the training study used 5 sets of 10 at 70% 1RM, twice a week (PubMed 35819335)",
        "sources": [
          "overhead2022"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Overhead Single Arm Triceps Extension, video (movement reference)",
        "url": "https://gymvisual.com/videos/12871-band-overhead-single-arm-triceps-extension.html"
      },
      {
        "id": "overhead2022",
        "title": "Triceps brachii hypertrophy is substantially greater after elbow extension training performed in the overhead versus neutral arm position (Eur J Sport Sci 2022, DOI 10.1080/17461391.2022.2100279; PubMed 35819335; 21 adults, 12 weeks, cable)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/35819335/"
      },
      {
        "id": "ace2011",
        "title": "Boehler, Porcari, Kline, Hendrix and Foster, ACE-sponsored research: best triceps exercises (American Council on Exercise; University of Wisconsin-La Crosse, 15 trained women, triceps EMG relative to the triangle push-up)",
        "url": "https://www.acefitness.org/certifiednewsarticle/1562/ace-study-identifies-best-triceps-exercises/"
      }
    ],
    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a heavy bench frame or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is lightest at the start and heaviest at the end of the push; let it return under control rather than snapping back.",
        "Shoulder pain overhead: shorten the range or switch to a band pushdown (clinical opinion).",
        "Elbow pain: use a lighter band and a slower lowering.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Left hand supporting the right upper arm.",
        "Seated tall on a bench with the band anchored low behind it."
      ],
      "regressions": [
        "Lighter band, partial range.",
        "Band triceps pushdown."
      ],
      "progressions": [
        "Stronger band or a shorter band length.",
        "Slower lowering (3 s).",
        "Single-arm dumbbell overhead extension."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Holds the upper arm up beside the head (clinical opinion).",
      "ant_deltoid_l": "Holds the upper arm up beside the head (clinical opinion).",
      "lat_deltoid_r": "Helps hold the arm overhead (clinical opinion).",
      "lat_deltoid_l": "Helps hold the arm overhead (clinical opinion).",
      "upper_traps_r": "Rotates the shoulder blade upward to keep the arm overhead (clinical opinion).",
      "upper_traps_l": "Rotates the shoulder blade upward to keep the arm overhead (clinical opinion).",
      "serratus_r": "Works with the upper trapezius to hold the shoulder blade in upward rotation (clinical opinion).",
      "serratus_l": "Works with the upper trapezius to hold the shoulder blade in upward rotation (clinical opinion).",
      "forearm_flexors_r": "Grip the band handle, palm facing in.",
      "forearm_flexors_l": "Grip the band handle, palm facing in.",
      "core": "Keeps the trunk tall and square against the one-arm pull from behind (clinical opinion).",
      "triceps_r": "Straightens the elbow with the arm overhead, where the long head is lengthened. Twelve weeks of overhead cable extensions grew the long head (+28.5% vs +19.6%) and the whole triceps (+19.9% vs +13.9%) more than the same training with the arm at the side, despite 34-39% lighter loads (Eur J Sport Sci 2022, PubMed 35819335). Overhead extensions reached 76% of the triangle push-up's triceps EMG in the ACE study (Boehler et al.).",
      "triceps_l": "Straightens the elbow with the arm overhead, where the long head is lengthened. Twelve weeks of overhead cable extensions grew the long head (+28.5% vs +19.6%) and the whole triceps (+19.9% vs +13.9%) more than the same training with the arm at the side, despite 34-39% lighter loads (Eur J Sport Sci 2022, PubMed 35819335). Overhead extensions reached 76% of the triangle push-up's triceps EMG in the ACE study (Boehler et al.)."
    }
