    "breathing": {
      "pattern": "Inhale as you lower the dumbbell, exhale as you press it up.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12 per arm",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9); start a little lighter than one hand of your two-arm incline press.",
      "progression": "Add reps up to the top of the range, then the next dumbbell; finish all reps on the weaker arm first."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Back pad at 30 degrees, glutes in the crease, upper back and head on the pad, feet planted wide; one dumbbell up over the right shoulder, palm forward, the free hand resting on the stomach."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the dumbbell under control, elbow about 45-60 degrees from the side, forearm vertical; keep the chest square, do not let the trunk roll toward the weight."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbell beside the upper chest, upper arm just below the bench line; brief pause, no bounce."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press up and slightly in until the arm is straight over the shoulder."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause at the top with the shoulder blade still pinned to the pad, then lower again. Switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Trunk rolling toward the working arm",
        "fix": "Brace the trunk and plant the opposite foot; both shoulder blades stay on the pad."
      },
      {
        "id": "m2",
        "mistake": "Elbow flared straight out at 90 degrees",
        "fix": "Bring the elbow to about 45-60 degrees from the body."
      },
      {
        "id": "m3",
        "mistake": "Bouncing out of the bottom or cutting the range short",
        "fix": "Lower under control to beside the chest, pause, then press."
      },
      {
        "id": "m4",
        "mistake": "Wrist bent back, dumbbell drifting toward the face",
        "fix": "Keep the forearm vertical under the dumbbell and the wrist straight."
      },
      {
        "id": "m5",
        "mistake": "Hips lifting off the seat",
        "fix": "Keep the glutes in the crease and both feet planted."
      }
    ],
