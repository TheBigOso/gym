    "breathing": {
      "pattern": "Breathe in at the shoulders and brace, breathe out as you press; breathe in as you lower.",
      "cadence": "About 1.5 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-12",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0-1.5-0 (down-pause-up-pause, seconds)",
      "rest": "90-120 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; the EMG studies used 80% of 1RM (Saeterbakken 2013; Saeterbakken 2012)",
      "progression": "Add reps, then weight; single-arm or alternating standing press"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet about hip width, knees soft, ribs down and glutes lightly braced. Dumbbells at shoulder height, palms forward, elbows under the wrists and a little in front."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press up and slightly in; keep the ribs down and glutes tight."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms nearly straight overhead, dumbbells over the shoulders, head through."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower in about 2 s to shoulder height, elbows under the wrists."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brace again at the shoulders and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back and arching the low back",
        "fix": "Squeeze the glutes and brace the abs; lighter dumbbells."
      },
      {
        "id": "m2",
        "mistake": "Using the legs to bounce the weight up",
        "fix": "Knees stay soft and still (a push press is a different exercise)."
      },
      {
        "id": "m3",
        "mistake": "Elbows flaring straight out or behind the body",
        "fix": "Keep the elbows a little in front (scapular plane)."
      },
      {
        "id": "m4",
        "mistake": "Half reps",
        "fix": "Lower to about shoulder height and press to nearly straight arms."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder elevation",
        "setup": "≈80° (upper arm vs trunk)",
        "peak": "≈167°",
        "norm": "From about 80-90 degrees at the bottom to about 160-170 degrees overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈98°, forearm vertical",
        "peak": "≈12° (nearly straight)",
        "norm": "About 90 degrees at the bottom with the forearms vertical, nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Plane of elevation",
        "setup": "elbows ≈30° in front of the frontal plane",
        "peak": "≈40°",
        "norm": "Elbows about 20-40 degrees in front of the frontal plane (scapular plane; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "upright, knees ≈5°",
        "peak": "unchanged (no lean back, no leg drive)",
        "norm": "Upright and stacked, knees soft; standing presses demand much more trunk activity than seated (Saeterbakken 2012)",
        "sources": [
          "saeterbakken2012"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.8 s at the shoulders",
        "peak": "1.5 s up, 0.4 s at the top, 2.0 s down",
        "norm": "Controlled, about 2 s down and 1-2 s up (clinical opinion)",
        "sources": []
      }
    ],
