    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Bring the dumbbells to the shoulders with a controlled curl or clean, and lower them the same way."
      ],
      "modify": [
        "Shoulder pain overhead: press with palms facing in and elbows further forward.",
        "Low-back discomfort: press seated with back support or half-kneeling."
      ],
      "regressions": [
        "Seated dumbbell shoulder press.",
        "Half-kneeling press.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Alternating or single-arm standing press.",
        "Dumbbell push press.",
        "Z press (no leg or back support)."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover. The shoulder press gave the highest anterior deltoid activity of four exercises (Campos 2020); standing and dumbbells gave more deltoid activity than seated and barbell (Saeterbakken 2013).",
      "ant_deltoid_l": "Main mover. The shoulder press gave the highest anterior deltoid activity of four exercises (Campos 2020); standing and dumbbells gave more deltoid activity than seated and barbell (Saeterbakken 2013).",
      "lat_deltoid_r": "Lifts the arms up and out; medial deltoid activity in the press was close to the lateral raise (Campos 2020) and higher standing than seated (Saeterbakken 2013).",
      "lat_deltoid_l": "Lifts the arms up and out; medial deltoid activity in the press was close to the lateral raise (Campos 2020) and higher standing than seated (Saeterbakken 2013).",
      "triceps_r": "Straightens the elbows in the top half.",
      "triceps_l": "Straightens the elbows in the top half.",
      "upper_traps_r": "Upward rotation and elevation of the shoulder blades overhead.",
      "upper_traps_l": "Upward rotation and elevation of the shoulder blades overhead.",
      "serratus_r": "Upward rotation of the shoulder blades so the arms reach fully overhead.",
      "serratus_l": "Upward rotation of the shoulder blades so the arms reach fully overhead.",
      "pec_r": "The clavicular head helps at the bottom, with the elbows forward.",
      "pec_l": "The clavicular head helps at the bottom, with the elbows forward.",
      "post_deltoid_r": "Steadies the shoulder; higher standing than seated (Saeterbakken 2013).",
      "post_deltoid_l": "Steadies the shoulder; higher standing than seated (Saeterbakken 2013).",
      "infraspinatus_r": "Rotator cuff: centres the ball of the shoulder.",
      "infraspinatus_l": "Rotator cuff: centres the ball of the shoulder.",
      "core": "Keeps the ribs down and the trunk stacked; rectus abdominis activity was about 81% lower seated than standing in the bilateral dumbbell press (Saeterbakken 2012).",
      "spinal_extensors_r": "Hold the spine tall under the load.",
      "spinal_extensors_l": "Hold the spine tall under the load.",
      "glute_max_r": "Squeezed to keep the pelvis level and stop the low back arching.",
      "glute_max_l": "Squeezed to keep the pelvis level and stop the low back arching."
    }
