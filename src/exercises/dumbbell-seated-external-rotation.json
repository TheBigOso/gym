        "url": "https://www.jospt.org/doi/10.2519/jospt.2004.34.7.385"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Rotator cuff work: use a light dumbbell and a slow, pain-free range."
      ],
      "modify": [
        "Shoulder discomfort: rest the elbow lower (less elevation) and shorten the range.",
        "Hip or knee discomfort with the foot up: rest the elbow on a padded box instead."
      ],
      "regressions": [
        "Side-lying external rotation.",
        "No dumbbell."
      ],
      "progressions": [
        "Slower lowering (3-4 s).",
        "Standing 90/90 external rotation."
      ]
    },
    "muscleNotes": {
      "infraspinatus_r": "Prime mover (with teres minor): turns the forearm up (external rotation).",
      "post_deltoid_r": "Assists external rotation with the arm forward and out.",
      "rhomboids_midtrap_r": "Keep the shoulder blade back.",
      "lat_deltoid_r": "Light: steadies the arm on the knee.",
      "forearm_flexors_r": "Hold the dumbbell.",
      "core": "Keeps the trunk upright."
    }
