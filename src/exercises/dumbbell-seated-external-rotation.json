    "id": "dumbbell-seated-external-rotation",
    "name": "Dumbbell Seated External Rotation",
    "aliases": [
      "Seated elbow-on-knee external rotation",
      "Seated dumbbell Cuban rotation (one arm)",
      "Seated 90/90 external rotation"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15725",
      "title": "Dumbbell Seated External Rotation (male)",
      "url": "https://gymvisual.com/videos/15725-dumbbell-seated-external-rotation-male.html",
      "listing": "Page not read (gymvisual.com is blocked by the proxy); movement taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (rotator cuff: infraspinatus, teres minor)",
    "secondaryBodyParts": [
      "Posterior deltoid"
    ],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder external rotation)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "infraspinatus_r"
      ],
      "synergist": [
        "post_deltoid_r"
      ],
      "stabilizer": [
        "rhomboids_midtrap_r",
        "lat_deltoid_r",
        "forearm_flexors_r",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the forearm rotates up, breathe in as it lowers.",
      "cadence": "About 2 s up, short pause, about 2.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "effort": "Stop 2-3 reps short of failure (RIR 2-3); no pain",
      "tempo": "2.5-0.5-2-0 (down-pause-up-bottom, seconds)",
      "rest": "45-60 s",
      "frequency": "2-3 times a week",
      "load": "Very light dumbbell (0.5-3 kg)",
      "progression": "Add reps, then a slightly heavier dumbbell"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on a bench with the right foot up on the bench, knee bent and raised. Rest the right elbow on the knee, upper arm out in front and a little to the side, elbow bent 90 degrees, forearm pointing forward and down, palm down."
      },
      {
        "id": "c2",
        "phase": "rotate",
        "text": "Breathe out and turn the forearm up about the elbow until it points up; the elbow stays on the knee."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Forearm vertical, palm forward; shoulder down and back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to the start."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause and repeat. Then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbow sliding off or lifting from the knee",
        "fix": "Keep the elbow resting on the knee as the pivot."
      },
      {
        "id": "m2",
        "mistake": "Leaning back to lift the weight",
        "fix": "Sit tall and still; only the forearm moves."
      },
      {
        "id": "m3",
        "mistake": "Shrugging",
        "fix": "Keep the shoulder down and away from the ear."
      },
      {
        "id": "m4",
        "mistake": "Too heavy a dumbbell",
        "fix": "Use a very light weight."
      }
    ],
    "kinematics": [
      {
        "measure": "External rotation",
        "setup": "Forearm ≈25° below horizontal, pointing forward",
        "peak": "Forearm ≈85° above horizontal (≈110° of rotation); elbow fixed on the knee",
        "norm": "From the forearm forward and below horizontal up to vertical (clinical opinion); external rotation with the arm abducted and supported loads the infraspinatus and teres minor (Reinold 2004)",
        "sources": [
          "reinold2004"
        ]
      },
      {
        "measure": "Shoulder position",
        "setup": "Upper arm ≈64° from the trunk, ≈58° in front of the frontal plane; elbow joint 4.3 cm above the thigh surface at the knee",
        "peak": "Unchanged",
        "norm": "Upper arm forward and out (scapular plane), elbow supported on the raised knee (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈91°",
        "peak": "≈91°",
        "norm": "Held at about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Leaning ≈1° forward; right foot on the bench, left foot on the floor",
        "peak": "Unchanged",
        "norm": "Upright, still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s",
        "peak": "2.0 s up, 0.5 s at the top, 2.5 s down",
        "norm": "Slow and controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15725, Dumbbell Seated External Rotation (male), video (movement reference only; page not read)",
