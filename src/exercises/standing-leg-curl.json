  "exercise": {
    "id": "standing-leg-curl",
    "name": "Standing Leg Curl",
    "aliases": [
      "Standing single leg curl",
      "Bodyweight standing hamstring curl",
      "Standing knee flexion"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "079512",
      "title": "Standing Single Leg Curl",
      "url": "https://gymvisual.com/videos/11404-standing-single-leg-curl.html",
      "listing": "Video; data sheet: body part Thighs, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (hamstrings)",
    "secondaryBodyParts": [
      "Calves"
    ],
    "equipment": [
      "Body weight",
      "Wall (light hand support)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (knee flexion)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "hamstrings_r"
      ],
      "synergist": [
        "calves_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "glute_max_r",
        "core",
        "calves_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the heel lifts, inhale as it lowers.",
      "cadence": "About 1.2 s up, 0.5 s hold, 1.7 s down"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "12-20",
      "tempo": "1-0.5-2-0",
      "frequency": "3-5 times a week (warm-up or rehab)",
      "progression": "Ankle weight, then a band or a lying dumbbell leg curl"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall facing a wall, hands resting on it, weight on the left leg."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and bend the right knee, bringing the heel up toward the buttock; thigh stays vertical."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the back of the thigh; knees side by side."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the foot slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Toes just touch down; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Thigh swinging forward",
        "fix": "Keep the knees side by side; only the lower leg moves."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back",
        "fix": "Stand tall, brace lightly, pelvis neutral."
      },
      {
        "id": "m3",
        "mistake": "Dropping the foot fast",
        "fix": "Lower in about 2 s."
      },
      {
        "id": "m4",
        "mistake": "Leaning on the wall",
        "fix": "Hands rest lightly for balance only."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈36° (toes just off the floor)",
        "peak": "≈115°",
        "norm": "Heel toward the buttock, about 100-120 degrees of knee flexion with the thigh vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip (thigh)",
        "setup": "Thigh ≈4° from vertical",
        "peak": "Thigh ≈1° from vertical (hip flexion 2°)",
        "norm": "Thigh stays vertical, hip near neutral (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Tall",
        "peak": "Tall (pelvis tips 1.5° forward)",
        "norm": "Tall, no lean or arch (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance knee",
        "setup": "≈4°",
        "peak": "≈4°",
        "norm": "Soft, not locked (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.2 s up, 0.5 s squeeze, 1.7 s down",
        "norm": "About 1 s up, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #079512, Standing Single Leg Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/11404-standing-single-leg-curl.html"
      },
      {
        "id": "bourne2017",
        "title": "Bourne, Williams, Opar, Al Najjar, Kerr & Shield 2017, impact of exercise selection on hamstring muscle activation (Br J Sports Med; PubMed 27467123)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/27467123/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Hamstring cramp: smaller range, rest between sets.",
        "Poor balance: hold the wall with both hands (as shown)."
      ],
      "regressions": [
        "Smaller range.",
        "Seated knee flexion against a band."
      ],
      "progressions": [
        "Ankle weight.",
        "Band around the ankle.",
        "Lying dumbbell leg curl."
      ]
    },
    "muscleNotes": {
      "hamstrings_r": "Knee flexors lifting the heel. Leg curls favour the medial hamstrings over the biceps femoris (one of the lowest BF/MH activation ratios; Bourne 2017). Bodyweight only, so the load is light: a warm-up or rehab exercise.",
      "calves_r": "The gastrocnemius crosses the knee and assists knee flexion (clinical opinion).",
      "glute_med_l": "Stance side: keeps the pelvis level on one leg (clinical opinion).",
      "glute_max_r": "Keeps the thigh vertical so the hip does not flex as the knee bends (clinical opinion).",
      "core": "Holds the trunk tall (clinical opinion).",
      "calves_l": "Balance on the stance foot (clinical opinion)."
    }
  },
