        "hamstrings_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl, breathe in as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.3 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 each side",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "tempo": "1.2-0.6-2.3-0.4 (lift-hold-lower-pause, seconds)",
      "load": "Plate load is user-chosen: curl without the hips twisting.",
      "progression": "Add reps, then load; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel with the left knee on the knee pad, forearms on the arm pads and the front of the right thigh against the thigh pad; right knee lined up with the lever axis, roller behind the lower calf."
      },
      {
        "id": "c2",
        "phase": "work",
        "text": "Breathe out and curl the right heel up toward the buttock."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the hamstrings with the knee well bent; keep the hips square."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and lower the roller under control until the leg is nearly straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause without letting the plates rest; switch legs after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips twisting open",
        "fix": "Keep the hips square and the thigh on its pad."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back",
        "fix": "Brace the trunk on the forearms."
      },
      {
        "id": "m3",
        "mistake": "Knee off the lever axis",
        "fix": "Line the knee joint up with the pivot."
      },
      {
        "id": "m4",
        "mistake": "Dropping the leg",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈35° with the leg extended",
        "peak": "≈125° at the top of the curl",
        "norm": "From nearly straight to well bent (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee axis",
        "setup": "Lever pivot on the right knee (15.2, 66.5 cm)",
        "peak": "Roller within 0.03 cm of its arc",
        "norm": "Lever pivot on the knee joint so the roller stays on the calf (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Roller",
        "setup": "Behind the right calf, 84% of the way from knee to ankle",
        "peak": "Lever 90° up",
        "norm": "Behind the lower calf above the heel (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip",
        "setup": "Right hip ≈74° (relative to the trunk), thigh on its pad; trunk 52° forward on the forearms",
        "peak": "Unchanged",
        "norm": "Working hip flexed, thigh on the pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hamstring EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Leg curls load the hamstrings well (McAllister 2014)",
