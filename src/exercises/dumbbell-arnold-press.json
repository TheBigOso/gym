        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe in at the start and brace, breathe out as you rotate and press; breathe in on the way down.",
      "cadence": "About 1.8 s up with the turn, short pause, about 2.5 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "Controlled, about 2-3 s down and 2 s up",
      "rest": "90 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; usually lighter than for the plain shoulder press (clinical opinion)",
      "progression": "Add reps, then weight; standing Arnold press"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall with the back on the pad. Dumbbells in front of the shoulders at chin height, palms facing you, elbows in front and close together."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out, open the elbows out to the sides and turn the palms forward as you press up."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Finish with arms nearly straight overhead, palms forward."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Reverse it: lower and bring the elbows back in front, turning the palms toward you."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause at chin height, palms facing you, and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rotating first, then pressing (two separate moves)",
        "fix": "Blend the turn and the press into one smooth arc."
      },
      {
        "id": "m2",
        "mistake": "Arching the low back to finish",
        "fix": "Keep the back on the pad, ribs down; lighten the load."
      },
      {
        "id": "m3",
        "mistake": "Dumbbells hitting the face or each other at the start",
        "fix": "Keep the forearms vertical and the dumbbells a hand width apart in front of the chin."
      }
    ],
    "kinematics": [
      {
        "measure": "Forearm rotation",
        "setup": "palms toward the face (wrist pron -4.8°, shoulder axial -90.2°)",
        "peak": "palms forward (pron 113.8°, axial -102.1°)",
        "norm": "Palms toward the face at the start, palms forward at the top: about a quarter turn of the hands (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation (humerus)",
        "setup": "≈51° (upper arm vs trunk)",
        "peak": "≈167°",
        "norm": "Upper arm in front at about chest height to about 160-170 degrees overhead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Plane of elevation",
        "setup": "elbows ≈85° in front of the frontal plane",
        "peak": "≈37°",
        "norm": "Elbows travel from in front (flexion plane) out toward the scapular plane as they rise (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈125°",
        "peak": "≈12°",
        "norm": "Deeply bent at the start to nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.8 s at the chin, 1.0 s at the bottom of each rep",
        "peak": "1.8 s up with the turn, 0.4 s at the top, 2.5 s down",
        "norm": "Slow and continuous (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #213712, Dumbbell Arnold Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/5213-dumbbell-arnold-press.html"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7706677/"
      },
      {
        "id": "saeterbakken2013",
        "title": "Saeterbakken & Fimland 2013, effects of body position and loading modality on muscle activity and strength in shoulder presses (J Strength Cond Res 27(7):1824-1831)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23096062/"
      },
      {
        "id": "saeterbakken2012",
        "title": "Saeterbakken & Fimland 2012, muscle activity of the core during bilateral, unilateral, seated and standing resistance exercise (Eur J Appl Physiol 112:1671-1678)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21877146/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "No study measured the Arnold press directly; the muscle roles are inferred from shoulder press EMG and anatomy."
      ],
      "modify": [
        "Shoulder pain in the opening turn: do the plain seated dumbbell press with palms facing each other.",
        "Stiff shoulders: stop the press short of full overhead."
      ],
      "regressions": [
        "Seated dumbbell shoulder press.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Standing Arnold press.",
        "Slower lowering (3-4 s)."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Works through the whole rep and most at the start, when the elbows are in front (shoulder flexion). Pressing gave the highest anterior deltoid activity among tested exercises (Campos 2020); no EMG study of the Arnold press itself was found.",
      "ant_deltoid_l": "Works through the whole rep and most at the start, when the elbows are in front (shoulder flexion). Pressing gave the highest anterior deltoid activity among tested exercises (Campos 2020); no EMG study of the Arnold press itself was found.",
      "lat_deltoid_r": "Takes over as the elbows open out to the sides during the rotation and press (clinical opinion; medial deltoid is high in pressing, Campos 2020).",
      "lat_deltoid_l": "Takes over as the elbows open out to the sides during the rotation and press (clinical opinion; medial deltoid is high in pressing, Campos 2020).",
      "triceps_r": "Straightens the elbow from the deeply bent start to the top.",
      "triceps_l": "Straightens the elbow from the deeply bent start to the top.",
      "pec_r": "The clavicular head helps at the start, with the elbows together in front of the chest.",
      "pec_l": "The clavicular head helps at the start, with the elbows together in front of the chest.",
      "upper_traps_r": "Upward rotation and elevation of the shoulder blade overhead.",
      "upper_traps_l": "Upward rotation and elevation of the shoulder blade overhead.",
      "serratus_r": "Upward rotation of the shoulder blade so the arms can finish overhead.",
      "serratus_l": "Upward rotation of the shoulder blade so the arms can finish overhead.",
      "infraspinatus_r": "Rotator cuff: controls the turn of the upper arm as the elbows open.",
      "infraspinatus_l": "Rotator cuff: controls the turn of the upper arm as the elbows open.",
      "post_deltoid_r": "Steadies the shoulder as the arms rotate out.",
      "post_deltoid_l": "Steadies the shoulder as the arms rotate out.",
      "core": "Holds the trunk against the pad. Core activity is lower seated than standing (Saeterbakken 2012)."
    }
  },
