    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "core"
      ],
      "lengthened": [
        "biceps_r",
        "biceps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "load": "Load is user-chosen: the pad removes body swing and the bottom is hardest, so expect less than for a standing barbell curl; pick a bar you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion).",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Add reps, then weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the seat so the armpits rest on the top of the pad; sit tall, chest against the pad, feet flat. Underhand grip about shoulder width, the backs of the upper arms flat on the pad, arms nearly straight."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the bar up; the elbows and upper arms stay on the pad."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze with the forearms about vertical; do not let the shoulders roll forward or lift off the pad."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, 2-3 s, until the arms are nearly straight; keep control at the bottom."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms nearly straight, not locked or hanging off the pad; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping into the bottom and bouncing out of it",
        "fix": "Lower slowly and stop just short of locking the elbows; the stretched bottom is where the elbow is most exposed."
      },
      {
        "id": "m2",
        "mistake": "Lifting the elbows or the chest off the pad to finish the rep",
        "fix": "Lighten the bar; the upper arms stay on the pad the whole time."
      },
      {
        "id": "m3",
        "mistake": "Seat too low or too high (armpits not on the top of the pad)",
        "fix": "Adjust the seat so the pad sits in the armpits and the upper arms lie flat on it."
      },
      {
        "id": "m4",
        "mistake": "Wrists curling back under the load",
        "fix": "Keep the wrists straight and grip the bar firmly."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈17° (arm straight)",
        "peak": "≈125° at the top (range ≈109°)",
        "norm": "Full range from nearly straight arms to about 120-130 degrees; mean elbow range was about 117-123 degrees across standing barbell, EZ-bar and dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "76.5° (neutral, thumb up)",
        "peak": "-0.5° (palm forward/up)",
        "norm": "Supinated grip: the highest biceps activity in the lifting phase (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈64°",
        "peak": "≈64° (elbow forward)",
        "norm": "Shoulder flexed with the upper arm on the pad: preacher curls load the elbow flexors at short muscle lengths compared with shoulder-extended curls (Attarieh 2025)",
        "sources": [
          "attarieh2025"
        ]
      },
      {
        "measure": "Upper arm on the pad (rig shapes)",
        "setup": "Pad 45° (top edge 78.3 cm high, 28.3 cm ahead of the seat centre); elbow 4.8 cm off the pad surface (upper-arm radius)",
        "peak": "Elbows stay on the pad (drift ≤0 cm); arms vs pad -0.2 cm at the closest",
        "norm": "Upper arms and elbows stay on the pad throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms nearly straight on the pad 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #007013, Barbell Preacher Curl, animated GIF (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/1564-barbell-preacher-curl.html"
      },
      {
        "id": "attarieh2025",
        "title": "Attarieh, Nunes, Khani, Negahdar, Goli, Nazarirad, Nazarirad, Mojtahedi, Nosaka and Soori 2025, shoulder flexed versus extended elbow-flexion training: preacher versus Bayesian cable curls, regional hypertrophy and strength (Eur J Sport Sci 25(4):e12279; PMC11906226)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11906226/"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow: the bottom of a preacher curl stretches the biceps and the front of the elbow under load; lower slowly and stop short of locking out (clinical opinion).",
        "A straight bar turns the forearms fully up; if the wrists or elbows complain, use an EZ bar (clinical opinion).",
        "Take the bar from the bench hooks or a partner and put it back the same way; do not let it roll off the pad.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "EZ bar.",
        "One dumbbell at a time (dumbbell preacher curl)."
      ],
      "regressions": [
        "Empty bar or a light fixed barbell.",
        "Shorter range: stop the lowering at about 30 degrees of elbow bend."
      ],
      "progressions": [
        "Slower lowering (3-4 s).",
        "Pause just above the bottom.",
        "Heavier bar for fewer reps."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor and forearm supinator; a supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023). The pad fixes the upper arm in front of the body, so the shoulder cannot swing the bar.",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) helps flex the elbow (Coratella 2023).",
      "forearm_flexors_r": "Wrist and finger flexors hold the bar and keep the wrist straight.",
      "ant_deltoid_r": "Keeps the upper arm pressed on the pad (clinical opinion).",
      "biceps_l": "Main elbow flexor and forearm supinator; a supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023). The pad fixes the upper arm in front of the body, so the shoulder cannot swing the bar.",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) helps flex the elbow (Coratella 2023).",
      "forearm_flexors_l": "Wrist and finger flexors hold the bar and keep the wrist straight.",
      "ant_deltoid_l": "Keeps the upper arm pressed on the pad (clinical opinion).",
      "core": "Keeps the chest steady against the pad."
    }
  },
