  "exercise": {
    "id": "cable-high-row",
    "name": "Cable High Row",
    "aliases": [
      "Seated cable high row",
      "High cable row to the chest",
      "Wide-grip high row",
      "Cable rear delt high row"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "16301",
      "title": "Cable High Row",
      "url": "https://gymvisual.com/videos/16301-cable-high-row.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment, so the movement was taken from the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (upper back and rear deltoid)",
    "secondaryBodyParts": [
      "Shoulders (rear deltoid)",
      "Upper arms (biceps)"
    ],
    "equipment": [
      "Cable machine (high pulley)",
      "Straight bar attachment",
      "Box or bench seat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder horizontal abduction and extension, scapular retraction, elbow flexion)",
    "plane": "Multiplanar",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "synergist": [
        "lats_r",
        "lats_l",
        "biceps_r",
        "biceps_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "upper_traps_r",
        "upper_traps_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core"
      ],
      "lengthened": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row the bar to the upper chest, breathe in as the arms reach back toward the pulley.",
      "cadence": "About 1.2 s pull, short squeeze, about 2 s return"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can row to the upper chest with the elbows high and no shrug.",
      "progression": "Add reps, then one plate on the stack; add a 1 s squeeze"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the seat facing a pulley set above head height, feet flat; hold the bar overhand, wider than the shoulders, arms long and reaching up toward the pulley."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out; draw the shoulder blades together and row the bar to the upper chest, elbows high and out to the sides."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Bar just below the collarbones, elbows about shoulder height and slightly behind the trunk, shoulders down."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the arms reach back up toward the pulley under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief stretch with the arms long, then row again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping the elbows into a low row",
        "fix": "Keep the elbows about shoulder height and the bar at the upper chest."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders up",
        "fix": "Pull the shoulder blades back and down; lighten the stack."
      },
      {
        "id": "m3",
        "mistake": "Leaning back to move the weight",
        "fix": "Sit tall and keep the trunk still."
      },
      {
        "id": "m4",
        "mistake": "Bending the wrists",
        "fix": "Keep the wrists straight in line with the forearms."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "Upper arm ≈123° from the trunk, reaching up toward the pulley",
        "peak": "≈87° from the trunk (elbow -2 cm from shoulder height, 9 cm behind)",
        "norm": "Elbows about shoulder height at the finish (clinical opinion); horizontal abduction with the arm raised works the posterior deltoid (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12° (arms long)",
        "peak": "≈135°",
        "norm": "From nearly straight to about 90-120 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blades",
        "setup": "Protracted, slightly raised (reaching)",
        "peak": "Retracted, shoulders down",
        "norm": "Protracted with the arms long, retracted at the finish; retraction drives the middle trapezius and rhomboids (Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Overhand, 62 cm between the hands on a 100 cm bar",
        "peak": "Unchanged (61.76-62.16 cm)",
        "norm": "Overhand, wider than the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈3° from upright, seated tall",
        "peak": "Unchanged",
        "norm": "Upright and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stretch 0.5 s with the arms long",
        "peak": "1.2 s pull, 0.4 s squeeze, 2 s return",
        "norm": "Controlled, about 1 s pull and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable High Row, video (movement reference)",
        "url": "https://gymvisual.com/videos/16301-cable-high-row.html"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "oyama2010",
        "title": "Oyama, Myers, Wassinger and Lephart 2010, three-dimensional scapular and clavicular kinematics and scapular muscle activity during retraction exercises (J Orthop Sports Phys Ther 40(3):169-179)",
        "url": "https://chs.uky.edu/sites/default/files/2023-12/Oyama_2010_Three-Dimensional%20Scapular%20and%20Clavicular%20Kinematics.pdf"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain at the front or top of the shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can row with the shoulders down and the trunk still.",
        "Keep the cable in front of the face: sit far enough back that the bar does not pass close to the head.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort with high elbows: lower the elbows a little toward a mid-height row (clinical opinion).",
        "Wrist discomfort with the straight bar: use a rope with a neutral grip."
      ],
      "regressions": [
        "Lighter load.",
        "Band high row anchored overhead.",
        "Seated cable row."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Pause 1 s at the chest.",
        "Rope face pull."
      ]
    },
    "muscleNotes": {
      "rhomboids_midtrap_r": "Prime mover: draws the shoulder blade back toward the spine.",
      "rhomboids_midtrap_l": "Prime mover: draws the shoulder blade back toward the spine.",
      "post_deltoid_r": "Prime mover: pulls the raised arm back (horizontal abduction).",
      "post_deltoid_l": "Prime mover: pulls the raised arm back (horizontal abduction).",
      "lats_r": "Helps pull the arm down and back from the reach.",
      "lats_l": "Helps pull the arm down and back from the reach.",
      "biceps_r": "Bends the elbow as the bar comes in.",
      "biceps_l": "Bends the elbow as the bar comes in.",
      "infraspinatus_r": "Steadies the shoulder and helps pull the arm back.",
      "infraspinatus_l": "Steadies the shoulder and helps pull the arm back.",
      "forearm_flexors_r": "Grip the bar.",
      "forearm_flexors_l": "Grip the bar.",
      "upper_traps_r": "Steadies the shoulder girdle with the arms raised; should not shrug.",
      "upper_traps_l": "Steadies the shoulder girdle with the arms raised; should not shrug.",
      "spinal_extensors_r": "Keep the trunk tall.",
      "spinal_extensors_l": "Keep the trunk tall.",
      "core": "Keeps the trunk still on the seat."
    }
