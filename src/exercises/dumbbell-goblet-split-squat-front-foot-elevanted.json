    "breathing": {
      "pattern": "Inhale on the way down, exhale on the way up.",
      "cadence": "About 1.9 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "3 per leg",
      "reps": "6-12",
      "tempo": "2-1-1-0",
      "frequency": "1-3 times a week",
      "progression": "Heavier dumbbell, a higher step, then a rear-foot-elevated split squat. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Whole front foot on a low step, back foot on its ball on the floor. Hold one dumbbell upright against the chest, hands cupping the top plate, elbows down."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and drop the back knee toward the floor, below the level of the front foot; chest tall."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Back knee just above the floor, front knee well bent and over the foot, front heel down."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive through the front foot to stand up."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the split stance, reset, repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dumbbell drifting off the chest",
        "fix": "Keep it touching the sternum, elbows under it."
      },
      {
        "id": "m2",
        "mistake": "Front heel lifting off the step",
        "fix": "Push through the whole front foot; shorten the depth if needed."
      },
      {
        "id": "m3",
        "mistake": "Front knee caving inward",
        "fix": "Keep the front knee over the second toe."
      },
      {
        "id": "m4",
        "mistake": "Bouncing out of the bottom",
        "fix": "Control the descent into the extra range and pause briefly."
      }
    ],
    "kinematics": [
      {
        "measure": "Step height",
        "setup": "15 cm step under the whole right foot",
        "peak": "Front foot stays flat on the step",
        "norm": "A low step or plate, about 5-15 cm (common coaching; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance length (ankle centres)",
        "setup": "85 cm between ankle centres, feet 18 cm apart sideways",
        "peak": "Unchanged",
        "norm": "About one leg length was suggested as optimal in the split squat (Song 2023)",
        "sources": [
          "song2023"
        ]
      },
      {
        "measure": "Front knee flexion",
        "setup": "≈28°",
        "peak": "≈104°, shin ≈-3° forward of vertical",
        "norm": "More than in a flat split squat; about 100-110 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Back knee",
        "setup": "≈18°",
        "peak": "≈95°, joint centre 13 cm above the floor (the front ankle is 21.8 cm up)",
        "norm": "Drops toward the floor, below the front foot (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈1°",
        "peak": "≈3°",
        "norm": "Upright to slightly forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell",
        "setup": "Upright at the sternum, hands cupping the top plate",
        "peak": "Stays at the chest, clear of the front thigh (≥2.83 cm on the rig shapes)",
        "norm": "Held upright at the sternum, elbows down (common coaching)",
        "sources": []
      },
      {
