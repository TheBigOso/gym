    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a stable step that cannot slide."
      ],
      "modify": [
        "Knee pain: use a lower step or shorten the range.",
        "Balance concerns: widen the stance sideways a little, or practise with bodyweight holding a support first."
      ],
      "regressions": [
        "Goblet split squat on the floor.",
        "Front-foot-elevated split squat with bodyweight."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Higher step.",
        "Bulgarian split squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Front-leg knee extensors; raising the front foot lets the front knee and hip bend further than in a flat split squat (clinical opinion). Split squat vastus lateralis activity was similar to the Bulgarian split squat (Mausehund 2019).",
      "quads_l": "Front-leg knee extensors; raising the front foot lets the front knee and hip bend further than in a flat split squat (clinical opinion). Split squat vastus lateralis activity was similar to the Bulgarian split squat (Mausehund 2019).",
      "glute_max_r": "Front-leg hip extensor, stretched further at the bottom of the deeper range (clinical opinion).",
      "glute_max_l": "Front-leg hip extensor, stretched further at the bottom of the deeper range (clinical opinion).",
      "adductors_r": "Adductor magnus assists hip extension in the deep front-hip position (clinical opinion).",
      "adductors_l": "Adductor magnus assists hip extension in the deep front-hip position (clinical opinion).",
      "hamstrings_r": "Assist hip extension on the front leg (Mausehund 2019 measured biceps femoris in the split squat).",
      "hamstrings_l": "Assist hip extension on the front leg (Mausehund 2019 measured biceps femoris in the split squat).",
      "calves_r": "Steady the front shin on the step; the back calf holds the heel up.",
      "calves_l": "Steady the front shin on the step; the back calf holds the heel up.",
      "glute_med_r": "Holds the pelvis level on the narrow base (clinical opinion).",
      "glute_med_l": "Holds the pelvis level on the narrow base (clinical opinion).",
      "core": "Braces against the load held in front of the chest and keeps the pelvis level in the split stance (clinical opinion).",
      "spinal_extensors_r": "Hold the trunk upright as it tips slightly forward.",
      "spinal_extensors_l": "Hold the trunk upright as it tips slightly forward.",
      "hip_flexors_r": "The back-leg hip flexors lengthen as the back knee drops below the front foot (clinical opinion).",
      "hip_flexors_l": "The back-leg hip flexors lengthen as the back knee drops below the front foot (clinical opinion).",
      "forearm_flexors_r": "Cup the top plate and keep the dumbbell from slipping (clinical opinion).",
      "forearm_flexors_l": "Cup the top plate and keep the dumbbell from slipping (clinical opinion).",
      "biceps_r": "Hold the elbows bent and the dumbbell against the chest (clinical opinion).",
      "biceps_l": "Hold the elbows bent and the dumbbell against the chest (clinical opinion)."
    }
