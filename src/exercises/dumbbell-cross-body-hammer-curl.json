      "listing": "Video; data sheet: body part Upper Arms, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "equipment": [
      "Dumbbell"
    ],
    "laterality": "Unilateral, alternating (right then left in one loop)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l",
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "synergist": [
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "pec_r",
        "pec_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale on each curl, inhale as each dumbbell lowers.",
      "cadence": "Per arm: about 1.1 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12 per arm",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, dumbbells at your sides, palms facing in, thumbs forward."
      },
      {
        "id": "c2",
        "phase": "rightUp",
        "text": "Breathe out and curl the right dumbbell up and across toward the left chest, thumb up the whole way."
      },
      {
        "id": "c3",
        "phase": "rightTop",
        "text": "Squeeze with the dumbbell in front of the opposite chest; elbow stays low."
      },
      {
        "id": "c4",
        "phase": "rightDown",
        "text": "Lower it back down the same path to your right side."
      },
      {
        "id": "c5",
        "phase": "leftUp",
        "text": "Now the left: curl it across toward the right chest, thumb up."
      },
      {
        "id": "c6",
        "phase": "leftTop",
        "text": "Squeeze at the top."
      },
      {
        "id": "c7",
        "phase": "leftDown",
        "text": "Lower slowly to a straight arm."
      },
      {
        "id": "c8",
        "phase": "reset",
        "text": "Both arms straight; repeat, alternating sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting the trunk toward the dumbbell",
        "fix": "Keep the shoulders and hips square to the front."
      },
      {
        "id": "m2",
        "mistake": "Lifting the elbow up and out",
        "fix": "The elbow stays low and close; the forearm swings across."
      },
      {
        "id": "m3",
        "mistake": "Turning the palm up",
        "fix": "Keep the thumb pointing up for the whole rep."
      },
      {
        "id": "m4",
        "mistake": "Dropping the dumbbell back down",
        "fix": "Take 2 s to lower each rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈16° (arm straight)",
        "peak": "≈123° at the top (range ≈107°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "76.6° (neutral, thumb up)",
        "peak": "65.3° channel; handle centre ends -0.6 cm left of the midline, 129.7 cm high (in front of the left chest)",
        "norm": "Neutral (thumb up) the whole rep; the neutral grip shares the work with the brachioradialis (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-11°",
        "peak": "≈4° (elbow forward)",
        "norm": "Upper arm stays close to the side and turns slightly inward as the forearm crosses the body (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms straight 0.5 s",
        "peak": "Per arm: 1.1 s up, 0.2 s squeeze, 2.0 s down; right rep then left rep",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #029812, Dumbbell Cross Body Hammer Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/1358-dumbbell-cross-body-hammer-curl.html"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "parpa2025",
        "title": "Parpa, Vasiliou, Michaelides, Govindasamy, Chernov and Intziegianni 2025, biceps brachii EMG during traditional dumbbell versus Bayesian cable curls, with a review of curl EMG studies (Muscles 4:45)",
        "url": "https://knowledge.lancashire.ac.uk/id/eprint/57119/1/57119%20Parpa%20et%20al.%20VOR.pdf"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the dumbbell and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Pick the dumbbells up and set them down with a straight back and bent knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort crossing the body: curl straight up (hammer curl).",
        "Back strain: do it seated."
      ],
      "regressions": [
        "Dumbbell hammer curl.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Slower lowering.",
        "Both arms alternating without a pause."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Still a prime elbow flexor with the thumb up, though its activity was about 12% lower with a neutral grip than with a supinated grip (Coratella 2023).",
      "biceps_l": "Still a prime elbow flexor with the thumb up, though its activity was about 12% lower with a neutral grip than with a supinated grip (Coratella 2023).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) is best placed to flex the elbow with the thumb up; a review reported the hammer curl gave the highest brachioradialis activity among curls (Bagchi and Raizada 2019, as reviewed by Parpa 2025).",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) is best placed to flex the elbow with the thumb up; a review reported the hammer curl gave the highest brachioradialis activity among curls (Bagchi and Raizada 2019, as reviewed by Parpa 2025).",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder as the forearm swings across the body; neutral grips raised its activity versus supinated (Coratella 2023).",
      "ant_deltoid_l": "Steadies the shoulder as the forearm swings across the body; neutral grips raised its activity versus supinated (Coratella 2023).",
      "core": "Resists the twist of one working arm; keep the trunk square.",
      "pec_r": "Draws the upper arm slightly toward the midline as the dumbbell crosses the chest.",
      "pec_l": "Draws the upper arm slightly toward the midline as the dumbbell crosses the chest."
    }
