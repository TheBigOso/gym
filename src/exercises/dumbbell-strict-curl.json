      },
      {
        "id": "augustin2025",
        "title": "Augustin, Pinero, Enes, Mohan, Sapuppo, Coleman, Wolf, Korakakis, Swinton, Nippard and Schoenfeld 2025, do cheaters prosper? Externally supplied momentum in curls and pushdowns and upper-arm hypertrophy (Int J Exerc Sci 18(3):329-342)",
        "url": "https://digitalcommons.wku.edu/ijes/vol18/iss3/5"
      },
      {
        "id": "oliveira2009",
