      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight. The strict form needs a lighter dumbbell than a free-standing curl; cheat and strict curls built similar muscle in a 2025 trial, so strict form is about control rather than growth (Augustin 2025)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand with the head, upper back and glutes against a wall, heels a few centimetres forward. Dumbbells at your sides, palms forward, backs of the arms on the wall."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl both dumbbells; the elbows stay touching the wall."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze at the top without letting the elbows leave the wall."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight, back flat on the wall, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows coming off the wall at the top",
        "fix": "Stop the curl where the elbows would have to move."
      },
      {
        "id": "m2",
        "mistake": "Arching the lower back off the wall",
        "fix": "Brace the abs and keep the glutes on the wall."
      },
      {
        "id": "m3",
        "mistake": "Head pushing forward",
        "fix": "Keep the back of the head on the wall."
      },
      {
        "id": "m4",
        "mistake": "Rushing the lowering",
        "fix": "Take 2-3 s down."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈18° (arm straight)",
        "peak": "≈136° at the top (range ≈118°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "-1.3° (palm forward/up)",
        "peak": "-23.5° (palm forward/up)",
        "norm": "The supinated grip gave the highest biceps activity in the lifting phase; neutral grips shift work toward the brachioradialis (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-20°",
        "peak": "≈-20° (elbow behind the trunk line)",
        "norm": "Upper arms stay vertical on the wall (no forward drift); flexing the arms forward changes the muscles used (JFMK 2023)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms straight 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Back on the wall (skinned mesh gap)",
        "setup": "Wall face 8.5 cm behind the pelvis centre; heels ≈2.5 cm from the wall",
        "peak": "Unchanged: trunk and elbows stay on the wall (mesh gaps in the report)",
        "norm": "Head, upper back, glutes and elbows touching the wall the whole set (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #1199712, Dumbbell Alternate Hammer Strict Curl (female), video (movement reference)",
