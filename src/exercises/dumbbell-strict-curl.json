      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the dumbbell and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Pick the dumbbells up and set them down with a straight back and bent knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Elbow pain: hammer grip against the wall.",
        "Too hard at the top: shorten the range slightly."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Seated dumbbell curl."
      ],
      "progressions": [
        "Slower lowering (3-4 s).",
        "Pause 1 s at the top."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor; with the back and elbows on the wall the trunk and upper arms cannot move, so the biceps cannot borrow momentum. Curling the arms forward (shoulder flexion) at the top raised biceps and front-deltoid excitation in a barbell study, which the wall prevents (JFMK 2023).",
      "biceps_l": "Main elbow flexor; with the back and elbows on the wall the trunk and upper arms cannot move, so the biceps cannot borrow momentum. Curling the arms forward (shoulder flexion) at the top raised biceps and front-deltoid excitation in a barbell study, which the wall prevents (JFMK 2023).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder so the upper arm stays put; it rises if the elbow drifts forward.",
      "ant_deltoid_l": "Steadies the shoulder so the upper arm stays put; it rises if the elbow drifts forward.",
      "core": "Keeps the lower back from arching off the wall.",
      "post_deltoid_r": "Keeps the backs of the upper arms against the wall.",
      "post_deltoid_l": "Keeps the backs of the upper arms against the wall."
    }
  },
