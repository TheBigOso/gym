    "breathing": {
      "pattern": "Breathe in and brace at the top, lower; breathe out as you pass the hardest part of the rise.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-10",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbells, a 2 s pause at the bottom, then a barbell front squat. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Heels on a low board, balls of the feet on the floor, feet a little narrower than shoulder width. A dumbbell on each shoulder, palms in, elbows forward."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, brace and sit straight down; the knees travel forward over the toes, elbows stay up."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs below parallel, trunk upright, heels pressed into the board."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive up through the whole foot, elbows high; breathe out near the top."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, reset the brace, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows dropping",
        "fix": "Keep the elbows forward so the dumbbells stay on the shoulders."
      },
      {
        "id": "m2",
        "mistake": "Knees caving inward",
        "fix": "Keep the knees tracking over the second toe as they travel forward."
      },
      {
        "id": "m3",
        "mistake": "Heels sliding off the board",
        "fix": "Board under the heels only; the balls of the feet stay on the floor."
      },
      {
        "id": "m4",
        "mistake": "Rounding the upper back",
        "fix": "Chest tall and the dumbbells resting on the shoulders the whole way down."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "34 cm between ankle centres (≈0.8x the rig's 40 cm shoulder width), toes out 12°",
        "peak": "Unchanged",
        "norm": "About hip to shoulder width, toes slightly out (common coaching)",
        "sources": []
      },
      {
        "measure": "Heel elevation",
        "setup": "Heels on a 3.3 cm board, feet pitched 12° heel-up, balls of the feet on the floor",
        "peak": "Unchanged (heels stay on the board)",
        "norm": "About 2-5 cm under the heels (a plate or slant board; common coaching). Raising the heels lets the knees travel further forward for the same ankle range, so the trunk stays more upright and the knee bends deeper (common coaching; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈127°",
        "norm": "About 120-135 degrees in a deep heel-raised squat (clinical opinion); depth is driven mostly by knee range (Zawadka 2020)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈3°",
        "peak": "≈112° (joint channel, as in the HUD)",
        "norm": "Not specified by the sources for this depth",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈13° forward",
        "norm": "Front-loaded squats stay more upright than back squats (front vs back squat, 2009); more lean moves demand from knee to hip (Straub 2024)",
        "sources": [
          "frontsquat2009",
          "straub2024"
        ]
      },
      {
        "measure": "Dumbbells",
        "setup": "Racked on the front of the shoulders, palms in, elbows forward",
        "peak": "Stay on the shoulders (clearance to the body ≥8.08 cm on the rig shapes)",
        "norm": "Racked on the front of the shoulders, elbows forward (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "About 2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
