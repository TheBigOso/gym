        "url": "https://pubmed.ncbi.nlm.nih.gov/16649890/"
      }
    ],
    "safety": {
      "cautions": [
        "Set the cradles at mid-shin height and check the anchor before each set.",
        "Wrist pain: use push-up handles or fists (clinical opinion).",
        "Low-back pain: start with ring knee tucks.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Sliders on a smooth floor work similarly."
      ],
      "regressions": [
        "Ring knee tuck.",
        "Pike on a stability ball."
      ],
      "progressions": [
        "Pike to push-up.",
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "core": "Braces the trunk so the body stays in one line.",
      "hip_flexors_r": "Bend the hips.",
      "hip_flexors_l": "Bend the hips.",
      "obliques_r": "Turn and brace the trunk.",
      "obliques_l": "Turn and brace the trunk.",
      "ant_deltoid_r": "Raises the upper arm forward.",
      "ant_deltoid_l": "Raises the upper arm forward.",
      "serratus_r": "Moves the shoulder blade forward around the ribs and holds it to the chest wall.",
      "serratus_l": "Moves the shoulder blade forward around the ribs and holds it to the chest wall.",
      "triceps_r": "Straightens the elbow.",
      "triceps_l": "Straightens the elbow.",
      "pec_r": "Brings the upper arm across and forward (pressing).",
      "pec_l": "Brings the upper arm across and forward (pressing).",
      "quads_r": "Keep the knees straight.",
      "quads_l": "Keep the knees straight.",
      "lats_r": "Pulls the upper arm down and back toward the trunk.",
      "lats_l": "Pulls the upper arm down and back toward the trunk.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
      "upper_traps_l": "Steadies the shoulder girdle; should not shrug."
