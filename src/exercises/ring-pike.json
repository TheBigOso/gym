  "exercise": {
    "id": "ring-pike",
    "name": "Ring Pike",
    "aliases": [
      "Suspended pike",
      "Feet-in-rings pike",
      "Suspension trainer pike"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15624",
      "title": "Ring Pike",
      "url": "https://gymvisual.com/videos/15624-ring-pike-male.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Core (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Shoulders",
      "Triceps",
      "Serratus"
    ],
    "equipment": [
      "Gymnastic rings or suspension straps (foot cradles)",
      "Pull-up bar (anchor)"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (hip and trunk; shoulders braced)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "triceps_r",
        "triceps_l",
        "pec_r",
        "pec_l",
        "quads_r",
        "quads_l",
        "lats_r",
        "lats_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the hips lift into the pike, breathe in as you return to the plank.",
      "cadence": "About 1.4 s up, short pause, about 1.6 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-12",
      "tempo": "1-1-2-0",
      "load": "Bodyweight (RIR 1-3, clinical opinion)",
      "frequency": "2 times a week",
      "progression": "Slower lowering, then a pause at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet in the cradles under the anchor, hands under the shoulders: high plank, body straight, shoulders pushed away from the floor."
      },
      {
        "id": "c2",
        "phase": "pike",
        "text": "Breathe out and lift the hips high, legs straight; the feet swing forward in the straps toward the hands."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Hips over the shoulders, head between the arms; hold briefly."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the hips back to a straight plank under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brace; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging in the plank",
        "fix": "Brace the abs and squeeze the glutes before each rep."
      },
      {
        "id": "m2",
        "mistake": "Bending the knees",
        "fix": "Keep the legs straight; this is a pike, not a tuck."
      },
      {
        "id": "m3",
        "mistake": "Shoulders sinking",
        "fix": "Push the floor away the whole time."
      },
      {
        "id": "m4",
        "mistake": "Swinging the straps",
        "fix": "Move slowly so the feet stay quiet in the cradles."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "Straight plank (trunk-to-leg ≈175°), feet 50 cm off the floor",
        "peak": "Trunk-to-leg ≈80° in the pike, hips 97 cm high",
        "norm": "From straight in the plank to about 90-110 degrees in the pike (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder position",
        "setup": "Shoulders over the wrists, arms straight",
        "peak": "Shoulders 4 cm ahead of the wrists, head between the arms",
        "norm": "Shoulders stay over or a little behind the hands; the serratus holds the shoulder blades to the ribs (Ludewig 2004)",
        "sources": [
          "ludewig2004"
        ]
      },
      {
        "measure": "Straps",
        "setup": "One strap per foot, 167.7 cm from anchors 215 cm up",
        "peak": "Feet swing 55.2 cm toward the hands on the strap arcs; straps at least 19.7 cm off the body",
        "norm": "The foot straps stay taut; the feet swing on their strap arcs about the anchor (geometry)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Plank 0.6 s",
        "peak": "1.4 s up, 0.5 s hold, 1.6 s down",
        "norm": "Controlled, about 1.5 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15624, Ring Pike, video (movement reference)",
