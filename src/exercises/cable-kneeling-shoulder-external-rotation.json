  "exercise": {
    "id": "cable-kneeling-shoulder-external-rotation",
    "name": "Cable Kneeling Shoulder External Rotation",
    "aliases": [
      "Kneeling cable external rotation",
      "Tall-kneeling cable external rotation",
      "Cable rotator cuff external rotation"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "16811",
      "title": "Cable Kneeling Shoulder External Rotation",
      "url": "https://gymvisual.com/videos/16811-cable-kneeling-shoulder-external-rotation-male.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment, so the movement was taken from the exercise name and standard coaching: tall kneeling side-on to the pulley, elbow at the side)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength / rehabilitation",
    "bodyPart": "Shoulders (rotator cuff)",
    "secondaryBodyParts": [
      "Upper back",
      "Posterior deltoid"
    ],
    "equipment": [
      "Cable machine (pulley at elbow height)",
      "D-handle"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder rotation)",
    "plane": "Transverse",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "infraspinatus_r"
      ],
      "synergist": [
        "post_deltoid_r",
        "rhomboids_midtrap_r"
      ],
      "stabilizer": [
        "rhomboids_midtrap_l",
        "core",
        "glute_max_r",
        "glute_max_l",
        "forearm_extensors_r",
        "obliques_r",
        "obliques_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you rotate up, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-15 per arm",
      "effort": "Moderate (RIR 2-4); no pain",
      "tempo": "1.8-0.5-2.1-0.6 (out-pause-back-pause, seconds)",
      "rest": "45-60 s",
      "frequency": "2-3 times a week",
      "load": "Cable stack load is user-chosen: very light.",
      "progression": "Add reps, then the smallest plate step; longer pause turned out"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel tall side-on to the cable with the pulley on your left at elbow height. Hold the D-handle in the right hand, elbow bent 90 degrees and tucked at your side, forearm across the stomach; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "rotate",
        "text": "Breathe out and turn the forearm out like a door on a hinge, the elbow staying against your side."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Forearm turned out as far as the shoulder allows without the elbow leaving the side; shoulder blade down and back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Let the cable turn the forearm back across the stomach slowly, in about 2 s."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause, stay tall on the knees, and repeat; switch sides (turn round) after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbow drifting away from the side",
        "fix": "Keep the elbow pinned (a rolled towel between the elbow and the ribs helps)."
      },
      {
        "id": "m2",
        "mistake": "Twisting the trunk to finish the rotation",
        "fix": "Keep the hips and shoulders square; stop where the shoulder runs out of rotation."
      },
      {
        "id": "m3",
        "mistake": "Sitting back toward the heels",
        "fix": "Squeeze the glutes and stay tall on the knees."
      },
      {
        "id": "m4",
        "mistake": "Bending the wrist to move the handle",
        "fix": "Keep the wrist straight in line with the forearm."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper arm",
        "setup": "≈10° from the trunk, elbow at the side",
        "peak": "Unchanged (elbow moves 0.00 cm over the loop)",
        "norm": "Elbow at the side (about 0-20 degrees of abduction); Sung 2023 compared external rotation at different abduction angles and positions",
        "sources": [
          "sung2023"
        ]
      },
      {
        "measure": "External rotation",
        "setup": "Forearm ≈34° across the body from straight ahead",
        "peak": "Forearm ≈56° out from straight ahead (range ≈90°)",
        "norm": "From the forearm across the stomach (some internal rotation) to about 45-60 degrees out (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈90°",
        "peak": "≈90°",
        "norm": "Held at about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Pulley on the left at 63 cm (elbow height)",
        "peak": "Clear of the body by at least 13.35 cm",
        "norm": "Pulley at elbow height on the opposite side, so the cable pulls the forearm across the body and the load is horizontal (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s, forearm across the stomach",
        "peak": "1.8 s out, 0.5 s hold, 2.1 s back",
        "norm": "Slow, about 2 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Kneeling Shoulder External Rotation, video (movement reference)",
        "url": "https://gymvisual.com/videos/16811-cable-kneeling-shoulder-external-rotation-male.html"
      },
      {
        "id": "sung2023",
        "title": "Sung, Jung, Wang and Kim 2023, the effects of body positions and abduction angles on shoulder muscle activity patterns during external rotation exercises (Healthcare 11(14):1977)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10378914/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front of the shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: use a very light weight; the rotator cuff is a small muscle group.",
        "Put a pad or folded mat under the knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee discomfort: do it standing or half-kneeling.",
        "Shoulder pinching: shorten the range and put a rolled towel under the elbow."
      ],
      "regressions": [
        "Band external rotation with the elbow at the side.",
        "Side-lying dumbbell external rotation."
      ],
      "progressions": [
        "Slower lowering (3 s) and a 2 s pause turned out.",
        "Half-kneeling or standing version.",
        "90/90 external rotation."
      ]
    },
    "muscleNotes": {
      "infraspinatus_r": "Prime mover (with teres minor): turns the upper arm out against the cable.",
      "post_deltoid_r": "Helps the outward rotation and holds the arm in line.",
      "rhomboids_midtrap_r": "Hold the shoulder blade back so the upper arm can rotate.",
      "rhomboids_midtrap_l": "Keeps the shoulders square.",
      "core": "Keeps the trunk from twisting toward the pulley.",
      "glute_max_r": "Keeps the hips tall on the knees.",
      "glute_max_l": "Keeps the hips tall on the knees.",
      "forearm_extensors_r": "Hold the wrist straight.",
      "obliques_r": "Resist the cable's pull to turn the trunk.",
      "obliques_l": "Resist the cable's pull to turn the trunk."
    }
  },
