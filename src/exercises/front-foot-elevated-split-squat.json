    "breathing": {
      "pattern": "Inhale on the way down, exhale on the way up.",
      "cadence": "About 1.9 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "3 per leg",
      "reps": "6-12",
      "tempo": "2-1-1-0",
      "frequency": "1-3 times a week",
      "progression": "Heavier dumbbells, a pause at the bottom, then a higher step. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Whole right foot on a low step, left foot back on its ball, a dumbbell in each hand at the sides."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and drop the back knee straight down; the front knee travels forward over the foot."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Back knee just above the floor, below the level of the front foot; chest tall, front heel down."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive through the whole front foot to stand up."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the stance and repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Front heel lifting off the step",
        "fix": "Keep the whole foot on the step; lengthen the stance slightly if needed."
      },
      {
        "id": "m2",
        "mistake": "Front knee caving inward",
        "fix": "Keep the knee over the 2nd-3rd toe."
      },
      {
        "id": "m3",
        "mistake": "Cutting the range short",
        "fix": "Use the step: let the back knee travel below the front foot under control."
      },
      {
        "id": "m4",
        "mistake": "Leaning far forward",
        "fix": "Keep the chest tall and the dumbbells hanging straight down."
      }
    ],
    "kinematics": [
      {
        "measure": "Step height",
        "setup": "15 cm step under the whole right foot",
        "peak": "Front foot stays flat on the step",
        "norm": "A low step or plate, about 5-15 cm (common coaching; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance length (ankle centres)",
        "setup": "85 cm between ankle centres, feet 18 cm apart sideways",
        "peak": "Unchanged",
        "norm": "About one leg length was suggested as optimal in the split squat (Song 2023)",
        "sources": [
          "song2023"
        ]
      },
      {
        "measure": "Front knee flexion",
        "setup": "≈28°",
        "peak": "≈104°, shin ≈-3° forward of vertical",
        "norm": "More than in a flat split squat; about 100-110 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Back knee",
        "setup": "≈18°",
        "peak": "≈95°, joint centre 13 cm above the floor (the front ankle is 21.8 cm up)",
        "norm": "Drops toward the floor, below the front foot (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈1°",
        "peak": "≈7°",
        "norm": "Upright to slightly forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.9 s down, 0.3 s pause, 1.1 s up, 1.1 s reset",
        "norm": "About 2 s down, 1 s up (clinical opinion)",
        "sources": []
      }
    ],
