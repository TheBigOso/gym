  "exercise": {
    "id": "flutter-kicks",
    "name": "Flutter Kicks",
    "aliases": [
      "Lying flutter kicks",
      "Scissor flutters"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "045912",
      "title": "Flutter Kicks",
      "url": "https://gymvisual.com/videos/14581-flutter-kicks.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (hip flexors) and waist",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (alternating hip flexion and extension, trunk held)",
    "plane": "Sagittal",
    "laterality": "Bilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "obliques_r",
        "obliques_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily through the kicks; do not hold the breath.",
      "cadence": "Small kicks about 2 per second"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "20-30 s or 20-40 kicks",
      "tempo": "Small, steady kicks about 2 per second",
      "frequency": "2-3 times a week",
      "progression": "Longer sets, then lower legs (closer to the floor), then add a head and shoulder lift"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, arms by your sides palms down, legs straight and together."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Brace and lift both heels a little off the mat; low back stays down."
      },
      {
        "id": "c3",
        "phase": "kicks",
        "text": "Kick small and fast, one leg up as the other goes down; knees long, toes pointed. Keep breathing."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Bring the legs together and lower them to the mat under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest briefly and repeat the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching off the mat",
        "fix": "Raise the legs higher, put the hands under the hips, or bend the knees slightly."
      },
      {
        "id": "m2",
        "mistake": "Big, slow swings",
        "fix": "Keep the kicks small (about a hand span) and steady."
      },
      {
        "id": "m3",
        "mistake": "Holding the breath",
        "fix": "Breathe in a steady rhythm."
      },
      {
        "id": "m4",
        "mistake": "Neck straining",
        "fix": "Rest the head on the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Legs from the floor (average)",
        "setup": "Legs resting on the mat",
        "peak": "≈9° (heels about 9 cm off the mat)",
        "norm": "Heels lifted a little off the floor; lower is harder for the back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Kick amplitude",
        "setup": "–",
        "peak": "±5° per leg; up to 14 cm between the ankles",
        "norm": "Small alternating kicks, about a hand span between the feet (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion range",
        "setup": "≈12° hold",
        "peak": "≈7° to ≈17°",
        "norm": "Each leg moves a few degrees above and below the hold (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈2°",
        "peak": "≈2°, toes pointed",
        "norm": "Straight or nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Pelvis stays on the mat (clinical opinion; McGill 1998 for the load of straight-leg work)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.6 s, lift 0.6 s",
        "peak": "9 kick extremes in 4.2 s (about 2 kicks per second), lower 0.8 s",
        "norm": "About 2 kicks per second (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #045912, Flutter Kicks, video (movement reference)",
        "url": "https://gymvisual.com/videos/14581-flutter-kicks.html"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Straight-leg raises load the low back: leg raises gave higher psoas activity and spine compression than sit-ups in McGill's data (McGill 1998). If the low back arches off the mat, bend the knees or shorten the range.",
        "Low-back pain or disc problems: prefer dead bugs or bent-knee alternatives.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion or straight-leg work."
      ],
      "modify": [
        "Hands under the hips.",
        "Legs higher off the floor (easier on the back).",
        "Slight knee bend."
      ],
      "regressions": [
        "Single-leg lowering.",
        "Dead bug.",
        "Bent-knee flutter."
      ],
      "progressions": [
        "Longer sets.",
        "Legs closer to the floor.",
        "Head and shoulders lifted (hollow hold)."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas holds both legs up and drives each small kick. Leg raises gave the highest psoas activity in McGill's comparison (McGill 1998).",
      "hip_flexors_l": "Iliopsoas holds both legs up and drives each small kick. Leg raises gave the highest psoas activity in McGill's comparison (McGill 1998).",
      "core": "Rectus abdominis and transversus hold the pelvis still while both legs are off the floor; bilateral (not unilateral) leg lifts needed abdominal activation (Andersson 1997).",
      "adductors_r": "Keep the legs close and help flex the hip near the floor (clinical opinion).",
      "adductors_l": "Keep the legs close and help flex the hip near the floor (clinical opinion).",
      "quads_r": "Keep the knees straight and the toes pointed.",
      "quads_l": "Keep the knees straight and the toes pointed.",
      "obliques_r": "Brace against the alternating pull of the legs.",
      "obliques_l": "Brace against the alternating pull of the legs."
    }
