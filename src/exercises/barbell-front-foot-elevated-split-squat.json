    "breathing": {
      "pattern": "Inhale on the way down, exhale on the way up.",
      "cadence": "About 1.9 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-10 per side",
      "tempo": "2-1-1-0",
      "frequency": "1-2 times a week",
      "load": "Moderate; leave 2-3 reps in reserve.",
      "rest": "1.5-2 minutes",
      "progression": "Add 2.5 kg when every rep reaches full depth."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar on the upper traps just below the bony bump at the base of the neck, hands just outside the shoulders, elbows down, shoulder blades squeezed. Put the whole right foot on a low step, the left foot back on its ball, feet hip width apart sideways."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Brace and drop the hips straight down; the front knee travels forward over the toes and the chest stays up under the bar."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Lower the back knee to just above the floor, below the level of the front foot; front heel stays down."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive through the front foot to stand back up; breathe out as you rise."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall in the split stance, re-brace, repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Stance too short, so the front heel lifts",
        "fix": "Set the back foot about one leg length behind the step."
      },
      {
        "id": "m2",
        "mistake": "Pushing off the back leg",
        "fix": "Most of the weight stays on the front foot; the back leg only balances."
      },
      {
        "id": "m3",
        "mistake": "Front knee caving in",
        "fix": "Keep the knee over the middle toes."
      },
      {
        "id": "m4",
        "mistake": "Leaning forward under the bar",
        "fix": "Keep the chest up and the bar over the middle of the stance."
      }
    ],
    "kinematics": [
      {
        "measure": "Step height",
        "setup": "15 cm step under the whole right foot",
        "peak": "Front foot stays flat on the step",
        "norm": "A low step or plate, about 5-15 cm (common coaching; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance length (ankle centres)",
        "setup": "85 cm between ankle centres, feet 18 cm apart sideways",
        "peak": "Unchanged",
        "norm": "About one leg length was suggested as optimal in the split squat (Song 2023)",
        "sources": [
          "song2023"
        ]
      },
      {
        "measure": "Front knee flexion",
        "setup": "≈28°",
        "peak": "≈104°, shin ≈-3° forward of vertical",
        "norm": "More than in a flat split squat; about 100-110 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Back knee",
        "setup": "≈18°",
        "peak": "≈95°, joint centre 13 cm above the floor (the front ankle is 21.8 cm up)",
        "norm": "Drops toward the floor, below the front foot (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈1°",
        "peak": "≈7°",
        "norm": "Upright to slightly forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.9 s down, 0.3 s pause, 1.1 s up, 1.1 s reset",
        "norm": "About 2 s down, 1 s up (clinical opinion)",
        "sources": []
      }
