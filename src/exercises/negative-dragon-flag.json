  "exercise": {
    "id": "negative-dragon-flag",
    "name": "Negative Dragon Flag",
    "aliases": [
      "Dragon flag negative",
      "Eccentric dragon flag",
      "Dragon flag lowering",
      "Lowering dragon flag"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11349",
      "title": "Negative Dragon Flag",
      "url": "https://gymvisual.com/videos/11349-negative-dragon-flag.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Lats",
      "Hip flexors",
      "Glutes"
    ],
    "equipment": [
      "Flat bench",
      "Body weight"
    ],
    "difficulty": "Advanced",
    "mechanics": "Eccentric (anti-extension, long lever)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "lats_r",
        "lats_l",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "stabilizer": [
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Brace, then breathe out slowly through pursed lips as you lower; breathe in as you tuck back up.",
      "cadence": "One slow breath out per 4 s lowering"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "3-6 slow negatives",
      "tempo": "4 s lowering, tuck up, 1 s pause at the top",
      "frequency": "1-2 times a week",
      "progression": "Slower lowering, then pauses on the way down, then full dragon flags"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench and grip the bench behind your head. Roll up onto the upper back, body straight up."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Keep the body rigid from shoulders to toes and lower it slowly, like a falling plank."
      },
      {
        "id": "c3",
        "phase": "lower",
        "text": "Do not bend at the hips; keep the low back from arching."
      },
      {
        "id": "c4",
        "phase": "bottom",
        "text": "Stop just above the bench."
      },
      {
        "id": "c5",
        "phase": "tuck",
        "text": "Bend the knees and hips and roll back up to the top."
      },
      {
        "id": "c6",
        "phase": "extend",
        "text": "Straighten the body back to vertical and go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Piking at the hips",
        "fix": "Squeeze the glutes; if you cannot hold the line, use the tuck or one-leg version."
      },
      {
        "id": "m2",
        "mistake": "Low back arching",
        "fix": "Lower only as far as you can keep it flat; brace harder."
      },
      {
        "id": "m3",
        "mistake": "Resting the weight on the neck",
        "fix": "Balance on the upper back and shoulder blades, not the neck."
      },
      {
        "id": "m4",
        "mistake": "Dropping quickly",
        "fix": "Count four seconds down."
      }
    ],
    "kinematics": [
      {
        "measure": "Body angle",
        "setup": "≈72° above the bench at the top",
        "peak": "Lowered to ≈10° (feet 15 cm above the pad level)",
        "norm": "From near vertical to just above the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip angle",
        "setup": "Hip ≈0°",
        "peak": "Hip ≈0° throughout the lowering; tuck ≈112° to roll back up",
        "norm": "Straight (about 0 degrees) through the lowering (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pivot",
        "setup": "Upper back on the pad (contact hair)",
        "peak": "Mid-back joint stays put; neck flexion ≈60° at the top, ≈-20° at the bottom",
        "norm": "Upper back and shoulder blades on the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold the top 0.6 s",
        "peak": "4 s lowering, 0.4 s hold, 2.6 s tuck and roll up, 0.6 s pause",
        "norm": "About 3-5 s lowering (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11349, Negative Dragon Flag, video (movement reference; page not readable here)",
