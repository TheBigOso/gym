    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (anti-extension, shoulder flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
