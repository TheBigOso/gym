        "glute_max_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Brace before rolling out, breathe out slowly on the way out or hold the brace, breathe in once back at the start.",
      "cadence": "About 2.2 s out, a short hold, about 1.8 s back"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "60-90 s between sets",
      "sets": "3",
      "reps": "6-12",
      "tempo": "2 s out, short hold, 2 s back",
      "load": "Bodyweight plus range: roll only as far as the low back stays flat (no sag). Light round plates (standard 45 cm) let the bar roll smoothly.",
      "progression": "Roll out further each week, then pause at the far point; standing rollouts are the advanced step."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel on a mat, knees under the hips, bar on its plates on the floor under the shoulders, overhand grip about shoulder width, arms straight. Tuck the pelvis slightly and brace."
      },
      {
        "id": "c2",
        "phase": "out",
        "text": "Roll the bar forward on its plates, letting the hips and shoulders travel forward together; the arms reach overhead and the body lowers in one line from knees to shoulders."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Stop just before the low back starts to sag; ribs down, glutes tight."
      },
      {
        "id": "c4",
        "phase": "back",
        "text": "Pull the bar back toward the knees with straight arms, bracing the abs, until the hips are back over the knees."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Breathe, re-brace, and go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back sagging at the far point",
        "fix": "Shorten the range; keep the ribs down and the pelvis slightly tucked."
      },
      {
        "id": "m2",
        "mistake": "Hips staying back (only the arms move)",
        "fix": "Let the hips travel forward with the bar so the body lengthens as one piece."
      },
      {
        "id": "m3",
        "mistake": "Bending the elbows",
        "fix": "Keep the arms straight; the shoulders and abs do the work."
      },
      {
        "id": "m4",
        "mistake": "Rolling back by piking the hips first",
        "fix": "Pull the bar back with the abs and lats; the hips follow."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk inclination",
        "setup": "≈36° from vertical, thighs vertical over the knees",
        "peak": "≈73° from vertical at the far point (≈17° above level), thighs 52° forward",
        "norm": "Trunk lowers toward level as the bar rolls out (clinical opinion); rollouts were among the most demanding exercises for the rectus abdominis and obliques (Escamilla 2006)",
        "sources": [
          "escamilla2006"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈38° (joint channel)",
        "peak": "≈23° at the far point",
        "norm": "From flexed hips over the knees to near straight hips at the far point (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder flexion",
        "setup": "Upper arm ≈47° from the trunk line, arms about vertical",
        "peak": "≈154° from the trunk line, elbows ≈7°",
        "norm": "Arms move from under the shoulders to overhead in line with the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar path",
        "setup": "Overhand 50 cm grip (handle centres); bar 36.7 cm in front of the knees",
        "peak": "Rolls 96.1 cm forward, plates on the floor the whole loop (lowest plate point 0 to 0.2 cm)",
        "norm": "Plates roll on the floor the whole rep (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Set 0.8 s",
        "peak": "2.2 s out, 0.4 s hold, 1.8 s back, 0.8 s reset",
        "norm": "Slow, controlled out and back (clinical opinion); core exercise reviews favour controlled anti-extension work (Oliva-Lozano 2020)",
        "sources": [
          "oliva2020"
        ]
      }
    ],
    "safety": {
      "cautions": [
        "Low-back pain or a sagging low back: shorten the range; keep the spine neutral (McGill 1998).",
        "Use round plates of equal size so the bar rolls straight; a mat protects the knees.",
        "Shoulder pain overhead: stop the roll earlier.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shorter range, or roll up a slight incline / toward a wall that stops the bar.",
        "Knee pain: thicker pad."
      ],
      "regressions": [
        "Front plank.",
        "Swiss ball rollout.",
        "Partial-range rollout to a wall."
      ],
      "progressions": [
        "Longer range with a pause.",
        "Standing rollout (advanced)."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis resists the trunk extending as the lever lengthens (Escamilla 2006).",
      "obliques_r": "Resist extension and keep the pelvis tucked (Escamilla 2006).",
      "obliques_l": "Resist extension and keep the pelvis tucked (Escamilla 2006).",
      "lats_r": "Pull the bar back from overhead and control the roll out.",
      "lats_l": "Pull the bar back from overhead and control the roll out.",
      "triceps_r": "Long head helps hold and pull the straight arms.",
      "triceps_l": "Long head helps hold and pull the straight arms.",
      "ant_deltoid_r": "Controls the shoulder flexion as the arms reach overhead.",
      "ant_deltoid_l": "Controls the shoulder flexion as the arms reach overhead.",
      "hip_flexors_r": "Work with the hips flexing on the way back.",
      "hip_flexors_l": "Work with the hips flexing on the way back.",
      "serratus_r": "Holds the shoulder blades against the ribs.",
      "serratus_l": "Holds the shoulder blades against the ribs.",
      "pec_r": "Helps pull the arms back down from overhead.",
      "pec_l": "Helps pull the arms back down from overhead.",
      "glute_max_r": "Keeps the hips extended at the far point.",
      "glute_max_l": "Keeps the hips extended at the far point.",
      "forearm_flexors_r": "Hold the bar.",
      "forearm_flexors_l": "Hold the bar."
    },
