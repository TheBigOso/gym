    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Shoulders (front deltoid)"
    ],
    "equipment": [
      "Cable crossover (two low pulleys)",
      "Two D-handles",
      "Flat bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (horizontal adduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
