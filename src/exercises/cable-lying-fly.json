        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the arms open, breathe out as they hug back together.",
      "cadence": "About 2 s down, short stretch, about 1.5 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2.2-0.4-1.5-0.6 (open-stretch-close-squeeze, seconds)",
      "rest": "60-120 s",
      "frequency": "1-3 times a week",
      "load": "Cable stack load is user-chosen and moderate: the elbows must stay softly bent.",
      "progression": "Add reps, then load; add a 1 s squeeze"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench midway between two low pulleys, feet flat; a handle in each hand, arms up over the chest with a soft elbow bend, palms facing."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in; open the arms in a wide arc, elbows fixed, until the upper arms are about level with the bench."
      },
      {
        "id": "c3",
        "phase": "stretch",
        "text": "Brief stretch across the chest, shoulder blades on the bench."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out; hug the handles back up along the same arc over the chest."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the chest with the hands over the chest, then open again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending and straightening the elbows (pressing)",
        "fix": "Fix a soft elbow bend for the whole rep."
      },
      {
        "id": "m2",
        "mistake": "Lowering the arms far below the bench",
        "fix": "Stop with the upper arms about level with the bench."
      },
      {
        "id": "m3",
        "mistake": "Arching off the bench",
        "fix": "Keep the head, upper back and buttocks on the pad."
      },
      {
        "id": "m4",
        "mistake": "Clanking the handles together",
        "fix": "Stop with the hands a few cm apart."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "Flat (0°)",
        "peak": "Buttocks on the seat end, upper back and head on the pad",
        "norm": "Flat bench (Rodriguez-Ridao 2020 compares bench inclinations)",
        "sources": [
          "rodriguez2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈20° (soft, fixed)",
        "peak": "≈20° at the bottom; 20-20° through the loop",
        "norm": "Soft and fixed, about 20 degrees (elbow angle about 160); dumbbell flyes load the pectoralis well at long lengths (Solstad 2020)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Arm opening",
        "setup": "Upper arm ≈3° from vertical, hands 20.7 cm apart over the chest",
        "peak": "≈93° from vertical at the bottom (≈4° below the back plane, 12° toward the hips)",
        "norm": "From over the chest to the upper arms about level with the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral, palms facing each other",
        "peak": "Palms up at the bottom",
        "norm": "Neutral at the top, palms up at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Low pulleys 12 cm high beside the chest, 190 cm apart",
        "peak": "Both cables clear of the body by at least 6.66 cm",
        "norm": "Low pulleys beside the bench so the cables pull out and down (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor, knees about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Squeeze 0.6 s over the chest",
        "peak": "2.2 s down, 0.4 s stretch, 1.5 s up",
        "norm": "Controlled, about 2 s down and 1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Lying Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/5017-cable-lying-fly.html"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      },
      {
        "id": "rodriguez2020",
        "title": "Rodríguez-Ridao, Antequera-Vique, Martín-Fuentes and Muyor 2020, effect of five bench inclinations on the electromyographic activity of the pectoralis major, anterior deltoid and triceps brachii during the bench press exercise (Int J Environ Res Public Health 17(19):7339; PMC7579505)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7579505/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can move with the trunk still and the shoulders down.",
        "Bring the handles up over the chest before sitting up; do not let the cables pull the arms open.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort at the bottom: stop the arms higher.",
        "Lower-back discomfort: put the feet on the end of the bench."
      ],
      "regressions": [
        "Lighter load.",
        "Dumbbell fly.",
        "Band fly."
      ],
      "progressions": [
        "Slower 3 s down.",
        "Incline cable fly."
      ]
    },
    "muscleNotes": {
