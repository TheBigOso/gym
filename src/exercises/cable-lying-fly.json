      "pec_l": "Prime mover: hugs the arms together across the chest.",
      "ant_deltoid_r": "Helps bring the arms up and in.",
      "ant_deltoid_l": "Helps bring the arms up and in.",
      "biceps_r": "Holds the soft elbow bend.",
