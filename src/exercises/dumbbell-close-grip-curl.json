    "id": "dumbbell-close-grip-curl",
    "name": "Dumbbell Close Grip Curl",
    "aliases": [
      "Close-grip dumbbell curl",
      "Narrow-grip dumbbell curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "415212",
      "title": "Dumbbell Close Grip Curl",
      "url": "https://gymvisual.com/videos/9377-dumbbell-close-grip-curl.html",
      "listing": "Video; data sheet: body part Upper Arms, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "equipment": [
      "Dumbbell"
    ],
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, dumbbells in front of the thighs, palms forward, the inner ends of the dumbbells almost touching."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl both dumbbells together, elbows close to the body, hands staying close."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze at the top with the dumbbells in front of the chest; wrists straight."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, 2-3 s, to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight, dumbbells close together, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hands drifting apart as the weight rises",
        "fix": "Keep the inner plates a finger width apart all the way."
      },
      {
        "id": "m2",
        "mistake": "Swinging the hips to start the weight",
        "fix": "Stand tall, brace, and use a lighter dumbbell."
      },
      {
        "id": "m3",
        "mistake": "Elbows flaring out to the sides",
        "fix": "Keep the elbows in front of the hips and close to the body."
      },
      {
        "id": "m4",
        "mistake": "Dropping the weight on the way down",
        "fix": "Take 2-3 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈22° (arm straight)",
        "peak": "≈137° at the top (range ≈115°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "-15.4° (palm forward/up)",
        "peak": "3.6° (palm forward/up)",
        "norm": "The supinated grip gave the highest biceps activity in the lifting phase; neutral grips shift work toward the brachioradialis (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-6°",
        "peak": "≈7° (elbow forward)",
        "norm": "Elbows stay near the sides; a small forward drift at the top is normal, a big swing shifts work to the front deltoid (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms straight 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Hand spacing (handle centres)",
        "setup": "Handle centres 34.4 cm apart (inner plate ends ≈2.4 cm apart)",
        "peak": "Handle centres 34.7 cm apart at the top",
        "norm": "Narrower than the standard curl: inner plates nearly touching (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #415212, Dumbbell Close Grip Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/9377-dumbbell-close-grip-curl.html"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29; PMC3737788)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the dumbbell and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Pick the dumbbells up and set them down with a straight back and bent knees.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Wrist or elbow discomfort with the hands close: widen the grip slightly (clinical opinion)."
      ],
      "modify": [
        "Wrist strain: standard-width dumbbell curl.",
        "Back strain: do it seated or against a wall."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Dumbbell biceps curl."
      ],
      "progressions": [
        "Slower lowering.",
        "Strict curl against a wall."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor and supinator; the palms stay up. Grip changes the biceps/brachioradialis share (Coratella 2023); the hands-close position is commonly said to bias the outer (long) head, which no study we found has measured (clinical opinion).",
      "biceps_l": "Main elbow flexor and supinator; the palms stay up. Grip changes the biceps/brachioradialis share (Coratella 2023); the hands-close position is commonly said to bias the outer (long) head, which no study we found has measured (clinical opinion).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder so the upper arm stays put; it rises if the elbow drifts forward.",
      "ant_deltoid_l": "Steadies the shoulder so the upper arm stays put; it rises if the elbow drifts forward.",
      "core": "Keeps the trunk still so the hips do not swing the weight up."
    }
  },
