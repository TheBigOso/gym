    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: use a light load and a short range; seek advice if pain persists."
      ],
      "modify": [
        "Tight hips: sit a little higher or spread the feet wider."
      ],
      "regressions": [
        "Seated hinge without weight, hands across the chest.",
        "Shorter range."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Standing dumbbell good morning."
      ]
    },
    "muscleNotes": {
      "hamstrings_r": "Less stretched than in the standing good morning because the knees are bent (clinical opinion).",
      "hamstrings_l": "Less stretched than in the standing good morning because the knees are bent (clinical opinion).",
      "glute_max_r": "Extends the hips to lift the trunk from the forward lean.",
      "glute_max_l": "Extends the hips to lift the trunk from the forward lean.",
      "spinal_extensors_r": "Main mover here: with the knees bent the hamstrings are slack, so the back extensors and glutes lift the trunk; hold it flat (clinical opinion; barbell good morning erector spinae data in Vigotsky 2015).",
      "spinal_extensors_l": "Main mover here: with the knees bent the hamstrings are slack, so the back extensors and glutes lift the trunk; hold it flat (clinical opinion; barbell good morning erector spinae data in Vigotsky 2015).",
      "adductors_r": "Adductor magnus helps extend the hips; the wide seat lets the trunk lower between the thighs.",
      "adductors_l": "Adductor magnus helps extend the hips; the wide seat lets the trunk lower between the thighs.",
      "core": "Brace the trunk.",
      "biceps_r": "Hold the dumbbell against the chest.",
      "biceps_l": "Hold the dumbbell against the chest.",
      "forearm_flexors_r": "Cup the dumbbell.",
      "forearm_flexors_l": "Cup the dumbbell."
    }
