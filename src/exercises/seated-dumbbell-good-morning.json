        "core",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace upright, lower with the brace, breathe out as you sit tall.",
      "cadence": "About 2 s down, short pause, 1.3 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "2-1-1-1",
      "load": "User-chosen dumbbell, light; stop about 2-3 reps short of failure (RIR 2-3)",
      "frequency": "1-2 times a week",
      "progression": "Add load, then a pause at the bottom"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of the bench, feet wide and flat, one dumbbell held upright against the chest."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Hinge forward from the hips with a flat back, the chest moving down between the thighs."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop before the back rounds; feel the glutes and lower back working."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Squeeze the glutes and lift the chest to sit tall again."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Sit tall, breathe and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back to go lower",
        "fix": "Stop where the back is still flat."
      },
      {
        "id": "m2",
        "mistake": "Feet too narrow, so the thighs block the trunk",
        "fix": "Spread the feet wide so the chest can lower between the knees."
      },
      {
        "id": "m3",
        "mistake": "Rocking back off the seat to stand up the trunk",
        "fix": "Keep the hips planted on the bench."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈83° seated",
        "peak": "≈137° (joint channel), trunk ≈45° forward of vertical",
        "norm": "Trunk leans forward from upright to about 45-60 degrees with a flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈86°, ankles 60 cm apart, toes out 20°",
        "peak": "≈86°",
        "norm": "Knees bent about 90 degrees, feet planted (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar motion",
        "setup": "Neutral",
        "peak": "Spine channels -4°/-1°/1° (L5/T12/T6): neutral",
        "norm": "Neutral spine (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Sit 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.3 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
