  "exercise": {
    "id": "cable-incline-pushdown",
    "name": "Cable Incline Pushdown",
    "aliases": [
      "Incline bench cable pullover",
      "Incline straight-arm cable pushdown",
      "Cable incline pullover"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "19230",
      "title": "Cable Incline Pushdown",
      "url": "https://gymvisual.com/videos/19230-cable-incline-pushdown.html",
      "listing": "Video; the page could not be read here (blocked). The movement follows the name and a written description of the same exercise: lying back on an incline bench facing away from a high pulley, straight bar, straight arms sweeping from over the head to the thighs.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lats)",
    "secondaryBodyParts": [
      "Chest",
      "Triceps (long head)",
      "Core"
    ],
    "equipment": [
      "Cable",
      "Bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (shoulder extension with straight arms)",
    "plane": "Sagittal",
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l"
      ],
      "synergist": [
        "pec_r",
        "pec_l",
        "triceps_r",
        "triceps_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "stabilizer": [
        "core",
        "serratus_r",
        "serratus_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "lats_r",
        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you sweep the bar down to the thighs; breathe in as it goes back over the head.",
      "cadence": "About 1.4 s down, 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "About 1-2 s down, short squeeze, 2 s back",
      "load": "User-chosen light-to-moderate cable weight; straight arms make it feel heavy",
      "frequency": "1-2 times a week",
      "progression": "Pause at the thighs, then more weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie back on a 45-degree bench facing away from the high pulley; hold the straight bar overhand, shoulder width, arms long over the head."
      },
      {
        "id": "c2",
        "phase": "push",
        "text": "Keeping the arms straight, sweep the bar in an arc down to just above the thighs; shoulder blades set down."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the lats with the bar just over the thighs."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Let the bar travel back over the head slowly, arms still straight, ribs down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief stretch with the arms overhead."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the elbows (turning it into a triceps pushdown)",
        "fix": "Fix the elbows softly bent; the shoulders do the work."
      },
      {
        "id": "m2",
        "mistake": "Arching off the pad as the arms go overhead",
        "fix": "Keep the ribs down and the back on the pad; shorten the range."
      },
      {
        "id": "m3",
        "mistake": "Shrugging",
        "fix": "Shoulders down, long neck."
      },
      {
        "id": "m4",
        "mistake": "Letting the cable pull the arms back fast",
        "fix": "Control the return over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder flexion",
        "setup": "Upper arm ≈154° from the trunk (bar over the head)",
        "peak": "≈23° (bar 4 cm off the thighs)",
        "norm": "From arms overhead to the hands at the thighs; pullovers load the lats and pectorals through a long arc (Pezarat-Correia 2020; Teixeira 2022)",
        "sources": [
          "pezarat2020",
          "teixeira2022"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12°-12° over the loop",
        "peak": "Unchanged",
        "norm": "Straight arms, soft elbows, unchanged (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bench",
        "setup": "Back pad at 45° from the floor; upper back on the pad (gap 0-0 cm on the rig shapes)",
        "peak": "Unchanged: only the arms move",
        "norm": "Incline about 45 degrees; back and head on the pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Overhand, 44 cm between the hands on a 50 cm bar",
        "peak": "Unchanged (43.81-44.08 cm)",
        "norm": "Overhand, about shoulder width (standard coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the bar over the head",
        "peak": "1.4 s down, 0.4 s at the thighs, 2 s back up",
        "norm": "Controlled, about 1-2 s down and 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #19230, Cable Incline Pushdown, video (movement reference)",
        "url": "https://gymvisual.com/videos/19230-cable-incline-pushdown.html"
      },
      {
        "id": "pezarat2020",
        "title": "Pezarat-Correia, Medeiros, Fernandes, Vaz, Silva and Moraes 2020, comparison of shoulder and trunk muscle activation between different pullover exercises (Rev Andal Med Deporte 13(3):127-133)",
        "url": "https://ws154.juntadeandalucia.es/ojs/index.php/ramd/article/download/672/1129?inline=1"
      },
      {
        "id": "teixeira2022",
        "title": "Teixeira, Gomes, da Silva, Magalhães and Marchetti 2022, differences between pullover and pulldown exercises on maximal isometric force and myoelectric activity in recreationally-trained men (Int J Exerc Sci 15(4):797-807; PMC9362894)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC9362894/"
      },
      {
        "id": "campos2014",
        "title": "Campos and Silva 2014, comparison of electromyographic activity during the bench press and barbell pullover exercises (Motriz 20(2):200-205)",
        "url": "https://scielo.br/j/motriz/a/jbfGfJrRsXbfc9BrfXgVSPy/?lang=en"
      }
    ],
    "safety": {
      "cautions": [
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Shoulder pain or limited overhead mobility: start the arc lower (bar above the face, not over the head).",
        "Sit down and stand up from the bench with the bar under control; ask for a hand-off if needed.",
        "Load is user-chosen: start light."
      ],
      "modify": [
        "Shorter arc.",
        "Standing cable straight-arm pulldown."
      ],
      "regressions": [
        "Band straight-arm pulldown.",
        "Dumbbell pullover with a light dumbbell."
      ],
      "progressions": [
        "Pause at the thighs.",
        "More weight.",
        "Single-arm version with a D-handle."
      ]
    },
    "muscleNotes": {
      "lats_r": "Extend the shoulder through the arc from overhead to the thighs; pullover and pulldown both load the latissimus dorsi (Teixeira 2022) and it is lengthened at the overhead start.",
      "lats_l": "Extend the shoulder through the arc from overhead to the thighs; pullover and pulldown both load the latissimus dorsi (Teixeira 2022) and it is lengthened at the overhead start.",
      "pec_r": "The lower pectoral fibres help pull the arms down from overhead (Pezarat-Correia 2020; Campos 2014).",
      "pec_l": "The lower pectoral fibres help pull the arms down from overhead (Pezarat-Correia 2020; Campos 2014).",
      "triceps_r": "The long head helps extend the shoulder and keeps the elbows straight (clinical opinion).",
      "triceps_l": "The long head helps extend the shoulder and keeps the elbows straight (clinical opinion).",
      "post_deltoid_r": "Helps finish the arc toward the thighs (clinical opinion).",
      "post_deltoid_l": "Helps finish the arc toward the thighs (clinical opinion).",
      "core": "Stops the ribs flaring and the back arching (clinical opinion).",
      "serratus_r": "Controls the shoulder blades overhead (clinical opinion).",
      "serratus_l": "Controls the shoulder blades overhead (clinical opinion).",
      "rhomboids_midtrap_r": "Set the shoulder blades as the bar comes down (clinical opinion).",
      "rhomboids_midtrap_l": "Set the shoulder blades as the bar comes down (clinical opinion).",
      "forearm_flexors_r": "Grip the bar (clinical opinion).",
      "forearm_flexors_l": "Grip the bar (clinical opinion)."
    }
