  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "alternate-heel-touchers",
    "name": "Alternate Heel Touchers",
    "aliases": [
      "Heel touches",
      "Lying oblique reach",
      "Ankle tappers"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "8092",
      "title": "Alternate Heel Touchers",
      "url": "https://gymvisual.com/videos/8092-alternate-heel-touchers.html",
      "listing": "Video (movement reference; page could not be read at authoring time, movement taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk lateral flexion with the shoulders held off the mat)",
    "plane": "Frontal",
    "laterality": "Bilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "core"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "upper_traps_r",
        "upper_traps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale on each side reach, inhale through the centre.",
      "cadence": "About 1 s per side"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-20 per side",
      "tempo": "Steady, about 1 s per side",
      "frequency": "2-4 times a week",
      "progression": "Feet farther from the hips, then hold a light plate across the chest between sets"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent, feet flat about hip width, arms long by your sides."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Curl the head and shoulders a little off the mat and float the hands just above it."
      },
      {
        "id": "c3",
        "phase": "right",
        "text": "Side-bend to the right and reach the right hand toward the right heel."
      },
      {
        "id": "c4",
        "phase": "left",
        "text": "Pass through the centre and reach the left hand toward the left heel. Shoulders stay up."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Lower the head and shoulders and rest."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping the shoulders to the mat between reaches",
        "fix": "Keep the shoulder blades just off the mat for the whole set."
      },
      {
        "id": "m2",
        "mistake": "Pulling the chin into the chest",
        "fix": "Keep a fist of space under the chin."
      },
      {
        "id": "m3",
        "mistake": "Rotating instead of side-bending",
        "fix": "Slide the hand along the floor toward the heel; the chest faces the knees."
      },
      {
        "id": "m4",
        "mistake": "Feet sliding",
        "fix": "Press the feet into the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk lift",
        "setup": "Head and shoulders on the mat",
        "peak": "Shoulders 10.3 cm up, upper trunk ≈24° from the floor",
        "norm": "Shoulder blades just off the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lateral flexion",
        "setup": "0°",
        "peak": "24° each way (sum of the lumbar and thoracic segments)",
        "norm": "Each side reach is a short side bend of the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hand reach",
        "setup": "Arms long by the sides",
        "peak": "Fingertips 15 cm from the heel at full reach (hands about 3 cm off the mat)",
        "norm": "Hand slides toward the heel on the same side (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hips and knees",
        "setup": "Knees ≈110°, feet planted",
        "peak": "Unchanged",
        "norm": "Knees bent about 90 degrees, feet planted (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.6 s, curl 0.6 s",
        "peak": "About 1.2 s per side, two reaches each side",
        "norm": "About 1 s per side (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #8092, Alternate Heel Touchers, video (movement reference)",
        "url": "https://gymvisual.com/videos/8092-alternate-heel-touchers.html"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises: implications for rehabilitation and training (Phys Ther 86(5):656-671; PubMed 16649890)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/16649890/"
      },
      {
        "id": "konrad2001",
        "title": "Konrad, Schmitz and Denner 2001, neuromuscular evaluation of trunk-training exercises (J Athl Train 36(2):109-118; PMC155519)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC155519"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Neck discomfort: support the head between sets or keep it on the mat.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion or legs-off-the-floor work."
      ],
      "modify": [
        "Head resting on the mat (smaller reach).",
        "Feet closer to the hips."
      ],
      "regressions": [
        "Crunch.",
        "Standing side bend."
      ],
      "progressions": [
        "Feet farther away.",
        "Slower reaches with a pause."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Side-bend the trunk to the right for the right-hand reach; the internal and external obliques are the prime lateral flexors (Konrad 2001; Escamilla 2006).",
      "obliques_l": "Side-bend the trunk to the left for the left-hand reach.",
      "core": "Rectus abdominis holds the head and shoulders off the mat throughout.",
      "hip_flexors_r": "Help fix the pelvis with the feet planted.",
      "hip_flexors_l": "Help fix the pelvis with the feet planted.",
      "upper_traps_r": "Hold the arm and shoulder up off the mat.",
      "upper_traps_l": "Hold the arm and shoulder up off the mat."
    }
  },
