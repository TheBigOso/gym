      "url": "https://gymvisual.com/videos/1395-dumbbell-lateral-raise.html",
      "listing": "Video; data sheet: body part Shoulders, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (lateral deltoid)",
    "secondaryBodyParts": [
      "Upper back (trapezius)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "core",
        "forearm_extensors_r",
        "forearm_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down (the tempo used by Coratella 2020)"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "effort": "Stop 0-3 reps short of failure (RIR 0-3)",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds; Coratella 2020)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbells; light: the arm is a long lever",
      "progression": "Add reps, then 1-2 kg; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, dumbbells beside the thighs, palms facing in, elbows slightly bent."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the arms out to the sides, a little in front of the body, leading with the elbows."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at about shoulder height, thumbs forward, shoulders down away from the ears."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s; do not let the dumbbells drop."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause beside the thighs, then repeat without swinging."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the weight up with the hips and back",
        "fix": "Stand still, brace the trunk and use a lighter weight."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders toward the ears",
        "fix": "Keep the shoulders down; raise only to about shoulder height."
      },
      {
        "id": "m3",
        "mistake": "Turning the thumbs up and raising in front (a front raise)",
        "fix": "Keep the thumbs forward and the arms out to the sides, just in front of the body."
      },
      {
        "id": "m4",
        "mistake": "Raising far above shoulder height",
        "fix": "Stop at about 90 degrees; the studies used a 90-degree range (Coratella 2020)."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction (peak)",
        "setup": "≈8° (dumbbells clear of the thighs)",
        "peak": "≈88° (elbow at shoulder height 1 cm)",
        "norm": "Up to about 90 degrees (Coratella 2020 range)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈32° in front of the frontal plane",
        "peak": "≈34°",
        "norm": "Scapular plane, about 30-40 degrees in front of the frontal plane (40 degrees in Tsuruike 2019); Coratella 2020 tested the frontal plane",
        "sources": [
          "tsuruike2019",
          "coratella2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈14°",
        "peak": "≈18°",
        "norm": "Slight, constant bend; a 90-degree elbow bend lowered medial deltoid activity (Coratella 2020)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Humeral rotation",
        "setup": "palms facing the thighs",
        "peak": "palms down, thumbs forward",
        "norm": "Neutral (\"thumbs forward\") gave the highest medial deltoid activity in the lifting phase (Coratella 2020)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the sides",
        "peak": "1.8 s up, 0.4 s at the top, 2.0 s down",
        "norm": "2 s up, 0.5 s pause, 2 s down (Coratella 2020)",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #033412, Dumbbell Lateral Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/1395-dumbbell-lateral-raise.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "campos2020",
        "title": "Campos et al. 2020, different shoulder exercises affect the activation of deltoid portions in resistance-trained individuals (J Hum Kinet 75:5-14)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7706677/"
      },
      {
        "id": "tsuruike2019",
        "title": "Tsuruike & Ellenbecker 2019, scapular muscle electromyographic activity during abduction exercises in the scapular plane in three positions (Int J Sports Phys Ther 14(6):935-944)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6878867/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The \"thumbs down\" (internally rotated) raise was the most demanding for the deltoids in one study, but this position is often linked to shoulder impingement; it is not the default here (clinical opinion; Coratella 2020)."
      ],
      "modify": [
        "Shoulder pinch near the top: raise only to about 70-80 degrees and keep the arms a little further forward (scapular plane).",
        "Low-back strain: do the raise seated on a bench."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Seated lateral raise.",
        "Elbows bent to 90 degrees (shorter lever)."
      ],
      "progressions": [
        "Slower 3-4 s lowering.",
        "Lean-away single-arm lateral raise.",
        "Cable lateral raise."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Prime mover. The lateral raise gave the highest medial deltoid activity among tested exercises (Campos 2020); a neutral humerus (\"thumbs forward\") gave the highest medial deltoid activity in the lifting phase among raise variations (Coratella 2020).",
      "lat_deltoid_l": "Prime mover. The lateral raise gave the highest medial deltoid activity among tested exercises (Campos 2020); a neutral humerus (\"thumbs forward\") gave the highest medial deltoid activity in the lifting phase among raise variations (Coratella 2020).",
      "ant_deltoid_r": "Helps, more so if the arms drift forward or the thumbs turn up; external rotation (\"thumbs up\") roughly doubled anterior deltoid activity (Coratella 2020). Scapular-plane raising may be gentler on the anterior deltoid (Tsuruike 2019).",
      "ant_deltoid_l": "Helps, more so if the arms drift forward or the thumbs turn up; external rotation (\"thumbs up\") roughly doubled anterior deltoid activity (Coratella 2020). Scapular-plane raising may be gentler on the anterior deltoid (Tsuruike 2019).",
      "upper_traps_r": "Upward rotation of the shoulder blade; shrugging the shoulders up shifts work here. Highest with the \"thumbs down\" variation (Coratella 2020).",
      "upper_traps_l": "Upward rotation of the shoulder blade; shrugging the shoulders up shifts work here. Highest with the \"thumbs down\" variation (Coratella 2020).",
      "serratus_r": "Upward rotation of the shoulder blade as the arm rises.",
      "serratus_l": "Upward rotation of the shoulder blade as the arm rises.",
      "post_deltoid_r": "Assists abduction; the lateral raise gave more posterior deltoid activity than the press (Campos 2020).",
      "post_deltoid_l": "Assists abduction; the lateral raise gave more posterior deltoid activity than the press (Campos 2020).",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred.",
      "core": "Keeps the trunk still so the weight is not swung up.",
      "forearm_extensors_r": "Hold the wrist level with the dumbbell.",
      "forearm_extensors_l": "Hold the wrist level with the dumbbell."
    }
  },
