    "breathing": {
      "pattern": "Breathe in and brace at the top, lower; breathe out as you stand.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbell, a pause at the bottom, then stand on two low steps for more depth. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Wide stance, toes turned out. Hold one dumbbell across your body by the handle with both hands, overhand, hands side by side, arms long."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, brace, push the knees out over the toes and sit straight down; the dumbbell hangs between the legs."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs about parallel, chest up, arms long, heels down."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Squeeze the glutes and drive up; breathe out near the top."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, shoulders down, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Knees caving inward",
        "fix": "Push the knees out over the toes all the way down and up."
      },
      {
        "id": "m2",
        "mistake": "Curling or swinging the dumbbell",
        "fix": "Arms stay long and relaxed; only the legs move it."
      },
      {
        "id": "m3",
        "mistake": "Leaning forward",
        "fix": "Keep the chest up; the dumbbell hangs straight under the shoulders."
      },
      {
        "id": "m4",
        "mistake": "Shrugging the shoulders",
        "fix": "Shoulders down and back; let the arms hang."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "60 cm (≈1.5x the rig's 40 cm shoulder width)",
        "peak": "Unchanged",
        "norm": "About 1.4-2x shoulder width; 140% of shoulder width was the widest stance in McCaw 1999, about 1.7x acromion width in Larsen 2021",
        "sources": [
          "mccaw1999",
          "larsen2021"
        ]
      },
      {
        "measure": "Toe-out (each foot)",
        "setup": "30°",
        "peak": "Unchanged; knee 1 cm outside the foot axis at the bottom",
        "norm": "About 30-45 degrees, matched to the knees (Lorenzetti 2018; Sinclair 2022)",
        "sources": [
          "lorenzetti2018",
          "sinclair2022"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈104°",
        "norm": "About 100-120 degrees at thighs parallel (clinical opinion; Larsen 2021 reported about 119-120 degrees in wide-stance loaded squats)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈2°",
        "peak": "≈111° (joint channel), thighs ≈44° out of the sagittal plane",
        "norm": "Not specified by the sources for this load and trunk angle",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈20° forward",
        "norm": "Upright to slightly forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell",
        "setup": "Held across by the handle in both hands, overhand, arms long",
        "peak": "28.4 cm above the floor at the lowest; ≥2.12 cm from the legs and trunk (rig shapes); hands 6.9-7.3 cm apart on the handle",
        "norm": "Held across by the handle, hanging at arm length between the legs (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "About 2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
