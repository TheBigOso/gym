    "id": "cable-seated-one-arm-concentration-curl",
    "name": "Cable Seated One Arm Concentration Curl",
    "aliases": [
      "Cable concentration curl",
      "Seated cable concentration curl",
      "Single-arm cable concentration curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14788",
      "title": "Cable Seated One Arm Concentration Curl",
      "url": "https://gymvisual.com/videos/14788-cable-seated-one-arm-concentration-curl.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment, so the movement was taken from the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "equipment": [
      "Cable machine (low pulley)",
      "D-handle",
      "Flat bench"
    ],
    "laterality": "Unilateral (right arm authored; switch sides)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "biceps_r"
      ],
      "synergist": [
        "forearm_extensors_r"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, 0.5 s squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12 per arm",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Cable stack load is user-chosen: pick a weight you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then one plate."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the end of a bench facing a low pulley, feet wide and flat. Take the D-handle in the right hand, lean forward and brace the back of the right upper arm against the inside of the right thigh; left hand on the left thigh."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the handle toward the right shoulder, palm up; the upper arm stays on the thigh."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze hard at the top for a moment."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the arm is straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arm straight with the cable still taut, repeat; then switch arms."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the elbow off the thigh or using the shoulder",
        "fix": "Keep the upper arm braced; only the forearm moves."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back and hunching over the handle",
        "fix": "Hinge from the hips with a long back."
      },
      {
        "id": "m3",
        "mistake": "Rocking the trunk back to lift",
        "fix": "Keep the trunk still; lighten the load."
      },
      {
        "id": "m4",
        "mistake": "Stopping short of a straight arm",
        "fix": "Lower all the way each rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈10° (arm nearly straight)",
        "peak": "≈127° at the squeeze",
        "norm": "Full range, from a straight arm to the forearm against the biceps (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "Palm forward / in (pron 20°)",
        "peak": "Palm up (pron -3°)",
        "norm": "Grip changes the biceps/brachioradialis share: the supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈7° from vertical (hanging, braced on the inner thigh)",
        "peak": "≈7° from vertical (does not move)",
        "norm": "Elbows stay near the sides; a small forward drift at the top is normal, a big swing shifts work to the front deltoid (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arm straight 0.6 s",
        "peak": "1.2 s up, 0.5 s squeeze, 2.4 s down, 1.3 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); the cable keeps tension on the biceps near the straight-arm end, where a dumbbell unloads (Parpa 2025 compared cable and dumbbell curls)",
        "sources": [
          "parpa2025"
        ]
      },
      {
        "measure": "Trunk lean (forward from vertical)",
        "setup": "≈48° forward from vertical",
        "peak": "Unchanged",
        "norm": "Hinge forward from the hips with a long back so the working arm hangs inside the thigh (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Low pulley 55 cm in front of the hand, 12 cm high, in line with it",
        "peak": "Clear of the body and legs by at least 11.87 cm",
        "norm": "Low pulley in front of the athlete, in line with the working hand, so the cable runs forward and down from the handle (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Seated One Arm Concentration Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/14788-cable-seated-one-arm-concentration-curl.html"
      },
      {
        "id": "ace2014",
        "title": "Young, Porcari, Camic, Kovacs and Foster 2014, ACE-sponsored EMG study of eight biceps exercises, University of Wisconsin-La Crosse (ACE ProSource, August 2014)",
        "url": "https://www.acefitness.org/prosourcearticle/4933/ace-study-reveals-best-biceps-exercises"
      },
      {
        "id": "parpa2025",
        "title": "Parpa, Vasiliou, Michaelides, Govindasamy, Chernov and Intziegianni 2025, biceps brachii EMG during traditional dumbbell versus Bayesian cable curls, with a review of curl EMG studies (Muscles 4:45)",
        "url": "https://knowledge.lancashire.ac.uk/id/eprint/57119/1/57119%20Parpa%20et%20al.%20VOR.pdf"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the load and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm); a bent-back wrist under load strains the forearm (clinical opinion).",
        "Take the handle from the pulley and return it with a straight back; do not let the stack yank the arm straight.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Lower-back discomfort in the lean: sit taller and brace the free hand on the thigh."
      ],
      "modify": [
        "Back discomfort: sit taller and use a lighter load.",
        "Elbow pain: neutral-grip (hammer) concentration curl with a rope end or a lighter load."
      ],
      "regressions": [
        "Lighter load.",
        "Dumbbell concentration curl."
      ],
      "progressions": [
        "Slower lowering (3-4 s).",
        "Pause 1-2 s at the top."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor; the concentration curl gave significantly higher biceps activity than seven other biceps exercises in the ACE study (ACE 2014), with the arm braced so it cannot swing.",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) assists elbow flexion, most with the forearm near neutral.",
      "forearm_flexors_r": "Wrist and finger flexors hold the handle and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder so the elbow stays by the side; it rises if the elbow drifts forward.",
      "ant_deltoid_l": "Steadies the shoulder so the elbow stays by the side; it rises if the elbow drifts forward.",
      "core": "Holds the forward-leaning trunk still.",
      "upper_traps_r": "Hold the shoulder girdle level under the handles.",
      "upper_traps_l": "Hold the shoulder girdle level under the handles.",
      "spinal_extensors_r": "Hold the flat back in the forward lean.",
      "spinal_extensors_l": "Hold the flat back in the forward lean."
    }
  },
