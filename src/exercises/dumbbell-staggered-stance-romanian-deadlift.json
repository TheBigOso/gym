    "bodyPart": "Thighs (hamstrings) and hips",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Lower back",
      "Forearms (grip)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip hinge)",
    "plane": "Sagittal",
    "laterality": "Unilateral bias (one leg works, the other steadies)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "hamstrings_r",
        "glute_max_r"
      ],
      "synergist": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "adductors_r",
        "hamstrings_l",
        "glute_max_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "forearm_flexors_r",
