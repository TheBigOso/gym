      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: shorten the range and keep the spine neutral; seek advice if pain persists."
      ],
      "modify": [
        "Back discomfort: shorten the range.",
        "Balance concerns: widen the feet sideways a little."
      ],
      "regressions": [
        "Dumbbell Romanian deadlift (both feet flat).",
        "Hip hinge with a dowel."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Single-leg dumbbell Romanian deadlift."
      ]
    },
    "muscleNotes": {
      "hamstrings_r": "Main target: the front-leg hamstrings lengthen under load as the hips travel back, then extend the hip to stand (clinical opinion; McCurdy 2025 on RDL hip flexion).",
      "hamstrings_l": "The back (kickstand) leg helps a little and steadies the hips (clinical opinion).",
      "glute_max_r": "Front-leg hip extensor, working hardest out of the bottom (clinical opinion).",
      "glute_max_l": "The back (kickstand) leg helps a little and steadies the hips (clinical opinion).",
      "spinal_extensors_r": "Hold the spine neutral; lumbar motion stayed about 7 degrees in the RDLs measured by McCurdy 2025.",
      "spinal_extensors_l": "Hold the spine neutral; lumbar motion stayed about 7 degrees in the RDLs measured by McCurdy 2025.",
      "adductors_r": "Adductor magnus assists hip extension.",
      "forearm_flexors_r": "Grip the dumbbells.",
      "forearm_flexors_l": "Grip the dumbbells.",
      "lats_r": "Keep the dumbbells close to the legs.",
      "lats_l": "Keep the dumbbells close to the legs.",
      "upper_traps_r": "Hold the shoulders against the pull of the dumbbells.",
      "upper_traps_l": "Hold the shoulders against the pull of the dumbbells.",
      "core": "Brace the trunk.",
      "glute_med_r": "Keeps the pelvis level and the front knee in line with most of the weight on one foot (clinical opinion)."
    }
