        "lats_l",
        "upper_traps_r",
        "upper_traps_l",
        "core"
      ],
      "lengthened": [
        "hamstrings_r"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the top, lower with the brace, breathe out as you stand.",
      "cadence": "About 2.2 s down, short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-1-1-1",
      "load": "User-chosen dumbbells; stop about 2 reps short of failure (RIR 2)",
      "frequency": "1-2 times a week",
      "progression": "Add load, then single-leg RDL"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Right foot flat; left foot back with its toes about level with or a little behind the right heel, heel up. Dumbbells in front of the thighs, palms facing you, front knee soft. Most of the weight on the right foot."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Push the hips back, keep the back flat and slide the dumbbells down the front of the legs; the back leg just steadies you."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop at about mid-shin, or where the right hamstrings are stretched with the back still flat."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the right hip forward to stand tall, dumbbells close to the legs."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall without leaning back; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shifting the weight onto the back foot",
        "fix": "Keep about 80% of the weight on the front foot; the back foot is a kickstand."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back",
        "fix": "Hinge only as far as the back stays flat."
      },
      {
        "id": "m3",
        "mistake": "Hips twisting open",
        "fix": "Keep both hip bones facing the floor at the bottom."
      },
      {
        "id": "m4",
        "mistake": "Bending the front knee into a squat",
        "fix": "Keep a soft, nearly constant knee bend; the hips move back, not down."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance",
        "setup": "Left ankle 32 cm behind the right, feet 20 cm apart sideways; left heel up on the ball of the foot",
        "peak": "Unchanged; left knee ≈72°",
        "norm": "Back foot toes about level with or a little behind the front heel, on the ball of the foot (common coaching)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈7°",
        "peak": "≈106° front hip (joint channel), trunk ≈20° above horizontal",
        "norm": "Peak hip flexion about 98-103 degrees in barbell and landmine RDLs (McCurdy 2025)",
        "sources": [
          "mccurdy2025"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈8°",
        "peak": "≈22° front knee",
        "norm": "Small, nearly constant soft knee bend, about 15-25 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar motion",
        "setup": "Neutral",
        "peak": "Spine channels -3°/0°/1° (L5/T12/T6): neutral",
        "norm": "Neutral spine; about 7 degrees of lumbar motion was measured in RDLs (McCurdy 2025)",
        "sources": [
          "mccurdy2025"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.2 s down to a handle height of 36.9 cm, 0.3 s pause, 1.3 s up, 1.4 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
