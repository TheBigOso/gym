    "id": "fire-hydrant",
    "name": "Fire Hydrant",
    "aliases": [
      "Bent leg side kick (kneeling)",
      "Quadruped hip abduction",
      "Kneeling hip abduction"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "303512",
      "title": "Bent Leg Side Kick (kneeling) (male)",
      "url": "https://gymvisual.com/videos/11666-bent-leg-side-kick-kneeling-male.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip abduction in flexion, knee bent)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_med_r"
      ],
      "synergist": [
        "glute_max_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "core",
        "obliques_r",
        "obliques_l",
        "serratus_r",
        "serratus_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the knee lifts out, inhale as it lowers.",
      "cadence": "About 1.2 s up, 0.6 s hold, 1.6 s down"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "12-20",
      "tempo": "1-1-1.5-0",
      "frequency": "2-4 times a week",
      "progression": "Pause at the top, then a mini band above the knees, then an ankle weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "On all fours: hands under the shoulders, knees under the hips, back flat, neck long."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and lift the bent right knee out to the side, shin level with the floor."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at the top; trunk still, weight evenly on both hands."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the knee back under the hip with control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Knee just touches the mat; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning the trunk away to lift the knee higher",
        "fix": "Keep the shoulders and hips level; lift only as high as the hip allows."
      },
      {
        "id": "m2",
        "mistake": "Foot rising above the knee",
        "fix": "Keep the shin level, knee bent 90 degrees."
      },
      {
        "id": "m3",
        "mistake": "Low back sagging",
        "fix": "Brace the abdomen; back flat."
      },
      {
        "id": "m4",
        "mistake": "Swinging the leg",
        "fix": "Lift in about a second, pause, lower slower."
      }
    ],
    "kinematics": [
      {
        "measure": "Hands and knees",
        "setup": "Hands under the shoulders, knees under the hips (hip 74°, knee 90°)",
        "peak": "Hands and the left knee stay planted",
        "norm": "Hands under the shoulders, knees under the hips (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip abduction",
        "setup": "≈2°",
        "peak": "44° channel (rig limit 45°); thigh ≈44° out from vertical, knee 11.8 cm up",
        "norm": "Thigh lifts out to the side as far as the hip allows without trunk lean (clinical opinion); the rig caps hip abduction at 45 degrees",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈90°",
        "peak": "≈90°, shin 0° from level",
        "norm": "About 90 degrees, shin level (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and trunk",
        "setup": "Trunk 74° from vertical",
        "peak": "Unchanged (pelvis fixed, no lean)",
        "norm": "Pelvis level, trunk still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s on all fours",
        "peak": "1.2 s up, 0.6 s pause, 1.6 s down",
        "norm": "About 1 s up, a short pause, 1.5-2 s down (clinical opinion)",
        "sources": []
      }
    ],
