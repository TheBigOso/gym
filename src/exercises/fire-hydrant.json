    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a mat or folded towel under the knees."
      ],
      "modify": [
        "Wrist discomfort: fists or forearms on the mat.",
        "Groin or hip pinch: lift less high."
      ],
      "regressions": [
        "Smaller lift.",
        "Side-lying clamshell."
      ],
      "progressions": [
        "Pause at the top.",
        "Mini band above the knees.",
        "Ankle weight."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Abducts the bent leg out to the side with the hip flexed. No EMG study of the quadruped version was found; the closest is the clam (abduction and external rotation with the hips flexed), which reached about 27% MVIC gluteus medius and 44% superior gluteus maximus with low TFL (Selkowitz 2013).",
      "glute_max_r": "Upper fibres assist abduction and external rotation in flexion (Selkowitz 2013 clam data; applying it here is clinical opinion).",
      "glute_med_l": "Support side: keeps the pelvis level (clinical opinion).",
      "core": "Stops the trunk leaning away from the lifting leg (clinical opinion).",
      "obliques_r": "Resist the trunk side-bending and rotating (clinical opinion).",
      "obliques_l": "Resist the trunk side-bending and rotating (clinical opinion).",
      "serratus_r": "Keeps the shoulder blades flat on the support arms (clinical opinion).",
      "serratus_l": "Keeps the shoulder blades flat on the support arms (clinical opinion).",
      "triceps_r": "Keep the support elbows straight (clinical opinion).",
      "triceps_l": "Keep the support elbows straight (clinical opinion)."
    }
