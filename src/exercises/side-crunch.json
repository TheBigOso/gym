{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-unisex-172-v1"
  },
  "exercise": {
    "id": "side-crunch",
    "name": "Side Crunch",
    "aliases": [
      "Side-lying crunch",
      "Lateral crunch",
      "Side-lying trunk lift"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "070812",
      "title": "Side Crunch",
      "url": "https://gymvisual.com/videos/1004-side-crunch.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (lateral flexion of the trunk)",
    "plane": "Frontal",
    "laterality": "Unilateral (one side at a time)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you lift the shoulders, inhale as you lower.",
      "cadence": "About 1 s up, a short squeeze, about 1.8 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 per side",
      "tempo": "About 1 s up, brief pause, 2 s down",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering and a 2 s hold, then the feet anchored (larger range) or a side plank"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your left side, hips stacked, knees slightly bent, top leg resting on the bottom one. Top fingertips behind the head, elbow wide; bottom hand resting on the mat in front of the chest."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and side-bend to lift both shoulders off the mat, bringing the top ribs toward the top hip."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Short squeeze at the top; stay on your side, chest facing forward, not rolling onto the back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the bottom shoulder touches down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest briefly; finish the set, then switch to the other side."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rolling back onto the shoulder blades",
        "fix": "Keep the hips stacked and the chest facing forward."
      },
      {
        "id": "m2",
        "mistake": "Pushing up with the bottom hand or pulling the head",
        "fix": "The bottom hand only balances; the top ribs lead the lift."
      },
      {
        "id": "m3",
        "mistake": "Swinging the legs to get up",
        "fix": "Legs stay heavy on the mat; reduce the range."
      },
      {
        "id": "m4",
        "mistake": "Dropping back down",
        "fix": "Lower for about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Lateral flexion (pelvis to upper back)",
        "setup": "≈0° (resting on the side)",
        "peak": "≈38° (lumbar ≈14°, thoracic ≈24°)",
        "norm": "Small range: the shoulders lift a few centimetres to a hand width (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder lift",
        "setup": "Bottom shoulder on the mat",
        "peak": "Bottom shoulder 21.1 cm up, top shoulder 13.4 cm up",
        "norm": "Bottom shoulder clears the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hips and knees",
        "setup": "Hips ≈25°, knees ≈35°, legs stacked",
        "peak": "Unchanged (pelvis and legs still)",
        "norm": "Hips stacked, knees slightly bent, legs still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Top hand behind the head, bottom hand resting on the mat in front of the chest",
        "peak": "Top elbow stays wide; the bottom hand only balances",
        "norm": "Top hand supports the head; the bottom hand only balances (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.1 s up, 0.6 s squeeze, 1.8 s down, 0.9 s rest",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #070812, Side Crunch, video (movement reference)",
        "url": "https://gymvisual.com/videos/1004-side-crunch.html"
      },
      {
        "id": "konrad2001",
        "title": "Konrad, Schmitz and Denner 2001, neuromuscular evaluation of trunk-training exercises (J Athl Train 36(2):109-118; PMC155519)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC155519"
      },
      {
        "id": "escamilla2016",
        "title": "Escamilla, Lewis, Pecson, Imamura and Andrews 2016, muscle activation among supine, prone and side position exercises with and without a Swiss ball (Sports Health 8(4):372-379; PMC4922527)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4922527"
      },
      {
        "id": "mcgill1996ql",
        "title": "McGill, Juker and Kropf, quantitative intramuscular myoelectric activity of quadratus lumborum during a wide variety of tasks (Clinical Biomechanics)",
        "url": "https://scilit.com/publications/dbf1681bb853bf9dcf2fd6d2c37728bd"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain with side bending: keep the range small or use a side plank on the knees instead (clinical opinion).",
        "Shoulder pain lying on the side: put a folded towel under the bottom shoulder or keep the bottom arm along the floor.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion work.",
        "The athlete mesh rests on the mat; the rig collision shapes are thicker than the mesh at the back and buttocks, so floorTolerance records how far those proxy shapes sink below the mat surface."
      ],
      "modify": [
        "Bottom arm along the floor or across the chest if the bottom shoulder is uncomfortable.",
        "Feet anchored under a support for a bigger range (harder)."
      ],
      "regressions": [
        "Side plank on the knees (hold).",
        "Smaller lift."
      ],
      "progressions": [
        "Slow 3 s lowering with a 2 s hold.",
        "Feet anchored side crunch.",
        "Side plank with hip dips."
      ]
    },
    "muscleNotes": {
      "obliques_r": "The top-side external and internal obliques bend the trunk sideways against gravity: side-lying lateral flexion with fixed legs gave about 98% MVC external oblique in Konrad 2001, and a side crunch on a Swiss ball about 50% MVIC external oblique (Escamilla 2016).",
      "obliques_l": "The top-side external and internal obliques bend the trunk sideways against gravity: side-lying lateral flexion with fixed legs gave about 98% MVC external oblique in Konrad 2001, and a side crunch on a Swiss ball about 50% MVIC external oblique (Escamilla 2016).",
      "core": "Rectus abdominis assists a little (about 21% MVIC upper rectus in the ball side crunch, Escamilla 2016).",
      "spinal_extensors_r": "Quadratus lumborum and the erector spinae on the top side help side-bend and keep the trunk from rolling; quadratus lumborum is a strong lateral stabiliser (McGill, Juker and Kropf).",
      "spinal_extensors_l": "Quadratus lumborum and the erector spinae on the top side help side-bend and keep the trunk from rolling; quadratus lumborum is a strong lateral stabiliser (McGill, Juker and Kropf).",
      "glute_med_r": "Holds the top hip steady so the pelvis does not roll back (clinical opinion).",
      "glute_med_l": "Holds the top hip steady so the pelvis does not roll back (clinical opinion)."
    }
  },
