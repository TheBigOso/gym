  "exercise": {
    "id": "hanging-straight-leg-raise",
    "name": "Hanging Straight Leg Raise",
    "aliases": [
      "Hanging L raise",
      "Strict hanging leg raise",
      "Hanging leg raise to level"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "2948",
      "title": "Hanging Straight Leg Raise",
      "url": "https://gymvisual.com/videos/2948-hanging-straight-leg-raise.html",
      "listing": "Video (movement reference; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Forearms (grip)",
      "Back (lats)",
      "Thighs (quadriceps)"
    ],
    "equipment": [
      "Pull-up bar"
    ],
    "difficulty": "Advanced",
    "mechanics": "Isolation (straight-leg hip flexion to level, hanging, pelvis braced)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "lats_r",
        "lats_l",
        "serratus_r",
        "serratus_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the legs rise, in on the way down.",
      "cadence": "About 1.6 s up, 2.2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-10",
      "tempo": "About 1.5 s up, short hold at level, 2 s down",
      "load": "Body weight",
      "frequency": "2-3 times a week",
      "progression": "Longer hold at level (L-hang), then raise past level with a pelvic curl (hanging leg hip raise)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hang from the bar, hands a little wider than the shoulders, legs straight and together."
      },
      {
        "id": "c2",
        "phase": "set",
        "text": "Shoulders down, ribs down, brace."
      },
      {
        "id": "c3",
        "phase": "raise",
        "text": "Lift the straight legs in front until they are level with the hips; knees locked, toes pointed."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Hold the L for a moment without swinging."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Lower slowly to the hang; stop the swing before the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the knees as the legs rise",
        "fix": "Keep the knees straight; use the knee raise if needed."
      },
      {
        "id": "m2",
        "mistake": "Swinging into the lift",
        "fix": "Start still and lower slowly."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back in the hang",
        "fix": "Brace before each rep."
      },
      {
        "id": "m4",
        "mistake": "Shrugging",
        "fix": "Keep the shoulder blades set down."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈3° in the dead hang",
        "peak": "≈90° at the top",
        "norm": "From about neutral to about 90 degrees, legs level (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Legs from horizontal",
        "setup": "-89° (hanging)",
        "peak": "4° (hip-to-ankle line; 0 = level)",
        "norm": "About level at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knees",
        "setup": "Straight (≈6°)",
        "peak": "Straight (≈4°)",
        "norm": "Straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "Neutral",
        "peak": "Braced, little curl (10° of spinal flexion); centre of mass within 0.4 cm of the hands",
        "norm": "Braced; a hanging straight-leg raise loads the spine heavily (Axler and McGill 1997)",
        "sources": [
          "axler1997"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s, set 0.3 s",
        "peak": "1.2 s up, 0.4 s hold, 2.5 s down",
        "norm": "About 1.5 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 2948, Hanging Straight Leg Raise, video (movement reference)",
