        "biceps_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale on the way down, exhale on the way up.",
      "cadence": "About 1.8 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "8-15",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbell, a 2 s pause at the bottom, then a front-foot-elevated or rear-foot-elevated split squat. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Long split stance, front foot flat, back heel up. Hold one dumbbell upright against the chest, hands cupping the top plate, elbows down."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and drop the back knee straight down toward the floor, chest tall behind the dumbbell."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Both knees about 90 degrees, back knee just above the floor, front knee over the foot."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive through the front foot to come up."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the split stance, reset, repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dumbbell drifting off the chest",
        "fix": "Keep it touching the sternum, elbows under it."
      },
      {
        "id": "m2",
        "mistake": "Front knee caving inward",
        "fix": "Keep the front knee over the second toe."
      },
      {
        "id": "m3",
        "mistake": "Stance too short",
        "fix": "Lengthen the stance so both knees reach about 90 degrees at the bottom."
      },
      {
        "id": "m4",
        "mistake": "Leaning forward over the front leg",
        "fix": "Stay tall; the front-loaded dumbbell helps keep the trunk upright."
      }
    ],
    "kinematics": [
      {
        "measure": "Step length (ankle centres)",
        "setup": "80 cm between ankle centres, feet 18 cm apart sideways",
        "peak": "Unchanged",
        "norm": "Front knee about over the front foot at the bottom (common guideline); a step about one leg length was suggested as optimal for strength training (Song 2023)",
        "sources": [
          "song2023"
        ]
      },
      {
        "measure": "Front knee flexion",
        "setup": "≈22°",
        "peak": "≈92°",
        "norm": "About 90 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Back knee",
        "setup": "≈33°",
        "peak": "≈94°, 13 cm above the floor (knee joint centre)",
        "norm": "Lowers to just above the floor, about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈3°",
        "peak": "≈1°",
        "norm": "Fairly upright; the load held in front helps keep the chest up (clinical opinion). Upright to slightly forward; more lean shifts work to the hip extensors (Farrokhi 2008)",
        "sources": [
          "farrokhi2008"
        ]
      },
      {
        "measure": "Dumbbell",
        "setup": "Upright at the sternum, hands cupping the top plate",
        "peak": "Stays at the chest, clear of the front thigh (≥2.84 cm on the rig shapes)",
        "norm": "Held upright at the sternum, elbows down (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s reset",
        "norm": "Controlled, about 1-2 s down and 1 s up (clinical opinion)",
        "sources": []
      }
    ],
