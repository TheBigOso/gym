    "id": "dumbbell-rear-delt-fly",
    "name": "Dumbbell Rear Delt Fly",
    "aliases": [
      "Bent-over dumbbell reverse fly",
      "Rear delt raise",
      "Bent-over lateral raise",
      "Dumbbell rear fly"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "037812",
      "title": "Dumbbell Rear Fly",
      "url": "https://gymvisual.com/videos/5049-dumbbell-rear-fly.html",
      "listing": "Video; data sheet: body part Shoulders, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (posterior deltoid)",
    "secondaryBodyParts": [
      "Upper back (rhomboids, mid trapezius)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (shoulder horizontal abduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "hamstrings_r",
        "hamstrings_l",
        "glute_max_r",
        "glute_max_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise the arms, breathe in as you lower; keep the trunk braced.",
      "cadence": "About 1.5 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0.5-1.5-0 (down-squeeze-up-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbells; light, so the back stays flat",
      "progression": "Add reps, then weight; chest-supported rear fly on an incline bench"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet hip width, knees soft, hinge at the hips until the trunk is nearly parallel to the floor with a flat back. Dumbbells hang under the shoulders, palms facing each other."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and sweep the arms out to the sides with soft elbows, leading with the backs of the hands."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms about level with the back; squeeze the shoulder blades together briefly."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly back under the shoulders; keep the trunk still."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the hinge, reset and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back",
        "fix": "Push the hips back, keep the chest long; stand a little more upright if needed."
      },
      {
        "id": "m2",
        "mistake": "Rowing (bending the elbows a lot and pulling back)",
        "fix": "Keep the elbow bend fixed and move the arms out to the sides."
      },
      {
        "id": "m3",
        "mistake": "Jerking the trunk up to swing the weights",
        "fix": "Keep the trunk still; use lighter dumbbells."
      },
      {
        "id": "m4",
        "mistake": "Shrugging toward the ears",
        "fix": "Draw the shoulder blades back and down."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk inclination",
        "setup": "≈17° above horizontal (≈73° from vertical)",
        "peak": "unchanged",
        "norm": "Nearly parallel to the floor, flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Horizontal abduction",
        "setup": "arms hanging (upper arm ≈11° from vertical)",
        "peak": "upper arm ≈106° from vertical, about level with the back",
        "norm": "From arms hanging to about level with the back; prone horizontal abduction tested at about 100 degrees of abduction (Reinold 2007)",
        "sources": [
          "reinold2007"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈16°",
        "peak": "≈20°",
        "norm": "Slight, fixed bend (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "neutral, palms facing each other",
        "peak": "palms down, thumbs toward the head",
        "norm": "Neutral (palms facing each other) gave more posterior deltoid and infraspinatus activity than pronated (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈24°",
        "peak": "unchanged",
        "norm": "Soft knees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold the hinge 0.8 s",
        "peak": "1.5 s up, 0.5 s squeeze, 2.0 s down",
        "norm": "Controlled, no swing (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #037812, Dumbbell Rear Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/5049-dumbbell-rear-fly.html"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "reinold2007",
        "title": "Reinold et al. 2007, electromyographic analysis of the supraspinatus and deltoid muscles during 3 common rehabilitation exercises (J Athl Train 42(4):464-469)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2140071/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The bent-over position loads the low back; keep the back flat and the weights light."
      ],
      "modify": [
        "Low-back discomfort: do it chest-supported, lying face down on an incline bench, or seated bent over the end of a bench.",
        "Hamstring tightness: bend the knees more."
      ],
      "regressions": [
        "Chest-supported rear delt fly on an incline bench.",
        "Seated bent-over rear delt fly.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Slower 3 s lowering with a 1 s squeeze.",
        "Cable or band reverse fly."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover (horizontal abduction). A neutral grip gave more posterior deltoid activity than a pronated grip on a reverse fly (Schoenfeld 2013); prone horizontal abduction reached about 87% MVIC in the posterior deltoid (Reinold 2007).",
      "post_deltoid_l": "Prime mover (horizontal abduction). A neutral grip gave more posterior deltoid activity than a pronated grip on a reverse fly (Schoenfeld 2013); prone horizontal abduction reached about 87% MVIC in the posterior deltoid (Reinold 2007).",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together at the top.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together at the top.",
      "infraspinatus_r": "External rotator that works with the posterior deltoid; higher with a neutral grip (Schoenfeld 2013).",
      "infraspinatus_l": "External rotator that works with the posterior deltoid; higher with a neutral grip (Schoenfeld 2013).",
      "lat_deltoid_r": "Helps lift the arm; prone horizontal abduction also gave about 63% MVIC in the middle deltoid (Reinold 2007).",
      "lat_deltoid_l": "Helps lift the arm; prone horizontal abduction also gave about 63% MVIC in the middle deltoid (Reinold 2007).",
      "spinal_extensors_r": "Hold the flat back in the hip hinge for the whole set.",
      "spinal_extensors_l": "Hold the flat back in the hip hinge for the whole set.",
      "hamstrings_r": "Hold the hinge at the hips with the knees soft.",
      "hamstrings_l": "Hold the hinge at the hips with the knees soft.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Keeps the trunk still so the arms do the work."
    }
  },
