    "breathing": {
      "pattern": "Inhale as the dumbbells lower behind the head, exhale as you straighten the arms.",
      "cadence": "About 2.3 s down, short pause, about 1.4 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "load": "Dumbbell load is user-chosen: pick a weight you can control through the full range for every rep with 1-3 reps in reserve (RPE 7-9). Expect to use less than for pushdowns: overhead loads were 34-39% lower in the training study (PubMed 35819335).",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "progression": "More reps, then heavier dumbbells"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width; press a dumbbell in each hand overhead, palms facing each other, arms beside the head."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend the elbows, lowering the dumbbells behind the head; elbows point up."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbells behind the head, upper arms still beside the ears."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbows, pressing the dumbbells back up."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked; ribs down; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows pointing up, about shoulder width apart."
      },
      {
        "id": "m2",
        "mistake": "Dumbbells knocking together behind the head",
        "fix": "Keep the hands a little apart and lower in line with the forearms."
      },
      {
        "id": "m3",
        "mistake": "Lower back arching",
        "fix": "Brace and squeeze the glutes; go lighter."
      },
      {
        "id": "m4",
        "mistake": "Turning it into a press (upper arms moving)",
        "fix": "Only the forearms move."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (straight, not locked)",
        "peak": "≈112° at the bottom",
        "norm": "Straight but not locked at the top; lower until the dumbbell is behind the head, about 100-120 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation (upper arm)",
        "setup": "≈170° from the trunk line, elbows 32 cm apart",
        "peak": "Unchanged (upper arm drifts at most 0.0° over the loop)",
        "norm": "Upper arm overhead beside the head and still: the long head works lengthened, which gave more triceps growth than training with the arm at the side (PubMed 35819335)",
        "sources": [
          "overhead2022"
        ]
      },
      {
        "measure": "Dumbbell clearance",
        "setup": "Dumbbells overhead",
        "peak": "8.6 cm behind the head at the closest, 8 cm above the upper back (rig shapes)",
        "norm": "The dumbbell passes behind the head without touching it (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hand spacing",
        "setup": "Wrists 23 cm apart, palms facing each other",
        "peak": "Dumbbells 3.7 cm apart at the closest",
        "norm": "Palms facing each other, hands about head width apart so the dumbbells do not touch (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.3 s down, 0.3 s pause, 1.4 s up, 0.6 s at the top",
        "norm": "Controlled, about 2 s lowering and 1-1.5 s pressing (clinical opinion); the training study used 5 sets of 10 at 70% 1RM, twice a week (PubMed 35819335)",
        "sources": [
          "overhead2022"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #622112, Dumbbell Standing French Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/15558-dumbbell-standing-french-press.html"
      },
      {
        "id": "overhead2022",
        "title": "Triceps brachii hypertrophy is substantially greater after elbow extension training performed in the overhead versus neutral arm position (Eur J Sport Sci 2022, DOI 10.1080/17461391.2022.2100279; PubMed 35819335; 21 adults, 12 weeks, cable)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/35819335/"
      },
      {
        "id": "ace2011",
        "title": "Boehler, Porcari, Kline, Hendrix and Foster, ACE-sponsored research: best triceps exercises (American Council on Exercise; University of Wisconsin-La Crosse, 15 trained women, triceps EMG relative to the triangle push-up)",
        "url": "https://www.acefitness.org/certifiednewsarticle/1562/ace-study-identifies-best-triceps-exercises/"
      }
    ],
    "safety": {
      "cautions": [
        "Shoulder pain overhead: shorten the range or switch to a lying or cable extension (clinical opinion).",
        "Elbow pain: use a lighter dumbbell and a slower lowering.",
        "Get the dumbbells overhead one at a time from the shoulders, and lower them to the shoulders at the end of the set.",
        "Lower back pain: do it seated against a back pad.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Seated version.",
        "One dumbbell held in both hands (two-hand overhead extension)."
      ],
      "regressions": [
        "Lighter dumbbells, partial range.",
        "Seated version."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Slower lowering (3 s).",
        "EZ-bar French press."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Holds the upper arm up beside the head (clinical opinion).",
      "ant_deltoid_l": "Holds the upper arm up beside the head (clinical opinion).",
      "lat_deltoid_r": "Helps hold the arm overhead (clinical opinion).",
      "lat_deltoid_l": "Helps hold the arm overhead (clinical opinion).",
      "upper_traps_r": "Rotates the shoulder blade upward to keep the arm overhead (clinical opinion).",
      "upper_traps_l": "Rotates the shoulder blade upward to keep the arm overhead (clinical opinion).",
      "serratus_r": "Works with the upper trapezius to hold the shoulder blade in upward rotation (clinical opinion).",
      "serratus_l": "Works with the upper trapezius to hold the shoulder blade in upward rotation (clinical opinion).",
      "forearm_flexors_r": "Grip each handle with the palms facing each other.",
      "forearm_flexors_l": "Grip each handle with the palms facing each other.",
      "core": "Standing, the trunk muscles keep the ribs down and the lower back from arching under the overhead load (clinical opinion).",
      "triceps_r": "Straightens the elbow with the arm overhead, where the long head is lengthened. Twelve weeks of overhead cable extensions grew the long head (+28.5% vs +19.6%) and the whole triceps (+19.9% vs +13.9%) more than the same training with the arm at the side, despite 34-39% lighter loads (Eur J Sport Sci 2022, PubMed 35819335). Overhead extensions reached 76% of the triangle push-up's triceps EMG in the ACE study (Boehler et al.). With a dumbbell in each hand, each arm works on its own (clinical opinion).",
      "triceps_l": "Straightens the elbow with the arm overhead, where the long head is lengthened. Twelve weeks of overhead cable extensions grew the long head (+28.5% vs +19.6%) and the whole triceps (+19.9% vs +13.9%) more than the same training with the arm at the side, despite 34-39% lighter loads (Eur J Sport Sci 2022, PubMed 35819335). Overhead extensions reached 76% of the triangle push-up's triceps EMG in the ACE study (Boehler et al.). With a dumbbell in each hand, each arm works on its own (clinical opinion)."
    }
