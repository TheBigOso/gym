      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Lower back and hips",
    "secondaryBodyParts": [
      "Glutes",
      "Hamstrings"
    ],
    "equipment": [
      "Body weight",
      "45-degree hyperextension bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip and lumbar spine)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "core",
        "calves_r",
        "calves_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you rise.",
      "cadence": "About 2 s down, short pause, about 1.8 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "2-0-2-1",
      "frequency": "2-3 times a week",
      "progression": "More reps, then hold a plate against the chest; keep the top at the body line"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the pad so its top edge sits just below the hip crease; heels under the roller, soles on the plate, body in one straight line, fingertips behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and hinge at the hips, letting the back round a little as the trunk goes down toward the floor."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with the trunk pointing about straight down; the thighs stay on the pad."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out, squeeze the glutes and lift the trunk back up until the body is in one line."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stop at the line; do not arch the lower back past it. Repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching far past the straight line at the top",
        "fix": "Stop when the body is in one line; extra arching loads the lower back without adding to the exercise (McGill 1998)."
      },
      {
        "id": "m2",
        "mistake": "Pad set too high (on the stomach)",
        "fix": "Lower the pad so the hips can hinge over its top edge."
      },
      {
        "id": "m3",
        "mistake": "Swinging up fast",
        "fix": "Rise in about 2 s and pause at the top."
      },
      {
        "id": "m4",
        "mistake": "Pulling on the head with the hands",
        "fix": "Fingertips only rest behind the head; or cross the arms over the chest."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈-1° (body in one line along the 45° bench)",
        "peak": "≈83° at the bottom",
        "norm": "The hips hinge over the pad; the 45-degree hip extension was among the exercises that strongly engaged the hamstrings, especially the biceps femoris long head (Bourne 2017)",
        "sources": [
          "bourne2017"
        ]
      },
      {
        "measure": "Lumbar flexion",
        "setup": "0° (neutral, no arching past the line)",
        "peak": "≈20° (L5 and T12 segments) at the bottom",
        "norm": "Some rounding at the bottom is normal; avoid arching past neutral at the top (clinical opinion; McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Trunk to the leg line",
        "setup": "≈5°",
        "peak": "≈94° (trunk ≈41° from straight down)",
        "norm": "In line at the top, about straight down at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip pad",
        "setup": "Pad top edge 16 cm below the hip joints along the leg line (74.2 cm from the foot plate); thighs on the pad",
        "peak": "Hip joints move ≤0 cm; thigh-to-pad gap -0.2 to -0.2 cm",
        "norm": "Top edge just below the hip crease so the hips can hinge (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Body in line 0.6 s",
        "peak": "2.0 s down, 0.3 s pause, 1.8 s up, 0.7 s in line",
        "norm": "Controlled, about 2 s down and 2 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #048913, Hyperextension, animated GIF (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/1988-hyperextension.html"
      },
      {
        "id": "bourne2017",
        "title": "Bourne, Williams, Opar, Al Najjar, Kerr & Shield 2017, impact of exercise selection on hamstring muscle activation (Br J Sports Med; PubMed 27467123)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/27467123/"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Lower back: stop at the body line; arching past it compresses the lumbar spine (McGill 1998). Skip it with an acute back flare-up.",
        "Set the pad so it supports the thighs, not the stomach, and lock the heel roller before starting.",
        "Get on and off the bench carefully; the trunk hangs head-down at the bottom.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Arms crossed over the chest (easier lever).",
        "Shorter range: stop with the trunk at about 45 degrees below the line."
      ],
      "regressions": [
        "Prone floor back extension.",
        "Glute bridge."
      ],
      "progressions": [
        "Hold a plate against the chest.",
        "Pause 2 s at the line.",
        "Single-leg version."
      ]
    },
    "muscleNotes": {
      "spinal_extensors_r": "Erector spinae lift the trunk and control the rounding at the bottom (clinical opinion; McGill 1998).",
      "glute_max_r": "Extends the hip to bring the trunk back to the line (clinical opinion).",
      "hamstrings_r": "Hip extensors; the 45-degree hip extension strongly engaged the biceps femoris long head (Bourne 2017).",
      "adductors_r": "Adductor magnus helps extend the hip (clinical opinion).",
      "calves_r": "Hold the heels against the roller.",
      "rhomboids_midtrap_r": "Keep the elbows open behind the head.",
      "spinal_extensors_l": "Erector spinae lift the trunk and control the rounding at the bottom (clinical opinion; McGill 1998).",
      "glute_max_l": "Extends the hip to bring the trunk back to the line (clinical opinion).",
      "hamstrings_l": "Hip extensors; the 45-degree hip extension strongly engaged the biceps femoris long head (Bourne 2017).",
      "adductors_l": "Adductor magnus helps extend the hip (clinical opinion).",
      "calves_l": "Hold the heels against the roller.",
      "rhomboids_midtrap_l": "Keep the elbows open behind the head.",
      "core": "Controls the trunk through the hinge."
    }
  },
