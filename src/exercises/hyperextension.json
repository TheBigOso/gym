    "id": "hyperextension",
    "name": "Hyperextension (45-Degree Back Extension)",
    "aliases": [
      "45-degree back extension",
      "Back extension",
      "Roman chair back extension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "048913",
      "title": "Hyperextension",
