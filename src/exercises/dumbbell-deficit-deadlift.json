      "listing": "Video; data sheet: body part Hips, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes) and thighs",
    "secondaryBodyParts": [
      "Hamstrings",
      "Lower back",
      "Forearms (grip)",
      "Upper back"
    ],
    "equipment": [
      "Dumbbell",
      "Low step or plate"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip and knee extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "upper_traps_r",
        "upper_traps_l",
        "lats_r",
        "lats_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace at the top, hold the brace down and up, breathe out at the top.",
      "cadence": "About 2.2 s down, light touch, 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "5-8",
      "tempo": "2-0-1-1",
      "load": "User-chosen dumbbells, a little lighter than your normal dumbbell deadlift; stop about 2 reps short of failure (RIR 2)",
      "frequency": "1 time a week",
      "progression": "Add load before raising the step"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on a low, stable step, feet hip width, a dumbbell beside each foot, palms facing in."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Push the hips back and bend the knees, back flat, until the dumbbells pass the top of the step."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Let the dumbbells pass just below the top of the step; keep the brace and the flat back."
      },
      {
        "id": "c4",
        "phase": "lift",
        "text": "Push the step away and stand tall, hips and shoulders rising together."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Finish tall without leaning back; breathe and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back to use the extra range",
        "fix": "Use a lower step or stop higher; the deficit is only useful with a flat back."
      },
      {
        "id": "m2",
        "mistake": "Standing on a wobbly or narrow surface",
        "fix": "Use a solid step wide enough for both feet."
      },
      {
        "id": "m3",
        "mistake": "Hips shooting up first",
        "fix": "Raise the hips and shoulders together."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈0°",
        "peak": "≈138° (joint channel), trunk ≈31° from vertical, spine neutral",
        "norm": "Greater starting hip flexion and range than the conventional deadlift (Rogacion 2024)",
        "sources": [
          "rogacion2024"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈4°",
        "peak": "≈130° at the bottom",
        "norm": "Greater starting knee flexion and range than the conventional deadlift (Rogacion 2024)",
        "sources": [
          "rogacion2024"
        ]
      },
      {
        "measure": "Deficit height",
        "setup": "10 cm step",
        "peak": "Dumbbells about 3.5 cm below the step top at the bottom (hip flexion is held inside the rig's 140° limit, which caps the extra range)",
        "norm": "A low step, about 10 cm (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.2 s down, 0.3 s at the bottom, 1.3 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #1169912, Dumbbell Deadlift from Deficit (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/25225-dumbbell-deadlift-from-deficit-male.html"
      },
      {
        "id": "rogacion2024",
        "title": "Rogacion, Schick, Cotter & Valenzuela 2024, differences in joint kinematics and electromyography activity among the conventional, block, and deficit deadlifts (Int J Exerc Sci Conf Proc 14(4))",
        "url": "https://digitalcommons.wku.edu/ijesab/vol14/iss4/68"
      },
      {
        "id": "swinton2011",
        "title": "Swinton et al. 2011, a biomechanical analysis of straight and hexagonal barbell deadlifts using submaximal loads (J Strength Cond Res 25(7):2000-2009)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21659894/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "The dumbbell load is your choice: pick a weight you can move with the form shown for every rep.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: master the floor deadlift first and keep the back flat; seek advice if pain persists.",
        "Make sure the step cannot slide or tip."
      ],
      "modify": [
        "Limited hip or ankle mobility: use a lower step or none."
      ],
      "regressions": [
        "Dumbbell deadlift from the floor.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Slightly higher step.",
        "Pause just off the floor."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Hip extensor; peak gluteus maximus activity was higher in the deficit than the conventional deadlift (Rogacion 2024).",
      "glute_max_l": "Hip extensor; peak gluteus maximus activity was higher in the deficit than the conventional deadlift (Rogacion 2024).",
      "quads_r": "The deeper start bends the knees more; peak vastus lateralis activity was higher in the deficit deadlift (Rogacion 2024). Dumbbells beside the feet, like a hex bar, load the knees more than a straight bar (Swinton 2011).",
      "quads_l": "The deeper start bends the knees more; peak vastus lateralis activity was higher in the deficit deadlift (Rogacion 2024). Dumbbells beside the feet, like a hex bar, load the knees more than a straight bar (Swinton 2011).",
      "hamstrings_r": "Hip extensors with the glutes; biceps femoris peaked higher than in a block (raised) deadlift (Rogacion 2024).",
      "hamstrings_l": "Hip extensors with the glutes; biceps femoris peaked higher than in a block (raised) deadlift (Rogacion 2024).",
      "spinal_extensors_r": "Keep the back flat through the longer range; erector spinae activity did not differ between deficit, block and conventional deadlifts (Rogacion 2024).",
      "spinal_extensors_l": "Keep the back flat through the longer range; erector spinae activity did not differ between deficit, block and conventional deadlifts (Rogacion 2024).",
      "adductors_r": "Adductor magnus assists hip extension.",
      "adductors_l": "Adductor magnus assists hip extension.",
      "forearm_flexors_r": "Grip the dumbbells.",
      "forearm_flexors_l": "Grip the dumbbells.",
      "upper_traps_r": "Hold the shoulders against the pull of the dumbbells.",
      "upper_traps_l": "Hold the shoulders against the pull of the dumbbells.",
      "lats_r": "Keep the arms close to the body.",
      "lats_l": "Keep the arms close to the body.",
      "core": "Brace the trunk."
    }
