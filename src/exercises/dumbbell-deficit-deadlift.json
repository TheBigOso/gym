    "id": "dumbbell-deficit-deadlift",
    "name": "Dumbbell Deficit Deadlift",
    "aliases": [
      "Dumbbell deadlift from a deficit",
      "Dumbbell deadlift on a step",
      "Elevated dumbbell deadlift"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "1169912",
      "title": "Dumbbell Deadlift from Deficit (male)",
