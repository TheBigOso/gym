    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Wrist pain: hands on fists or on a low step.",
        "Knee pain when kneeling: fold the mat under the knees."
      ],
      "modify": [
        "Lift only the leg, or only the arm, first (lower load: single-leg raise under 2,500 N of lumbar compression, McGill 1998).",
        "Shorten the reach."
      ],
      "regressions": [
        "Quadruped single-leg raise.",
        "Quadruped single-arm raise."
      ],
      "progressions": [
        "Longer holds.",
        "Hand and foot draw small squares.",
        "Ankle or wrist weights."
      ]
    },
    "muscleNotes": {
      "spinal_extensors_r": "Hold the spine neutral against the lifted limbs. Opposite arm and leg raise: about 27% MVC lumbar extensors on one side and 45% thoracic extensors on the other (McGill 1998); 23-46% MVC multifidus and 24-38% iliocostalis (Kelly 2016).",
      "spinal_extensors_l": "Hold the spine neutral against the lifted limbs. Opposite arm and leg raise: about 27% MVC lumbar extensors on one side and 45% thoracic extensors on the other (McGill 1998); 23-46% MVC multifidus and 24-38% iliocostalis (Kelly 2016).",
      "glute_max_r": "Extends the lifted leg to horizontal. The quadruped arm and leg lift was among the exercises suggested for gluteus maximus strengthening (above 45% MVIC, Ekstrom 2007); gluteus maximus peaked with ipsilateral leg elevation (Arch Phys Med Rehabil 2001).",
      "glute_max_l": "Extends the lifted leg to horizontal. The quadruped arm and leg lift was among the exercises suggested for gluteus maximus strengthening (above 45% MVIC, Ekstrom 2007); gluteus maximus peaked with ipsilateral leg elevation (Arch Phys Med Rehabil 2001).",
      "hamstrings_r": "Help extend the lifted hip.",
      "hamstrings_l": "Help extend the lifted hip.",
      "ant_deltoid_r": "Raises the reaching arm to horizontal.",
      "ant_deltoid_l": "Raises the reaching arm to horizontal.",
      "rhomboids_midtrap_r": "Set the shoulder blade of the reaching arm (lower trapezius in particular; clinical opinion).",
      "rhomboids_midtrap_l": "Set the shoulder blade of the reaching arm (lower trapezius in particular; clinical opinion).",
      "core": "Abdominals keep the low back from sagging and the pelvis from rotating; oblique activity exceeded rectus abdominis in the quadruped exercise (Arch Phys Med Rehabil 2001).",
      "obliques_r": "Resist the pelvis and trunk rotating toward the lifted leg.",
      "obliques_l": "Resist the pelvis and trunk rotating toward the lifted leg.",
      "glute_med_r": "Supporting-side hip abductors keep the pelvis level over the support knee.",
      "glute_med_l": "Supporting-side hip abductors keep the pelvis level over the support knee.",
      "serratus_r": "Supporting-arm serratus keeps the chest from sinking between the shoulder blades.",
      "serratus_l": "Supporting-arm serratus keeps the chest from sinking between the shoulder blades.",
      "triceps_r": "Keeps the supporting elbow straight (clinical opinion).",
      "triceps_l": "Keeps the supporting elbow straight (clinical opinion)."
    }
  },
