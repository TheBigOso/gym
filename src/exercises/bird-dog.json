        "serratus_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the arm and leg reach out, breathe lightly in the hold, inhale as they return.",
      "cadence": "About 1.2 s out, 1.5 s hold, 1.1 s back per side"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-10 per side, alternating",
      "tempo": "1-2 s out, hold, 1 s back",
      "holds": "About 2 s here; longer holds of up to about 10 s are common in rehab (clinical opinion)",
      "frequency": "Daily to 3 times a week (low load)",
      "progression": "Longer holds, then draw squares with the hand and foot, then add an ankle weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hands under the shoulders, knees under the hips, back flat, neck long."
      },
      {
        "id": "c2",
        "phase": "extendR",
        "text": "Brace and reach the right arm forward and the left leg back to horizontal."
      },
      {
        "id": "c3",
        "phase": "holdR",
        "text": "Hold; hips square and level, no low-back arch."
      },
      {
        "id": "c4",
        "phase": "returnR",
        "text": "Bring the hand and knee back to the mat under control."
      },
      {
        "id": "c5",
        "phase": "extendL",
        "text": "Now the left arm forward and the right leg back."
      },
      {
        "id": "c6",
        "phase": "holdL",
        "text": "Hold; reach long through the fingers and the heel."
      },
      {
        "id": "c7",
        "phase": "returnL",
        "text": "Return to all fours."
      },
      {
        "id": "c8",
        "phase": "reset",
        "text": "Reset the flat back, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching as the leg lifts",
        "fix": "Lift the leg only to hip height; brace the stomach."
      },
      {
        "id": "m2",
        "mistake": "Hips rotating open toward the lifted leg",
        "fix": "Keep both hip bones pointing at the mat."
      },
      {
        "id": "m3",
        "mistake": "Rushing",
        "fix": "Move slowly and hold the end position."
      },
      {
        "id": "m4",
        "mistake": "Head lifting",
        "fix": "Look at the mat between the hands."
      }
    ],
    "kinematics": [
      {
        "measure": "Hands and knees",
        "setup": "Hands 6 cm behind the shoulder joints (rig), knees under the hips (hip ≈74°, knee ≈90°)",
        "peak": "Supporting hand and knee stay planted (elbow ≈35°)",
        "norm": "Hands under the shoulders, knees under the hips (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arm elevation (reaching arm)",
        "setup": "≈64° to the trunk (hand on the mat)",
        "peak": "≈162° (arm level)",
        "norm": "Arm level with the trunk, about 180 degrees of shoulder flexion relative to the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension (lifted leg)",
        "setup": "Hip ≈74° flexion",
        "peak": "Hip ≈-14° (leg level, ≈20° off the inclined trunk line), knee ≈4°",
        "norm": "Leg level with the trunk, not higher, so the lumbar spine stays neutral (McGill 1998 cue; clinical opinion)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Pelvis and trunk",
        "setup": "Trunk ≈20° from level, neutral spine",
        "peak": "Pelvis and trunk unchanged (pelvis fixed, no rotation)",
        "norm": "Neutral spine, pelvis level; opposite arm and leg raise loads the lumbar spine with a little over 3,000 N (McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s on all fours",
        "peak": "1.2 s out, 1.5 s hold, 1.1 s back per side",
        "norm": "Slow, about 2 s holds here (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
