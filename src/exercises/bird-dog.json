    ],
    "difficulty": "Beginner",
    "mechanics": "Compound, stability (anti-rotation and anti-extension)",
    "plane": "Sagittal",
    "laterality": "Alternating (both sides in one loop)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "spinal_extensors_r",
        "spinal_extensors_l",
