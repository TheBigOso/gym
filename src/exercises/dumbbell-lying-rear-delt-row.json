    "bodyPart": "Shoulders (rear deltoid)",
    "secondaryBodyParts": [
      "Upper back (rhomboids, middle trapezius)",
      "Rotator cuff"
    ],
    "equipment": [
      "Dumbbell",
      "Flat bench (raised)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "lat_deltoid_r",
        "lat_deltoid_l",
        "biceps_r",
        "biceps_l"
      ],
      "stabilizer": [
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull the elbows up and out, breathe in as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1-0.5-2-0.5 (up-squeeze-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-3 times a week",
      "load": "User-chosen dumbbells; lighter than for a regular bent-over row (clinical opinion)",
      "progression": "Add reps, then weight; slower lowering; chest-supported version to remove the low-back demand"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down on a high flat bench with the chin just past the end, legs straddling the bench, balls of the feet on the floor. Dumbbells hang under the shoulders, palms facing your feet."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and pull the elbows up and out to the sides, wide of the body, keeping the chest on the bench."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Upper arms about level with the back, elbows bent about 90 degrees; squeeze the backs of the shoulders and the shoulder blades."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower under control back to nearly straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Let the shoulder blades glide apart a little; chest stays down; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the chest off the bench to heave the weight",
        "fix": "Keep the chest on the pad; use lighter dumbbells."
      },
      {
        "id": "m2",
        "mistake": "Elbows drifting back toward the hips",
        "fix": "Pull the elbows out to the sides, in line with the shoulders."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulders to the ears",
        "fix": "Keep the neck long; pull the shoulder blades back and down."
      },
      {
        "id": "m4",
        "mistake": "Craning the neck up",
        "fix": "Keep the head in line with the trunk, eyes on the floor."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench and chest support",
        "setup": "Flat bench 61 cm high (120 cm long); chest on the pad, head 5.6 cm past the end",
        "peak": "Trunk ≈-3° from horizontal, unchanged (the trunk does not move); dumbbells 6.3 cm above the floor at the lowest",
        "norm": "Chest supported on the bench so the low back does not hold a hinge; the bench is high enough that the dumbbells hang clear of the floor (clinical opinion; compare the lumbar demand of the free-standing bent-over row in Fenwick 2009)",
        "sources": [
          "fenwick2009"
        ]
      },
      {
        "measure": "Elbow flare",
        "setup": "Arms hanging under the shoulders",
        "peak": "Upper arm ≈86° from the trunk line (head direction), elbow 9.3 cm from shoulder height",
        "norm": "Upper arm about 60-90 degrees out from the trunk so the pull is a horizontal abduction; horizontal abduction loads the posterior deltoid more than a close row (Franke 2015)",
        "sources": [
          "franke2015"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈10°",
        "peak": "≈91°, shoulder blades retracted (clavicle 8° to -16°)",
        "norm": "Nearly straight at the bottom, about 90 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Pronated: palms toward the feet",
        "peak": "Pronated (held)",
        "norm": "Pronated (palms back) is the usual rear delt row grip; on a reverse fly a neutral grip gave more posterior deltoid activity than pronated (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Feet",
        "setup": "Straddling the bench, balls of the feet on the floor 52 cm apart",
        "peak": "Unchanged (planted)",
        "norm": "Legs straddle the bench, balls of the feet planted for balance (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s",
        "peak": "1.2 s up, 0.4 s squeeze, 2.0 s down, 0.8 s pause",
        "norm": "Controlled, about 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual Dumbbell Lying Rear Delt Row, video page (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/5289-dumbbell-lying-rear-delt-row.html"
      },
      {
        "id": "franke2015",
        "title": "de Azevedo Franke, Botton, Rodrigues, Pinto and Lima 2015, analysis of anterior, middle and posterior deltoid activation during single and multijoint exercises (J Sports Med Phys Fitness 55(7-8):714-721)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/24947920/"
      },
      {
        "id": "botton2013",
        "title": "Botton, Wilhelm, Ughini, Pinto and Lima 2013, electromyographical analysis of the deltoid between different strength training exercises (Medicina Sportiva 17(2):67-71)",
        "url": "https://www.bisp-surf.de/Record/PU201312008451"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "fenwick2009",
        "title": "Fenwick, Brown & McGill 2009, comparison of different rowing exercises: trunk muscle activation and lumbar spine motion, load and stiffness (J Strength Cond Res 23(2):350-358)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19197209/"
      }
    ],
    "safety": {
      "cautions": [
        "Use a stable bench; if you raise it on blocks or plates, make sure it cannot tip or slide.",
        "Shoulder pain at the top: stop the elbows a little below the level of the back (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low-back pain: the chest support usually makes this easier on the back than a bent-over version (clinical opinion).",
        "No high bench: an incline bench at a low angle works the same way."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "One arm at a time."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Pause at the top.",
        "Slower lowering (3 s)."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover: with the elbows out wide the row becomes a horizontal abduction (a bent-arm reverse fly). Horizontal abduction (reverse peck deck) gave much higher posterior deltoid activity than a close-elbow seated row (Franke 2015; Botton 2013).",
      "post_deltoid_l": "Prime mover: with the elbows out wide the row becomes a horizontal abduction (a bent-arm reverse fly). Horizontal abduction (reverse peck deck) gave much higher posterior deltoid activity than a close-elbow seated row (Franke 2015; Botton 2013).",
      "rhomboids_midtrap_r": "Pull the shoulder blades together at the top of the row.",
      "rhomboids_midtrap_l": "Pull the shoulder blades together at the top of the row.",
      "infraspinatus_r": "External rotator that works with the posterior deltoid in horizontal abduction (Schoenfeld 2013).",
      "infraspinatus_l": "External rotator that works with the posterior deltoid in horizontal abduction (Schoenfeld 2013).",
      "lat_deltoid_r": "Helps hold the upper arm out from the body as it rises.",
      "lat_deltoid_l": "Helps hold the upper arm out from the body as it rises.",
      "biceps_r": "Holds the elbow bend; less involved than in a close row because the elbows lead.",
      "biceps_l": "Holds the elbow bend; less involved than in a close row because the elbows lead.",
      "core": "Light bracing only: the bench holds the trunk (clinical opinion).",
      "forearm_flexors_r": "Grip the dumbbells.",
      "forearm_flexors_l": "Grip the dumbbells."
    }
  },
