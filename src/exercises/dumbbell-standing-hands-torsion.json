  "exercise": {
    "id": "dumbbell-standing-hands-torsion",
    "name": "Dumbbell Standing Hands Torsion",
    "aliases": [
      "Standing dumbbell forearm twist",
      "Two-hand dumbbell wrist rotation",
      "Dumbbell steering-wheel twist"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "17299",
      "title": "Dumbbell Standing Hands Torsion (male)",
      "url": "https://gymvisual.com/videos/17299-dumbbell-standing-hands-torsion-male.html",
      "listing": "Video; the page could not be read here (blocked). The movement follows the name and a written description of the same catalog exercise: one dumbbell upright in both hands in front of the body, rotated through the forearms and wrists with the elbows by the ribs.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Forearms",
    "secondaryBodyParts": [
      "Upper arms"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (forearm pronation and supination)",
    "plane": "Frontal",
    "laterality": "Bilateral (one dumbbell in both hands)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "synergist": [
        "biceps_r",
        "biceps_l"
      ],
      "stabilizer": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily; out as the dumbbell tips to each side, in as it comes back through upright.",
      "cadence": "About 1 s to each side, 2 s across"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 to each side",
      "tempo": "Slow and controlled; brief pause at each end",
      "load": "User-chosen light dumbbell; the lever arm grows as it tips",
      "frequency": "2-3 times a week",
      "progression": "Longer pauses at each end, then a heavier dumbbell or holding nearer one end"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall. Hold one dumbbell upright in front of the belly, one fist above the other; elbows bent and by the ribs, wrists straight."
      },
      {
        "id": "c2",
        "phase": "right",
        "text": "Turn the forearms so the top of the dumbbell tips out to the right; upper arms stay still."
      },
      {
        "id": "c3",
        "phase": "holdR",
        "text": "Pause at the end of the range you can control."
      },
      {
        "id": "c4",
        "phase": "left",
        "text": "Turn back through upright and tip it out to the left."
      },
      {
        "id": "c5",
        "phase": "holdL",
        "text": "Pause; wrists straight, shoulders down."
      },
      {
        "id": "c6",
        "phase": "back",
        "text": "Return to upright."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the arms or twisting the trunk to move the dumbbell",
        "fix": "Pin the elbows to the ribs; only the forearms turn."
      },
      {
        "id": "m2",
        "mistake": "Letting the dumbbell drop at the end of the range",
        "fix": "Go only as far as you can stop it; use a lighter dumbbell."
      },
      {
        "id": "m3",
        "mistake": "Bending the wrists",
        "fix": "Keep the wrists in line with the forearms; the turn comes from the forearm."
      },
      {
        "id": "m4",
        "mistake": "Shrugging",
        "fix": "Shoulders relaxed and down."
      }
    ],
    "kinematics": [
      {
        "measure": "Dumbbell tilt",
        "setup": "Upright (≈0° from vertical, seen from the front)",
        "peak": "≈43° to the right and ≈40° to the left",
        "norm": "About 40-45 degrees each way from upright (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm rotation (wrist pron channel)",
        "setup": "Right ≈86°, left ≈88° (pron channel, 90 = thumb up)",
        "peak": "Right ≈44° to ≈125°, left ≈126° to ≈49°",
        "norm": "Functional forearm rotation needs about 50 degrees each of pronation and supination (Ryu 1991 studied the wrist; forearm values are clinical opinion)",
        "sources": [
          "ryu1991"
        ]
      },
      {
        "measure": "Elbows",
        "setup": "Bent ≈55°, by the ribs",
        "peak": "Move at most 2 cm over the loop",
        "norm": "Bent and by the ribs, still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s upright",
        "peak": "1 s out to each side, 0.4 s hold, 2 s across",
        "norm": "Slow, controlled, pause at each end (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #17299, Dumbbell Standing Hands Torsion (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/17299-dumbbell-standing-hands-torsion-male.html"
      },
      {
        "id": "ryu1991",
        "title": "Ryu, Cooney, Askew, An and Chao 1991, functional ranges of motion of the wrist joint (J Hand Surg Am 16(3):409-419; 40 adults, biaxial wrist electrogoniometer)",
        "url": "https://mayoclinic.elsevierpure.com/en/publications/functional-ranges-of-motion-of-the-wrist-joint/"
      },
      {
        "id": "jht2012",
        "title": "Effectiveness of different methods of resistance exercises in lateral epicondylosis, a systematic review (J Hand Ther 2012;25(1):5-25; PubMed 22075055; 12 studies)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/22075055/"
      },
      {
        "id": "szymanski2004",
        "title": "Szymanski, Szymanski, Molloy and Pascoe 2004, effect of 12 weeks of wrist and forearm training on high school baseball players (J Strength Cond Res 18(3):432-440; PubMed 15320673; 43 players)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/15320673/"
      }
    ],
    "safety": {
      "cautions": [
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Elbow or wrist pain (for example tennis or golfer's elbow): use a very light dumbbell or none, and a small range.",
        "Hold the dumbbell firmly and keep it away from the body; a long dumbbell tips quickly.",
        "Stand clear of anything you could hit if the dumbbell slips."
      ],
      "modify": [
        "Hold the dumbbell near one end for less lever, or use a hammer or a light bar.",
        "Seated, forearms resting on the thighs."
      ],
      "regressions": [
        "No weight: turn the fists through the same range.",
        "Smaller range."
      ],
      "progressions": [
        "Slower turns with longer pauses.",
        "Heavier dumbbell.",
        "One hand at a time."
      ]
    },
    "muscleNotes": {
      "forearm_flexors_r": "Pronator teres and the wrist flexors turn the forearm palm-down and grip the handle (clinical opinion). Forearm strengthening is a mainstay for lateral elbow pain (J Hand Ther 2012 review).",
      "forearm_flexors_l": "Pronator teres and the wrist flexors turn the forearm palm-down and grip the handle (clinical opinion). Forearm strengthening is a mainstay for lateral elbow pain (J Hand Ther 2012 review).",
      "forearm_extensors_r": "Supinator and brachioradialis (drawn with the extensors) turn the forearm palm-up and hold the wrists straight (clinical opinion). Wrist and forearm training improved forearm strength in Szymanski 2004.",
      "forearm_extensors_l": "Supinator and brachioradialis (drawn with the extensors) turn the forearm palm-up and hold the wrists straight (clinical opinion). Wrist and forearm training improved forearm strength in Szymanski 2004.",
      "biceps_r": "Assists supination and holds the elbows bent (clinical opinion).",
      "biceps_l": "Assists supination and holds the elbows bent (clinical opinion).",
      "ant_deltoid_r": "Holds the upper arms still (clinical opinion).",
      "ant_deltoid_l": "Holds the upper arms still (clinical opinion).",
      "core": "Keeps the trunk quiet (clinical opinion)."
    }
  },
