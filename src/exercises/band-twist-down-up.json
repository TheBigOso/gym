    "id": "band-twist-down-up",
    "name": "Band Twist (Down-Up)",
    "aliases": [
      "Band wood chop (low to high)",
      "Band low-to-high chop",
      "Band upward twist",
      "Band reverse wood chop"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "25201",
      "title": "Band twist (down up)",
      "url": "https://gymvisual.com/videos/25201-band-twist-down-up-male.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (the proxy refused gymvisual.com), so the movement follows the name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Abdominals",
      "Shoulders",
      "Hips"
    ],
    "equipment": [
      "Resistance band",
      "Squat rack upright (band anchor)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk rotation with a diagonal arm pull)",
    "plane": "Multiplanar",
    "laterality": "Unilateral (band pulls from one side)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l",
        "core"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l",
        "glute_med_r",
        "glute_med_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you drive the band up and across, breathe in as the arms return down to the anchor.",
      "cadence": "About 1 s up, 1.5 s back down"
    },
    "prescription": {
      "sets": "2-3 per side",
      "reps": "8-12 per side",
      "effort": "Stop 2-3 reps short of losing control of the return (clinical opinion)",
      "tempo": "1-0.3-1.5-0.5 (down-pause-up-pause, seconds)",
      "rest": "45-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: step farther from the anchor for more tension",
      "progression": "Stronger band, slower return, half-kneeling version for more trunk control"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand side-on to the anchor, band tied low on the upright. Feet a little wider than the hips; sit into a quarter squat, turn toward the anchor and hold the handle with both hands low beside the outside of the near thigh."
      },
      {
        "id": "c2",
        "phase": "chop",
        "text": "Breathe out and drive the band up and across the body to above the far shoulder, standing up and turning the hips and ribs together, arms long."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Brief pause high; ribs down, shoulders away from the ears, feet planted."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Let the arms come back down to the anchor slowly, sitting back into the quarter squat and turning back as one piece."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Chest up at the bottom, then drive up again. Turn around to train the other side."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting with the arms only",
        "fix": "Drive with the legs and turn the hips and ribs together; the arms stay long and guide the band."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back at the bottom",
        "fix": "Sit the hips back and keep the chest up; bend the knees rather than the spine."
      },
      {
        "id": "m3",
        "mistake": "Letting the band yank the arms back down",
        "fix": "Control the return; take 1-2 s."
      },
      {
        "id": "m4",
        "mistake": "Arching back and shrugging at the top",
        "fix": "Finish with the ribs down and the shoulders low; stop at about head height."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk rotation",
        "setup": "Turned ≈82° toward the anchor (pelvis ≈32°, spine ≈50°)",
        "peak": "Turned ≈52° away (pelvis ≈18°, spine ≈34°)",
        "norm": "Ribs and hips turn together from facing the anchor to facing away; mostly thoracic and hip rotation (clinical opinion; end-range twisting under flexion is the concern, Marshall and McGill 2010)",
        "sources": [
          "marshall2010"
        ]
      },
      {
        "measure": "Hand path",
        "setup": "Hands low beside the outside of the right thigh at 80 cm, band tied 14 cm high, 74 cm to the side",
        "peak": "Above the left shoulder at 172 cm, 24 cm left of the midline",
        "norm": "Diagonal from low beside the near thigh to above the far shoulder (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈48°",
        "peak": "≈9°",
        "norm": "Quarter squat at the bottom, nearly straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈54°",
        "peak": "≈0°",
        "norm": "Arms long, elbows soft (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Low reach 0.6 s",
        "peak": "1 s up, 0.3 s pause, 1.5 s down, 0.5 s reach",
        "norm": "Controlled pull, slower return (clinical opinion)",
        "sources": []
      }
    ],
