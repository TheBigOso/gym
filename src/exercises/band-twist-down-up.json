    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Check the band and the anchor before each set: a band that slips or snaps can hit you, and the hands finish near the face.",
        "Keep the range comfortable and turn the hips with the ribs; avoid a forceful end-range twist with a rounded back (Marshall and McGill 2010).",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low back discomfort: smaller turn, or a half-kneeling chop.",
        "Shoulder discomfort: finish at chest height instead of above the shoulder."
      ],
      "regressions": [
        "Lighter band or stand closer to the anchor.",
        "Half-kneeling chop.",
        "Pallof press (anti-rotation hold)."
      ],
      "progressions": [
        "Stronger band.",
        "Slower return.",
        "Narrower stance."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Turn the trunk up and across against the band (oblique pair across the trunk). In elastic-band torso twists the external oblique reached about 54-77% MVC (Scientifica 2015).",
      "obliques_l": "Turn the trunk up and across against the band (Scientifica 2015).",
      "core": "Transversus and rectus abdominis brace the trunk and stop the low back arching at the top (clinical opinion).",
      "ant_deltoid_r": "Raise the long arms up and across (clinical opinion).",
      "ant_deltoid_l": "Raise the long arms up and across (clinical opinion).",
      "glute_max_r": "Drive the hips up out of the quarter squat and help turn the pelvis (clinical opinion).",
      "glute_max_l": "Drive the hips up out of the quarter squat and help turn the pelvis (clinical opinion).",
      "quads_r": "Straighten the knees as you stand up (clinical opinion).",
      "quads_l": "Straighten the knees as you stand up (clinical opinion).",
      "glute_med_r": "Turn and steady the pelvis over the planted feet (clinical opinion).",
      "glute_med_l": "Turn and steady the pelvis over the planted feet (clinical opinion).",
      "spinal_extensors_r": "Keep the chest up in the low start (erector spinae about 32-50% MVC in torso twists, Scientifica 2015).",
      "spinal_extensors_l": "Keep the chest up in the low start (Scientifica 2015).",
      "upper_traps_r": "Support the shoulder blade as the arms rise (clinical opinion).",
      "upper_traps_l": "Support the shoulder blade as the arms rise (clinical opinion).",
      "serratus_r": "Turns the shoulder blade up as the arms rise (clinical opinion).",
      "serratus_l": "Turns the shoulder blade up as the arms rise (clinical opinion)."
    }
