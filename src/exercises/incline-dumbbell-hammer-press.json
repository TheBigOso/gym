    "breathing": {
      "pattern": "Inhale as you lower the dumbbells, exhale as you press them up.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "Add reps up to the top of the range, then move to the next dumbbell (usually 1-2.5 kg per hand)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the back pad to 30 degrees, glutes in the crease, upper back and head on the pad, feet planted; dumbbells up over the upper chest with the palms facing each other."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the dumbbells beside the upper chest, elbows tucked about 30 degrees from your sides, forearms vertical."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Handles parallel to the body beside the chest, upper arms just below the pad line; no bounce."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press straight up over the shoulders, palms still facing each other."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked, dumbbells a few centimetres apart, shoulder blades still back on the pad."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the palms turn forward as you press",
        "fix": "Keep the handles parallel to your body (palms facing) from bottom to top."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out like a regular press",
        "fix": "Keep the elbows tucked about 30 degrees from the sides; the neutral grip is meant to keep them close."
      },
      {
        "id": "m3",
        "mistake": "Bench set too steep (shoulder press)",
        "fix": "Use a 30-45 degree incline; steeper turns it into a shoulder press (Rodríguez-Ridao 2020)."
      },
      {
        "id": "m4",
        "mistake": "Glutes sliding off the seat",
        "fix": "Sit back into the crease and keep the feet planted."
      },
      {
        "id": "m5",
        "mistake": "Banging the dumbbells together at the top",
        "fix": "Stop with them a few centimetres apart over the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "30° back pad, flat seat",
        "peak": "Glutes in the crease, upper back and head on the pad (skinned-mesh offsets from b2/chest_mesh.mjs)",
        "norm": "Back pad at 30 degrees (the angle that gave the highest upper-pectoralis activity in Rodríguez-Ridao 2020; Lauver 2016 also recommends 30 degrees); 30-45 degrees is common for the incline hammer press (clinical opinion)",
        "sources": [
          "rodriguez2020",
          "lauver2016"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Neutral: handles along the trunk, dumbbells 23.5 cm apart at the top",
        "peak": "Neutral beside the chest, centres 59.2 cm apart",
        "norm": "Neutral (palms facing each other) throughout (clinical opinion; the neutral grip shifted activity toward the clavicular pectoralis in a seated press, Muyor 2023)",
        "sources": [
          "muyor2023"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈11° (arms straight, not locked)",
        "peak": "≈113° at the bottom",
        "norm": "Arms straight but not locked at the top; dumbbells beside the chest at the bottom with the elbows roughly 90-110 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "Arms vertical over the shoulders",
        "peak": "≈30° from the trunk at the bottom; upper arm ≈14° below the back plane",
        "norm": "About 20-40 degrees from the body, closer than a pronated press (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up, 0.7 s at the top",
        "norm": "Controlled: about 2 s down and 1-2 s up; Rodríguez-Ridao 2020 used 2 s down and 2 s up at 60% of 1RM",
        "sources": [
          "rodriguez2020"
        ]
      }
    ],
