  "exercise": {
    "id": "ring-high-row",
    "name": "Ring High Row",
    "aliases": [
      "Ring face row",
      "Ring wide row",
      "Gymnastic ring high row"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11420",
      "title": "Ring High Row",
      "url": "https://gymvisual.com/videos/11420-ring-high-row.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper back (rear shoulders, mid-back)",
    "secondaryBodyParts": [
      "Lats",
      "Biceps",
      "Core"
    ],
    "equipment": [
      "Gymnastic rings",
      "Pull-up bar (anchor)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "synergist": [
        "lats_r",
        "lats_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_max_r",
        "glute_max_l",
        "hamstrings_r",
        "hamstrings_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "lengthened": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull the rings to the upper chest, breathe in as the arms straighten.",
      "cadence": "About 1.2 s pull, short squeeze, about 2 s lower"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-15",
      "tempo": "1-1-2-0",
      "load": "Bodyweight; body angle sets the load (RIR 1-3, clinical opinion)",
      "frequency": "2-3 times a week",
      "progression": "Lower the body angle, then raise the feet"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Rings at shoulder width, overhand grip (palms toward the feet); lean back with long arms, heels down, body straight."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and pull the rings to the upper chest, elbows wide, about level with the shoulders."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the shoulder blades together; keep the neck long."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to long arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the glutes and abs tight; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows dropping to the ribs",
        "fix": "Keep the elbows up and out; this is a high row, not a low row."
      },
      {
        "id": "m2",
        "mistake": "Shrugging",
        "fix": "Pull the shoulder blades back, not up."
      },
      {
        "id": "m3",
        "mistake": "Hips sagging",
        "fix": "Brace and squeeze the glutes."
      },
      {
        "id": "m4",
        "mistake": "Chin poking forward to meet the rings",
        "fix": "Keep the head in line with the body."
      }
    ],
    "kinematics": [
      {
        "measure": "Body angle",
        "setup": "≈28° above the floor, heels down",
        "peak": "≈48° at the top",
        "norm": "The more upright the body, the easier the row (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare",
        "setup": "Arms long toward the rings",
        "peak": "Upper arms ≈82° from the trunk, hands at the upper chest",
        "norm": "Upper arms about 70-90 degrees out from the trunk at the top shift the work toward the rear deltoids and mid-trapezius (Schoenfeld 2013, Oyama 2010)",
        "sources": [
          "schoenfeld2013",
          "oyama2010"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈25° (arms long)",
        "peak": "≈119° at the top",
        "norm": "About 100-120 degrees at the top, hands just in front of the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Straps",
        "setup": "One strap per ring, 105.7 cm, anchors 60 cm apart; 14° from vertical at the bottom",
        "peak": "1° from vertical at the top; at least 14 cm off the body",
        "norm": "Straps stay taut; each hand stays on its strap arc (geometry)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s",
        "peak": "1.2 s up, 0.4 s squeeze, 2 s down",
        "norm": "About 1 s up, 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11420, Ring High Row, video (movement reference)",
        "url": "https://gymvisual.com/videos/11420-ring-high-row.html"
      },
      {
        "id": "schoenfeld2013",
        "title": "Schoenfeld et al. 2013, effect of hand position on EMG activity of the posterior shoulder musculature during a horizontal abduction exercise (J Strength Cond Res 27(10):2644-2649)",
        "url": "https://scholars.nova.edu/en/publications/effect-of-hand-position-on-emg-activity-of-the-posterior-shoulder/"
      },
      {
        "id": "oyama2010",
        "title": "Oyama, Myers, Wassinger and Lephart 2010, three-dimensional scapular and clavicular kinematics and scapular muscle activity during retraction exercises (J Orthop Sports Phys Ther 40(3):169-179)",
        "url": "https://chs.uky.edu/sites/default/files/2023-12/Oyama_2010_Three-Dimensional%20Scapular%20and%20Clavicular%20Kinematics.pdf"
      },
      {
        "id": "fenwick2009",
        "title": "Fenwick, Brown & McGill 2009, comparison of different rowing exercises: trunk muscle activation and lumbar spine motion, load and stiffness (J Strength Cond Res 23(2):350-358)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19197209/"
      }
    ],
    "safety": {
      "cautions": [
        "Check the anchor and the straps before each set; anchor only to a sturdy bar or a door anchor made for it.",
        "Shoulder pain: stand more upright and shorten the range (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Suspension straps with handles work the same way."
      ],
      "regressions": [
        "Stand more upright."
      ],
      "progressions": [
        "Feet on a box.",
        "Pause 2 s at the top."
      ]
    },
    "muscleNotes": {
      "rhomboids_midtrap_r": "Draws the shoulder blade back at the finish.",
      "rhomboids_midtrap_l": "Draws the shoulder blade back at the finish.",
      "post_deltoid_r": "Pulls the upper arm back and out.",
      "post_deltoid_l": "Pulls the upper arm back and out.",
      "lats_r": "Pulls the upper arm down and back toward the trunk.",
      "lats_l": "Pulls the upper arm down and back toward the trunk.",
      "infraspinatus_r": "Turns the upper arm out and steadies the shoulder.",
      "infraspinatus_l": "Turns the upper arm out and steadies the shoulder.",
      "biceps_r": "Bends the elbow.",
      "biceps_l": "Bends the elbow.",
      "forearm_flexors_r": "Grip.",
      "forearm_flexors_l": "Grip.",
      "core": "Braces the trunk so the body stays in one line.",
      "spinal_extensors_r": "Hold the spine long.",
      "spinal_extensors_l": "Hold the spine long.",
      "glute_max_r": "Keeps the hips extended in line with the body.",
      "glute_max_l": "Keeps the hips extended in line with the body.",
      "hamstrings_r": "Help the glutes hold the hips up.",
      "hamstrings_l": "Help the glutes hold the hips up.",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
      "upper_traps_l": "Steadies the shoulder girdle; should not shrug."
    }
