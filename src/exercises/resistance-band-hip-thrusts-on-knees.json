  "exercise": {
    "id": "resistance-band-hip-thrusts-on-knees",
    "name": "Resistance Band Hip Thrusts on Knees",
    "aliases": [
      "Kneeling band hip thrust",
      "Banded kneeling hip extension",
      "Kneeling glute thrust with band"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "21161",
      "title": "Resistance Band Hip Thrusts on Knees",
      "url": "https://gymvisual.com/videos/21161-resistance-band-hip-thrusts-on-knees-male.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment, so the movement was taken from the exercise name and standard coaching). The band, usually across the front of the hips, is drawn as two strands from the rack uprights behind to the hands, which hold it at the sides of the hips.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Hamstrings",
      "Core"
    ],
    "equipment": [
      "Resistance band (two strands, or a long band round the hips)",
      "Squat rack uprights (band anchor)",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "quads_r",
        "quads_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you drive the hips forward, inhale as they go back.",
      "cadence": "About 1.2 s forward, short squeeze, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.8-2-1.2 (forward-squeeze-back-pause, seconds)",
      "rest": "45-75 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: pick a band you can drive through to full tall kneeling for every rep.",
      "progression": "Add reps, then a stronger band; longer squeeze"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel on a mat facing away from a rack, knees hip width, toes tucked. Hold the band strands at the sides of your hips so the band pulls them back; sit the hips back toward the heels with a long back."
      },
      {
        "id": "c2",
        "phase": "drive",
        "text": "Breathe out, squeeze the glutes and drive the hips forward until you are tall on the knees."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Tall kneeling: hips fully forward, ribs down, glutes squeezed; do not lean back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the band draw the hips back toward the heels, hinging with a long back."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the hips back, then drive again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back and arching the low back at the top",
        "fix": "Finish tall with the ribs down; the hips move, the low back stays still."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back when sitting back",
        "fix": "Hinge from the hips with a long back."
      },
      {
        "id": "m3",
        "mistake": "Letting the band yank the hips back",
        "fix": "Control the lowering over about 2 s."
      },
      {
        "id": "m4",
        "mistake": "Knees sliding or splaying",
        "fix": "Keep the knees hip width and planted on the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "69° (hips back)",
        "peak": "0.3° (tall kneeling)",
        "norm": "From hips back (about 60-90 degrees of flexion) to neutral at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Thigh angle",
        "setup": "≈40° behind vertical",
        "peak": "≈8° (vertical)",
        "norm": "The thighs swing from well behind vertical (hips toward the heels) to vertical at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈27° forward",
        "peak": "≈3° (upright)",
        "norm": "Leaning forward with the hinge at the bottom, upright at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Anchored on the uprights 56.5 cm high, 71 cm to the hands",
        "peak": "Stretched to 89 cm; strands clear of the body by 2.34 cm or more",
        "norm": "Elastic tension rises as the hips move forward, so the load is highest at the top, where the glutes are shortest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 1.2 s with the hips back",
        "peak": "1.2 s forward, 0.8 s squeeze, 2 s back",
        "norm": "About 1 s forward, a short squeeze, about 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Resistance Band Hip Thrusts on Knees, video (movement reference)",
        "url": "https://gymvisual.com/videos/21161-resistance-band-hip-thrusts-on-knees-male.html"
      },
      {
        "id": "neto2020",
        "title": "Krause Neto, Soares, Vieira et al. 2020, gluteus maximus activation during common strength and hypertrophy exercises: a systematic review (J Sports Sci Med 19(1):195-203)",
        "url": "https://www.jssm.org/jssm-19-195.xml-abst"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if pain in the low back, hips or knees, numbness or tingling occurs.",
        "Kneel on a mat or pad.",
        "Anchor the band low and securely round the uprights and check it for nicks; a snapping band can whip back.",
        "Band tension is user-chosen: start light.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee discomfort: add padding or do a glute bridge instead.",
        "Low-back discomfort: shorten the range and keep the trunk more upright."
      ],
      "regressions": [
        "No band.",
        "Glute bridge."
      ],
      "progressions": [
        "Stronger band.",
        "2 s squeeze at the top.",
        "Hip thrust on a bench."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Prime mover: drives the hips forward to full extension against the band; the band load is highest at the top.",
      "hamstrings_r": "Assist hip extension with the knee bent.",
      "adductors_r": "The large adductor assists hip extension from the flexed position.",
      "spinal_extensors_r": "Hold the long back in the hinge; they should not arch the low back at the top (clinical opinion).",
      "quads_r": "Steady the knees on the mat.",
      "forearm_flexors_r": "Hold the band.",
      "glute_max_l": "Prime mover: drives the hips forward to full extension against the band; the band load is highest at the top.",
      "hamstrings_l": "Assist hip extension with the knee bent.",
      "adductors_l": "The large adductor assists hip extension from the flexed position.",
      "spinal_extensors_l": "Hold the long back in the hinge; they should not arch the low back at the top (clinical opinion).",
      "quads_l": "Steady the knees on the mat.",
      "forearm_flexors_l": "Hold the band.",
      "core": "Keeps the ribs down so the hips, not the low back, finish the move (Macadam 2019 reviewed bracing and glute activity)."
    }
  },
