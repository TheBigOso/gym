{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "cable-hip-abduction",
    "name": "Cable Hip Abduction (standing, ankle strap)",
    "aliases": [
      "Standing cable hip abduction",
      "Cable side leg raise",
      "Ankle-strap cable abduction"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "087912",
      "title": "Cable hip abduction (version 2)",
      "url": "https://gymvisual.com/videos/2954-cable-hip-abduction-version-2.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus medius)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Cable machine (low pulley)",
      "Ankle strap"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip abduction)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_med_r"
      ],
      "synergist": [
        "glute_max_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "core",
        "obliques_l",
        "calves_l"
      ],
      "lengthened": [
        "adductors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg moves out, inhale as it returns.",
      "cadence": "About 1.2 s out, 0.5 s hold, 1.8 s back"
    },
    "prescription": {
      "sets": "2-4 per side",
      "reps": "10-15",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-60 s",
      "progression": "Add a plate on the stack once 15 controlled reps are easy"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Strap the right ankle, clip it to the low pulley on your left, and stand tall on the left leg with the hands on the hips."
      },
      {
        "id": "c2",
        "phase": "out",
        "text": "Breathe out and sweep the straight leg out to the side, toes pointing forward."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at about 30-40 degrees; the pelvis stays level."
      },
      {
        "id": "c4",
        "phase": "back",
        "text": "Breathe in and let the cable bring the leg back slowly, in front of the stance shin."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stop just before the stack touches down; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning far over the stance leg",
        "fix": "Stay tall; a small lean is fine, a big one hitches the pelvis instead of working the hip."
      },
      {
        "id": "m2",
        "mistake": "Turning the toes up",
        "fix": "Keep the toes forward so the hip does not rotate out and hand the work to the hip flexors."
      },
      {
        "id": "m3",
        "mistake": "Swinging the leg",
        "fix": "Slow out, pause, slower back; the cable should never slam the stack."
      },
      {
        "id": "m4",
        "mistake": "Standing too close to the pulley",
        "fix": "Step out until the cable has tension with the leg under the hip."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "≈3° (leg under the hip, toes just off the floor)",
        "peak": "≈35° (joint channel); leg ≈37° from vertical in the frontal plane",
        "norm": "About 30-45 degrees of abduction (clinical opinion); hip abduction against load excites the gluteus medius strongly (Distefano 2009; Boren 2011)",
        "sources": [
          "distefano2009",
          "boren2011"
        ]
      },
      {
        "measure": "Pelvis and trunk",
        "setup": "Tall, pelvis level over the stance foot",
        "peak": "≈5° lean toward the stance side (small, controlled)",
        "norm": "Pelvis level, trunk upright; only a small lean (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable line",
        "setup": "Pulley at ankle height on the left; cable 82 cm",
        "peak": "Cable 127 cm; clears the stance shin by 5.0 cm or more",
        "norm": "Low pulley at ankle height on the stance side; cable runs in front of the stance leg (standard setup)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.2 s out, 0.5 s hold, 1.8 s back",
        "norm": "Slow and controlled, slower back than out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #087912, Cable hip abduction (version 2), video (movement reference)",
        "url": "https://gymvisual.com/videos/2954-cable-hip-abduction-version-2.html"
      },
      {
        "id": "distefano2009",
        "title": "Distefano et al. 2009, gluteal muscle activation during common therapeutic exercises (J Orthop Sports Phys Ther 39(7):532-540)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19574661/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the strap is snug and the clip is closed before each set."
      ],
      "modify": [
        "Poor balance: hold the machine with the free hand.",
        "Hip pinching: make the arc smaller."
      ],
      "regressions": [
        "Side-lying hip abduction.",
        "Band hip abduction."
      ],
      "progressions": [
        "Heavier stack.",
        "Longer pause at the top."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Prime mover of hip abduction; side-lying and standing abduction rank among the highest gluteus medius exercises (Distefano 2009; Boren 2011).",
      "glute_max_r": "Upper fibres assist abduction (Boren 2011).",
      "glute_med_l": "Holds the pelvis level over the stance leg (clinical opinion).",
      "core": "Keeps the trunk tall (clinical opinion).",
      "obliques_l": "Resists side bending toward the moving leg (clinical opinion).",
      "calves_l": "Balance on the stance foot (clinical opinion).",
      "adductors_r": "Lengthen as the leg moves out (clinical opinion)."
    }
  },
