  "exercise": {
    "id": "dumbbell-decline-fly",
    "name": "Dumbbell Decline Fly",
    "aliases": [
      "Decline dumbbell fly",
      "Decline chest fly"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "001359",
      "title": "Dumbbell Decline Fly",
      "url": "https://gymvisual.com/videos/1359-dumbbell-decline-fly.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Front shoulders"
    ],
    "equipment": [
      "Decline bench",
      "Dumbbells"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (horizontal shoulder adduction)",
    "plane": "Transverse",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "biceps_r",
        "biceps_l",
        "serratus_r",
        "serratus_l",
        "core"
      ],
      "lengthened": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press or lift.",
      "cadence": "About 2 s down, a short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2 s down, brief pause, 1-1.5 s up",
      "frequency": "2 times a week",
      "progression": "Add load in small steps; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the decline bench, feet hooked under the roller, dumbbells above the lower chest, palms facing each other, elbows slightly bent."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and open the arms in a wide arc, elbows fixed slightly bent, until the upper arms are about level with the body."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with a stretch across the chest; do not go lower."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and hug the dumbbells back up over the chest in the same arc."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stop with the dumbbells close but not touching; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending and straightening the elbows (turns it into a press)",
        "fix": "Keep the elbow angle fixed."
      },
      {
        "id": "m2",
        "mistake": "Dropping the arms too low",
        "fix": "Stop with the upper arms about level with the body."
      },
      {
        "id": "m3",
        "mistake": "Banging the dumbbells together at the top",
        "fix": "Stop just before they touch."
      },
      {
        "id": "m4",
        "mistake": "Too heavy a load",
        "fix": "Use a weight you can control through the whole arc."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder horizontal abduction",
        "setup": "Arms ≈15° from vertical over the chest",
        "peak": "≈81° from vertical at the bottom of the arc",
        "norm": "From arms over the chest to upper arms about level with the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow",
        "setup": "≈15°",
        "peak": "≈30°",
        "norm": "Fixed slight bend, about 15-30 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Decline",
        "setup": "25° decline, head low, feet hooked",
        "peak": "Body still on the board",
        "norm": "Decline benches shift pressing work toward the lower chest (Rodriguez-Ridao 2020)",
        "sources": [
          "rodriguez2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #001359, Dumbbell Decline Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/1359-dumbbell-decline-fly.html"
      },
      {
        "id": "rodriguez2020",
        "title": "Rodríguez-Ridao, Antequera-Vique, Martín-Fuentes and Muyor 2020, effect of five bench inclinations on the electromyographic activity of the pectoralis major, anterior deltoid and triceps brachii during the bench press exercise (Int J Environ Res Public Health 17(19):7339; PMC7579505)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7579505/"
      }
    ],
    "safety": {
      "cautions": [
        "Lying head-down raises pressure in the head; skip the decline with uncontrolled high blood pressure, glaucoma or a recent eye or head problem (clinical opinion), and sit up slowly after the set.",
        "Hook the feet under the roller before taking the weights; hand the weights down or lower them to the floor beside the bench at the end.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: smaller arc."
      ],
      "regressions": [
        "Flat dumbbell fly.",
        "Lighter dumbbells."
      ],
      "progressions": [
        "Slower lowering.",
        "Pause in the stretch."
      ]
    },
    "muscleNotes": {
      "pec": "The fly loads the pectoralis most with the arms open; a decline position biases the lower (sternal) fibres in pressing studies (Rodriguez-Ridao 2020), and the same is commonly assumed for flies (clinical opinion)."
    }
  },
