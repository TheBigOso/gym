{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "chest-dip",
    "name": "Chest Dip",
    "aliases": [
      "Parallel bar dip, chest version",
      "Forward-lean dip"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "002884",
      "title": "Chest Dip",
      "url": "https://gymvisual.com/videos/2884-chest-dip.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest and upper arms (triceps, chest, front shoulders)",
    "secondaryBodyParts": [
      "Triceps",
      "Chest",
      "Shoulders"
    ],
    "equipment": [
      "Dip station (parallel bars)",
      "Body weight"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (elbow extension, shoulder flexion from extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "triceps_r",
        "triceps_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "serratus_r",
        "serratus_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ],
      "lengthened": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale on the way down, exhale as you press up.",
      "cadence": "About 2 s down, a short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-12",
      "tempo": "2 s down, brief pause, 1-1.5 s up",
      "frequency": "2 times a week",
      "progression": "Assisted (band or machine), then body weight, then a dip belt with added load"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Grip the bars with the arms straight, lean the chest forward a little, bend the knees and cross or tuck the feet behind."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower by bending the elbows; let the trunk lean forward and the elbows drift slightly out."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop with the upper arms about parallel and a stretch across the chest."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Press back up, breathing out, keeping the forward lean until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked, shoulders down; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping too deep",
        "fix": "Stop at about parallel upper arms; deeper loads the front of the shoulder."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders to the ears",
        "fix": "Keep the shoulders down and back."
      },
      {
        "id": "m3",
        "mistake": "Staying upright (turns it into a triceps dip)",
        "fix": "Lean the trunk forward about 20-30 degrees at the bottom."
      },
      {
        "id": "m4",
        "mistake": "Swinging the legs to get up",
        "fix": "Keep the legs still; press with the arms."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈2° (straight, not locked)",
        "peak": "≈94° at the bottom",
        "norm": "Arms straight but not locked at the top; elbow flexion at the bottom of a bar dip was larger than in a bench dip (McKenzie 2022); upper arms about parallel is a common limit (clinical opinion)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Trunk lean",
        "setup": "≈10° forward of vertical",
        "peak": "≈30° at the bottom (forward lean: chest emphasis)",
        "norm": "Forward lean of about 20-30 degrees at the bottom shifts the work toward the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm angle to the floor",
        "setup": "≈82° (arms straight down to the bars)",
        "peak": "≈0° at the bottom",
        "norm": "Stop with the upper arms about parallel to the floor (clinical opinion); bar dips reached about 95% of the maximal shoulder extension range in the study group (McKenzie 2022)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Body travel",
        "setup": "Shoulders 50 cm above the wrists",
        "peak": "23 cm down; feet stay 70 cm or more off the floor",
        "norm": "The body moves down and up between the bars; the feet stay off the floor (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #002884, Chest Dip, video (movement reference)",
        "url": "https://gymvisual.com/videos/2884-chest-dip.html"
      },
      {
        "id": "mckenzie2022",
        "title": "McKenzie, Crowley-McHattan, Meir, Whitting and Volschenk 2022, bench, bar, and ring dips: do kinematics and muscle activity differ? (Int J Environ Res Public Health 19(20):13211; PMC9603242)",
        "url": "https://www.mdpi.com/1660-4601/19/20/13211"
      }
    ],
    "safety": {
      "cautions": [
        "Shoulder: dips take the shoulder far into extension under body weight, which loads the front of the shoulder (McKenzie 2022); keep the range to upper arms about parallel and stop if the front of the shoulder hurts.",
        "Skip it with a history of shoulder instability or pain at the front of the shoulder.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorter range (stop with the elbows at about 60 degrees).",
        "Assisted dip machine or a band across the bars."
      ],
      "regressions": [
        "Bench dip with the knees bent.",
        "Negative-only dips."
      ],
      "progressions": [
        "Slower lowering (3 s).",
        "Pause at the bottom."
      ]
    },
    "muscleNotes": {
      "pec": "The forward lean and the elbows drifting a little out put the sternal pectoralis under stretch at the bottom and make it the main presser (clinical opinion).",
      "triceps": "Triceps extend the elbows from the bottom to the top (McKenzie 2022)."
    }
  },
