    "id": "dumbbell-upright-row",
    "name": "Dumbbell Upright Row",
    "aliases": [
      "DB upright row",
      "Standing dumbbell upright row"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "043712",
      "title": "Dumbbell Upright Row",
      "url": "https://gymvisual.com/videos/5058-dumbbell-upright-row.html",
      "listing": "Video; data sheet: body part Shoulders, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (lateral deltoid) and upper trapezius",
    "secondaryBodyParts": [
      "Upper back (trapezius)",
      "Upper arms (biceps)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder, shoulder blade and elbow)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lat_deltoid_r",
        "lat_deltoid_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "biceps_r",
        "biceps_l",
        "serratus_r",
        "serratus_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "post_deltoid_r",
        "post_deltoid_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull up, breathe in as you lower.",
      "cadence": "About 1.5 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1.5-0.5-2-0.5 (up-pause-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbells; moderate, with the elbows stopping at about shoulder height",
      "progression": "Add reps, then weight; keep the range at or below shoulder height"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet about hip width, knees soft, ribs down and glutes lightly braced. Dumbbells in front of the thighs, palms facing you, hands about shoulder width."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and lead with the elbows: pull the dumbbells up close to the body."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop with the elbows at about shoulder height, above the wrists, hands at the lower chest. Do not shrug to the ears."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower under control in about 2 s, dumbbells close to the body."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms long in front of the thighs; reset and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling the elbows above shoulder height",
        "fix": "Stop at about shoulder height: upright rows above 90 degrees of elevation were linked to impingement signs (impingement study 2014)."
      },
      {
        "id": "m2",
        "mistake": "Hands leading the elbows, wrists curling up",
        "fix": "Think \"elbows up and out\"; the wrists stay below the elbows and roughly straight."
      },
      {
        "id": "m3",
        "mistake": "Leaning back and swinging",
        "fix": "Stand tall with the ribs down; use a lighter weight."
      },
      {
        "id": "m4",
        "mistake": "Hands too close together",
        "fix": "Keep the hands about shoulder width (wider grips used more deltoid and trapezius, less biceps)."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction (elbow height)",
        "setup": "≈13° (arms long)",
        "peak": "≈82° (elbow -2 cm vs the shoulder joint, 18.7 cm above the wrist)",
        "norm": "Stop at about 90 degrees of elevation, elbows at shoulder height; rows above 90 degrees were associated with impingement signs (impingement study 2014; Schoenfeld 2011)",
        "sources": [
          "impinge2014",
          "schoenfeld2011"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈0°",
        "peak": "≈107°",
        "norm": "Arms long at the bottom; elbows bent about 90-110 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hand path",
        "setup": "hands 41 cm apart in front of the thighs",
        "peak": "hands 46 cm apart, 21 cm below the shoulder joints (lower chest), rise 30 cm",
        "norm": "Hands travel straight up close to the body, about shoulder width apart; wider grips raised deltoid and trapezius activity (grip width study 2013)",
        "sources": [
          "gripwidth2013"
        ]
      },
      {
        "measure": "Trunk",
        "setup": "upright, knees ≈5°",
        "peak": "unchanged (no lean back)",
        "norm": "Upright and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the thighs",
        "peak": "1.4 s up, 0.4 s at the top, 2.0 s down",
        "norm": "Controlled, about 1-2 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #043712, Dumbbell Upright Row, video (movement reference)",
        "url": "https://gymvisual.com/videos/5058-dumbbell-upright-row.html"
      },
      {
        "id": "gripwidth2013",
        "title": "Effect of grip width on electromyographic activity during the upright row (J Strength Cond Res 2013;27(1):181-187, PubMed 22362088)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/22362088/"
      },
      {
        "id": "impinge2014",
        "title": "Characteristics of shoulder impingement in the recreational weight-training population (J Strength Cond Res 2014;28(4):1081-1089, PubMed 24077379)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/24077379/"
      },
      {
        "id": "schoenfeld2011",
        "title": "Schoenfeld, Kolber & Haimes 2011, the upright row: implications for preventing subacromial impingement (Strength Cond J 33(5):25-28)",
        "url": "https://scholars.nova.edu/en/publications/the-upright-row-implications-for-preventing-subacromial-impingeme/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Keep the elbows at or below shoulder height; people with shoulder impingement may need to skip this exercise or use a lateral raise instead (Schoenfeld 2011)."
      ],
      "modify": [
        "Pinching at the top: stop lower (elbows below shoulder height) and keep the hands a little wider.",
        "Wrist discomfort: let the wrists stay straight and the dumbbells turn slightly."
      ],
      "regressions": [
        "Lighter dumbbells and a shorter range.",
        "Dumbbell lateral raise (no internal rotation at the top).",
        "Shrugs for the trapezius."
      ],
      "progressions": [
        "Slower lowering (3 s).",
        "Pause for 1 s at the top.",
        "High pull from the hang (power variation, with coaching)."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Lifts the elbows out and up. Deltoid activity rose with grip width in the barbell upright row (grip width study 2013); dumbbells let the hands sit about shoulder width.",
      "lat_deltoid_l": "Lifts the elbows out and up. Deltoid activity rose with grip width in the barbell upright row (grip width study 2013); dumbbells let the hands sit about shoulder width.",
      "upper_traps_r": "Elevates and upwardly rotates the shoulder blades as the elbows rise; trapezius activity also rose with a wider grip (grip width study 2013).",
      "upper_traps_l": "Elevates and upwardly rotates the shoulder blades as the elbows rise; trapezius activity also rose with a wider grip (grip width study 2013).",
      "ant_deltoid_r": "Helps lift the arm, more so if the dumbbells drift forward.",
      "ant_deltoid_l": "Helps lift the arm, more so if the dumbbells drift forward.",
      "biceps_r": "Bends the elbow; a narrow grip used the biceps more and the deltoids less (grip width study 2013).",
      "biceps_l": "Bends the elbow; a narrow grip used the biceps more and the deltoids less (grip width study 2013).",
      "serratus_r": "Upward rotation of the shoulder blade with the trapezius.",
      "serratus_l": "Upward rotation of the shoulder blade with the trapezius.",
      "forearm_flexors_r": "Grip on the handles.",
      "forearm_flexors_l": "Grip on the handles.",
      "post_deltoid_r": "Pulls the elbows out and slightly back; posterior deltoid activity differed with grip width (grip width study 2013).",
      "post_deltoid_l": "Pulls the elbows out and slightly back; posterior deltoid activity differed with grip width (grip width study 2013).",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred while the arm is turned in.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred while the arm is turned in.",
      "core": "Keeps the trunk upright: no leaning back to swing the weights.",
      "spinal_extensors_r": "Hold the spine tall against the load in front.",
      "spinal_extensors_l": "Hold the spine tall against the load in front."
    }
  },
