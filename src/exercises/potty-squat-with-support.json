  "exercise": {
    "id": "potty-squat-with-support",
    "name": "Potty Squat with Support",
    "aliases": [
      "Supported deep squat",
      "Assisted toilet squat",
      "Rack-supported deep squat",
      "Holding-on deep squat"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "17611",
      "title": "Potty Squat with Support",
      "url": "https://gymvisual.com/videos/17611-potty-squat-with-support.html",
      "listing": "Video (movement reference; the page could not be read at authoring time: gymvisual.com is blocked by the proxy, so the movement comes from the name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Calves"
    ],
    "equipment": [
      "Squat stand or rack uprights (any sturdy support at about waist height)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip, knee and ankle; full depth, hands on a fixed support)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "hamstrings_r",
        "hamstrings_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core",
        "glute_med_r",
        "glute_med_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "lats_r",
        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as you sit down, hold briefly at the bottom, breathe out as you stand.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "2 s down, brief pause in the deep squat, about 1 s up",
      "frequency": "2-4 times a week",
      "progression": "Lighter grip on the support, then the free potty squat."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Face the uprights, grip one with each hand at about waist height, feet a little wider than the shoulders, toes out."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and sit straight down between the heels, letting the arms reach forward to the support."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause deep with the heels down and the chest up; the hands only steady you."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive through the whole foot to stand, pulling lightly on the support only if needed."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, hands still on the uprights."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hauling yourself up with the arms",
        "fix": "Let the legs do the work; the support is for balance."
      },
      {
        "id": "m2",
        "mistake": "Heels lifting at the bottom",
        "fix": "Sit back into the support and widen the stance a little."
      },
      {
        "id": "m3",
        "mistake": "Knees caving inward",
        "fix": "Push the knees out over the 2nd-3rd toe."
      },
      {
        "id": "m4",
        "mistake": "Back rounding at the bottom",
        "fix": "Keep the chest up and stop where the back stays neutral."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "42 cm, toes out 25°",
        "peak": "Unchanged",
        "norm": "A little wider than the shoulders with the toes turned out suits a deep squat (Lorenzetti 2018)",
        "sources": [
          "lorenzetti2018"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈3°",
        "peak": "≈125°",
        "norm": "Well past thighs-parallel; depth comes mostly from knee range of motion (Zawadka 2020)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈1°",
        "peak": "≈138° (joint channel)",
        "norm": "Deep hip flexion with the pelvis between and behind the heels (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈14° forward (more upright than the free potty squat)",
        "norm": "Upright; holding a support lets the hips sit further back with less trunk lean (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Support",
        "setup": "Both hands on the uprights 95 cm up, 50.7 cm apart",
        "peak": "Hands stay put; arms reach forward as the hips sit back (centre of mass -12.5 cm from the ankles)",
        "norm": "Hands steady the body without lifting it (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.5 s pause, 1.2 s up, 1.5 s reset",
        "norm": "2 s down, about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #17611, Potty Squat with Support, video (movement reference)",
        "url": "https://gymvisual.com/videos/17611-potty-squat-with-support.html"
      },
      {
        "id": "zawadka2020",
