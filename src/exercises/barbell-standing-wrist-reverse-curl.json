    "id": "barbell-standing-wrist-reverse-curl",
    "name": "Barbell Standing Wrist Reverse Curl",
    "aliases": [
      "Standing reverse barbell wrist curl",
      "Standing palms-down barbell wrist curl",
      "Standing barbell wrist extension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15742",
      "title": "Barbell Standing Wrist Reverse Curl",
      "url": "https://gymvisual.com/videos/15742-barbell-standing-wrist-reverse-curl.html",
      "listing": "Video (title from the listing URL; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Forearms",
    "equipment": [
      "Barbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (wrist)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "breathing": {
      "pattern": "Exhale as the hands curl, inhale as they lower.",
      "cadence": "About 1 s up, 0.4 s squeeze, 1.7 s down"
    },
    "secondaryBodyParts": [
      "Shoulders"
    ],
    "muscles": {
      "target": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "core"
      ]
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "load": "Bar load is user-chosen: pick a weight you can control through the full range for every rep with 1-3 reps in reserve (RPE 7-9). Expect to use a lighter bar than for the palms-up wrist curl (clinical opinion).",
      "tempo": "1-0-2-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, then a slower lowering, then a heavier bar"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width; hold the bar in front of the thighs with an overhand grip (palms facing the thighs), hands about shoulder width, arms straight."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and lift the knuckles, bending the wrists back so the bar rises forward."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze; the arms stay straight and still."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the wrists bend forward a little."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Shoulders down, chest up; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the elbows to lift the bar",
        "fix": "Arms straight; only the wrists move."
      },
      {
        "id": "m2",
        "mistake": "Swinging the bar with the shoulders",
        "fix": "Keep the arms still, hanging just in front of the thighs."
      },
      {
        "id": "m3",
        "mistake": "Too heavy a bar, so the range shrinks",
        "fix": "Lighter bar, full range."
      }
    ],
    "kinematics": [
      {
        "measure": "Wrist extension/flexion",
        "setup": "20° flexion (bar low, wrists bent forward a little)",
        "peak": "45° extension at the top (arc ≈65°)",
        "norm": "Healthy adults used up to about 54 degrees of wrist flexion and 60 degrees of extension in daily tasks, functional range about 40 each way (Ryu 1991); a curl goes a little further, to a comfortable end range without pain (clinical opinion)",
        "sources": [
          "ryu1991"
        ]
      },
      {
        "measure": "Arm position",
        "setup": "Elbows ≈4° (straight); arms ≈15° in front of vertical",
        "peak": "Unchanged (elbows and wrists move 0 cm over the loop)",
        "norm": "Arms straight, hanging just in front of the thighs, still throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar clearance",
        "setup": "Bar 13.6 cm in front of the hip line (handle points); grip 42 cm between the handle points",
        "peak": "At least 0.82 cm off the body over the loop (rig shapes, nearest quad_l)",
        "norm": "The bar stays just clear of the thighs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bottom 0.5 s",
        "peak": "1 s up, 0.4 s squeeze, 1.7 s down, 0.4 s at the bottom",
        "norm": "Slow and controlled, about 1 s up, a short squeeze and 1.5-2 s down (clinical opinion); resistance programmes for the wrist extensors in tendinopathy used 1-4 sets of about 15 reps, with no optimal dose defined (J Hand Ther 2012)",
        "sources": [
          "jht2012"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15742, Barbell Standing Wrist Reverse Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/15742-barbell-standing-wrist-reverse-curl.html"
      },
      {
        "id": "ryu1991",
        "title": "Ryu, Cooney, Askew, An and Chao 1991, functional ranges of motion of the wrist joint (J Hand Surg Am 16(3):409-419; 40 adults, biaxial wrist electrogoniometer)",
        "url": "https://mayoclinic.elsevierpure.com/en/publications/functional-ranges-of-motion-of-the-wrist-joint/"
      },
      {
