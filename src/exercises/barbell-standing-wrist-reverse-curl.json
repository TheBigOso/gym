        "url": "https://pubmed.ncbi.nlm.nih.gov/15320673/"
      }
    ],
    "safety": {
      "cautions": [
        "Pain on the outside of the elbow (tennis elbow): use a light bar and a slow lowering, and get it assessed if it does not settle (clinical opinion).",
        "Wrist or elbow pain: use a lighter bar and a shorter range; stop if pain persists (clinical opinion).",
        "Lift the bar from a rack or the floor with a flat back and bent knees, and set it down the same way.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Seated reverse wrist curl with the forearms on the thighs.",
        "Dumbbells, one arm at a time."
      ],
      "regressions": [
        "Empty bar or a light fixed barbell.",
        "Seated dumbbell reverse wrist curl."
      ],
      "progressions": [
        "Heavier bar.",
        "Slower lowering (3 s).",
        "Pause at the top."
      ]
    },
    "muscleNotes": {
      "forearm_extensors_r": "Lift the hands back against the bar (wrist extension); resistance programmes for the wrist extensors are a common part of lateral elbow pain rehabilitation (J Hand Ther 2012).",
      "forearm_extensors_l": "Lift the hands back against the bar (wrist extension); resistance programmes for the wrist extensors are a common part of lateral elbow pain rehabilitation (J Hand Ther 2012).",
      "forearm_flexors_r": "Finger flexors hold the bar.",
      "forearm_flexors_l": "Finger flexors hold the bar.",
      "ant_deltoid_r": "Holds the straight arms just in front of the thighs (clinical opinion).",
      "ant_deltoid_l": "Holds the straight arms just in front of the thighs (clinical opinion).",
      "upper_traps_r": "Carry the bar on the shoulders (clinical opinion).",
      "upper_traps_l": "Carry the bar on the shoulders (clinical opinion).",
      "core": "Keeps the trunk tall."
    }
