    "breathing": {
      "pattern": "Inhale as you lower the dumbbells, exhale as you press them up.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "Add reps up to the top of the range, then move to the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Back pad at 30 degrees, glutes in the crease, feet planted; dumbbells up over the shoulders, palms toward the feet."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the dumbbells, turning the palms in as they come down so the handles end along the body."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbells beside the upper chest, palms facing each other, elbows about 30 degrees from the sides; brief pause."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press up, turning the palms to face the feet as the arms straighten."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight over the shoulders, palms forward; pause, then lower again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting with the wrists only",
        "fix": "Turn the whole forearm smoothly through the press, wrists straight."
      },
      {
        "id": "m2",
        "mistake": "Rushing the turn at the end",
        "fix": "Spread the rotation over the whole press."
      },
      {
        "id": "m3",
        "mistake": "Elbows flaring out at the bottom",
        "fix": "Start with the elbows tucked and let them open a little as you press."
      },
      {
        "id": "m4",
        "mistake": "Hips lifting off the seat",
        "fix": "Keep the glutes in the crease and the feet planted."
      }
    ],
    "kinematics": [
      {
        "measure": "Grip rotation",
        "setup": "Pronated at the top (forearm pronation 113)",
        "peak": "Neutral beside the chest (pronation 54): about 59° of turn",
        "norm": "Neutral (palms facing) at the bottom, pronated (palms toward the feet) at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (arms straight, not locked)",
        "peak": "≈115° at the bottom",
        "norm": "Straight but not locked at the top; about 90-110 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck",
        "setup": "Arms vertical over the shoulders",
        "peak": "≈32° from the trunk at the bottom; upper arm ≈6° below the back plane",
        "norm": "About 25-40 degrees from the trunk at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bench angle",
        "setup": "30° back pad, flat seat",
        "peak": "Glutes in the crease, upper back and head on the pad",
        "norm": "30-degree back pad (Rodríguez-Ridao 2020)",
        "sources": [
          "rodriguez2020"
        ]
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat, knees about 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up, 0.7 s at the top",
        "norm": "About 2 s down, a short pause, 1-1.5 s up (clinical opinion)",
        "sources": []
      }
