    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Check the bar is secure and can take your weight before hanging from it.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The very wide grip loads the shoulders and elbows: build up from regular wide-grip pull-ups first.",
        "Step or drop down from the bar with control; do not let go at the top."
      ],
      "modify": [
        "Bend the assisting arm a little more to share the load.",
        "Use a band under the knees for assistance."
      ],
      "regressions": [
        "Wide-grip pull-up.",
        "Archer inverted row.",
        "Assisted archer pull-up (band)."
      ],
      "progressions": [
        "Slow lowering on the working arm.",
        "Typewriter pull-up (traverse along the bar at the top).",
        "One-arm pull-up negatives."
      ]
    },
    "muscleNotes": {
      "lats_r": "Main mover on the working side: pull the upper arm down to the ribs. The assisting side helps push down with a straight arm.",
      "lats_l": "Main mover on the working side: pull the upper arm down to the ribs. The assisting side helps push down with a straight arm.",
      "biceps_r": "Bend the elbows (with the brachialis underneath).",
      "biceps_l": "Bend the elbows (with the brachialis underneath).",
      "rhomboids_midtrap_r": "Pull the shoulder blades down and together as you rise.",
      "rhomboids_midtrap_l": "Pull the shoulder blades down and together as you rise.",
      "post_deltoid_r": "Help pull the arms down and back.",
      "post_deltoid_l": "Help pull the arms down and back.",
      "pec_r": "Lower fibres help pull the arms down from overhead.",
      "pec_l": "Lower fibres help pull the arms down from overhead.",
      "forearm_flexors_r": "Grip the bar.",
      "forearm_flexors_l": "Grip the bar.",
      "core": "Brace so the body hangs in one line without swinging.",
      "obliques_r": "Brace the trunk so the legs do not swing.",
      "obliques_l": "Brace the trunk so the legs do not swing.",
      "triceps_r": "Keeps the assisting arm straight; the long head helps pull the arm down.",
      "triceps_l": "Keeps the assisting arm straight; the long head helps pull the arm down.",
      "infraspinatus_r": "Steadies the shoulder joint.",
      "infraspinatus_l": "Steadies the shoulder joint.",
      "serratus_r": "Controls the shoulder blade in the hang.",
      "serratus_l": "Controls the shoulder blade in the hang.",
      "hip_flexors_r": "Hold the legs steady.",
      "hip_flexors_l": "Hold the legs steady."
    }
