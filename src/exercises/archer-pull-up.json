        "serratus_l",
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull toward one hand, breathe in on the way down.",
      "cadence": "About 1.3 s up, 1.8 s down on each side"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "2-6 each side",
      "tempo": "About 1.3 s up, brief hold, 1.8 s down",
      "load": "Body weight",
      "frequency": "1-3 times a week",
      "progression": "More reps each side, then a slower lowering, then one-arm pull-up work"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hang from the bar with a very wide overhand grip, arms straight."
      },
      {
        "id": "c2",
        "phase": "set",
        "text": "Pull the shoulder blades down first."
      },
      {
        "id": "c3",
        "phase": "pullR",
        "text": "Pull up toward the right hand: right elbow bends and drives down, left arm stays straight and slides out along the bar."
      },
      {
        "id": "c4",
        "phase": "topR",
        "text": "Chin over the bar beside the right hand; left arm long and straight."
      },
      {
        "id": "c5",
        "phase": "lowerR",
        "text": "Lower under control back to the centre and the full hang."
      },
      {
        "id": "c6",
        "phase": "hang",
        "text": "Reset in the middle with straight arms."
      },
      {
        "id": "c7",
        "phase": "pullL",
        "text": "Now pull toward the left hand, right arm straight."
      },
      {
        "id": "c8",
        "phase": "topL",
        "text": "Chin over the bar beside the left hand."
      },
      {
        "id": "c9",
        "phase": "lowerL",
        "text": "Lower slowly to the centre."
      },
      {
        "id": "c10",
        "phase": "reset",
        "text": "Full hang, then repeat to the right."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the straight arm",
        "fix": "Keep the assisting elbow straight; it pushes the bar out and down, it does not pull."
      },
      {
        "id": "m2",
        "mistake": "Grip too narrow",
        "fix": "Take the hands well wider than the shoulders so the straight arm can reach out."
      },
      {
        "id": "m3",
        "mistake": "Twisting or kipping",
        "fix": "Keep the hips square and the legs quiet."
      },
      {
        "id": "m4",
        "mistake": "Not reaching the top",
        "fix": "Chin over the bar next to the working hand each rep."
      },
      {
        "id": "m5",
        "mistake": "Dropping from the top",
        "fix": "Control the way down to the centre."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈12° in the dead hang",
        "peak": "Working elbow ≈146°, assisting elbow ≈14° at the top",
        "norm": "Working arm from nearly straight to well bent; the assisting arm stays nearly straight (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Grip width",
        "setup": "Overhand, grip points 90 cm apart (shoulder joints 39 cm): about 228% of shoulder width",
        "peak": "Unchanged (hands planted on the bar)",
        "norm": "Very wide overhand grip, about twice shoulder width (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Body shift",
        "setup": "Centred under the bar in the hang",
        "peak": "Pelvis ≈23 cm toward the working hand",
        "norm": "The body travels sideways toward the working hand (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Chin height",
        "setup": "Chin 46 cm below the bar in the hang",
        "peak": "Chin 2.2 cm above the bar beside the working hand",
        "norm": "Chin clears the bar beside the working hand (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s, set 0.3 s",
        "peak": "About 1.3 s up, 0.4 s hold, 1.8 s down on each side",
        "norm": "Controlled, about 1.3 s up and 1.8 s down (clinical opinion)",
        "sources": []
      }
    ],
