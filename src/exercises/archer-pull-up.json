    "equipment": [
      "Pull-up bar"
    ],
    "difficulty": "Advanced",
    "mechanics": "Compound (shoulder adduction and extension, scapular depression, elbow flexion), one arm working while the other assists straight",
    "plane": "Frontal",
    "laterality": "Alternating (one rep to the right, one to the left in each loop)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l"
      ],
