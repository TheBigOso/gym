    "breathing": {
      "pattern": "Inhale and brace as you lower, exhale as you press.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-10",
      "tempo": "2-1-1-0 (a short pause at the bottom)",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9). Use about 10-20% less than for a regular dumbbell press at first (clinical opinion).",
      "progression": "More reps, a longer pause, then the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench with the glutes near its end; straighten the legs out in front and hold the feet just off the floor. Dumbbells over the shoulders, palms toward the feet."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Brace hard and lower the dumbbells beside the chest, elbows about 45-60 degrees from the body; legs stay still."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Brief pause at the bottom without rocking or arching."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Press up and slightly in with the chest and arms only: no leg drive."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight over the shoulders, legs still hovering; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the back to make up for the missing leg drive",
        "fix": "Keep the ribs down and the glutes on the bench; a flat, braced trunk is the point."
      },
      {
        "id": "m2",
        "mistake": "Feet touching down to regain balance",
        "fix": "Lighten the dumbbells until you can keep the legs still."
      },
      {
        "id": "m3",
        "mistake": "Elbows flared to 90 degrees",
        "fix": "Keep them about 45-60 degrees from the body."
      },
      {
        "id": "m4",
        "mistake": "Rocking side to side",
        "fix": "Lower slowly and evenly with both arms."
      },
      {
        "id": "m5",
        "mistake": "Bouncing at the bottom",
        "fix": "Pause briefly, then press."
      }
    ],
    "kinematics": [
      {
        "measure": "Leg position",
        "setup": "Legs straight (knee ≈4°), ≈13° below horizontal, heels about 25.8 cm off the floor",
        "peak": "Unchanged: no foot contact and no leg drive",
        "norm": "Legs straight and held off the floor, no foot support (clinical opinion; Muyor 2019 tested a feet-suspended position with the hips flexed and knees at 90 degrees, not extended legs)",
        "sources": [
          "muyor2019"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈7° (arms straight, not locked)",
        "peak": "≈109° at the bottom",
        "norm": "Arms straight at the top; dumbbells beside the chest at the bottom, elbows roughly 90-110 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare",
        "setup": "Arms vertical over the shoulders",
        "peak": "≈55° at the bottom",
        "norm": "About 45-60 degrees from the body at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm depth",
        "setup": "–",
        "peak": "≈22° below the back plane",
        "norm": "Upper arms about level with, or a little below, the back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell path",
        "setup": "Top: dumbbells 13.7 cm apart over the shoulders",
        "peak": "Bottom: centres 77 cm apart beside the chest, rise 32.1 cm",
        "norm": "Forearms vertical; the dumbbells rise and come slightly together over the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up, 0.7 s at the top",
        "norm": "Controlled, with a short pause at the bottom; Muyor 2019 used 2 s down and 2 s up at 60% 1RM",
        "sources": [
          "muyor2019"
        ]
      }
    ],
    "sources": [
      {
