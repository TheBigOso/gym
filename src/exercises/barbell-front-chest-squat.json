    "breathing": {
      "pattern": "Big breath in and brace at the top, hold it on the way down and through the bottom, breathe out as you pass the hardest part of the rise.",
      "cadence": "About 2 s down, a short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "3-8",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "load": "Barbell load is user-chosen: usually about 80-85% of your back squat. Leave about 2-3 reps in reserve (RPE 7-8).",
      "rest": "2-3 minutes between sets",
      "progression": "Add 2.5 kg when every rep reaches full depth with the elbows staying up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar across the front of the shoulders against the throat, fingertips under the bar just outside the shoulders, elbows high and forward. Step back, feet about shoulder width, toes out a little."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Brace and sit straight down between the heels, elbows up, chest tall, knees forward and out."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Hips below the knees, elbows still high, back flat."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive up leading with the elbows and chest; breathe out as you pass the hardest part."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, re-brace."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows dropping so the bar rolls forward",
        "fix": "Lead with the elbows: think of pushing them up to the ceiling as you rise."
      },
      {
        "id": "m2",
        "mistake": "Holding the bar with the palms instead of resting it on the shoulders",
        "fix": "Let the bar sit on the front delts; the fingers only keep it in place."
      },
      {
        "id": "m3",
        "mistake": "Rounding the upper back",
        "fix": "Lighter bar; keep the chest tall and the upper back tight."
      },
      {
        "id": "m4",
        "mistake": "Heels lifting",
        "fix": "Keep the whole foot down; work on ankle mobility or use lifting shoes."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width",
        "setup": "44 cm between the ankle centres, toes out 25°",
        "peak": "Unchanged (feet planted)",
        "norm": "About hip to shoulder width, toes out about 20-30 degrees (Lorenzetti 2018)",
        "sources": [
          "lorenzetti2018"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈2°",
        "peak": "≈120°; hip joints 10.9 cm below the knee joints; ankle dorsiflexion ≈28°",
        "norm": "Full depth, about 115-130 degrees (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈-7°",
        "peak": "≈125° (joint channel)",
        "norm": "Less hip flexion than a back squat at the same depth (Gullett 2009)",
        "sources": [
          "frontsquat2009"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈18° forward of vertical; bar 2.4 cm from mid-foot",
        "norm": "More upright than a back squat (Gullett 2009)",
        "sources": [
          "frontsquat2009"
        ]
      },
      {
        "measure": "Front rack",
        "setup": "Bar across the front delts in the fingers, 66 cm between the hands; elbows 18 cm in front of the shoulders, wrists extended 90°",
        "peak": "Unchanged: the bar rides with the trunk (grip width 65.62-65.62 cm)",
        "norm": "Bar on the front delts against the throat, elbows high (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
