    "safety": {
      "cautions": [
        "Squat inside a rack with the safety arms set just below your bottom position; to bail, push the bar forward off the shoulders and step back.",
        "Wrist or elbow discomfort in the rack: widen the grip or let only two fingers hold the bar.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Limited wrist mobility: a wider grip, or straps around the bar.",
        "Knee pain: squat to a box at a pain-free depth."
      ],
      "regressions": [
        "Goblet squat.",
        "Dumbbell front squat."
      ],
      "progressions": [
        "Heavier bar.",
        "Pause front squat.",
        "Barbell clean into a front squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Main movers: the front rack keeps the trunk upright and the knees forward, with knee extensor demand similar to a back squat at a lighter load (Gullett 2009).",
      "quads_l": "Main movers: the front rack keeps the trunk upright and the knees forward, with knee extensor demand similar to a back squat at a lighter load (Gullett 2009).",
      "glute_max_r": "Extends the hip out of the bottom of the squat.",
      "glute_max_l": "Extends the hip out of the bottom of the squat.",
      "adductors_r": "Help extend the hip from the bottom.",
      "adductors_l": "Help extend the hip from the bottom.",
      "hamstrings_r": "Assist hip extension; their length changes little in a squat.",
      "hamstrings_l": "Assist hip extension; their length changes little in a squat.",
      "spinal_extensors_r": "Hold the upper back upright so the bar does not roll forward; less compressive load than a back squat (Gullett 2009).",
      "spinal_extensors_l": "Hold the upper back upright so the bar does not roll forward; less compressive load than a back squat (Gullett 2009).",
      "calves_r": "Control the forward travel of the knees over the planted feet.",
      "calves_l": "Control the forward travel of the knees over the planted feet.",
      "core": "Bracing stiffens the trunk under the bar.",
      "obliques_r": "Part of the brace.",
      "obliques_l": "Part of the brace.",
      "glute_med_r": "Keeps the knees tracking over the feet.",
      "glute_med_l": "Keeps the knees tracking over the feet.",
      "upper_traps_r": "Raise the shoulders to make the shelf the bar rests on.",
      "upper_traps_l": "Raise the shoulders to make the shelf the bar rests on.",
      "rhomboids_midtrap_r": "Keep the upper back tight and upright under the bar.",
      "rhomboids_midtrap_l": "Keep the upper back tight and upright under the bar.",
      "lats_r": "Pull the bar down into the back and keep the upper back tight.",
      "lats_l": "Pull the bar down into the back and keep the upper back tight.",
      "forearm_flexors_r": "Fingers hold the bar in place on the shoulders.",
      "forearm_flexors_l": "Fingers hold the bar in place on the shoulders.",
      "ant_deltoid_r": "The front of the shoulders forms the shelf; holds the elbows up.",
      "ant_deltoid_l": "The front of the shoulders forms the shelf; holds the elbows up."
    }
