      },
      {
        "id": "callaghan1998",
        "title": "Callaghan, Gunning and McGill 1998, the relationship between lumbar spine load and muscle activity during extensor exercises (Phys Ther 78(1):8-18)",
        "url": "https://doi.org/10.1093/ptj/78.1.8"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Lying head-down raises pressure in the head; get up slowly after the set.",
        "Back pain or disc problems: keep the range small and avoid arching past neutral (McGill 1998).",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Smaller range: hinge only to about 45 degrees."
      ],
      "regressions": [
        "Floor back extension (prone).",
        "Hip hinge with a dowel."
      ],
      "progressions": [
        "Slower lowering.",
        "Heavier plate or dumbbell at the chest."
      ]
    },
    "muscleNotes": {
      "spinal_extensors": "Erector spinae hold and then extend the trunk against gravity; back extensions on a 45-degree bench are a classic extensor exercise (Edelburg 2017; Callaghan 1998).",
      "glute_max": "Gluteus maximus extends the hips from the hinge back to the line.",
      "hamstrings": "The hamstrings work as hip extensors and lengthen at the bottom."
    }
