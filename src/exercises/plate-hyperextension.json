  "exercise": {
    "id": "plate-hyperextension",
    "name": "Plate Hyperextension",
    "aliases": [
      "Weighted 45-degree back extension",
      "Plate-loaded back extension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "022689",
      "title": "Plate Hyperextension",
      "url": "https://gymvisual.com/videos/22689-plate-hyperextension.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lower back, glutes, hamstrings)",
    "secondaryBodyParts": [
      "Glutes",
      "Hamstrings"
    ],
    "equipment": [
      "45-degree hyperextension bench",
      "Weight plate"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip extension, spinal extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "core",
        "calves_r",
        "calves_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "biceps_r",
        "biceps_l",
        "pec_r",
        "pec_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale on the way down, exhale as you raise the trunk.",
      "cadence": "About 2 s down, a short pause, about 1.8 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "tempo": "2 s down, brief pause, 1.5-2 s up; no swinging",
      "frequency": "2-3 times a week",
      "progression": "Body weight with arms crossed, then a light plate or dumbbell at the chest, then a heavier load or slower tempo"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the pad just below the hip crease, soles flat on the foot plate under the heel roller, legs straight; hug a plate flat against the chest, hands at its sides."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and hinge down at the hips under control until the trunk points nearly straight down."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause briefly at the bottom; keep the neck long."
      },
      {
        "id": "c4",
        "phase": "raise",
        "text": "Squeeze the glutes and back extensors and raise the trunk back to the leg line, breathing out."
      },
      {
        "id": "c5",
        "phase": "top",
        "text": "Stop with the body in one straight line; do not arch past it."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching past the leg line at the top",
        "fix": "Stop with the body straight; the extra arch only loads the low back."
      },
      {
        "id": "m2",
        "mistake": "Pad set too high (on the stomach)",
        "fix": "Set the top edge just below the hip crease so the hips can hinge."
      },
      {
        "id": "m3",
        "mistake": "Swinging up with momentum",
        "fix": "Raise in about 2 s and pause at the top."
      },
      {
        "id": "m4",
        "mistake": "Craning the neck to look forward",
        "fix": "Keep the head in line with the trunk."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈-1° (body in one line along the 45° bench)",
        "peak": "≈79° at the bottom",
        "norm": "Hinge to about 80-90 degrees of hip flexion at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar flexion",
        "setup": "0° (neutral, no arching past the line)",
        "peak": "≈20° (L5 and T12 segments) at the bottom",
        "norm": "Some rounding at the bottom; neutral at the top, no hyperextension (McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Trunk to the leg line",
        "setup": "≈5°",
        "peak": "≈90° (trunk ≈45° from straight down)",
        "norm": "Back to the leg line at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip pad",
        "setup": "Pad top edge 16 cm below the hip joints along the leg line; thighs on the pad",
        "peak": "Hip joints move ≤0 cm; thigh-to-pad gap -0.2 to -0.2 cm",
        "norm": "Pad below the hip crease so the pelvis is free to rotate (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Crossed on the chest",
        "peak": "Fixed to the chest through the rep",
        "norm": "Arms crossed or holding the load at the chest (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #022689, Plate Hyperextension, video (movement reference)",
