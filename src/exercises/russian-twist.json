  "exercise": {
    "id": "russian-twist",
    "name": "Russian Twist",
    "aliases": [
      "Seated twist",
      "Seated Russian twist",
      "Bodyweight Russian twist"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "068712",
      "title": "Russian Twist",
      "url": "https://gymvisual.com/videos/7448-russian-twist.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Abdominals",
      "Hip flexors"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (trunk rotation in a leaned-back sit)",
    "plane": "Transverse",
    "laterality": "Bilateral, alternating sides",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "core"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you turn to each side, breathe in through the middle. Breathe steadily; do not hold the breath.",
      "cadence": "About 1.2-1.4 s per side"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-20 total turns (5-10 per side)",
      "tempo": "Controlled, about 1-1.5 s per side; slower is harder",
      "frequency": "2-3 times a week",
      "progression": "Feet lifted (harder balance), then a light medicine ball or plate held at the chest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with knees bent and heels on the floor. Lean back to about 45 degrees with a long spine, chest lifted, hands together in front of the chest."
      },
      {
        "id": "c2",
        "phase": "turnR",
        "text": "Breathe out and turn the ribs and shoulders to the right, hands following toward the floor beside the hip."
      },
      {
        "id": "c3",
        "phase": "turnL",
        "text": "Turn through the middle to the left; the hips and knees stay still."
      },
      {
        "id": "c4",
        "phase": "turnR2",
        "text": "Move from the upper back, eyes following the hands."
      },
      {
        "id": "c5",
        "phase": "turnL2",
        "text": "Stay tall: do not let the low back slump into a C shape."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Return to the middle and sit tall."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the low back into a slump",
        "fix": "Sit taller and lean back less; lift the chest."
      },
      {
        "id": "m2",
        "mistake": "Swinging the arms while the trunk stays still",
        "fix": "Keep the hands in front of the chest; turn the ribs and shoulders."
      },
      {
        "id": "m3",
        "mistake": "Knees falling side to side",
        "fix": "Squeeze the knees together; the pelvis stays still."
      },
      {
        "id": "m4",
        "mistake": "Going fast with momentum (especially with a weight)",
        "fix": "Slow, controlled turns; pause briefly at each side."
      },
      {
        "id": "m5",
        "mistake": "Holding the breath",
        "fix": "Exhale on each turn."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk lean",
        "setup": "≈45° back from vertical (pelvis to C7)",
        "peak": "Held through the turns",
        "norm": "About 45 degrees back from vertical (common description; clinical opinion)",
        "sources": [
          "lesmills"
        ]
      },
      {
        "measure": "Trunk rotation",
        "setup": "Facing the knees",
        "peak": "≈46° each way (lumbar ≈5°, thoracic ≈41°), head turns with the hands",
        "norm": "Mostly thoracic; lumbar segments allow only a few degrees of rotation each (expert opinion, Les Mills); end-range lumbar twisting under flexion is the concern (Marshall and McGill 2010)",
        "sources": [
          "lesmills",
          "marshall2010"
        ]
      },
      {
        "measure": "Knees and hips",
        "setup": "Knees ≈95°, hips ≈77°, feet flat (heels down)",
        "peak": "Feet and pelvis do not move",
        "norm": "Knees bent, heels on the floor for the standard bodyweight version; feet lifted is the harder version (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hands",
        "setup": "Together 42 cm in front of the upper chest, elbows ≈87°",
        "peak": "Beside the hip, 26 cm above the floor",
        "norm": "Together in front of the chest, travel with the trunk to beside each hip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Sit 0.8 s",
        "peak": "About 1.35 s per side with a short pause, 4 turns per 7.6 s loop",
        "norm": "Controlled, no momentum (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #068712, Russian Twist, video (movement reference)",
        "url": "https://gymvisual.com/videos/7448-russian-twist.html"
      },
      {
        "id": "torso2015",
        "title": "Torso-twist exercise with elastic resistance vs a training machine: core muscle EMG (Scientifica 2015:403068; PubMed 26557405)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26557405/"
      },
      {
        "id": "oliva2020",
        "title": "Oliva-Lozano and Muyor 2020, core muscle activity during physical fitness exercises: a systematic review (Int J Environ Res Public Health 17(12):4306)",
        "url": "https://www.mdpi.com/1660-4601/17/12/4306"
      },
      {
        "id": "marshall2010",
        "title": "Marshall and McGill 2010, the role of axial torque in disc herniation (Clin Biomech 25:6-9), porcine model",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19815318/"
      },
      {
        "id": "lesmills",
        "title": "Les Mills, \"The ab exercise to avoid\" (Russian twist; expert opinion, no data)",
        "url": "https://www.lesmills.com/articles/the-ab-exercise-to-avoid"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "No peer-reviewed EMG study of the seated Russian twist was found; the muscle notes use standing torso-twist and twisting curl-up data.",
        "Repeated twisting combined with flexion promoted disc delamination in a porcine model (Marshall and McGill 2010), and some coaches advise avoiding the rounded, weighted version (Les Mills, expert opinion). Keep the spine long, the range moderate and the tempo slow.",
        "Disc herniation, flexion or rotation intolerance, osteoporosis: avoid; use a Pallof press or side plank instead."
      ],
      "modify": [
        "Low back discomfort: sit more upright (lean back less) and make the turn smaller.",
        "Hip flexors cramp: hold the backs of the thighs lightly, or lean back less."
      ],
      "regressions": [
        "More upright trunk, hands on the thighs.",
        "Smaller turns.",
        "Seated or half-kneeling Pallof press (anti-rotation)."
      ],
      "progressions": [
        "Feet lifted off the floor.",
        "Hold a light medicine ball or plate.",
        "Slower turns with a pause at each side."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Turn the trunk: the external oblique of one side works with the internal oblique of the other (turning right uses the left external and right internal oblique). In torso-twist training the external oblique reached about 54-77% MVC (Scientifica 2015, standing twists). A curl-up with a twist kept internal oblique activity near 57% MVIC (Crommert 2018, via Oliva-Lozano 2020).",
      "obliques_l": "Turn the trunk: the external oblique of one side works with the internal oblique of the other (turning right uses the left external and right internal oblique). In torso-twist training the external oblique reached about 54-77% MVC (Scientifica 2015, standing twists). A curl-up with a twist kept internal oblique activity near 57% MVIC (Crommert 2018, via Oliva-Lozano 2020).",
      "core": "Rectus abdominis and transversus abdominis hold the trunk leaned back at about 45 degrees and stop the low back sagging (clinical opinion).",
      "hip_flexors_r": "Iliopsoas holds the hips flexed so the trunk does not fall back (clinical opinion).",
      "hip_flexors_l": "Iliopsoas holds the hips flexed so the trunk does not fall back (clinical opinion).",
      "spinal_extensors_r": "Multifidus and the erectors keep the chest lifted and help control the rotation (clinical opinion; erector spinae reached about 32-50% MVC in torso twists, Scientifica 2015).",
      "spinal_extensors_l": "Multifidus and the erectors keep the chest lifted and help control the rotation (clinical opinion; erector spinae reached about 32-50% MVC in torso twists, Scientifica 2015)."
    }
  },
