        "biceps_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "triceps_r",
        "triceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "core"
      ],
      "lengthened": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the arms open, breathe out as you hug them back together.",
      "cadence": "About 2.2 s opening, short stretch, about 1.5 s closing"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "2-0.4-1.5-0.6 (open-stretch-close-squeeze, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can sweep through the full arc with the elbow bend unchanged.",
      "progression": "Add reps, then one plate on each stack; slower opening"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand between two towers with the pulleys a little above shoulder height, one D-handle in each hand, feet hip width, a slight forward lean; hands together in front of the chest, elbows softly bent."
      },
      {
        "id": "c2",
        "phase": "open",
        "text": "Breathe in and let the cables draw the arms open in a wide arc, elbow bend fixed, chest up."
      },
      {
        "id": "c3",
        "phase": "stretch",
        "text": "Stop with the hands about in line with the shoulders and a stretch across the chest, not in the front of the shoulder."
      },
      {
        "id": "c4",
        "phase": "close",
        "text": "Breathe out and hug the handles back together along the same arc, as if around a big tree."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the chest with the handles just apart in front of the breastbone; keep the shoulders down."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Turning the fly into a press",
        "fix": "Keep the same soft elbow bend all the way out and back."
      },
      {
        "id": "m2",
        "mistake": "Opening too far behind the body",
        "fix": "Stop with the hands about in line with the shoulders."
      },
      {
        "id": "m3",
        "mistake": "Shrugging or rolling the shoulders forward",
        "fix": "Shoulders down and back, chest up; lighten the stacks."
      },
      {
        "id": "m4",
        "mistake": "Rocking the trunk to swing the handles",
        "fix": "Brace, keep the lean fixed and move only at the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈20° (soft, fixed)",
        "peak": "≈20° in the stretch",
        "norm": "Fixed soft bend of about 20-30 degrees, as in the dumbbell fly protocol of Solstad 2020",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Arm opening",
        "setup": "Upper arm ≈-5° from straight ahead, hands 12.7 cm apart",
        "peak": "≈97° from straight ahead (hands about in line with the shoulders)",
        "norm": "From hands together in front of the chest to about in line with the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral: palms facing each other, handles vertical",
        "peak": "Palms forward in the stretch",
        "norm": "Neutral: palms facing each other in front, forward when open (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Cable",
        "setup": "Pulleys 172 cm high, 176 cm apart, 8 cm behind the hips",
        "peak": "Both cables clear of the body by at least 10.83 cm",
        "norm": "One cable per hand from its own pulley a little above shoulder height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "≈7° forward of vertical, knees soft",
        "peak": "Unchanged",
        "norm": "Slight forward lean, braced and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Squeeze 0.6 s with the hands together",
        "peak": "2.2 s opening, 0.4 s stretch, 1.5 s closing",
        "norm": "Controlled, about 2 s out and 1.5 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Standing Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/4279-cable-standing-fly.html"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      },
      {
        "id": "welsch2005",
        "title": "Welsch, Bird and Mayhew 2005, electromyographic activity of the pectoralis major and anterior deltoid muscles during three upper-body lifts (J Strength Cond Res 19(2):449-452)",
        "url": "https://www.bisp-surf.de/Record/PU201204002593"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can control through the whole arc without the elbows bending more.",
        "Do not let the cables pull the arms far behind the body: the stretched shoulder is the vulnerable position (clinical opinion).",
        "Take the handles one at a time and step forward into position; return them the same way rather than letting the stacks drop.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorten the arc so the hands stop in front of the shoulders.",
        "Balance: use a staggered stance with one foot forward."
      ],
      "regressions": [
        "Lighter stacks.",
        "Band chest fly.",
        "Machine pec deck."
      ],
      "progressions": [
        "Slower opening with a 1 s pause in the stretch.",
        "Heavier stacks.",
        "Cable low fly or decline fly for a different line of pull."
      ]
    },
    "muscleNotes": {
      "pec_r": "Prime mover: draws the arm across the body (horizontal adduction). Flyes and the bench press activated the pectoralis similarly in trained men (Solstad 2020); the cable keeps tension even with the hands together.",
      "pec_l": "Prime mover: draws the arm across the body (horizontal adduction). Flyes and the bench press activated the pectoralis similarly in trained men (Solstad 2020); the cable keeps tension even with the hands together.",
      "ant_deltoid_r": "Assists the horizontal adduction.",
      "ant_deltoid_l": "Assists the horizontal adduction.",
      "biceps_r": "Holds the soft elbow bend against the cable.",
      "biceps_l": "Holds the soft elbow bend against the cable.",
      "serratus_r": "Steadies the shoulder blade on the ribcage.",
      "serratus_l": "Steadies the shoulder blade on the ribcage.",
      "triceps_r": "Keeps the elbow from bending further.",
      "triceps_l": "Keeps the elbow from bending further.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "infraspinatus_r": "Centres the head of the humerus in the stretch.",
      "infraspinatus_l": "Centres the head of the humerus in the stretch.",
      "core": "Holds the slight lean still against the pull of both cables."
    }
  },
