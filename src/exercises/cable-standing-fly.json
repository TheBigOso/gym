    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Front of the shoulders",
      "Core"
    ],
    "equipment": [
      "Cable machine (two towers)",
      "Two D-handles"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
