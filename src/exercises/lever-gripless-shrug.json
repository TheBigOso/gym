      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Plate load is user-chosen: start light; the pads press on the shoulders.",
        "Neck pain: stop and lighten the load.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
