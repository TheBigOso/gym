      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper back (trapezius)",
    "secondaryBodyParts": [
      "Levator scapulae"
    ],
    "equipment": [
      "Gripless shrug machine (shoulder pads on a lever, plates on the horn)",
      "Weight plates"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder blade elevation)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "upper_traps_r",
        "upper_traps_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core",
        "calves_r",
        "calves_l"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe out as you shrug, breathe in as you lower.",
      "cadence": "About 1.3 s up, short hold, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "tempo": "1.3-0.5-2-0.5 (shrug-hold-lower-pause, seconds)",
      "load": "Plate load is user-chosen: shrug straight up with the arms relaxed.",
      "progression": "Add reps, then plates; longer hold at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall under the shoulder pads with the feet hip width and the knees soft; let the arms hang relaxed (no grip needed)."
      },
      {
        "id": "c2",
        "phase": "work",
        "text": "Breathe out and lift the shoulders straight up toward the ears against the pads."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hold at the top for a moment."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and lower the shoulders slowly to a full stretch."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the shoulders down, keeping tension."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rolling the shoulders",
        "fix": "Lift straight up and lower straight down."
      },
      {
        "id": "m2",
        "mistake": "Bending the knees to bounce",
        "fix": "Keep the knees soft and still."
      },
      {
        "id": "m3",
        "mistake": "Head poking forward",
        "fix": "Keep the neck long and the chin level."
      },
      {
        "id": "m4",
        "mistake": "Short range",
        "fix": "Lower to a full stretch every rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder blade elevation",
        "setup": "Lowered (elevate -6)",
        "peak": "Raised (elevate 24); shoulders up 9.4 cm",
        "norm": "From fully lowered to fully raised toward the ears (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Hanging relaxed, no grip",
        "peak": "Unchanged",
        "norm": "Hanging relaxed; the load sits on the shoulders, so grip does not limit the set (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lever",
        "setup": "Pivot 89.9 cm behind the shoulders; pads on the trapezius",
        "peak": "Lever turns 7.2°; pads within 0.15 cm of the shoulders",
        "norm": "The shoulder pads ride an arc about a pivot behind the athlete (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trapezius EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Shrugs strongly activate the upper trapezius (Ekstrom 2003; Pizzari 2014)",
        "sources": [
          "ekstrom2003",
          "pizzari2014"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s at the bottom",
        "peak": "1.3 s up, 0.5 s hold, 2 s down",
        "norm": "About 1.3 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
