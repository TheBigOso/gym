  "exercise": {
    "id": "assisted-triceps-dip-kneeling",
    "name": "Assisted Triceps Dip (kneeling)",
    "aliases": [
      "Machine assisted dip",
      "Kneeling assisted triceps dip"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "004986",
      "title": "Assisted Triceps Dip (kneeling)",
      "url": "https://gymvisual.com/videos/4986-assisted-triceps-dip-kneeling.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest and upper arms (triceps, chest, front shoulders)",
    "secondaryBodyParts": [
      "Triceps",
      "Chest",
      "Shoulders"
    ],
    "equipment": [
      "Assisted dip machine (knee pad)",
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (elbow extension, shoulder flexion from extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ],
      "lengthened": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale on the way down, exhale as you press up.",
      "cadence": "About 2 s down, a short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2 s down, brief pause, 1-1.5 s up",
      "frequency": "2-3 times a week",
      "progression": "Lower the counterweight step by step, then move to free dips"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel on the pad, grip the bars with the arms straight, trunk upright."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower by bending the elbows straight back, trunk upright; the pad goes down with you."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop with the upper arms about parallel."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Press back up, breathing out, until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight but not locked, shoulders down; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Too much assistance (no effort at the bottom)",
        "fix": "Choose a counterweight that makes the last reps hard."
      },
      {
        "id": "m2",
        "mistake": "Sitting back on the heels",
        "fix": "Kneel tall on the pad with the hips over the knees."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulders to the ears",
        "fix": "Keep the shoulders down and back."
      },
      {
        "id": "m4",
        "mistake": "Dropping too deep",
        "fix": "Stop at about parallel upper arms."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈3° (straight, not locked)",
        "peak": "≈98° at the bottom",
        "norm": "Arms straight but not locked at the top; elbow flexion at the bottom of a bar dip was larger than in a bench dip (McKenzie 2022); upper arms about parallel is a common limit (clinical opinion)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Trunk lean",
        "setup": "≈3° forward of vertical",
        "peak": "≈10° at the bottom (upright: triceps emphasis)",
        "norm": "Nearly upright for the triceps version (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm angle to the floor",
        "setup": "≈82° (arms straight down to the bars)",
        "peak": "≈0° at the bottom",
        "norm": "Stop with the upper arms about parallel to the floor (clinical opinion); bar dips reached about 95% of the maximal shoulder extension range in the study group (McKenzie 2022)",
        "sources": [
          "mckenzie2022"
        ]
      },
      {
        "measure": "Body travel",
        "setup": "Shoulders 50 cm above the wrists",
        "peak": "28 cm down; feet stay 67.5 cm or more off the floor",
        "norm": "The body moves down and up between the bars; the feet stay off the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee pad",
        "setup": "Shins on the pad, hips over the knees",
        "peak": "Pad rides down and up with the knees",
        "norm": "The counterweighted pad rides with the knees (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #004986, Assisted Triceps Dip (kneeling), video (movement reference)",
        "url": "https://gymvisual.com/videos/4986-assisted-triceps-dip-kneeling.html"
      },
      {
        "id": "mckenzie2022",
        "title": "McKenzie, Crowley-McHattan, Meir, Whitting and Volschenk 2022, bench, bar, and ring dips: do kinematics and muscle activity differ? (Int J Environ Res Public Health 19(20):13211; PMC9603242)",
        "url": "https://www.mdpi.com/1660-4601/19/20/13211"
      }
    ],
    "safety": {
      "cautions": [
        "Shoulder: dips take the shoulder far into extension, which loads the front of the shoulder (McKenzie 2022); keep the range to upper arms about parallel and stop if the front of the shoulder hurts.",
        "Step on and off the knee pad carefully; it moves with the counterweight.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: shorter range (stop with the elbows at about 60 degrees)."
      ],
      "regressions": [
        "Bench dip with the knees bent.",
        "Negative-only dips."
      ],
      "progressions": [
        "Slower lowering (3 s).",
        "Pause at the bottom."
      ]
    },
    "muscleNotes": {
      "triceps": "Upright trunk and elbows straight back keep the triceps as the main mover; the knee pad takes part of the body weight (clinical opinion)."
    }
  },
