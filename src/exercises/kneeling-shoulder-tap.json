    "secondaryBodyParts": [
      "Shoulders",
      "Chest"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isometric (anti-rotation) with alternating arm lifts",
    "plane": "Transverse",
    "laterality": "Alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "serratus_r",
        "serratus_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "pec_r",
        "pec_l",
        "triceps_r",
        "triceps_l"
      ],
      "stabilizer": [
        "glute_max_r",
        "glute_max_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe steadily; exhale on each tap.",
      "cadence": "One breath per tap"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 taps per side",
      "tempo": "About 1.2 s per tap with a short pause",
      "frequency": "3-4 times a week",
      "progression": "Slower taps, feet wider then narrower, then shoulder taps from a full plank"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel in a plank: hands under the shoulders, knees on the mat, body straight from knees to head."
      },
      {
        "id": "c2",
        "phase": "tap",
        "text": "Lift the right hand and tap the left shoulder."
      },
      {
        "id": "c3",
        "phase": "tap",
        "text": "Keep the hips level and still; do not rock side to side."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Put the hand back down under the shoulder."
      },
      {
        "id": "c5",
        "phase": "tap",
        "text": "Tap the right shoulder with the left hand."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips rocking side to side",
        "fix": "Slow down; widen the knees a little; squeeze the glutes."
      },
      {
        "id": "m2",
        "mistake": "Hips piking up or sagging",
        "fix": "Keep one line from knees to head."
      },
      {
        "id": "m3",
        "mistake": "Shoulders sinking toward the floor",
        "fix": "Push the floor away."
      },
      {
        "id": "m4",
        "mistake": "Rushing",
        "fix": "One controlled tap at a time."
      }
    ],
    "kinematics": [
      {
        "measure": "Body line",
        "setup": "Knees to shoulders within ≈18° of straight; trunk ≈50° from vertical",
        "peak": "Held",
        "norm": "Straight from knees to head (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tap",
        "setup": "Hands under the shoulders",
        "peak": "Right hand on top of the left shoulder (wrist target missed by 0.03 cm)",
        "norm": "Hand to the opposite shoulder (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "Level",
        "peak": "Shifts 1.9 cm toward the support hand, rolls ≈1°; hips stay within 0.3 cm of level",
        "norm": "Level, with only a small shift onto the support hand (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Plank 0.6 s",
        "peak": "0.8 s to tap, 0.4 s hold, 1 s back; then the other hand",
        "norm": "About 1.2 s per tap (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
