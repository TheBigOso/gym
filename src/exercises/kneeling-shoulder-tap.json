    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Wrist discomfort: make fists or use push-up handles; a soft mat under the knees."
      ],
      "modify": [
        "Wider knee stance.",
        "Hands on a bench (incline) to make it easier."
      ],
      "regressions": [
        "Kneeling plank hold.",
        "Hand lifts only a few centimetres."
      ],
      "progressions": [
        "Shoulder taps from a full plank.",
        "Slower taps with a pause."
      ]
    },
    "muscleNotes": {
      "core": "Holds the straight line from knees to head on three points while one hand lifts (clinical opinion; plank-type holds and their unilateral variants raise abdominal demand, Escamilla 2016).",
      "obliques_r": "Resist the trunk twisting toward the lifted hand (anti-rotation; clinical opinion).",
      "obliques_l": "Resist the trunk twisting toward the lifted hand (anti-rotation; clinical opinion).",
      "serratus_r": "Keeps the supporting shoulder blade flat against the ribs (push-up plus position; Ludewig 2004 on serratus in push-up variants).",
      "serratus_l": "Keeps the supporting shoulder blade flat against the ribs (Ludewig 2004).",
      "ant_deltoid_r": "Supports the body on the planted arm and lifts the tapping hand (clinical opinion).",
      "ant_deltoid_l": "Supports the body on the planted arm and lifts the tapping hand (clinical opinion).",
      "pec_r": "Supports the body on the planted arm (clinical opinion).",
      "pec_l": "Supports the body on the planted arm (clinical opinion).",
      "triceps_r": "Keeps the supporting elbow straight (clinical opinion).",
      "triceps_l": "Keeps the supporting elbow straight (clinical opinion).",
      "glute_max_r": "Keep the hips extended in line with the trunk (clinical opinion).",
      "glute_max_l": "Keep the hips extended in line with the trunk (clinical opinion).",
      "rhomboids_midtrap_r": "Steady the shoulder blades (clinical opinion).",
      "rhomboids_midtrap_l": "Steady the shoulder blades (clinical opinion)."
    }
