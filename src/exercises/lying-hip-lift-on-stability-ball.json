  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "lying-hip-lift-on-stability-ball",
    "name": "Lying Hip Lift (on stability ball)",
    "aliases": [
      "Stability ball bridge",
      "Swiss ball hip lift",
      "Heels-on-ball glute bridge"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "996",
      "title": "Lying Hip Lift (on stability ball)",
      "url": "https://gymvisual.com/videos/996-lying-hip-lift-on-stability-ball.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus maximus)",
    "secondaryBodyParts": [
      "Hamstrings",
      "Core"
    ],
    "equipment": [
      "Stability ball",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "obliques_r",
        "obliques_l",
        "glute_med_r",
        "glute_med_l"
      ],
      "lengthened": [
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the hips rise, inhale as they lower.",
      "cadence": "About 1.5 s up, 1 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "1.5-1-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Arms across the chest, then single-leg"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, heels on top of the ball, legs almost straight, arms on the floor by your sides."
      },
      {
        "id": "c2",
        "phase": "up",
        "text": "Breathe out, press the heels into the ball and lift the hips until the body is one straight line."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the glutes; keep the ball still."
      },
      {
        "id": "c4",
        "phase": "down",
        "text": "Breathe in and lower the hips slowly to just above the mat."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Touch down lightly; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back at the top",
        "fix": "Stop at a straight line; ribs down."
      },
      {
        "id": "m2",
        "mistake": "Letting the ball roll",
        "fix": "Press both heels down evenly."
      },
      {
        "id": "m3",
        "mistake": "Pushing through the arms",
        "fix": "Arms only steady you."
      },
      {
        "id": "m4",
        "mistake": "Dropping fast",
        "fix": "Lower over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip extension",
        "setup": "Hip ≈38° flexion (pelvis just off the mat)",
        "peak": "Hip ≈0° (line shoulders-hips-ankles)",
        "norm": "To neutral (straight line shoulders-hips-ankles) (clinical opinion); bridging excites the gluteus maximus (Lehecka 2017)",
        "sources": [
          "lehecka2017"
        ]
      },
      {
        "measure": "Knee",
        "setup": "≈10°",
        "peak": "≈10°",
        "norm": "Nearly straight, heels on the ball (standard setup)",
        "sources": []
      },
      {
        "measure": "Hip height",
        "setup": "Hip joint 9.1 cm",
        "peak": "26.4 cm",
        "norm": "Pelvis rises from the mat to the shoulder-ankle line (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Ball",
        "setup": "55 cm ball under the heels (heel gap -0.6 to 0.0 cm)",
        "peak": "Rolls 6 cm under the heels (bottom -0.1 to 0.2 cm off the floor)",
        "norm": "Supine work on a Swiss ball raises core and hamstring demand (Escamilla 2016)",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Lie 0.8 s",
        "peak": "1.5 s up, 1 s squeeze, 2 s down",
        "norm": "Controlled, squeeze at the top (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #996, Lying Hip Lift (on stability ball), video (movement reference)",
        "url": "https://gymvisual.com/videos/996-lying-hip-lift-on-stability-ball.html"
      },
      {
        "id": "lehecka2017",
