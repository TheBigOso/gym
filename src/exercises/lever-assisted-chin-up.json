      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull up, breathe in as you lower.",
      "cadence": "About 1.3 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "tempo": "1.3-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
      "load": "Assistance is user-chosen: more counterweight means a lighter pull.",
      "progression": "Add reps, then reduce the counterweight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Take the bar with an underhand (palms toward you) grip about shoulder width and kneel on the pad; hang with the arms nearly straight."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and pull the chest toward the bar, elbows travelling down in front of the body."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Pause with the chin over the bar and the shoulders down."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and lower under control on the counterweighted pad."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Reach a full hang with the arms nearly straight."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Kicking or swinging up",
        "fix": "Keep the knees on the pad and pull with the arms."
      },
      {
        "id": "m2",
        "mistake": "Half reps",
        "fix": "Lower to nearly straight arms each rep."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the bottom",
        "fix": "Set the shoulder blades down before each pull."
      },
      {
        "id": "m4",
        "mistake": "Craning the chin up",
        "fix": "Pull the chest toward the handles; keep the neck long."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈8° in the hang",
        "peak": "≈128° at the top",
        "norm": "From nearly straight at the bottom to well bent with the chin over the handles (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Underhand, grip points 34 cm apart",
        "peak": "Unchanged (hands planted on the bar)",
        "norm": "Supinated: underhand, about shoulder width (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body path",
        "setup": "Kneeling on the pad, knees ≈92°",
        "peak": "Body rises 61.5 cm; chin 12.5 cm above the bar",
        "norm": "The body rises nearly straight up; the knees ride the counterweighted pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Assistance",
        "setup": "Knee pad on a lever from a pivot 99.8 cm behind the knees",
        "peak": "Lever swings 36.6°; pad within 2.64 cm of the shins",
        "norm": "The counterweight under the knees takes part of body weight, so the pull is lighter than a free pull-up (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pull-up EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Pull-up and chin-up variations load the latissimus heavily; the chin-up adds biceps (Youdas 2010)",
        "sources": [
          "youdas2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s",
        "peak": "1.3 s up, 0.4 s hold, 2 s down",
        "norm": "About 1.3 s up, short pause, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11597, Lever Assisted Chin-up, video (movement reference)",
