  },
  "exercise": {
    "id": "single-leg-calf-raise-off-step",
    "name": "Single Leg Calf Raise Off Step",
    "aliases": [
      "Single-leg step calf raise",
      "One-leg deficit calf raise",
      "Single-leg heel raise off a step",
      "Step-edge calf raise (one leg)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11782",
      "title": "Single Leg Calf Raise Off Step",
      "url": "https://gymvisual.com/videos/11782-single-leg-calf-raise-off-step.html",
      "listing": "Video (movement reference; the page could not be read at authoring time: gymvisual.com is blocked by the proxy, so the movement comes from the name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Calves",
    "secondaryBodyParts": [],
    "equipment": [
      "Step or box (about 20 cm)",
      "Wall (light hand support)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (ankle plantarflexion on one leg through a full range)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "calves_r"
      ],
      "synergist": [],
      "stabilizer": [
        "glute_med_r",
        "core",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the heel lowers below the step, breathe out as you rise onto the ball of the foot.",
      "cadence": "About 1.2 s down, short stretch, 1.3 s up, short pause"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-15 per leg",
      "tempo": "About 1-2 s down into the stretch, brief pause, 1 s up, 1 s squeeze",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering, a longer stretch pause, then a dumbbell in the same-side hand."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on one foot with the ball of the foot on the edge of a step, heel off, hands lightly on a wall."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the heel sink below the step for a calf stretch."
      },
      {
        "id": "c3",
        "phase": "stretch",
        "text": "Pause briefly at the bottom without bouncing."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and rise onto the ball of the foot as high as you can."
      },
      {
        "id": "c5",
        "phase": "return",
        "text": "Pause at the top, then return to level under control."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bouncing out of the stretch",
        "fix": "Pause at the bottom and rise smoothly."
      },
      {
        "id": "m2",
        "mistake": "Short range at the top",
        "fix": "Rise as high as possible every rep."
      },
      {
        "id": "m3",
        "mistake": "Foot rolling outward onto the little toe",
        "fix": "Keep the pressure under the big toe and second toe."
      },
      {
        "id": "m4",
        "mistake": "Pushing with the hands",
        "fix": "Fingertips only steady you; the calf lifts the body."
      }
    ],
    "kinematics": [
      {
        "measure": "Ankle",
        "setup": "≈-2° plantarflexion with the foot level",
        "peak": "≈22° dorsiflexion at the bottom (heel 7.1 cm below the step), ≈26° plantarflexion at the top",
        "norm": "Full range: below level into dorsiflexion at the bottom, full plantarflexion at the top; only full-height rises count in the heel-rise test (Hébert-Losier 2017)",
        "sources": [
          "heberlosier2017"
        ]
      },
      {
        "measure": "Heel travel",
        "setup": "Level with the step",
        "peak": "16.6 cm from the bottom of the stretch to the top",
        "norm": "As far as the range allows each rep (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "Standing knee ≈4°, free knee ≈75°",
        "peak": "Standing knee ≈4°",
        "norm": "Straight but not locked; knee angle did not change triceps surae fatigue at 0 vs 45 degrees (Hébert-Losier 2012)",
        "sources": [
          "heberlosier2012"
        ]
      },
      {
        "measure": "Support",
        "setup": "Ball of the foot on a 20 cm step, both hands lightly on the wall",
        "peak": "Unchanged; the wall hands stay planted",
        "norm": "Light support with both hands on a wall for balance (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Level 0.6 s",
        "peak": "1.2 s down, 0.4 s stretch, 1.3 s up, 0.6 s pause, 1.3 s back to level",
        "norm": "About 1-2 s down, a short pause, about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11782, Single Leg Calf Raise Off Step, video (movement reference)",
        "url": "https://gymvisual.com/videos/11782-single-leg-calf-raise-off-step.html"
      },
      {
        "id": "heberlosier2017",
        "title": "Hébert-Losier, Wessman, Alricsson & Svantesson 2017, updated reliability and normative values for the standing heel-rise test in healthy adults (Physiotherapy; doi 10.1016/j.physio.2017.03.002; PubMed 28886865)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/28886865/"
      },
      {
        "id": "heberlosier2012",
        "title": "Hébert-Losier, Schneiders, García, Sullivan & Simoneau 2012, influence of knee flexion angle and age on triceps surae muscle fatigue during heel raises (J Strength Cond Res 26(11))",
        "url": "https://epublications.marquette.edu/phys_therapy_fac/29"
      },
      {
        "id": "kinoshita2023",
        "title": "Kinoshita, Maeo et al. 2023, triceps surae muscle hypertrophy is greater after standing versus seated calf-raise training (Front Physiol 14:1272106)",
        "url": "https://www.frontiersin.org/articles/10.3389/fphys.2023.1272106/full"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Achilles tendon pain: limit the drop below level and progress slowly.",
        "Use a stable step with a non-slip edge."
      ],
      "modify": [
        "Balance: hold the wall more firmly.",
        "Tender Achilles: stop at level (no drop below the step)."
      ],
      "regressions": [
        "One leg floor calf raise.",
        "Two-leg calf raise off a step."
      ],
      "progressions": [
        "Dumbbell in the same-side hand.",
        "Slow 3 s lowering."
      ]
    },
    "muscleNotes": {
      "calves_r": "Gastrocnemius and soleus lift the body through a long range; standing calf-raise training grew the gastrocnemius more than seated work (Kinoshita 2023).",
      "glute_med_r": "Keeps the pelvis level on one leg (clinical opinion).",
      "core": "Keeps the body tall (clinical opinion).",
      "hamstrings_l": "Hold the free knee bent (clinical opinion)."
    }
  },
