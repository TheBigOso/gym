{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "lying-toe-tap",
    "name": "Lying Toe Tap",
    "aliases": [
      "Supine toe taps",
      "Tabletop toe taps",
      "Bent-knee toe taps",
      "Alternating toe taps"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "15136",
      "title": "Lying Toe Tap",
      "url": "https://gymvisual.com/videos/15136-lying-toe-tap-male.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Hip flexors"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isometric trunk (anti-extension), dynamic hips",
    "plane": "Sagittal",
    "laterality": "Alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l",
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the toes lower and tap; inhale as the leg returns to tabletop.",
      "cadence": "About 3 s per tap"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 taps per side",
      "tempo": "1.2 s down, light tap, 1.2 s up",
      "frequency": "3-4 times a week",
      "progression": "Both legs at once, then a straighter knee, then dead bugs"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms by your sides. Bring both legs to tabletop: hips and knees at 90 degrees."
      },
      {
        "id": "c2",
        "phase": "tap",
        "text": "Keeping the knee bent, lower the right foot until the toes lightly tap the mat."
      },
      {
        "id": "c3",
        "phase": "return",
        "text": "Bring the leg back to tabletop without letting the low back lift."
      },
      {
        "id": "c4",
        "phase": "tap",
        "text": "Repeat with the left leg."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching as the leg lowers",
        "fix": "Tap only as low as the back stays flat."
      },
      {
        "id": "m2",
        "mistake": "Opening the knee to reach the floor",
        "fix": "Keep the knee at about 90 degrees; the hip does the moving."
      },
      {
        "id": "m3",
        "mistake": "Dropping the foot onto the mat",
        "fix": "A light tap; control the way down."
      },
      {
        "id": "m4",
        "mistake": "Holding the breath",
        "fix": "Exhale on each tap."
      }
    ],
    "kinematics": [
      {
        "measure": "Tabletop",
        "setup": "Hip ≈92°, knee ≈90°",
        "peak": "Held on the non-tapping leg",
        "norm": "Hips and knees about 90 degrees (standard dead bug and toe tap set-up)",
        "sources": []
      },
      {
        "measure": "Tap",
        "setup": "Hip ≈92°",
        "peak": "Hip ≈46° (lowered ≈45°), knee ≈90°; toes 0.4 cm from the mat",
        "norm": "Hip extends from about 90 degrees until the toes touch the mat, knee unchanged (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "On the mat, low back flat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Still; the low back stays down (Drysdale 2004)",
        "sources": [
          "drysdale2004"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Tabletop 0.6 s",
        "peak": "1.2 s down, 0.2 s tap, 1.2 s up, 0.4 s pause; then the other leg",
        "norm": "Slow, about 3 s per tap (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15136, Lying Toe Tap, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/15136-lying-toe-tap-male.html"
      },
      {
        "id": "drysdale2004",
        "title": "Drysdale, Earl and Hertel 2004, surface EMG of the abdominal muscles during pelvic-tilt and abdominal-hollowing exercises (J Athl Train 39(1):32-36)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC385259/"
      },
      {
        "id": "escamilla2016",
        "title": "Escamilla et al. 2016, muscle activation among supine, prone and side position exercises with and without a Swiss ball (Sports Health 8(4):372-379)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4922527"
      },
      {
        "id": "souza2001",
        "title": "Electromyographic activity of selected trunk muscles during dynamic spine stabilization exercises (dying bug and quadruped progressions, 12 healthy adults; Arch Phys Med Rehabil 2001; 82(11):1551-1557; PubMed 11689975)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/11689975/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "If the low back arches off the mat, the legs are too low for your strength: raise them or bend the knees."
      ],
      "modify": [
        "Hands under the buttocks help keep the pelvis tilted and the low back down.",
        "Bend the knees a little to shorten the lever.",
        "Pregnancy, postpartum or diastasis recti: get cleared first, and avoid long supine work later in pregnancy."
      ],
      "regressions": [
        "Smaller range: lower the foot only halfway.",
        "Start with one foot resting on the floor."
      ],
      "progressions": [
        "Lower both feet together.",
        "Straighter knees.",
        "Dead bug (add the opposite arm)."
      ]
    },
    "muscleNotes": {
      "core": "Transversus and rectus abdominis keep the low back flat while one bent leg lowers and the other hangs in tabletop; lowering a leg pulls the pelvis toward an arch (Drysdale 2004; Escamilla 2016 lists supine leg-lowering among the supine core drills).",
      "hip_flexors_r": "Iliopsoas and rectus femoris hold the legs up against gravity (clinical opinion; hip flexor EMG rises with leg-lowering work, Andersson 1997).",
      "hip_flexors_l": "Iliopsoas and rectus femoris hold the legs up against gravity (clinical opinion; hip flexor EMG rises with leg-lowering work, Andersson 1997).",
      "obliques_r": "The obliques help keep the pelvis level and the ribs down as the legs move off the midline (clinical opinion).",
      "obliques_l": "The obliques help keep the pelvis level and the ribs down as the legs move off the midline (clinical opinion).",
      "quads_r": "Hold the knee angle steady at about 90 degrees (clinical opinion).",
      "quads_l": "Hold the knee angle steady at about 90 degrees (clinical opinion)."
    }
  },
