  "exercise": {
    "id": "self-assisted-inverse-leg-curl",
    "name": "Self Assisted Inverse Leg Curl",
    "aliases": [
      "Nordic curl with a push-off",
      "Self-assisted Nordic hamstring curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "011677",
      "title": "Self Assisted Inverse Leg Curl",
      "url": "https://gymvisual.com/videos/11677-self-assisted-inverse-leg-curl-version-2.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (hamstrings)",
    "secondaryBodyParts": [
      "Glutes",
      "Calves"
    ],
    "equipment": [
      "Kneeling pad with ankle roller",
      "Body weight"
    ],
    "difficulty": "Advanced",
    "mechanics": "Isolation (eccentric knee flexion with the hips extended)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hamstrings_r",
        "hamstrings_l"
      ],
      "synergist": [
        "calves_r",
        "calves_l",
        "glute_max_r",
        "glute_max_l",
        "pec_r",
        "pec_l",
        "triceps_r",
        "triceps_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale and brace before lowering, exhale as you come back up.",
      "cadence": "About 3 s down, then back up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "3-6",
      "tempo": "3 s down, then up as smoothly as you can",
      "frequency": "1-2 times a week",
      "progression": "More range before the catch, then less help, then slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel on the pad with the ankles hooked under the roller, body upright."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Lean forward from the knees as one straight piece, as slowly as you can; bring the hands forward."
      },
      {
        "id": "c3",
        "phase": "catch",
        "text": "Catch yourself on the hands near the floor."
      },
      {
        "id": "c4",
        "phase": "push",
        "text": "Give a short push with the arms."
      },
      {
        "id": "c5",
        "phase": "curl",
        "text": "Pull with the hamstrings back to upright."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Kneel tall; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending at the hips to shorten the lever",
        "fix": "Keep knee, hip and shoulder in line."
      },
      {
        "id": "m2",
        "mistake": "Dropping fast once the hamstrings give out",
        "fix": "Lower slowly to the point you can control, then catch."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back",
        "fix": "Squeeze the glutes and brace."
      },
      {
        "id": "m4",
        "mistake": "Too much volume too soon",
        "fix": "Start with a few slow reps; soreness can be marked."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈90° (kneeling upright)",
        "peak": "≈14° at the bottom",
        "norm": "From kneeling upright (about 90 degrees) toward straight knees under control (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line",
        "setup": "≈93° from the floor",
        "peak": "≈10° from the floor at the bottom",
        "norm": "Knee to shoulder in one line as it turns forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip",
        "setup": "Extended (knee, hip and shoulder in line)",
        "peak": "≈12° of hip bend at the bottom",
        "norm": "Hips extended; a small bend at the bottom is common (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hands",
        "setup": "Arms reach forward on the way down",
        "peak": "Hands on the floor at the bottom, short push",
        "norm": "Hands catch and give a push only at the bottom (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #011677, Self Assisted Inverse Leg Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/11677-self-assisted-inverse-leg-curl-version-2.html"
      },
      {
        "id": "mcallister2014",
        "title": "McAllister, Hammond, Schilling, Ferreria, Reed & Weiss 2014, muscle activation during various hamstring exercises (J Strength Cond Res 28(6):1573-1580)",
        "url": "https://digitalcommons.memphis.edu/facpubs/9934"
      }
    ],
    "safety": {
      "cautions": [
        "Hamstring strain risk: build up the volume slowly and stop at any sharp pain at the back of the thigh.",
        "Knee pain on the pad: use a thicker pad.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shorter range."
      ],
      "regressions": [
        "Band-assisted version.",
        "Lying leg curl."
      ],
      "progressions": [
        "Slower lowering.",
        "Less assistance."
      ]
    },
    "muscleNotes": {
      "hamstrings": "The hamstrings brake the forward fall as the knees straighten (eccentric knee flexion) and pull the body back up; a classic hamstring-strength exercise with high hamstring activity in hamstring exercise comparisons (McAllister 2014 compared related movements).",
      "glute_max": "Gluteus maximus keeps the hips straight."
    }
