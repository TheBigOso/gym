      },
      {
        "id": "boehler2011",
        "title": "Boehler 2011, electromyographic analysis of the triceps brachii muscle during a variety of triceps exercises (MS thesis, University of Wisconsin-La Crosse, ACE-sponsored; 15 women, 8 exercises at 70% 1RM)",
        "url": "https://minds.wisc.edu/items/4876923b-3a14-47c3-9a69-decf731bd027"
      },
      {
        "id": "kholinne2018",
        "title": "The different role of each head of the triceps brachii muscle in elbow extension (Acta Orthop Traumatol Turc 2018;52(3):201-205; PubMed 29503079; EMG plus OpenSim at 0-180 degrees of shoulder elevation)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29503079/"
      }
    ],
    "safety": {
      "cautions": [
        "Lower back pain: keep the back flat and the supporting hand under the shoulder; shorten the set if form slips (clinical opinion).",
        "Elbow pain: lighter dumbbell, slower tempo.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "No bench: brace one hand on a sturdy chair or do it standing in a hip hinge.",
        "Wrist discomfort: keep the palm facing the body (neutral grip, as here)."
      ],
      "regressions": [
        "Lighter dumbbell, shorter range.",
        "Band kickback."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Longer pause at full extension.",
        "Cable kickback (constant tension)."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Straightens the elbow against the dumbbell; the load peaks with the arm straight. Kickbacks, dips and triangle push-ups did not differ significantly in long or lateral head EMG and led an eight-exercise comparison (Boehler 2011). With the upper arm near the trunk the long head produced the most force (Kholinne 2018).",
      "triceps_l": "Straightens the elbow against the dumbbell; the load peaks with the arm straight. Kickbacks, dips and triangle push-ups did not differ significantly in long or lateral head EMG and led an eight-exercise comparison (Boehler 2011). With the upper arm near the trunk the long head produced the most force (Kholinne 2018).",
      "post_deltoid_r": "Holds the upper arm up along the trunk (clinical opinion).",
      "post_deltoid_l": "Holds the upper arm up along the trunk (clinical opinion).",
      "lats_r": "Help keep the upper arm against the side (clinical opinion).",
      "lats_l": "Help keep the upper arm against the side (clinical opinion).",
      "rhomboids_midtrap_r": "Hold the shoulder blade back so the upper arm stays still (clinical opinion).",
      "rhomboids_midtrap_l": "Hold the shoulder blade back so the upper arm stays still (clinical opinion).",
      "forearm_flexors_r": "Grip the handle; keep the wrist straight.",
      "forearm_flexors_l": "Grip the handle; keep the wrist straight.",
      "core": "Holds the trunk square to the bench; no twisting as the arm straightens.",
      "spinal_extensors_r": "Keep a flat back in the bent-over position.",
      "spinal_extensors_l": "Keep a flat back in the bent-over position."
    }
  },
