    "breathing": {
      "pattern": "Exhale as you straighten the elbow, inhale as the dumbbell returns.",
      "cadence": "About 1 s out, 0.6 s squeeze, about 1.8 s back"
    },
    "prescription": {
      "sets": "2-3 per arm",
      "reps": "10-15",
      "load": "Dumbbell load is user-chosen: pick a weight you can control for every rep with 1-3 reps in reserve (RPE 7-9). Kickbacks need a much lighter dumbbell than presses.",
      "tempo": "1-1-2-0 (out, squeeze, back)",
      "frequency": "1-2 times a week",
      "progression": "More reps, a longer squeeze, then a heavier dumbbell"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Left knee and left hand on the bench, back flat; right upper arm along the side, elbow bent, dumbbell hanging under the elbow."
      },
      {
        "id": "c2",
        "phase": "extend",
        "text": "Breathe out and straighten the elbow, pushing the dumbbell back until the arm is straight."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the back of the arm with the arm straight; the upper arm stays still along the trunk."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and bend the elbow slowly to bring the dumbbell back under the elbow."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the back flat and the shoulder still; repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the dumbbell (momentum)",
        "fix": "Move slowly and pause with the arm straight; use a lighter dumbbell."
      },
      {
        "id": "m2",
        "mistake": "Upper arm dropping as the elbow bends",
        "fix": "Keep the upper arm parallel to the trunk throughout."
      },
      {
        "id": "m3",
        "mistake": "Trunk rotating open",
        "fix": "Keep both shoulders square to the bench."
      },
      {
        "id": "m4",
        "mistake": "Rounded back",
        "fix": "Flat back, neck long, eyes on the bench."
      },
      {
        "id": "m5",
        "mistake": "Wrist bending",
        "fix": "Keep the wrist straight in line with the forearm."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈96° (forearm hanging)",
        "peak": "≈4° (arm straight back)",
        "norm": "From about 90 degrees (forearm hanging) to straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm to trunk",
        "setup": "≈21° from the trunk line, ≈1° below horizontal",
        "peak": "Unchanged (shoulder channels constant)",
        "norm": "Upper arm along the trunk (low shoulder elevation), where the long head carried the most force (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈19° above horizontal (left knee and hand on a 42 cm bench)",
        "peak": "Unchanged",
        "norm": "Trunk close to horizontal with a flat back, supported on the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Elbow bent 0.5 s",
        "peak": "1.0 s out, 0.6 s squeeze, 1.8 s back, 0.7 s reset",
        "norm": "Slow and controlled with a pause at full extension (clinical opinion); the EMG comparison used sets of 7 reps at 70% of 1RM (Boehler 2011)",
        "sources": [
          "boehler2011"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #033312, Dumbbell Kickback, video (movement reference)",
