      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower to the bench edge, exhale as you press away.",
      "cadence": "About 1.8 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Lower surface, then floor close-grip push-up, then diamond push-up"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hands on the bench edge, closer than shoulder width, arms straight, body in one line on the balls of the feet."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the chest to the edge, elbows brushing back along the ribs."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Chest just above the hands, elbows pointing back."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and push the bench away until the arms are straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Hold the plank line at the top and go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows close to the ribs, pointing back toward the feet."
      },
      {
        "id": "m2",
        "mistake": "Hips sagging toward the floor",
        "fix": "Brace the abs and squeeze the glutes."
      },
      {
        "id": "m3",
        "mistake": "Chin poking toward the bench",
        "fix": "Lead with the chest; keep the neck long."
      },
      {
        "id": "m4",
        "mistake": "Feet slipping",
        "fix": "Use a non-slip floor and a stable bench against a wall."
      }
    ],
    "kinematics": [
      {
        "measure": "Hand width",
        "setup": "Wrists 22 cm apart on a 45 cm bench (shoulder joints 40 cm): about 55% of shoulder width",
        "peak": "Unchanged (hands planted)",
        "norm": "Inside shoulder width; 50% of shoulder width raised triceps activity versus wider hands (Kim 2016)",
        "sources": [
          "kim2016"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (arms straight, not locked)",
        "peak": "≈127° at the bottom (chest 4 cm above the bench edge)",
        "norm": "Arms straight but not locked at the top; elbows bend to about 90 degrees or more at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "≈-15° (arms near vertical)",
        "peak": "≈7° at the bottom",
        "norm": "Elbows close to the ribs, about 10-30 degrees from the body at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line",
        "setup": "Trunk ≈46° above horizontal; trunk-to-leg bend 0.0°",
        "peak": "Trunk ≈29°; bend 0.1°",
        "norm": "Head, trunk, hips and ankles (or knees) in one straight line throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Wrist extension",
        "setup": "≈76°",
        "peak": "≈51° at the bottom",
        "norm": "Palms flat; the wrist bends back about 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up; lab studies used 2-2.5 s per repetition (Marcolin 2015)",
        "sources": [
          "marcolin2015"
        ]
      },
      {
        "measure": "Load on the hands",
        "setup": "Hands 45 cm up: the body is inclined 46° above horizontal",
        "peak": "29° at the bottom",
        "norm": "Raising the hands lowers the share of body weight on them, so the move is easier than on the floor (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11882, Incline Close Grip Push-up (movement reference only)",
