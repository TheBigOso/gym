        "url": "https://digitalcommons.wku.edu/ijes/vol18/iss3/5"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain in the elbow or shoulder, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can control for every rep with the trunk still.",
        "Sit far enough from the pulley that the bar does not drag the hands into the thighs at the bottom.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrist discomfort with the straight bar: use an EZ-bar attachment or a rope.",
        "Elbow pain at the bottom: stop a little short of the lowest position (clinical opinion)."
      ],
      "regressions": [
        "Lighter load.",
        "Standing cable curl.",
        "Seated dumbbell curl."
      ],
      "progressions": [
        "Slower 3 s lowering.",
        "Pause 1 s halfway up.",
        "Heavier load for 6-10 reps."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Prime mover: bends the elbow against the cable with the palm up. The seat and the still upper arms leave the elbow flexors to do the lift.",
      "biceps_l": "Prime mover: bends the elbow against the cable with the palm up. The seat and the still upper arms leave the elbow flexors to do the lift.",
      "forearm_flexors_r": "Grip the bar and help bend the elbow.",
      "forearm_flexors_l": "Grip the bar and help bend the elbow.",
      "forearm_extensors_r": "Hold the wrist straight.",
      "forearm_extensors_l": "Hold the wrist straight.",
      "core": "Keeps the trunk tall on the bench so the bar is not rocked up."
    }
  },
