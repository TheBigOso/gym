      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper Arms",
    "secondaryBodyParts": [
      "Forearms"
    ],
    "equipment": [
      "Cable machine",
      "Straight bar attachment",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "forearm_extensors_r",
        "forearm_extensors_l",
        "core"
      ],
      "lengthened": []
    },
    "breathing": {
      "pattern": "Breathe out as you curl the bar up, breathe in as you lower it.",
      "cadence": "About 1 s up, short squeeze, 2-3 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1.2-0.3-2.4-0.5 (up-squeeze-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can curl without rocking the trunk back.",
      "progression": "Add reps, then one plate on the stack; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench facing the low pulley, feet flat and a little wider than the hips. Hold the bar underhand about shoulder width, elbows a little in front of the ribs, bar just over the knees."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the bar toward the chest, moving only at the elbows."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the biceps at the top; the elbows stay where they started and the trunk stays tall."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the bar is back over the knees, keeping the cable taut."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rocking the trunk back to start the curl",
        "fix": "Sit tall with the feet planted; lighten the stack."
      },
      {
        "id": "m2",
        "mistake": "Elbows drifting forward or flaring at the top",
        "fix": "Keep the upper arms still; stop when the forearms can go no higher without the elbows moving."
      },
      {
        "id": "m3",
        "mistake": "Letting the bar drop onto the thighs",
        "fix": "Lower over 2-3 s and stop with the bar just over the knees."
      },
      {
        "id": "m4",
        "mistake": "Curling the wrists to finish",
        "fix": "Keep the wrists straight in line with the forearms."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈43° (bar just over the knees, clear of the thighs)",
        "peak": "≈134° at the top (range ≈91°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Upper arm",
        "setup": "≈19° forward of vertical, elbows near the sides",
        "peak": "Unchanged (elbows move 0.00 cm over the loop)",
        "norm": "Upper arms still, a little forward of the trunk so the bar clears the thighs at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Underhand, 38 cm between the hands on a 50 cm bar",
        "peak": "Unchanged (37.91-38.07 cm)",
        "norm": "Underhand (supinated) grip about shoulder width; the supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Seat",
        "setup": "Sitting tall on a 45 cm flat bench, feet flat, knees about 90 degrees",
        "peak": "Unchanged (trunk still)",
        "norm": "Sitting tall, feet flat, knees about 90 degrees; the seat removes leg drive and trunk sway (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bar over the knees 0.5 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Seated Curl, video (movement reference)",
