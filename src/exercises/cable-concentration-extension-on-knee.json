      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment, so the movement was taken from the exercise name and standard coaching: half-kneeling facing a pulley set at about head height, working upper arm braced on the inside of the front thigh)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper Arms",
    "secondaryBodyParts": [
      "Shoulders",
      "Core"
    ],
    "equipment": [
      "Cable machine (pulley at about head height)",
      "D-handle"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
