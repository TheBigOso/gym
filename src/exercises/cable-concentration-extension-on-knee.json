    },
    "breathing": {
      "pattern": "Breathe out as you push the handle down, breathe in as it rises.",
      "cadence": "About 1 s down, short pause, about 2 s up"
    },
    "prescription": {
      "sets": "2-4 per arm",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "tempo": "1-0.4-2-0.5 (down-pause-up-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can push down with the working elbow still at your side for every rep.",
      "progression": "Add reps, then one plate on the stack; slower return. Do the same reps with each arm."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel on the left knee facing a pulley set at about head height, right foot forward. Lean forward from the hips and brace the back of the right upper arm against the inside of the right thigh; take the D-handle underhand, elbow well bent, left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "push",
        "text": "Breathe out and straighten the elbow, pushing the handle down until the arm hangs straight; the upper arm stays on the thigh."
      },
      {
        "id": "c3",
        "phase": "lockout",
        "text": "Squeeze the back of the arm for a moment, wrist straight."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the handle rise slowly until the elbow is well bent again."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the cable taut, then repeat; switch arms (and kneeling legs) after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the upper arm off the thigh",
        "fix": "Keep the arm braced; only the forearm moves."
      },
      {
        "id": "m2",
        "mistake": "Rounding the back over the knee",
        "fix": "Hinge from the hips with a long back."
      },
      {
        "id": "m3",
        "mistake": "Letting the handle yank the elbow shut",
        "fix": "Control the return over about 2 s."
      },
      {
        "id": "m4",
        "mistake": "Bending the wrist",
        "fix": "Keep the wrist in line with the forearm."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈110° (well bent)",
        "peak": "≈8° (arm straight, not locked hard)",
        "norm": "From well bent to straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm",
        "setup": "≈32° from vertical, braced on the inner right thigh (gap -0.7 cm)",
        "peak": "Unchanged (elbow moves 0.00 cm over the loop)",
        "norm": "Braced on the inside of the front thigh and still, hanging close to vertical; with the arm near the side the long head carried the most force in a model and EMG study (Kholinne 2018)",
        "sources": [
          "kholinne2018"
        ]
      },
      {
        "measure": "Grip",
        "setup": "Underhand on the D-handle",
        "peak": "Palm forward with the arm straight",
        "norm": "Underhand (palm toward the fold of the elbow) on a D-handle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Half-kneeling on the left knee, ≈38° forward lean",
        "peak": "Unchanged",
        "norm": "Half-kneeling, leaning forward from the hips with a long back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the elbow bent",
        "peak": "1 s down, 0.4 s at the bottom, 2 s up",
        "norm": "Controlled, about 1 s down and 2 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Concentration Extension (on knee), video (movement reference)",
