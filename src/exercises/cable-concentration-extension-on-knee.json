    "name": "Cable Concentration Extension (on knee)",
    "aliases": [
      "Cable concentration triceps extension",
      "Kneeling one-arm cable triceps extension",
      "Half-kneeling concentration pushdown"
    ],
    "reference": {
      "source": "GymVisual",
