      },
      {
        "id": "kholinne2018",
        "title": "The different role of each head of the triceps brachii muscle in elbow extension (Acta Orthop Traumatol Turc 2018;52(3):201-205; PubMed 29503079; EMG plus OpenSim at 0-180 degrees of shoulder elevation)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29503079/"
      },
      {
        "id": "overhead2022",
        "title": "Triceps brachii hypertrophy is substantially greater after elbow extension training performed in the overhead versus neutral arm position (Eur J Sport Sci 2022, DOI 10.1080/17461391.2022.2100279; PubMed 35819335; 21 adults, 12 weeks, cable)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/35819335/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain in the elbow, shoulder or kneeling knee, numbness or tingling occurs.",
        "The cable load is user-chosen: pick a weight you can control for every rep with the upper arm braced.",
        "Put a pad or folded mat under the kneeling knee.",
        "Keep the head out of the cable's path: set the pulley so the cable runs in front of the face.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee discomfort: sit on a bench with the arm braced on the thigh instead.",
        "Elbow pain: lighter load and a shorter range (clinical opinion)."
      ],
      "regressions": [
        "Lighter load.",
        "One-arm cable pushdown standing.",
        "Band pushdown."
      ],
      "progressions": [
        "Slower 3 s return.",
        "Pause 1-2 s with the arm straight.",
        "Overhead cable triceps extension (more triceps growth than the arm-at-the-side position in a 12-week study, PubMed 35819335)."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Prime mover: straightens the elbow against the cable, one arm at a time. With the upper arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018); training in this position gave less triceps growth than overhead extensions in a 12-week study (PubMed 35819335).",
      "triceps_l": "Prime mover: straightens the elbow against the cable, one arm at a time. With the upper arm at the side the long head carried the most force in a model and EMG study (Kholinne 2018); training in this position gave less triceps growth than overhead extensions in a 12-week study (PubMed 35819335).",
      "lats_r": "Keeps the upper arm pressed against the thigh.",
      "lats_l": "Keeps the upper arm pressed against the thigh.",
      "post_deltoid_r": "Keeps the upper arm from drifting forward.",
      "post_deltoid_l": "Keeps the upper arm from drifting forward.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "forearm_extensors_r": "Hold the wrist straight.",
      "forearm_extensors_l": "Hold the wrist straight.",
      "core": "Keeps the trunk still and square so body weight does not push the handle.",
      "obliques_r": "Keep the trunk from twisting toward the working arm.",
      "obliques_l": "Keep the trunk from twisting toward the working arm.",
      "glute_max_r": "Holds the half-kneeling hips steady.",
      "spinal_extensors_r": "Hold the long back in the forward lean.",
      "glute_max_l": "Holds the half-kneeling hips steady.",
      "spinal_extensors_l": "Hold the long back in the forward lean."
    }
