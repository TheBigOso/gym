{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-unisex-172-v1"
  },
  "exercise": {
    "id": "hip-abduction",
    "name": "Hip Abduction (side-lying)",
    "aliases": [
      "Side-lying hip abduction",
      "Side-lying leg raise",
      "Lying side leg lift"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "218012",
      "title": "Hip abduction",
      "url": "https://gymvisual.com/videos/12492-hip-abduction.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus medius)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip abduction)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_med_r"
      ],
      "synergist": [
        "glute_max_r"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg rises, inhale as it lowers.",
      "cadence": "About 1.2 s up, 0.5 s hold, 1.7 s down"
    },
    "prescription": {
      "sets": "2-3 per side",
      "reps": "12-20",
      "tempo": "1-0.5-2-0",
      "frequency": "3-5 times a week (rehab and warm-up)",
      "progression": "Ankle weight, then a band around the knees or ankles"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your left side, head on the left arm, hips stacked, legs straight in line with the body."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and lift the top leg straight up, toes pointing forward."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause at about 35-45 degrees. Leg slightly behind the body line, not in front of it."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly without resting the leg."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Repeat; then roll over and switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rolling the pelvis back",
        "fix": "Keep the hips stacked; a hand on the floor in front helps."
      },
      {
        "id": "m2",
        "mistake": "Toes turning up to the ceiling",
        "fix": "Keep the toes forward or slightly down; turning out shifts work to the hip flexors."
      },
      {
        "id": "m3",
        "mistake": "Leg drifting forward",
        "fix": "Keep the leg in line with the trunk or slightly behind it."
      },
      {
        "id": "m4",
        "mistake": "Lifting too high",
        "fix": "Stop at about 35-45 degrees; higher only hitches the pelvis."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "≈-9.8° (legs stacked, top leg resting)",
        "peak": "≈40° (joint channel); thigh ≈43° above the bottom leg",
        "norm": "Lift to about 35-45 degrees (clinical opinion); side-lying abduction excites the gluteus medius strongly (Distefano 2009; Boren 2011)",
        "sources": [
          "distefano2009",
          "boren2011"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈-4°",
        "peak": "≈-8° (slightly behind the body line)",
        "norm": "Hip neutral to slightly extended, leg in line with the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip rotation",
        "setup": "0° (toes forward)",
        "peak": "0° (toes forward)",
        "norm": "Neutral, toes forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bottom leg",
        "setup": "Straight (knee ≈6°)",
        "peak": "Unchanged",
        "norm": "Straight in line, as in the neutral setups compared by Boren 2011 (some protocols bend it for support)",
        "sources": [
          "boren2011"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.2 s up, 0.5 s hold, 1.7 s down",
        "norm": "Slow and controlled, slower down than up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #218012, Hip abduction, video (movement reference)",
        "url": "https://gymvisual.com/videos/12492-hip-abduction.html"
      },
      {
        "id": "distefano2009",
        "title": "Distefano et al. 2009, gluteal muscle activation during common therapeutic exercises (J Orthop Sports Phys Ther 39(7):532-540)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19574661/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Hip or shoulder pressure on the floor: lie on a mat or bend the bottom knee.",
        "Hard to keep the pelvis stacked: bend the bottom knee and hip for a wider base."
      ],
      "regressions": [
        "Smaller lift.",
        "Clamshell."
      ],
      "progressions": [
        "Ankle weight.",
        "Band above the knees.",
        "Side plank with leg lift."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Top-leg abductor. Side-lying hip abduction gave the highest gluteus medius activity of the exercises tested by Distefano 2009 (about 81% MVIC); Boren 2011 measured about 63% MVIC.",
      "glute_max_r": "Upper fibres assist abduction with the hip neutral; Boren 2011 measured about 51% MVIC in side-lying abduction.",
      "obliques_r": "Keep the pelvis stacked so it does not roll back as the leg rises (clinical opinion).",
      "obliques_l": "Keep the pelvis stacked so it does not roll back as the leg rises (clinical opinion).",
      "core": "Holds the trunk still on the mat (clinical opinion)."
    }
  },
