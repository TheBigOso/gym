    "id": "barbell-reverse-curl",
    "name": "Barbell Reverse Curl",
    "aliases": [
      "Reverse-grip barbell curl",
      "Overhand barbell curl",
      "Pronated barbell curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "4999",
      "title": "Barbell Reverse Curl",
      "url": "https://gymvisual.com/videos/4999-barbell-reverse-curl.html",
      "listing": "Video (title from the listing URL; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper arms (biceps)",
    "secondaryBodyParts": [
      "Forearms"
    ],
    "equipment": [
      "Barbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "forearm_extensors_r",
        "forearm_extensors_l",
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "upper_traps_r",
        "upper_traps_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "load": "Load is user-chosen: expect to use clearly less than for the palms-up barbell curl; pick a bar you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion).",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Add reps, then a slower lowering, then weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width; hold the bar with an overhand grip (palms down), hands about shoulder width, the bar resting against the thighs."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the bar up, elbows by your sides, knuckles leading."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze with the bar at chest height; wrists straight, knuckles up."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, 2-3 s, until the bar touches the thighs."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Shoulders down, chest up; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Wrists bending down (knuckles dropping) as the bar comes up",
        "fix": "Keep the wrists straight, in line with the forearms; lighten the bar."
      },
      {
        "id": "m2",
        "mistake": "Swinging the hips to heave the bar",
        "fix": "Lighter bar; stand tall with the glutes and abs braced."
      },
      {
        "id": "m3",
        "mistake": "Elbows drifting forward or flaring out",
        "fix": "Elbows stay by the sides; only the forearms move."
      },
      {
        "id": "m4",
        "mistake": "Dropping the bar on the way down",
        "fix": "Take 2-3 s to lower to the thighs."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈11° (arm straight)",
        "peak": "≈124° at the top (range ≈113°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "159° (neutral, thumb up)",
        "peak": "176.8° (neutral, thumb up)",
        "norm": "Pronated grip: biceps activity in the lifting phase was about 19% lower than with the supinated grip, so the brachioradialis and brachialis share more of the work (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈3°",
        "peak": "≈10° (elbow forward)",
        "norm": "Elbows stay near the sides; a small forward drift at the top is normal (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar clearance",
        "setup": "Bar 0.8 cm or more off the body; 42 cm between the handle points, overhand",
        "peak": "Grip width steady within 0.56 cm over the rep; nearest the bar comes: quad_l",
        "norm": "The bar starts just off the front of the thighs and stays clear of the body (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bar on the thighs 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #4999, Barbell Reverse Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/4999-barbell-reverse-curl.html"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      }
    ],
    "safety": {
      "cautions": [
        "Pain on the outside of the elbow or the top of the forearm: lighten the bar or switch to the hammer curl (clinical opinion).",
        "Keep the wrists straight; the pronated grip loads the wrist extensors hard (clinical opinion).",
        "Lift the bar from a rack or the floor with a flat back and bent knees, and set it down the same way.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "EZ bar with an overhand grip if the straight bar strains the wrists.",
        "Dumbbells, one arm at a time."
      ],
      "regressions": [
        "Empty bar or a light fixed barbell.",
        "Dumbbell hammer curl."
      ],
      "progressions": [
        "Slower lowering (3-4 s).",
        "Pause at the top.",
        "Heavier bar for fewer reps."
      ]
    },
    "muscleNotes": {
      "forearm_extensors_r": "Brachioradialis and the wrist extensors (mapped to the forearm extensor region): with the palms down the brachioradialis takes a larger share of the elbow flexion and the wrist extensors hold the wrist straight; biceps activity was about 19% lower than with a supinated grip (Coratella 2023).",
      "forearm_extensors_l": "Brachioradialis and the wrist extensors (mapped to the forearm extensor region): with the palms down the brachioradialis takes a larger share of the elbow flexion and the wrist extensors hold the wrist straight; biceps activity was about 19% lower than with a supinated grip (Coratella 2023).",
      "biceps_r": "Still flexes the elbow, though its activity was about 19% lower than with the supinated grip (Coratella 2023); the brachialis (not a separate id on this rig) works hard whatever the grip.",
      "biceps_l": "Still flexes the elbow, though its activity was about 19% lower than with the supinated grip (Coratella 2023); the brachialis (not a separate id on this rig) works hard whatever the grip.",
      "forearm_flexors_r": "Finger flexors hold the bar.",
      "forearm_flexors_l": "Finger flexors hold the bar.",
      "ant_deltoid_r": "Steadies the shoulder as the bar rises (clinical opinion).",
      "ant_deltoid_l": "Steadies the shoulder as the bar rises (clinical opinion).",
      "upper_traps_r": "Hold the shoulder girdle level under the bar.",
      "upper_traps_l": "Hold the shoulder girdle level under the bar.",
      "core": "Keeps the trunk still so the hips do not swing the bar up."
    }
  },
