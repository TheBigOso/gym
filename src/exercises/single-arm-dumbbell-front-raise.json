        "upper_traps_l"
      ],
      "stabilizer": [
        "infraspinatus_r",
        "infraspinatus_l",
        "obliques_r",
        "obliques_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3 per arm",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-0.5-2-0.5 (up-pause-down-pause, seconds; Coratella 2020)",
      "rest": "30-60 s between arms",
      "frequency": "1-2 times a week",
      "load": "User-chosen dumbbell; light",
      "progression": "Add reps, then 1-2 kg"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet about hip width, knees soft, ribs down and glutes lightly braced. Dumbbell in front of the right thigh, palm facing the thigh; left hand on the hip."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the arm straight forward, palm down, elbow soft."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stop at shoulder height; do not lean back or twist."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly in about 2 s to the thigh."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause and repeat; switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back or twisting to lift",
        "fix": "Brace the trunk, squeeze the glutes, lighter dumbbell."
      },
      {
        "id": "m2",
        "mistake": "Swinging the weight up",
        "fix": "Pause at the bottom and lift with a 2 s count."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulder up",
        "fix": "Keep the shoulder blade down and the neck long."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder flexion",
        "setup": "≈15° (dumbbell just in front of the thigh)",
        "peak": "≈83° (hand at shoulder height)",
        "norm": "From the thigh to about 90 degrees (the range tested by Coratella 2020)",
        "sources": [
          "coratella2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈10°",
        "peak": "≈10°",
        "norm": "Elbow soft, about 10 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "palm facing the thigh",
        "peak": "palm down",
        "norm": "Palm facing the thigh at the start, palm down at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "upright, left hand on the hip",
        "peak": "unchanged (no lean back or twist)",
        "norm": "Upright, square to the front (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the thigh",
        "peak": "1.8 s up, 0.4 s at the top, 2.0 s down",
        "norm": "2 s up, 0.5 s pause, 2 s down in Coratella 2020",
        "sources": [
          "coratella2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #391312, Dumbbell One Arm Front Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/13963-dumbbell-one-arm-front-raise.html"
      },
      {
        "id": "coratella2020",
        "title": "Coratella et al. 2020, an electromyographic analysis of lateral raise variations and frontal raise in competitive bodybuilders (Int J Environ Res Public Health 17(17):6015)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7503819/"
      },
      {
        "id": "saeterbakken2012",
        "title": "Saeterbakken & Fimland 2012, muscle activity of the core during bilateral, unilateral, seated and standing resistance exercise (Eur J Appl Physiol 112:1671-1678)",
        "url": "https://www.springermedicine.com/muscle-activity-of-the-core-during-bilateral-unilateral-seated-a/21069718"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: raise with the thumb up (neutral grip).",
        "Balance: hold a post with the free hand."
      ],
      "regressions": [
        "Lighter dumbbell.",
        "Seated single-arm front raise."
      ],
      "progressions": [
        "Alternating front raise.",
        "Slower lowering or a 2 s hold at the top."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover: shoulder flexion. The frontal raise gave the highest anterior deltoid activity in the lifting phase among the raises tested (Coratella 2020).",
      "ant_deltoid_l": "Main mover: shoulder flexion. The frontal raise gave the highest anterior deltoid activity in the lifting phase among the raises tested (Coratella 2020).",
      "pec_r": "The clavicular head helps flex the shoulder; most active in the frontal raise (Coratella 2020).",
      "pec_l": "The clavicular head helps flex the shoulder; most active in the frontal raise (Coratella 2020).",
      "lat_deltoid_r": "Helps hold the arm up; lower than in lateral raises (Coratella 2020).",
      "lat_deltoid_l": "Helps hold the arm up; lower than in lateral raises (Coratella 2020).",
      "serratus_r": "Upward rotation of the shoulder blade.",
      "serratus_l": "Upward rotation of the shoulder blade.",
      "upper_traps_r": "Supports the shoulder blade near the top.",
      "upper_traps_l": "Supports the shoulder blade near the top.",
      "infraspinatus_r": "Rotator cuff: keeps the ball of the shoulder centred.",
      "infraspinatus_l": "Rotator cuff: keeps the ball of the shoulder centred.",
      "obliques_r": "Resist twisting and side-bending toward the one-sided load (clinical opinion; unilateral loading raises oblique activity in presses, Saeterbakken 2012).",
      "obliques_l": "Resist twisting and side-bending toward the one-sided load (clinical opinion; unilateral loading raises oblique activity in presses, Saeterbakken 2012).",
      "core": "Keeps the ribs down; no leaning back.",
      "spinal_extensors_r": "Keep the spine tall against the load in front.",
      "spinal_extensors_l": "Keep the spine tall against the load in front."
    }
