    "bodyPart": "Shoulders (anterior deltoid)",
    "secondaryBodyParts": [
      "Chest (upper)",
      "Core (obliques)"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "synergist": [
        "pec_r",
        "pec_l",
