        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower all the way down, relax a breath on the mat, exhale as you press back up.",
      "cadence": "About 1.8 s down, 0.8 s on the mat, about 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-15",
      "tempo": "2-1-1-0",
      "frequency": "2-3 times a week",
      "progression": "More reps, then a longer pause on the mat, then a standard push-up without the rest"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "High plank, hands a little wider than the shoulders, body in one line."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower as one piece until the chest rests on the mat."
      },
      {
        "id": "c3",
        "phase": "rest",
        "text": "Rest the chest on the mat for a moment; hands stay planted, elbows back, chin lifted off the mat."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out, brace and press the whole body up in one line."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight at the top; go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips rising first on the way up (worm)",
        "fix": "Brace before pressing so the chest and hips lift together."
      },
      {
        "id": "m2",
        "mistake": "Flopping onto the mat",
        "fix": "Lower under control all the way down."
      },
      {
        "id": "m3",
        "mistake": "Elbows flaring out",
        "fix": "Keep them about 30-45 degrees from the body."
      },
      {
        "id": "m4",
        "mistake": "Head dropping first",
        "fix": "Keep the neck long, eyes just ahead of the hands."
      }
    ],
    "kinematics": [
      {
        "measure": "Hand width",
        "setup": "Wrists 58 cm apart (shoulder joints 40 cm), level with the lower chest",
        "peak": "Unchanged (hands planted)",
        "norm": "A little wider than the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈9° (arms straight, not locked)",
        "peak": "≈147° at the bottom (chest resting on the mat)",
        "norm": "Arms straight but not locked at the top; elbows bend to about 90 degrees or more at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck (upper arm from the trunk)",
        "setup": "≈24° (arms near vertical)",
        "peak": "≈24° at the bottom",
        "norm": "Elbows close to the ribs, about 10-30 degrees from the body at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body line",
        "setup": "Trunk ≈23° above horizontal; trunk-to-leg bend 0.0°",
        "peak": "Trunk ≈3°; bend -0.0°",
        "norm": "Head, trunk, hips and ankles (or knees) in one straight line throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Wrist extension",
        "setup": "≈90°",
        "peak": "≈65° at the bottom",
        "norm": "Palms flat; the wrist bends back about 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.8 s down, 0.8 s on the mat, 1.2 s up, 0.8 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up; lab studies used 2-2.5 s per repetition (Marcolin 2015)",
        "sources": [
          "marcolin2015"
        ]
      },
      {
        "measure": "Dead stop",
        "setup": "Arms straight at the top",
        "peak": "Chest on the mat for 0.8 s, neck extended so the chin clears the mat",
        "norm": "The body rests on the mat for a moment each rep, which removes the stretch-shortening rebound (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #15131, Lay Down Push-up (male) (movement reference only)",
        "url": "https://gymvisual.com/videos/15131-lay-down-push-up-male.html"
      },
      {
        "id": "marcolin2015",
        "title": "Marcolin, Petrone, Moro, Battaglia, Bianco and Paoli 2015, selective activation of shoulder, trunk and arm muscles: a comparative analysis of different push-up variants (J Athl Train 50(11):1126-1132)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26488636/"
      }
    ],
    "safety": {
      "cautions": [
        "Wrist pain: the planted palm bends the wrist back about 80-90 degrees; use push-up handles or hex dumbbells to keep the wrists straight, or stop if pain persists (clinical opinion).",
        "Low back: lift the body as one piece; a sagging press from the floor strains the low back (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Too hard from the floor: knees down for the press."
      ],
      "regressions": [
        "Knee push-up to the floor.",
        "Incline push-up."
      ],
      "progressions": [
        "Hand-release push-up (lift the hands at the bottom).",
        "Longer pause on the mat."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher with the front deltoids: flexes and adducts the upper arm as the body rises.",
      "pec_l": "Main pusher with the front deltoids: flexes and adducts the upper arm as the body rises.",
      "triceps_r": "Straightens the elbows; narrow hands raise its share (Kim 2016).",
      "triceps_l": "Straightens the elbows; narrow hands raise its share (Kim 2016).",
      "ant_deltoid_r": "Flexes the shoulder with the chest muscles.",
      "ant_deltoid_l": "Flexes the shoulder with the chest muscles.",
      "serratus_r": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "serratus_l": "Holds the shoulder blades on the rib cage and spreads them at the top.",
      "core": "Bracing keeps the hips from sagging or piking.",
      "obliques_r": "Help hold the trunk rigid and level.",
      "obliques_l": "Help hold the trunk rigid and level.",
      "rhomboids_midtrap_r": "Control the shoulder blades as they draw together on the way down.",
      "rhomboids_midtrap_l": "Control the shoulder blades as they draw together on the way down.",
      "infraspinatus_r": "Keeps the head of the upper arm centred as the elbows bend.",
      "infraspinatus_l": "Keeps the head of the upper arm centred as the elbows bend.",
      "glute_max_r": "Squeezed lightly to keep the pelvis in line.",
      "glute_max_l": "Squeezed lightly to keep the pelvis in line.",
      "quads_r": "Keep the knees straight so the legs stay part of the plank.",
      "quads_l": "Keep the knees straight so the legs stay part of the plank.",
      "spinal_extensors_r": "Hold a long, neutral spine and neck.",
      "spinal_extensors_l": "Hold a long, neutral spine and neck."
    }
