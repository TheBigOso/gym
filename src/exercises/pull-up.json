        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull up, breathe in on the way down.",
      "cadence": "About 1 s up, 2 s down"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "3-10 (or as many as you can with full range)",
      "tempo": "About 1 s up, brief hold, 2 s down",
      "load": "Body weight; add weight or use assistance to stay in the rep range",
      "frequency": "2-3 times a week",
      "progression": "More reps, then added weight (belt or vest)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hang from the bar, hands a little wider than the shoulders, palms facing away, arms straight."
      },
      {
        "id": "c2",
        "phase": "set",
        "text": "Pull the shoulder blades down and back before the elbows bend."
      },
      {
        "id": "c3",
        "phase": "pull",
        "text": "Drive the elbows down toward the ribs and pull the chest toward the bar."
      },
      {
        "id": "c4",
        "phase": "top",
        "text": "Chin over the bar, neck long, no kicking."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Lower under control all the way to straight arms."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Full hang, then the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Half reps",
        "fix": "Start each rep from straight arms and finish with the chin over the bar."
      },
      {
        "id": "m2",
        "mistake": "Kicking or swinging the legs",
        "fix": "Brace the trunk, keep the legs quiet with a slight knee bend."
      },
      {
        "id": "m3",
        "mistake": "Reaching with the chin",
        "fix": "Pull the chest toward the bar; keep the neck long."
      },
      {
        "id": "m4",
        "mistake": "Shrugging at the top",
        "fix": "Keep the shoulders down away from the ears as you pull."
      },
      {
        "id": "m5",
        "mistake": "Dropping fast on the way down",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈8° in the dead hang",
        "peak": "≈142° at the top",
        "norm": "Nearly straight in the hang to well over 90 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip width",
        "setup": "Grip points 52 cm apart (shoulder joints 39 cm in the hang): about 133% of shoulder width",
        "peak": "Unchanged (hands planted on the bar)",
        "norm": "Hands a little wider than the shoulders, about 1.2-1.5 times shoulder width (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Chin height",
        "setup": "Chin 52 cm below the bar in the dead hang",
        "peak": "Chin 2.9 cm above the bar at the top; body rises 52 cm",
        "norm": "Chin clears the bar at the top (common standard for a full rep)",
        "sources": []
      },
      {
        "measure": "Shoulder blades",
        "setup": "Elevated (26) in the hang",
        "peak": "Depressed and retracted (elevate -10, protract -16) at the top",
        "norm": "Elevated and upwardly rotated in the hang, depressed and retracted as the body rises (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.8 s, set the shoulders 0.3 s",
        "peak": "About 1.1 s up, 0.4 s hold, 2 s down",
        "norm": "About 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 1400, Pull-up, video (movement reference)",
