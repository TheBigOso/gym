    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Check the bar is secure and can take your weight before hanging from it.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Shoulder or elbow pain: shorten the range and use assistance; stop if pain increases.",
        "Step or drop down from the bar with control; do not let go at the top."
      ],
      "modify": [
        "Not yet strong enough: use a resistance band under the knees or an assisted machine.",
        "Grip fatigue: shorter sets or use straps."
      ],
      "regressions": [
        "Negative pull-up (jump to the top, lower slowly).",
        "Band-assisted pull-up.",
        "Inverted row."
      ],
      "progressions": [
        "Weighted pull-up.",
        "Pause at the top.",
        "L-sit pull-up."
      ]
    },
    "muscleNotes": {
      "lats_r": "Main mover: pull the upper arms down and in toward the ribs.",
      "biceps_r": "Bend the elbows.",
      "rhomboids_midtrap_r": "Pull the shoulder blades together as you rise.",
      "post_deltoid_r": "Help pull the arms down and back.",
      "forearm_flexors_r": "Grip the bar.",
      "infraspinatus_r": "Steadies the shoulder joint.",
      "obliques_r": "Brace the trunk so the legs do not swing.",
      "pec_r": "Helps pull the arms down from overhead.",
      "triceps_r": "Long head helps pull the arm down from overhead.",
      "serratus_r": "Controls the shoulder blade in the hang.",
      "hip_flexors_r": "Hold the legs steady in front.",
      "lats_l": "Main mover: pull the upper arms down and in toward the ribs.",
      "biceps_l": "Bend the elbows.",
      "rhomboids_midtrap_l": "Pull the shoulder blades together as you rise.",
      "post_deltoid_l": "Help pull the arms down and back.",
      "forearm_flexors_l": "Grip the bar.",
      "infraspinatus_l": "Steadies the shoulder joint.",
      "obliques_l": "Brace the trunk so the legs do not swing.",
      "pec_l": "Helps pull the arms down from overhead.",
      "triceps_l": "Long head helps pull the arm down from overhead.",
      "serratus_l": "Controls the shoulder blade in the hang.",
      "hip_flexors_l": "Hold the legs steady in front.",
      "core": "Brace so the body hangs in one line without swinging."
