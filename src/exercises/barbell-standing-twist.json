  "exercise": {
    "id": "barbell-standing-twist",
    "name": "Barbell Standing Twist",
    "aliases": [
      "Barbell torso twist",
      "Standing barbell rotation",
      "Barbell trunk twist"
    ],
    "reference": {
      "source": "GymVisual",
      "title": "Barbell Standing Twist",
      "url": "https://gymvisual.com/videos/14577-barbell-standing-twist.html",
      "productRef": "14577",
      "listing": "Video (title from the listing URL; the page could not be read from this environment, gymvisual.com is blocked by the proxy, so the movement is taken from the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Abdominals",
      "Lower back"
    ],
    "equipment": [
      "Barbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk rotation)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l",
        "glute_max_r",
        "glute_max_l",
        "upper_traps_r",
        "upper_traps_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you turn, in as you come back to the middle.",
      "cadence": "About 1.2 s to each side, 1 s back"
    },
    "prescription": {
      "frequency": "2-3 times a week",
      "rest": "30-60 seconds between sets",
      "sets": "2-3",
      "reps": "10-15 turns each side",
      "tempo": "Smooth and controlled, no bouncing at the ends",
      "load": "An empty bar or a light bar: this is a control drill, not a strength lift.",
      "progression": "Add range slowly, then pause at the end of each turn; move to cable or band rotations for load."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar across the upper back, hands just outside the shoulders, feet about shoulder width, knees soft, stand tall."
      },
      {
        "id": "c2",
        "phase": "right",
        "text": "Turn the shoulders and the bar to the right; hips and knees stay facing forward."
      },
      {
        "id": "c3",
        "phase": "back1",
        "text": "Come back to the middle under control."
      },
      {
        "id": "c4",
        "phase": "left",
        "text": "Turn to the left the same amount."
      },
      {
        "id": "c5",
        "phase": "back2",
        "text": "Back to the middle; stay tall and braced."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the bar fast",
        "fix": "Turn slowly and stop each turn with the trunk muscles, not momentum."
      },
      {
        "id": "m2",
        "mistake": "Hips turning with the shoulders",
        "fix": "Keep the belt buckle facing forward; the turn comes from above the pelvis."
      },
      {
        "id": "m3",
        "mistake": "Leaning or bending sideways",
        "fix": "Keep the bar level and the trunk tall."
      },
      {
        "id": "m4",
        "mistake": "Using a heavy bar",
        "fix": "Light bar only; the long lever loads the spine at the end range."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk rotation",
        "setup": "Shoulders square to the front",
        "peak": "±40° of spine rotation (L5 4°, T12 18°, T6 18°): shoulder line turned ≈40°; pelvis still",
        "norm": "Thoracic and lumbar rotation; the lumbar spine contributes only a few degrees (clinical opinion). Repeated loaded end-range twisting stresses the discs (Marshall and McGill 2010)",
        "sources": [
          "marshall2010"
        ]
      },
      {
        "measure": "Bar position",
        "setup": "High bar on the upper traps, 80 cm grip (handle centres), light 32 cm plates",
        "peak": "Rides with the upper back; grip width 80.06-80.06 cm",
        "norm": "High bar on the upper traps, hands just outside the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.6 s",
        "peak": "1.2 s to each side, 1 s back to the middle",
        "norm": "Controlled, no ballistic swing (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Use a light bar and a smooth, moderate range; avoid fast or bouncing twists.",
        "Back pain or a disc history: choose anti-rotation work (Pallof press) instead.",
        "Clear the space around you: the bar ends travel far.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Use a broomstick or dowel.",
        "Seated on a bench to lock the hips."
      ],
      "regressions": [
        "Band seated twist.",
        "Quadruped thoracic rotation."
      ],
      "progressions": [
        "Pause at the end of each turn.",
        "Cable or band standing rotation."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Turn the rib cage over a still pelvis and stop the turn at each end.",
      "obliques_l": "Turn the rib cage over a still pelvis and stop the turn at each end.",
      "core": "Brace the abdominal wall throughout.",
      "spinal_extensors_r": "Keep the trunk tall; the deep back muscles also help rotate.",
      "spinal_extensors_l": "Keep the trunk tall; the deep back muscles also help rotate.",
      "glute_med_r": "Holds the pelvis level and facing forward.",
      "glute_med_l": "Holds the pelvis level and facing forward.",
      "glute_max_r": "Holds the hips still.",
      "glute_max_l": "Holds the hips still.",
      "upper_traps_r": "Hold the bar on the shoulders.",
      "upper_traps_l": "Hold the bar on the shoulders.",
      "rhomboids_midtrap_r": "Keep the shoulder blades squeezed under the bar.",
      "rhomboids_midtrap_l": "Keep the shoulder blades squeezed under the bar."
    },
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Barbell Standing Twist, video (movement reference)",
