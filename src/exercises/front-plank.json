    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low back pain that increases in the plank: shorten the hold or use the knee plank.",
        "High blood pressure: breathe steadily; long breath-held efforts raise blood pressure."
      ],
      "modify": [
        "Shoulder discomfort: hands together (forearms in a slight V) or an incline plank with the forearms on a bench.",
        "Elbow discomfort: fold the mat under the forearms."
      ],
      "regressions": [
        "Knee plank (forearms and knees).",
        "Incline plank with the forearms on a bench."
      ],
      "progressions": [
        "Longer holds.",
        "Long-lever plank (elbows further forward), higher abdominal activity (Schoenfeld 2014).",
        "Plank with one foot lifted."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis and the deep abdominals resist the hips sagging. Upper rectus abdominis about 27% MVC in a 30 s forearm plank (Schoenfeld 2014); 34-40% MVIC for upper and lower rectus in a plank on the toes (Escamilla 2016).",
      "obliques_r": "External oblique was the most active abdominal in the plank: about 50% MVC (Schoenfeld 2014) and 40% MVIC (Escamilla 2016).",
      "obliques_l": "External oblique was the most active abdominal in the plank: about 50% MVC (Schoenfeld 2014) and 40% MVIC (Escamilla 2016).",
      "serratus_r": "Holds the shoulder blades flat on the rib cage as the chest pushes away from the floor.",
      "serratus_l": "Holds the shoulder blades flat on the rib cage as the chest pushes away from the floor.",
      "ant_deltoid_r": "Holds the upper arm vertical over the elbow against the forward lean of the body.",
      "ant_deltoid_l": "Holds the upper arm vertical over the elbow against the forward lean of the body.",
      "pec_r": "Helps the anterior deltoid hold the upper arms and keeps the elbows from sliding apart.",
      "pec_l": "Helps the anterior deltoid hold the upper arms and keeps the elbows from sliding apart.",
      "quads_r": "Keep the knees straight; rectus femoris about 20% MVIC on the toes, 7% on the knees (Escamilla 2016).",
      "quads_l": "Keep the knees straight; rectus femoris about 20% MVIC on the toes, 7% on the knees (Escamilla 2016).",
      "hip_flexors_r": "Rectus femoris and iliopsoas help hold the hips from sagging (clinical opinion).",
      "hip_flexors_l": "Rectus femoris and iliopsoas help hold the hips from sagging (clinical opinion).",
      "glute_max_r": "A light glute squeeze keeps the pelvis neutral (cue from the long-lever plank study, Schoenfeld 2014).",
      "glute_max_l": "A light glute squeeze keeps the pelvis neutral (cue from the long-lever plank study, Schoenfeld 2014).",
      "lats_r": "Latissimus dorsi about 18% MVIC (Escamilla 2016); helps pull the elbows toward the toes.",
      "lats_l": "Latissimus dorsi about 18% MVIC (Escamilla 2016); helps pull the elbows toward the toes.",
      "triceps_r": "Little work in the forearm plank; steadies the elbow (clinical opinion).",
      "triceps_l": "Little work in the forearm plank; steadies the elbow (clinical opinion)."
    }
  },
