    "breathing": {
      "pattern": "Breathe steadily through the hold: short breaths low into the belly while the brace stays on. Do not hold the breath.",
      "cadence": "About one breath every 3 s during the 9 s hold"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "1 hold per set",
      "tempo": "Hold 10-30 s, build toward 60 s with good form",
      "holds": "Short repeated holds (about 10 s) keep the form crisp for beginners (clinical opinion)",
      "frequency": "2-4 times a week",
      "progression": "Longer holds, then a long-lever plank (elbows further forward) or lifting one foot"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Forearms flat on the mat, elbows under the shoulders, forearms parallel, knees down, toes tucked."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Brace the stomach, squeeze the glutes and lift the knees: one straight line from head to heels."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Push the floor away with the forearms, keep the hips level and breathe steadily."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the knees to the mat under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging (low back arching)",
        "fix": "Brace the stomach and squeeze the glutes; drop to the knees if the line cannot be held."
      },
      {
        "id": "m2",
        "mistake": "Hips piked high",
        "fix": "Lower the hips until shoulders, hips and ankles line up."
      },
      {
        "id": "m3",
        "mistake": "Elbows far in front of or behind the shoulders",
        "fix": "Stack the elbows directly under the shoulders."
      },
      {
        "id": "m4",
        "mistake": "Head hanging or craning up",
        "fix": "Look at the mat just ahead of the hands; neck long."
      },
      {
        "id": "m5",
        "mistake": "Holding the breath",
        "fix": "Keep short, steady breaths through the brace."
      }
    ],
    "kinematics": [
      {
        "measure": "Body line (shoulder-hip-ankle)",
        "setup": "Kneeling: shoulder-hip-knee nearly in line (hip ≈16°)",
        "peak": "≈13° off straight (shoulder-hip-ankle)",
        "norm": "Straight line from shoulders through hips to ankles (Schoenfeld 2014 study set-up; clinical opinion for tolerance)",
        "sources": [
          "schoenfeld2014"
        ]
      },
      {
        "measure": "Elbow position",
        "setup": "Elbows on the mat, shoulders 7 cm behind them",
        "peak": "Directly under the shoulders, 40 cm apart (joint centres)",
        "norm": "Elbows directly below the shoulders, shoulder width apart, forearms and toes on the floor (Schoenfeld 2014)",
        "sources": [
          "schoenfeld2014"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈107°",
        "peak": "≈120°",
        "norm": "About 90 degrees (upper arm vertical, forearm flat) (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈16°",
        "peak": "≈0°",
        "norm": "Neutral, about 0 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈39°, knees on the mat",
        "peak": "≈3°",
        "norm": "Knees straight in the full plank; the knee-supported version roughly halves abdominal activity (Escamilla 2016)",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Trunk angle to the floor",
        "setup": "≈16°",
        "peak": "≈13°",
        "norm": "Set by arm and leg length; about 10-15 degrees for a forearm plank (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "1 s kneeling",
        "peak": "1 s lift, 9 s hold with breathing settles, 1 s lower, 1 s rest",
        "norm": "Held 30 s in the EMG study (Schoenfeld 2014); loop shows a 9 s hold",
        "sources": [
          "schoenfeld2014"
        ]
      }
    ],
