    "breathing": {
      "pattern": "Inhale as you lower the dumbbells, exhale as you press them up.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "6-12",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "Add reps up to the top of the range, then move to the next dumbbell (usually 1-2.5 kg per hand)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench, feet planted, glutes and upper back on the pad; dumbbells pressed up over the shoulders, palms toward the feet, shoulder blades pinned back."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the dumbbells under control, elbows out about 45-60 degrees from your sides, forearms vertical."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbells beside the chest, upper arms just below the bench line; feel the chest stretch, no bounce."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press up and slightly in until the arms are straight over the shoulders."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the dumbbells a few centimetres apart, shoulder blades still pinned back, then go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flared straight out at 90 degrees (a \"T\")",
        "fix": "Bring the elbows to about 45-60 degrees from the body so the upper arms point down and slightly toward the hips."
      },
      {
        "id": "m2",
        "mistake": "Bouncing out of the bottom or cutting the range short",
        "fix": "Lower under control until the dumbbells are beside the chest, pause briefly, then press."
      },
      {
        "id": "m3",
        "mistake": "Wrists bent back, dumbbells drifting toward the face or the belly",
        "fix": "Keep the forearms vertical under the dumbbells and the wrists straight."
      },
      {
        "id": "m4",
        "mistake": "Hips lifting off the bench",
        "fix": "Keep the glutes on the seat and the feet planted; a slight arch in the low back is fine, a bridge is not."
      },
      {
        "id": "m5",
        "mistake": "Dumbbells clashed together at the top",
        "fix": "Press up and slightly in, stopping with the dumbbells a few centimetres apart above the shoulders."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "Flat (0°)",
        "peak": "Glutes on the seat, upper back and head on the pad (skinned mesh within about 1 cm, measured with b2/chest_mesh.mjs)",
        "norm": "Flat (0 degrees). The middle and lower parts of the pectoralis major were most active on a flat bench (Rodríguez-Ridao 2020, barbell)",
        "sources": [
          "rodriguez2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈7° (arms straight, not locked)",
        "peak": "≈111° at the bottom",
        "norm": "Arms straight but not locked at the top; at the bottom the dumbbells reach the sides of the chest with the elbows at roughly 90-110 degrees (clinical opinion; no measured dumbbell norm found)",
        "sources": []
      },
      {
        "measure": "Elbow flare (upper arm from the trunk)",
        "setup": "Arms vertical over the shoulders",
        "peak": "≈55° at the bottom",
        "norm": "About 45-60 degrees from the body at the bottom, not a 90-degree \"T\" (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm depth",
        "setup": "–",
        "peak": "≈22° below the back plane; dumbbell centre 24.1 cm above the shoulder joint",
        "norm": "Upper arms reach about level with, or a little below, the back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell path",
        "setup": "Top: dumbbells 13.9 cm apart over the shoulders",
        "peak": "Bottom: centres 77 cm apart beside the chest, rise 33 cm",
        "norm": "Forearms vertical under the dumbbells; the dumbbells rise and come slightly together over the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench, about 90 degrees of knee flexion)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up, 0.7 s at the top",
        "norm": "Controlled: about 2 s down and 1-2 s up. Rodríguez-Ridao 2020 used 2 s down and 2 s up at 60% of 1RM",
        "sources": [
          "rodriguez2020"
        ]
      }
    ],
