    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Set the bench where it cannot slide."
      ],
      "modify": [
        "Knee pain: move the front foot farther forward and shorten the depth.",
        "Balance concerns: hold a rack or wall with one hand and one dumbbell in the other."
      ],
      "regressions": [
        "Dumbbell split squat (both feet on the floor).",
        "Bodyweight Bulgarian split squat."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Pause at the bottom.",
        "Front foot on a small plate (deficit)."
      ]
    },
    "muscleNotes": {
      "quads_r": "Front-leg knee extensors do most of the work: the front foot carried about 84% of the vertical force (Helme 2022). Vastus lateralis activity was similar to the split squat and single-leg squat (Mausehund 2019).",
      "quads_l": "Front-leg knee extensors do most of the work: the front foot carried about 84% of the vertical force (Helme 2022). Vastus lateralis activity was similar to the split squat and single-leg squat (Mausehund 2019).",
      "glute_max_r": "Front-leg hip extensor; gluteus maximus activity did not differ from the split squat or single-leg squat (Mausehund 2019).",
      "glute_max_l": "Front-leg hip extensor; gluteus maximus activity did not differ from the split squat or single-leg squat (Mausehund 2019).",
      "hamstrings_r": "Biceps femoris activity was higher than in the split squat (76% vs 62% MVIC), giving the highest hamstring-to-quadriceps ratio of the three exercises (Mausehund 2019).",
      "hamstrings_l": "Biceps femoris activity was higher than in the split squat (76% vs 62% MVIC), giving the highest hamstring-to-quadriceps ratio of the three exercises (Mausehund 2019).",
      "adductors_r": "Adductor magnus assists hip extension on the front leg (clinical opinion).",
      "adductors_l": "Adductor magnus assists hip extension on the front leg (clinical opinion).",
      "calves_r": "Steady the front shin (clinical opinion).",
      "calves_l": "Steady the front shin (clinical opinion).",
      "glute_med_r": "Holds the pelvis level on the narrow front-foot base; it was less active than in the single-leg squat (Mausehund 2019).",
      "glute_med_l": "Holds the pelvis level on the narrow front-foot base; it was less active than in the single-leg squat (Mausehund 2019).",
      "core": "Keeps the trunk tall and the pelvis square to the front.",
      "spinal_extensors_r": "Hold the trunk upright as it tips slightly forward.",
      "spinal_extensors_l": "Hold the trunk upright as it tips slightly forward.",
      "hip_flexors_r": "The rear-leg hip flexors are stretched as the hips drop (clinical opinion).",
      "hip_flexors_l": "The rear-leg hip flexors are stretched as the hips drop (clinical opinion).",
      "forearm_flexors_r": "Grip the dumbbell handles; the hands stay closed all set (clinical opinion).",
      "forearm_flexors_l": "Grip the dumbbell handles; the hands stay closed all set (clinical opinion).",
      "upper_traps_r": "Hold the shoulders level and stop the dumbbells pulling the shoulder blades down (clinical opinion).",
      "upper_traps_l": "Hold the shoulders level and stop the dumbbells pulling the shoulder blades down (clinical opinion)."
    }
