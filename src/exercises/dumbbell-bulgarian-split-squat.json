    "breathing": {
      "pattern": "Inhale on the way down, exhale on the way up.",
      "cadence": "About 1.8 s down, short pause, about 1.1 s up"
    },
    "prescription": {
      "sets": "3 per leg",
      "reps": "6-12",
      "tempo": "2-0-1-0",
      "frequency": "1-3 times a week",
      "progression": "Heavier dumbbells, a pause at the bottom, then a front-foot deficit. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Laces of the back foot on the bench, front foot about a leg length ahead, a dumbbell in each hand at the sides."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and drop the back knee straight down; the front knee travels over the foot."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Front thigh about parallel to the floor, chest tall, dumbbells hanging beside the front foot."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive through the whole front foot to stand up."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the stance and repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Front foot too close to the bench",
        "fix": "Move it forward until the front shin is near vertical at the bottom and the heel stays down."
      },
      {
        "id": "m2",
        "mistake": "Pushing hard through the back foot",
        "fix": "The back foot only balances; the front leg does the work."
      },
      {
        "id": "m3",
        "mistake": "Front knee caving inward",
        "fix": "Keep the knee over the 2nd-3rd toe."
      },
      {
        "id": "m4",
        "mistake": "Toes curled under on the bench",
        "fix": "Rest the laces flat on the bench so the ankle stays relaxed."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench height",
        "setup": "45 cm flat bench, rear ankle 3 cm past its near edge",
        "peak": "Rear foot (laces) stays on the pad",
        "norm": "About knee height, 40-50 cm is common (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Stance length (front ankle to bench edge)",
        "setup": "84 cm between ankle centres (87 cm from the bench edge to the front ankle; rig leg length 90 cm hip to floor)",
        "peak": "Unchanged",
        "norm": "About one leg length from the rear support (common coaching); about one leg length was suggested as optimal in the split squat (Song 2023)",
        "sources": [
          "song2023"
        ]
      },
      {
        "measure": "Front knee flexion",
        "setup": "≈14°",
        "peak": "≈95°, shin ≈10° forward of vertical",
        "norm": "About 90 degrees with the front thigh near parallel (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Rear knee",
        "setup": "≈92°",
        "peak": "≈104°, 18.9 cm above the floor (knee joint centre)",
        "norm": "Drops toward the floor; the rear foot stays on the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈1°",
        "peak": "≈13° forward",
        "norm": "Upright to slightly forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.8 s down, 0.3 s pause, 1.1 s up, 1.0 s reset",
        "norm": "About 2 s down, 1 s up (clinical opinion)",
        "sources": []
      }
