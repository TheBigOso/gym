        "infraspinatus_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you press forward and down, breathe in as the band draws the hands back to the chest.",
      "cadence": "About 1 s press, short hold, about 2 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-0 (2 s back, 1 s press)",
      "progression": "More reps, a slower return, a step farther from the rack, then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop a band round each rack upright behind you, above shoulder height. Staggered stance, knees soft, ribs down; a band end in each hand beside the lower chest, palms down, elbows back and out about 45 degrees."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and press forward and slightly down, about 15-20 degrees below horizontal, until the arms are nearly straight in front of the lower chest."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hands about lower-chest height and close together; shoulders down, do not let the band pull the trunk back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the hands come back to the chest slowly along the same line."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief pause with the band still taut, then press again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pressing straight ahead or up so the line of pull no longer matches the band",
        "fix": "Aim the hands at a point a little below the chest; the band should run in line with the forearms."
      },
      {
        "id": "m2",
        "mistake": "Leaning back or arching the low back as the band tightens",
        "fix": "Ribs down, glutes lightly braced, weight over the front foot; use a lighter band."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the end of the press",
        "fix": "Reach forward but keep the shoulders down."
      },
      {
        "id": "m4",
        "mistake": "Letting the band snap the hands back",
        "fix": "Return for about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Press angle",
        "setup": "Hands beside the chest, 14.1 cm below shoulder height",
        "peak": "Hands travel ≈17° below horizontal to 25.2 cm below the shoulders, 27.9 cm apart",
        "norm": "Hands travel forward and a little down (about 15-20 degrees below horizontal), the line of a decline press, which favours the lower (sternal) fibres of the chest (clinical opinion; the bench-angle EMG study tested only flat-to-incline angles, Rodríguez-Ridao 2020).",
        "sources": [
          "rodriguez2020"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈138° at the chest",
        "peak": "≈11° (nearly straight)",
        "norm": "About 90-110 degrees at the chest to nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flare",
        "setup": "Upper arm ≈35° out from the side (front view)",
        "peak": "Arms reach forward and down",
        "norm": "About 45 degrees from the body at the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack uprights 50 cm behind, 157.9 cm up, 150 cm apart; strands 93.3 cm",
        "peak": "Strands 132.2 cm at the end of the press; at least 4.8 cm from the body",
        "norm": "Elastic resistance can give muscle activity comparable to free weights at a matched effort (Andersen 2010).",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Stance",
        "setup": "Staggered: right foot 24 cm forward, left 22 cm back, knees soft",
        "peak": "Unchanged (trunk still)",
        "norm": "Staggered stance, knees soft, so the band does not pull you backward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the chest",
        "peak": "1.1 s press, 0.4 s hold, 1.8 s return, 0.4 s pause",
        "norm": "About 1 s press and 2 s return (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Low Chest Press, video (movement reference)",
