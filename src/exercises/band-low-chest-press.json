      "Triceps"
    ],
    "equipment": [
      "Resistance band (two)",
      "Rack (band anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Transverse",
    "laterality": "Bilateral",
