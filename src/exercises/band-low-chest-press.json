      },
      {
        "id": "rodriguez2020",
        "title": "Rodríguez-Ridao, Antequera-Vique, Martín-Fuentes and Muyor 2020, effect of five bench inclinations on the electromyographic activity of the pectoralis major, anterior deltoid and triceps brachii during the bench press exercise (Int J Environ Res Public Health 17(19):7339; PMC7579505)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7579505/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      },
      {
        "id": "saeterbakken2011",
        "title": "Saeterbakken, van den Tillaar and Fimland 2011, a comparison of muscle activity and 1-RM strength of three chest-press exercises with different stability requirements (J Sports Sci 29(5):533-538; PubMed 21225489)",
        "url": "https://read.qxmd.com/read/21225489/a-comparison-of-muscle-activity-and-1-rm-strength-of-three-chest-press-exercises-with-different-stability-requirements"
      }
    ],
    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Shoulder pain: shorten the range at the chest (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: palms facing each other and the elbows a little more tucked.",
        "Balance: widen the staggered stance."
      ],
      "regressions": [
        "Lighter band or step closer to the rack.",
        "Incline push-up."
      ],
      "progressions": [
        "Stronger band or a step farther from the rack.",
        "Slower 3 s return with a pause at the chest.",
        "Dips (when the gear is available) or a decline press."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher; pressing down and forward biases the lower (sternal) fibres (clinical opinion).",
      "pec_l": "Main pusher; pressing down and forward biases the lower (sternal) fibres (clinical opinion).",
      "ant_deltoid_r": "Flexes the shoulder with the chest; less involved than in an incline press because the arms finish below shoulder height.",
      "ant_deltoid_l": "Flexes the shoulder with the chest; less involved than in an incline press because the arms finish below shoulder height.",
      "triceps_r": "Straightens the elbows to finish the press.",
      "triceps_l": "Straightens the elbows to finish the press.",
      "serratus_r": "Carries the shoulder blades forward round the rib cage at the end of the press.",
      "serratus_l": "Carries the shoulder blades forward round the rib cage at the end of the press.",
      "biceps_r": "Stabiliser at the elbow and shoulder (Saeterbakken 2011 found higher biceps activity with less stable loads).",
      "biceps_l": "Stabiliser at the elbow and shoulder (Saeterbakken 2011 found higher biceps activity with less stable loads).",
      "forearm_flexors_r": "Grip the band.",
      "forearm_flexors_l": "Grip the band.",
      "infraspinatus_r": "Rotator cuff: centres the head of the upper arm (clinical opinion).",
      "infraspinatus_l": "Rotator cuff: centres the head of the upper arm (clinical opinion).",
      "rhomboids_midtrap_r": "Control the shoulder blades on the return.",
      "rhomboids_midtrap_l": "Control the shoulder blades on the return.",
      "core": "Keeps the trunk upright against the band (clinical opinion)."
    }
  },
