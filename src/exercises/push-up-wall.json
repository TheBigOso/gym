  "exercise": {
    "id": "push-up-wall",
    "name": "Push-up (wall)",
    "aliases": [
      "Wall push-up",
      "Standing wall press-up",
      "Wall press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "10390",
      "title": "Push-up (wall)",
      "url": "https://gymvisual.com/videos/10390-push-up-wall.html",
      "listing": "Video (movement reference only; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Arms (triceps)",
      "Shoulders (front delts)",
      "Core"
    ],
    "equipment": [
      "Wall"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder horizontal adduction and elbow extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l",
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l",
        "glute_max_r",
        "glute_max_l",
        "quads_r",
        "quads_l",
        "calves_r",
        "calves_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as you lean toward the wall, breathe out as you push away.",
      "cadence": "About 1.6 s in, 1.1 s out"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-20",
      "tempo": "About 1.6 s in, short pause, 1.1 s out",
      "load": "Body weight (stand further from the wall for more)",
      "frequency": "2-4 times a week",
      "progression": "Feet further back, then incline push-ups on a bench, then floor push-ups"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing a wall, feet hip width and about an arm's length or more back. Hands on the wall at shoulder height, a little wider than the shoulders, arms straight."
      },
      {
        "id": "c2",
        "phase": "down",
        "text": "Lean in as one piece, bending the elbows (about 30-45 degrees from the body) until the face is close to the wall. Heels stay down."
      },
      {
        "id": "c3",
        "phase": "pause",
        "text": "Brief pause, body straight."
      },
      {
        "id": "c4",
        "phase": "up",
        "text": "Push the wall away back to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Body in one line, then the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging toward the wall",
        "fix": "Squeeze the glutes and keep the body in one line."
      },
      {
        "id": "m2",
        "mistake": "Only bending the neck toward the wall",
        "fix": "The whole body leans; the head stays in line."
      },
      {
        "id": "m3",
        "mistake": "Elbows flaring straight out",
        "fix": "Keep them about 30-45 degrees from the body."
      },
      {
        "id": "m4",
        "mistake": "Feet too close to the wall",
        "fix": "Step back until you feel the chest and arms working."
      },
      {
        "id": "m5",
        "mistake": "Hands too high",
        "fix": "Hands at about shoulder height."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈11° (arms straight, not locked)",
        "peak": "≈117° with the nose 4 cm from the wall",
        "norm": "Straight to well bent (about 90 degrees or more) near the wall (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Body lean",
        "setup": "≈15° from vertical (ankles to C7)",
        "peak": "≈29° from vertical at the bottom",
        "norm": "The whole body leans forward from the ankles; the steeper the body, the lower the load on the hands (push-up load falls as the hands go higher: Wurm 2010)",
        "sources": [
          "wurm2010"
        ]
      },
      {
        "measure": "Hand position",
        "setup": "Wrists 122 cm up (shoulders 126 cm), 52 cm apart; wall 94 cm in front of the ankles",
        "peak": "Unchanged (hands planted)",
        "norm": "Shoulder height, a little wider than the shoulders (common coaching standard)",
        "sources": []
      },
      {
        "measure": "Ankle",
        "setup": "Dorsiflexion ≈19°, heels down",
        "peak": "≈32° at the bottom (limit 35°)",
        "norm": "Heels down; the ankles bend as the body leans (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.6 s in, 0.3 s pause, 1.1 s out, 0.8 s at the top",
        "norm": "About 1.6 s in, 1.1 s out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 10390, Push-up (wall), video (movement reference)",
        "url": "https://gymvisual.com/videos/10390-push-up-wall.html"
      },
      {
        "id": "wurm2010",
        "title": "Wurm, VanderZanden, Spadavecchia, Durocher, Bickham, Petushek and Ebben, kinetic analysis of several variations of push-ups (ISBS 2010 conference proceedings; peak hand force 64% of body mass for a regular push-up, 70% and 74% with the feet on 30.5 cm and 61 cm boxes)",
        "url": "https://ojs.ub.uni-konstanz.de/cpa/article/view/4457"
      },
      {
        "id": "kim2016",
        "title": "Kim, Kim and Ha 2016, effect of the push-up exercise at different palmar width on muscle activities (J Phys Ther Sci 28(2):446-449; PMC4792988)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4792988/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Wear shoes that do not slip, or stand on a non-slip surface."
      ],
      "modify": [
        "Step closer to the wall to make it easier.",
        "Wrist discomfort: hands a little lower or turned slightly out."
      ],
      "regressions": [
        "Smaller range (lean in only part way)."
      ],
      "progressions": [
        "Feet further back.",
        "Incline push-up on a bench.",
        "Knee push-up, then the floor push-up."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main mover: lower and press the body.",
      "pec_l": "Main mover: lower and press the body.",
      "triceps_r": "Straighten the elbows.",
      "triceps_l": "Straighten the elbows.",
      "ant_deltoid_r": "Helps press the arms forward.",
      "ant_deltoid_l": "Helps press the arms forward.",
      "serratus_r": "Keeps the shoulder blades flat on the ribs and pushes them forward at the top.",
      "serratus_l": "Keeps the shoulder blades flat on the ribs and pushes them forward at the top.",
      "core": "Holds the body in one straight line.",
      "obliques_r": "Stop the hips sagging or twisting.",
      "obliques_l": "Stop the hips sagging or twisting.",
      "rhomboids_midtrap_r": "Control the shoulder blades as they move back and forth.",
      "rhomboids_midtrap_l": "Control the shoulder blades as they move back and forth.",
      "infraspinatus_r": "Steadies the shoulder joint.",
      "infraspinatus_l": "Steadies the shoulder joint.",
      "glute_max_r": "Squeeze to keep the hips in line.",
      "glute_max_l": "Squeeze to keep the hips in line.",
      "quads_r": "Keep the knees straight.",
      "quads_l": "Keep the knees straight.",
      "spinal_extensors_r": "Stop the back rounding.",
      "spinal_extensors_l": "Stop the back rounding.",
      "calves_r": "Keep the heels down and the ankles steady as the body leans.",
      "calves_l": "Keep the heels down and the ankles steady as the body leans."
    }
