  },
  "exercise": {
    "id": "captains-chair-leg-raise",
    "name": "Captain's Chair Leg Raise",
    "aliases": [
      "Captain's chair knee raise",
      "Vertical knee raise",
      "Roman chair knee raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "004161",
      "title": "Captains chair leg raise",
      "url": "https://gymvisual.com/videos/4161-captains-chair-leg-raise.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Captain's chair (vertical knee raise station)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip flexion with posterior pelvic tilt)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "lats_r",
        "lats_l",
        "triceps_r",
        "triceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you raise the legs, inhale as you lower them.",
      "cadence": "About 1.5 s up, a short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "1.5 s up, brief pause, 2 s down",
      "frequency": "2-3 times a week",
      "progression": "Pause at the top, then straight-leg raises"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Back flat against the pad, forearms on the rests, hands on the handles, legs hanging."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and bring the knees up toward the chest, curling the pelvis up at the end."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause with the knees high and the low back pressed into the pad."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the legs slowly without swinging."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Legs hang still, back on the pad; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the legs up",
        "fix": "Start from a still hang and lift under control."
      },
      {
        "id": "m2",
        "mistake": "Stopping at hip height without curling the pelvis",
        "fix": "Finish by tilting the pelvis up toward the chest."
      },
      {
        "id": "m3",
        "mistake": "Arching the back off the pad",
        "fix": "Keep the back on the pad."
      },
      {
        "id": "m4",
        "mistake": "Shrugging the shoulders to the ears",
        "fix": "Press down on the forearms and keep the neck long."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈4° (legs hanging)",
        "peak": "≈92° at the top; thighs ≈108° from hanging",
        "norm": "From hanging to knees above hip height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈6°",
        "peak": "≈100° (knees to the chest)",
        "norm": "Knees bend to about 90 degrees or more as they rise (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvic tilt",
        "setup": "Neutral, back flat on the pad",
        "peak": "≈16° posterior tilt at the top (low back rounds into the pad)",
        "norm": "Posterior tilt at the top brings in the abdominals (Escamilla 2006)",
        "sources": [
          "escamilla2006"
        ]
      },
      {
        "measure": "Support",
        "setup": "Forearms on the rests (127.8 cm high), hands on the handles; feet 14.5 cm or more off the floor",
        "peak": "Upper trunk still (moves ≤0.1 cm)",
        "norm": "Upper body still on the forearm rests (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #004161, Captains chair leg raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/4161-captains-chair-leg-raise.html"
      },
      {
        "id": "ace2001",
        "title": "ACE-sponsored study, Francis and Davis (San Diego State University Biomechanics Lab) 2001, best and worst abdominal exercises, 30 adults, EMG relative to a crunch (ACE FitnessMatters, May/June 2001)",
        "url": "https://www.acefitness.org/getfit/studies/BestWorstAbExercises.pdf"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises: implications for rehabilitation and training (Phys Ther 86(5):656-671; PubMed 16649890)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/16649890/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Low-back pain: the hip flexors pull on the lumbar spine when the legs are long; start with bent knees and a small range (clinical opinion).",
        "Shoulder pain while supported on the forearms: stop and use a floor variation.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Bent knees instead of straight legs.",
        "Smaller range: thighs to horizontal only."
      ],
      "regressions": [
        "Lying reverse crunch.",
        "Bent-knee raise with a pause."
      ],
      "progressions": [
        "Straight legs.",
        "Slow 3 s lowering.",
        "Hanging knee or leg raise."
      ]
    },
    "muscleNotes": {
      "core": "The captain's chair was among the most effective rectus abdominis and oblique exercises in the ACE-sponsored study (ACE 2001); the abdominals work hardest when the pelvis curls up at the top.",
      "hip_flexors": "Iliopsoas and rectus femoris lift the legs; the abdominals tilt the pelvis.",
      "obliques": "High oblique activity in the captain's chair (ACE 2001)."
    }
  },
