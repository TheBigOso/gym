  "exercise": {
    "id": "ez-barbell-anti-gravity-press",
    "name": "EZ Barbell Anti-Gravity Press",
    "aliases": [
      "Prone incline EZ bar press",
      "EZ bar prone press",
      "Incline prone overhead press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5059",
      "title": "EZ Barbell Anti-Gravity Press",
      "url": "https://gymvisual.com/videos/5059-ez-barbell-anti-gravity-press.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Shoulders (deltoids, lower trapezius)",
    "secondaryBodyParts": [
      "Upper back",
      "Triceps"
    ],
    "equipment": [
      "EZ curl bar",
      "Adjustable bench (incline)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "lat_deltoid_r",
        "lat_deltoid_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "synergist": [
        "triceps_r",
        "triceps_l",
        "serratus_r",
        "serratus_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "post_deltoid_r",
        "post_deltoid_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you press the bar out past the head, breathe in as you bring it back.",
      "cadence": "About 1.2 s out, short pause, about 2 s back"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-1",
      "load": "Light: the arms work against gravity far out in front (RIR 2-3, clinical opinion)",
      "frequency": "2 times a week",
      "progression": "Add small plates"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down on a bench set to about 45 degrees, chest on the pad, feet on the floor; hold the EZ bar overhand on the outer cambers at the level of the forehead, elbows bent and out."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press the bar forward past the head in line with the body until the arms are long."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms beside the ears; reach a little with the shoulder blades."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and bring the bar back to the forehead under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Chest stays on the pad; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the chest off the pad",
        "fix": "Keep the chest down; let the shoulders do the work."
      },
      {
        "id": "m2",
        "mistake": "Pressing up instead of out",
        "fix": "Press in line with the bench, past the head."
      },
      {
        "id": "m3",
        "mistake": "Shrugging hard",
        "fix": "Let the shoulder blades rotate up, not hike to the ears."
      },
      {
        "id": "m4",
        "mistake": "Too heavy",
        "fix": "Use a light bar: the lever is long."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "45° pad, chest on the pad, chin over the top",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "About 45 degrees, chest supported (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation",
        "setup": "Upper arm ≈78° from the trunk",
        "peak": "≈172° with the arms long past the head",
        "norm": "Upper arm rises from about 90 degrees to about 150-170 degrees from the trunk (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈112°",
        "peak": "≈8°",
        "norm": "From about 90-110 degrees at the head to nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Overhand on the outer cambers, 44 cm between the grip points",
        "peak": "Grip width steady within 0.4 cm; bar at least 2.7 cm off the body and 7.5 cm off the bench",
        "norm": "Overhand on the outer cambers of the EZ bar (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.6 s set",
        "peak": "1.2 s out, 0.4 s hold, 2 s back",
        "norm": "About 1 s out, 2 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #5059, EZ Barbell Anti-Gravity Press, video (movement reference)",
