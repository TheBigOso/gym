    "id": "band-chest-fly",
    "name": "Band Chest Fly",
    "aliases": [
      "Standing band fly",
      "Resistance band chest fly",
      "Band pec fly"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9446",
      "title": "Band Chest Fly",
      "url": "https://gymvisual.com/videos/9446-band-chest-fly-male.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (the proxy refused gymvisual.com), so the data sheet was not read; the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Front of the shoulders",
      "Biceps (stabiliser)"
    ],
    "equipment": [
      "Resistance band (two)",
      "Rack (band anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "biceps_r",
        "biceps_l"
      ],
      "stabilizer": [
        "serratus_r",
        "serratus_l",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "infraspinatus_r",
        "infraspinatus_l",
        "core"
      ],
      "lengthened": [
        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the arms sweep together, breathe in as they open.",
      "cadence": "About 1 s in, short squeeze, about 2 s out"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "frequency": "1-3 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; step farther from the anchor, or choke up on the band, for more tension.",
      "tempo": "2-0-1-1 (2 s open, 1 s close, 1 s squeeze)",
      "progression": "More reps, a slower opening, a step farther from the rack, then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Loop a band round each rack upright behind you at about shoulder height. Staggered stance, knees soft, chest up; a band end in each hand, arms out to the sides at shoulder height, elbows slightly bent, palms forward."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and hug the arms forward in a wide arc until the hands meet in front of the chest; keep the elbow bend fixed."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Hands together in front of the chest, shoulders down; squeeze the chest."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the band draw the arms back out to the sides, stopping with the hands level with the shoulders."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Short pause with the band taut, then sweep again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending and straightening the elbows (turning the fly into a press)",
        "fix": "Lock the elbow angle and move only at the shoulders."
      },
      {
        "id": "m2",
        "mistake": "Letting the hands drift behind the body at the open position",
        "fix": "Stop with the hands about level with the shoulders."
      },
      {
        "id": "m3",
        "mistake": "Shrugging or rolling the shoulders forward",
        "fix": "Keep the chest up and the shoulders down."
      },
      {
        "id": "m4",
        "mistake": "Leaning back as the band tightens",
        "fix": "Weight over the front foot, ribs down."
      }
    ],
    "kinematics": [
      {
        "measure": "Horizontal adduction",
        "setup": "Arms ≈7° behind the frontal plane, hands at shoulder height",
        "peak": "Hands together in front of the chest, 2.8 cm apart",
        "norm": "Arms from out to the side (about level with the body) to in front of the chest with the hands together (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈20°, held",
        "peak": "≈20° (unchanged)",
        "norm": "Fixed, about 15-25 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arm height",
        "setup": "≈83° of elevation",
        "peak": "≈80° of elevation",
        "norm": "About shoulder height throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Looped round the rack uprights 30 cm behind, 129.8 cm up, 150 cm apart; strands 28.3 cm",
        "peak": "Strands 115.5 cm with the hands together; at least 2.7 cm from the body",
        "norm": "Anchored behind at shoulder height: tension is highest with the hands together, where a dumbbell fly loses its load; dumbbell flyes and the bench press give similar pectoral activity (Solstad 2020); elastic resistance can match free weights (Andersen 2010).",
        "sources": [
          "solstad2020",
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s open",
        "peak": "1.1 s in, 0.4 s squeeze, 1.8 s out, 0.4 s pause",
        "norm": "About 1 s in and 2 s out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Band Chest Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/9446-band-chest-fly-male.html"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjornlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://doi.org/10.2522/ptj.20090167"
      }
    ],
    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a pull-up bar or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is heaviest at the end of the pull or push; let it return under control rather than snapping back.",
        "Do not let the band pull the arms back past the body; the stretched shoulder is vulnerable at the open position (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: smaller range, hands stop in front of the shoulders."
      ],
      "regressions": [
        "Lighter band or step closer to the rack.",
        "One arm at a time."
      ],
      "progressions": [
        "Stronger band or step farther from the rack.",
        "Pause 2 s with the hands together.",
        "Cable standing fly."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main mover: brings the arm across the body (horizontal adduction) and, with the shoulder, presses the hands forward. Dumbbell flyes gave pectoral activity similar to the bench press (Solstad 2020).",
      "pec_l": "Main mover: brings the arm across the body (horizontal adduction) and, with the shoulder, presses the hands forward. Dumbbell flyes gave pectoral activity similar to the bench press (Solstad 2020).",
      "ant_deltoid_r": "Assists horizontal adduction.",
      "ant_deltoid_l": "Assists horizontal adduction.",
      "biceps_r": "Holds the slight elbow bend against the band; the biceps were more active in flyes than in the bench press (Solstad 2020).",
      "biceps_l": "Holds the slight elbow bend against the band; the biceps were more active in flyes than in the bench press (Solstad 2020).",
      "serratus_r": "Keeps the shoulder blades against the rib cage.",
      "serratus_l": "Keeps the shoulder blades against the rib cage.",
      "forearm_flexors_r": "Grip the band.",
      "forearm_flexors_l": "Grip the band.",
      "infraspinatus_r": "Rotator cuff: steadies the shoulder at the open position (clinical opinion).",
      "infraspinatus_l": "Rotator cuff: steadies the shoulder at the open position (clinical opinion).",
      "core": "Keeps the trunk still against the bands (clinical opinion)."
    }
  },
