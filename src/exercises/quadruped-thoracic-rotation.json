{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "quadruped-thoracic-rotation",
    "name": "Quadruped Thoracic Rotation",
    "aliases": [
      "Lumbar-locked thoracic rotation",
      "Quadruped T-spine rotation, hand behind head",
      "Sit-back thoracic rotation"
    ],
    "reference": {
      "source": "Ask Doctor Jo (YouTube)",
      "title": "Thoracic Rotation in Quadruped",
      "url": "https://www.youtube.com/watch?v=snzLuyYgbVI",
      "note": "Video used only to identify the movement. This rig, model and animation are original."
    },
    "type": "Stretching / dynamic mobility",
    "bodyPart": "Back (thoracic spine)",
    "secondaryBodyParts": [
      "Shoulders",
      "Chest",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (spinal mobility)",
    "plane": "Transverse",
    "laterality": "Unilateral (alternate sides)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "post_deltoid_r",
        "infraspinatus_r"
      ],
      "stabilizer": [
        "serratus_l",
        "triceps_l",
        "core",
        "glute_med_r",
        "glute_med_l"
      ],
      "lengthened": [
        "pec_r",
        "ant_deltoid_r"
      ]
    },
    "muscleNotes": {
      "obliques_r": "Internal oblique on the turning side helps drive the turn toward it.",
      "obliques_l": "External oblique on the opposite side pairs with it to turn the rib cage.",
      "spinal_extensors_l": "Deep rotators (multifidus/rotatores) turn the spine toward the opposite side, so the left side works on a right turn.",
      "spinal_extensors_r": "Keeps the upper back long so the turn is rotation, not rounding.",
      "rhomboids_midtrap_r": "Draws the shoulder blade back as the elbow opens toward the ceiling.",
      "post_deltoid_r": "Carries the elbow up and back.",
      "infraspinatus_r": "Holds the upper arm turned out with the hand behind the head.",
      "serratus_l": "Pushes the floor away so the support shoulder blade stays flat.",
      "triceps_l": "Keeps the support arm long without locking the elbow.",
      "core": "Light brace; sitting back already limits the lower back.",
      "glute_med_r": "Keeps the hips level on the heels.",
      "glute_med_l": "Keeps the hips level on the heels.",
      "pec_r": "Lengthens across the front of the chest at the top.",
      "ant_deltoid_r": "Lengthens at the front of the shoulder at the top."
    },
    "breathing": {
      "pattern": "Inhale as the elbow drops toward the opposite hand; exhale slowly as you rotate up toward the ceiling; keep breathing in the hold; inhale on the way back.",
      "cadence": "About 1.5 s down, 2 s up, 1–2 s hold, 1.5 s return"
    },
    "prescription": {
      "sets": "1–3",
      "reps": "8–10 per side",
      "endRangeHold": "1–2 s per rep",
      "staticOption": "20–30 s hold at the top, 2–3 times per side",
      "frequency": "Daily or as a warm-up",
      "tempo": "1.5–2–1.5 (down–up–return)"
    },
    "cues": [
      {
        "id": "b1",
        "phase": "setup",
        "text": "On hands and knees, sit the hips back toward the heels. This locks the lower back so the turn has to come from the upper back. Place the right hand behind the head."
      },
      {
        "id": "b2",
        "phase": "down",
        "text": "Breathe in and turn the chest down, bringing the right elbow toward the left hand."
      },
      {
        "id": "b3",
        "phase": "rotate",
        "text": "Breathe out and rotate up, opening the elbow toward the ceiling. Eyes follow the elbow."
      },
      {
        "id": "b4",
        "phase": "hold",
        "text": "Pause at the top. Hips stay on the heels and the support arm stays long."
      },
      {
        "id": "b5",
        "phase": "return",
        "text": "Rotate back to the start under control."
      },
      {
        "id": "b6",
        "phase": "reset",
        "text": "Reset a long spine, then repeat or switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "n1",
        "mistake": "Letting the hips drift forward off the heels",
        "fix": "Stay sat back; once the hips lift, the lower back joins in and the drill stops isolating the upper back."
      },
      {
        "id": "n2",
        "mistake": "Pulling on the head with the hand",
        "fix": "Rest the fingertips lightly behind the head; the hand is only there to set the arm position."
      },
      {
        "id": "n3",
        "mistake": "Flapping the elbow instead of turning the rib cage",
        "fix": "Keep the elbow wide and in line with the chest; it only rises as far as the chest turns."
      },
      {
        "id": "n4",
        "mistake": "Sinking into the support shoulder",
        "fix": "Push the floor away so the shoulder blade stays flat on the rib cage."
      },
      {
        "id": "n5",
        "mistake": "Rushing or holding the breath",
        "fix": "Rotate up on a slow exhale and pause at the top."
      },
      {
        "id": "n6",
        "mistake": "Cranking the neck",
        "fix": "Let the head follow the rib cage; the eyes track the elbow."
      }
    ],
    "kinematics": [
      {
        "measure": "Thoracic rotation (T12–T1)",
        "setup": "0°",
        "peak": "≈44°",
        "norm": "Lumbar-locked test mean ≈41° (SD ≈11°); ≥50° counted as unrestricted",
        "sources": [
          "johnson2012",
          "whetstone2024"
        ]
      },
      {
        "measure": "Lumbar rotation (L5–S1 to T12)",
        "setup": "0°",
        "peak": "≈2°",
        "norm": "Near zero: sitting back locks the lumbar spine",
        "sources": [
          "johnson2012"
        ]
      },
      {
        "measure": "Total trunk rotation",
        "setup": "0°",
        "peak": "≈46°",
        "norm": "≈45° thoracolumbar per side",
        "sources": [
          "nasm"
        ]
      },
      {
        "measure": "Rotation toward the support side (elbow down)",
        "setup": "0°",
        "peak": "≈28°",
        "norm": "Comfortable range only",
        "sources": []
      },
      {
        "measure": "Hips",
        "setup": "≈135° flexion, sat back",
        "peak": "Unchanged; hips stay back on heels",
        "norm": "Sat back toward the heels",
        "sources": [
          "johnson2012"
        ]
      },
      {
        "measure": "Knees",
        "setup": "≈138° flexion",
        "peak": "Unchanged",
        "norm": "Shins on mat",
        "sources": []
      },
      {
        "measure": "Working arm",
        "setup": "Hand behind head, elbow wide",
        "peak": "Elbow points toward the ceiling",
        "norm": "Elbow stays in line with the chest",
        "sources": [
          "askdoctorjo"
        ]
      }
    ],
