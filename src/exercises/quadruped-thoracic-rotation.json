    "safety": {
      "cautions": [
        "Stop if rotation causes sharp, radiating or nerve-type pain.",
        "Knee discomfort when sitting back: place a cushion between hips and heels."
      ],
      "modify": [
        "Hip or knee flexion limits that stop you sitting back: sit back only as far as is comfortable.",
        "Recent spinal surgery or osteoporosis with fracture risk: get clearance first."
      ],
      "regressions": [
        "Keep the hips over the knees (less lumbar lock).",
        "Forearm-supported version."
      ],
      "progressions": [
        "Pause 2–3 s at the top.",
        "Add a light band pulling the elbow up."
      ]
    }
