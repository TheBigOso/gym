    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.5 s down, brief pause at the bottom"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-12",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Load is user-chosen: pick a dumbbell you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion); add reps, then weight. Start light: the stretched start makes the weight feel heavier (clinical opinion)."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back on a flat bench, feet flat on the floor. Let the arms hang down below the bench, slightly out to the sides, palms up."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the dumbbells up toward the shoulders; the upper arms stay where they hang."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze at the top; shoulders stay on the bench."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the arms are straight again."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause briefly in the stretch, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the elbows up toward the ceiling",
        "fix": "Keep the upper arms hanging below the bench; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Arching the back off the bench",
        "fix": "Keep the hips and shoulders on the pad, feet planted."
      },
      {
        "id": "m3",
        "mistake": "Dropping into the bottom",
        "fix": "Lower slowly and pause at straight arms."
      },
      {
        "id": "m4",
        "mistake": "Going too heavy for the stretched position",
        "fix": "Use a lighter dumbbell than for a standing curl."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈8° (arm straight)",
        "peak": "≈130° at the top (range ≈122°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "53.8° (semi-supinated)",
        "peak": "-33.9° (palm forward/up)",
        "norm": "The supinated grip gave the highest biceps activity in the lifting phase; neutral grips shift work toward the brachioradialis (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈37° below horizontal (below the bench line), ≈53° out from straight down",
        "peak": "Unchanged: pure elbow hinge",
        "norm": "Upper arms hang below the bench line (shoulder extended past the trunk), similar to the incline curl but further (clinical opinion); Attarieh 2025 trained the biceps with the shoulder extended about 50 degrees",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms hanging 0.8 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.5 s down, 1.2 s pause in the stretch",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Back on the bench (skinned mesh gap)",
        "setup": "Glutes and upper back on the pad, head resting with a small neutral lift (batch 3 flat-bench base)",
        "peak": "Unchanged",
        "norm": "Shoulders, back and hips on the pad, feet flat (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #035012, Dumbbell Lying Supine Curl, video (movement reference)",
