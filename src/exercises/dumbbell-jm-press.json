    "bodyPart": "Upper Arms",
    "secondaryBodyParts": [
      "Chest",
      "Front of the shoulders"
    ],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (elbow and shoulder)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [
        "pec_r",
        "pec_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the dumbbells come down toward the upper chest, exhale as you press.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-0",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "More reps, then the next dumbbell; keep the elbow path the same."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench, feet planted; dumbbells straight up over the shoulders, palms facing each other, elbows tucked."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and let the elbows bend and drift down toward your feet together, bringing the dumbbells back toward the upper chest and chin."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbells just above the upper chest, forearms angled back, elbows pointing toward the feet; no contact with the face."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and push the dumbbells straight back up, straightening the elbows."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms vertical over the shoulders; reset and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Turning it into a regular press (elbows flaring out to the sides)",
        "fix": "Keep the elbows tucked and pointing toward the feet."
      },
      {
        "id": "m2",
        "mistake": "Turning it into a skull crusher (upper arms still)",
        "fix": "Let the elbows travel down toward the feet as the forearms fold back; both joints move."
      },
      {
        "id": "m3",
        "mistake": "Dumbbells crashing toward the face",
        "fix": "Lower under control to just above the upper chest."
      },
      {
        "id": "m4",
        "mistake": "Too heavy too soon",
        "fix": "Elbow-dominant pressing is hard on the elbows: progress slowly (clinical opinion)."
      },
      {
        "id": "m5",
        "mistake": "Wrists bent back",
        "fix": "Keep the wrists straight."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (arms straight over the shoulders)",
        "peak": "≈118° at the bottom",
        "norm": "From straight to deeply bent (about 110-130 degrees of flexion) at the bottom (clinical opinion; no measured norm found)",
        "sources": []
      },
      {
        "measure": "Upper arm angle",
        "setup": "≈4° from vertical",
        "peak": "≈42° from vertical toward the feet at the bottom",
        "norm": "The upper arms tilt toward the feet as the elbows bend, about 40-55 degrees from vertical at the bottom (clinical opinion); the poster in Puluka reports less shoulder involvement than a regular press",
        "sources": [
          "puluka"
        ]
      },
      {
        "measure": "Dumbbell path",
        "setup": "Over the shoulders",
        "peak": "Dumbbell centres 26.2 cm above the shoulder joints and 15.4 cm toward the head from them (over the upper chest / chin), 35.5 cm apart",
        "norm": "Dumbbells travel back toward the upper chest and chin, not the face (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up, 0.7 s at the top",
        "norm": "Controlled, about 2 s down and 1 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #1121312, Dumbbell JM Bench Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/24318-dumbbell-jm-bench-press.html"
      },
      {
        "id": "puluka",
        "title": "Puluka, JM press vs skull crusher movement analysis (student biomechanics poster, Monmouth University; one male participant, surface EMG normalised to MVIC)",
        "url": "https://www.monmouth.edu/provost/wp-content/uploads/sites/108/2026/04/Julia-Puluka-PosterPresentation.pdf"
      },
      {
        "id": "saeterbakken2021",
        "title": "Saeterbakken, Stien, Pedersen, Solstad, Cumming and Andersen 2021, the effect of grip width on muscle strength and electromyographic activity in bench press among novice- and resistance-trained men (Int J Environ Res Public Health 18(12):6444; PMC8296276)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8296276/"
      },
      {
        "id": "boehler2011",
        "title": "Boehler 2011, electromyographic analysis of the triceps brachii muscle during a variety of triceps exercises (MS thesis, University of Wisconsin-La Crosse)",
        "url": "https://minds.wisc.edu/items/4876923b-3a14-47c3-9a69-decf731bd027"
      }
    ],
    "safety": {
      "cautions": [
        "Get into position safely: sit on the end of the bench with the dumbbells on the thighs, then lie back and kick them up one knee at a time; at the end of the set bring them back to the thighs or lower them to the floor beside the bench rather than dropping them (clinical opinion).",
        "Elbow pain: the JM press loads the elbow heavily; reduce the depth or switch to a close-grip press (clinical opinion).",
        "Lower to the upper chest, never to the face; stop the set if control is lost.",
        "Keep the wrists straight over the forearms; bent-back wrists under a heavy dumbbell strain the wrist.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shorter range: stop when the dumbbells are a hand-width above the chest.",
        "Lighter dumbbells while learning the elbow path."
      ],
      "regressions": [
        "Close-grip dumbbell press.",
        "Dumbbell skull crusher with light dumbbells."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Pause 1 s at the bottom.",
        "Barbell JM press."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Main mover: a hybrid of a close-grip press and a lying extension, mostly elbow extension. In a one-person biomechanics poster the JM press gave higher triceps EMG than the skull crusher (0.65 vs 0.53 mV, Puluka); narrow-grip pressing also raises triceps activity (Saeterbakken 2021).",
      "triceps_l": "Main mover: a hybrid of a close-grip press and a lying extension, mostly elbow extension. In a one-person biomechanics poster the JM press gave higher triceps EMG than the skull crusher (0.65 vs 0.53 mV, Puluka); narrow-grip pressing also raises triceps activity (Saeterbakken 2021).",
      "pec_r": "Helps press the upper arms back up from the tucked position.",
      "pec_l": "Helps press the upper arms back up from the tucked position.",
      "ant_deltoid_r": "Flexes the shoulder as the elbows come forward and back.",
      "ant_deltoid_l": "Flexes the shoulder as the elbows come forward and back.",
      "forearm_flexors_r": "Grip the handles.",
      "forearm_flexors_l": "Grip the handles.",
      "core": "Bracing keeps the ribs down and the pelvis on the bench.",
      "rhomboids_midtrap_r": "Keep the shoulder blades set on the bench.",
      "rhomboids_midtrap_l": "Keep the shoulder blades set on the bench."
    }
