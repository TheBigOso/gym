      "url": "https://gymvisual.com/videos/5073-lever-seated-leg-curl.html",
      "listing": "Video (movement reference only; the page could not be fetched from the authoring environment (gymvisual.com refused the request), so the data sheet was not read and the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (hamstrings)",
    "secondaryBodyParts": [
      "Calves"
    ],
    "equipment": [
      "Seated leg curl machine (lever on the knee axis, heel roller, thigh hold-down pad)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (knee flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hamstrings_r",
        "hamstrings_l"
      ],
      "synergist": [
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you curl, breathe in as the legs straighten.",
      "cadence": "About 1.2 s down, short squeeze, about 2.3 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "tempo": "1.2-0.6-2.3-0.4 (lift-hold-lower-pause, seconds)",
      "load": "Stack load is user-chosen: curl fully without the hips sliding forward.",
      "progression": "Add reps, then load; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with the back on the pad, knees lined up with the lever axis, the roller behind the lower calves and the thigh pad snug above the knees; hold the side handles."
      },
      {
        "id": "c2",
        "phase": "work",
        "text": "Breathe out and curl the heels down and back under the seat."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the hamstrings with the knees well bent."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and let the legs straighten slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the knees nearly straight without letting the stack rest."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Knees not on the lever axis",
        "fix": "Line the knee joints up with the pivot."
      },
      {
        "id": "m2",
        "mistake": "Hips sliding forward",
        "fix": "Lock the thigh pad down and hold the handles."
      },
      {
        "id": "m3",
        "mistake": "Short range",
        "fix": "Curl until the knees are well bent."
      },
      {
        "id": "m4",
        "mistake": "Letting the stack slam",
        "fix": "Take about 2 s to straighten."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈12° with the legs extended",
        "peak": "≈95° at the bottom of the curl",
        "norm": "From nearly straight to well bent (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee axis",
        "setup": "Lever pivot on the knee joint (21.8, 57.5 cm)",
        "peak": "Roller within 0.06 cm of its arc",
        "norm": "Lever pivot on the knee joint so the roller does not slide on the calf (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Roller",
        "setup": "Behind the calves, 82% of the way from knee to ankle",
        "peak": "Lever 82.8° down",
        "norm": "Behind the lower calves above the heels (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip",
        "setup": "Seated, back on the 10° pad, hips ≈84°; thigh roller above the knees",
        "peak": "Unchanged",
        "norm": "Seated with the hips flexed, which keeps the hamstrings long (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hamstring EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Leg curls load the hamstrings well, especially the lateral and medial hamstrings in flexion (McAllister 2014)",
        "sources": [
          "mcallister2014"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.5 s with the legs extended",
        "peak": "1.2 s down, 0.6 s squeeze, 2.3 s up",
        "norm": "About 1.2 s down and 2.3 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
