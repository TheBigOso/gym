      ]
    },
    "breathing": {
      "pattern": "Inhale as the rope travels behind the head, exhale as you straighten the arms.",
      "cadence": "About 2.2 s down, 0.3 s pause, 1.4 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "tempo": "2-0-1-1",
      "frequency": "1-2 times a week",
      "load": "Cable stack load is user-chosen: pick a weight you can extend for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "More reps, then one plate on the stack."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the back pad to 30 degrees with its top end toward a low pulley; glutes in the crease, upper back and head on the pad, feet planted. Hold the rope ends palms facing each other, arms straight up and angled a little back toward the pulley."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Keep the upper arms still and breathe in as you bend the elbows, letting the rope ends travel back beside and behind the head."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Hands behind the head, elbows bent a little past 90 degrees, a stretch in the back of the arms."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbows, bringing the rope back up over the shoulders."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight, squeeze the triceps against the cable, then go again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arms swinging back and forth",
        "fix": "Keep the elbows pointing at the same spot; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows about shoulder-width apart."
      },
      {
        "id": "m3",
        "mistake": "Letting the cable pull the arms back over the head",
        "fix": "Keep the upper arms fixed; lighten the stack if they drift."
      },
      {
        "id": "m4",
        "mistake": "Locking out hard",
        "fix": "Straighten the elbows without snapping them."
      },
      {
        "id": "m5",
        "mistake": "Bench too steep",
        "fix": "Use about 30-45 degrees; steeper turns it into a seated overhead extension."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "30° back pad, flat seat",
        "peak": "Glutes in the crease and upper back on the pad (rig shapes), back of the head just off it with a neutral neck",
        "norm": "Back pad at 30 degrees (30-45 is common; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈8° (straight, not locked)",
        "peak": "≈100° at the bottom",
        "norm": "From straight to a little past 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm angle",
        "setup": "3° behind vertical: ≈115° of shoulder flexion relative to the trunk",
        "peak": "Unchanged: shoulder channels constant (max 1.2° drift)",
        "norm": "Upper arms angled a little back from vertical toward the pulley and still; on a 30-degree incline that is well over 120 degrees of shoulder flexion relative to the trunk (clinical opinion; long-length triceps training: Maeo and Kanehisa)",
        "sources": [
          "maeo_desc"
        ]
      },
      {
        "measure": "Rope and cable",
        "setup": "Low pulley 45 cm high, 60 cm behind the top of the pad; 35.5 cm between the hands",
        "peak": "Grip width unchanged (35.48-35.51 cm); hands 8.3 cm from the head and 3.9 cm above the pad at the closest",
        "norm": "Rope ends beside and behind the head, clear of the head and the pad; the cable runs from the low pulley behind the bench, past the top of the pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.2 s down, 0.3 s pause, 1.4 s up, 0.5 s at the top",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual, Cable Rope Incline Tricep Extension, animated GIF (movement reference)",
