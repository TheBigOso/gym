  "exercise": {
    "id": "reverse-hyper-on-flat-bench",
    "name": "Reverse Hyper on Flat Bench",
    "aliases": [
      "Bench reverse hyperextension",
      "Reverse hyperextension (flat bench)",
      "Prone bench leg raise",
      "Reverse hyper"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "2958",
      "title": "Reverse Hyper on Flat Bench",
      "url": "https://gymvisual.com/videos/2958-reverse-hyper-on-flat-bench.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Hamstrings",
      "Lower back"
    ],
    "equipment": [
      "Flat bench",
      "Body weight"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (hip extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ],
      "stabilizer": [
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l",
        "lats_r",
        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the legs rise; inhale as they lower.",
      "cadence": "About 4-5 s per rep"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "1.2 s up, 0.6 s squeeze, 1.6 s down",
      "frequency": "2-3 times a week",
      "progression": "Pause at the top, then ankle weights"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie face down on a flat bench with the hips at the end and the legs hanging toward the floor, toes resting on it. Hold the bench."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Squeeze the glutes and lift both legs, straightening them, until they are level with the body."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause with the legs level; do not crank the low back into an arch."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower with control back to the floor."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the legs up with momentum",
        "fix": "Lift and lower under control; pause at the top."
      },
      {
        "id": "m2",
        "mistake": "Over-arching the low back at the top",
        "fix": "Stop when the legs are level with the body."
      },
      {
        "id": "m3",
        "mistake": "Chest lifting off the bench",
        "fix": "Hold the bench and keep the trunk down."
      },
      {
        "id": "m4",
        "mistake": "Bent knees at the top",
        "fix": "Straighten the legs as they rise."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip extension",
        "setup": "Hip flexed ≈76° (legs hanging, toes on the floor)",
        "peak": "Hip ≈-7° (≈7° extension); legs ≈8° above level",
        "norm": "From flexed (legs hanging) to about level with the body or slightly past (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "Bent ≈75°",
        "peak": "Straight (≈2°)",
        "norm": "Bent with the toes on the floor at the bottom, straight at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Chest and belly on the pad, hands gripping the edges",
        "peak": "Unchanged (pelvis and mid-back move 0 cm)",
        "norm": "Still on the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Legs hanging 0.6 s",
        "peak": "1.2 s up, 0.6 s pause, 1.6 s down",
        "norm": "Controlled, with a pause at the top (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #2958, Reverse Hyper on Flat Bench, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/2958-reverse-hyper-on-flat-bench.html"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      },
      {
        "id": "callaghan1998",
        "title": "Callaghan, Gunning and McGill 1998, the relationship between lumbar spine load and muscle activity during extensor exercises (Phys Ther 78(1):8-18)",
        "url": "https://doi.org/10.1093/ptj/78.1.8"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Raise the legs only to level: arching past it loads the lumbar spine.",
        "Make sure the bench is stable and cannot tip."
      ],
      "modify": [
        "One leg at a time.",
        "Smaller range."
      ],
      "regressions": [
        "Single-leg version.",
        "Prone hip extension on the floor (one leg)."
      ],
      "progressions": [
        "Pause 2-3 s at the top.",
        "Ankle weights.",
        "Reverse hyper machine."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Gluteus maximus extends the hips to raise the legs from hanging to level; prone hip extension drills draw moderate to high gluteus maximus activity (Macadam and Feser 2019).",
      "glute_max_l": "Gluteus maximus extends the hips to raise the legs from hanging to level; prone hip extension drills draw moderate to high gluteus maximus activity (Macadam and Feser 2019).",
      "hamstrings_r": "Assist hip extension with the knees straight (clinical opinion).",
      "hamstrings_l": "Assist hip extension with the knees straight (clinical opinion).",
      "spinal_extensors_r": "The lumbar extensors work as the legs reach level and just above (Callaghan 1998 on prone leg-extension tasks).",
      "spinal_extensors_l": "The lumbar extensors work as the legs reach level and just above (Callaghan 1998 on prone leg-extension tasks).",
      "core": "Keep the trunk still on the bench and stop the low back over-arching at the top (clinical opinion).",
      "forearm_flexors_r": "Grip the bench (clinical opinion).",
      "forearm_flexors_l": "Grip the bench (clinical opinion).",
      "lats_r": "Pull the chest onto the bench so the trunk stays put (clinical opinion).",
      "lats_l": "Pull the chest onto the bench so the trunk stays put (clinical opinion)."
    }
