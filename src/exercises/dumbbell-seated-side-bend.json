    "id": "dumbbell-seated-side-bend",
    "name": "Dumbbell Seated Side Bend",
    "aliases": [
      "Seated dumbbell side bend",
      "Seated dumbbell lateral flexion",
      "Bench side bend"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "17152",
      "title": "Dumbbell Seated Side Bend (male)",
      "url": "https://gymvisual.com/videos/17152-dumbbell-seated-side-bend-male.html",
      "listing": "Page not read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (obliques)",
    "secondaryBodyParts": [
      "Core",
      "Lower back"
    ],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (lateral flexion of the trunk)",
    "plane": "Frontal",
    "laterality": "Unilateral load (one side at a time)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_l",
        "spinal_extensors_l"
      ],
      "synergist": [
        "obliques_r"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "upper_traps_r",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you bend toward the dumbbell, exhale as you pull back up.",
      "cadence": "About 1.5 s down, short pause, about 1.5 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 per side",
      "tempo": "About 1.5 s down, brief pause, 1.5 s up",
      "frequency": "1-3 times a week",
      "progression": "Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set. Many coaches prefer suitcase carries for the same muscles with less spine bending."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall on the end of a flat bench, feet flat a little wider than the hips, dumbbell in the right hand hanging beside the bench (palm in), left fingertips lightly behind the head."
      },
      {
        "id": "c2",
        "phase": "down",
        "text": "Breathe in and bend straight sideways toward the dumbbell; let it sink straight down beside the bench."
      },
      {
        "id": "c3",
        "phase": "pause",
        "text": "Short pause at a comfortable stretch; both sit bones stay on the bench, no leaning forward or twisting."
      },
      {
        "id": "c4",
        "phase": "up",
        "text": "Breathe out and pull the trunk back up with the opposite side of the waist, just past upright."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Sit tall; finish the set, then switch hands."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the opposite hip off the bench",
        "fix": "Keep both sit bones down; the waist bends, the pelvis stays put."
      },
      {
        "id": "m2",
        "mistake": "Leaning forward or twisting as you bend",
        "fix": "Move in a flat side plane, chest facing forward."
      },
      {
        "id": "m3",
        "mistake": "Holding a dumbbell in each hand",
        "fix": "One dumbbell only; two cancel each other out."
      },
      {
        "id": "m4",
        "mistake": "Bouncing out of the bottom or letting the dumbbell hit the bench",
        "fix": "Use a load you can lower in 1.5 s and hold it beside, not over, the bench."
      }
    ],
    "kinematics": [
      {
        "measure": "Lateral flexion (pelvis to C7)",
        "setup": "Upright (≈0°)",
        "peak": "≈25° toward the dumbbell (pelvis to C7); spine segments ≈39° (lumbar ≈16°, thoracic ≈24°); back up to ≈4° past upright",
        "norm": "A comfortable side bend toward the weight and back to just past upright; seated, the range is a little smaller than standing because the pelvis cannot shift; no study fixes the range (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell path",
        "setup": "Hanging beside the bench, wrist 47 cm above the floor",
        "peak": "Drops 17 cm straight down beside the bench (arm ≈12° max off vertical; 16.91 cm above the floor, 4.93 cm from the bench at the closest)",
        "norm": "Straight down beside the bench, arm vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "Square on the bench end, seat 45 cm, knees ≈92°",
        "peak": "Unchanged (pelvis moves 0 cm); no twisting or forward lean",
        "norm": "Square and still on the bench (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Sit 0.7 s",
        "peak": "1.6 s down, 0.5 s pause, 1.5 s up, 0.5 s past upright, 1.1 s reset",
        "norm": "About 1.5 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #17152, Dumbbell Seated Side Bend (male), video (movement reference)",
