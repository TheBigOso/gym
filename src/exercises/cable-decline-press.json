  "exercise": {
    "id": "cable-decline-press",
    "name": "Cable Decline Press",
    "aliases": [
      "Decline cable chest press",
      "Cable decline bench press"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "016298",
      "title": "Cable Decline Press",
      "url": "https://gymvisual.com/videos/16298-cable-decline-press.html",
      "listing": "Video (title and number from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Chest",
    "secondaryBodyParts": [
      "Triceps",
      "Front shoulders"
    ],
    "equipment": [
      "Decline bench",
      "Cable machine (two low pulleys)",
      "D-handles"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (shoulder horizontal adduction, elbow extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "pec_r",
        "pec_l"
      ],
      "synergist": [
        "triceps_r",
        "triceps_l",
        "ant_deltoid_r",
        "ant_deltoid_l"
      ],
      "stabilizer": [
        "serratus_r",
        "serratus_l",
        "core",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "pec_r",
        "pec_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you press or lift.",
      "cadence": "About 2 s down, a short pause, about 1.3 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2 s down, brief pause, 1-1.5 s up",
      "frequency": "2 times a week",
      "progression": "Add load in small steps; slower lowering"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a decline bench between two low pulleys, feet hooked under the roller, a handle in each hand beside the lower chest."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the handles to the sides of the lower chest, elbows about 45 degrees from the body."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with the hands level with the chest."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press up and in until the hands nearly meet over the lower chest."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight, not locked; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows flared straight out",
        "fix": "Keep them about 45 degrees from the trunk."
      },
      {
        "id": "m2",
        "mistake": "Letting the cables pull the arms too low",
        "fix": "Stop with the hands level with the chest."
      },
      {
        "id": "m3",
        "mistake": "Bouncing at the bottom",
        "fix": "Pause, then press."
      },
      {
        "id": "m4",
        "mistake": "Feet slipping out of the roller",
        "fix": "Hook the feet before taking the handles."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈14° at the top",
        "peak": "≈124° at the bottom",
        "norm": "From about 90 degrees at the bottom to nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hand path",
        "setup": "Hands nearly meet over the lower chest",
        "peak": "Hands beside the lower chest, about 48 cm apart",
        "norm": "Up and in toward the midline (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Decline",
        "setup": "25° decline, head low, feet hooked",
        "peak": "Body still on the board",
        "norm": "Lower-chest bias (Rodriguez-Ridao 2020)",
        "sources": [
          "rodriguez2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #016298, Cable Decline Press, video (movement reference)",
        "url": "https://gymvisual.com/videos/16298-cable-decline-press.html"
      },
      {
        "id": "rodriguez2020",
        "title": "Rodríguez-Ridao, Antequera-Vique, Martín-Fuentes and Muyor 2020, effect of five bench inclinations on the electromyographic activity of the pectoralis major, anterior deltoid and triceps brachii during the bench press exercise (Int J Environ Res Public Health 17(19):7339; PMC7579505)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7579505/"
      },
      {
        "id": "saeterbakken2011",
        "title": "Saeterbakken, van den Tillaar and Fimland 2011, a comparison of muscle activity and 1-RM strength of three chest-press exercises with different stability requirements (J Sports Sci 29(5):533-538; PubMed 21225489)",
        "url": "https://read.qxmd.com/read/21225489/a-comparison-of-muscle-activity-and-1-rm-strength-of-three-chest-press-exercises-with-different-stability-requirements"
      }
    ],
    "safety": {
      "cautions": [
        "Lying head-down raises pressure in the head; skip the decline with uncontrolled high blood pressure, glaucoma or a recent eye or head problem (clinical opinion), and sit up slowly after the set.",
        "Hook the feet under the roller before taking the weights; hand the weights down or lower them to the floor beside the bench at the end.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [],
      "regressions": [
        "Flat cable press."
      ],
      "progressions": [
        "Slower lowering."
      ]
    },
    "muscleNotes": {
      "pec": "A decline press biases the lower chest (Rodriguez-Ridao 2020); the cables pull out to the sides, so the hands come together at the top."
    }
  },
