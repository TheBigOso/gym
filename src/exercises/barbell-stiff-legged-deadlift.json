    "breathing": {
      "pattern": "Breathe in and brace at the top, hold it while hinging down and back up, breathe out at the top.",
      "cadence": "About 2 s down, a short pause, about 1.4 s up"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "2-3 minutes between sets",
      "sets": "3-4",
      "reps": "6-10",
      "tempo": "2 s down, short pause, 1-1.5 s up",
      "load": "Barbell load is user-chosen: light enough to keep the back flat at the bottom, about 2-3 reps in reserve (RPE 7-8).",
      "progression": "Add 2.5 kg once every rep reaches the same depth with a flat back."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, bar in front of the thighs, overhand grip just outside the legs, arms straight. Knees just unlocked and kept that way."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Push the hips straight back and lower the bar down the front of the legs with a flat back; the knees stay nearly straight."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop when the hamstrings are fully stretched, about mid-shin, before the back starts to round."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the hips forward and stand up tall, the bar brushing the legs."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the glutes at the top without leaning back; re-brace for the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back to reach lower",
        "fix": "Only go as low as the hamstrings allow with a flat back; mid-shin is plenty."
      },
      {
        "id": "m2",
        "mistake": "Bending the knees into a squat",
        "fix": "Keep the soft knee angle fixed; the hips move back, not down."
      },
      {
        "id": "m3",
        "mistake": "Bar drifting away from the legs",
        "fix": "Keep the bar close, lats tight, so it travels down the thighs and shins."
      },
      {
        "id": "m4",
        "mistake": "Leaning back at the top",
        "fix": "Finish with the hips under the shoulders and the glutes squeezed."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈4° standing",
        "peak": "≈114° (joint channel) at the bottom",
        "norm": "Deep hip hinge with a flat back; the knees stay almost straight so the hamstrings take more of the work than in a conventional deadlift (Lee 2018 for the straight-knee Romanian style)",
        "sources": [
          "lee2018"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈4°",
        "peak": "≈9°, held nearly straight",
        "norm": "Knees nearly straight, about 5-15 degrees, held through the rep (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5° from vertical",
        "peak": "≈91° from vertical (≈-1° from level), back flat",
        "norm": "Trunk near or a little below horizontal at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar path",
        "setup": "Bar against the thighs, grip 50 cm (handle centres)",
        "peak": "Bar 29.8 cm up at the bottom (shin top 49.3 cm), plates 7.3 cm off the floor, -1.6 cm from mid-foot",
        "norm": "Bar close to the legs, over mid-foot (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.2 s down, 0.3 s pause, 1.4 s up, 1.3 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Learn the hip hinge with a light bar first; the back stays flat at every depth.",
        "Low-back pain: shorten the range or choose the Romanian deadlift with softer knees.",
        "Lower under control; don't bounce at the bottom.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Tight hamstrings: stop at the knees or just below.",
        "Grip failing first: use straps for the top sets."
      ],
      "regressions": [
        "Dumbbell stiff-leg deadlift.",
        "Romanian deadlift with softer knees.",
        "Hip hinge with a dowel along the back."
      ],
      "progressions": [
        "Slower 3-4 s lowering.",
        "Pause at the bottom.",
        "Heavier bar in small steps."
      ]
    },
    "muscleNotes": {
      "hamstrings_r": "Lengthened under load as the hips hinge with straight knees; they extend the hip on the way up (Lee 2018).",
      "hamstrings_l": "Lengthened under load as the hips hinge with straight knees; they extend the hip on the way up (Lee 2018).",
      "glute_max_r": "Drives the hips forward to stand tall.",
      "glute_max_l": "Drives the hips forward to stand tall.",
      "spinal_extensors_r": "Hold the back flat against the bar hanging in front (Escamilla 2002).",
      "spinal_extensors_l": "Hold the back flat against the bar hanging in front (Escamilla 2002).",
      "adductors_r": "Adductor magnus assists hip extension.",
      "adductors_l": "Adductor magnus assists hip extension.",
      "lats_r": "Keep the bar close to the legs.",
      "lats_l": "Keep the bar close to the legs.",
      "upper_traps_r": "Hold the shoulders against the pull of the bar.",
      "upper_traps_l": "Hold the shoulders against the pull of the bar.",
      "rhomboids_midtrap_r": "Keep the upper back set.",
      "rhomboids_midtrap_l": "Keep the upper back set.",
      "forearm_flexors_r": "Hold the bar.",
      "forearm_flexors_l": "Hold the bar.",
      "obliques_r": "Part of the trunk brace.",
      "obliques_l": "Part of the trunk brace.",
      "core": "Bracing keeps the spine still while the hips move.",
      "calves_r": "Keep the feet pressed flat.",
      "calves_l": "Keep the feet pressed flat."
    },
