{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "air-twisting-crunch",
    "name": "Air Twisting Crunch",
    "aliases": [
      "Tabletop twisting crunch",
      "Legs-up cross crunch",
      "Air cross crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11425",
      "title": "Air Twisting Crunch (male)",
      "url": "https://gymvisual.com/videos/11425-air-twisting-crunch-male.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the network proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, obliques)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk flexion with rotation, alternating hip and knee flexion)",
    "plane": "Multiplanar",
    "laterality": "Bilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "obliques_r",
        "obliques_l"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale on each twist up, inhale as you lower.",
      "cadence": "About 1.2 s up and turn, short squeeze, 1.2 s down per side"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per side",
      "tempo": "About 1 s up and turn, brief squeeze, 1-1.5 s down",
      "frequency": "2-3 times a week",
      "progression": "Longer squeeze, then straighten the legs a little (longer lever), then the air bike"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, legs up in a tabletop: hips and knees at 90 degrees, shins level. Fingertips behind the head, elbows wide."
      },
      {
        "id": "c2",
        "phase": "twistA",
        "text": "Breathe out, curl up and turn so the right elbow travels toward the left knee."
      },
      {
        "id": "c3",
        "phase": "lowerA",
        "text": "Lower the shoulders under control; the legs stay still."
      },
      {
        "id": "c4",
        "phase": "twistB",
        "text": "Breathe out, curl up and turn the left elbow toward the right knee."
      },
      {
        "id": "c5",
        "phase": "lowerB",
        "text": "Lower and keep alternating. Low back stays on the mat throughout."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling the head with the hands",
        "fix": "Fingertips only; turn from the ribs, not the neck."
      },
      {
        "id": "m2",
        "mistake": "Only the elbow moves (flapping the arm)",
        "fix": "Keep the elbows wide and turn the shoulder toward the knee."
      },
      {
        "id": "m3",
        "mistake": "Legs drifting or rocking with each twist",
        "fix": "Hold the tabletop still; brace the low back into the mat."
      },
      {
        "id": "m4",
        "mistake": "Rushing the reps",
        "fix": "Pause briefly at each twist."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk curl",
        "setup": "Shoulders on the mat between reps (upper back 1.1 cm)",
        "peak": "Shoulder blades off the mat, thoracic ≈47° flexion",
        "norm": "Head and shoulder blades come off the mat; low back stays down (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk rotation",
        "setup": "Square to the ceiling",
        "peak": "≈38° toward the opposite knee (mostly thoracic), elbow 45 cm from the knee",
        "norm": "Shoulder turns toward the opposite knee; the turn is mostly thoracic (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Legs",
        "setup": "Hips ≈90°, knees ≈90° (tabletop), feet 42 cm off the mat",
        "peak": "Unchanged (the legs hold still)",
        "norm": "Tabletop: hips and knees about 90 degrees, held still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Set 0.6 s",
        "peak": "About 1.2 s up and turn, 0.4 s squeeze, 1.2 s down per side; 6 s loop",
        "norm": "Controlled, a short pause each side (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11425, Air Twisting Crunch (male), video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/11425-air-twisting-crunch-male.html"
      },
      {
        "id": "ace2001",
        "title": "ACE-sponsored study, Francis and Davis (San Diego State University Biomechanics Lab) 2001, best and worst abdominal exercises, 30 adults, EMG relative to a crunch (ACE FitnessMatters, May/June 2001)",
        "url": "https://www.acefitness.org/getfit/studies/BestWorstAbExercises.pdf"
      },
      {
        "id": "oliva2020",
        "title": "Oliva-Lozano and Muyor 2020, core muscle activity during physical fitness exercises: a systematic review (Int J Environ Res Public Health 17(12):4306)",
        "url": "https://www.mdpi.com/1660-4601/17/12/4306"
      },
      {
        "id": "marshall2010",
        "title": "Marshall and McGill 2010, the role of axial torque in disc herniation (Clin Biomech 25:6-9), porcine model",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19815318/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "The ACE result is from a magazine-published lab study (EMG relative to a crunch), not a peer-reviewed paper; treat the ranking as indicative.",
        "Repeated loaded flexion combined with twisting promoted disc delamination in a porcine model (Marshall and McGill 2010); people with disc problems or flexion intolerance should pick a dead bug or side plank instead."
      ],
      "modify": [
        "Neck strain: rest the head in the hands without pulling, or cross the arms on the chest.",
        "Low back arches: keep the straight leg higher.",
        "Pregnancy or diastasis recti: avoid curl-up twists."
      ],
      "regressions": [
        "Feet on the floor, alternate elbow to opposite knee one side at a time.",
        "Legs only (no curl).",
        "Dead bug."
      ],
      "progressions": [
        "Slower pedalling with a 2 s pause at each twist.",
        "Straight leg lower toward the floor."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the shoulders off the mat each rep and braces the pelvis against the weight of the raised legs. ACE 2001 measured the related pedalling bicycle maneuver at about 2.5 times a crunch; this version without pedalling has not been measured (clinical opinion).",
      "obliques_r": "Turn the trunk so the elbow travels toward the opposite knee: the external oblique on the side of the moving elbow and the internal oblique on the knee side (clinical opinion; the pedalling version gave about 2.9 times crunch oblique activity in ACE 2001).",
      "obliques_l": "Turn the trunk so the elbow travels toward the opposite knee: the external oblique on the side of the moving elbow and the internal oblique on the knee side (clinical opinion; the pedalling version gave about 2.9 times crunch oblique activity in ACE 2001).",
      "hip_flexors_r": "Hold the thigh up in the tabletop isometrically (clinical opinion).",
      "hip_flexors_l": "Hold the thigh up in the tabletop isometrically (clinical opinion).",
      "quads_r": "Light work to hold the shin level (clinical opinion).",
      "quads_l": "Light work to hold the shin level (clinical opinion)."
    }
  },
