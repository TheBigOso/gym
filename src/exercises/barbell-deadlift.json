    "breathing": {
      "pattern": "Breathe in and brace before the bar leaves the floor, hold the brace through the pull, breathe out at the top or once the plates are back on the floor.",
      "cadence": "About 1.8 s up, a short lockout, about 2 s down, reset on the floor"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "3-6",
      "tempo": "Controlled pull, short lockout, controlled lowering; reset each rep on the floor",
      "frequency": "1-2 times a week",
      "load": "Barbell load is user-chosen: pick a weight you can pull with a flat back for every rep, leaving about 2-3 reps in reserve (RPE 7-8).",
      "rest": "2-4 minutes between sets",
      "progression": "Add 2.5-5 kg when every rep of every set stays flat-backed and smooth off the floor."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar over the middle of the foot, feet about hip width. Hinge down and grip the bar just outside the knees, overhand, arms straight. Shins to the bar, hips above the knees, shoulders just in front of the bar, back flat. Big breath and brace."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Push the floor away: the bar slides up the shins, hips and shoulders rising together; once it passes the knees drive the hips forward."
      },
      {
        "id": "c3",
        "phase": "lockout",
        "text": "Stand tall with the hips and knees straight, shoulders over the bar; don't lean back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Push the hips back first with the bar close to the thighs, then bend the knees once it passes them."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Set the plates down softly on the floor, keep the brace or take a new breath, then pull again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back off the floor",
        "fix": "Brace before the pull and take the slack out of the bar (pull it against the plates) before it leaves the floor; lower the load if the back still rounds."
      },
      {
        "id": "m2",
        "mistake": "Bar drifting away from the legs",
        "fix": "Keep the bar touching or brushing the shins and thighs; pull it toward you with straight arms."
      },
      {
        "id": "m3",
        "mistake": "Hips shooting up first",
        "fix": "Push with the legs so the hips and shoulders rise at the same rate until the bar passes the knees."
      },
      {
        "id": "m4",
        "mistake": "Leaning back hard at the top",
        "fix": "Finish by squeezing the glutes and standing tall; the shoulders stack over the hips."
      },
      {
        "id": "m5",
        "mistake": "Bending the arms to pull",
        "fix": "Arms stay straight like ropes; the legs and hips do the lifting."
      }
    ],
    "kinematics": [
      {
        "measure": "Knee flexion",
        "setup": "≈80° with the plates on the floor",
        "peak": "≈4° at lockout",
        "norm": "Less knee bend than a hex-bar or dumbbell deadlift because the bar is in front of the shins (Swinton 2011)",
        "sources": [
          "swinton2011"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈137° (joint channel); hips 63.8 cm high, knees 48.8 cm, shoulders 75.9 cm",
        "peak": "≈5° at lockout",
        "norm": "Hips above the knees and below the shoulders at the start (clinical opinion); the conventional style starts with the hips higher and the trunk more inclined than the sumo style (Escamilla 2002)",
        "sources": [
          "escamilla2002"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈62° from vertical, back flat",
        "peak": "≈5° at lockout",
        "norm": "Trunk more inclined than in a hex-bar deadlift (Swinton 2011; Stewart 2008)",
        "sources": [
          "swinton2011",
          "stewart2008"
        ]
      },
      {
        "measure": "Bar path",
        "setup": "Bar 4.5 cm from mid-foot, shoulders 1.4 cm in front of the bar; grip 54 cm (handle centres)",
        "peak": "Bar stays within 3.5 cm fore-aft, at least 0.8 cm off the legs; lockout height 80.4 cm",
        "norm": "Bar starts over mid-foot and travels nearly straight up, close to the legs (common coaching)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Set up 0.8 s",
        "peak": "1.8 s up, 0.6 s lockout, 2 s down, 0.8 s reset on the floor",
        "norm": "Controlled lift and lowering; reset on the floor between reps (clinical opinion)",
        "sources": []
      }
    ],
