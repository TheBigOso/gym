    "safety": {
      "cautions": [
        "Learn the hip hinge with a light bar or a dowel before loading up; keep the back flat on every rep.",
        "Use plates of standard diameter (or blocks) so the bar starts at about mid-shin height.",
        "Lower the bar under control; don't drop it from lockout.",
        "Low-back pain: stop and get advice; pull from blocks to shorten the range until it settles.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Tight hamstrings or hips: pull from blocks or plates on risers.",
        "Grip failing before the legs: use chalk or straps for the top sets."
      ],
      "regressions": [
        "Dumbbell or kettlebell deadlift.",
        "Hex-bar (trap-bar) deadlift.",
        "Rack pull from just below the knees."
      ],
      "progressions": [
        "Heavier bar in small steps.",
        "Pause just off the floor or at the knees.",
        "Deficit deadlift from a low platform."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor, driving the hips through to lockout (Escamilla 2002).",
      "glute_max_l": "Main hip extensor, driving the hips through to lockout (Escamilla 2002).",
      "hamstrings_r": "Extend the hip from the hinged start; conventional and Romanian deadlifts both loaded them heavily (Lee 2018).",
      "hamstrings_l": "Extend the hip from the hinged start; conventional and Romanian deadlifts both loaded them heavily (Lee 2018).",
      "spinal_extensors_r": "Hold the back flat against the bar hanging in front; the conventional style relies on them more than the sumo style (Escamilla 2002).",
      "spinal_extensors_l": "Hold the back flat against the bar hanging in front; the conventional style relies on them more than the sumo style (Escamilla 2002).",
      "quads_r": "Straighten the knees to break the bar off the floor (Escamilla 2002).",
      "quads_l": "Straighten the knees to break the bar off the floor (Escamilla 2002).",
      "adductors_r": "Adductor magnus assists hip extension from the bottom.",
      "adductors_l": "Adductor magnus assists hip extension from the bottom.",
      "core": "Bracing stiffens the trunk so the hips and legs can move the bar.",
      "obliques_r": "Part of the brace around the trunk.",
      "obliques_l": "Part of the brace around the trunk.",
      "lats_r": "Keep the bar close to the legs and the shoulders set.",
      "lats_l": "Keep the bar close to the legs and the shoulders set.",
      "upper_traps_r": "Hold the shoulders against the pull of the bar on straight arms.",
      "upper_traps_l": "Hold the shoulders against the pull of the bar on straight arms.",
      "rhomboids_midtrap_r": "Keep the upper back tight and the shoulder blades from being pulled apart.",
      "rhomboids_midtrap_l": "Keep the upper back tight and the shoulder blades from being pulled apart.",
      "forearm_flexors_r": "Hold the bar; grip is often the first limit.",
      "forearm_flexors_l": "Hold the bar; grip is often the first limit.",
      "calves_r": "Keep the whole foot pressed into the floor.",
      "calves_l": "Keep the whole foot pressed into the floor."
    }
