  "exercise": {
    "id": "bodyweight-frog-pump",
    "name": "Bodyweight Frog Pump",
    "aliases": [
      "Frog pump",
      "Frog glute bridge",
      "Butterfly glute bridge (floor)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "7068",
      "title": "Bodyweight Frog Pump",
      "url": "https://gymvisual.com/animated-gifs/7068-bodyweight-frog-pump.html",
      "listing": "Video (movement reference; page could not be read at authoring time, movement taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (adductors)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip extension with the hips abducted and externally rotated)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "glute_med_r",
        "glute_med_l",
        "hamstrings_r",
        "hamstrings_l"
      ],
      "stabilizer": [
        "adductors_r",
        "adductors_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the hips drive up, inhale as they lower.",
      "cadence": "About 0.8 s up, 0.6 s squeeze, 1.2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "20-30",
      "tempo": "1-1-1-0",
      "frequency": "2-4 times a week",
      "progression": "Pause at the top, then high-rep sets, then a frog hip thrust on a bench"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, soles of the feet together close to the hips, knees wide, arms on the mat."
      },
      {
        "id": "c2",
        "phase": "up",
        "text": "Breathe out and drive the hips up by pressing the outer edges of the feet down."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the glutes hard at the top; ribs down, no low back arch."
      },
      {
        "id": "c4",
        "phase": "down",
        "text": "Lower the hips to just touch the mat and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back at the top",
        "fix": "Tuck the pelvis and keep the ribs down; stop when the hips are level with the knees."
      },
      {
        "id": "m2",
        "mistake": "Knees drifting together",
        "fix": "Let the knees fall wide and keep the soles touching."
      },
      {
        "id": "m3",
        "mistake": "Pushing through the toes",
        "fix": "Press through the outer edges and heels of the feet."
      },
      {
        "id": "m4",
        "mistake": "Bouncing off the floor",
        "fix": "Touch down lightly and drive up again."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈46° (lying)",
        "peak": "≈0° at the top (shoulder-to-hip line 16° from the floor)",
        "norm": "From flexed on the mat to about neutral at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip abduction and external rotation",
        "setup": "Thighs ≈43° out (abd 42.8°, rot -33.8°)",
        "peak": "≈39° out (abd 38.8°, rot -36.3°); soles together, feet on their outer edges",
        "norm": "Knees wide, soles together (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈125°",
        "peak": "≈117°",
        "norm": "Deeply bent with the feet close to the hips (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip height",
        "setup": "Hip joint 8.6 cm above the floor",
        "peak": "23.6 cm (+15 cm)",
        "norm": "Hips rise until roughly in line with the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Lying 0.8 s",
        "peak": "0.8 s up, 0.6 s squeeze, 1.2 s down, 2 s reset",
        "norm": "Fast up, squeeze, controlled down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #7068, Bodyweight Frog Pump, video (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/7068-bodyweight-frog-pump.html"
      },
      {
        "id": "contreras2015",
        "title": "Contreras, Vigotsky, Schoenfeld, Beardsley & Cronin 2015, a comparison of gluteus maximus, biceps femoris and vastus lateralis EMG in the back squat and barbell hip thrust (J Appl Biomech 31(6):452-458)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26214739/"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      },
      {
        "id": "lehecka2017",
        "title": "Lehecka et al. 2017, building a better gluteal bridge: EMG of hip muscles during modified single-leg bridges (Int J Sports Phys Ther 12(4):543-549; PMC5534144)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5534144/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Hip or groin discomfort in the wide-knee position: bring the feet a little farther from the hips or narrow the knees.",
        "Low-back pain at the top: shorten the range and tuck the pelvis."
      ],
      "modify": [
        "Feet farther from the hips.",
        "Smaller range."
      ],
      "regressions": [
        "Glute bridge.",
        "Pelvic tilts."
      ],
      "progressions": [
        "Pause at the top.",
        "Frog hip thrust on a bench."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Extends the hip from the turned-out position; hip-extension exercises in the bridge family load the gluteus maximus strongly at the top (Contreras 2015; Macadam 2019).",
      "glute_max_l": "Same on the left.",
      "glute_med_r": "Holds the thigh turned out and the knee wide.",
      "glute_med_l": "Same on the left.",
      "hamstrings_r": "Assist hip extension; the deep knee bend keeps them short (Lehecka 2017).",
      "hamstrings_l": "Same on the left.",
      "adductors_r": "Keep the soles pressed together.",
      "adductors_l": "Keep the soles pressed together.",
      "core": "Keeps the ribs down and the low back neutral."
    }
  },
