    "safety": {
      "cautions": [
        "Squat inside a rack with the safety arms set just below your bottom position, or with a spotter; the rack drawn here shows only the J-hooks.",
        "The low bar position needs good shoulder mobility; do not force the hands in if the elbows or shoulders hurt.",
        "Keep the back flat: the forward lean puts more load on the lower back.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder or elbow discomfort: widen the grip or use the high-bar position.",
        "Limited hip mobility: squat to a box at parallel."
      ],
      "regressions": [
        "Box squat to a parallel box.",
        "High-bar back squat.",
        "Goblet squat."
      ],
      "progressions": [
        "Heavier bar in small steps.",
        "Pause squat at parallel."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "The forward lean and hips-back position give the hip extensors a larger share than in a high-bar squat (Swinton 2012).",
      "glute_max_l": "The forward lean and hips-back position give the hip extensors a larger share than in a high-bar squat (Swinton 2012).",
      "quads_r": "Still extend the knees from parallel, with somewhat less knee demand than a high-bar squat (Swinton 2012; Larsen 2021).",
      "quads_l": "Still extend the knees from parallel, with somewhat less knee demand than a high-bar squat (Swinton 2012; Larsen 2021).",
      "adductors_r": "Adductor magnus extends the hip from flexion; the shoulder-width stance keeps it busy.",
      "adductors_l": "Adductor magnus extends the hip from flexion; the shoulder-width stance keeps it busy.",
      "hamstrings_r": "Assist hip extension against the forward lean.",
      "hamstrings_l": "Assist hip extension against the forward lean.",
      "spinal_extensors_r": "Work hard to hold the back flat under the forward-leaning trunk.",
      "spinal_extensors_l": "Work hard to hold the back flat under the forward-leaning trunk.",
      "calves_r": "Steady the lower legs over the planted feet.",
      "calves_l": "Steady the lower legs over the planted feet.",
      "core": "Bracing stiffens the trunk.",
      "obliques_r": "Part of the brace.",
      "obliques_l": "Part of the brace.",
      "glute_med_r": "Keeps the knees tracking out over the toes.",
      "glute_med_l": "Keeps the knees tracking out over the toes.",
      "post_deltoid_r": "The rear delts form the shelf the low bar sits on.",
      "post_deltoid_l": "The rear delts form the shelf the low bar sits on.",
      "upper_traps_r": "Help hold the shoulder blades back under the bar.",
      "upper_traps_l": "Help hold the shoulder blades back under the bar.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together so the upper back forms a tight shelf.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together so the upper back forms a tight shelf.",
      "lats_r": "Pull the bar down into the back and keep the upper back tight.",
      "lats_l": "Pull the bar down into the back and keep the upper back tight.",
      "forearm_flexors_r": "Grip the bar to hold it in place on the back.",
      "forearm_flexors_l": "Grip the bar to hold it in place on the back."
    }
