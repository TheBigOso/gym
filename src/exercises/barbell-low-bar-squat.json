    "breathing": {
      "pattern": "Big breath in and brace at the top, hold it on the way down and through the bottom, breathe out as you pass the hardest part of the rise or at the top.",
      "cadence": "About 2 s down, a short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "3-8",
      "tempo": "2-0-1-0",
      "frequency": "1-3 times a week",
      "load": "User-chosen; leave about 2 reps in reserve.",
      "rest": "2-4 minutes",
      "progression": "Add 2.5-5 kg when every rep reaches parallel with good form."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Bar low on the back, across the rear shoulders just below the bony ridge of the shoulder blades; hands close enough to pin it there, elbows lifted back, wrists straight over the bar. Feet about shoulder width, toes turned out."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Big breath, brace, then send the hips back and down as the chest tips forward over the bar; knees push out over the toes, bar stays over mid-foot."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Hips at or just below knee level, back flat, heels down; no bounce."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Drive the hips up and back into the bar while the chest rises with them; knees keep pushing out. Breathe out past the hardest part."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Lock out the hips and knees, take a new breath and brace."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bar sliding down the back",
        "fix": "Set it just below the ridge of the shoulder blades, squeeze the upper back and grip narrow enough to trap it."
      },
      {
        "id": "m2",
        "mistake": "Hips rising faster than the chest (the squat turns into a good morning)",
        "fix": "Drive the upper back into the bar so hips and shoulders rise together."
      },
      {
        "id": "m3",
        "mistake": "Wrists bent back carrying the bar",
        "fix": "Keep the wrists straight and the bar on the back, not in the hands; widen the grip a little if needed."
      },
      {
        "id": "m4",
        "mistake": "Knees caving in",
        "fix": "Push the knees out over the toes."
      },
      {
        "id": "m5",
        "mistake": "Rounding the lower back at the bottom",
        "fix": "Brace harder and stop just above the depth where the pelvis tucks under."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "44 cm between the ankle centres (≈1.1x the rig's 40 cm shoulder width), toes out 25°",
        "peak": "Unchanged (feet planted)",
        "norm": "About shoulder width with the toes out (Lorenzetti 2018; Sinclair 2022)",
        "sources": [
          "lorenzetti2018",
          "sinclair2022sports"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈2°",
        "peak": "≈112°; hip joints 0.3 cm below the knee joints, knees 2.6 cm from the toe tips (+ = past them)",
        "norm": "To about thighs parallel (hip crease at the top of the knee), typical of powerlifting depth (Swinton 2012)",
        "sources": [
          "swinton2012"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈-7°",
        "peak": "≈135° (joint channel)",
        "norm": "More hip flexion and hip extensor demand than a high-bar squat (Swinton 2012; Larsen 2021)",
        "sources": [
          "swinton2012",
          "larsen2021"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈47° forward of vertical",
        "norm": "Leans further forward than a high-bar squat, as the low bar must stay over mid-foot (Larsen 2021)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Bar position",
        "setup": "Low bar: across the rear delts on the spine of the shoulder blades, 9.4 cm below C7 (the high bar sits about 3.5 cm below it), 84 cm grip (handle centres)",
        "peak": "Bar -4.3 cm from mid-foot at the top, -0.5 cm at the bottom (bar + body centre of mass 1.3 → -2.6 cm)",
        "norm": "Low bar across the posterior deltoids, a few cm below the high-bar position (Larsen 2021)",
        "sources": [
          "larsen2021"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
