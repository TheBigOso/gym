{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "alternate-leg-raise",
    "name": "Alternate Leg Raise",
    "aliases": [
      "Alternating leg raise",
      "Single-leg raise with hover",
      "Scissor leg raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11008",
      "title": "Alternate Leg Raise",
      "url": "https://gymvisual.com/videos/11008-alternate-leg-raise-male.html",
      "listing": "Video (movement reference; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (hip flexors) and waist",
    "secondaryBodyParts": [
      "Thighs (quadriceps)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (alternating hip flexion with both legs off the floor, trunk held)",
    "plane": "Sagittal",
    "laterality": "Bilateral, alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core"
      ],
      "synergist": [
        "quads_r",
        "quads_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as each leg rises, in as it lowers; keep breathing in the hover.",
      "cadence": "About 1.1 s up, 1.1 s down per leg"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-10 per leg",
      "tempo": "About 1 s up, short pause, 1 s down",
      "load": "Body weight",
      "frequency": "2-3 times a week",
      "progression": "Lower hover, slower lowering, then head and shoulders up"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, arms by your sides palms down, legs straight."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Brace and lift both heels a few centimetres off the mat."
      },
      {
        "id": "c3",
        "phase": "raiseR",
        "text": "Raise the right leg to vertical, lower it back to the hover; the left leg holds just off the mat."
      },
      {
        "id": "c4",
        "phase": "raiseL",
        "text": "Now the left leg up and back down to the hover."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Bring the legs together and lower them to the mat."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Rest, then the next set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching off the mat",
        "fix": "Hover higher or put the hands under the hips."
      },
      {
        "id": "m2",
        "mistake": "Hover leg touching down",
        "fix": "Keep both heels just off the mat the whole time."
      },
      {
        "id": "m3",
        "mistake": "Bending the knees",
        "fix": "Keep both knees long."
      },
      {
        "id": "m4",
        "mistake": "Holding the breath",
        "fix": "Breathe out on every lift."
      }
    ],
    "kinematics": [
      {
        "measure": "Lifting leg from the floor",
        "setup": "Hover, ≈6°",
        "peak": "≈82° at the top",
        "norm": "Up to about vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hover leg",
        "setup": "Heels 6 cm off the mat",
        "peak": "Holds at 6 cm while the other leg lifts (never below 6.03 cm)",
        "norm": "Heel a few centimetres off the mat; the lower the hover, the harder the abdominal demand (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈9° in the hover",
        "peak": "≈88° on the lifting side",
        "norm": "Lifting side to about 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Pelvis stays on the mat; straight-leg raises load the low back (McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.5 s, lift 0.6 s",
        "peak": "Per leg: 1.1 s up, 0.3 s pause, 1.1 s down",
        "norm": "About 1 s up, 1 s down per leg (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 11008, Alternate Leg Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/11008-alternate-leg-raise-male.html"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises (Phys Ther 86(5):656-671)",
        "url": "https://scholars.csus.edu/esploro/outputs/journalArticle/Electromyographic-Analysis-of-Traditional-and-Nontraditional/99257847129401671"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Straight-leg raises load the low back: leg raises gave higher psoas activity and spine compression than sit-ups (McGill 1998). If the back arches, hover higher or bend the knees.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before straight-leg work."
      ],
      "modify": [
        "Hands under the hips.",
        "Higher hover."
      ],
      "regressions": [
        "Alternate lying floor leg raise (resting leg on the mat).",
        "Dead bug."
      ],
      "progressions": [
        "Alternate leg raise with head up.",
        "Lying leg raise.",
        "Ankle weights."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas and rectus femoris lift the right leg; leg raises gave high psoas activity in McGill's comparison (McGill 1998).",
      "hip_flexors_l": "Iliopsoas and rectus femoris lift the left leg in its turn.",
      "core": "Rectus abdominis and transversus hold the pelvis still while both legs are off the floor; bilateral leg lifts needed abdominal activation (Andersson 1997).",
      "quads_r": "Rectus femoris helps flex the hip and keeps the knee straight.",
      "quads_l": "Rectus femoris helps flex the hip and keeps the knee straight.",
      "adductors_r": "Help flex the hip near the floor and keep the leg in line.",
      "adductors_l": "Help flex the hip near the floor and keep the leg in line.",
      "obliques_r": "Resist the pelvis rotating toward the lifting leg.",
      "obliques_l": "Resist the pelvis rotating toward the lifting leg."
    }
  },
