    },
    "type": "Strength",
    "bodyPart": "Back",
    "secondaryBodyParts": [
      "Biceps",
      "Middle back",
      "Forearms"
    ],
    "equipment": [
      "Assisted pull-up machine (counterweighted knee pad, overhead handles)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (pull, vertical)",
    "plane": "Frontal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l"
      ],
      "synergist": [
        "biceps_r",
        "biceps_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "core"
      ],
      "lengthened": [
        "lats_r",
        "lats_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you pull up, breathe in as you lower.",
      "cadence": "About 1.3 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
      "rest": "60-90 s",
      "frequency": "1-2 times a week",
      "tempo": "1.3-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
      "load": "Assistance is user-chosen: more counterweight means a lighter pull; pick a setting that lets you reach chin over the handles.",
      "progression": "Add reps, then reduce the counterweight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hold the overhead handles with an overhand grip a little wider than the shoulders and kneel on the pad; hang with the arms nearly straight."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Set the shoulder blades down, breathe out and pull the chest up toward the handles, elbows driving down and back."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Pause with the chin over the handles and the shoulders down."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and lower under control; the knee pad rises and falls with you."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Reach a full hang with the arms nearly straight."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Kicking or swinging up",
        "fix": "Keep the knees on the pad and pull with the arms."
      },
      {
        "id": "m2",
        "mistake": "Half reps",
        "fix": "Lower to nearly straight arms each rep."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the bottom",
        "fix": "Set the shoulder blades down before each pull."
      },
      {
        "id": "m4",
        "mistake": "Craning the chin up",
        "fix": "Pull the chest toward the handles; keep the neck long."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈8° in the hang",
        "peak": "≈140° at the top",
        "norm": "From nearly straight at the bottom to well bent with the chin over the handles (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Overhand, grip points 52 cm apart",
        "peak": "Unchanged (hands planted on the bar)",
        "norm": "Pronated: overhand, a little wider than the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Body path",
        "setup": "Kneeling on the pad, knees ≈92°",
        "peak": "Body rises 50.3 cm; chin 2.1 cm above the bar",
        "norm": "The body rises nearly straight up; the knees ride the counterweighted pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Assistance",
        "setup": "Knee pad on a lever from a pivot 142.9 cm behind the knees",
        "peak": "Lever swings 20.6°; pad within 3.6 cm of the shins",
        "norm": "The counterweight under the knees takes part of body weight, so the pull is lighter than a free pull-up (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pull-up EMG",
        "setup": "–",
        "peak": "–",
        "norm": "Pull-up and chin-up variations load the latissimus heavily; the chin-up adds biceps (Youdas 2010)",
        "sources": [
          "youdas2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s",
        "peak": "1.3 s up, 0.4 s hold, 2 s down",
        "norm": "About 1.3 s up, short pause, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #4985, Assisted Pull-up, video (movement reference)",
        "url": "https://gymvisual.com/videos/4985-assisted-pull-up.html"
      },
      {
        "id": "youdas2010",
        "title": "Youdas et al. 2010, surface EMG activation patterns and elbow joint motion during a pull-up, chin-up, or perfect-pullup rotational exercise (J Strength Cond Res 24(12):3404-3414)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21068680/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or tingling occurs.",
        "Step onto the knee pad one knee at a time while holding the handles; step off the same way.",
        "More counterweight means more help: start with enough assistance to reach the top with control.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort at the bottom: stop just short of a full hang.",
        "Elbow discomfort: use the neutral handles if the machine has them."
      ],
      "regressions": [
        "More counterweight (more help).",
        "Lat pulldown."
      ],
      "progressions": [
        "Less counterweight.",
        "Negative pull-ups, then unassisted pull-ups."
      ]
    },
    "muscleNotes": {
      "lats_r": "Prime mover: pulls the body up to the handles (Youdas 2010 for pull-up and chin-up muscle activity).",
      "lats_l": "Prime mover: pulls the body up to the handles (Youdas 2010 for pull-up and chin-up muscle activity).",
      "biceps_r": "Bends the elbow.",
      "biceps_l": "Bends the elbow.",
      "rhomboids_midtrap_r": "Draws the shoulder blades down and together.",
      "rhomboids_midtrap_l": "Draws the shoulder blades down and together.",
      "post_deltoid_r": "Helps extend the shoulder.",
      "post_deltoid_l": "Helps extend the shoulder.",
      "forearm_flexors_r": "Grip the handles.",
      "forearm_flexors_l": "Grip the handles.",
      "core": "Keeps the body steady on the knee pad.",
      "infraspinatus_r": "Steadies the shoulder.",
      "infraspinatus_l": "Steadies the shoulder."
    }
