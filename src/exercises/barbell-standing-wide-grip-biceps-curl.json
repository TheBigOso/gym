    "breathing": {
      "pattern": "Breathe out as the bar comes up, in as it lowers.",
      "cadence": "About 1.2 s up, 0.3 s squeeze, 2.4 s down"
    },
    "prescription": {
      "frequency": "1-2 times a week",
      "rest": "60-90 seconds between sets",
      "sets": "3",
      "reps": "8-12",
      "tempo": "1 s up, short squeeze, 2-3 s down",
      "load": "Barbell load is user-chosen: a little lighter than a shoulder-width curl; no swing, about 2 reps in reserve.",
      "progression": "Add a rep per set, then 1-2.5 kg."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, underhand grip a few inches wider than the shoulders, bar resting on the thighs, elbows at the sides."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Curl the bar up in an arc, elbows pinned to the sides."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the biceps at the top without letting the elbows drift forward."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly to straight arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms long, stay tall, start the next rep without a swing."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the trunk",
        "fix": "Stay tall with the glutes squeezed; lighten the bar."
      },
      {
        "id": "m2",
        "mistake": "Elbows drifting forward or out",
        "fix": "Keep the elbows at the sides; the hands are wider than the elbows."
      },
      {
        "id": "m3",
        "mistake": "Cutting the bottom short",
        "fix": "Straighten the arms fully each rep."
      },
      {
        "id": "m4",
        "mistake": "Wrists bending back",
        "fix": "Keep the wrists straight; shorten the grip a little if they hurt."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈13° (arm straight)",
        "peak": "≈130° at the top (range ≈117°)",
        "norm": "Full range from a straight arm to about 130-145 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "24.5° (palm forward/up)",
        "peak": "-19.5° (palm forward/up)",
        "norm": "Palms up the whole rep with a straight bar (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-2°",
        "peak": "≈9° (elbow forward)",
        "norm": "Elbows at the sides; the hands sit wider than the elbows (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bar clearance",
        "setup": "Underhand, 60 cm between the handle points (elbows 44 cm apart); bar 0.9 cm or more off the body",
        "peak": "Grip width steady within 0.39 cm over the rep; nearest the bar comes: quad_l",
        "norm": "Bar close to the body but not dragging (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bar on the thighs 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "About 1 s up and 2-3 s down (clinical opinion)",
        "sources": []
      }
    ],
    "safety": {
      "cautions": [
        "Wide grips put more twist on the wrists and elbows; use a grip that feels comfortable.",
        "Elbow pain: narrow the grip or use an EZ bar or dumbbells.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrists or elbows: shoulder-width grip."
      ],
      "regressions": [
        "Dumbbell biceps curl.",
        "Band biceps curl."
      ],
      "progressions": [
        "Slower lowering (3-4 s).",
        "Pause halfway up.",
        "Heavier bar in small steps."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Bends the elbows against the bar; the wide grip turns the forearms out and is often felt more in the short (inner) head.",
      "biceps_l": "Bends the elbows against the bar; the wide grip turns the forearms out and is often felt more in the short (inner) head.",
      "forearm_flexors_r": "Hold the bar and help bend the elbows.",
      "forearm_flexors_l": "Hold the bar and help bend the elbows.",
      "ant_deltoid_r": "Holds the upper arms still at the sides; it works more if the elbows drift forward.",
      "ant_deltoid_l": "Holds the upper arms still at the sides; it works more if the elbows drift forward.",
      "core": "Keeps the trunk still, no swing.",
      "upper_traps_r": "Steady the shoulders; do not shrug.",
      "upper_traps_l": "Steady the shoulders; do not shrug.",
      "spinal_extensors_r": "Keep the trunk upright.",
      "spinal_extensors_l": "Keep the trunk upright."
