        "core",
        "obliques_r",
        "obliques_l",
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale on the way down, exhale on the way up.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "5-10",
      "tempo": "2-0-1-1",
      "frequency": "2-3 times a week",
      "progression": "Deeper range, then a pistol squat or hold a light weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Balance on the right foot, left foot just off the floor in front, arms forward."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, sit the hips back and down; knee over the 2nd-3rd toe."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Pause with the knee bent about 80 degrees, pelvis level, chest forward over the foot."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and push the floor away to stand tall."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, keep the left foot up, and repeat; switch legs after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Knee caving inward",
        "fix": "Push the knee out over the 2nd-3rd toe; reduce depth."
      },
      {
        "id": "m2",
        "mistake": "Pelvis dropping on the free-leg side",
        "fix": "Keep the hips level; squeeze the side of the stance hip."
      },
      {
        "id": "m3",
        "mistake": "Trunk leaning sideways",
        "fix": "Keep the chest square and over the foot."
      },
      {
        "id": "m4",
        "mistake": "Heel lifting",
        "fix": "Sit the hips back and keep the weight in the middle of the foot."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance knee flexion",
        "setup": "≈5°",
        "peak": "≈80°",
        "norm": "60-90 degrees for a controlled single-leg squat; 75 degrees was used in Muyor 2020, while Lewis 2015 had people squat as low as possible",
        "sources": [
          "muyor2020",
          "lewis2015"
        ]
      },
      {
        "measure": "Stance hip flexion",
        "setup": "≈8°",
        "peak": "≈97° (joint channel, as in the HUD)",
        "norm": "Hips sit back as the knee bends (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈1°",
        "peak": "≈29° forward",
        "norm": "Forward lean keeps the centre of mass over the foot; trunk flexion was smaller than in a 24 cm step-down (Lewis 2015)",
        "sources": [
          "lewis2015"
        ]
      },
      {
        "measure": "Free leg",
        "setup": "Foot 22 cm ahead of the stance ankle, knee ≈68°",
        "peak": "Foot 45.9 cm ahead, knee ≈43°, hip ≈115°",
        "norm": "Held off the floor in front of the body (Lewis 2015; Muyor 2020)",
        "sources": [
          "lewis2015",
          "muyor2020"
        ]
      },
      {
        "measure": "Knee alignment",
        "setup": "Knee over the foot",
        "peak": "Knee 1.5 cm outside the foot axis (over the 2nd-3rd toe)",
        "norm": "Knee over the foot; the single-leg squat showed more knee abduction than step-downs (Lewis 2015), so cue against valgus",
        "sources": [
          "lewis2015"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Balance 0.8 s",
        "peak": "2.0 s down, 0.3 s pause, 1.2 s up, 1.2 s reset",
        "norm": "Metronome at 60 bpm, about 1-2 s down and up (Lewis 2015; Muyor 2020)",
        "sources": [
          "lewis2015",
          "muyor2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #756012, Bodyweight Single Leg Squat (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/18143-bodyweight-single-leg-squat-male.html"
      },
      {
        "id": "muyor2020",
        "title": "Muyor, Martín-Fuentes, Rodríguez-Ridao & Antequera-Vique 2020, EMG activity of gluteus medius, gluteus maximus, biceps femoris and the vasti during the monopodal squat, forward lunge and lateral step-up (PLoS ONE 15(4):e0230841)",
        "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0230841"
      },
      {
        "id": "lewis2015",
        "title": "Lewis, Foch, Luko, Loverro & Khuu 2015, differences in lower extremity and trunk kinematics between single leg squat and step down tasks (PLoS ONE 10(5):e0126258)",
        "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0126258"
      },
      {
        "id": "jsr2010",
        "title": "Comparison of lower extremity EMG between the 2-leg squat and modified single-leg squat in female athletes (J Sport Rehabil 19(1):57-70, 2010; PubMed 20231745)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/20231745/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Needs good balance: have a wall or rail within reach."
      ],
      "modify": [
        "Knee pain: shallower depth.",
        "Balance concerns: hold a wall or chair with one hand, or squat to a bench behind you (box single-leg squat)."
      ],
      "regressions": [
        "Single-leg squat to a box or bench.",
        "Split squat.",
        "Hold a support."
      ],
      "progressions": [
        "Deeper range.",
        "Pistol squat.",
        "Hold a light dumbbell."
      ]
    },
    "muscleNotes": {
      "quads_r": "Stance-leg knee extensors control the descent and drive the rise; the vasti were the most active muscles in the monopodal squat (Muyor 2020).",
      "quads_l": "Stance-leg knee extensors control the descent and drive the rise; the vasti were the most active muscles in the monopodal squat (Muyor 2020).",
      "glute_max_r": "Stance-leg hip extensor; about 60% MVIC in a loaded monopodal squat to 75 degrees of knee flexion (Muyor 2020).",
      "glute_max_l": "Stance-leg hip extensor; about 60% MVIC in a loaded monopodal squat to 75 degrees of knee flexion (Muyor 2020).",
      "adductors_r": "Adductor magnus assists hip extension out of the bottom.",
      "adductors_l": "Adductor magnus assists hip extension out of the bottom.",
      "calves_r": "Balance the body over the single foot.",
      "calves_l": "Balance the body over the single foot.",
      "glute_med_r": "Holds the pelvis level and stops the knee caving in. Gluteus medius activity was higher in a single-leg than a two-leg squat (J Sport Rehabil 2010) and about 60% MVIC in Muyor 2020.",
      "glute_med_l": "Holds the pelvis level and stops the knee caving in. Gluteus medius activity was higher in a single-leg than a two-leg squat (J Sport Rehabil 2010) and about 60% MVIC in Muyor 2020.",
      "spinal_extensors_r": "Hold the trunk as it leans forward to keep the centre of mass over the foot.",
      "spinal_extensors_l": "Hold the trunk as it leans forward to keep the centre of mass over the foot.",
      "core": "Stiffens the trunk for balance.",
      "obliques_r": "Resist trunk side-lean toward the stance leg.",
      "obliques_l": "Resist trunk side-lean toward the stance leg.",
      "hip_flexors_r": "Free-leg hip flexors hold the left foot off the floor in front.",
      "hip_flexors_l": "Free-leg hip flexors hold the left foot off the floor in front."
    }
  },
