      "Hips (glutes)",
      "Core"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip, knee and ankle)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l",
