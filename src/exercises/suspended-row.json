    "name": "Suspended Row",
    "aliases": [
      "Suspension trainer row",
      "Suspension strap row",
      "Inverted row on straps"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "2290",
      "title": "Suspended Row",
      "url": "https://gymvisual.com/animated-gifs/2290-suspended-row.html",
      "listing": "Animated GIF (title from the catalog listing; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lats, mid-back)",
    "secondaryBodyParts": [
      "Upper arms (biceps)",
      "Rear shoulders",
      "Core"
    ],
    "equipment": [
      "Suspension trainer straps",
      "Pull-up bar (anchor)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (shoulder and elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "stabilizer": [
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_max_r",
        "glute_max_l",
        "hamstrings_r",
        "hamstrings_l",
        "upper_traps_r",
        "upper_traps_l"
      ],
      "lengthened": [
        "lats_r",
        "lats_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you row the bar to the stomach, breathe in as the arms straighten.",
      "cadence": "About 1.2 s pull, short squeeze, about 2 s return"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-15",
      "tempo": "1-1-2-0",
      "load": "Bodyweight; set the body angle so the last reps are hard with 1-3 reps in reserve (RIR 1-3, clinical opinion)",
      "frequency": "2-3 times a week",
      "progression": "Lower the body angle, then raise the feet"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hold a handle in each hand, palms facing in; walk the feet forward and lean back until the arms are long, heels down, body straight from heels to head."
      },
      {
        "id": "c2",
        "phase": "pull",
        "text": "Breathe out and pull the chest up to the hands, elbows close to the body."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze the shoulder blades together; hips stay up in line with the body."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the arms are long again."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the glutes and abs tight; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging toward the floor",
        "fix": "Squeeze the glutes and brace; the body stays in one line."
      },
      {
        "id": "m2",
        "mistake": "Shrugging the shoulders up to the ears",
        "fix": "Pull the shoulder blades back and down."
      },
      {
        "id": "m3",
        "mistake": "Elbows flaring wide",
        "fix": "Keep the elbows close to the ribs for this row."
      },
      {
        "id": "m4",
        "mistake": "Dropping fast into the bottom",
        "fix": "Lower over about 2 s to long arms."
      }
    ],
    "kinematics": [
      {
        "measure": "Body angle",
        "setup": "≈24° above the floor, heels down, straight from heels to head",
        "peak": "≈52° at the top (the body turns about the heels)",
        "norm": "The more upright the body, the easier the row; walking the feet forward toward the anchor makes it harder (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈27° (arms long)",
        "peak": "≈133° with the hands at the lower chest",
        "norm": "From nearly straight to about 90-110 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder blades",
        "setup": "",
        "peak": "",
        "norm": "Protracted with the arms long, retracted at the top; retraction work drives the middle trapezius and rhomboids (Oyama 2010)",
        "sources": [
          "oyama2010"
        ]
      },
      {
        "measure": "Straps",
        "setup": "Straps 103.9 cm from a single anchor 215 cm up; 25° from vertical at the bottom",
        "peak": "11° from vertical at the top; at least 7.9 cm off the body",
        "norm": "Straps stay taut and close to vertical; the hands stay on the strap arcs about the anchor (geometry)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.5 s",
        "peak": "1.2 s up, 0.4 s squeeze, 2 s down",
        "norm": "Controlled, about 1 s up and 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #2290, Suspended Row, animated GIF (movement reference)",
        "url": "https://gymvisual.com/animated-gifs/2290-suspended-row.html"
      },
      {
        "id": "fenwick2009",
        "title": "Fenwick, Brown & McGill 2009, comparison of different rowing exercises: trunk muscle activation and lumbar spine motion, load and stiffness (J Strength Cond Res 23(2):350-358)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19197209/"
      },
      {
        "id": "oyama2010",
        "title": "Oyama, Myers, Wassinger and Lephart 2010, three-dimensional scapular and clavicular kinematics and scapular muscle activity during retraction exercises (J Orthop Sports Phys Ther 40(3):169-179)",
        "url": "https://chs.uky.edu/sites/default/files/2023-12/Oyama_2010_Three-Dimensional%20Scapular%20and%20Clavicular%20Kinematics.pdf"
      }
    ],
    "safety": {
      "cautions": [
        "Check the anchor and the straps before each set; anchor only to a sturdy bar or a door anchor made for it.",
        "Shoulder pain: stand more upright and shorten the range (clinical opinion).",
        "Keep the straps taut; do not let them rub on the arms.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Gymnastic rings work the same way.",
        "Bend the knees, feet flat, to take some of the load."
      ],
      "regressions": [
        "Stand more upright (feet further from the anchor).",
        "Bent-knee suspended row."
      ],
      "progressions": [
        "Walk the feet toward the anchor so the body is lower.",
        "Feet raised on a box.",
        "Single-arm suspended row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Prime mover: pulls the upper arm back past the trunk.",
      "lats_l": "Prime mover: pulls the upper arm back past the trunk.",
      "rhomboids_midtrap_r": "Prime mover: draws the shoulder blade back at the finish.",
      "rhomboids_midtrap_l": "Prime mover: draws the shoulder blade back at the finish.",
      "post_deltoid_r": "Helps pull the upper arm back.",
      "post_deltoid_l": "Helps pull the upper arm back.",
      "biceps_r": "Bends the elbow as the bar comes in.",
      "biceps_l": "Bends the elbow as the bar comes in.",
      "forearm_flexors_r": "Grip the bar.",
      "forearm_flexors_l": "Grip the bar.",
      "core": "Braces the trunk so the cable does not pull it forward.",
      "spinal_extensors_r": "Hold the spine upright.",
      "spinal_extensors_l": "Hold the spine upright.",
      "glute_max_r": "Keep the hips extended in line with the body (clinical opinion).",
      "glute_max_l": "Keep the hips extended in line with the body (clinical opinion).",
      "upper_traps_r": "Steadies the shoulder girdle; should not shrug.",
      "upper_traps_l": "Steadies the shoulder girdle; should not shrug.",
      "hamstrings_r": "Hold the hips up with the glutes so the body stays straight (clinical opinion).",
      "hamstrings_l": "Hold the hips up with the glutes so the body stays straight (clinical opinion)."
    }
