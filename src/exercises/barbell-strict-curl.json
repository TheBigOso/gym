    "id": "barbell-strict-curl",
    "name": "Barbell Strict Curl",
    "aliases": [
      "Barbell wall curl",
      "Strict barbell curl against the wall",
      "Back-to-wall barbell curl"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "14792",
      "title": "Barbell Strict Curl",
      "url": "https://gymvisual.com/videos/14792-barbell-srtict-curl.html",
      "listing": "Video (title from the listing URL; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper arms (biceps)",
    "secondaryBodyParts": [
      "Forearms"
    ],
    "equipment": [
      "Barbell",
      "Wall"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (elbow)",
    "plane": "Sagittal",
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1.2 s up, short squeeze, about 2.4 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-12",
      "load": "Load is user-chosen: the wall removes body swing, so expect less than for a free-standing barbell curl; pick a bar you can curl for the target reps with 1-3 reps in reserve (RIR 1-3, clinical opinion).",
      "tempo": "1-0-2-1 (about 1 s up, 2-3 s down)",
      "frequency": "2-3 times a week",
      "progression": "Add reps, then weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand with the glutes, upper back and head on a wall, heels a few centimetres out; underhand grip (palms up), hands about shoulder width, the backs of the elbows touching the wall, the bar resting on the thighs."
      },
      {
        "id": "c2",
        "phase": "lift",
        "text": "Breathe out and curl the bar up; the elbows stay on the wall."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Squeeze with the bar near the upper chest; shoulders stay down and back on the wall."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, 2-3 s, back to the thighs."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Back, head and elbows still on the wall; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows coming off the wall at the top",
        "fix": "Stop the curl when the elbows want to move forward; the elbows stay on the wall."
      },
      {
        "id": "m2",
        "mistake": "Head or upper back peeling off the wall to help the bar up",
        "fix": "Lighten the bar; keep the head and shoulders on the wall."
      },
      {
        "id": "m3",
        "mistake": "Shrugging at the top",
        "fix": "Shoulders down and back."
      },
      {
        "id": "m4",
        "mistake": "Dropping the bar on the way down",
        "fix": "Take 2-3 s to lower back to the thighs."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈42° (arm straight)",
        "peak": "≈132° at the top (range ≈90°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018)",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "-11.9° (palm forward/up)",
        "peak": "-4.9° (palm forward/up)",
        "norm": "Grip changes the biceps/brachioradialis share: the supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-17°",
        "peak": "≈-17° (elbow behind the trunk line)",
        "norm": "Elbows held back on the wall: the upper arm stays just behind the trunk line, so the front deltoid cannot help (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Bar on the thighs 0.6 s",
        "peak": "1.2 s up, 0.3 s squeeze, 2.4 s down, 0.9 s at the bottom",
        "norm": "Controlled, about 1 s up and 2-3 s down (clinical opinion); biceps activity was lower while lowering than lifting at the same load (Oliveira 2009)",
        "sources": [
          "oliveira2009"
        ]
      },
      {
        "measure": "Back on the wall (rig shapes)",
        "setup": "Wall face 8.5 cm behind the pelvis centre; heels ≈2.5 cm from the wall",
        "peak": "Unchanged: trunk and elbows stay on the wall (arm-to-wall gap 0 to 0 cm)",
        "norm": "Glutes, upper back, head and elbows touch the wall throughout (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #14792, Barbell Strict Curl, video (movement reference)",
        "url": "https://gymvisual.com/videos/14792-barbell-srtict-curl.html"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "oliveira2009",
        "title": "Oliveira, Matta, Alves, Garcia and Vieira 2009, effect of the shoulder position on the biceps brachii EMG in different dumbbell curls (J Sports Sci Med 8(1):24-29)",
        "url": "https://jssm.org/jssm-08-24.xml-abst"
      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: lighten the bar and shorten the range; stop if pain is sharp (clinical opinion).",
        "A straight bar turns the forearms fully up; if the wrists or elbows complain, use an EZ bar (clinical opinion).",
        "Lift the bar from a rack or the floor with a flat back and bent knees, and set it down the same way.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "EZ bar.",
        "Free-standing barbell curl with the elbows pinned to the sides if no wall is free."
      ],
      "regressions": [
        "Empty bar or a light fixed barbell.",
        "Dumbbell strict curl."
      ],
      "progressions": [
        "Slower lowering (3-4 s).",
        "Pause at the top.",
        "Heavier bar for fewer reps."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Main elbow flexor and forearm supinator; with a supinated grip it worked harder than with neutral (+12%) or pronated (+19%) grips in the lifting phase (Coratella 2023). The wall keeps the elbows back, so the shoulder cannot swing the bar.",
      "biceps_l": "Main elbow flexor and forearm supinator; with a supinated grip it worked harder than with neutral (+12%) or pronated (+19%) grips in the lifting phase (Coratella 2023). The wall keeps the elbows back, so the shoulder cannot swing the bar.",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) helps flex the elbow (Coratella 2023).",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) helps flex the elbow (Coratella 2023).",
      "forearm_flexors_r": "Wrist and finger flexors hold the bar and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the bar and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder; the elbows on the wall stop it from lifting the bar (clinical opinion).",
      "ant_deltoid_l": "Steadies the shoulder; the elbows on the wall stop it from lifting the bar (clinical opinion).",
      "post_deltoid_r": "Holds the elbows back against the wall (clinical opinion).",
      "post_deltoid_l": "Holds the elbows back against the wall (clinical opinion).",
      "core": "Keeps the back flat on the wall."
    }
  },
