  "exercise": {
    "id": "oblique-crunch",
    "name": "Oblique Crunch",
    "aliases": [
      "Crossed-leg oblique crunch",
      "Cross-knee crunch",
      "Elbow-to-knee oblique crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5291",
      "title": "Oblique Crunch (Version 2)",
      "url": "https://gymvisual.com/videos/5291-oblique-crunch-version-2.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the network proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, obliques)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (spinal flexion with rotation)",
    "plane": "Multiplanar",
    "laterality": "Unilateral (one side per set)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l",
        "core"
      ],
      "synergist": [],
      "stabilizer": [
        "hip_flexors_r",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl and turn, inhale as you lower.",
      "cadence": "About 1 s up and turn, a short squeeze, about 1.4 s down, then switch sides"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15 per side",
      "tempo": "About 1 s up, brief squeeze, 1.5 s down",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering and a 2 s hold, then the bicycle crunch"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, right foot flat, left ankle crossed over the right knee. Right fingertips behind the head, left arm out on the mat."
      },
      {
        "id": "c2",
        "phase": "twist",
        "text": "Breathe out, curl up and turn the right shoulder and elbow toward the left knee."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze briefly; the pelvis and legs stay still."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower under control, head last."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Finish the set, then cross the other leg and switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling the head toward the knee with the hand",
        "fix": "Fingertips only; turn the shoulder, not the neck."
      },
      {
        "id": "m2",
        "mistake": "Bringing the knee to the elbow (pelvis rolls)",
        "fix": "Keep the crossed leg still; the trunk does the turning."
      },
      {
        "id": "m3",
        "mistake": "Elbow collapsing in so only the arm moves",
        "fix": "Keep the elbow wide and lift the shoulder blade."
      },
      {
        "id": "m4",
        "mistake": "Rushing",
        "fix": "About 1 s up, a short squeeze, 1.5 s down."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk (T12 to C7) from the floor",
        "setup": "≈-1°",
        "peak": "≈28° (C7 up 16.2 cm)",
        "norm": "Shoulder blades clear the mat as in a crunch (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk rotation",
        "setup": "Facing the ceiling",
        "peak": "≈36° toward the crossed knee (thoracic ≈33°); right shoulder 24 cm higher than the left",
        "norm": "Upper trunk turns toward the opposite knee; the cross curl-up raised external oblique activity (Konrad 2001)",
        "sources": [
          "konrad2001"
        ]
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈7° (resting curve)",
        "peak": "≈47° (+39°)",
        "norm": "Most of the curl happens here (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip and knee",
        "setup": "Right knee ≈90° (foot flat); left ankle on the right knee, left hip ≈108° flexed, ≈29° abducted, ≈-40° rotated",
        "peak": "Unchanged (pelvis and legs still)",
        "norm": "One foot flat, the other ankle crossed on that knee; the pelvis does not move (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Right fingertips behind the head; left arm out on the mat",
        "peak": "Right elbow 58 cm from the left knee (reaching toward it)",
        "norm": "Working hand supports the head only; the other arm rests on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.6 s",
        "peak": "1.0 s up and turn, 0.4 s squeeze, 1.4 s down, 0.6 s rest",
        "norm": "Controlled, about 1 s up and 1.5 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #5291, Oblique Crunch (Version 2), video (movement reference; page not readable here)",
