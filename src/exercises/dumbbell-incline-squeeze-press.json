    "safety": {
      "cautions": [
        "Get into position safely: sit with the dumbbells on the thighs, lie back and kick them up with the knees; at the end of the set bring them back to the thighs rather than dropping them (clinical opinion).",
        "Shoulder pain: shorten the range at the bottom until it settles (clinical opinion).",
        "Keep the wrists straight over the forearms; bent-back wrists under a heavy dumbbell strain the wrist.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Elbow discomfort: lighter dumbbells and a shorter range."
      ],
      "regressions": [
        "Flat dumbbell squeeze press.",
        "Incline push-up."
      ],
      "progressions": [
        "Pause 2 s at the bottom.",
        "Slower lowering (3-4 s)."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main pusher; squeezing the dumbbells together adds an inward (adduction) effort, and the incline shifts work toward the upper fibres (Rodríguez-Ridao 2020).",
      "pec_l": "As the right side.",
      "triceps_r": "Straightens the elbow; works hard with the elbows tucked.",
      "triceps_l": "As the right side.",
      "ant_deltoid_r": "Flexes the shoulder; busier on an incline (Rodríguez-Ridao 2020).",
      "ant_deltoid_l": "As the right side.",
      "serratus_r": "Holds the shoulder blade on the rib cage.",
      "serratus_l": "As the right side.",
      "biceps_r": "Steadies the elbow (Saeterbakken 2011).",
      "biceps_l": "As the right side.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "rhomboids_midtrap_r": "Keep the shoulder blades back on the pad.",
      "rhomboids_midtrap_l": "As the right side.",
      "core": "Keeps the trunk still on the pad."
    }
