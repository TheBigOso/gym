    "breathing": {
      "pattern": "Inhale as you lower the dumbbells, exhale as you press them up.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-15",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Use a lighter pair than for the incline press: the squeeze, not the load, is the point. Pick a weight you can lift for the target reps with 1-3 reps in reserve.",
      "progression": "Add reps up to the top of the range, then move to the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Back pad at 30 degrees, glutes in the crease, feet planted; dumbbells pressed together over the upper chest, palms facing, plates touching."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the pair together toward the upper chest, squeezing the plates into each other, elbows close to the body."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Plates just above the chest, still pressed together; brief pause."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press straight up, squeezing the dumbbells together the whole way."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze hard at the top, then lower again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dumbbells drifting apart",
        "fix": "Actively push the plates into each other through the whole rep."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring wide",
        "fix": "Keep the elbows close to the trunk."
      },
      {
        "id": "m3",
        "mistake": "Touching the chest with the dumbbells",
        "fix": "Stop a few centimetres above the chest."
      },
      {
        "id": "m4",
        "mistake": "Going too heavy",
        "fix": "Use a load that lets you squeeze hard for every rep."
      }
    ],
    "kinematics": [
      {
        "measure": "Dumbbell contact",
        "setup": "Plates 1.4 cm apart (pressed together), handles along the body",
        "peak": "Closest plate gap through the loop -0.05 cm",
        "norm": "Plates pressed together throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈8° (straight, not locked)",
        "peak": "≈115° at the bottom, plates 5 cm above the chest",
        "norm": "Straight but not locked at the top; about 90 degrees at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck",
        "setup": "Arms vertical over the upper chest",
        "peak": "≈43° from the trunk at the bottom",
        "norm": "Elbows close to the trunk, about 20-35 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Bench angle",
        "setup": "30° back pad, flat seat",
        "peak": "Glutes in the crease, upper back and head on the pad",
        "norm": "30-degree back pad, flat seat (Rodríguez-Ridao 2020)",
        "sources": [
          "rodriguez2020"
        ]
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat, knees about 80-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.2 s up, 0.7 s squeeze at the top",
        "norm": "About 2 s down, a short pause, 1-1.5 s up (clinical opinion)",
        "sources": []
      }
