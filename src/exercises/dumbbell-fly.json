    },
    "breathing": {
      "pattern": "Inhale as the arms open, exhale as you squeeze them back together.",
      "cadence": "About 2.2 s down, 0.4 s stretch, 1.5 s up"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15",
      "tempo": "3-1-2-0 (3 s down, 1 s stretch, 2 s up)",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9). Use much lighter dumbbells than for the press.",
      "progression": "More reps, then a slower lowering, then the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench, feet planted; dumbbells together over the chest, palms facing each other, elbows softly bent."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and open the arms in a wide arc, elbows softly bent and fixed, like hugging a big tree in reverse."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop when the upper arms are about level with the bench and the chest is stretched; palms face the ceiling."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and squeeze the chest to sweep the dumbbells back up along the same arc."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Bring the dumbbells together over the chest without letting them touch; keep the elbow bend."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Turning the fly into a press (elbows bending and straightening)",
        "fix": "Fix a soft bend in the elbows at the top and keep that same angle all the way down and up."
      },
      {
        "id": "m2",
        "mistake": "Lowering too far",
        "fix": "Stop when the upper arms are about level with the bench and you feel a stretch across the chest, not a pull in the front of the shoulder."
      },
      {
        "id": "m3",
        "mistake": "Locked straight elbows",
        "fix": "Keep a soft bend (elbows at about 150-160 degrees) to keep the load off the elbow joint."
      },
      {
        "id": "m4",
        "mistake": "Too heavy a weight",
        "fix": "The fly needs a much lighter dumbbell than the press; in one study the 6-repetition maximum was less than half the bench press load (Solstad 2020)."
      },
      {
        "id": "m5",
        "mistake": "Clanging the dumbbells at the top",
        "fix": "Bring them together in a wide hug and stop just before they touch; squeeze the chest."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "Flat (0°)",
        "peak": "Glutes on the seat, upper back and head on the pad (skinned mesh within about 1 cm, measured with b2/chest_mesh.mjs)",
        "norm": "Flat (0 degrees), as in Solstad 2020 and Welsch 2005",
        "sources": [
          "solstad2020",
          "welsch2005"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈22° flexion (elbow angle ≈158°)",
        "peak": "≈22° at the bottom; 22-22° through the loop",
        "norm": "Fixed soft bend: Solstad 2020 held the elbow at about 150-160 degrees (20-30 degrees of flexion) at the bottom and stopped the set if it bent further",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Arm opening (upper arm from vertical)",
        "setup": "Upper arm ≈3° from vertical",
        "peak": "≈93° from vertical at the bottom, 12° toward the hips",
        "norm": "From over the chest to about level with the bench at the bottom (clinical opinion); Solstad 2020 standardised depth with the dumbbell bands touching the chest line",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Upper arm depth",
        "setup": "–",
        "peak": "≈4° below the back plane",
        "norm": "Upper arms about level with the bench at the bottom, no lower (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral; dumbbells 6.5 cm apart at the top",
        "peak": "Palms up at the bottom; dumbbell centres 149.9 cm apart",
        "norm": "Neutral: palms face each other at the top and the ceiling at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat, knees about 90 degrees (Solstad 2020 set-up)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "2.2 s down, 0.4 s stretch, 1.5 s up, 0.6 s squeeze",
        "norm": "Slow and controlled; Solstad 2020 used a controlled self-selected tempo. About 2-3 s down and 1.5-2 s up (clinical opinion)",
        "sources": [
          "solstad2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #030812, Dumbbell Fly, video (movement reference)",
        "url": "https://gymvisual.com/videos/2886-dumbbell-fly.html"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      },
      {
        "id": "welsch2005",
        "title": "Welsch, Bird and Mayhew 2005, electromyographic activity of the pectoralis major and anterior deltoid muscles during three upper-body lifts (J Strength Cond Res 19(2):449-452)",
        "url": "https://www.bisp-surf.de/Record/PU201204002593"
      }
    ],
    "safety": {
      "cautions": [
        "Get into position safely: sit on the end of the bench with the dumbbells on the thighs, then lie back and kick them up one knee at a time; at the end of the set bring them back to the thighs or lower them to the floor beside the bench rather than dropping them (clinical opinion).",
        "Shoulder pain: shorten the range at the bottom and keep the upper arms out of the fully stretched position until it settles (clinical opinion).",
        "Keep the wrists straight over the forearms; bent-back wrists under a heavy dumbbell strain the wrist.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Do not let heavy dumbbells pull the arms below the bench line: the stretched shoulder is the vulnerable position (clinical opinion)."
      ],
      "modify": [
        "Shoulder discomfort: shorten the arc so the upper arms stop above the bench line.",
        "Elbow discomfort: keep a little more bend and use lighter dumbbells."
      ],
      "regressions": [
        "Floor fly (the floor limits the depth).",
        "Machine pec deck or band fly."
      ],
      "progressions": [
        "Slower lowering with a 1-2 s pause in the stretch.",
        "Heavier dumbbells.",
        "Cable fly (more tension at the top)."
      ]
    },
    "muscleNotes": {
      "pec_r": "Main mover: hugs the upper arms across the chest (horizontal adduction). Whole-movement activity was about 16% lower than in a barbell bench press, and lower than the press mostly in the stretched part of the lowering (Solstad 2020); Welsch 2005 found similar peak activity to the dumbbell press but a shorter time of high activity.",
      "pec_l": "Main mover: hugs the upper arms across the chest (horizontal adduction). Whole-movement activity was about 16% lower than in a barbell bench press, and lower than the press mostly in the stretched part of the lowering (Solstad 2020); Welsch 2005 found similar peak activity to the dumbbell press but a shorter time of high activity.",
      "ant_deltoid_r": "Helps bring the arms together; its activity was about 25% lower than in the barbell bench press (Solstad 2020).",
      "ant_deltoid_l": "Helps bring the arms together; its activity was about 25% lower than in the barbell bench press (Solstad 2020).",
      "biceps_r": "Holds the fixed elbow bend against the load: biceps activity was about 76% higher in the dumbbell fly than in the bench press (Solstad 2020).",
      "biceps_l": "Holds the fixed elbow bend against the load: biceps activity was about 76% higher in the dumbbell fly than in the bench press (Solstad 2020).",
      "serratus_r": "Keeps the shoulder blades on the rib cage while the arms open and close.",
      "serratus_l": "Keeps the shoulder blades on the rib cage while the arms open and close.",
      "triceps_r": "Light work holding the elbows from bending further; about 75% lower than in the bench press (Solstad 2020).",
      "triceps_l": "Light work holding the elbows from bending further; about 75% lower than in the bench press (Solstad 2020).",
      "forearm_flexors_r": "Grip the handles, palms facing each other.",
      "forearm_flexors_l": "Grip the handles, palms facing each other.",
      "infraspinatus_r": "Rotator cuff: steadies the head of the upper arm in the stretched position (clinical opinion).",
      "infraspinatus_l": "Rotator cuff: steadies the head of the upper arm in the stretched position (clinical opinion).",
      "core": "Bracing keeps the ribs down and the pelvis on the seat."
    }
  },
