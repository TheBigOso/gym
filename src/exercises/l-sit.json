  "exercise": {
    "id": "l-sit",
    "name": "L-sit",
    "aliases": [
      "Floor L-sit",
      "L-sit hold",
      "L-seat"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "4244",
      "title": "L-sit",
      "url": "https://gymvisual.com/videos/4244-l-sit.html",
      "listing": "GymVisual page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching knowledge",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Upper arms (triceps)",
      "Shoulders (depressors)",
      "Thighs (quadriceps)"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Advanced",
    "mechanics": "Isometric (hip flexion hold with shoulder depression)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core",
        "hip_flexors_r",
        "hip_flexors_l",
        "triceps_r",
        "triceps_l"
      ],
      "synergist": [
        "quads_r",
        "quads_l",
        "lats_r",
        "lats_l",
        "pec_r",
        "pec_l",
        "serratus_r",
        "serratus_l",
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "adductors_r",
        "adductors_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Short, steady breaths through the hold with the brace on.",
      "cadence": "About one breath every 2 s during the 4 s hold"
    },
    "prescription": {
      "sets": "3-6",
      "reps": "1 hold per set",
      "tempo": "Hold 3-10 s, build toward 20-30 s",
      "frequency": "2-4 times a week",
      "progression": "Tuck sit, then one leg straight, then the full L-sit; parallettes give more clearance"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit with the legs straight and together, hands flat beside the hips, fingers forward."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Lock the elbows, push the floor away and pull the shoulders down: the hips and legs lift off the mat together."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Legs straight and level, toes pointed, chest up; breathe in short breaths."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower the hips and heels back to the mat under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Shrugging the shoulders up to the ears",
        "fix": "Push the floor away: shoulders down, long neck."
      },
      {
        "id": "m2",
        "mistake": "Bent knees or dropped heels",
        "fix": "Squeeze the quads and point the toes; regress to a tuck sit if needed."
      },
      {
        "id": "m3",
        "mistake": "Elbows bending",
        "fix": "Lock the arms straight."
      },
      {
        "id": "m4",
        "mistake": "Leaning far back",
        "fix": "Keep the shoulders roughly over the hands."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈94°, legs on the mat",
        "peak": "≈101°, legs level",
        "norm": "About 90 degrees, legs level with the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow",
        "setup": "≈10° (hands beside the hips)",
        "peak": "≈4° (locked)",
        "norm": "Locked straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder depression",
        "setup": "Neutral",
        "peak": "Clavicle elevation -10° (rig limit -10°)",
        "norm": "Shoulders pulled down away from the ears to gain height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Clearance",
        "setup": "Buttocks and legs on the mat",
        "peak": "Hips 5.5 cm, legs 5.2 cm off the mat",
        "norm": "Hips and heels just off the floor; arm length decides how high (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Sit 1 s",
        "peak": "0.6 s press, 4 s hold, 0.8 s lower, 1.6 s rest",
        "norm": "Short holds repeated (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #4244, L-sit, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/4244-l-sit.html"
      },
      {
        "id": "konrad2001",
        "title": "Konrad, Schmitz and Denner 2001, neuromuscular evaluation of trunk-training exercises (J Athl Train 36(2):109-118; PMC155519)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC155519"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain occurs in the wrists, elbows or shoulders.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Wrist pain: use parallettes or fists, or press on yoga blocks.",
        "Tight hamstrings make the straight-leg position hard: bend the knees (tuck sit)."
      ],
      "modify": [
        "Wrist discomfort: hands on parallettes or blocks.",
        "Not enough clearance: hands on blocks for extra height."
      ],
      "regressions": [
        "Tuck sit (knees bent to the chest).",
        "One-leg L-sit.",
        "Feet-supported L-sit (heels down, hips up)."
      ],
      "progressions": [
        "Longer holds.",
        "V-sit (legs higher)."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis holds the pelvis against the pull of the hip flexors and the weight of the straight legs (clinical opinion).",
      "hip_flexors_r": "Iliopsoas and rectus femoris hold the straight legs level with the hips flexed about 90 degrees (clinical opinion).",
      "hip_flexors_l": "Iliopsoas and rectus femoris hold the straight legs level with the hips flexed about 90 degrees (clinical opinion).",
      "triceps_r": "Triceps lock the elbows to support the body on the hands (clinical opinion).",
      "triceps_l": "Triceps lock the elbows to support the body on the hands (clinical opinion).",
      "lats_r": "Lats and lower pecs pull the shoulders down to lift the body higher (clinical opinion).",
      "lats_l": "Lats and lower pecs pull the shoulders down to lift the body higher (clinical opinion)."
    }
  },
