{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "lying-knee-raise",
    "name": "Lying Knee Raise",
    "aliases": [
      "Lying knee tuck",
      "Supine knee raise",
      "Lying knees to chest"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "19022",
      "title": "Lying Knee Raise",
      "url": "https://gymvisual.com/videos/19022-lying-knee-raise-male.html",
      "listing": "Video (movement reference; the page could not be read at authoring time, so the movement is taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Thighs (quadriceps)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip and knee flexion with the legs off the floor, trunk held)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ],
      "stabilizer": [
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the knees come in, in as the legs extend.",
      "cadence": "About 1.1 s in, 1.6 s out"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "About 1 s in, short pause, 1.5 s out",
      "load": "Body weight",
      "frequency": "2-4 times a week",
      "progression": "Lower hover at the extension, then reverse crunch, then lying leg raise"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, arms by your sides palms down, legs straight with the heels just off the mat."
      },
      {
        "id": "c2",
        "phase": "tuck",
        "text": "Bend the knees and draw them in toward the chest; the low back stays on the mat."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Pause with the knees over the chest."
      },
      {
        "id": "c4",
        "phase": "extend",
        "text": "Push the legs back out long, slowly, to the hover."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Heels stay just off the mat; next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching as the legs straighten",
        "fix": "Stop the extension higher or put the hands under the hips."
      },
      {
        "id": "m2",
        "mistake": "Heels touching down between reps",
        "fix": "Keep the hover; rest only between sets."
      },
      {
        "id": "m3",
        "mistake": "Rocking the hips up",
        "fix": "Pelvis stays on the mat; curling it up is the reverse crunch."
      },
      {
        "id": "m4",
        "mistake": "Rushing the extension",
        "fix": "Take longer out than in."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈9°",
        "peak": "≈121° (thighs ≈119° from the floor, knees over the chest)",
        "norm": "From a few degrees in the hover to about 110-120 degrees with the knees over the chest (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knees",
        "setup": "≈3°",
        "peak": "≈119°",
        "norm": "From nearly straight to about 110-120 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Heels in the hover",
        "setup": "6 cm off the mat",
        "peak": "Never below 6 cm during the rep",
        "norm": "A few centimetres off the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Pelvis stays on the mat; bent-knee hip flexion loads the spine less than straight-leg raises (McGill 1998)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hover 0.5 s",
        "peak": "1.1 s in, 0.4 s pause, 1.6 s out, 1.8 s hover",
        "norm": "About 1 s in and 1.5 s out (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual 19022, Lying Knee Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/19022-lying-knee-raise-male.html"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Low-back pain: start each rep from the feet on the mat instead of the hover.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk work."
      ],
      "modify": [
        "Hands under the hips.",
        "Tap the heels down between reps."
      ],
      "regressions": [
        "Single-leg knee raise.",
        "Dead bug."
      ],
      "progressions": [
        "Reverse crunch.",
        "Lying leg raise.",
        "Hanging knee raise."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas draws the thigh toward the chest and holds the leg off the mat.",
      "hip_flexors_l": "Iliopsoas draws the thigh toward the chest and holds the leg off the mat.",
      "core": "Rectus abdominis and transversus keep the pelvis and low back on the mat while the legs move (Andersson 1997).",
      "obliques_r": "Brace the trunk with the rectus abdominis.",
      "obliques_l": "Brace the trunk with the rectus abdominis.",
      "quads_r": "Straighten the knee on the way out and hold the hover.",
      "quads_l": "Straighten the knee on the way out and hold the hover.",
      "adductors_r": "Keep the legs together.",
      "adductors_l": "Keep the legs together."
    }
  },
