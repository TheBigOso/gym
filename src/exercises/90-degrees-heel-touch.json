{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "90-degrees-heel-touch",
    "name": "90 degrees Heel Touch",
    "aliases": [
      "Tabletop heel taps",
      "90-90 heel taps (both legs)",
      "Double-leg heel touch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "9306",
      "title": "90 degrees Heel Touch",
      "url": "https://gymvisual.com/videos/9306-90-degrees-heel-touch.html",
      "listing": "Video (movement reference; page could not be read at authoring time, movement taken from the exercise name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (lower abdominals)",
    "secondaryBodyParts": [
      "Hips (hip flexors)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip extension and flexion with the knees held at 90 degrees; anti-extension core)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "stabilizer": [
        "obliques_r",
        "obliques_l",
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the heels lower, exhale as the legs come back to tabletop.",
      "cadence": "About 1.4 s down, 1.2 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-15",
      "tempo": "1.5-0-1-1",
      "frequency": "2-4 times a week",
      "progression": "Slower lowering, then straighten the knees a little (longer lever)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "table",
        "text": "Lie on your back, arms by your sides; hips and knees bent 90 degrees, shins level (tabletop)."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Keep the knees at 90 degrees and lower both heels toward the mat; low back stays flat."
      },
      {
        "id": "c3",
        "phase": "tap",
        "text": "Lightly touch the heels to the mat; do not rest."
      },
      {
        "id": "c4",
        "phase": "raise",
        "text": "Breathe out and draw the thighs back to vertical."
      },
      {
        "id": "c5",
        "phase": "hold",
        "text": "Pause in tabletop and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching as the heels lower",
        "fix": "Shorten the range: tap only as low as the back stays flat."
      },
      {
        "id": "m2",
        "mistake": "Knee angle opening to reach the floor",
        "fix": "Keep the knees at 90 degrees; the movement comes from the hips."
      },
      {
        "id": "m3",
        "mistake": "Dropping the heels onto the mat",
        "fix": "Touch lightly and come straight back up."
      },
      {
        "id": "m4",
        "mistake": "Holding the breath",
        "fix": "Inhale down, exhale up."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈92° (thighs vertical)",
        "peak": "≈46° at the heel touch",
        "norm": "About 90 degrees in tabletop (thighs vertical), lowering until the heels touch (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈90°",
        "peak": "≈90° (held)",
        "norm": "Held at about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Heel height",
        "setup": "Heels 41 cm above the mat in tabletop",
        "peak": "0.3 cm (light touch)",
        "norm": "Heels lightly touch the mat at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Pelvis stays on the mat; low back flat (clinical opinion; Drysdale 2004 for abdominal bracing)",
        "sources": [
          "drysdale2004"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Tabletop 0.8 s",
        "peak": "1.4 s down, 0.3 s touch, 1.2 s up, 0.9 s pause",
        "norm": "Slow down, controlled up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #9306, 90 degrees Heel Touch, video (movement reference)",
        "url": "https://gymvisual.com/videos/9306-90-degrees-heel-touch.html"
      },
      {
        "id": "drysdale2004",
        "title": "Drysdale, Earl and Hertel 2004, surface EMG of the abdominal muscles during pelvic-tilt and abdominal-hollowing exercises (J Athl Train 39(1):32-36)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC385259/"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises: implications for rehabilitation and training (Phys Ther 86(5):656-671; PubMed 16649890)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/16649890/"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion or legs-off-the-floor work."
      ],
      "modify": [
        "Tap one heel at a time (dead bug legs).",
        "Smaller range."
      ],
      "regressions": [
        "Single-leg heel taps.",
        "Dead bug."
      ],
      "progressions": [
        "Slower lowering.",
        "Longer lever (knees a little straighter)."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis and transversus keep the pelvis tilted back as the legs lower and pull it level; the anti-extension demand rises as the heels go down (clinical opinion; Escamilla 2006 for lower abdominal exercises).",
      "hip_flexors_r": "Control the lowering and lift the thighs back to vertical.",
      "hip_flexors_l": "Control the lowering and lift the thighs back to vertical.",
      "obliques_r": "Help hold the ribs and pelvis together.",
      "obliques_l": "Help hold the ribs and pelvis together.",
      "quads_r": "Hold the knee angle.",
      "quads_l": "Hold the knee angle."
    }
  },
