  "exercise": {
    "id": "dumbbell-finger-curl",
    "name": "Dumbbell Finger Curl",
    "aliases": [
      "Seated dumbbell finger curl",
      "Dumbbell finger roll",
      "Finger roll"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "143712",
      "title": "Dumbbell Finger Curls",
      "url": "https://gymvisual.com/videos/19710-dumbbell-finger-curls.html",
      "listing": "Video; data sheet: body part Forearms, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Forearms",
    "secondaryBodyParts": [],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (fingers and wrist)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_extensors_r",
        "forearm_extensors_l",
        "biceps_r",
        "biceps_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the dumbbell rolls down to the fingertips, exhale as the fingers curl it back up.",
      "cadence": "About 1.5 s down, short pause, 1.4 s up, 0.6 s squeeze"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "load": "Dumbbell load is user-chosen: pick a weight you can control through the full range for every rep with 1-3 reps in reserve (RPE 7-9). Finger curls need a light dumbbell: the fingers must hold it at the fingertips.",
      "tempo": "2-0-1-1",
      "frequency": "2-3 times a week",
      "progression": "More reps, then a heavier dumbbell"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the end of the bench, forearms along the thighs, palms up, wrists just past the knees, dumbbells in a full fist."
      },
      {
        "id": "c2",
        "phase": "roll",
        "text": "Breathe in, let the wrists bend back and open the fingers so the handle rolls down to the fingertips."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Handle at the fingertips; keep the hold, do not drop it."
      },
      {
        "id": "c4",
        "phase": "curl",
        "text": "Breathe out and curl the fingers to roll the handle back into the palm, then curl the wrists up a little."
      },
      {
        "id": "c5",
        "phase": "squeeze",
        "text": "Squeeze the fist hard for a moment; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the dumbbell slip off the fingers",
        "fix": "Go lighter and roll only as far as you can hold."
      },
      {
        "id": "m2",
        "mistake": "Turning it into a full wrist curl",
        "fix": "Let the fingers do the work; the wrist moves only a little."
      },
      {
        "id": "m3",
        "mistake": "Forearms lifting off the thighs",
        "fix": "Keep the forearms pinned."
      }
    ],
    "kinematics": [
      {
        "measure": "Wrist position",
        "setup": "20° flexion with a closed fist at the top",
        "peak": "42° extension at the bottom (arc ≈62°)",
        "norm": "Grip is strongest at about 35 degrees of wrist extension and needs at least 25 degrees (O'Driscoll 1992); the wrist bends back to let the handle roll out and comes up only a little (clinical opinion)",
        "sources": [
          "odriscoll1992"
        ]
      },
      {
        "measure": "Finger action",
        "setup": "Full fist; handle set 8.4 cm toward the fingers (finger crease)",
        "peak": "Not animated: the player keeps a holding hand closed and the handle fixed in it, so the roll to the fingertips is shown by the wrist bending back and by the cues",
        "norm": "Fingers open until the handle sits at the fingertips, then curl it back into a full fist (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Forearm on the thigh",
        "setup": "Elbow at 66% of the thigh, wrist at 122% (just past the knee); elbow ≈53°",
        "peak": "Forearm still (elbow and wrist move 0 cm over the loop)",
        "norm": "Forearms rest along the thighs and stay still; only the hands move, the wrists just past the knees so the hands move freely (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.5 s",
        "peak": "1.5 s roll down, 0.4 s hold, 1.4 s curl up, 0.6 s squeeze",
        "norm": "Slow and controlled with a squeeze in the fist (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #143712, Dumbbell Finger Curls, video (movement reference)",
        "url": "https://gymvisual.com/videos/19710-dumbbell-finger-curls.html"
      },
      {
        "id": "odriscoll1992",
        "title": "O'Driscoll, Horii, Ness, Cahalan, Richards and An 1992, the relationship between wrist position, grasp size, and grip strength (J Hand Surg Am 17(1):169-177)",
        "url": "https://mayoclinic.elsevierpure.com/en/publications/the-relationship-between-wrist-position-grasp-size-and-grip-stren"
      },
      {
        "id": "szymanski2004",
        "title": "Szymanski, Szymanski, Molloy and Pascoe 2004, effect of 12 weeks of wrist and forearm training on high school baseball players (J Strength Cond Res 18(3):432-440; PubMed 15320673; 43 players)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/15320673/"
      }
    ],
    "safety": {
      "cautions": [
        "Finger or wrist pain (for example trigger finger or carpal tunnel symptoms): skip it or use a very light dumbbell (clinical opinion).",
        "Keep the dumbbell low over the knees so a slip only drops it a short way; keep the feet clear.",
        "Wrist or elbow pain: use a lighter dumbbell and a shorter range; stop if pain persists (clinical opinion).",
        "Keep the forearm on the thigh so the elbow and shoulder stay out of it.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Forearms on a flat bench.",
        "One hand at a time."
      ],
      "regressions": [
        "Squeeze a soft ball or grip trainer.",
        "Lighter dumbbell, partial roll."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Barbell finger curl.",
        "Add a full wrist curl at the end of each rep."
      ]
    },
    "muscleNotes": {
      "forearm_flexors_r": "The finger flexors (flexor digitorum superficialis and profundus) roll the handle back up from the fingertips into the fist, then the wrist flexors finish with a small curl. Grip is strongest with the wrist extended about 35 degrees, and fell to about two-thirds to three-quarters at 15 degrees of extension (O'Driscoll 1992).",
      "forearm_flexors_l": "The finger flexors (flexor digitorum superficialis and profundus) roll the handle back up from the fingertips into the fist, then the wrist flexors finish with a small curl. Grip is strongest with the wrist extended about 35 degrees, and fell to about two-thirds to three-quarters at 15 degrees of extension (O'Driscoll 1992).",
      "forearm_extensors_r": "Hold the wrist slightly extended, the strong position for gripping (O'Driscoll 1992).",
      "forearm_extensors_l": "Hold the wrist slightly extended, the strong position for gripping (O'Driscoll 1992).",
      "biceps_r": "Holds the elbow bent while the forearm rests on the thigh (clinical opinion).",
      "biceps_l": "Holds the elbow bent while the forearm rests on the thigh (clinical opinion).",
      "core": "Holds the forward lean with a long back."
    }
  },
