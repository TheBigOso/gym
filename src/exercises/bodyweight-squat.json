  },
  "exercise": {
    "id": "bodyweight-squat",
    "name": "Bodyweight Squat",
    "aliases": [
      "Air squat",
      "Squat",
      "Free squat"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "119712",
      "title": "Bodyweight Squat (male)",
      "url": "https://gymvisual.com/videos/5104-bodyweight-squat-male.html",
      "listing": "Video; data sheet: body part Thighs, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Core"
    ],
    "equipment": [
      "Body weight"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip, knee and ankle)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "hamstrings_r",
        "hamstrings_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "core",
        "glute_med_r",
        "glute_med_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale on the way down, exhale as you stand. No breath hold is needed at body weight.",
      "cadence": "2 s down (inhale), short pause, about 1.2 s up (exhale)"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "tempo": "2-0-1-0: 2 s down, brief touch at the bottom, about 1 s up",
      "frequency": "2-3 times a week or as a warm-up",
      "progression": "More reps, a 3 s lowering, a pause at the bottom, then a goblet squat"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet about shoulder width, toes turned out slightly, arms reaching forward at shoulder height. Brace lightly."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, sit the hips back and down, knees travelling over the toes."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs about parallel, heels down, chest up."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and push the floor away through the whole foot to stand tall."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand fully, reset the brace, repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Heels lifting at the bottom",
        "fix": "Sit the hips back further and stop at a depth where the heels stay down."
      },
      {
        "id": "m2",
        "mistake": "Knees caving inside the toes",
        "fix": "Push the knees out over the 2nd-3rd toe; reduce depth until alignment holds."
      },
      {
        "id": "m3",
        "mistake": "Chest collapsing forward",
        "fix": "Keep the arms reaching forward and the eyes level; a more upright trunk keeps the load on the legs."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "37 cm (≈1.0x the rig's 37 cm shoulder width), toes out 15°",
        "peak": "Unchanged",
        "norm": "About shoulder width (Zawadka 2020 protocol)",
        "sources": [
          "gymvisual",
          "zawadka2020"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈2°",
        "peak": "≈112°",
        "norm": "About 100-120 degrees at thighs-parallel (clinical opinion); depth is driven mostly by knee range of motion (Zawadka 2020)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Hip flexion",
        "setup": "≈1°",
        "peak": "≈122° (joint channel, as in the HUD)",
        "norm": "Not specified for this depth",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈29° forward",
        "norm": "Moderate forward lean; more lean moves demand from knee to hip (Straub 2024)",
        "sources": [
          "straub2024"
        ]
      },
      {
        "measure": "Arms",
        "setup": "Reaching forward at shoulder height",
        "peak": "Unchanged",
        "norm": "Arms extended forward and parallel to the floor (Zawadka 2020 protocol)",
        "sources": [
          "zawadka2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2.0 s down, 0.4 s pause, 1.2 s up, 1.6 s reset",
        "norm": "2 s down, about 1 s up (common prescription; clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #119712, Bodyweight Squat (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/5104-bodyweight-squat-male.html"
      },
      {
        "id": "zawadka2020",
        "title": "Zawadka et al. 2020, How are squat timing and kinematics in the sagittal plane related to squat depth? (J Sports Sci Med 19:500-507)",
        "url": "https://www.jssm.org/jssm-19-500.xml-Fulltext"
      },
      {
        "id": "straub2024",
        "title": "Straub and Powers 2024, a biomechanical review of the squat exercise: implications for clinical practice (Int J Sports Phys Ther)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10987311/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knee pain: squat only to a pain-free depth.",
        "Hip pain: reduce depth or widen the stance slightly.",
        "Balance concerns: hold a counter or chair."
      ],
      "regressions": [
        "Squat to a chair or box.",
        "Shallower depth."
      ],
      "progressions": [
        "Slow 3 s lowering.",
        "Pause at the bottom.",
        "Goblet squat."
      ]
    },
    "muscleNotes": {
      "quads_r": "Main knee extensors: control the lowering and drive the stand. Knee range of motion was the strongest contributor to squat depth (Zawadka 2020).",
      "quads_l": "Main knee extensors: control the lowering and drive the stand. Knee range of motion was the strongest contributor to squat depth (Zawadka 2020).",
      "glute_max_r": "Hip extensor; works hardest standing up out of the bottom. A more forward trunk shifts demand from the knee to the hip (Straub 2024).",
      "glute_max_l": "Hip extensor; works hardest standing up out of the bottom. A more forward trunk shifts demand from the knee to the hip (Straub 2024).",
      "adductors_r": "Adductor magnus helps extend the hip from the bottom position.",
      "adductors_l": "Adductor magnus helps extend the hip from the bottom position.",
      "hamstrings_r": "Assist hip extension on the way up; co-contract with the quadriceps around the knee.",
      "hamstrings_l": "Assist hip extension on the way up; co-contract with the quadriceps around the knee.",
      "calves_r": "Soleus controls how far the shin travels forward over the foot.",
      "calves_l": "Soleus controls how far the shin travels forward over the foot.",
      "spinal_extensors_r": "Hold the trunk angle; demand rises as the trunk leans further forward (Straub 2024).",
      "spinal_extensors_l": "Hold the trunk angle; demand rises as the trunk leans further forward (Straub 2024).",
      "core": "Light brace keeps the ribs down and the trunk stiff; body weight does not call for a full breath hold (clinical opinion).",
      "glute_med_r": "Keeps the knee tracking over the toes.",
      "glute_med_l": "Keeps the knee tracking over the toes."
    }
  },
