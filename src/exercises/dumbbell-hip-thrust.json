      "Core"
    ],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "quads_r",
        "quads_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you drive the hips up, inhale as you lower.",
      "cadence": "About 1.2 s up, 0.8 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-15",
      "tempo": "1-1-2-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbell, a 2 s squeeze, then a barbell or single-leg hip thrust. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Upper back on the bench edge, feet flat about hip width, one dumbbell across the hip crease held at both ends."
      },
      {
        "id": "c2",
        "phase": "drive",
        "text": "Breathe out and drive through the heels to lift the hips."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Hips level with the shoulders and knees, shins vertical, chin tucked. Squeeze."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the hips toward the floor under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the dumbbell steady on the hips and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to get higher",
        "fix": "Stop when the trunk is level; ribs down, chin tucked."
      },
      {
        "id": "m2",
        "mistake": "Feet too far out or too close",
        "fix": "Place the feet so the shins are vertical at the top."
      },
      {
        "id": "m3",
        "mistake": "Dumbbell rolling toward the belly",
        "fix": "Hold it at both ends on the hip crease."
      },
      {
        "id": "m4",
        "mistake": "Back sliding along the bench",
        "fix": "Pivot on the shoulder blades; the bench edge stays under the same spot."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench height",
        "setup": "45 cm flat bench across the upper back",
        "peak": "Upper back pivots on the bench edge",
        "norm": "Knee-height bench, about 40-45 cm (common setup; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈82° at the bottom",
        "peak": "≈-11°",
        "norm": "Hip reaches neutral at the top, trunk level with the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈118° at the bottom",
        "peak": "≈90° (shins vertical), feet 26 cm apart",
        "norm": "About 90 degrees at the top (shins vertical) (common coaching); foot position changes muscle use (Collazo García 2020)",
        "sources": [
          "collazo2020"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈49° (hips below the shoulders)",
        "peak": "≈4° (level)",
        "norm": "Level at the top; the trunk pivots on the shoulder blades (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell",
        "setup": "Across the hip crease, both hands on the plates",
        "peak": "Rides on the hip crease (centred, ≤0.1 cm off the midline)",
        "norm": "Rests across the hip crease, held at both ends (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hips down 0.8 s",
        "peak": "1.2 s up, 0.8 s squeeze, 2.0 s down, 1.2 s reset",
        "norm": "About 1 s up, a short pause, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #474212, Dumbbell Hip Thrust, video (movement reference)",
        "url": "https://gymvisual.com/videos/14493-dumbbell-hip-thrust.html"
      },
      {
        "id": "contreras2015",
        "title": "Contreras, Vigotsky, Schoenfeld, Beardsley & Cronin 2015, a comparison of gluteus maximus, biceps femoris and vastus lateralis EMG in the back squat and barbell hip thrust (J Appl Biomech 31(6):452-458)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26214739/"
      },
      {
        "id": "neto2020",
        "title": "Krause Neto, Soares, Vieira et al. 2020, gluteus maximus activation during common strength and hypertrophy exercises: a systematic review (J Sports Sci Med 19(1):195-203)",
        "url": "https://www.jssm.org/jssm-19-195.xml-abst"
      },
      {
        "id": "collazo2020",
        "title": "Collazo García, Rueda, Suárez Luginick & Navarro 2020, differences in the electromyographic activity of lower-body muscles in hip thrust variations (J Strength Cond Res 34(9):2449-2455)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/30335717/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Set the bench against a wall so it cannot slide.",
        "Pad the dumbbell with a towel if it presses on the hip bones."
      ],
      "modify": [
        "Low back discomfort: lift less high and brace first.",
        "Neck discomfort: keep the chin tucked and the head moving with the trunk."
      ],
      "regressions": [
        "Bodyweight hip thrust.",
        "Glute bridge on the floor."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "2 s squeeze at the top.",
        "Single-leg or barbell hip thrust."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor. The barbell hip thrust gave about twice the mean upper and lower gluteus maximus EMG of the back squat (69.5% vs 29.4% and 86.8% vs 45.4% MVIC; Contreras 2015). Hip thrust variations were among the highest gluteus maximus exercises in a systematic review (Krause Neto 2020).",
      "glute_max_l": "Main hip extensor. The barbell hip thrust gave about twice the mean upper and lower gluteus maximus EMG of the back squat (69.5% vs 29.4% and 86.8% vs 45.4% MVIC; Contreras 2015). Hip thrust variations were among the highest gluteus maximus exercises in a systematic review (Krause Neto 2020).",
      "hamstrings_r": "Assist hip extension; biceps femoris EMG was higher in the hip thrust than in the back squat (40.8% vs 14.9% MVIC; Contreras 2015). Moving the feet farther out changes the pattern (Collazo García 2020).",
      "hamstrings_l": "Assist hip extension; biceps femoris EMG was higher in the hip thrust than in the back squat (40.8% vs 14.9% MVIC; Contreras 2015). Moving the feet farther out changes the pattern (Collazo García 2020).",
      "quads_r": "Hold the knees at about 90 degrees and press the feet into the floor; vastus lateralis EMG was similar to the back squat (Contreras 2015).",
      "quads_l": "Hold the knees at about 90 degrees and press the feet into the floor; vastus lateralis EMG was similar to the back squat (Contreras 2015).",
      "adductors_r": "Adductor magnus assists hip extension and keeps the knees in line (clinical opinion).",
      "adductors_l": "Adductor magnus assists hip extension and keeps the knees in line (clinical opinion).",
      "glute_med_r": "Keeps the knees from caving in (clinical opinion); its activity did not change across hip thrust variations (Collazo García 2020).",
      "glute_med_l": "Keeps the knees from caving in (clinical opinion); its activity did not change across hip thrust variations (Collazo García 2020).",
      "core": "Holds the ribs down so the lift comes from the hips, not the low back.",
      "spinal_extensors_r": "Hold the trunk straight; they should not take over by arching (clinical opinion).",
      "spinal_extensors_l": "Hold the trunk straight; they should not take over by arching (clinical opinion)."
    }
  },
