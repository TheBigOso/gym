      "serratus_r": "Upward rotation of the shoulder blades overhead (clinical opinion).",
      "serratus_l": "Upward rotation of the shoulder blades overhead (clinical opinion).",
      "calves_r": "Finish the leg drive onto the balls of the feet briefly (clinical opinion).",
      "calves_l": "Finish the leg drive onto the balls of the feet briefly (clinical opinion).",
      "core": "Keeps the trunk rigid in the dip and stops the low back arching overhead (clinical opinion).",
      "spinal_extensors_r": "Hold the upright trunk under the racked bells (clinical opinion).",
      "spinal_extensors_l": "Hold the upright trunk under the racked bells (clinical opinion).",
