    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the shoulder, numbness or tingling occurs.",
        "The kettlebell load is user-chosen: pick bells you can lock out with control.",
        "Fast lift: clear the space around you; if a bell gets away, step away from it.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort overhead: press only to the top of the head and keep the palms facing in.",
        "Low-back discomfort: lighter bells and a firmer glute squeeze at the lockout."
      ],
      "regressions": [
        "Single kettlebell push press.",
        "Double kettlebell strict press."
      ],
      "progressions": [
        "Heavier bells.",
        "Double kettlebell jerk.",
        "Pause 2 s at lockout."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover of the press; standing presses gave higher deltoid activity than seated presses (Saeterbakken 2013).",
      "ant_deltoid_l": "Main mover of the press; standing presses gave higher deltoid activity than seated presses (Saeterbakken 2013).",
      "lat_deltoid_r": "Raises the upper arms as the elbows move out past the face (clinical opinion).",
      "lat_deltoid_l": "Raises the upper arms as the elbows move out past the face (clinical opinion).",
      "triceps_r": "Finish the lockout (clinical opinion).",
      "triceps_l": "Finish the lockout (clinical opinion).",
      "quads_r": "Drive the bells off the shoulders from the dip (clinical opinion).",
      "quads_l": "Drive the bells off the shoulders from the dip (clinical opinion).",
      "glute_max_r": "Hip extension in the drive and a tight lockout (clinical opinion).",
      "glute_max_l": "Hip extension in the drive and a tight lockout (clinical opinion).",
      "upper_traps_r": "Upward rotation of the shoulder blades overhead (clinical opinion).",
