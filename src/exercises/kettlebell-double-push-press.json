    "breathing": {
      "pattern": "Breathe in and brace in the rack, keep the brace through the dip and drive, breathe out at the lockout, breathe in as the bells come down.",
      "cadence": "About 0.4 s dip, 0.55 s drive and press, 1.25 s back to the rack"
    },
    "prescription": {
      "sets": "3-5",
      "reps": "3-8",
      "tempo": "Quick dip, explosive drive, controlled lowering",
      "rest": "90-180 s",
      "frequency": "1-2 times a week",
      "load": "User-chosen pair of kettlebells; heavier than you can strict press, light enough that the dip stays short and upright",
      "progression": "Add reps, then heavier bells; then double jerk"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Feet about hip width, both kettlebells racked: fists in front of the shoulders, elbows down against the ribs, wrists straight."
      },
      {
        "id": "c2",
        "phase": "dip",
        "text": "Brace and dip quickly a few centimetres by bending the knees; trunk stays upright, heels down."
      },
      {
        "id": "c3",
        "phase": "drive",
        "text": "Drive hard through the legs and let the bells pop off the shoulders; finish the press with the arms."
      },
      {
        "id": "c4",
        "phase": "lockout",
        "text": "Lock out overhead, biceps by the ears, ribs down, glutes tight."
      },
      {
        "id": "c5",
        "phase": "lower",
        "text": "Bring the bells back to the rack under control, absorbing them with soft knees."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Re-brace in the rack and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dipping too deep or leaning forward in the dip",
        "fix": "Short, quick knee bend with the trunk vertical; the bells stay on the shoulders."
      },
      {
        "id": "m2",
        "mistake": "Pressing before the legs finish",
        "fix": "Let the leg drive launch the bells, then press."
      },
      {
        "id": "m3",
        "mistake": "Arching the low back at the lockout",
        "fix": "Squeeze the glutes and keep the ribs down."
      },
      {
        "id": "m4",
        "mistake": "Elbows flaring in the rack",
        "fix": "Keep the elbows tucked against the ribs so the forearms are vertical."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "30 cm, toes out 10°",
        "peak": "Unchanged",
        "norm": "About hip width (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dip",
        "setup": "Knees ≈5°",
        "peak": "Knees ≈26°, pelvis 2.1 cm lower, trunk ≈5° from vertical",
        "norm": "A short, quick knee bend with an upright trunk; the push press dip is far shallower than a squat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Rack",
        "setup": "Fists in front of the shoulders, elbows ≈141° bent, upper arms ≈19° from vertical",
        "peak": "Bells return here after each rep",
        "norm": "Kettlebells resting on the forearms in front of the shoulders, elbows down (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Shoulder elevation at lockout",
        "setup": "≈19° in the rack",
        "peak": "≈174° at lockout, elbows ≈12° from straight",
        "norm": "Arms fully extended overhead, the load stacked over the hips and ankles (CrossFit 2019, thruster lockout)",
        "sources": [
          "crossfit2019"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Rack 0.6 s",
        "peak": "0.4 s dip, 0.6 s drive and press, 0.4 s lockout, 1.3 s back to the rack",
        "norm": "Fast dip and drive, controlled lowering (clinical opinion); standing presses gave higher deltoid activity than seated ones (Saeterbakken 2013)",
        "sources": [
          "saeterbakken2013"
        ]
      }
    ],
    "sources": [
