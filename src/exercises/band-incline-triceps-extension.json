    },
    "breathing": {
      "pattern": "Inhale as the band draws the hands back beside the head, exhale as you straighten the arms.",
      "cadence": "About 2.2 s down, 0.3 s pause, 1.4 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "tempo": "2-0-1-1",
      "frequency": "1-2 times a week",
      "load": "Band tension is user-chosen (bands are colour-coded by tension): pick one you can move for the target reps with 1-3 reps in reserve; stand or sit farther from the anchor, or choke up on the band, for more tension.",
      "progression": "More reps, a slower return, more distance from the anchor (more stretch), then the next band up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set a rack (or two sturdy uprights) just behind the top of the bench and loop a band around each upright at about head height. Back pad at 30 degrees; glutes in the crease, upper back and head on the pad, feet planted; a handle in each hand, arms straight up, palms facing each other."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and bend only the elbows, letting the band draw the hands back beside the head; upper arms still."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Elbows a little past 90 degrees, hands beside the head; keep the band taut."
      },
      {
        "id": "c4",
        "phase": "extend",
        "text": "Breathe out and straighten the elbows against the band without moving the upper arms."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Squeeze the triceps with the arms straight, then lower again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arms drifting back and forth (turning it into a pullover)",
        "fix": "Keep the elbows pointing up; only the forearms move."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows about shoulder width."
      },
      {
        "id": "m3",
        "mistake": "Letting the band snap the hands back toward the head",
        "fix": "Lower for about 2 s and keep the hands beside, not over, the head."
      },
      {
        "id": "m4",
        "mistake": "Hips lifting off the seat",
        "fix": "Keep the glutes in the crease and the feet planted."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench angle",
        "setup": "30° back pad, flat seat",
        "peak": "Glutes in the crease and upper back on the pad (rig shapes), back of the head just off it with a neutral neck",
        "norm": "Back pad at 30 degrees (30-45 is common; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (straight, not locked)",
        "peak": "≈98° at the bottom",
        "norm": "From straight to a little past 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm angle",
        "setup": "15° forward of vertical (hands clear the pad): ≈98° of shoulder flexion relative to the trunk",
        "peak": "Unchanged: shoulder channels constant (max 0.0° drift)",
        "norm": "Upper arms about vertical over the shoulders and still; on a 30-degree incline that is roughly 100-120 degrees of shoulder flexion relative to the trunk, more than on a flat bench (clinical opinion; long-length triceps training: Maeo and Kanehisa)",
        "sources": [
          "maeo_desc"
        ]
      },
      {
        "measure": "Band",
        "setup": "Looped around the rack uprights 100 cm up, 85 cm behind the hinge, 80 cm apart",
        "peak": "Strands 33.3-72.8 cm (longest with the arms straight), at least 8.2 cm from the body; hands at least 4.2 cm from the head",
        "norm": "Anchored behind the bench at about head height so it pulls the hands back; the hands stay beside the head, clear of it (clinical opinion). Elastic resistance can reach muscle activity comparable to free weights (Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.2 s down, 0.3 s pause, 1.4 s up, 0.5 s at the top",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
