    "safety": {
      "cautions": [
        "Check the band for nicks or tears before every session and replace a worn band; a band that snaps can hit the face or eyes.",
        "Anchor the band to something that cannot move or slip (a rack upright, a heavy bench frame or under the feet) and make sure it is secure before loading it.",
        "Band tension rises as it stretches, so the load is lightest at the start and heaviest at the end of the push; let it return under control rather than snapping back.",
        "Lower beside the head, never toward the face.",
        "Elbow pain: shorten the range and use a lighter band (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort overhead: lower the bench toward flat.",
        "Elbow discomfort: lighter band, shorter range."
      ],
      "regressions": [
        "Lighter band.",
        "Band triceps pushdown."
      ],
      "progressions": [
        "Stronger band or the bench moved farther from the rack.",
        "Slower lowering with a pause in the stretch.",
        "Incline dumbbell triceps extension."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Only mover: straightens the elbow while the upper arm stays still. All three heads work; the long head is stretched more the higher the arm is raised: 12 weeks of extensions with the shoulder at 180 degrees grew the long head about 33% vs 21% with the arm at the side (Maeo and Kanehisa). On the incline the upper arms are raised further overhead than on a flat bench, so the long head works at a longer length (clinical opinion).",
      "triceps_l": "Only mover: straightens the elbow while the upper arm stays still. All three heads work; the long head is stretched more the higher the arm is raised: 12 weeks of extensions with the shoulder at 180 degrees grew the long head about 33% vs 21% with the arm at the side (Maeo and Kanehisa). On the incline the upper arms are raised further overhead than on a flat bench, so the long head works at a longer length (clinical opinion).",
      "forearm_flexors_r": "Grip the band handle.",
      "forearm_flexors_l": "Grip the band handle.",
      "ant_deltoid_r": "Holds the upper arm still against the band.",
      "ant_deltoid_l": "Holds the upper arm still against the band.",
      "post_deltoid_r": "Holds the upper arm still as the band draws the hand behind the elbow.",
      "post_deltoid_l": "Holds the upper arm still as the band draws the hand behind the elbow.",
      "rhomboids_midtrap_r": "Keep the shoulder blades set on the pad.",
      "rhomboids_midtrap_l": "Keep the shoulder blades set on the pad.",
      "core": "Keeps the trunk still on the bench."
    }
  },
