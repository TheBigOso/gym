  "exercise": {
    "id": "lateral-step-up",
    "name": "Lateral Step-up",
    "aliases": [
      "Side step-up",
      "Lateral box step-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "515412",
      "title": "Lateral Step-up",
      "url": "https://gymvisual.com/videos/11876-lateral-step-up.html",
      "listing": "Video; data sheet: body part Thighs, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Thighs (quadriceps)",
    "secondaryBodyParts": [
      "Hips (glutes)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Box (about 30 cm)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip, knee and ankle)",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "quads_r",
        "quads_l",
        "glute_max_r",
        "glute_max_l",
        "glute_med_r",
        "glute_med_l"
      ],
      "synergist": [
        "adductors_r",
        "adductors_l",
        "calves_r",
        "calves_l"
      ],
      "stabilizer": [
        "core",
        "obliques_r",
        "obliques_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you push up, inhale as you lower slowly.",
      "cadence": "About 1.2 s up, short hold, about 2 s down"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "10-15",
      "tempo": "Up in about 1 s, down in about 2 s",
      "frequency": "2-3 times a week",
      "progression": "Higher box, then hold dumbbells"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand side-on to the box with the right foot flat on top, hands on hips."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Breathe out and push down through the right heel to straighten the leg; the left foot lifts beside the box."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Stand tall on the right leg, pelvis level, left foot hovering."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the left heel just taps the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Tap, do not rest; go straight into the next rep. Switch legs after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pushing off the floor foot",
        "fix": "Keep the floor foot light; lift it as soon as the box leg starts to push."
      },
      {
        "id": "m2",
        "mistake": "Hip dropping on the free side",
        "fix": "Keep the pelvis level; squeeze the side of the box-leg hip."
      },
      {
        "id": "m3",
        "mistake": "Box knee caving inward",
        "fix": "Keep the knee over the 2nd-3rd toe."
      },
      {
        "id": "m4",
        "mistake": "Dropping down fast",
        "fix": "Take about 2 s to lower."
      }
    ],
    "kinematics": [
      {
        "measure": "Box height",
        "setup": "30 cm, right foot 24 cm from the left (ankle centres)",
        "peak": "Right foot stays planted",
        "norm": "15-40 cm in studies: 15 cm (MacAskill 2014), 20 cm (Worrell 1998), 40 cm (Muyor 2020)",
        "sources": [
          "macaskill2014",
          "worrell1998",
          "muyor2020"
        ]
      },
      {
        "measure": "Box-leg knee flexion",
        "setup": "≈97°",
        "peak": "≈5°",
        "norm": "Bent at the start, fully straight at the top (Muyor 2020; MacAskill 2014)",
        "sources": [
          "muyor2020",
          "macaskill2014"
        ]
      },
      {
        "measure": "Pelvis",
        "setup": "5 cm right of the midline, 89.8 cm high",
        "peak": "16.5 cm right of the midline (over the box foot), 119.3 cm high",
        "norm": "Level, shifting sideways over the box foot (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈9°",
        "peak": "≈2°",
        "norm": "Upright to slightly forward (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hold 0.8 s",
        "peak": "1.2 s up, 0.5 s hold, 2.0 s down, heel tap and 1.0 s reset",
        "norm": "Metronome-paced, about 2 s up and 2 s down in Muyor 2020",
        "sources": [
          "muyor2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #515412, Lateral Step-up, video (movement reference)",
        "url": "https://gymvisual.com/videos/11876-lateral-step-up.html"
      },
      {
        "id": "worrell1998",
        "title": "Worrell, Crisp & LaRosa 1998, electromyographic reliability and analysis of selected lower extremity muscles during lateral step-up conditions (J Athl Train 33(2):156-162; PMC1320404)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC1320404/"
      },
      {
        "id": "macaskill2014",
        "title": "MacAskill, Durant & Wallace 2014, gluteal muscle activity during weightbearing and non-weightbearing exercise (Int J Sports Phys Ther 9(7):907-914; PMC4275195)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4275195/"
      },
      {
        "id": "muyor2020",
        "title": "Muyor, Martín-Fuentes, Rodríguez-Ridao & Antequera-Vique 2020, EMG activity of gluteus medius, gluteus maximus, biceps femoris and the vasti during the monopodal squat, forward lunge and lateral step-up (PLoS ONE 15(4):e0230841)",
        "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0230841"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a stable box that cannot slide or tip."
      ],
      "modify": [
        "Knee pain: use a lower box (10-20 cm).",
        "Balance concerns: hold a wall or rail with one hand."
      ],
      "regressions": [
        "Lower box.",
        "Hold a support."
      ],
      "progressions": [
        "Higher box.",
        "Hold dumbbells.",
        "Lateral step-down (eccentric focus)."
      ]
    },
    "muscleNotes": {
      "quads_r": "Box-leg knee extensors do most of the work: vastus medialis and lateralis were more active than the hamstrings and gluteus maximus (Worrell 1998) and were the most active muscles in Muyor 2020.",
      "quads_l": "Box-leg knee extensors do most of the work: vastus medialis and lateralis were more active than the hamstrings and gluteus maximus (Worrell 1998) and were the most active muscles in Muyor 2020.",
      "glute_max_r": "Box-leg hip extensor; activity was about 31% MVIC in an unloaded lateral step-up on a 6-inch step (MacAskill 2014).",
      "glute_max_l": "Box-leg hip extensor; activity was about 31% MVIC in an unloaded lateral step-up on a 6-inch step (MacAskill 2014).",
      "glute_med_r": "Holds the pelvis level as the body moves sideways over the box foot; about 61% MVIC in an unloaded lateral step-up (MacAskill 2014).",
      "glute_med_l": "Holds the pelvis level as the body moves sideways over the box foot; about 61% MVIC in an unloaded lateral step-up (MacAskill 2014).",
      "adductors_r": "Steady the thigh and assist the hip as it straightens.",
      "adductors_l": "Steady the thigh and assist the hip as it straightens.",
      "calves_r": "Steady the box-leg shin; the floor foot gives only a light push.",
      "calves_l": "Steady the box-leg shin; the floor foot gives only a light push.",
      "core": "Keeps the trunk tall over the box foot.",
      "obliques_r": "Resist side-bending toward the free leg.",
      "obliques_l": "Resist side-bending toward the free leg."
    }
  },
