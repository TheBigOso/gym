    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Kneel on a mat or folded towel to protect the down knee.",
        "The EMG studies used seated and standing presses; no study of the half-kneeling press itself was found."
      ],
      "modify": [
        "Knee discomfort: put a pad under the down knee, or do the press standing.",
        "Shoulder pain overhead: press with the palm facing in (neutral grip) and stop short of full overhead."
      ],
      "regressions": [
        "Lighter dumbbell.",
        "Tall-kneeling (both knees down) or seated single-arm press.",
        "Half-kneeling landmine press."
      ],
      "progressions": [
        "Standing single-arm dumbbell press.",
        "Bottoms-up kettlebell press.",
        "Slower lowering (3 s)."
      ]
    },
    "muscleNotes": {
      "ant_deltoid_r": "Main mover of the press; dumbbell presses gave higher anterior deltoid activity than barbell presses (Saeterbakken 2013).",
      "ant_deltoid_l": "Main mover of the press; dumbbell presses gave higher anterior deltoid activity than barbell presses (Saeterbakken 2013).",
      "lat_deltoid_r": "Lifts the upper arm out and up; works hard through the press.",
      "lat_deltoid_l": "Lifts the upper arm out and up; works hard through the press.",
      "triceps_r": "Straightens the elbow in the top half.",
      "triceps_l": "Straightens the elbow in the top half.",
      "upper_traps_r": "Upward rotation and elevation of the shoulder blade overhead.",
      "upper_traps_l": "Upward rotation and elevation of the shoulder blade overhead.",
      "serratus_r": "Upward rotation of the shoulder blade so the arm can reach overhead.",
      "serratus_l": "Upward rotation of the shoulder blade so the arm can reach overhead.",
      "obliques_r": "Stop the trunk side-bending away from the one-sided load. A unilateral press gave much higher external oblique activity than a bilateral press (Saeterbakken 2012).",
      "obliques_l": "Stop the trunk side-bending away from the one-sided load. A unilateral press gave much higher external oblique activity than a bilateral press (Saeterbakken 2012).",
      "core": "Braces the trunk; the half-kneeling stance takes away help from the legs, so the trunk works more (clinical opinion).",
      "glute_max_r": "The glute of the down leg squeezes to keep the hip extended and the pelvis level (clinical opinion).",
      "glute_max_l": "The glute of the down leg squeezes to keep the hip extended and the pelvis level (clinical opinion).",
      "spinal_extensors_r": "Keep the trunk tall; a unilateral press activated the back stabilizers more than a bilateral press (Trunk 2005; Saeterbakken 2012).",
      "spinal_extensors_l": "Keep the trunk tall; a unilateral press activated the back stabilizers more than a bilateral press (Trunk 2005; Saeterbakken 2012).",
      "infraspinatus_r": "Rotator cuff: centres the ball of the shoulder as the arm rises.",
      "infraspinatus_l": "Rotator cuff: centres the ball of the shoulder as the arm rises."
    }
  },
