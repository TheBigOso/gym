  "exercise": {
    "id": "band-back-extension",
    "name": "Band Back Extension",
    "aliases": [
      "Standing band back extension",
      "Band good morning extension",
      "Banded standing hip hinge"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "2366",
      "title": "Band back extension",
      "url": "https://gymvisual.com/animated-gifs/2366-band-back-extension.html",
      "listing": "Animated GIF (movement reference; the page could not be fetched from the authoring environment, so the data sheet was not read; authored as a standing back extension: band under the feet, held at the front of the shoulders, hinge and stand tall)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Back (lower back, erector spinae)",
    "secondaryBodyParts": [
      "Hamstrings",
      "Hips (glutes)"
    ],
    "equipment": [
      "Resistance band (two, or one long band under both feet)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip hinge with trunk extension)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "hamstrings_r",
        "hamstrings_l"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "core",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "biceps_r",
        "biceps_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "hamstrings_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in and brace as you hinge forward, breathe out as you extend back up to standing.",
      "cadence": "About 2 s down, 1.3 s up"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-20",
      "effort": "Stop 2-3 reps short of failure or when the back starts to round (clinical opinion)",
      "tempo": "2-0.3-1.3-1 (down-pause-up-reset, seconds)",
      "rest": "45-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen: shorter band or a stronger band for more tension",
      "progression": "Stronger band, longer pause at the bottom, then a dumbbell good morning or a 45-degree back extension"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the band with both feet hip width, knees soft. Hold the band ends at the front of the shoulders, elbows down, chest tall."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, push the hips back and tip the trunk forward with a long back; the band slackens a little."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Stop when the hamstrings are stretched, trunk well inclined, back still long."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and extend back up against the band, hips forward, until you stand tall."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, ribs down, then hinge again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the low back to go lower",
        "fix": "Stop the hinge where the back stays long."
      },
      {
        "id": "m2",
        "mistake": "Squatting instead of hinging",
        "fix": "Hips back, knees only soft, shins nearly vertical."
      },
      {
        "id": "m3",
        "mistake": "Over-arching at the top",
        "fix": "Finish tall with the ribs down and the glutes squeezed."
      },
      {
        "id": "m4",
        "mistake": "Hands drifting away from the shoulders",
        "fix": "Keep the hands fixed at the shoulders; the trunk does the work."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈2°",
        "peak": "≈89° (joint channel), trunk ≈23° above horizontal",
        "norm": "Hinge to a hamstring stretch, as in the good morning (Vigotsky 2015 measured hip and trunk angles in the good morning)",
        "sources": [
          "vigotsky2015"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈5°",
        "peak": "≈18°",
        "norm": "Soft knees, about 10-20 degrees (clinical opinion; Vigotsky 2015)",
        "sources": [
          "vigotsky2015"
        ]
      },
      {
        "measure": "Lumbar motion",
        "setup": "Neutral",
        "peak": "Spine channels 2°/5°/5° (L5/T12/T6): slight rounding at the bottom",
        "norm": "Close to neutral; a little rounding near the bottom is common, keep it small (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hands",
        "setup": "At the front of the shoulders, 130 cm high; a band strand rises from under the ball of each foot",
        "peak": "Unchanged relative to the shoulders",
        "norm": "Fixed at the front of the shoulders (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "2 s down, 0.3 s pause, 1.3 s up, 1 s reset",
        "norm": "Slow, controlled hinge (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
