    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Check the bands before each set and keep them centred under the feet: a band that slips can snap up toward the face.",
        "Keep the back long; stop the hinge before the low back rounds.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low back discomfort: shorter range and more knee bend.",
        "Hamstring tightness: hinge only as far as the back stays long."
      ],
      "regressions": [
        "No band (bodyweight hip hinge).",
        "Shorter range.",
        "Lighter band."
      ],
      "progressions": [
        "Stronger band.",
        "Pause 2 s at the bottom.",
        "Dumbbell good morning or 45-degree back extension."
      ]
    },
    "muscleNotes": {
      "spinal_extensors_r": "Prime mover: extend the trunk back to standing and hold the back long through the hinge. In the good morning the erector spinae worked through the range (Vigotsky 2015); the band loads the top more than the bottom (clinical opinion).",
      "spinal_extensors_l": "Prime mover: extend the trunk back to standing (Vigotsky 2015).",
      "hamstrings_r": "Extend the hip and lengthen at the bottom of the hinge; hinge exercises load the hamstrings (McAllister 2014; Vigotsky 2015).",
      "hamstrings_l": "Extend the hip and lengthen at the bottom of the hinge (McAllister 2014; Vigotsky 2015).",
      "glute_max_r": "Extend the hip, mostly near the top (clinical opinion).",
      "glute_max_l": "Extend the hip, mostly near the top (clinical opinion).",
      "adductors_r": "Adductor magnus helps extend the hip (clinical opinion).",
      "adductors_l": "Adductor magnus helps extend the hip (clinical opinion).",
      "core": "Brace so the ribs stay down at the top (clinical opinion).",
      "ant_deltoid_r": "Hold the hands at the shoulders (clinical opinion).",
      "ant_deltoid_l": "Hold the hands at the shoulders (clinical opinion).",
      "biceps_r": "Hold the elbows bent against the band (clinical opinion).",
      "biceps_l": "Hold the elbows bent against the band (clinical opinion).",
      "forearm_flexors_r": "Grip the band (clinical opinion).",
      "forearm_flexors_l": "Grip the band (clinical opinion)."
    }
