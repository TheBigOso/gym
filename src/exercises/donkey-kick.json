  "exercise": {
    "id": "donkey-kick",
    "name": "Donkey Kick",
    "aliases": [
      "Quadruped hip extension (knee bent)",
      "Bent-leg kickback",
      "Kneeling glute kickback"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "303412",
      "title": "Bent Leg Kickback (kneeling) (male)",
      "url": "https://gymvisual.com/videos/12533-bent-leg-kickback-kneeling-male.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (hamstrings)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip extension with the knee bent)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r"
      ],
      "synergist": [
        "hamstrings_r"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "serratus_r",
        "serratus_l",
        "triceps_r",
        "triceps_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the foot presses up, inhale as the knee returns.",
      "cadence": "About 1.2 s up, 0.6 s hold, 1.6 s down"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "12-20",
      "tempo": "1-1-1.5-0",
      "frequency": "2-4 times a week",
      "progression": "Pause at the top, then an ankle weight or a dumbbell behind the knee, then a band"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "On all fours: hands under the shoulders, knees under the hips, back flat, neck long."
      },
      {
        "id": "c2",
        "phase": "kick",
        "text": "Breathe out and press the right sole toward the ceiling, knee bent 90 degrees, until the thigh is level."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the glute; hips square to the floor, no low back arch."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and bring the knee back under the hip with control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Knee just touches the mat; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to lift higher",
        "fix": "Stop when the thigh is level; brace the abdomen."
      },
      {
        "id": "m2",
        "mistake": "Hips rotating open toward the working leg",
        "fix": "Keep both hip bones facing the floor."
      },
      {
        "id": "m3",
        "mistake": "Knee straightening into a kick",
        "fix": "Keep the knee at about 90 degrees; the sole goes up, not back."
      },
      {
        "id": "m4",
        "mistake": "Swinging fast",
        "fix": "Lift in about a second, squeeze, lower slower."
      }
    ],
    "kinematics": [
      {
        "measure": "Hands and knees",
        "setup": "Hands under the shoulders, knees under the hips (hip 74°, knee 90°)",
        "peak": "Hands and the left knee stay planted",
        "norm": "Hands under the shoulders, knees under the hips (standard quadruped position; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip extension",
        "setup": "Hip 74° flexion (thigh vertical)",
        "peak": "Hip -17° (thigh 1° from level)",
        "norm": "Thigh lifts to about level with the trunk without lumbar extension (clinical opinion); Selkowitz 2013 used quadruped hip extension with the knee flexed",
        "sources": [
          "selkowitz2013"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈90°",
        "peak": "≈92° (sole toward the ceiling)",
        "norm": "About 90 degrees throughout (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and trunk",
        "setup": "Trunk 74° from vertical, neutral spine",
        "peak": "Unchanged (pelvis fixed, no rotation or arch)",
        "norm": "Pelvis level and square; no rotation or arching (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.8 s on all fours",
        "peak": "1.2 s up, 0.6 s squeeze, 1.6 s down",
        "norm": "Controlled, about 1 s up and 1.5-2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #303412, Bent Leg Kickback (kneeling) (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/12533-bent-leg-kickback-kneeling-male.html"
      },
      {
        "id": "selkowitz2013",
        "title": "Selkowitz, Beneck & Powers 2013, which exercises target the gluteal muscles while minimizing activation of the tensor fascia lata? Fine-wire EMG of 11 exercises (J Orthop Sports Phys Ther 43(2):54-64)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23160432/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a mat or folded towel under the knees."
      ],
      "modify": [
        "Wrist discomfort: fists or forearms on the mat.",
        "Low back discomfort: lift less high and brace first."
      ],
      "regressions": [
        "Smaller lift.",
        "Glute bridge."
      ],
      "progressions": [
        "Pause at the top.",
        "Ankle weight or a dumbbell held behind the knee.",
        "Band around the feet."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor. Quadruped hip extension with the knee flexed reached about 30% MVIC in the superior gluteus maximus and gluteus medius with low TFL (Selkowitz 2013); Boren 2011 measured about 60% MVIC gluteus maximus on the dominant leg.",
      "hamstrings_r": "Assist hip extension; the bent knee keeps them short so the glute does more (clinical opinion).",
      "glute_med_r": "Working-side fibres assist; support-side fibres keep the pelvis level (Selkowitz 2013 measured about 31% MVIC gluteus medius).",
      "glute_med_l": "Working-side fibres assist; support-side fibres keep the pelvis level (Selkowitz 2013 measured about 31% MVIC gluteus medius).",
      "core": "Stops the low back arching and the pelvis rotating as the leg rises (clinical opinion).",
      "spinal_extensors_r": "Hold a flat back; they should not take over (clinical opinion).",
      "spinal_extensors_l": "Hold a flat back; they should not take over (clinical opinion).",
      "serratus_r": "Keeps the shoulder blades flat on the support arms (clinical opinion).",
      "serratus_l": "Keeps the shoulder blades flat on the support arms (clinical opinion).",
      "triceps_r": "Keep the support elbows straight (clinical opinion).",
      "triceps_l": "Keep the support elbows straight (clinical opinion)."
    }
  },
