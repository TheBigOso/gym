  },
  "exercise": {
    "id": "medicine-ball-crunch",
    "name": "Medicine Ball Crunch",
    "aliases": [
      "Crunch with medicine ball",
      "Straight-arm medicine ball crunch"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "25783",
      "title": "Medicine Ball Crunch",
      "url": "https://gymvisual.com/videos/25783-medicine-ball-crunch.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (rectus abdominis)",
    "secondaryBodyParts": [
      "Obliques"
    ],
    "equipment": [
      "Medicine ball",
      "Mat"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (trunk flexion)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "serratus_r",
        "serratus_l",
        "triceps_r",
        "triceps_l"
      ],
      "lengthened": [
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower.",
      "cadence": "About 1 s up, 0.5 s squeeze, 1.6 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Heavier ball, or hold the ball overhead"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent, feet flat; hold the ball in both hands with the arms straight over the chest."
      },
      {
        "id": "c2",
        "phase": "up",
        "text": "Breathe out and curl the head and shoulders up, pressing the ball toward the ceiling."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the abs; low back stays on the mat."
      },
      {
        "id": "c4",
        "phase": "down",
        "text": "Breathe in and lower the shoulder blades, then the head."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Rest briefly with the arms still up; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the ball forward to sit up",
        "fix": "Keep the arms vertical to the trunk; the abs lift you."
      },
      {
        "id": "m2",
        "mistake": "Lifting the low back",
        "fix": "Curl only until the shoulder blades clear the mat."
      },
      {
        "id": "m3",
        "mistake": "Tucking the chin hard",
        "fix": "Keep a fist of space between chin and chest."
      },
      {
        "id": "m4",
        "mistake": "Bending the elbows",
        "fix": "Arms long and locked."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk",
        "setup": "≈0°",
        "peak": "≈31° (C7 up 17.2 cm)",
        "norm": "About 25-45 degrees off the mat (clinical opinion); crunches excite the rectus abdominis (Escamilla 2006)",
        "sources": [
          "escamilla2006"
        ]
      },
      {
        "measure": "Lumbar",
        "setup": "On the mat",
        "peak": "Low back 0.5 cm off the mat at most",
        "norm": "Low back stays on the mat (Escamilla 2006)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Elbows ≈35°, hands 27 cm apart on the ball",
        "peak": "Ball rises 6.2 cm with the trunk",
        "norm": "Straight, perpendicular to the trunk, holding the ball (standard technique)",
        "sources": []
      },
      {
        "measure": "Hips and knees",
        "setup": "Hip ≈47°, knee ≈90°",
        "peak": "Unchanged",
        "norm": "Feet flat, knees about 90 degrees (standard setup)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.0 s up, 0.5 s squeeze, 1.6 s down, 1.1 s rest",
        "norm": "Controlled, slower down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #25783, Medicine Ball Crunch, video (movement reference)",
        "url": "https://gymvisual.com/videos/25783-medicine-ball-crunch.html"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises (Phys Ther 86(5):656-671)",
        "url": "https://scholars.csus.edu/esploro/outputs/journalArticle/Electromyographic-Analysis-of-Traditional-and-Nontraditional/99257847129401671"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Hold the ball securely so it cannot fall on the face."
      ],
      "modify": [
        "Neck strain: lighter ball, smaller curl."
      ],
      "regressions": [
        "Floor crunch."
      ],
      "progressions": [
        "Heavier ball.",
        "Medicine ball held overhead."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis curls the trunk (Escamilla 2006); the ball held over the chest adds a little load.",
      "obliques_r": "Assist trunk flexion (Escamilla 2006).",
      "obliques_l": "Assist trunk flexion (Escamilla 2006).",
      "ant_deltoid_r": "Hold the arms up (clinical opinion).",
      "ant_deltoid_l": "Hold the arms up (clinical opinion).",
      "serratus_r": "Reaches the ball toward the ceiling (clinical opinion).",
      "serratus_l": "Reaches the ball toward the ceiling (clinical opinion).",
      "triceps_r": "Keep the elbows straight (clinical opinion).",
      "triceps_l": "Keep the elbows straight (clinical opinion).",
      "spinal_extensors_r": "Lengthen as the trunk curls (clinical opinion).",
      "spinal_extensors_l": "Lengthen as the trunk curls (clinical opinion)."
    }
