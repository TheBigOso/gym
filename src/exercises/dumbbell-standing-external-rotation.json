    "id": "dumbbell-standing-external-rotation",
    "name": "Dumbbell Standing External Rotation (90/90)",
    "aliases": [
      "Standing 90/90 external rotation",
      "Dumbbell Cuban rotation (one arm)",
      "Standing scapular-plane external rotation"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "723412",
      "title": "Dumbbell Standing Scapula External Rotation (male)",
      "url": "https://gymvisual.com/videos/17585-dumbbell-standing-scapula-external-rotation-male.html",
      "listing": "Video; data sheet: body part Back, equipment Dumbbell, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength / rehabilitation",
    "bodyPart": "Shoulders (rotator cuff)",
    "secondaryBodyParts": [
      "Upper back (trapezius)",
      "Posterior deltoid"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (shoulder rotation)",
    "plane": "Transverse",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "infraspinatus_r",
        "infraspinatus_l"
      ],
      "synergist": [
        "post_deltoid_r",
        "post_deltoid_l",
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "lat_deltoid_r",
        "lat_deltoid_l"
      ],
      "stabilizer": [
        "upper_traps_r",
        "upper_traps_l",
        "serratus_r",
        "serratus_l",
        "core",
        "forearm_extensors_r",
        "forearm_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you rotate up, breathe in as you lower.",
      "cadence": "About 2 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "12-15 per arm",
      "effort": "Moderate (RIR 2-4); no pain",
      "tempo": "2-0.5-2-0.3 (up-pause-down-pause, seconds)",
      "rest": "45-60 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbells; very light (1-4 kg)",
      "progression": "Add reps, then 0.5-1 kg; longer pause at the top"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall. Raise the right upper arm out to shoulder height, a little in front of the body, elbow bent 90 degrees, forearm pointing forward, palm down."
      },
      {
        "id": "c2",
        "phase": "rotate",
        "text": "Breathe out and turn the forearm up like a hinge until it points to the ceiling; the elbow stays where it is."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Forearm vertical, palm forward, shoulder down away from the ear."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly back to forearm level in about 2 s."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the forearm level and repeat; switch arms after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Letting the elbow drop or drift",
        "fix": "Keep the upper arm level and still; only the forearm moves."
      },
      {
        "id": "m2",
        "mistake": "Arching the back or leaning to finish",
        "fix": "Use a lighter dumbbell and stop where the shoulder runs out of rotation."
      },
      {
        "id": "m3",
        "mistake": "Shrugging",
        "fix": "Keep the shoulder blade down and back."
      },
      {
        "id": "m4",
        "mistake": "Bending the wrist back to lift the weight",
        "fix": "Keep the wrist straight in line with the forearm."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "≈86° (elbow -1 cm from shoulder height)",
        "peak": "≈85° (held)",
        "norm": "About 90 degrees (Sung 2023 tested 45 and 90; 90 raised posterior deltoid and upper trapezius activity seated)",
        "sources": [
          "sung2023"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈25° in front of the frontal plane",
        "peak": "≈25°",
        "norm": "Scapular plane, a little in front of the frontal plane (clinical opinion)",
        "sources": []
      },
      {
        "measure": "External rotation",
        "setup": "forearm 0° from horizontal (forward, palm down)",
        "peak": "forearm 88° from horizontal (vertical, palm forward); elbow moves 0.4 cm",
        "norm": "From the forearm level (about 0 degrees) to the forearm vertical (about 90 degrees) (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈91°",
        "peak": "≈91°",
        "norm": "Held at about 90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s, forearm level",
        "peak": "1.8 s up, 0.5 s at the top, 2.1 s down",
        "norm": "Slow, about 2 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #723412, Dumbbell Standing Scapula External Rotation (male), video (movement reference)",
        "url": "https://gymvisual.com/videos/17585-dumbbell-standing-scapula-external-rotation-male.html"
      },
      {
        "id": "sung2023",
        "title": "Sung, Jung, Wang and Kim 2023, the effects of body positions and abduction angles on shoulder muscle activity patterns during external rotation exercises (Healthcare 11(14):1977)",
        "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10378914/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Sung 2023 tested sitting, supine and prone positions; standing values are inferred from the seated results.",
        "Use very light weights: the rotator cuff is a small muscle group."
      ],
      "modify": [
        "Pain at 90 degrees: lower the elbow to about 45 degrees of abduction, which in Sung 2023 gave a better lower-to-upper trapezius balance.",
        "Can not hold the arm up: rest the elbow on an incline bench pad (supported version) or do side-lying external rotation."
      ],
      "regressions": [
        "Side-lying dumbbell external rotation.",
        "Elbow at the side with a band.",
        "No weight, arm supported."
      ],
      "progressions": [
        "Slower lowering (3 s) and a 2 s pause at the top.",
        "Slightly heavier dumbbell.",
        "Half-kneeling version."
      ]
    },
    "muscleNotes": {
      "infraspinatus_r": "Prime mover (with teres minor): turns the upper arm out. Seated external rotation gave higher infraspinatus activity than supine at both 45 and 90 degrees of abduction (Sung 2023).",
      "infraspinatus_l": "Prime mover (with teres minor): turns the upper arm out. Seated external rotation gave higher infraspinatus activity than supine at both 45 and 90 degrees of abduction (Sung 2023).",
      "post_deltoid_r": "Helps rotate and holds the arm back in line; posterior deltoid activity seated was higher at 90 than at 45 degrees of abduction (Sung 2023).",
      "post_deltoid_l": "Helps rotate and holds the arm back in line; posterior deltoid activity seated was higher at 90 than at 45 degrees of abduction (Sung 2023).",
      "rhomboids_midtrap_r": "Hold the shoulder blade back so the upper arm stays in line with the body.",
      "rhomboids_midtrap_l": "Hold the shoulder blade back so the upper arm stays in line with the body.",
      "lat_deltoid_r": "Holds the upper arm up at shoulder height for the whole set.",
      "lat_deltoid_l": "Holds the upper arm up at shoulder height for the whole set.",
      "upper_traps_r": "Supports the shoulder blade; upper trapezius activity was higher at 90 than at 45 degrees of abduction (Sung 2023).",
      "upper_traps_l": "Supports the shoulder blade; upper trapezius activity was higher at 90 than at 45 degrees of abduction (Sung 2023).",
      "serratus_r": "Keeps the shoulder blade on the ribs.",
      "serratus_l": "Keeps the shoulder blade on the ribs.",
      "core": "Keeps the trunk still and the ribs down.",
      "forearm_extensors_r": "Hold the wrist straight.",
      "forearm_extensors_l": "Hold the wrist straight."
    }
  },
