  "exercise": {
    "id": "lying-abduction",
    "name": "Lying Abduction",
    "aliases": [
      "Supine leg abduction",
      "Lying leg open and close",
      "Legs-up V abduction",
      "Supine straddle open"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "24135",
      "title": "Lying Abduction",
      "url": "https://gymvisual.com/videos/24135-lying-abduction-male.html",
      "listing": "Page could not be read here (gymvisual.com is blocked by the proxy); the movement is taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (outer and inner thighs)",
    "secondaryBodyParts": [
      "Hip flexors",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation",
    "plane": "Frontal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_med_r",
        "glute_med_l",
        "adductors_r",
        "adductors_l"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l"
      ],
      "stabilizer": [
        "core",
        "quads_r",
        "quads_l"
      ],
      "lengthened": [
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the legs open, exhale as you squeeze them back together.",
      "cadence": "About 2 s to open, 2 s to close"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "2 s open, short pause, 2 s close",
      "frequency": "2-3 times a week",
      "progression": "Slower tempo, a longer pause in the open position, then light ankle weights"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms by your sides, and raise both straight legs until they point at the ceiling."
      },
      {
        "id": "c2",
        "phase": "open",
        "text": "Open the legs out to the sides in a wide V, slowly, keeping them straight and the toes up."
      },
      {
        "id": "c3",
        "phase": "close",
        "text": "Squeeze the legs back together over the hips."
      },
      {
        "id": "c4",
        "phase": "reset",
        "text": "Keep the low back and the pelvis quiet on the mat for every rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Opening so wide that the low back arches or the pelvis rocks",
        "fix": "Open only as far as the pelvis stays still."
      },
      {
        "id": "m2",
        "mistake": "Letting the legs drop apart quickly",
        "fix": "Control the opening; take 2 s each way."
      },
      {
        "id": "m3",
        "mistake": "Bent knees",
        "fix": "Keep the knees straight; if the hamstrings are tight, bring the legs a little further from vertical."
      },
      {
        "id": "m4",
        "mistake": "Lifting the head and straining the neck",
        "fix": "Rest the head on the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "Legs together (≈-2°)",
        "peak": "≈36° per leg; ≈72° between the legs",
        "norm": "A comfortable wide V, about 30-45 degrees per leg (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈84°",
        "peak": "≈82° (legs stay about vertical)",
        "norm": "Legs about vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Still on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Legs up 0.6 s",
        "peak": "1.2 s open, 0.5 s pause, 1.3 s close; two reps in 8 s",
        "norm": "Slow and controlled, about 2 s each way (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #24135, Lying Abduction, video (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/24135-lying-abduction-male.html"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      },
      {
        "id": "drysdale2004",
        "title": "Drysdale, Earl and Hertel 2004, surface EMG of the abdominal muscles during pelvic-tilt and abdominal-hollowing exercises (J Athl Train 39(1):32-36)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC385259/"
      },
      {
        "id": "macadam2015",
        "title": "Macadam, Cronin & Contreras 2015, gluteal muscle activity in dynamic hip abduction and hip external rotation exercise: a systematic review (Int J Sports Phys Ther 10(5):573-591; PMC4595911)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4595911/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "If the low back arches off the mat, the legs are too low for your strength: raise them or bend the knees."
      ],
      "modify": [
        "Hands under the buttocks help keep the pelvis tilted and the low back down.",
        "Bend the knees a little to shorten the lever.",
        "Pregnancy, postpartum or diastasis recti: get cleared first, and avoid long supine work later in pregnancy."
      ],
      "regressions": [
        "Knees bent, feet on the floor, let the knees fall open and close (butterfly).",
        "Smaller V."
      ],
      "progressions": [
        "Pause 3 s in the open position.",
        "Light ankle weights.",
        "Side-lying hip abduction for more abductor load."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Gluteus medius and the other abductors start each opening and set its pace (clinical opinion; with the legs straight up gravity loads them little, so this is a light abduction drill).",
      "glute_med_l": "Gluteus medius and the other abductors start each opening and set its pace (clinical opinion; with the legs straight up gravity loads them little, so this is a light abduction drill).",
      "adductors_r": "Past vertical, gravity pulls the legs apart: the adductors lengthen to control the opening and shorten to squeeze the legs back together (clinical opinion).",
      "adductors_l": "Past vertical, gravity pulls the legs apart: the adductors lengthen to control the opening and shorten to squeeze the legs back together (clinical opinion).",
      "hip_flexors_r": "Iliopsoas and rectus femoris hold the legs up against gravity (clinical opinion; hip flexor EMG rises with leg-lowering work, Andersson 1997).",
      "hip_flexors_l": "Iliopsoas and rectus femoris hold the legs up against gravity (clinical opinion; hip flexor EMG rises with leg-lowering work, Andersson 1997).",
      "core": "Rectus abdominis and transversus abdominis keep the pelvis from tipping forward and the low back from arching while the legs move (Drysdale 2004: highest abdominal activity in pelvic-tilt work with the legs unsupported).",
      "quads_r": "Keep the knees straight and the legs long (clinical opinion).",
      "quads_l": "Keep the knees straight and the legs long (clinical opinion)."
    }
  },
