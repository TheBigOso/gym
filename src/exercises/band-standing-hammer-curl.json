      }
    ],
    "safety": {
      "cautions": [
        "Elbow or shoulder pain: use a lighter band and shorten the range; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight (in line with the forearm) (clinical opinion).",
        "Check the band for nicks or tears before each set and make sure it cannot slip off its anchor (under the feet, round the upright). Stand firmly on its middle so it cannot slip out from under the feet.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Wrist or elbow pain with the palm-up curl: the neutral grip is often more comfortable (clinical opinion).",
        "Too hard at the top: step on the band with one foot only, or hold the ends higher."
      ],
      "regressions": [
        "Lighter band.",
        "Seated or one arm at a time."
      ],
      "progressions": [
        "Stronger band, or feet wider on the band.",
        "Slower lowering.",
        "Dumbbell hammer curl."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Still a prime elbow flexor, though its activity was about 12% lower with the neutral grip than with the supinated grip (Coratella 2023).",
      "biceps_l": "Still a prime elbow flexor, though its activity was about 12% lower with the neutral grip than with the supinated grip (Coratella 2023).",
      "forearm_extensors_r": "Brachioradialis (mapped to the forearm extensor region) is best placed to flex the elbow with the thumb up; a review reported the hammer curl gave the highest brachioradialis activity among curls (Bagchi and Raizada 2019, as reviewed by Parpa 2025).",
      "forearm_extensors_l": "Brachioradialis (mapped to the forearm extensor region) is best placed to flex the elbow with the thumb up; a review reported the hammer curl gave the highest brachioradialis activity among curls (Bagchi and Raizada 2019, as reviewed by Parpa 2025).",
      "forearm_flexors_r": "Wrist and finger flexors hold the band and keep the wrist straight.",
      "forearm_flexors_l": "Wrist and finger flexors hold the band and keep the wrist straight.",
      "ant_deltoid_r": "Steadies the shoulder; its activity was higher with the neutral grip than with the supinated grip (Coratella 2023).",
      "ant_deltoid_l": "Steadies the shoulder; its activity was higher with the neutral grip than with the supinated grip (Coratella 2023).",
      "core": "Keeps the trunk still so the hips do not swing the hands up.",
      "upper_traps_r": "Hold the shoulder girdle level.",
      "upper_traps_l": "Hold the shoulder girdle level."
    }
