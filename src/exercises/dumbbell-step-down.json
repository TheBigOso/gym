        "upper_traps_l"
      ]
    },
    "breathing": {
      "pattern": "Inhale as you lower, exhale as you stand back up.",
      "cadence": "About 2 s down, light tap, about 1.2 s up"
    },
    "prescription": {
      "sets": "3 per leg",
      "reps": "8-12",
      "tempo": "3-0-1-0 (slow lowering)",
      "frequency": "2-3 times a week",
      "progression": "Higher box, slower lowering, then heavier dumbbells. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the box near its front edge, a dumbbell in each hand at the sides."
      },
      {
        "id": "c2",
        "phase": "shift",
        "text": "Shift your weight onto the right foot and lift the left foot just off the box."
      },
      {
        "id": "c3",
        "phase": "lower",
        "text": "Breathe in and bend the right knee slowly; the left foot reaches forward and down. Right knee stays over the middle of the foot."
      },
      {
        "id": "c4",
        "phase": "tap",
        "text": "Lightly touch the left heel to the floor; do not put weight on it."
      },
      {
        "id": "c5",
        "phase": "rise",
        "text": "Breathe out and straighten the right leg to stand tall; bring the left foot back onto the box."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Stand tall on both feet and reset; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Standing knee caving inward",
        "fix": "Keep the knee over the 2nd-3rd toe; lower the box if it keeps happening."
      },
      {
        "id": "m2",
        "mistake": "Dropping onto the free foot",
        "fix": "Control the whole lowering; only tap the heel."
      },
      {
        "id": "m3",
        "mistake": "Hip hiking or the pelvis dropping",
        "fix": "Keep the hips level and the trunk tall."
      },
      {
        "id": "m4",
        "mistake": "Pushing off the floor with the free foot",
        "fix": "The leg on the box does all the work."
      }
    ],
    "kinematics": [
      {
        "measure": "Box height",
        "setup": "16 cm box, right toes about 2 cm from its front edge",
        "peak": "Right foot stays flat on the box",
        "norm": "Lewis 2015 used 16 and 24 cm steps",
        "sources": [
          "lewis2015"
        ]
      },
      {
        "measure": "Standing knee flexion",
        "setup": "≈4°",
        "peak": "≈85° at the heel tap (ankle dorsiflexion ≈34°)",
        "norm": "Deepest at the heel tap; set by the box height and leg length; Lewis 2015 compared tasks at 60 degrees and at peak knee flexion",
        "sources": [
          "lewis2015"
        ]
      },
      {
        "measure": "Standing hip",
        "setup": "flexion ≈-2°",
        "peak": "flexion ≈79° at the tap (joint channel), pelvis level",
        "norm": "More hip adduction and less knee abduction than in a single-leg squat (Lewis 2015); keep the knee over the foot",
        "sources": [
          "lewis2015"
        ]
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈5°",
        "peak": "≈20° forward at the tap",
        "norm": "Slight forward lean; trunk flexion was the only difference between the 16 and 24 cm steps at 60 degrees of knee flexion (Lewis 2015)",
        "sources": [
          "lewis2015"
        ]
      },
      {
        "measure": "Free foot",
        "setup": "On the box beside the right",
        "peak": "Heel touches the floor 6 cm in front of the box edge, toes up 20°",
        "norm": "Heel touches the floor in front of the box without taking weight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "Shift 0.4 s, 2.0 s down, 0.2 s tap, 1.2 s up, 1.4 s on both feet",
        "norm": "Slow lowering, 2-3 s; about 1 s up (clinical opinion)",
        "sources": []
      }
    ],
