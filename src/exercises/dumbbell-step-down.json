    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or giving-way occurs.",
        "Choose a dumbbell load you can control for every rep; the load is user-chosen.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Use a stable box that cannot slide; stand near its front edge only when you can control the lowering."
      ],
      "modify": [
        "Knee pain: lower box (15-20 cm) and a shorter lowering.",
        "Balance concerns: one dumbbell, free hand on a rail or wall."
      ],
      "regressions": [
        "Bodyweight step-down.",
        "Lower box."
      ],
      "progressions": [
        "Higher box.",
        "Slower (3-4 s) lowering.",
        "Heavier dumbbells."
      ]
    },
    "muscleNotes": {
      "quads_r": "The knee extensors of the leg on the box lower the body slowly (eccentric) and straighten it again (clinical opinion).",
      "quads_l": "The knee extensors of the leg on the box lower the body slowly (eccentric) and straighten it again (clinical opinion).",
      "glute_max_r": "Hip extensor of the standing leg (clinical opinion).",
      "glute_max_l": "Hip extensor of the standing leg (clinical opinion).",
      "glute_med_r": "Holds the pelvis level on one leg: compared with a single-leg squat, step-downs showed more hip adduction and more pelvic drop on the free side (Lewis 2015).",
      "glute_med_l": "Holds the pelvis level on one leg: compared with a single-leg squat, step-downs showed more hip adduction and more pelvic drop on the free side (Lewis 2015).",
      "adductors_r": "Steady the standing thigh (clinical opinion).",
      "adductors_l": "Steady the standing thigh (clinical opinion).",
      "hamstrings_r": "Co-contract around the standing knee (clinical opinion).",
      "hamstrings_l": "Co-contract around the standing knee (clinical opinion).",
      "calves_r": "Steady the standing shin as the knee travels forward (clinical opinion).",
      "calves_l": "Steady the standing shin as the knee travels forward (clinical opinion).",
      "core": "Keeps the trunk tall on one leg (clinical opinion).",
      "obliques_r": "Stop the pelvis dropping toward the free leg (clinical opinion).",
      "obliques_l": "Stop the pelvis dropping toward the free leg (clinical opinion).",
      "spinal_extensors_r": "Hold the trunk upright as it tips slightly forward (clinical opinion).",
      "spinal_extensors_l": "Hold the trunk upright as it tips slightly forward (clinical opinion).",
      "forearm_flexors_r": "Grip the dumbbell handles; the hands stay closed all set (clinical opinion).",
      "forearm_flexors_l": "Grip the dumbbell handles; the hands stay closed all set (clinical opinion).",
      "upper_traps_r": "Hold the shoulders level and stop the dumbbells pulling the shoulder blades down (clinical opinion).",
      "upper_traps_l": "Hold the shoulders level and stop the dumbbells pulling the shoulder blades down (clinical opinion)."
    }
