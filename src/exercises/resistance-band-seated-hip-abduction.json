  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "resistance-band-seated-hip-abduction",
    "name": "Resistance Band Seated Hip Abduction",
    "aliases": [
      "Mini band seated abduction",
      "Banded seated knee push-out"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "11511",
      "title": "Resistance Band Seated Hip Abduction",
      "url": "https://gymvisual.com/videos/11511-resistance-band-seated-hip-abduction.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus medius)",
    "secondaryBodyParts": [
      "Gluteus maximus"
    ],
    "equipment": [
      "Resistance band (mini loop above the knees)",
      "Flat bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip abduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_med_r",
        "glute_med_l"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l"
      ],
      "stabilizer": [
        "core"
      ],
      "lengthened": [
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the knees press out, inhale as they return.",
      "cadence": "About 1 s out, 0.6 s hold, 1.8 s in"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "15-25",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Stronger band, or lean forward a little to bias the gluteus maximus"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit tall at the end of the bench, band above the knees, feet flat about hip width, hands resting on the thighs."
      },
      {
        "id": "c2",
        "phase": "out",
        "text": "Breathe out and press both knees out against the band."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause wide; the feet stay put."
      },
      {
        "id": "c4",
        "phase": "in",
        "text": "Breathe in and let the knees come back in slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep tension in the band; repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Lifting the feet",
        "fix": "Keep the feet flat; the knees move, the feet stay."
      },
      {
        "id": "m2",
        "mistake": "Slumping",
        "fix": "Sit tall on the sit bones."
      },
      {
        "id": "m3",
        "mistake": "Letting the band snap the knees in",
        "fix": "Control the return."
      },
      {
        "id": "m4",
        "mistake": "Rocking the trunk",
        "fix": "Only the thighs move."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "Knees 36 cm apart",
        "peak": "Thighs open 30° each about the hip-ankle axis; knees 63 cm apart (hip abd 31.1°, rot -36.2°)",
        "norm": "About 25-35 degrees each side from the knees together (clinical opinion); seated and side-lying abduction load the gluteus medius (Macadam 2015)",
        "sources": [
          "macadam2015"
        ]
      },
      {
        "measure": "Hips and knees",
        "setup": "Hip ≈87°, knee ≈86°",
        "peak": "Feet stay put (sole 0.3 cm off the floor at most)",
        "norm": "About 90 degrees, feet flat (standard setup)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Above both knees (34 cm apart)",
        "peak": "Stretched to 57 cm",
        "norm": "Mini loop above both knees (elastic resistance, Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Seated 0.8 s",
        "peak": "1.1 s out, 0.6 s hold, 1.8 s in",
        "norm": "Controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #11511, Resistance Band Seated Hip Abduction, video (movement reference)",
        "url": "https://gymvisual.com/videos/11511-resistance-band-seated-hip-abduction.html"
      },
      {
        "id": "macadam2015",
        "title": "Macadam, Cronin & Contreras 2015, gluteal muscle activity in dynamic hip abduction and hip external rotation exercise: a systematic review (Int J Sports Phys Ther 10(5):573-591; PMC4595911)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4595911/"
      },
      {
        "id": "andersen2010",
        "title": "Andersen, Andersen, Mortensen, Poulsen, Bjørnlund and Zebis 2010, muscle activation and perceived loading during rehabilitation exercises: comparison of dumbbells and elastic resistance (Phys Ther 90(4):538-549)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Andersen+2010+muscle+activation+perceived+loading+dumbbells+elastic+resistance"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the band for nicks before use."
      ],
      "modify": [
        "Hip pinching: smaller range."
      ],
      "regressions": [
        "Lighter band."
      ],
      "progressions": [
        "Heavier band.",
        "Longer pause.",
        "Lever seated hip abduction."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Abducts the flexed hip against the band (Macadam 2015).",
      "glute_med_l": "Abducts the flexed hip against the band (Macadam 2015).",
      "glute_max_r": "Upper fibres abduct and externally rotate the flexed hip (Selkowitz 2013; Macadam 2015).",
      "glute_max_l": "Upper fibres abduct and externally rotate the flexed hip (Selkowitz 2013; Macadam 2015).",
      "core": "Keeps the trunk tall (clinical opinion).",
      "adductors_r": "Lengthen as the knees open (clinical opinion).",
      "adductors_l": "Lengthen as the knees open (clinical opinion)."
    }
