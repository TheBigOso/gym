    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Going overhead needs full, pain-free shoulder mobility; stop at shoulder height if it pinches.",
        "Use much lighter dumbbells than for a normal lateral raise."
      ],
      "modify": [
        "Pinching overhead: stop at shoulder height (standard lateral raise).",
        "Low-back arching: do it seated with the back supported."
      ],
      "regressions": [
        "Standard dumbbell lateral raise.",
        "Seated Lu raise with back support."
      ],
      "progressions": [
        "Pause at shoulder height on the way up and down.",
        "Slower 3 s lowering."
      ]
    },
    "muscleNotes": {
      "lat_deltoid_r": "Prime mover through the whole arc; lateral raises gave the highest middle deltoid EMG among common shoulder exercises (Coratella 2020; Campos 2020).",
      "lat_deltoid_l": "Prime mover through the whole arc; lateral raises gave the highest middle deltoid EMG among common shoulder exercises (Coratella 2020; Campos 2020).",
      "ant_deltoid_r": "Helps above shoulder height, more as the arms come forward.",
      "ant_deltoid_l": "Helps above shoulder height, more as the arms come forward.",
      "upper_traps_r": "Upwardly rotates and lifts the shoulder blades to get the arms overhead.",
      "upper_traps_l": "Upwardly rotates and lifts the shoulder blades to get the arms overhead.",
      "serratus_r": "Upwardly rotates the shoulder blades overhead.",
      "serratus_l": "Upwardly rotates the shoulder blades overhead.",
      "infraspinatus_r": "Turns the arms out (thumbs up) so they can pass overhead.",
      "infraspinatus_l": "Turns the arms out (thumbs up) so they can pass overhead.",
      "core": "Keeps the ribs down; no lean back.",
      "spinal_extensors_r": "Hold the trunk tall.",
      "spinal_extensors_l": "Hold the trunk tall.",
      "glute_max_r": "Steadies the pelvis.",
      "glute_max_l": "Steadies the pelvis."
    }
