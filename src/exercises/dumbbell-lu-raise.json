        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "glute_max_r",
        "glute_max_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out on the way up, breathe in on the way down.",
      "cadence": "About 2 s up, short pause overhead, about 2.5 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "8-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2.5-0.5-2-0 (down-pause-up-bottom, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Light dumbbells (lighter than a normal lateral raise)",
      "progression": "Add reps, then weight; pause at shoulder height on the way up"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, knees soft. Dumbbells at the sides, palms in, arms straight with a soft elbow."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the arms out to the sides, turning the thumbs up as they pass shoulder height, and keep going until the dumbbells are overhead."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms long overhead, a little wider than the shoulders; ribs down, no lean back."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the same way, slowly, back to the sides."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief reset at the sides and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back to get the dumbbells overhead",
        "fix": "Brace the ribs down and squeeze the glutes; use lighter dumbbells."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbows into a press",
        "fix": "Keep the arms long; the elbows stay soft but fixed."
      },
      {
        "id": "m3",
        "mistake": "Swinging up from the legs",
        "fix": "Start each rep from a still position."
      },
      {
        "id": "m4",
        "mistake": "Keeping the palms down past shoulder height",
        "fix": "Turn the thumbs up as the arms pass shoulder height."
      }
    ],
    "kinematics": [
      {
        "measure": "Shoulder abduction",
        "setup": "≈9° (dumbbells at the sides)",
        "peak": "≈166° overhead, hands 27 cm apart",
        "norm": "From the sides to overhead (about 160-170 degrees); the lateral raise loads the middle deltoid most (Coratella 2020; Campos 2020)",
        "sources": [
          "coratella2020",
          "campos2020"
        ]
      },
      {
        "measure": "Plane of elevation",
        "setup": "≈24° in front of the frontal plane",
        "peak": "Held",
        "norm": "A little in front of the frontal plane (scapular plane) (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Palms facing in, thumbs forward",
        "peak": "Thumbs up from shoulder height, palms forward overhead",
        "norm": "Palms in at the sides, thumbs up from shoulder height (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈12°",
        "peak": "≈12°",
        "norm": "Soft, fixed (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Upright, knees soft",
        "peak": "Unchanged (no lean back)",
        "norm": "Upright, no lean back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Pause 0.6 s at the sides",
        "peak": "2.0 s up, 0.5 s overhead, 2.5 s down",
        "norm": "Slow, with a pause overhead (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
