  "exercise": {
    "id": "lying-leg-hip-raise-on-floor",
    "name": "Lying Leg Hip Raise on Floor",
    "aliases": [
      "Floor leg-hip raise",
      "Lying leg raise with hip lift",
      "Leg raise to hip lift",
      "Supine leg and hip raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "7579",
      "title": "Lying Leg Hip Raise on Floor",
      "url": "https://gymvisual.com/videos/7579-lying-leg-hip-raise-on-floor.html",
      "listing": "Video (movement reference; the page could not be read at authoring time: gymvisual.com is blocked by the proxy, so the movement comes from the name and standard coaching practice)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Hips (hip flexors)",
      "Thighs (quadriceps)"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (hip flexion, then posterior pelvic tilt and lumbar flexion with the legs vertical)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "hip_flexors_r",
        "hip_flexors_l",
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l",
        "lats_r",
        "lats_l",
        "triceps_r",
        "triceps_l",
        "adductors_r",
        "adductors_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe in as the legs rise to vertical, breathe out as the hips curl off the mat, breathe in as you lower.",
      "cadence": "About 1.4 s legs up, 1.1 s hips up, short pause, 1.7 s hips down, 1.9 s legs down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-12",
      "tempo": "Legs up in about 1.5 s, hips up in 1 s, lower each part in about 2 s; no swinging",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering, then a longer pause with the hips up, then the bench version (lying leg hip raise) or hanging leg raises."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, arms by your sides palms down, legs straight and together, heels just off the mat."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Keep the knees straight and lift the legs to vertical without arching the low back."
      },
      {
        "id": "c3",
        "phase": "lift",
        "text": "Breathe out and curl the hips up off the mat, driving the feet straight up toward the ceiling."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Roll the pelvis down one vertebra at a time, then lower the legs slowly to a hover."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Keep the heels off the mat and the low back heavy before the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the legs to throw the hips up",
        "fix": "Stop at vertical for a beat and lift the hips with the abdominals, not momentum."
      },
      {
        "id": "m2",
        "mistake": "Low back arching as the legs lower",
        "fix": "Press the low back into the mat; stop the hover higher if it lifts."
      },
      {
        "id": "m3",
        "mistake": "Pushing hard through the hands and neck",
        "fix": "Hands only steady you; keep the head and shoulders relaxed on the mat."
      },
      {
        "id": "m4",
        "mistake": "Bending the knees to make it easier",
        "fix": "Keep the legs straight, or switch to the bent-knee hip raise."
      }
    ],
    "kinematics": [
      {
        "measure": "Legs from the floor",
        "setup": "≈6° (heels 6 cm off the mat)",
        "peak": "≈104° (vertical is 90°; the feet go a little past it as the hips lift)",
        "norm": "From a low hover to about vertical before the hips lift (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈9°",
        "peak": "≈95° with the legs vertical, ≈75° at the top",
        "norm": "About 90 degrees with the legs vertical; straight-leg raises load the hip flexors heavily (Andersson 1997)",
        "sources": [
          "andersson1997"
        ]
      },
      {
        "measure": "Pelvis roll",
        "setup": "Pelvis resting",
        "peak": "≈34° posterior tilt; buttocks 7.9 cm off the mat",
        "norm": "The pelvis curls until the buttocks clear the mat; this curl brings in the lower abdominals (Clark 2003)",
        "sources": [
          "clark2003"
        ]
      },
      {
        "measure": "Knees",
        "setup": "≈3°",
        "peak": "≈7°",
        "norm": "Straight or nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper back",
        "setup": "On the mat",
        "peak": "Stays down (T6 moves 0.1 cm)",
        "norm": "Shoulders and head stay on the mat (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hover 0.6 s",
        "peak": "1.35 s legs up, 1.1 s hips up, 0.4 s pause, 1.65 s hips down, 1.9 s legs down",
        "norm": "Controlled, about 1-2 s per part (clinical opinion)",
        "sources": []
      }
    ],
