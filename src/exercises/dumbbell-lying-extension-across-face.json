    "id": "dumbbell-lying-extension-across-face",
    "name": "Dumbbell Lying Extension (across face)",
    "aliases": [
      "Cross-face triceps extension",
      "Lying cross-body dumbbell extension",
      "One-arm across-the-face extension"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "963",
      "title": "Dumbbell Lying Extension (across face)",
      "url": "https://gymvisual.com/videos/963-dumbbell-lying-extension-across-face.html",
      "listing": "Page could not be read (gymvisual.com blocked by the proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper Arms",
    "secondaryBodyParts": [],
    "equipment": [
      "Dumbbell",
      "Flat bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (elbow)",
    "plane": "Transverse",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "triceps_r"
      ],
      "synergist": [],
      "stabilizer": [
        "forearm_flexors_r",
        "ant_deltoid_r",
        "post_deltoid_r",
        "infraspinatus_r",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Inhale as the dumbbell lowers beside the head, exhale as you straighten the arm.",
      "cadence": "About 2.2 s down, 0.3 s pause, 1.4 s up"
    },
    "prescription": {
      "sets": "2-3 per arm",
      "reps": "10-15",
      "tempo": "2-0-1-1",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "More reps, then the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on a flat bench, feet planted. Hold one dumbbell straight up over the shoulder, neutral grip (palm facing in, handle along your body); rest the other hand on your stomach."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Keep the upper arm still and breathe in as you bend the elbow, lowering the dumbbell across above your face toward the opposite shoulder."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Forearm across above the chin, dumbbell over the opposite shoulder with the palm facing your face, elbow pointing up; keep it clear of the face."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and straighten the elbow along the same path."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arm straight, squeeze the triceps, repeat; then switch arms."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Upper arm drifting across the body",
        "fix": "Keep the elbow pointing straight up over the shoulder; only the forearm crosses."
      },
      {
        "id": "m2",
        "mistake": "Trunk twisting toward the dumbbell",
        "fix": "Keep both shoulder blades on the bench; brace lightly."
      },
      {
        "id": "m3",
        "mistake": "Lowering onto the face or chin",
        "fix": "Stop with the forearm across above the face; the dumbbell stays over the opposite shoulder, not on you."
      },
      {
        "id": "m4",
        "mistake": "Locking out hard",
        "fix": "Straighten the elbow without snapping it."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈6° (straight, not locked)",
        "peak": "≈90° at the bottom",
        "norm": "From straight to about 90-100 degrees, stopping before the dumbbell reaches the head (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Upper arm angle",
        "setup": "≈10° from vertical",
        "peak": "Unchanged: shoulder channels constant (max 0.0° drift)",
        "norm": "Over the shoulder, here tilted slightly toward the head so the forearm crosses above the face, and still (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "Neutral: palm toward the midline, handle along the body",
        "peak": "Palm toward the face at the bottom, handle still along the body (forearm rotation constant)",
        "norm": "Neutral at the top (palm toward the midline); the palm ends facing the face, the handle staying along the body so neither end points at you (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Dumbbell path",
        "setup": "Over the shoulder, upper arm tilted 10° toward the head",
        "peak": "Forearm swings across the body above the face; dumbbell over the opposite shoulder; dumbbell centre 21.8 cm above the shoulder at the bottom, 32.9 cm toward the midline from it; closest approach to the body 3.3 cm (rig shapes), to the bench 23.9 cm",
        "norm": "The upper arm is turned in so the forearm swings across the body instead of back toward the head; the dumbbell passes above the face to over the opposite shoulder (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Free hand",
        "setup": "Left hand resting on the stomach",
        "peak": "Unchanged (constant left-arm channels)",
        "norm": "Rests on the stomach; some lifters steady the working upper arm with it instead (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈85°, feet 48 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat on the floor with the knees bent about 90 degrees, like the bench set-up in Solstad 2020 (head, shoulders and hips on the bench)",
        "sources": [
          "solstad2020"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.6 s",
        "peak": "2.2 s down, 0.3 s pause, 1.4 s up, 0.5 s at the top",
        "norm": "Controlled, about 2 s down and 1-1.5 s up (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual Dumbbell Lying Extension (across face), video page (movement reference; page not readable here)",
        "url": "https://gymvisual.com/videos/963-dumbbell-lying-extension-across-face.html"
      },
      {
        "id": "boehler2011",
        "title": "Boehler 2011, electromyographic analysis of the triceps brachii muscle during a variety of triceps exercises (MS thesis, University of Wisconsin-La Crosse, ACE-sponsored; 15 women, 8 exercises at 70% 1RM)",
        "url": "https://minds.wisc.edu/items/4876923b-3a14-47c3-9a69-decf731bd027"
      },
      {
        "id": "maeo_desc",
        "title": "Maeo and Kanehisa, triceps hypertrophy after 12 weeks of elbow extension training with the shoulder at 180 versus 0 degrees of flexion (Descente Sports Science vol 41; full paper: Maeo et al. 2023, Eur J Sport Sci 23(7):1240-1250, PubMed 35819335)",
        "url": "https://www.shinshu-u.ac.jp/faculty/textiles/db/seeds/descente_sports41_21.pdf"
      },
      {
        "id": "solstad2020",
        "title": "Solstad, Andersen, Shaw, Hoel, Vonheim and Saeterbakken 2020, a comparison of muscle activation between barbell bench press and dumbbell flyes in resistance-trained males (J Sports Sci Med 19(4):645-651; PMC7675616)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7675616/"
      }
    ],
    "safety": {
      "cautions": [
        "The dumbbell travels over the face: use a light, fixed-plate dumbbell and a slow, controlled lowering.",
        "Elbow pain: shorten the range and use a lighter dumbbell (clinical opinion).",
        "Keep the wrist straight over the forearm; a bent-back wrist under the dumbbell strains it.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: let the upper arm tilt slightly toward the head.",
        "Elbow discomfort: lighter dumbbell, shorter range."
      ],
      "regressions": [
        "Two-arm lying extension with light dumbbells.",
        "Band pushdown."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Slower lowering (3 s).",
        "Pause at the bottom."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Only mover: straightens the elbow while the upper arm stays vertical. Long and lateral head activity differed in lying barbell triceps extensions (Boehler 2011); the long head works at a longer length the higher the arm is raised (Maeo and Kanehisa). Turning the upper arm in moves the bend across the body; the elbow still does all the work (clinical opinion).",
      "forearm_flexors_r": "Grip the handle and hold the wrist straight.",
      "ant_deltoid_r": "Holds the upper arm vertical.",
      "post_deltoid_r": "Holds the upper arm vertical as the dumbbell lowers behind the elbow.",
      "core": "Keeps the trunk still on the bench.",
      "infraspinatus_r": "Holds the upper arm turned in so the forearm stays on the cross-body path (clinical opinion)."
    }
  },
