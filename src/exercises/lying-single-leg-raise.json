  "exercise": {
    "id": "lying-single-leg-raise",
    "name": "Lying Single Leg Raise",
    "aliases": [
      "Single straight-leg raise",
      "Supine one-leg raise",
      "Alternating lying leg raise"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "23830",
      "title": "Lying Single Leg Raise (male)",
      "url": "https://gymvisual.com/videos/23830-lying-single-leg-raise-male.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the network proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip flexion, trunk held)",
    "plane": "Sagittal",
    "laterality": "Unilateral (alternate legs)",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "core"
      ],
      "synergist": [
        "quads_r",
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "hip_flexors_l",
        "glute_max_l"
      ],
      "lengthened": [
        "hamstrings_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg rises, inhale as it lowers.",
      "cadence": "About 1.4 s up, short pause, about 2 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per leg",
      "tempo": "About 1.5 s up, brief pause, 2 s down; heel hovers between reps",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering, then both legs together (lying leg raise)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, arms by your sides palms down, both legs straight; lift one heel just off the mat."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise the straight leg to about vertical; the other leg stays long on the mat."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Brief pause with the foot over the hip; pelvis level and low back down."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly until the heel hovers."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Finish the set, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "The resting leg lifts or bends as the working leg rises",
        "fix": "Press the resting leg into the mat and keep it long."
      },
      {
        "id": "m2",
        "mistake": "Pelvis tilting or the low back arching",
        "fix": "Brace and lower only as far as the back stays flat."
      },
      {
        "id": "m3",
        "mistake": "Swinging the leg up",
        "fix": "Start from a still hover and lift smoothly."
      },
      {
        "id": "m4",
        "mistake": "Bending the working knee a lot to get higher",
        "fix": "Keep the knee long; stop where the hamstrings allow."
      }
    ],
    "kinematics": [
      {
        "measure": "Working leg from the floor",
        "setup": "Right heel 5 cm off the mat",
        "peak": "≈82°",
        "norm": "From a hover to about vertical, as far as the hamstrings allow (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈8°",
        "peak": "≈87°",
        "norm": "Rises to about 90 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈3°",
        "peak": "≈6°",
        "norm": "Straight or nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "On the mat; left leg resting straight",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Pelvis and the resting leg stay still (clinical opinion)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hover 0.5 s",
        "peak": "1.4 s up, 0.4 s pause, 2.2 s down, 0.7 s hover",
        "norm": "About 1.5 s up and 2-3 s down (clinical opinion)",
        "sources": []
      }
    ],
