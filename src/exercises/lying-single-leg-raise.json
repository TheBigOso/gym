    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "A one-leg raise loads the low back much less than raising both legs; if the back still arches, bend the resting knee with the foot flat.",
        "Low-back pain or disc problems: prefer bent-knee raises, dead bugs or curl-ups.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion or straight-leg work."
      ],
      "modify": [
        "Bend the knees to shorten the lever.",
        "Hands under the hips if the low back lifts.",
        "Shorter range: stop lowering higher up."
      ],
      "regressions": [
        "Bend the resting knee, foot flat on the mat.",
        "Bent-knee single leg raise.",
        "Smaller range."
      ],
      "progressions": [
        "Slower 3 s lowering.",
        "Hold the top for 2 s.",
        "Lying leg raise (both legs)."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas and rectus femoris lift and lower the leg. A unilateral leg lift needs far less abdominal work than a bilateral one (Andersson 1997).",
      "core": "Rectus abdominis and the deep abdominals hold the pelvis steady; unilateral lifts needed little abdominal activation in Andersson 1997.",
      "quads_r": "Keeps the knee straight; rectus femoris also flexes the hip.",
      "obliques_r": "Stops the pelvis tilting and rotating as one leg rises (clinical opinion).",
      "obliques_l": "Stops the pelvis tilting and rotating as one leg rises (clinical opinion).",
      "hip_flexors_l": "Quiet; the resting leg stays on the mat.",
      "glute_max_l": "Presses the resting leg lightly into the mat to anchor the pelvis (clinical opinion).",
      "hamstrings_r": "Lengthen as the straight leg approaches vertical; tight hamstrings limit the top of the range."
    }
  },
