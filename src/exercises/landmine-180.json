  "exercise": {
    "id": "landmine-180",
    "name": "Landmine 180",
    "aliases": [
      "Landmine rainbow",
      "Landmine rotation",
      "Landmine arc"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "4257",
      "title": "Landmine 180",
      "url": "https://gymvisual.com/videos/4257-landmine-180.html",
      "listing": "Video (title from the catalog link; the page could not be read from this environment, so the movement follows the exercise name and standard coaching)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Core (obliques)",
    "secondaryBodyParts": [
      "Shoulders",
      "Hips"
    ],
    "equipment": [
      "Landmine (barbell in a floor pivot)",
      "Weight plate"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Compound (trunk rotation, shoulders and hips)",
    "plane": "Transverse",
    "laterality": "Alternating",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "obliques_r",
        "obliques_l",
        "core"
      ],
      "synergist": [
        "ant_deltoid_r",
        "ant_deltoid_l",
        "lat_deltoid_r",
        "lat_deltoid_l",
        "glute_med_r",
        "glute_med_l",
        "glute_max_r",
        "glute_max_l"
      ],
      "stabilizer": [
        "spinal_extensors_r",
        "spinal_extensors_l",
        "serratus_r",
        "serratus_l",
        "triceps_r",
        "triceps_l",
        "quads_r",
        "quads_l",
        "forearm_flexors_r",
        "forearm_flexors_l"
      ],
      "lengthened": [
        "obliques_r",
        "obliques_l"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as the bar sweeps down to each hip, breathe in as it comes back up to the middle.",
      "cadence": "About 1 s to each side, 1 s back"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-10 per side",
      "tempo": "Controlled",
      "load": "Light to moderate: control matters more than load (clinical opinion)",
      "frequency": "2 times a week",
      "progression": "Add a small plate, then a slower, longer arc"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand facing the landmine, feet wider than the hips; hold the end of the bar in both hands at arm's length in front of the chest."
      },
      {
        "id": "c2",
        "phase": "right",
        "text": "Breathe out and sweep the bar down to the outside of the right hip, letting the hips and chest turn with it; bring it back up through the middle."
      },
      {
        "id": "c3",
        "phase": "left",
        "text": "Sweep it down to the left hip the same way and back to the middle."
      },
      {
        "id": "c4",
        "phase": "reset",
        "text": "Arms stay long; the rotation comes from the hips and the trunk together."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Bending the elbows",
        "fix": "Keep the arms long; the bar travels on a wide arc."
      },
      {
        "id": "m2",
        "mistake": "Twisting only through the lower back",
        "fix": "Let the hips turn with the bar; the feet stay planted, knees soft."
      },
      {
        "id": "m3",
        "mistake": "Rushing and letting the bar pull you",
        "fix": "Control the bar down and stop it at the hip."
      },
      {
        "id": "m4",
        "mistake": "Rounding the back",
        "fix": "Stay tall with the chest up."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk rotation",
        "setup": "Square to the bar, hands in front of the chest",
        "peak": "Shoulder line turned ≈32° toward each side (pelvis ≈10°, the rest through the trunk); feet planted 44 cm apart",
        "norm": "Shoulders turn about 25-45 degrees each way with the hips helping; axial torque under load is the risk factor, so control the speed (Marshall 2010, clinical opinion)",
        "sources": [
          "marshall2010"
        ]
      },
      {
        "measure": "Bar arc",
        "setup": "Bar end 116 cm high in front of the chest, 42 cm from the right shoulder",
        "peak": "Down to 100 cm beside each hip, 24 cm out from the midline",
        "norm": "The bar end sweeps from chest height in front down to each hip on the sphere of the bar about the pivot (geometry)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Elbows ≈87°",
        "peak": "≈64° at the hip (arms stay long)",
        "norm": "Elbows stay nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "0.4 s set",
        "peak": "1 s to each hip, the same back",
        "norm": "About 1 s down to the hip, 1 s back (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #4257, Landmine 180, video (movement reference)",
        "url": "https://gymvisual.com/videos/4257-landmine-180.html"
      },
      {
        "id": "marshall2010",
        "title": "Marshall and McGill 2010, the role of axial torque in disc herniation (Clin Biomech 25:6-9), porcine model",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19815318/"
      },
      {
        "id": "torso2015",
        "title": "Torso-twist exercise with elastic resistance vs a training machine: core muscle EMG (Scientifica 2015:403068; PubMed 26557405)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26557405/"
      },
      {
        "id": "saeterbakken2012",
        "title": "Saeterbakken & Fimland 2012, muscle activity of the core during bilateral, unilateral, seated and standing resistance exercise (Eur J Appl Physiol 112:1671-1678)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21877146/"
      }
    ],
    "safety": {
      "cautions": [
        "Seat the bar end firmly in the pivot; keep the area around the arc clear.",
        "Low-back pain: shorten the arc and keep the hips square (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Smaller arcs, or the bar alone."
      ],
      "regressions": [
        "Half-kneeling landmine rotation (short arc)."
      ],
      "progressions": [
        "Add a plate.",
        "Landmine rotational press."
      ]
    },
    "muscleNotes": {
      "obliques_r": "Turn and brace the trunk.",
      "obliques_l": "Turn and brace the trunk.",
      "core": "Braces the trunk so the body stays in one line.",
      "ant_deltoid_r": "Raises the upper arm forward.",
      "ant_deltoid_l": "Raises the upper arm forward.",
      "lat_deltoid_r": "Raises the upper arm out to the side.",
      "lat_deltoid_l": "Raises the upper arm out to the side.",
      "glute_med_r": "Holds the pelvis level.",
      "glute_med_l": "Holds the pelvis level.",
      "glute_max_r": "Keeps the hips extended in line with the body.",
      "glute_max_l": "Keeps the hips extended in line with the body.",
      "spinal_extensors_r": "Hold the spine long.",
      "spinal_extensors_l": "Hold the spine long.",
      "serratus_r": "Moves the shoulder blade forward around the ribs and holds it to the chest wall.",
      "serratus_l": "Moves the shoulder blade forward around the ribs and holds it to the chest wall.",
      "triceps_r": "Straightens the elbow.",
      "triceps_l": "Straightens the elbow.",
      "quads_r": "Keep the knees straight.",
      "quads_l": "Keep the knees straight.",
      "forearm_flexors_r": "Grip.",
      "forearm_flexors_l": "Grip."
    }
