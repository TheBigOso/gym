    "breathing": {
      "pattern": "Breathe in at the bottom, breathe out as the hips drive up, hold briefly at the top, breathe in as you lower.",
      "cadence": "About 1.2 s up, 0.8 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "2-4 per leg",
      "reps": "6-12",
      "tempo": "1-1-2-0",
      "frequency": "1-2 times a week",
      "load": "Barbell load is user-chosen and much lighter than a two-leg hip thrust; use a bar pad. Leave about 2-3 reps in reserve (RPE 7-8).",
      "rest": "60-90 s between legs",
      "progression": "Heavier bar, then a 2 s squeeze at the top."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lower shoulder blades on the bench edge, bar (with a pad) across the hip crease, hands just outside the hips. Right foot flat under the knee, left leg straight off the floor."
      },
      {
        "id": "c2",
        "phase": "rise",
        "text": "Tuck the chin, brace, drive through the right heel until the hips and trunk are level, shin vertical."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the right glute at the top without arching the lower back; keep the pelvis level."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly until the plates touch the floor."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Brief reset, then the next rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips tilting toward the free leg",
        "fix": "Keep the pelvis level: push the working knee slightly out and brace."
      },
      {
        "id": "m2",
        "mistake": "Arching the lower back at the top",
        "fix": "Tuck the chin and ribs down; finish with the glutes, not the back."
      },
      {
        "id": "m3",
        "mistake": "Pushing through the toes",
        "fix": "Drive through the heel; set the foot so the shin is vertical at the top."
      },
      {
        "id": "m4",
        "mistake": "Letting the bar roll toward the belly",
        "fix": "Hold the bar on the hip crease with both hands and use a pad."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench height",
        "setup": "42 cm",
        "peak": "Upper back pivots on the bench edge",
        "norm": "About knee height so the upper back can pivot on the edge (common coaching)",
        "sources": []
      },
      {
        "measure": "Working hip flexion",
        "setup": "≈97° at the bottom (plates on the floor)",
        "peak": "≈-8° at the top",
        "norm": "From deep flexion with the plates down to neutral at the top (Contreras 2015)",
        "sources": [
          "contreras2015"
        ]
      },
      {
        "measure": "Working knee flexion",
        "setup": "≈111° at the bottom",
        "peak": "≈90° (shin vertical)",
        "norm": "About 90 degrees at the top, shin vertical (common coaching)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈55° (hips below the shoulders)",
        "peak": "≈0° (level)",
        "norm": "Trunk level with the thighs at the top (common coaching)",
