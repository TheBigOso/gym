    "safety": {
      "cautions": [
        "Use a thick bar pad over the hips; roll the bar into place from the floor.",
        "Use a bench that cannot slide (against a wall or loaded).",
        "Keep the chin tucked; do not let the neck arch over the bench.",
        "Stop if sharp pain, numbness, tingling or giving-way occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Hip-bone discomfort: thicker pad, lighter bar.",
        "Pelvis tilting: two-leg barbell hip thrust first."
      ],
      "regressions": [
        "Bodyweight single-leg hip thrust.",
        "Two-leg barbell glute bridge on the floor."
      ],
      "progressions": [
        "Heavier bar.",
        "Longer squeeze at the top.",
        "Feet-elevated single-leg hip thrust."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Main hip extensor; hip thrusts drove more upper and lower gluteus maximus activity than back squats (Contreras 2015).",
      "glute_max_l": "Main hip extensor; hip thrusts drove more upper and lower gluteus maximus activity than back squats (Contreras 2015).",
      "hamstrings_r": "Assist hip extension; less active with the knees bent about 90 degrees at the top.",
      "hamstrings_l": "Assist hip extension; less active with the knees bent about 90 degrees at the top.",
      "quads_r": "Working side holds the knee angle; free side keeps the lifted leg straight.",
      "quads_l": "Working side holds the knee angle; free side keeps the lifted leg straight.",
      "adductors_r": "Help extend the hips and keep the knees from flaring.",
      "adductors_l": "Help extend the hips and keep the knees from flaring.",
      "glute_med_r": "Keeps the pelvis level on one leg (working side); single-leg bridging raises gluteal demand over the two-leg version (Selkowitz 2013; Boren 2011).",
      "glute_med_l": "Keeps the pelvis level on one leg (working side); single-leg bridging raises gluteal demand over the two-leg version (Selkowitz 2013; Boren 2011).",
      "core": "Holds the ribs down so the lower back does not arch at the top.",
      "obliques_r": "Part of the brace.",
      "obliques_l": "Part of the brace.",
      "spinal_extensors_r": "Keep the spine neutral; the movement should come from the hips, not the lower back.",
      "spinal_extensors_l": "Keep the spine neutral; the movement should come from the hips, not the lower back.",
      "forearm_flexors_r": "Hold the bar in place on the hips.",
