  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "standing-hip-extension",
    "name": "Bodyweight Standing Hip Extension",
    "aliases": [
      "Standing hip extension",
      "Standing glute kickback",
      "Standing leg extension to the back"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "646212",
      "title": "Bodyweight Standing Hip Extension (VERSION 2)",
      "url": "https://gymvisual.com/videos/16148-bodyweight-standing-hip-extension-version-2.html",
      "listing": "Video; data sheet: body part Hips, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (hamstrings)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Wall (light hand support)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip extension)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_max_r"
      ],
      "synergist": [
        "hamstrings_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l",
        "calves_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg goes back, inhale as it returns.",
      "cadence": "About 1.2 s back, 0.6 s hold, 1.4 s return"
    },
    "prescription": {
      "sets": "2-3 per leg",
      "reps": "12-15",
      "tempo": "1-1-1.5-0",
      "frequency": "3-5 times a week (rehab and warm-up)",
      "progression": "Ankle weight, then a resistance band or cable kickback"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall on the left leg facing a wall, hands resting lightly on it, brace."
      },
      {
        "id": "c2",
        "phase": "extend",
        "text": "Breathe out and move the straight right leg back from the hip."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Squeeze the glute. Stop before the low back arches; the trunk stays tall."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and bring the leg back under the hip with control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Tap the toes down, reset, repeat; then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to swing the leg higher",
        "fix": "Brace, keep the ribs down; the leg only goes back about 15-20 degrees from the hip."
      },
      {
        "id": "m2",
        "mistake": "Leaning far forward",
        "fix": "Stay tall; only a small forward tip of the pelvis is normal."
      },
      {
        "id": "m3",
        "mistake": "Swinging with momentum",
        "fix": "Slow, controlled lift and a pause at the back."
      },
      {
        "id": "m4",
        "mistake": "Turning the toes out",
        "fix": "Keep the toes pointing down and forward so the hip does not rotate."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip extension",
        "setup": "≈-4° (hip flexion 4°)",
        "peak": "≈19° (joint channel; rig limit 20°)",
        "norm": "True hip extension is small, about 10-20 degrees with the knee straight, before the pelvis has to tip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Thigh behind vertical",
        "setup": "≈-4°",
        "peak": "≈25° (hip extension plus 6° pelvic tip)",
        "norm": "Thigh angle behind vertical includes the small forward tip of the pelvis (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "Tall (reference posture)",
        "peak": "≈6° forward of the standing posture with the pelvis; spine channels at 0 (no lumbar extension)",
        "norm": "Tall trunk; the pelvis may tip forward a few degrees, no lumbar arch (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "Moving knee ≈17°, stance ≈4°",
        "peak": "Moving knee ≈3°",
        "norm": "Moving knee straight; stance knee soft (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.2 s back, 0.6 s hold, 1.4 s return",
        "norm": "Slow and controlled with a short hold (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #646212, Bodyweight Standing Hip Extension (VERSION 2), video (movement reference)",
        "url": "https://gymvisual.com/videos/16148-bodyweight-standing-hip-extension-version-2.html"
      },
      {
        "id": "macadam2019",
        "title": "Macadam and Feser 2019, gluteus maximus EMG excitation during dynamic body-weight hip extension: a systematic review (Int J Sports Phys Ther 14(1):14-31; PMC6350668)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6350668/"
      },
      {
        "id": "boren2011",
        "title": "Boren et al. 2011, EMG analysis of gluteus medius and gluteus maximus during rehabilitation exercises (Int J Sports Phys Ther 6(3):206-223; PMC3201064)",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3201064/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Good balance: hands on hips instead of the wall.",
        "Low back discomfort: make the movement smaller and brace first."
      ],
      "regressions": [
        "Prone hip extension on the floor.",
        "Quadruped hip extension."
      ],
      "progressions": [
        "Hands on hips (no wall).",
        "Ankle weight.",
        "Band or cable kickback.",
        "Single-leg Romanian deadlift."
      ]
    },
    "muscleNotes": {
      "glute_max_r": "Moving-leg hip extensor. Glute cues and abdominal bracing raised gluteus maximus activity in body-weight hip extension exercises (Macadam 2019).",
      "hamstrings_r": "Assist hip extension with the knee straight (clinical opinion).",
      "glute_med_l": "Stance-leg abductor holding the pelvis level on one leg (clinical opinion).",
      "core": "Bracing keeps the low back from arching as the leg goes back; a lumbopelvic control strategy raised gluteus maximus activity in related exercises (Macadam 2019).",
      "spinal_extensors_r": "Hold the trunk tall; they should not take over by arching the low back (clinical opinion).",
      "spinal_extensors_l": "Hold the trunk tall; they should not take over by arching the low back (clinical opinion).",
      "calves_l": "Balance on the stance foot (clinical opinion)."
    }
  },
