  "exercise": {
    "id": "hip-thrusts",
    "name": "Hip Thrusts",
    "aliases": [
      "Hip thrust",
      "Bodyweight hip thrust",
      "Bench hip thrust",
      "Shoulder-elevated glute bridge"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "13808",
      "title": "Hip Thrusts",
      "url": "https://gymvisual.com/videos/13808-hip-thrusts.html",
      "listing": "Video (movement reference; page could not be read at authoring time, title from the link)",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (glutes)",
    "secondaryBodyParts": [
      "Thighs (hamstrings, quadriceps)",
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Bench"
    ],
    "difficulty": "Beginner",
    "mechanics": "Compound (hip extension on both legs)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "glute_max_r",
        "glute_max_l"
      ],
      "synergist": [
        "hamstrings_r",
        "hamstrings_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "glute_med_r",
        "glute_med_l",
        "quads_r",
        "quads_l",
        "obliques_r",
        "obliques_l",
        "core",
        "spinal_extensors_r",
        "spinal_extensors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you drive the hips up, inhale as you lower.",
      "cadence": "About 1.2 s up, 0.8 s squeeze, 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-20",
      "tempo": "1-1-2-0",
      "frequency": "2-3 times a week",
      "progression": "Pause at the top, then single-leg hip thrust, then a dumbbell or barbell on the hips"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Shoulder blades on the bench edge, arms spread on the bench, feet flat about hip width."
      },
      {
        "id": "c2",
        "phase": "drive",
        "text": "Breathe out and drive through the heels to lift the hips."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Hips level with the shoulders, shins vertical, chin tucked. Squeeze the glutes."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower the hips toward the floor under control."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay on the bench and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Arching the low back to get higher",
        "fix": "Stop when the trunk is level; keep the ribs down and the chin tucked."
      },
      {
        "id": "m2",
        "mistake": "Knees caving in",
        "fix": "Push the knees out in line with the toes."
      },
      {
        "id": "m3",
        "mistake": "Feet too far out (hamstrings cramp) or too close (knee strain)",
        "fix": "Place the feet so the shins are vertical at the top."
      },
      {
        "id": "m4",
        "mistake": "Back sliding along the bench",
        "fix": "Pivot on the shoulder blades; the bench edge stays under the same spot."
      },
      {
        "id": "m5",
        "mistake": "Pushing through the toes",
        "fix": "Keep the whole foot down and drive through the heels."
      }
    ],
    "kinematics": [
      {
        "measure": "Bench height",
        "setup": "42 cm",
        "peak": "Upper back pivots on the bench edge",
        "norm": "Knee height bench, about 40-45 cm (common setup; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈99° at the bottom",
        "peak": "≈-4°",
        "norm": "Hip reaches neutral at the top, trunk level with the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion",
        "setup": "≈107° at the bottom",
        "peak": "≈90° (shins vertical), feet 26 cm apart",
        "norm": "About 90 degrees at the top (shins vertical) (common setup; clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk inclination",
        "setup": "≈56° (hips below the shoulders)",
        "peak": "≈0° (level)",
        "norm": "Level at the top; the trunk pivots on the shoulder blades (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hips down 0.8 s",
        "peak": "1.2 s up, 0.8 s squeeze, 2.0 s down, 1.2 s reset",
        "norm": "About 1 s up, a short pause, about 2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
