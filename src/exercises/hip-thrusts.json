    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Make sure the bench cannot slide; set it against a wall."
      ],
      "modify": [
        "Low back discomfort: lift less high and brace first.",
        "Hamstring cramps: bring the feet a little closer."
      ],
      "regressions": [
        "Glute bridge on the floor."
      ],
      "progressions": [
        "Pause at the top.",
        "Single-leg hip thrust.",
        "Dumbbell or barbell hip thrust."
      ]
    },
    "muscleNotes": {
      "core": "Brace so the ribs stay down and the low back does not arch.",
      "glute_max_r": "Main mover: extend the hips to lift the pelvis.",
      "glute_max_l": "Main mover: extend the hips to lift the pelvis.",
      "hamstrings_r": "Help extend the hips.",
      "hamstrings_l": "Help extend the hips.",
      "adductors_r": "Help extend the hips; keep the knees in line.",
      "adductors_l": "Help extend the hips; keep the knees in line.",
      "glute_med_r": "Keeps the knees from caving in and the pelvis level.",
      "glute_med_l": "Keeps the knees from caving in and the pelvis level.",
      "quads_r": "Hold the knee angle.",
      "quads_l": "Hold the knee angle.",
      "obliques_r": "Brace the trunk.",
      "obliques_l": "Brace the trunk.",
      "spinal_extensors_r": "Hold the trunk in line; should not arch the low back.",
      "spinal_extensors_l": "Hold the trunk in line; should not arch the low back."
    }
