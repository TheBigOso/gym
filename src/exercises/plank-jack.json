    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Wrist pain: plank on the fists or on dumbbell handles, or do step-out plank jacks.",
        "Shoulder pain or recent shoulder injury: get guidance before weight-bearing on the hands.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before plank and jumping work."
      ],
      "modify": [
        "Step the feet out and in one at a time (no hop).",
        "Hands on a bench (incline plank jack)."
      ],
      "regressions": [
        "High plank hold.",
        "Alternating side steps in a plank."
      ],
      "progressions": [
        "Faster tempo or longer sets.",
        "Plank jack with a push-up every few jacks."
      ]
    },
    "muscleNotes": {
      "core": "Rectus abdominis holds the trunk against sagging: a plank on the toes is about 34% upper and 40% lower rectus MVIC (Escamilla 2016). The hops add brief impacts the trunk must absorb without the hips dipping (clinical opinion).",
      "obliques_r": "External and internal obliques were about 40% and 29% MVIC in a plank on the toes (Escamilla 2016); they also resist the side-to-side shift as the feet move.",
      "obliques_l": "External and internal obliques were about 40% and 29% MVIC in a plank on the toes (Escamilla 2016); they also resist the side-to-side shift as the feet move.",
      "glute_med_r": "Abducts the legs to jump the feet out (clinical opinion).",
      "glute_med_l": "Abducts the legs to jump the feet out (clinical opinion).",
      "adductors_r": "Bring the feet back in (clinical opinion).",
      "adductors_l": "Bring the feet back in (clinical opinion).",
      "serratus_r": "Keeps the shoulder blades flat on the rib cage while the hands bear weight (clinical opinion).",
      "serratus_l": "Keeps the shoulder blades flat on the rib cage while the hands bear weight (clinical opinion).",
      "ant_deltoid_r": "Supports the body over the hands (clinical opinion).",
      "ant_deltoid_l": "Supports the body over the hands (clinical opinion).",
      "pec_r": "Supports the body over the hands (clinical opinion).",
      "pec_l": "Supports the body over the hands (clinical opinion).",
      "triceps_r": "Keeps the elbows straight (clinical opinion).",
      "triceps_l": "Keeps the elbows straight (clinical opinion).",
      "quads_r": "Keep the knees straight in the plank (rectus femoris about 20% MVIC in a plank on the toes, Escamilla 2016).",
      "quads_l": "Keep the knees straight in the plank (rectus femoris about 20% MVIC in a plank on the toes, Escamilla 2016).",
      "calves_r": "Push off and land on the balls of the feet (clinical opinion).",
      "calves_l": "Push off and land on the balls of the feet (clinical opinion)."
    }
