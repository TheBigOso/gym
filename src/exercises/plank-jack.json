    "breathing": {
      "pattern": "Breathe steadily and rhythmically; do not hold the breath.",
      "cadence": "About one jack (out and in) per second"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "20-40 s or 10-20 jacks",
      "tempo": "Quick, light hops at about one jack per second",
      "frequency": "2-3 times a week",
      "progression": "Longer sets, then faster jacks, then plank jacks with a push-up"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "High plank: hands under the shoulders, arms straight, body in one line, feet together on the balls of the feet."
      },
      {
        "id": "c2",
        "phase": "hopOut",
        "text": "Hop both feet out to about twice hip width; land softly on the balls of the feet."
      },
      {
        "id": "c3",
        "phase": "hopIn",
        "text": "Hop them back together. Hips stay level: no piking up or sagging."
      },
      {
        "id": "c4",
        "phase": "repeat",
        "text": "Keep a steady rhythm; hands and shoulders stay still, abs braced."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Finish in the plank with the feet together."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips bouncing up and down",
        "fix": "Brace harder, slow down and make the hops smaller."
      },
      {
        "id": "m2",
        "mistake": "Low back sagging",
        "fix": "Squeeze the glutes and pull the ribs down; drop to the knees between sets if needed."
      },
      {
        "id": "m3",
        "mistake": "Shoulders drifting behind the hands",
        "fix": "Keep the shoulders over the wrists."
      },
      {
        "id": "m4",
        "mistake": "Landing flat-footed and loud",
        "fix": "Land lightly on the balls of the feet."
      }
    ],
    "kinematics": [
      {
        "measure": "Body line",
        "setup": "Trunk ≈24° above horizontal, trunk-to-leg bend 0.0°",
        "peak": "Feet out: trunk ≈25°, bend 0.0°; pelvis height 44.7-44.9 cm",
        "norm": "Shoulders, hips and ankles in one line; hips stay level as the feet move (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Foot width",
        "setup": "Feet 16 cm apart (ankles)",
