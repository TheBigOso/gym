  },
  "exercise": {
    "id": "resistance-band-standing-balance-hip-abduction",
    "name": "Resistance Band Standing Balance Hip Abduction",
    "aliases": [
      "Single-leg balance banded abduction",
      "Mini band quarter-squat hip abduction"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "18901",
      "title": "Resistance Band Standing Balance Hip Abduction",
      "url": "https://gymvisual.com/videos/18901-resistance-band-standing-balance-hip-abduction-male.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (gluteus medius)",
    "secondaryBodyParts": [
      "Thighs",
      "Core"
    ],
    "equipment": [
      "Resistance band (mini loop above the knees)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (hip abduction) with single-leg balance",
    "plane": "Frontal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "glute_med_r",
        "glute_med_l"
      ],
      "synergist": [
        "glute_max_r",
        "glute_max_l"
      ],
      "stabilizer": [
        "quads_l",
        "core",
        "obliques_l",
        "calves_l"
      ],
      "lengthened": [
        "adductors_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg presses out, inhale as it returns.",
      "cadence": "About 1.2 s out, 0.5 s hold, 1.8 s back"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Stronger band, deeper stance squat, or eyes on a fixed point further away"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Band above the knees; sit into a quarter squat on the left leg, hands on the hips."
      },
      {
        "id": "c2",
        "phase": "out",
        "text": "Breathe out and press the right leg out to the side; the stance knee stays over the toes."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause; pelvis level, chest proud."
      },
      {
        "id": "c4",
        "phase": "back",
        "text": "Breathe in and bring the leg back slowly without touching down."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the squat; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Stance knee caving in",
        "fix": "Push the stance knee out over the middle toes against the band."
      },
      {
        "id": "m2",
        "mistake": "Standing up out of the squat",
        "fix": "Keep the stance knee bent the whole set."
      },
      {
        "id": "m3",
        "mistake": "Leaning over the stance leg",
        "fix": "Stay square; a smaller arc is fine."
      },
      {
        "id": "m4",
        "mistake": "Rushing",
        "fix": "Pause at the top and come back slower than you went out."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip abduction",
        "setup": "≈3°",
        "peak": "≈30° (joint channel); thigh 29° out in the frontal view",
        "norm": "About 25-35 degrees (clinical opinion); single-leg stance and abduction both load the gluteus medius (Boren 2011; Distefano 2009)",
        "sources": [
          "boren2011",
          "distefano2009"
        ]
      },
      {
        "measure": "Stance leg",
        "setup": "Knee ≈25°, trunk ≈13° forward",
        "peak": "Held",
        "norm": "Quarter squat, knee over the toes (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "Above both knees (23 cm apart)",
        "peak": "Stretched to 39 cm",
        "norm": "Mini loop above both knees (elastic resistance, Andersen 2010)",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Balance 0.8 s",
        "peak": "1.2 s out, 0.5 s hold, 1.8 s back",
        "norm": "Slow and controlled (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #18901, Resistance Band Standing Balance Hip Abduction, video (movement reference)",
