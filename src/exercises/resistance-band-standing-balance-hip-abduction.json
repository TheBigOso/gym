    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the band for nicks before use."
      ],
      "modify": [
        "Poor balance: one hand on a wall.",
        "Knee discomfort: stand taller."
      ],
      "regressions": [
        "Resistance band standing hip abduction (upright).",
        "Band clamshell."
      ],
      "progressions": [
        "Heavier band.",
        "Band around the ankles."
      ]
    },
    "muscleNotes": {
      "glute_med_r": "Moves the leg out against the band (Distefano 2009).",
      "glute_med_l": "Works hard holding the pelvis level on the single-leg squat (Boren 2011; Distefano 2009).",
      "glute_max_r": "Upper fibres assist abduction (Selkowitz 2013).",
      "glute_max_l": "Holds the hip in the quarter squat (clinical opinion).",
      "quads_l": "Hold the stance knee bent (clinical opinion).",
      "core": "Steadies the trunk (clinical opinion).",
      "obliques_l": "Resist leaning (clinical opinion).",
      "calves_l": "Balance on the stance foot (clinical opinion).",
      "adductors_r": "Lengthen as the leg moves out (clinical opinion)."
    }
