      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "Band tension is user-chosen: pick one you can control for every rep with good form.",
        "Check the band for nicks or tears before each set and make sure it cannot slip off its anchor (under the feet, round the upright). Stand firmly on its middle so it cannot slip out from under the feet.",
        "The bent-over position loads the low back; keep the back flat and the band light.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Low-back discomfort: do it chest-supported, lying face down on an incline bench, or seated bent over the end of a bench.",
        "Hamstring tightness: bend the knees more."
      ],
      "regressions": [
        "Chest-supported raise on an incline bench.",
        "Seated bent-over rear delt fly.",
        "Lighter band."
      ],
      "progressions": [
        "Slower 3 s lowering with a 1 s squeeze.",
        "Stronger band.",
        "Dumbbell or cable reverse fly."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Prime mover (horizontal abduction). A neutral grip gave more posterior deltoid activity than a pronated grip on a reverse fly (Schoenfeld 2013); prone horizontal abduction reached about 87% MVIC in the posterior deltoid (Reinold 2007).",
      "post_deltoid_l": "Prime mover (horizontal abduction). A neutral grip gave more posterior deltoid activity than a pronated grip on a reverse fly (Schoenfeld 2013); prone horizontal abduction reached about 87% MVIC in the posterior deltoid (Reinold 2007).",
      "rhomboids_midtrap_r": "Squeeze the shoulder blades together at the top.",
      "rhomboids_midtrap_l": "Squeeze the shoulder blades together at the top.",
      "infraspinatus_r": "External rotator that works with the posterior deltoid; higher with a neutral grip (Schoenfeld 2013).",
      "infraspinatus_l": "External rotator that works with the posterior deltoid; higher with a neutral grip (Schoenfeld 2013).",
      "lat_deltoid_r": "Helps lift the arm; prone horizontal abduction also gave about 63% MVIC in the middle deltoid (Reinold 2007).",
      "lat_deltoid_l": "Helps lift the arm; prone horizontal abduction also gave about 63% MVIC in the middle deltoid (Reinold 2007).",
      "spinal_extensors_r": "Hold the flat back in the hip hinge for the whole set.",
      "spinal_extensors_l": "Hold the flat back in the hip hinge for the whole set.",
      "hamstrings_r": "Hold the hinge at the hips with the knees soft.",
      "hamstrings_l": "Hold the hinge at the hips with the knees soft.",
      "glute_max_r": "Holds the hips in the hinge.",
      "glute_max_l": "Holds the hips in the hinge.",
      "core": "Keeps the trunk still so the arms do the work."
    }
  },
