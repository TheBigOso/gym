        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you raise the arms, breathe in as you lower; keep the trunk braced.",
      "cadence": "About 1.5 s up, short squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-20",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "1.5-0.5-2-0 (up-squeeze-down-pause, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "Band tension is user-chosen; light, so the back stays flat; the band is hardest at the top",
      "progression": "Add reps, then a stronger band or the feet wider on the band; chest-supported band raise on an incline bench"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand on the middle of the band, feet hip width, knees soft; hinge at the hips until the trunk is nearly parallel to the floor with a flat back. Hold an end in each hand under the shoulders, palms facing each other."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and sweep the arms out to the sides with soft elbows, leading with the backs of the hands."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Arms about level with the back, where the band is tightest; squeeze the shoulder blades together briefly."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Lower slowly back under the shoulders against the band; keep the trunk still."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stay in the hinge, reset and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the back",
        "fix": "Push the hips back, keep the chest long; stand a little more upright if needed."
      },
      {
        "id": "m2",
        "mistake": "Rowing (bending the elbows a lot and pulling back)",
        "fix": "Keep the elbow bend fixed and move the arms out to the sides."
      },
      {
        "id": "m3",
        "mistake": "Jerking the trunk up to stretch the band",
        "fix": "Keep the trunk still; use a lighter band."
      },
      {
        "id": "m4",
        "mistake": "Shrugging toward the ears",
        "fix": "Draw the shoulder blades back and down."
      },
      {
        "id": "m5",
        "mistake": "Letting the band snap the arms down",
        "fix": "Lower over about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk inclination",
        "setup": "≈17° above horizontal (≈73° from vertical)",
        "peak": "unchanged",
        "norm": "Nearly parallel to the floor, flat back (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Horizontal abduction",
        "setup": "arms hanging (upper arm ≈11° from vertical)",
        "peak": "upper arm ≈106° from vertical, about level with the back",
        "norm": "From arms hanging to about level with the back; prone horizontal abduction tested at about 100 degrees of abduction (Reinold 2007)",
        "sources": [
          "reinold2007"
        ]
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈16°",
        "peak": "≈20°",
        "norm": "Slight, fixed bend (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Grip",
        "setup": "neutral, palms facing each other",
        "peak": "palms down, thumbs toward the head",
        "norm": "Neutral (palms facing each other) gave more posterior deltoid and infraspinatus activity than pronated (Schoenfeld 2013)",
        "sources": [
          "schoenfeld2013"
        ]
      },
      {
        "measure": "Knee flexion",
        "setup": "≈24°",
        "peak": "unchanged",
        "norm": "Soft knees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Band",
        "setup": "One band per hand, under the ball of each foot; strand 41.5 cm with the hands hanging",
        "peak": "Strand 130.3 cm with the arms out level with the back (most stretch, most tension)",
        "norm": "Elastic tension rises as the band stretches, so the load is highest where the band is longest; at matched effort, elastic tubing and dumbbells gave similar muscle activity in upper-body exercises (Andersen 2010); with the band under the feet the load is highest at the top, with the arms out level with the back",
        "sources": [
          "andersen2010"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hold the hinge 0.8 s",
        "peak": "1.5 s up, 0.5 s squeeze, 2.0 s down",
        "norm": "Controlled, no swing (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
