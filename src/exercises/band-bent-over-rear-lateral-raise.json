      "Upper back (rhomboids, mid trapezius)"
    ],
    "equipment": [
      "Resistance band"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (shoulder horizontal abduction)",
    "plane": "Transverse",
    "laterality": "Bilateral",
