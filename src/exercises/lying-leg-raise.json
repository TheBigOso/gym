  "exercise": {
    "id": "lying-leg-raise",
    "name": "Lying Leg Raise",
    "aliases": [
      "Leg raise",
      "Floor leg raise",
      "Supine straight-leg raise (both legs)"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "116312",
      "title": "Lying Leg Raise",
      "url": "https://gymvisual.com/videos/1404-lying-leg-raise.html",
      "listing": "Video; data sheet: body part Waist, equipment Body weight, exercise type Strength",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals, hip flexors)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (hip flexion, trunk held)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "hip_flexors_r",
        "hip_flexors_l",
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l",
        "adductors_r",
        "adductors_l"
      ],
      "stabilizer": [
        "quads_r",
        "quads_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the legs rise, inhale as they lower slowly.",
      "cadence": "About 1.5 s up, short pause, about 2.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-15",
      "tempo": "About 1.5 s up, brief pause, 2-3 s down; heels hover between reps",
      "frequency": "2-3 times a week",
      "progression": "Bent-knee raise first, then straight legs, then a slower lowering or a hanging leg raise"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie flat, arms by your sides palms down, legs straight and together, heels just off the mat."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and raise both legs together to about vertical, knees long."
      },
      {
        "id": "c3",
        "phase": "top",
        "text": "Brief pause with the legs over the hips; low back pressed into the mat."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly; stop with the heels just above the floor before the back arches."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Hover, keep the back flat, and repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Low back arching off the mat as the legs lower",
        "fix": "Brace, press the low back down, and stop higher; bend the knees if needed."
      },
      {
        "id": "m2",
        "mistake": "Dropping the legs fast",
        "fix": "Take 2-3 s to lower."
      },
      {
        "id": "m3",
        "mistake": "Swinging up with momentum",
        "fix": "Start each rep from a still hover."
      },
      {
        "id": "m4",
        "mistake": "Pushing hard into the floor with the hands and neck",
        "fix": "Hands rest lightly; head relaxed on the mat."
      }
    ],
    "kinematics": [
      {
        "measure": "Legs from the floor",
        "setup": "Heels 6 cm off the mat (hip-to-ankle line ≈6°; the hip joint sits above the heels)",
        "peak": "≈88°",
        "norm": "From a hover just above the floor to about vertical (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip flexion",
        "setup": "≈9° (pelvis resting in a slight anterior tilt)",
        "peak": "≈93°",
        "norm": "Rises to about 90 degrees at the top (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee",
        "setup": "≈3°",
        "peak": "≈6°",
        "norm": "Straight or nearly straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Pelvis and low back",
        "setup": "On the mat",
        "peak": "Unchanged (pelvis moves 0 cm)",
        "norm": "Pelvis stays on the mat; the low back should not arch (clinical opinion; McGill 1998 for the load)",
        "sources": [
          "mcgill1998"
        ]
      },
      {
        "measure": "Tempo",
        "setup": "Hover 0.6 s",
        "peak": "1.5 s up, 0.4 s pause, 2.5 s down, 1 s hover",
        "norm": "About 1.5 s up and 2-3 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #116312, Lying Leg Raise, video (movement reference)",
        "url": "https://gymvisual.com/videos/1404-lying-leg-raise.html"
      },
      {
        "id": "andersson1997",
        "title": "Andersson, Nilsson, Ma and Thorstensson 1997, abdominal and hip flexor muscle activation during various training exercises (Eur J Appl Physiol 75:115-123; PMID 9118976)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9118976/"
      },
      {
        "id": "mcgill1998",
        "title": "McGill 1998, low back exercises: evidence for improving exercise regimens (Phys Ther 78(7):754-765; PMID 9672547)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/9672547/"
      },
      {
        "id": "clark2003",
        "title": "Clark, Holt and Sinyard 2003, electromyographic comparison of the upper and lower rectus abdominis during abdominal exercises (J Strength Cond Res 17(3):475-483; PMID 12930172)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/12930172/"
      },
      {
        "id": "axler1997",
        "title": "Axler and McGill 1997, low-back loads over a variety of abdominal exercises: searching for the safest abdominal challenge (Med Sci Sports Exerc 29(6):804-811)",
        "url": "https://acnpsearch.tweb-dev.unibo.it/singlejournalindex/7588015"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Straight-leg raises load the low back: leg raises gave higher psoas activity and spine compression than sit-ups in McGill's data (McGill 1998). If the low back arches off the mat, bend the knees or shorten the range.",
        "Low-back pain or disc problems: prefer bent-knee raises, dead bugs or curl-ups.",
        "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion or straight-leg work."
      ],
      "modify": [
        "Bend the knees to shorten the lever.",
        "Hands under the hips if the low back lifts.",
        "Shorter range: stop lowering higher up."
      ],
      "regressions": [
        "Bent-knee leg raise.",
        "Single-leg lowering (other foot on the floor).",
        "Dead bug."
      ],
      "progressions": [
        "Slower 3-4 s lowering.",
        "Add a hip lift at the top.",
        "Hanging leg raise."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas lifts and lowers the legs. Bilateral leg lifts gave higher iliacus activity than hip-flexion sit-ups (Andersson 1997), and leg raises produced the highest psoas activity in McGill's comparison (McGill 1998).",
      "hip_flexors_l": "Iliopsoas lifts and lowers the legs. Bilateral leg lifts gave higher iliacus activity than hip-flexion sit-ups (Andersson 1997), and leg raises produced the highest psoas activity in McGill's comparison (McGill 1998).",
      "core": "Rectus abdominis does not move the legs; it holds the pelvis and low back against the pull of the hip flexors. Bilateral, but not unilateral, leg lifts needed abdominal activation (Andersson 1997). Leg lowering gave less rectus activity than curl-ups (Clark 2003).",
      "obliques_r": "Brace with the rectus to stop the low back arching.",
      "obliques_l": "Brace with the rectus to stop the low back arching.",
      "adductors_r": "Keep the legs together and assist hip flexion near the bottom (clinical opinion).",
      "adductors_l": "Keep the legs together and assist hip flexion near the bottom (clinical opinion).",
      "quads_r": "Keep the knees straight; rectus femoris also helps flex the hips.",
      "quads_l": "Keep the knees straight; rectus femoris also helps flex the hips."
    }
  },
