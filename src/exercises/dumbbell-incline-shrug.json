    "id": "dumbbell-incline-shrug",
    "name": "Dumbbell Incline Shrug",
    "aliases": [
      "Chest-supported dumbbell shrug",
      "Prone incline shrug",
      "Incline bench dumbbell shrug"
    ],
    "reference": {
      "source": "GymVisual",
