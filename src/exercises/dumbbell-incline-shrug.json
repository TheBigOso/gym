      },
      {
        "id": "ekstrom2003",
        "title": "Ekstrom, Donatelli & Soderberg 2003, surface electromyographic analysis of exercises for the trapezius and serratus anterior muscles (J Orthop Sports Phys Ther 33(5):247-258)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/12774999/"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, a pinching feeling in the front or top of the shoulder, numbness or tingling occurs.",
        "The dumbbell load is user-chosen: pick a weight you can control for every rep with good form.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if the shrug causes neck pain, headache, numbness or tingling in the arms."
      ],
      "modify": [
        "Neck discomfort: shrug through a smaller range, lighter dumbbells.",
        "Grip gives out first: use lifting straps or lighter dumbbells."
      ],
      "regressions": [
        "Standing dumbbell shrug with light dumbbells.",
        "Shrug with empty hands, slow squeeze."
      ],
      "progressions": [
        "Two-second squeeze at the top.",
        "Heavier dumbbells with straps."
      ]
    },
    "muscleNotes": {
      "upper_traps_r": "Prime mover: lifts the shoulder blades; with the trunk inclined forward the arms hang ahead of the trunk, so the shrug also draws the shoulders back toward the spine.",
      "upper_traps_l": "Prime mover: lifts the shoulder blades; with the trunk inclined forward the arms hang ahead of the trunk, so the shrug also draws the shoulders back toward the spine.",
      "rhomboids_midtrap_r": "Hold the shoulder blades in against the ribs as they rise.",
      "rhomboids_midtrap_l": "Hold the shoulder blades in against the ribs as they rise.",
      "serratus_r": "Keeps the shoulder blades on the ribcage.",
      "serratus_l": "Keeps the shoulder blades on the ribcage.",
      "forearm_flexors_r": "Hold the dumbbells.",
      "forearm_flexors_l": "Hold the dumbbells.",
      "post_deltoid_r": "Keeps the arms hanging still.",
      "post_deltoid_l": "Keeps the arms hanging still.",
      "core": "Keeps the trunk still on the pad."
    }
