      "title": "Dumbbell Incline Shrug",
      "url": "https://gymvisual.com/videos/1369-dumbbell-incline-shrug.html",
      "listing": "Page not read (gymvisual.com is blocked by the proxy); movement taken from the exercise name and standard coaching practice.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper back (trapezius)",
    "secondaryBodyParts": [
      "Neck and shoulder girdle (levator scapulae)"
    ],
    "equipment": [
      "Dumbbell",
      "Adjustable bench"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (scapular elevation)",
    "plane": "Sagittal",
    "laterality": "Bilateral",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "upper_traps_r",
        "upper_traps_l"
      ],
      "synergist": [
        "rhomboids_midtrap_r",
        "rhomboids_midtrap_l",
        "serratus_r",
        "serratus_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "post_deltoid_r",
        "post_deltoid_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Breathe out as you shrug, breathe in as the shoulders lower.",
      "cadence": "About 1 s up, 1 s squeeze, about 2 s down"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "10-15",
      "effort": "Stop 1-3 reps short of failure (RIR 1-3)",
      "tempo": "2-1-1-0 (down-squeeze-up-bottom, seconds)",
      "rest": "60-90 s",
      "frequency": "2-3 times a week",
      "load": "User-chosen dumbbells; moderate, the grip often limits",
      "progression": "Add reps and a longer squeeze, then weight"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Set the bench to about 40 degrees. Straddle the seat with the chest on the pad, balls of the feet on the floor behind; arms hang straight outside the pad, palms in."
      },
      {
        "id": "c2",
        "phase": "shrug",
        "text": "Breathe out and lift the shoulders straight up toward the ears; the arms stay long."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Hold the top for a moment; chest stays on the pad, chin neutral."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and let the shoulders sink slowly back down to a full stretch."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Pause with the arms hanging, then repeat."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rolling the shoulders in circles",
        "fix": "Shrug straight up along the trunk and straight back down."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbows to help",
        "fix": "Keep the arms long; only the shoulders move."
      },
      {
        "id": "m3",
        "mistake": "Lifting the chest off the pad",
        "fix": "Keep the chest heavy on the pad."
      },
      {
        "id": "m4",
        "mistake": "Short, bouncy reps",
        "fix": "Pause at the top and lower all the way."
      }
    ],
    "kinematics": [
      {
        "measure": "Scapular elevation",
        "setup": "Shoulders relaxed down (clavicle elevation -4°)",
        "peak": "Clavicle elevation 22°: shoulders 8.3 cm higher along the trunk, hands 18.4 cm",
        "norm": "Shoulders lift straight up along the trunk; a shrug with the arms raised (30 degrees abduction) raised upper trapezius activity (Pizzari 2014)",
        "sources": [
          "pizzari2014"
        ]
      },
      {
        "measure": "Bench angle",
        "setup": "40° back pad, seat 45 cm; chest on the pad, head 5.6 cm past the top",
        "peak": "Unchanged (the trunk does not move)",
        "norm": "About 40 degrees, chest on the pad (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow flexion",
        "setup": "≈9° (arms long)",
        "peak": "Unchanged",
        "norm": "Arms straight and long (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Hang 0.7 s",
        "peak": "1.1 s up, 0.8 s squeeze, 1.8 s down, 0.6 s reset",
        "norm": "Pause at the top, slow lowering (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #1369, Dumbbell Incline Shrug, video (movement reference only; page not read)",
