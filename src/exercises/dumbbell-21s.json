      "listing": "Video; the page could not be read here (blocked), so the movement follows the name and standard coaching (7 lower-half, 7 upper-half and 7 full curls).",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Upper arms (biceps)",
    "secondaryBodyParts": [
      "Forearms"
    ],
    "equipment": [
      "Dumbbell"
    ],
    "difficulty": "Intermediate",
    "mechanics": "Isolation (elbow), partial and full ranges",
    "plane": "Sagittal",
    "laterality": "Bilateral (both arms together)",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "biceps_r",
        "biceps_l"
      ],
      "synergist": [
        "forearm_extensors_r",
        "forearm_extensors_l"
      ],
      "stabilizer": [
        "forearm_flexors_r",
        "forearm_flexors_l",
        "ant_deltoid_r",
        "ant_deltoid_l",
        "core"
      ]
    },
    "breathing": {
      "pattern": "Exhale on each curl up, inhale on each way down; keep breathing through the set, do not hold the breath for all 21 reps.",
      "cadence": "About 0.7 s up and 0.8 s down for the half reps, 1.2 s up and 2 s down for the full reps"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "21 (7 lower-half + 7 upper-half + 7 full)",
      "tempo": "Controlled, no swing; about 1 s up and 1-2 s down",
      "load": "User-chosen: about 60-70% of the weight used for normal curls",
      "frequency": "1-2 times a week as a finisher",
      "progression": "Slower lowering on the full reps, then a heavier dumbbell"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, a dumbbell in each hand, arms straight and palms forward; elbows by the sides."
      },
      {
        "id": "c2",
        "phase": "lowUp",
        "text": "Lower-half reps: curl only to the halfway point, forearms level."
      },
      {
        "id": "c3",
        "phase": "lowDown",
        "text": "Lower back to straight arms without letting the elbows drift."
      },
      {
        "id": "c4",
        "phase": "toMid",
        "text": "Curl to forearms level and hold there to start the upper-half reps."
      },
      {
        "id": "c5",
        "phase": "upUp",
        "text": "Upper-half reps: from forearms level, curl all the way up and squeeze."
      },
      {
        "id": "c6",
        "phase": "upDown",
        "text": "Lower only to forearms level, not past it."
      },
      {
        "id": "c7",
        "phase": "toBottom",
        "text": "After the upper-half reps, lower all the way to straight arms."
      },
      {
        "id": "c8",
        "phase": "fullUp",
        "text": "Full reps: curl all the way from straight arms to the top."
      },
      {
        "id": "c9",
        "phase": "squeeze",
        "text": "Squeeze at the top, elbows still by the sides."
      },
      {
        "id": "c10",
        "phase": "fullDown",
        "text": "Lower slowly all the way to straight arms."
      },
      {
        "id": "c11",
        "phase": "reset",
        "text": "Arms straight; in a real set each block is 7 reps before moving on."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Swinging the trunk to get through the last reps",
        "fix": "Pick a lighter dumbbell; the trunk stays still for all 21 reps."
      },
      {
        "id": "m2",
        "mistake": "Cutting the half reps short or letting them blend together",
        "fix": "Use forearms level as the turning point for both halves."
      },
      {
        "id": "m3",
        "mistake": "Elbows drifting forward on the upper half",
        "fix": "Keep the elbows by the ribs; only the forearms move."
      },
      {
        "id": "m4",
        "mistake": "Rushing the full reps",
        "fix": "Take 2 s or more to lower the last seven."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion (forearm to upper arm)",
        "setup": "≈8° (arm straight)",
        "peak": "≈137° at the top (range ≈129°)",
        "norm": "Full range: mean elbow range was about 117-123 degrees across barbell, EZ-bar and alternating dumbbell curls (Marcolin 2018); 21s split it at about 90 degrees",
        "sources": [
          "marcolin2018"
        ]
      },
      {
        "measure": "Partial ranges",
        "setup": "Lower half: ≈8° to ≈90° (forearms level)",
        "peak": "Upper half: ≈90° to ≈137°; full rep ≈8° to ≈137°",
        "norm": "Lower half from straight arms to about 90 degrees, upper half from about 90 degrees to the top (standard 21s coaching); training the initial range gave larger arm-curl adaptations than the final range in Pedrosa 2023",
        "sources": [
          "pedrosa2023"
        ]
      },
      {
        "measure": "Forearm rotation (wrist pron channel, 0 = palm up/forward, 90 = thumb up)",
        "setup": "6° (palm forward/up)",
        "peak": "0° (palm forward/up)",
        "norm": "Supinated grip gave the highest biceps activity in the lifting phase (Coratella 2023)",
        "sources": [
          "coratella2023"
        ]
      },
      {
        "measure": "Upper arm from the trunk line (sagittal)",
        "setup": "≈-1°",
        "peak": "≈11° (elbow forward)",
        "norm": "Elbows stay near the sides; a small forward drift at the top is normal (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Arms straight 0.5 s",
        "peak": "Half reps 0.7 s up / 0.8 s down; full rep 1.2 s up, 0.2 s squeeze, 2 s down",
        "norm": "Controlled; half reps about 1.5 s each, full reps about 3 s (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #13339, Dumbbell 21s, video (movement reference)",
        "url": "https://gymvisual.com/videos/13339-dumbbell-21s.html"
      },
      {
        "id": "marcolin2018",
        "title": "Marcolin et al. 2018, differences in electromyographic activity of biceps brachii and brachioradialis while performing three variants of curl (PeerJ 6:e5165; PMC6047503)",
        "url": "https://peerj.com/articles/5165"
      },
      {
        "id": "coratella2023",
        "title": "Coratella et al. 2023, biceps brachii and brachioradialis excitation in biceps curl exercise: different handgrips, different synergy (Sports 11(3):64; PMC10054060)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/36976950/"
      },
      {
        "id": "pedrosa2023",
        "title": "Pedrosa, Simoes, Figueiredo, Lacerda, Schoenfeld, Lima, Chagas and Diniz 2023, training in the initial range of motion promotes greater muscle adaptations than at final in the arm curl (Sports 11(2):39; PMC9960616)",
        "url": "https://www.mdpi.com/2075-4663/11/2/39"
      }
    ],
    "safety": {
      "cautions": [
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Stop if you feel sharp, radiating or nerve-type pain.",
        "Elbow or shoulder pain: lighten the dumbbells and shorten the set; stop if pain is sharp (clinical opinion).",
        "Keep the wrists straight, in line with the forearms.",
        "21 reps under tension cause a strong burn; use a load clearly lighter than for normal curls.",
        "Pick the dumbbells up and set them down with a straight back and bent knees."
      ],
      "modify": [
        "Fewer reps per block (5-5-5 = 15s).",
        "Seated, back against a bench, to stop the swing."
      ],
      "regressions": [
        "Lighter dumbbells.",
        "Normal dumbbell biceps curl.",
        "One arm at a time."
      ],
      "progressions": [
        "Slower lowering on every rep.",
        "Heavier dumbbells.",
        "Add a 1 s pause at the halfway point on each rep."
      ]
    },
    "muscleNotes": {
      "biceps_r": "Prime mover through both half ranges and the full range; the long time under tension is the point of 21s (clinical opinion). Supinated grip gave the highest biceps activity in Coratella 2023.",
      "biceps_l": "Prime mover through both half ranges and the full range; the long time under tension is the point of 21s (clinical opinion). Supinated grip gave the highest biceps activity in Coratella 2023.",
      "forearm_extensors_r": "Brachioradialis (drawn with the forearm extensors) assists elbow flexion, most near the middle of the range (Marcolin 2018).",
      "forearm_extensors_l": "Brachioradialis (drawn with the forearm extensors) assists elbow flexion, most near the middle of the range (Marcolin 2018).",
      "forearm_flexors_r": "Grip the dumbbells (clinical opinion).",
      "forearm_flexors_l": "Grip the dumbbells (clinical opinion).",
      "ant_deltoid_r": "Holds the upper arm still beside the trunk (clinical opinion).",
      "ant_deltoid_l": "Holds the upper arm still beside the trunk (clinical opinion).",
      "core": "Keeps the trunk still so the arms do the work (clinical opinion)."
    }
