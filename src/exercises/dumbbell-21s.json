    "id": "dumbbell-21s",
    "name": "Dumbbell 21s",
    "aliases": [
      "Dumbbell 21 curls",
      "21s biceps curl",
      "Dumbbell 7-7-7 curl"
    ],
    "reference": {
      "source": "GymVisual",
