  "exercise": {
    "id": "crunch-arms-straight",
    "name": "Crunch (Arms Straight)",
    "aliases": [
      "Straight-arm crunch",
      "Reaching crunch",
      "Arms-forward curl-up"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "5038",
      "title": "Crunch (arms straight)",
      "url": "https://gymvisual.com/videos/5038-crunch-arms-straight.html",
      "listing": "Page could not be read (gymvisual.com is blocked by the network proxy); movement taken from the exercise name and standard coaching practice",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Waist (abdominals)",
    "secondaryBodyParts": [
      "Core"
    ],
    "equipment": [
      "Body weight",
      "Exercise mat (optional)"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (spinal flexion, mostly thoracic)",
    "plane": "Sagittal",
    "laterality": "Bilateral, symmetric",
    "authoredSide": "bilateral",
    "muscles": {
      "target": [
        "core"
      ],
      "synergist": [
        "obliques_r",
        "obliques_l"
      ],
      "stabilizer": [
        "hip_flexors_r",
        "hip_flexors_l"
      ]
    },
    "breathing": {
      "pattern": "Exhale as you curl up, inhale as you lower. Do not hold the breath at the top.",
      "cadence": "About 1 s up, a short squeeze, about 1.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-20",
      "tempo": "About 1 s up, brief pause, 1.5-2 s down",
      "frequency": "2-3 times a week",
      "progression": "Slower lowering and a 2 s hold, then hands behind the head, then arms overhead"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on your back, knees bent about 90 degrees, feet flat and hip width, arms straight by your sides."
      },
      {
        "id": "c2",
        "phase": "curl",
        "text": "Breathe out and curl the head, shoulders and shoulder blades off the mat as the straight arms reach forward toward the knees."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Short squeeze at the top, hands beside the knees. Low back stays on the mat."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly, shoulder blades first, head last; arms return beside you."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Head rests briefly; repeat without bouncing."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Throwing the arms forward to swing up",
        "fix": "Let the trunk lead; the arms only follow the curl."
      },
      {
        "id": "m2",
        "mistake": "Chin jammed to the chest",
        "fix": "Keep a fist-sized gap under the chin and look toward the knees."
      },
      {
        "id": "m3",
        "mistake": "Sitting all the way up (hip flexors take over)",
        "fix": "Stop once the shoulder blades clear the mat; the low back stays down."
      },
      {
        "id": "m4",
        "mistake": "Shrugging the shoulders to the ears",
        "fix": "Reach long through the fingertips with the shoulders down."
      }
    ],
    "kinematics": [
      {
        "measure": "Upper trunk (T12 to C7) from the floor",
        "setup": "≈-1°",
        "peak": "≈32° (C7 up 18.2 cm)",
        "norm": "Head, shoulders and shoulder blades clear the mat; no study fixes the angle (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Lumbar flexion",
        "setup": "≈-5° (slight lordosis)",
        "peak": "≈-2° (low back stays on the mat)",
        "norm": "Small: about 3 degrees of lumbar flexion in a crunch, cited by Escamilla 2016 from earlier work",
        "sources": [
          "escamilla2016"
        ]
      },
      {
        "measure": "Thoracic flexion (T12 and T6 segments)",
        "setup": "≈7° (resting curve)",
        "peak": "≈45° (+37°)",
        "norm": "Most of the curl happens here (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Arms",
        "setup": "Arms by the sides on the mat (shoulder elevation ≈6°)",
        "peak": "Shoulder elevation ≈52°, elbows straight; fingertips 3 cm short of the knees",
        "norm": "Straight arms reach forward, roughly parallel to the thighs (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Hip and knee",
        "setup": "Hip ≈45°, knee ≈90°",
        "peak": "Unchanged (pelvis and feet still)",
        "norm": "Knees about 90 degrees, feet flat; the pelvis and legs do not move (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Rest 0.8 s",
        "peak": "1.0 s up, 0.5 s squeeze, 1.6 s down, 1.1 s rest",
        "norm": "Controlled, about 1 s up and 1.5-2 s down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
