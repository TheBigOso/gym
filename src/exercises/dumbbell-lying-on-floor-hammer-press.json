    "safety": {
      "cautions": [
        "To start, sit with the dumbbells on the thighs and roll back, bringing them to the chest; reverse this to finish (clinical opinion).",
        "Keep the wrists straight over the forearms.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: this short range is often comfortable; keep the elbows tucked."
      ],
      "regressions": [
        "Push-up on the knees."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Pause 2 s on the floor.",
        "Dumbbell lying hammer press on a bench (longer range)."
      ]
    },
    "muscleNotes": {
      "triceps_r": "Straightens the elbow; the short floor range and tucked elbows bias the triceps (clinical opinion).",
      "triceps_l": "As the right side.",
      "pec_r": "Pushes the arm up and in.",
      "pec_l": "As the right side.",
      "ant_deltoid_r": "Flexes the shoulder.",
      "ant_deltoid_l": "As the right side.",
      "serratus_r": "Holds the shoulder blade on the rib cage.",
      "serratus_l": "As the right side.",
      "biceps_r": "Steadies the elbow (Saeterbakken 2011).",
      "biceps_l": "As the right side.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
      "infraspinatus_r": "Centres the head of the upper arm.",
      "infraspinatus_l": "As the right side.",
      "core": "Keeps the trunk still on the floor."
