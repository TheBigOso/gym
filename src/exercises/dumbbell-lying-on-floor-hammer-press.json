    "breathing": {
      "pattern": "Inhale as you lower the dumbbells, exhale as you press them up.",
      "cadence": "About 1.8 s down, 0.4 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "Add reps up to the top of the range, then move to the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the mat, knees bent and feet flat; dumbbells straight up over the chest, palms facing each other."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the dumbbells, elbows tucked about 30 degrees from the sides, forearms vertical."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Let the backs of the upper arms rest on the floor for a moment, handles along the body."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press straight up, palms still facing."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight over the chest; pause, then lower again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Elbows slamming into the floor",
        "fix": "Lower under control and just touch."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep them close to the ribs."
      },
      {
        "id": "m3",
        "mistake": "Bouncing off the floor",
        "fix": "Pause with the arms resting, then press."
      },
      {
        "id": "m4",
        "mistake": "Wrists bending back",
        "fix": "Keep the forearms vertical and the wrists straight."
      }
    ],
    "kinematics": [
      {
        "measure": "Elbow flexion",
        "setup": "≈3° (arms straight, not locked)",
        "peak": "≈102° with the upper arms on the floor",
        "norm": "Arms straight but not locked at the top; elbows about 90 degrees with the upper arms on the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Elbow tuck",
        "setup": "Arms vertical over the chest, palms facing",
        "peak": "≈30° from the trunk at the bottom",
        "norm": "About 20-40 degrees from the trunk with the neutral grip (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Range of motion",
        "setup": "Dumbbell centre 66.3 cm above the floor at the top",
        "peak": "36.9 cm at the bottom: 29.4 cm of travel",
        "norm": "Shorter than a bench press: the floor stops the elbows about level with the back (Martínez-Cava 2019)",
        "sources": [
          "martinezcava2019"
        ]
      },
      {
        "measure": "Upper arm on the floor",
        "setup": "–",
        "peak": "Arm shapes 0 cm above the floor (resting)",
        "norm": "Back of the upper arm rests briefly on the floor at the bottom (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Knee flexion (feet planted)",
        "setup": "≈80°, feet 32 cm apart",
        "peak": "Unchanged (feet planted)",
        "norm": "Feet flat, knees bent about 70-90 degrees (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Top 0.8 s",
        "peak": "1.8 s down, 0.4 s pause on the floor, 1.2 s up, 0.8 s at the top",
        "norm": "About 2 s down, a short pause with the arms on the floor, 1-1.5 s up (clinical opinion)",
        "sources": []
      }
