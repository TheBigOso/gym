{
  "schemaVersion": "1.0.0",
  "rig": {
    "ref": "reprig-studio-clay-v2"
  },
  "exercise": {
    "id": "cable-standing-hip-flexion",
    "name": "Cable Standing Hip Flexion",
    "aliases": [
      "Cable straight-leg raise",
      "Standing cable leg raise forward",
      "Ankle-strap hip flexion"
    ],
    "reference": {
      "source": "GymVisual",
      "productRef": "19019",
      "title": "Cable Standing Hip Flexion",
      "url": "https://gymvisual.com/videos/19019-cable-standing-hip-flexion-male.html",
      "listing": "Catalog entry only (gymvisual.com not read; blocked by the proxy). Movement from the exercise name and standard coaching.",
      "note": "Reference used only to identify the movement. No GymVisual media is stored here; this rig, model and animation are original."
    },
    "type": "Strength",
    "bodyPart": "Hips (hip flexors)",
    "secondaryBodyParts": [
      "Thighs",
      "Core"
    ],
    "equipment": [
      "Cable machine (low pulley)",
      "Ankle strap"
    ],
    "difficulty": "Beginner",
    "mechanics": "Isolation (hip flexion)",
    "plane": "Sagittal",
    "laterality": "Unilateral",
    "authoredSide": "right",
    "muscles": {
      "target": [
        "hip_flexors_r"
      ],
      "synergist": [
        "quads_r"
      ],
      "stabilizer": [
        "glute_med_l",
        "glute_max_l",
        "core",
        "calves_l"
      ],
      "lengthened": [
        "hamstrings_r",
        "glute_max_r"
      ]
    },
    "breathing": {
      "pattern": "Exhale as the leg rises, inhale as it returns.",
      "cadence": "About 1.2 s up, 0.5 s hold, 1.8 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "10-15 per side",
      "tempo": "1-0.5-2-0",
      "frequency": "2-3 times a week",
      "rest": "45-75 s",
      "progression": "Add a plate on the stack once 15 controlled reps are easy"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Strap the right ankle to the low pulley behind you; stand tall on the left leg, hands on the hips."
      },
      {
        "id": "c2",
        "phase": "up",
        "text": "Breathe out and swing the long right leg forward and up, toes pointing ahead."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Pause with the trunk tall; do not lean back."
      },
      {
        "id": "c4",
        "phase": "down",
        "text": "Breathe in and let the cable draw the leg back slowly."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stop with the foot just behind the body; repeat, then switch legs."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Leaning back to lift higher",
        "fix": "Stay tall; stop where the pelvis starts to tuck."
      },
      {
        "id": "m2",
        "mistake": "Bending the knee a lot",
        "fix": "Keep the knee long so the hip flexors do the work."
      },
      {
        "id": "m3",
        "mistake": "Letting the stack pull the leg back fast",
        "fix": "Control the return."
      },
      {
        "id": "m4",
        "mistake": "Standing too close to the tower",
        "fix": "Step out until the cable has tension with the leg under the hip."
      }
    ],
    "kinematics": [
      {
        "measure": "Hip flexion",
        "setup": "≈-6° (leg just behind the body)",
        "peak": "≈52° (channel); leg 49° forward of vertical, knee ≈6°",
        "norm": "About 45-60 degrees with the knee near straight (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Trunk",
        "setup": "Tall",
        "peak": "≤5° from vertical",
        "norm": "Tall, no backward lean (Escamilla 2006, trunk stability under limb load)",
        "sources": [
          "escamilla2006"
        ]
      },
      {
        "measure": "Cable line",
        "setup": "Pulley behind at ankle height; cable 71 cm",
        "peak": "Cable 162 cm; clears the body by 6.2 cm or more",
        "norm": "Low pulley behind the strapped ankle (standard setup)",
        "sources": []
      },
      {
        "measure": "Tempo",
        "setup": "Stand 0.8 s",
        "peak": "1.2 s up, 0.5 s hold, 1.8 s down",
        "norm": "Controlled, slower down (clinical opinion)",
        "sources": []
      }
    ],
    "sources": [
      {
        "id": "gymvisual",
        "title": "GymVisual #19019, Cable Standing Hip Flexion, video (movement reference)",
        "url": "https://gymvisual.com/videos/19019-cable-standing-hip-flexion-male.html"
      },
      {
        "id": "escamilla2006",
        "title": "Escamilla et al. 2006, electromyographic analysis of traditional and nontraditional abdominal exercises (Phys Ther 86(5):656-671)",
        "url": "https://scholars.csus.edu/esploro/outputs/journalArticle/Electromyographic-Analysis-of-Traditional-and-Nontraditional/99257847129401671"
      }
    ],
    "safety": {
      "cautions": [
        "Stop if sharp pain, numbness or cramping occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG.",
        "Check the strap is snug and the clip is closed before each set."
      ],
      "modify": [
        "Poor balance: one hand on the machine.",
        "Hip pinching at the top: lower range."
      ],
      "regressions": [
        "Standing knee raise without load."
      ],
      "progressions": [
        "Heavier stack.",
        "Longer pause at the top."
      ]
    },
    "muscleNotes": {
      "hip_flexors_r": "Iliopsoas and rectus femoris lift the leg against the cable (clinical opinion).",
      "quads_r": "Rectus femoris crosses the hip and keeps the knee long (clinical opinion).",
      "glute_med_l": "Holds the pelvis level on the stance leg (Boren 2011).",
      "glute_max_l": "Keeps the stance hip tall (clinical opinion).",
      "core": "Stops the trunk leaning back as the leg rises (Escamilla 2006).",
      "calves_l": "Balance (clinical opinion).",
      "hamstrings_r": "Lengthen at the top (clinical opinion).",
      "glute_max_r": "Lengthens at the top (clinical opinion)."
    }
  },
