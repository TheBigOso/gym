    "safety": {
      "cautions": [
        "Use light dumbbells and keep them at the shoulders during the turn.",
        "Lower back discomfort: put the heels down and lean back less; avoid this variation with current low back pain (Marshall and McGill 2010 relate repeated loaded twisting to disc stress).",
        "Shoulder pain overhead: press only partway up.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Heels on the floor (Russian twist with press, feet down).",
        "One dumbbell held at the chest for the turns."
      ],
      "regressions": [
        "Russian twist (bodyweight).",
        "Seated dumbbell shoulder press."
      ],
      "progressions": [
        "Legs straighter (longer lever).",
        "Slightly heavier dumbbells."
      ]
    },
    "muscleNotes": {
      "core": "Holds the leaned-back V-sit against the weight of the legs and the pressed dumbbells (Escamilla 2006; Konrad 2001).",
