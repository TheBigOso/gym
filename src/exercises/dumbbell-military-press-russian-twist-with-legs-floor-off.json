    "breathing": {
      "pattern": "Exhale as you press and as you turn; inhale as you lower the dumbbells and come back to the middle.",
      "cadence": "About 1.1 s up, 1.3 s down, 1.8 s per turn"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "4-6 press-and-twist cycles (each cycle: press, turn right, press, turn left)",
      "tempo": "Controlled; no swinging",
      "frequency": "1-2 times a week",
      "load": "Light dumbbells: balance and the long lever of the arms limit the load. Pick a weight you can press for the target reps with 2-3 reps in reserve (RIR 2-3) while the feet stay up.",
      "progression": "Add cycles, then slightly heavier dumbbells; straighten the legs further to make it harder."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Sit on the mat, lean back about 45 degrees with a long spine, knees bent and feet lifted just off the floor; dumbbells at the shoulders, palms forward."
      },
      {
        "id": "c2",
        "phase": "press1",
        "text": "Breathe out and press both dumbbells up until the arms are straight over the shoulders; keep the feet up and the chest lifted."
      },
      {
        "id": "c3",
        "phase": "lower1",
        "text": "Breathe in and lower the dumbbells back to the shoulders under control."
      },
      {
        "id": "c4",
        "phase": "twistR",
        "text": "Holding them at the shoulders, breathe out and turn the chest to one side from the upper back, then return to the middle; the knees stay pointing forward."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Hold the V-sit; press again and turn to the other side."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Rounding the lower back and collapsing",
        "fix": "Keep a long spine and the chest lifted; lean back less if needed."
      },
      {
        "id": "m2",
        "mistake": "Feet dropping to the floor",
        "fix": "Keep the knees bent and the feet just off the floor; put the heels down to regress."
      },
      {
        "id": "m3",
        "mistake": "Swinging the knees with the turn",
        "fix": "Turn the chest, not the legs; knees keep pointing forward."
      },
      {
        "id": "m4",
        "mistake": "Pressing with the arms drifting behind the head",
        "fix": "Press up over the shoulders, slightly in front of the trunk line."
      },
      {
        "id": "m5",
        "mistake": "Rushing the turn",
        "fix": "Turn under control and pause briefly at the end."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk lean",
        "setup": "≈45° back from vertical (pelvis to C7)",
        "peak": "Held through the presses and turns",
        "norm": "About 45 degrees back from vertical with a neutral spine (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Legs",
        "setup": "Knees ≈90°, hips ≈91°, feet 10 cm off the floor",
        "peak": "Held off the floor (lowest 10 cm)",
        "norm": "Knees bent about 90 degrees, feet a few centimetres off the floor (clinical opinion)",
        "sources": []
      },
      {
        "measure": "Press",
        "setup": "Dumbbells at the shoulders, elbows ≈131°, palms forward",
        "peak": "Arms straight (elbows ≈13°), ≈18° from vertical",
        "norm": "From the shoulders to straight arms overhead (clinical opinion); seated dumbbell pressing loads the deltoids and triceps (Saeterbakken 2013)",
        "sources": [
          "saeterbakken2013"
        ]
      },
      {
        "measure": "Trunk rotation",
        "setup": "Facing the knees",
        "peak": "≈36° each way, dumbbells riding at the shoulders",
        "norm": "About 30-40 degrees each way, mostly thoracic; axial twisting under load should stay controlled (Marshall and McGill 2010; clinical opinion)",
        "sources": [
          "marshall2010"
