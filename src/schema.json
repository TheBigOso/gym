{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprig.app/schema/exercise-module/1.0.0",
  "title": "RepRig exercise module",
  "description": "One file per exercise: clinical metadata + keyframed pose data for a shared parametric rig. Angles in degrees, lengths in cm. World axes: +X forward, +Y up, +Z the figure's right. Author the right side; the player mirrors it for the left.",
  "type": "object",
  "required": [
    "schemaVersion",
    "rig",
    "exercise",
    "timeline",
    "poses",
    "keyframes"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "rig": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "description": "rigId of a shared rig file, e.g. reprig-female-165-v1"
        }
      },
      "additionalProperties": false
    },
    "exercise": {
      "$ref": "#/$defs/metadata"
    },
    "camera": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        },
        "presets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "yaw",
              "pitch"
            ],
            "properties": {
              "yaw": {
                "type": "number"
              },
              "pitch": {
                "type": "number",
                "minimum": -10,
                "maximum": 89
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "mat",
              "bench",
              "box",
              "barbell",
              "dumbbell",
              "kettlebell",
              "band",
              "cable",
              "cone",
              "stick",
              "ladder",
              "hurdle",
              "wall"
            ]
          },
          "center": {
            "$ref": "#/$defs/vec3"
          },
          "size": {
            "$ref": "#/$defs/vec3"
          },
          "attach": {
            "type": "object",
            "properties": {
              "joint": {
                "type": "string"
              },
              "offset": {
                "$ref": "#/$defs/vec3"
              }
            }
          },
          "rotY": {
            "type": "number",
            "description": "Yaw in degrees about +Y"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      },
      "description": "Equipment drawn in the player and exported to glTF. center = floor-contact point (cm); size = [x, y, z] extents (cm). cone: size[1] is height, size[0] base diameter; stick: size[0] is length, size[1] diameter."
    },
    "contacts": {
      "type": "array",
      "description": "Limbs solved with two-bone IK so planted hands/feet never slide. Targets are keyed in poses under ik.<id>.target.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "chain",
          "pole"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "chain": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3,
            "maxItems": 4
          },
          "pole": {
            "$ref": "#/$defs/vec3"
          },
          "handRot": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "World-locked end-effector rotation, quaternion [w,x,y,z]"
          },
          "bend": {
            "enum": [
              "forward",
              "back"
            ],
            "description": "Which way the middle joint points: knees forward, elbows back (default)."
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "required": [
        "duration",
        "phases"
      ],
      "properties": {
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "integer",
          "minimum": 24
        },
        "loop": {
          "type": "boolean"
        },
        "interpolation": {
          "enum": [
            "monotoneCubic",
            "linear"
          ]
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "start",
              "end",
              "breath"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number"
              },
              "breath": {
                "enum": [
                  "inhale",
                  "exhale",
                  "hold",
                  "natural"
                ]
              },
              "cue": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "poses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/pose"
      }
    },
    "keyframes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "t",
          "pose"
        ],
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0
          },
          "pose": {
            "type": "string"
          },
          "set": {
            "type": "object",
            "description": "Flat overrides, e.g. {\"ch.spine_t6.rot\": 22}",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "activation": {
      "type": "object",
      "description": "Per-muscle activation 0\u20131 over time: [[t, value], ...]. Keys are rig muscle ids with _r/_l suffix.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "path",
              "rotationArc",
              "gaze",
              "jointAngle"
            ]
          },
          "joint": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "radius": {
            "type": "number"
          },
          "normBand": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "description": "Per-exercise acceptance thresholds read by test/verify.mjs.",
      "properties": {
        "stillJoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joints that must not move (cm tolerance 0.05)."
        },
        "plantedContacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Contact ids whose target must stay fixed while weight is 1."
        },
        "measure": {
          "type": "object",
          "required": [
            "name",
            "min",
            "max"
          ],
          "properties": {
            "name": {
              "enum": [
                "shoulderLineIncl",
                "trunkFlexion",
                "kneeFlexion",
                "hipFlexion",
                "rootTravel"
              ]
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "description": "Peak value of a named measurement must fall in [min, max]."
        },
        "floorTolerance": {
          "type": "number",
          "description": "Lowest body point allowed below y=0 (cm), default 0.5."
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "pose": {
      "type": "object",
      "properties": {
        "root": {
          "type": "object",
          "properties": {
            "pos": {
              "$ref": "#/$defs/vec3"
            },
            "rot": {
              "type": "object",
              "properties": {
                "yaw": {
                  "type": "number"
                },
                "pitch": {
                  "type": "number"
                },
                "roll": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "ch": {
          "type": "object",
          "description": "Anatomical joint channels. spine/neck: flex,latFlex,rot \u00b7 clavicle(sc): protract,elevate \u00b7 shoulder: plane,elev,axial (ISB globe) \u00b7 elbow/knee: flex \u00b7 wrist: pron,flex,dev \u00b7 hip: flex,abd,rot \u00b7 ankle: dorsi",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "flex",
                "latFlex",
                "rot",
                "protract",
                "elevate",
                "plane",
                "elev",
                "axial",
                "pron",
                "dev",
                "abd",
                "dorsi"
              ]
            },
            "additionalProperties": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            }
          }
        },
        "ik": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "$ref": "#/$defs/vec3"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "bodyPart",
        "equipment",
        "difficulty",
        "muscles",
        "breathing",
        "cues",
        "mistakes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "productRef": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "listing": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "type": {
          "type": "string"
        },
        "bodyPart": {
          "type": "string"
        },
        "secondaryBodyParts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "difficulty": {
          "enum": [
            "Beginner",
            "Intermediate",
            "Advanced"
          ]
        },
        "mechanics": {
          "type": "string"
        },
        "plane": {
          "enum": [
            "Sagittal",
            "Frontal",
            "Transverse",
            "Multiplanar"
          ]
        },
        "laterality": {
          "type": "string"
        },
        "authoredSide": {
          "enum": [
            "right",
            "left",
            "bilateral"
          ],
          "description": "bilateral: symmetric exercise; the player's side switch only mirrors the view and the GLB has one clip."
        },
        "muscles": {
          "type": "object",
          "required": [
            "target",
            "synergist"
          ],
          "properties": {
            "target": {
              "$ref": "#/$defs/ids"
            },
            "synergist": {
              "$ref": "#/$defs/ids"
            },
            "stabilizer": {
              "$ref": "#/$defs/ids"
            },
            "lengthened": {
              "$ref": "#/$defs/ids"
            }
          },
          "additionalProperties": false
        },
        "muscleNotes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "breathing": {
          "type": "object",
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string"
            },
            "cadence": {
              "type": "string"
            }
          }
        },
        "prescription": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "phase": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "mistakes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "mistake",
              "fix"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "mistake": {
                "type": "string"
              },
              "fix": {
                "type": "string"
              }
            }
          }
        },
        "kinematics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "measure",
              "setup",
              "peak"
            ],
            "properties": {
              "measure": {
                "type": "string"
              },
              "setup": {
                "type": "string"
              },
              "peak": {
                "type": "string"
              },
              "norm": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "safety": {
          "type": "object",
          "properties": {
            "cautions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "modify": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "regressions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "progressions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "Who should avoid or modify the exercise, plus easier and harder versions."
        }
      }
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "uniqueItems": true
    }
  }
}