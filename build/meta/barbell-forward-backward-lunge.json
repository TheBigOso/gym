  "safety": {
   "cautions": [
    "Take the bar from a rack at about shoulder height; use clear floor space in front and behind.",
    "Start light: the moving base makes balance the limit.",
    "Keep the bar on the muscle of the upper back, never on the neck.",
    "Stop if sharp pain, numbness, tingling or giving-way occurs.",
    "Muscle glow colours and activation curves are illustrative, not measured EMG."
   ],
   "modify": [
    "Balance issues: do the forward and reverse halves as separate reps, or hold dumbbells instead.",
    "Knee pain: shorter range, or the reverse half only."
   ],
   "regressions": [
    "Bodyweight forward and reverse lunge.",
    "Barbell split squat (feet stay put)."
   ],
