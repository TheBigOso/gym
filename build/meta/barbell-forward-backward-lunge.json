  "breathing": {
   "pattern": "Breathe in as you step and lower, breathe out as you drive up; re-brace as the foot passes under you.",
   "cadence": "About 3.5 s for the forward lunge and 3.5 s for the reverse lunge, without stopping in between"
  },
  "prescription": {
   "sets": "2-4",
   "reps": "6-10 per leg (one rep = forward and back)",
   "tempo": "Controlled, no pause between halves",
   "frequency": "1-2 times a week",
   "load": "Barbell load is user-chosen and lighter than a static lunge: balance limits it. Leave about 2-3 reps in reserve (RPE 7-8).",
   "rest": "90-120 s between sets",
   "progression": "Heavier bar, then a short pause at the bottom of each half."
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Bar on the upper traps, hands just outside the shoulders, elbows down. Stand tall, feet hip width."
   },
   {
    "id": "c2",
    "phase": "step",
    "text": "Take a long step forward with the right foot, land heel first, back heel rolling up."
   },
   {
    "id": "c3",
    "phase": "lower",
    "text": "Drop straight down until the front knee is about 90 degrees and the back knee is just above the floor; trunk tall."
   },
   {
    "id": "c4",
    "phase": "push",
    "text": "Push off the front heel and bring the right foot back under the hip without stopping."
   },
   {
    "id": "c5",
    "phase": "stepBack",
    "text": "Keep going: reach the same foot straight back and land on its ball."
   },
   {
    "id": "c6",
    "phase": "lower2",
    "text": "Lower again, now with the left as the front leg, front shin about vertical."
   },
   {
    "id": "c7",
    "phase": "rise",
    "text": "Drive through the left heel and step the right foot back in."
   },
   {
    "id": "c8",
    "phase": "reset",
    "text": "Stand tall, re-brace."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Stepping too short so the front heel lifts",
    "fix": "Step long enough that the front shin is about vertical at the bottom."
   },
   {
    "id": "m2",
    "mistake": "Losing balance as the foot passes under the body",
    "fix": "Slow the swing and brace; the foot travels close to the floor."
   },
   {
    "id": "m3",
    "mistake": "Back knee slamming the floor",
    "fix": "Stop just above the floor and control each descent."
   },
   {
    "id": "m4",
    "mistake": "Trunk pitching forward",
    "fix": "Keep the chest up and the bar over the middle of the base."
   }
  ],
  "kinematics": [
   {
