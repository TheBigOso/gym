  "breathing": {
   "pattern": "Breathe out as you pull the handles down and out, breathe in as they rise and cross overhead.",
   "cadence": "About 1.3 s down, short squeeze, about 2 s up"
  },
  "prescription": {
   "sets": "2-4",
   "reps": "8-15",
   "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
   "rest": "60-90 s",
   "frequency": "1-2 times a week",
   "tempo": "1.3-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
   "load": "Stack load is user-chosen: pick a weight you can pull to beside the shoulders without leaning back.",
   "progression": "Add reps, then load; slower return"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Sit with the thighs under the roller; reach up and take the handles, which start high and close together over the head, palms forward."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Breathe out and pull the handles down and out to the sides on their arcs, elbows driving down toward the hips."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Squeeze with the hands beside the shoulders and the shoulder blades down and together."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Breathe in and let the handles swing back up and in over the head."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Let the lats stretch with the arms long overhead, shoulders not shrugged."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Leaning back to finish",
    "fix": "Stay upright; the arms move in the frontal plane."
   },
   {
    "id": "m2",
    "mistake": "Elbows drifting forward",
    "fix": "Pull the elbows down to the sides."
   },
   {
    "id": "m3",
    "mistake": "Rushing the return",
    "fix": "Take about 2 s on the way up."
   },
   {
    "id": "m4",
    "mistake": "Shrugging at the top",
    "fix": "Keep the shoulder blades set down."
   }
  ],
