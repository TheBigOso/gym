   "progression": "Heavier dumbbell, then hands off the floor"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Sit leaning back on your hands, dumbbell squeezed upright between the feet, legs extended off the floor."
   },
   {
    "id": "c2",
    "phase": "in",
    "text": "Breathe out, pull the knees to the chest and curl the trunk up to meet them."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Squeeze the abs; keep the feet off the floor."
   },
   {
    "id": "c4",
    "phase": "out",
    "text": "Breathe in, push the legs back out and lean back with control."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Hold the legs long just off the floor; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Letting the feet touch down",
    "fix": "Keep the legs hovering; make the range smaller if needed."
   },
   {
    "id": "m2",
    "mistake": "Arching the low back as the legs go out",
    "fix": "Keep the ribs down; stop the legs higher."
   },
   {
    "id": "m3",
    "mistake": "Losing the dumbbell",
    "fix": "Squeeze the handle with the feet flexed; use a light one."
   },
   {
    "id": "m4",
    "mistake": "Rocking with momentum",
    "fix": "Pause in and out."
   }
  ],
