  "prescription": {
   "sets": "2-4",
   "reps": "10-15 per side",
   "tempo": "1-0.5-2-0",
   "frequency": "2-3 times a week",
   "rest": "45-75 s",
   "progression": "Add a plate on the stack once 15 controlled reps are easy"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Strap the right ankle to the low pulley on your right; stand tall on the left leg, hands on the hips, leg drawn out by the cable."
   },
   {
    "id": "c2",
    "phase": "in",
    "text": "Breathe out and sweep the long right leg in, just in front of the stance foot."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Pause with the toes forward and the pelvis level."
   },
   {
    "id": "c4",
    "phase": "out",
    "text": "Breathe in and let the cable take the leg back out slowly."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stop at about 25 degrees out; repeat, then switch legs."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Leaning toward the tower",
    "fix": "Stay tall; the hip moves, not the trunk."
   },
   {
    "id": "m2",
    "mistake": "Swinging the leg through",
    "fix": "Slow in, pause, slower out."
   },
   {
    "id": "m3",
    "mistake": "Kicking the stance foot",
    "fix": "Let the leg pass a little in front of the stance foot."
   },
   {
    "id": "m4",
    "mistake": "Turning the toes out",
    "fix": "Keep the toes forward."
   }
  ],
