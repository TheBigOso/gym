  "prescription": {
   "sets": "2-3",
   "reps": "10-15",
   "tempo": "About 1 s up, 2 s hold, 1 s down",
   "load": "Body weight",
   "frequency": "2-4 times a week",
   "progression": "Longer holds, then light weights, then the incline-bench version"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie face down, legs long, arms straight overhead on the mat a little wider than the shoulders, thumbs up."
   },
   {
    "id": "c2",
    "phase": "lift",
    "text": "Keeping the arms straight, lift them off the mat in front of you; the legs stay down."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Hold, shoulders away from the ears, forehead just off the mat."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Lower the arms slowly back to the mat."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Relax, then repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Lifting the chest to get the arms up",
    "fix": "Keep the chest heavy; only the arms rise."
   },
   {
    "id": "m2",
    "mistake": "Shrugging into the ears",
    "fix": "Reach long and draw the shoulder blades down."
   },
   {
    "id": "m3",
    "mistake": "Bending the elbows",
    "fix": "Arms stay long."
   },
   {
    "id": "m4",
    "mistake": "Lifting the legs (superman)",
    "fix": "Legs stay relaxed on the mat."
   }
  ],
