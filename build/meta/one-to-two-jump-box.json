    "muscleNotes": {
      "quads_r": "Takeoff leg: extends the knee in the drive, then absorbs the landing with the other leg.",
      "glute_max_r": "Takeoff leg: drives hip extension. Single-leg takeoffs lean more on the hip than two-leg takeoffs.",
      "calves_r": "Takeoff leg: the last push through the ball of the foot (ankle plantarflexion).",
      "quads_l": "Shares the two-foot landing: controls knee bend into the quarter-to-half squat.",
      "glute_max_l": "Shares the landing: controls the hips sitting back.",
      "hamstrings_r": "Helps extend the hip at takeoff.",
      "adductors_r": "Adductor magnus helps extend the hip at takeoff.",
      "hip_flexors_l": "Swing leg: drives the free knee up so both feet meet in flight.",
      "hip_flexors_r": "Takeoff leg: pulls the knee up after toe-off to join the swing leg.",
      "calves_l": "Controls the ankle as the foot lands on the box.",
      "ant_deltoid_r": "Arm swing forward and up adds to the takeoff.",
      "ant_deltoid_l": "Arm swing forward and up adds to the takeoff.",
      "glute_med_r": "Keeps the takeoff knee over the foot and the pelvis level on one leg.",
      "glute_med_l": "Keeps the knees tracking over the toes on the landing.",
      "core": "Braces the trunk through takeoff, flight and landing.",
      "spinal_extensors_r": "Holds the inclined trunk at takeoff and on the landing.",
      "spinal_extensors_l": "Holds the inclined trunk at takeoff and on the landing."
    },
    "breathing": {
      "pattern": "Inhale as you step into the stagger and load; exhale sharply as you drive off the takeoff leg; hold a brace through flight and the landing; breathe normally as you stand and step down.",
      "cadence": "About 1.2 s set and load, 0.4 s drive, 0.4 s flight, 0.7 s land and stick, then a calm step down and reset"
    },
    "prescription": {
      "sets": "3–5",
      "reps": "3–5 per takeoff leg; never to failure",
      "rest": "Full rest between sets (sources give no seconds; 60–90 s is an unsourced app default)",
      "frequency": "2–3 sessions per week, 48–72 h between plyometric sessions",
      "boxHeight": "Start at 30–46 cm; raise it only while the landing stays quiet, balanced and in a half squat",
      "tempo": "Explosive takeoff, soft stick, step down under control"
    },
    "cues": [
      {
        "id": "j1",
        "phase": "setup",
        "text": "Stand tall a short step behind the box (toes about 30–35 cm away), arms at your sides, light brace."
      },
      {
        "id": "j2",
        "phase": "stagger",
        "text": "Step the other foot back into a staggered stance with the takeoff foot in front. Breathe in."
      },
      {
        "id": "j3",
        "phase": "load",
        "text": "Hinge slightly forward, bend into the front leg and draw both arms back."
      },
      {
        "id": "j4",
        "phase": "drive",
        "text": "Drive off the front leg through hip, knee and ankle as both arms swing forward and up. Breathe out on the drive."
      },
      {
        "id": "j5",
        "phase": "flight",
        "text": "Pull the free knee up and bring the takeoff leg to meet it, so both feet arrive together."
      },
      {
        "id": "j6",
        "phase": "land",
        "text": "Land softly on both feet, whole feet on the box top. Hips back into a quarter-to-half squat, knees over toes, arms forward. Stick it for a beat."
      },
      {
        "id": "j7",
        "phase": "stand",
        "text": "Stand up tall on the box."
      },
      {
        "id": "j8",
        "phase": "stepdown",
        "text": "Step down backward one foot at a time; do not jump down."
      },
      {
        "id": "j9",
        "phase": "reset",
        "text": "Step back to the start, reset, then repeat or switch takeoff leg."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Box too high: tucking the knees hard to clear the edge and landing in a deep squat",
        "fix": "Use a lower box. Land in about the same half squat you took off from."
      },
      {
        "id": "m2",
        "mistake": "Stiff, straight-knee or loud landing",
        "fix": "Land quietly with soft knees and hips back so the big muscles absorb the load."
      },
      {
        "id": "m3",
        "mistake": "Knees caving inward on takeoff or landing",
        "fix": "Keep the knees over the middle toes. Lower the box or go back to two-foot takeoffs until it is clean."
      },
      {
        "id": "m4",
        "mistake": "Toes catching the box edge, or landing half on the box",
        "fix": "Start close enough, jump up and slightly forward, and land with whole feet on the box top."
      },
      {
        "id": "m5",
        "mistake": "One foot lands first, or the weight shifts to the takeoff side",
        "fix": "Bring the takeoff leg up to meet the swing leg in flight and land both feet at once."
      },
      {
        "id": "m6",
        "mistake": "Jumping backward off the box",
        "fix": "Step down. Jumping down turns every rep into a drop landing with extra Achilles and knee load."
      },
      {
        "id": "m7",
        "mistake": "Only training the dominant takeoff leg",
        "fix": "Alternate legs and match reps per side."
      }
    ],
    "kinematics": [
      {
