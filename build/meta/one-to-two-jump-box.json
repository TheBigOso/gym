    "safety": {
      "cautions": [
        "Slipping off the box edge causes most box jump lower-leg wounds: use a foam or soft-top box on a non-slip floor and land with whole feet on the top.",
        "The takeoff leg takes roughly 3 × body weight; stop the set if landings get loud, stiff or uneven. Do not train it fatigued.",
        "Step down, never jump down."
      ],
      "modify": [
        "Acute or subacute ankle or knee sprain, acute inflammation, recent surgery, joint instability, history of stress injuries or poor base strength: use a low box, a two-foot takeoff or a step-up instead.",
        "Knee pain, patellar or Achilles tendinopathy, or prior ACL injury: get clinician clearance; keep the box low and use step-downs only.",
        "Knees caving in or stiff landings: go back to landing drills first; technique feedback raises landing knee flexion within a few sessions."
      ],
      "regressions": [
        "Two-foot takeoff box jump onto a low box.",
        "Lower box (30 cm).",
        "Step-up with a knee drive."
      ],
      "progressions": [
        "Raise the box gradually while the landing stays quiet and in a half squat.",
        "Single-leg landing (same-leg or opposite-leg) on a low box."
      ]
    }
