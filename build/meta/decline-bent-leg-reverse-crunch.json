  "breathing": {
   "pattern": "Exhale as you curl the hips up, inhale as you lower.",
   "cadence": "About 1.5 s up, a short pause, about 2 s down"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "10-15",
   "tempo": "1.5 s up, brief pause, 2 s down",
   "frequency": "2-3 times a week",
   "progression": "Steeper bench, slower lowering, then straight legs"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie head-up on the bench, hands gripping the roller behind the head, hips and knees bent about 90 degrees, feet off the board."
   },
   {
    "id": "c2",
    "phase": "raise",
    "text": "Breathe out and curl the hips off the board, bringing the knees toward the chest."
   },
   {
    "id": "c3",
    "phase": "top",
    "text": "Pause with the hips lifted; the upper back stays on the board."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Breathe in and roll the hips back down slowly, one vertebra at a time."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Thighs back to vertical; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Swinging the legs to throw the hips up",
    "fix": "Curl the pelvis with the abdominals, slowly."
   },
   {
    "id": "m2",
    "mistake": "Pulling hard with the arms",
    "fix": "The hands only anchor you."
   },
   {
    "id": "m3",
    "mistake": "Dropping the hips back down",
    "fix": "Lower in about 2 s."
   },
   {
    "id": "m4",
    "mistake": "Letting the knees straighten",
    "fix": "Keep the knee angle fixed."
   }
  ],
  "kinematics": [
   {
