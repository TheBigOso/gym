  "breathing": {
   "pattern": "Exhale as the leg rises, inhale as it returns.",
   "cadence": "About 1.2 s up, 0.5 s hold, 1.8 s down"
  },
  "prescription": {
   "sets": "2-4",
   "reps": "10-15 per side",
   "tempo": "1-0.5-2-0",
   "frequency": "2-3 times a week",
   "rest": "45-75 s",
   "progression": "Add a plate on the stack once 15 controlled reps are easy"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Strap the right ankle to the low pulley behind you; stand tall on the left leg, hands on the hips."
   },
   {
    "id": "c2",
    "phase": "up",
    "text": "Breathe out and swing the long right leg forward and up, toes pointing ahead."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Pause with the trunk tall; do not lean back."
   },
   {
    "id": "c4",
    "phase": "down",
    "text": "Breathe in and let the cable draw the leg back slowly."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stop with the foot just behind the body; repeat, then switch legs."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Leaning back to lift higher",
    "fix": "Stay tall; stop where the pelvis starts to tuck."
   },
   {
    "id": "m2",
    "mistake": "Bending the knee a lot",
    "fix": "Keep the knee long so the hip flexors do the work."
   },
   {
    "id": "m3",
    "mistake": "Letting the stack pull the leg back fast",
    "fix": "Control the return."
   },
   {
    "id": "m4",
    "mistake": "Standing too close to the tower",
    "fix": "Step out until the cable has tension with the leg under the hip."
   }
  ],
