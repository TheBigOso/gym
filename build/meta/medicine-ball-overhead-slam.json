   "pattern": "Inhale as the ball goes up, exhale forcefully as you slam.",
   "cadence": "About 0.9 s up, 0.6 s slam, 1.8 s pick-up"
  },
  "prescription": {
   "sets": "3-5",
   "reps": "6-10",
   "tempo": "Explosive down, controlled up",
   "frequency": "2-3 times a week",
   "rest": "60-90 s",
   "progression": "Heavier slam ball, or more reps at the same power"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand a little wider than hip width, ball at the chest in both hands."
   },
   {
    "id": "c2",
    "phase": "lift",
    "text": "Breathe in and reach the ball up overhead with long arms."
   },
   {
    "id": "c3",
    "phase": "slam",
    "text": "Breathe out hard and slam the ball to the floor just in front of your feet, hips back, knees bent."
   },
   {
    "id": "c4",
    "phase": "pick",
    "text": "Squat down, pick the ball up with a flat back and stand tall."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Ball back at the chest; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Slamming with a rounded back only",
    "fix": "Hinge at the hips and bend the knees; let the trunk follow."
   },
   {
    "id": "m2",
    "mistake": "Throwing the ball at the feet",
    "fix": "Aim just in front of the toes."
   },
   {
    "id": "m3",
    "mistake": "Bouncing ball to the face",
    "fix": "Use a dead (non-bouncing) slam ball."
   },
   {
    "id": "m4",
    "mistake": "Picking up with straight legs",
    "fix": "Squat down to the ball with a flat back."
   }
  ],
