  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie face down on the incline pad with the chest supported and the feet on the platform; take the lever handles, arms hanging straight."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Breathe out and row the handles up toward the lower ribs, elbows travelling back close to the body."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Squeeze the shoulder blades together with the chest still on the pad."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Breathe in and lower the lever along its arc until the arms are straight."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Let the shoulder blades spread at the bottom without losing the pad."
   }
  ],
  "mistakes": [
   {
