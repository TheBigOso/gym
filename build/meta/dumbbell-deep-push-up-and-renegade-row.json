    "safety": {
      "cautions": [
        "Use hex dumbbells on a non-slip floor; round dumbbells can roll out from under the hands.",
        "Keep the wrists straight over the handles; stop if the wrists hurt.",
        "Shoulder discomfort at the bottom: reduce the depth to a regular push-up.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Knees down for the push-up and the rows.",
        "Push-up on the floor, then the rows."
      ],
      "regressions": [
        "Dumbbell renegade row (no push-up).",
        "Push-up."
      ],
      "progressions": [
        "Heavier dumbbells.",
        "Slower lowering (3 s) in the push-up."
      ]
    },
