    "breathing": {
      "pattern": "Inhale on the way down, exhale as you push up; exhale on each row, inhale as you set the dumbbell down.",
      "cadence": "Push-up about 1.4 s down, 1 s up; each row about 1 s up, 1 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "5-8 cycles (one push-up and one row per arm)",
      "tempo": "Controlled; no hip swing",
      "frequency": "1-2 times a week",
      "load": "Hex dumbbells that sit flat (round ones can roll). Pick a weight you can row for the target reps with 2-3 reps in reserve (RIR 2-3) without the hips twisting.",
      "progression": "Add cycles, then heavier dumbbells; slow the lowering of the push-up."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "High plank gripping two hex dumbbells under the shoulders, handles along the body, feet wide on the balls of the feet, body in one straight line."
      },
      {
        "id": "c2",
        "phase": "down",
        "text": "Breathe in and lower the chest between the dumbbells, below the level of the hands, elbows about 45 degrees from the body."
      },
      {
        "id": "c3",
        "phase": "up",
        "text": "Breathe out and push back up to straight arms, the body moving as one piece."
      },
      {
        "id": "c4",
        "phase": "rowR",
        "text": "Brace, push the left dumbbell into the floor and row the right one to the lower ribs, elbow close; hips stay square to the floor."
      },
      {
        "id": "c5",
        "phase": "lowerR",
        "text": "Set the dumbbell down softly under the shoulder."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Re-brace in the plank; row the other side, then start the next push-up."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sagging in the deep push-up",
        "fix": "Squeeze the glutes and brace the abs; keep the body in one line."
      },
      {
        "id": "m2",
        "mistake": "Hips rotating during the row",
        "fix": "Widen the feet and push the supporting dumbbell into the floor."
      },
      {
        "id": "m3",
        "mistake": "Going deeper than the shoulders allow",
        "fix": "Stop where the shoulders are comfortable; the chest only needs to pass the hands."
      },
      {
        "id": "m4",
        "mistake": "Using round dumbbells",
        "fix": "Use hex dumbbells so they cannot roll under the hands."
      },
      {
        "id": "m5",
        "mistake": "Rushing the rows",
        "fix": "Pause briefly at the top and set the dumbbell down softly."
      }
    ],
