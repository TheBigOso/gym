   "pattern": "Breathe in and brace at the top, lower with the brace, breathe out as you stand.",
   "cadence": "About 2.2 s down, short pause, 1.3 s up"
  },
  "prescription": {
   "sets": "3",
   "reps": "10-15",
   "tempo": "2-1-1-1",
   "load": "User-chosen dumbbell, light to moderate; stop about 2-3 reps short of failure (RIR 2-3)",
   "frequency": "1-2 times a week",
   "progression": "Add load, then a pause at the bottom"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand tall, feet hip width, one dumbbell held upright against the chest, elbows down, knees soft."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Push the hips back and tip the chest forward with a flat back, the dumbbell staying on the chest."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Stop when the trunk is about level or the hamstrings are stretched."
   },
   {
    "id": "c4",
    "phase": "rise",
    "text": "Drive the hips forward and lift the chest to stand tall."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stand tall without leaning back; breathe and repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Rounding the back",
    "fix": "Stop where the back is still flat; think chest proud."
   },
   {
    "id": "m2",
    "mistake": "Bending the knees into a squat",
    "fix": "Keep the small knee bend steady and push the hips back."
   },
   {
    "id": "m3",
    "mistake": "Letting the dumbbell drift off the chest",
    "fix": "Hug it to the sternum the whole rep."
   }
  ],
