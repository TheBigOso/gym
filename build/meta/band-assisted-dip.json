  "breathing": {
   "pattern": "Inhale on the way down, exhale as you press up.",
   "cadence": "About 2 s down, a short pause, about 1.3 s up"
  },
  "prescription": {
   "sets": "3",
   "reps": "6-12",
   "tempo": "2 s down, brief pause, 1-1.5 s up",
   "frequency": "2-3 times a week",
   "progression": "Lighter bands as you get stronger, then unassisted dips"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stretch a band across the two bars, step up, kneel the shins on the band with the knees bent, arms straight on the bars."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in and lower by bending the elbows, trunk nearly upright; the band stretches under the shins."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Stop with the upper arms about parallel."
   },
   {
    "id": "c4",
    "phase": "press",
    "text": "Press back up, breathing out; the band helps most at the bottom."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Arms straight but not locked, shoulders down; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Bouncing out of the bottom on the band",
    "fix": "Pause at the bottom and press up under control."
   },
   {
    "id": "m2",
    "mistake": "Letting the knees slide off the band",
    "fix": "Keep the shins square on the band, knees together."
   },
   {
    "id": "m3",
    "mistake": "Shrugging the shoulders to the ears",
    "fix": "Keep the shoulders down and back."
   },
   {
    "id": "m4",
    "mistake": "Dropping too deep",
    "fix": "Stop at about parallel upper arms."
   }
  ],
  "kinematics": [
   {
    "measure": "Elbow flexion",
    "setup": "",
    "peak": "",
    "norm": "Arms straight but not locked at the top; elbow flexion at the bottom of a bar dip was larger than in a bench dip (McKenzie 2022); upper arms about parallel is a common limit (clinical opinion)",
    "sources": [
     "mckenzie2022"
    ]
   },
   {
    "measure": "Trunk lean",
    "setup": "",
    "peak": "",
    "norm": "Nearly upright, as in the triceps dip (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Upper arm angle to the floor",
    "setup": "",
    "peak": "",
    "norm": "Stop with the upper arms about parallel to the floor (clinical opinion); bar dips reached about 95% of the maximal shoulder extension range in the study group (McKenzie 2022)",
    "sources": [
     "mckenzie2022"
    ]
   },
   {
    "measure": "Body travel",
    "setup": "",
    "peak": "",
    "norm": "The body moves down and up between the bars; the feet stay off the floor (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Band",
    "setup": "",
    "peak": "",
    "norm": "The band runs from bar to bar under the shins and stretches as the body lowers (clinical opinion)",
    "sources": []
   }
  ],
