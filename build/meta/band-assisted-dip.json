  "safety": {
   "cautions": [
    "Shoulder: dips take the shoulder far into extension under body weight, which loads the front of the shoulder (McKenzie 2022); keep the range to upper arms about parallel and stop if the front of the shoulder hurts.",
    "Check the band for tears and anchor it securely; step off carefully so it does not snap back.",
    "Stop if sharp pain, numbness or tingling occurs.",
    "Muscle glow colours and activation curves are illustrative, not measured EMG."
   ],
   "modify": [
    "Shoulder discomfort: shorter range (stop with the elbows at about 60 degrees)."
   ],
   "regressions": [
    "Bench dip with the knees bent.",
    "Negative-only dips."
   ],
   "progressions": [
    "Slower lowering (3 s).",
    "Pause at the bottom."
   ]
  },
  "muscleNotes": {
   "triceps": "Same movement as the bar dip; the band takes part of the body weight, most at the bottom where it is stretched furthest (clinical opinion)."
  }
