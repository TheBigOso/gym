  "breathing": {
   "pattern": "Short, steady breaths through the hold with the brace on.",
   "cadence": "About one breath every 2 s during the 4 s hold"
  },
  "prescription": {
   "sets": "3-6",
   "reps": "1 hold per set",
   "tempo": "Hold 3-10 s, build toward 20-30 s",
   "frequency": "2-4 times a week",
   "progression": "Tuck sit, then one leg straight, then the full L-sit; parallettes give more clearance"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Sit with the legs straight and together, hands flat beside the hips, fingers forward."
   },
   {
    "id": "c2",
    "phase": "press",
    "text": "Lock the elbows, push the floor away and pull the shoulders down: the hips and legs lift off the mat together."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Legs straight and level, toes pointed, chest up; breathe in short breaths."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Lower the hips and heels back to the mat under control."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Rest, then repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Shrugging the shoulders up to the ears",
    "fix": "Push the floor away: shoulders down, long neck."
   },
   {
    "id": "m2",
    "mistake": "Bent knees or dropped heels",
    "fix": "Squeeze the quads and point the toes; regress to a tuck sit if needed."
   },
   {
    "id": "m3",
    "mistake": "Elbows bending",
    "fix": "Lock the arms straight."
   },
   {
    "id": "m4",
    "mistake": "Leaning far back",
    "fix": "Keep the shoulders roughly over the hands."
   }
  ],
  "kinematics": [
