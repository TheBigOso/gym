  "breathing": {
   "pattern": "Breathe out as the bar sweeps down to each hip, breathe in as it comes back up to the middle.",
   "cadence": "About 1 s to each side, 1 s back"
  },
  "prescription": {
   "sets": "3",
   "reps": "6-10 per side",
   "tempo": "Controlled",
   "load": "Light to moderate: control matters more than load (clinical opinion)",
   "frequency": "2 times a week",
   "progression": "Add a small plate, then a slower, longer arc"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand facing the landmine, feet wider than the hips; hold the end of the bar in both hands at arm's length in front of the chest."
   },
   {
    "id": "c2",
    "phase": "right",
    "text": "Breathe out and sweep the bar down to the outside of the right hip, letting the hips and chest turn with it; bring it back up through the middle."
   },
   {
    "id": "c3",
    "phase": "left",
    "text": "Sweep it down to the left hip the same way and back to the middle."
   },
   {
    "id": "c4",
    "phase": "reset",
    "text": "Arms stay long; the rotation comes from the hips and the trunk together."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Bending the elbows",
    "fix": "Keep the arms long; the bar travels on a wide arc."
   },
   {
    "id": "m2",
    "mistake": "Twisting only through the lower back",
    "fix": "Let the hips turn with the bar; the feet stay planted, knees soft."
   },
   {
    "id": "m3",
    "mistake": "Rushing and letting the bar pull you",
    "fix": "Control the bar down and stop it at the hip."
   },
   {
    "id": "m4",
    "mistake": "Rounding the back",
    "fix": "Stay tall with the chest up."
   }
  ],
  "kinematics": [
   {
    "measure": "Trunk rotation",
    "setup": "",
    "peak": "",
