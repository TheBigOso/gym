  "muscleNotes": {
   "obliques_l": "Main target: the obliques on the side away from the bar resist the trunk bending toward the load (Taylor & Reed 2020; clinical opinion).",
   "obliques_r": "Co-contract with the far side to keep the trunk stiff (clinical opinion).",
   "core": "Bracing keeps the trunk upright and still against the one-sided load (Taylor & Reed 2020); trunk muscles were among the most active in loaded carries (loaded carry activation, 2024).",
   "forearm_flexors_r": "Grip the bar at its middle; a long bar also tries to tip forward or back, which the grip resists (clinical opinion).",
   "forearm_extensors_r": "Steady the wrist so the bar stays level (clinical opinion).",
   "glute_med_l": "Keeps the pelvis level while standing on the left leg with the load on the right (clinical opinion).",
   "glute_med_r": "Keeps the pelvis level in the right-leg stance phases (clinical opinion).",
   "spinal_extensors_r": "Keep the trunk upright (clinical opinion).",
   "spinal_extensors_l": "Resist the pull toward the loaded side together with the obliques (clinical opinion).",
   "upper_traps_r": "Hold the loaded shoulder level instead of letting it drop (clinical opinion).",
   "lats_r": "Keep the loaded arm close to the side (clinical opinion).",
