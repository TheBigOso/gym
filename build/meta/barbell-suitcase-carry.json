  "prescription": {
   "sets": "3-4 each side",
   "reps": "20-40 m (or 20-40 s) per hand",
   "tempo": "Steady walk",
   "frequency": "2-3 times a week",
   "progression": "Longer distance, then more plates. Load is user-chosen: pick a weight you can carry with the trunk dead upright."
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand beside the barbell, hinge and grip it at its exact middle, then stand up tall; bar level and pointing forward, shoulders level, the free arm relaxed."
   },
   {
    "id": "c2",
    "phase": "walk",
    "text": "Walk with short, controlled steps; stay tall and do not lean toward or away from the bar."
   },
   {
    "id": "c3",
    "phase": "finish",
    "text": "Stop with the feet together, stay tall, then hinge to set the bar down; switch hands."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Leaning toward or away from the bar",
    "fix": "Brace and stay vertical; shoulders level."
   },
   {
    "id": "m2",
    "mistake": "Bar tipping forward or back",
    "fix": "Grip exactly at the middle (its balance point) and squeeze."
   },
   {
    "id": "m3",
    "mistake": "Loaded shoulder dropping",
    "fix": "Pull the shoulder up and back to level with the free side."
   },
   {
    "id": "m4",
    "mistake": "Long, bouncy steps",
    "fix": "Short, quiet steps keep the bar steady."
   }
  ],
