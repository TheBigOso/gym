    "text": "Walk the hands forward one at a time until you are in a high plank."
   },
   {
    "id": "c4",
    "phase": "plank",
    "text": "Hold a straight line from head to heels, hands under the shoulders."
   },
   {
    "id": "c5",
    "phase": "walkin",
    "text": "Walk the hands back toward the feet, hips rising."
   },
   {
    "id": "c6",
    "phase": "rise",
    "text": "Roll up to standing."
   }
  ],
