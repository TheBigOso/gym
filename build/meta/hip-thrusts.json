  "breathing": {
   "pattern": "Exhale as you drive the hips up, inhale as you lower.",
   "cadence": "About 1.2 s up, 0.8 s squeeze, 2 s down"
  },
  "prescription": {
   "sets": "2-4",
   "reps": "10-20",
   "tempo": "1-1-2-0",
   "frequency": "2-3 times a week",
   "progression": "Pause at the top, then single-leg hip thrust, then a dumbbell or barbell on the hips"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Shoulder blades on the bench edge, arms spread on the bench, feet flat about hip width."
   },
   {
    "id": "c2",
    "phase": "drive",
    "text": "Breathe out and drive through the heels to lift the hips."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Hips level with the shoulders, shins vertical, chin tucked. Squeeze the glutes."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Breathe in and lower the hips toward the floor under control."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stay on the bench and repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Arching the low back to get higher",
    "fix": "Stop when the trunk is level; keep the ribs down and the chin tucked."
   },
   {
    "id": "m2",
    "mistake": "Knees caving in",
    "fix": "Push the knees out in line with the toes."
   },
   {
    "id": "m3",
    "mistake": "Feet too far out (hamstrings cramp) or too close (knee strain)",
    "fix": "Place the feet so the shins are vertical at the top."
   },
   {
    "id": "m4",
    "mistake": "Back sliding along the bench",
    "fix": "Pivot on the shoulder blades; the bench edge stays under the same spot."
   },
   {
    "id": "m5",
    "mistake": "Pushing through the toes",
    "fix": "Keep the whole foot down and drive through the heels."
   }
  ],
  "kinematics": [
   {
