   "progression": "Add reps, then load; longer hold at the top"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand facing the machine with the chest against the pad and the feet flat; elbows bent about 90 degrees, the outsides of the arms just above the elbows against the pads."
   },
   {
    "id": "c2",
    "phase": "work",
    "text": "Breathe out and raise the elbows out to the sides on the lever arcs, leading with the elbows."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Hold with the upper arms about level with the shoulders; shoulders down from the ears."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Breathe in and lower the arms slowly back to the sides."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Pause with light tension, without letting the levers rest on their stops."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Shrugging the shoulders up",
    "fix": "Keep the shoulders down; lighten the load."
   },
