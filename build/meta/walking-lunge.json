  "breathing": {
   "pattern": "Inhale as you step and lower, exhale as you rise and bring the back foot through.",
   "cadence": "About 1 s down, about 1 s up per step"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "8-12 steps per leg",
   "tempo": "Controlled and continuous",
   "frequency": "1-3 times a week",
   "progression": "Hold dumbbells; add a pause at the bottom"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand tall, hands on hips, eyes forward."
   },
   {
    "id": "c2",
    "phase": "lungeR",
    "text": "Step forward and lower the back knee toward the floor."
   },
   {
    "id": "c3",
    "phase": "stepThrough",
    "text": "Drive through the front foot, rise and bring the back foot forward to stand."
   },
   {
    "id": "c4",
    "phase": "lungeL",
    "text": "Step forward with the other leg and repeat."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Keep the trunk tall and the steps in line."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Front knee caving inward",
    "fix": "Keep the front knee over the 2nd-3rd toe; shorten the range if needed."
   },
   {
    "id": "m2",
    "mistake": "Front heel lifting",
    "fix": "Lengthen the step and keep the weight in the front heel."
   },
   {
    "id": "m3",
    "mistake": "Back knee slamming the floor",
    "fix": "Lower under control and stop just above the floor."
   },
   {
    "id": "m4",
    "mistake": "Feet on a tightrope (stepping across the midline)",
    "fix": "Keep the feet hip width apart, like walking on two rails."
   }
  ],
  "kinematics": [
   {
    "measure": "Step length (ankle centres)",
    "setup": "",
    "peak": "",
