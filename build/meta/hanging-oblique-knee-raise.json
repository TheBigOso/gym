  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Hang from the bar, hands about shoulder width, legs together."
   },
   {
    "id": "c2",
    "phase": "raiseR",
    "text": "Draw the knees up and across toward the right elbow; the pelvis turns and the right side shortens."
   },
   {
    "id": "c3",
    "phase": "lowerR",
    "text": "Lower slowly to the centre hang without swinging."
   },
   {
    "id": "c4",
    "phase": "raiseL",
    "text": "Now up and across to the left side."
   },
   {
    "id": "c5",
    "phase": "lowerL",
    "text": "Lower slowly and settle the hang."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Swinging the legs side to side",
    "fix": "Lower to a still centre hang before each rep."
   },
   {
    "id": "m2",
    "mistake": "Only turning the legs (no trunk work)",
    "fix": "Lift the hip toward the ribs on the working side."
   },
   {
    "id": "m3",
    "mistake": "Shrugging",
    "fix": "Keep the shoulder blades set down."
   },
   {
    "id": "m4",
    "mistake": "Dropping the legs",
    "fix": "Lower in about 1.5 s."
   }
