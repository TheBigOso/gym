  "breathing": {
   "pattern": "Breathe out as the bar comes down to the chest, breathe in as it rises.",
   "cadence": "About 1.2 s down, short pause, about 2 s up"
  },
  "prescription": {
   "sets": "3-4",
   "reps": "8-15",
   "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
   "tempo": "1.2-0.4-2-0.5 (down-pause-up-stretch, seconds)",
   "rest": "60-120 s",
   "frequency": "1-3 times a week",
   "load": "Cable stack load is user-chosen: pick a weight you can pull to the upper chest without swinging back.",
   "progression": "Add reps, then one plate on the stack"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Kneel tall on a mat facing a high pulley, knees hip width, hips over the knees; hold the lat bar overhand a little wider than the shoulders, arms long reaching up."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Breathe out; draw the shoulder blades down and pull the bar in front of the face to the upper chest, elbows down and back."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Bar at the upper chest, ribs down, glutes tight so the hips stay over the knees."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Breathe in and let the bar rise under control until the arms are long."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Full stretch at the top without arching the lower back, then pull again."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Sitting back on the heels",
    "fix": "Squeeze the glutes and keep the hips over the knees."
   },
   {
    "id": "m2",
    "mistake": "Arching the lower back as the bar comes down",
    "fix": "Keep the ribs down and the trunk still."
   },
   {
    "id": "m3",
    "mistake": "Shrugging",
    "fix": "Lead each rep with the shoulder blades down."
   },
   {
    "id": "m4",
    "mistake": "Kneeling so close that the cable runs into the face",
    "fix": "Kneel back so the bar comes down in front of the face."
   }
  ],
