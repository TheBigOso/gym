   "progression": "Add reps, then plates; longer hold at the top"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand tall under the shoulder pads with the feet hip width and the knees soft; let the arms hang relaxed (no grip needed)."
   },
   {
    "id": "c2",
    "phase": "work",
    "text": "Breathe out and lift the shoulders straight up toward the ears against the pads."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Hold at the top for a moment."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Breathe in and lower the shoulders slowly to a full stretch."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Pause with the shoulders down, keeping tension."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Rolling the shoulders",
    "fix": "Lift straight up and lower straight down."
   },
   {
    "id": "m2",
    "mistake": "Bending the knees to bounce",
    "fix": "Keep the knees soft and still."
   },
   {
    "id": "m3",
    "mistake": "Head poking forward",
    "fix": "Keep the neck long and the chin level."
   },
   {
    "id": "m4",
    "mistake": "Short range",
    "fix": "Lower to a full stretch every rep."
   }
  ],
