  "breathing": {
   "pattern": "Breathe out as the legs rise and the pelvis curls, breathe in on the way down.",
   "cadence": "About 1.4 s up, 2 s down"
  },
  "prescription": {
   "sets": "3-4",
   "reps": "6-12",
   "tempo": "About 1.5 s up, brief hold, 2 s down",
   "load": "Body weight",
   "frequency": "2-3 times a week",
   "progression": "Higher raise (toes toward the bar), slower lowering, then ankle weights"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Hang from the bar, hands a little wider than the shoulders, legs together and straight."
   },
   {
    "id": "c2",
    "phase": "set",
    "text": "Pull the shoulders down away from the ears and brace."
   },
   {
    "id": "c3",
    "phase": "raise",
    "text": "Lift the straight legs in front; as they pass level, curl the pelvis up toward the ribs."
   },
   {
    "id": "c4",
    "phase": "top",
    "text": "Hold the curl for a moment, legs above level, no swing."
   },
   {
    "id": "c5",
    "phase": "lower",
    "text": "Uncurl the pelvis, then lower the legs slowly to the hang."
   },
   {
    "id": "c6",
    "phase": "reset",
    "text": "Stop the swing in the hang, then the next rep."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Swinging the body to throw the legs up",
    "fix": "Start each rep from a still hang; lower slowly so the body does not rock."
   },
   {
    "id": "m2",
    "mistake": "Only lifting the legs to level (hip flexors only)",
    "fix": "Finish with the pelvis curling up; that is the abdominal part of the rep."
   },
   {
    "id": "m3",
    "mistake": "Arching the low back at the bottom",
    "fix": "Keep the ribs down and the trunk braced in the hang."
   },
   {
    "id": "m4",
    "mistake": "Bending the knees more and more",
    "fix": "Keep the knees nearly straight; use the bent-knee version if needed."
   },
   {
    "id": "m5",
    "mistake": "Shrugging, shoulders by the ears",
    "fix": "Keep the shoulder blades set down through the rep."
   }
  ],
  "kinematics": [
   {
    "measure": "Hip flexion",
    "setup": "",
    "peak": "",
    "norm": "From about neutral in the hang to about 90-110 degrees, legs at or above level (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Pelvis and low back",
    "setup": "",
    "peak": "",
    "norm": "Posterior pelvic tilt and lumbar flexion at the top raise the abdominal demand; hanging leg raises are among the hardest abdominal exercises, with high spine compression (Axler and McGill 1997)",
