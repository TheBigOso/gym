  "breathing": {
   "pattern": "Breathe out as the bar comes down to the chest, breathe in as it rises.",
   "cadence": "About 1.2 s down, short pause, about 2 s up"
  },
  "prescription": {
   "sets": "3-4",
   "reps": "8-15",
   "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
   "tempo": "1.2-0.4-2-0.5 (down-pause-up-stretch, seconds)",
   "rest": "60-120 s",
   "frequency": "1-3 times a week",
   "load": "Cable stack load is user-chosen: pick a weight you can pull to the upper chest without swinging back.",
   "progression": "Add reps, then one plate on the stack"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Kneel tall on a mat midway between two high pulleys, one handle in each hand, arms long and reaching up and out toward the pulleys, palms forward."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Breathe out; draw the shoulder blades down and pull the elbows down and in toward the sides of the ribs, hands finishing beside the shoulders."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Elbows tucked to the ribs, chest up, shoulder blades down and together."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Breathe in and let the handles rise up and out along the same arc until the arms are long."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Full stretch at the top, ribs down, then pull again."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Arching the lower back as the handles come down",
    "fix": "Ribs down, glutes tight."
   },
   {
    "id": "m2",
    "mistake": "Pulling the hands in front of the chest like a fly",
    "fix": "Drive the elbows down to the sides; the hands stay over the elbows."
   },
   {
    "id": "m3",
    "mistake": "Shrugging at the top",
    "fix": "Start each rep by setting the shoulders down."
   },
   {
    "id": "m4",
    "mistake": "Sitting back on the heels",
    "fix": "Keep the hips over the knees."
   }
  ],
