    "breathing": {
      "pattern": "Exhale as each dumbbell presses up, inhale as it lowers.",
      "cadence": "Per side about 1.3 s up, 0.4 s at the top, 1.5 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "6-10 per side",
      "tempo": "1-0-2-0 (1 s up, 2 s down)",
      "frequency": "1-2 times a week",
      "load": "Light to moderate dumbbells: the side bend loads the spine, so pick a weight you can press for the target reps with 2-3 reps in reserve (RIR 2-3) and full control.",
      "progression": "Add reps, then a slightly heavier pair; keep the lean smooth and controlled."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, dumbbells in front of the shoulders at chin height, palms facing you, elbows down in front."
      },
      {
        "id": "c2",
        "phase": "pressR",
        "text": "Breathe out and press one dumbbell up, turning the palm forward and letting the elbow open to the side, while you bend sideways at the waist away from it."
      },
      {
        "id": "c3",
        "phase": "topR",
        "text": "Arm straight overhead, reaching up and over toward the opposite side; ribs and hips stay facing forward."
      },
      {
        "id": "c4",
        "phase": "lowerR",
        "text": "Breathe in and lower the dumbbell back to the shoulder as you straighten up, palm turning back toward you."
      },
      {
        "id": "c5",
        "phase": "switch",
        "text": "Both dumbbells at the shoulders, trunk upright; press the other side."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting instead of bending sideways",
        "fix": "Keep the chest and hips facing forward; the trunk bends straight to the side."
      },
      {
        "id": "m2",
        "mistake": "Leaning back and arching the lower back",
        "fix": "Brace the abs and keep the ribs down."
      },
      {
        "id": "m3",
        "mistake": "Bending too far with a heavy weight",
        "fix": "Keep the side bend moderate (about 10-20 degrees) and the weight light."
      },
      {
        "id": "m4",
        "mistake": "Pressing in front of the face",
        "fix": "Finish with the arm straight overhead, not out in front."
      },
      {
        "id": "m5",
        "mistake": "Dropping the waiting dumbbell",
        "fix": "Hold it in front of the shoulder while the other arm works."
      }
    ],
