  "breathing": {
   "pattern": "Brace and exhale as you rise, inhale as you lower.",
   "cadence": "About 1.6 s up, a short pause, about 2 s down"
  },
  "prescription": {
   "sets": "3",
   "reps": "4-8",
   "tempo": "1.5 s up, brief pause, 2-3 s down",
   "frequency": "1-2 times a week",
   "progression": "Hands pushing off a box for help, then full reps, then a plate at the chest"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Set the pad under the lower thighs, feet flat on the plate between the rollers, body straight and horizontal, arms crossed on the chest."
   },
   {
    "id": "c2",
    "phase": "raise",
    "text": "Drive the toes into the plate and curl the body up by bending the knees; keep the hips straight."
   },
   {
    "id": "c3",
    "phase": "top",
    "text": "Pause upright over the knees."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Lower slowly back to horizontal, hips still straight."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Body horizontal; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Bending at the hips (turns it into a back extension)",
    "fix": "Squeeze the glutes and keep knee, hip and shoulder in line."
   },
   {
    "id": "m2",
    "mistake": "Pad too far back (on the knees)",
    "fix": "Set it under the lower thighs so the knees can bend."
   },
   {
    "id": "m3",
    "mistake": "Dropping on the way down",
    "fix": "Lower in 2-3 s."
   },
   {
    "id": "m4",
    "mistake": "Arching the low back",
    "fix": "Brace the trunk."
   }
  ],
