  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Hang from the parallel handles, palms facing each other, arms straight, knees slightly bent."
   },
   {
    "id": "c2",
    "phase": "set",
    "text": "Pull the shoulder blades down before bending the arms."
   },
   {
    "id": "c3",
    "phase": "pull",
    "text": "Breathe out and drive the elbows down past the ribs until the chin rises above the handles."
   },
   {
    "id": "c4",
    "phase": "top",
    "text": "Pause with the chest up and the head between the bars."
   },
   {
    "id": "c5",
    "phase": "lower",
    "text": "Lower under control to a full hang."
   },
   {
    "id": "c6",
    "phase": "reset",
    "text": "Settle in the hang without swinging; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Kipping or swinging the legs",
    "fix": "Keep the legs still and pull with the arms and back."
   },
   {
    "id": "m2",
    "mistake": "Half reps",
    "fix": "Start from straight arms and finish with the chin above the handles."
   },
   {
    "id": "m3",
    "mistake": "Shrugging at the top",
    "fix": "Keep the shoulders down and back."
   },
   {
    "id": "m4",
    "mistake": "Craning the chin up",
    "fix": "Lift the chest, not just the chin."
   }
  ],
