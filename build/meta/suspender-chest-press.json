  "breathing": {
   "pattern": "Breathe in as the chest lowers between the hands, breathe out as you press back up.",
   "cadence": "About 2 s down, short pause, about 1.2 s up"
  },
  "prescription": {
   "sets": "3",
   "reps": "8-15",
   "tempo": "2-0-1-1",
   "load": "Bodyweight; set the body angle so the last reps are hard with 1-3 reps in reserve (RIR 1-3, clinical opinion)",
   "frequency": "2-3 times a week",
   "progression": "Walk the feet back toward the anchor so the body leans further"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Face away from the anchor, a handle in each hand in front of the chest, arms long; lean forward on the balls of the feet, body straight."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in and lower the chest between the hands, elbows about 45 degrees from the body."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Hands beside the chest; keep the straps off the arms and the body in one line."
   },
   {
    "id": "c4",
    "phase": "press",
    "text": "Breathe out and press the handles forward until the arms are long."
   },
   {
    "id": "c5",
    "phase": "top",
    "text": "Keep the ribs down and the glutes tight; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Hips sagging",
    "fix": "Brace the abs and squeeze the glutes."
   },
   {
    "id": "m2",
    "mistake": "Hands drifting apart",
    "fix": "Keep the handles in line with the chest; press them straight."
   },
   {
    "id": "m3",
    "mistake": "Straps rubbing on the arms",
    "fix": "Keep the hands a little wider than the shoulders so the straps run outside the arms."
   },
   {
    "id": "m4",
    "mistake": "Shoulders rolling forward at the bottom",
    "fix": "Keep the chest up and stop at a comfortable depth."
   }
  ],
  "kinematics": [
   {
    "measure": "Body angle",
    "setup": "",
    "peak": "",
    "norm": "Leaning further forward makes the press harder (more of the body weight on the hands, clinical opinion)",
