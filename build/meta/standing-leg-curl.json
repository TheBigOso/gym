  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand tall facing a wall, hands resting on it, weight on the left leg."
   },
   {
    "id": "c2",
    "phase": "curl",
    "text": "Breathe out and bend the right knee, bringing the heel up toward the buttock; thigh stays vertical."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Squeeze the back of the thigh; knees side by side."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Breathe in and lower the foot slowly."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Toes just touch down; repeat, then switch legs."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Thigh swinging forward",
    "fix": "Keep the knees side by side; only the lower leg moves."
   },
   {
    "id": "m2",
    "mistake": "Arching the low back",
    "fix": "Stand tall, brace lightly, pelvis neutral."
   },
   {
    "id": "m3",
    "mistake": "Dropping the foot fast",
    "fix": "Lower in about 2 s."
   },
   {
    "id": "m4",
    "mistake": "Leaning on the wall",
    "fix": "Hands rest lightly for balance only."
   }
  ],
