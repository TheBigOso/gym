    "breathing": {
      "pattern": "Breathe in while kneeling and before each step; exhale as you drive up to standing; breathe in again before lowering back down.",
      "cadence": "About 3 s from kneeling to standing, 3 s back down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "4-6 per lead leg",
      "tempo": "Controlled; pause in half-kneeling and when standing",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can hold at the chest through every rep with good posture (RPE 6-8).",
      "progression": "Slower lowering, then a heavier dumbbell; alternate the lead leg each rep"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Kneel tall on a mat, knees hip width, toes tucked; hold one dumbbell upright at the chest, elbows down, ribs down."
      },
      {
        "id": "c2",
        "phase": "step",
        "text": "Shift onto the left knee and step the right foot forward, foot flat, front shin about vertical: half-kneeling."
      },
      {
        "id": "c3",
        "phase": "rise",
        "text": "Breathe out and drive through the front foot to stand, chest up; step the back foot up beside the front one."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in, step the left foot back onto its ball and lower the knee softly to the mat; then bring the right foot back."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Tall kneeling again, dumbbell still at the chest; repeat, leading with the same or the other leg."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Dropping the back knee onto the floor",
        "fix": "Lower it slowly; use a mat or pad under the knees."
      },
      {
        "id": "m2",
        "mistake": "Pushing off the back foot instead of the front",
        "fix": "Drive through the whole front foot; the back leg only steadies you."
      },
      {
        "id": "m3",
        "mistake": "Leaning far forward or rounding the back",
        "fix": "Keep the chest up and the dumbbell close to the sternum; a small forward lean is fine."
      },
      {
        "id": "m4",
        "mistake": "Front knee caving in",
        "fix": "Keep the knee in line with the toes as you stand."
      },
      {
        "id": "m5",
        "mistake": "Feet in a line (tightrope)",
        "fix": "Keep the feet about hip width apart side to side for balance."
      }
    ],
