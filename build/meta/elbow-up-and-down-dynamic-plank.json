  "breathing": {
   "pattern": "Breathe out as you press up to the hands, breathe in as you lower to the forearms; never hold the breath for long.",
   "cadence": "About 2 s up and 2 s down"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "6-10 (alternate the lead arm)",
   "tempo": "Steady, about 2 s up and 2 s down",
   "frequency": "2-3 times a week",
   "progression": "Feet closer together, slower reps, or a pause in each position"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Forearm plank: elbows under the shoulders, feet hip width or wider, body in one line."
   },
   {
    "id": "c2",
    "phase": "upR",
    "text": "Place the right hand under the right shoulder and press up, then the left: up to a high plank."
   },
   {
    "id": "c3",
    "phase": "top1",
    "text": "High plank: hands under the shoulders, arms straight, hips level."
   },
   {
    "id": "c4",
    "phase": "downR",
    "text": "Lower to the right forearm, then the left, back to the forearm plank."
   },
   {
    "id": "c5",
    "phase": "plank2",
    "text": "Brief forearm plank."
   },
   {
    "id": "c6",
    "phase": "upL",
    "text": "Lead with the left arm this time: left hand, then right, up to the hands."
   },
   {
    "id": "c7",
    "phase": "top2",
    "text": "High plank, hips level."
   },
   {
    "id": "c8",
    "phase": "downL",
    "text": "Left forearm down, then the right."
   },
   {
    "id": "c9",
    "phase": "reset",
    "text": "Forearm plank, then repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Hips rocking side to side",
    "fix": "Widen the feet and brace; the hips stay as level as you can keep them."
   },
   {
    "id": "m2",
    "mistake": "Hips piking up during the transitions",
    "fix": "Keep one line from the shoulders to the heels."
   },
   {
    "id": "m3",
    "mistake": "Hands placed far ahead of the shoulders",
    "fix": "Plant each hand right under its shoulder."
   },
   {
    "id": "m4",
    "mistake": "Rushing",
    "fix": "Move one arm at a time with control."
   }
  ],
