   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand tall, feet hip width. Raise the straight arms out to the sides to shoulder height, palms down."
   },
   {
    "id": "c2",
    "phase": "rotate",
    "text": "Turn the palms up to the ceiling, then back down to the floor, rotating the whole arm from the shoulder; arms stay level and long."
   },
   {
    "id": "c3",
    "phase": "lower",
    "text": "Lower the arms to the sides under control."
   },
   {
    "id": "c4",
    "phase": "reset",
    "text": "Shake out the arms; repeat."
   }
  ],
  "mistakes": [
   {
