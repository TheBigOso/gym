  "breathing": {
   "pattern": "Inhale as you lower, exhale as you press or lift.",
   "cadence": "About 2 s down, a short pause, about 1.3 s up"
  },
  "prescription": {
   "sets": "3",
   "reps": "8-12",
   "tempo": "2 s down, brief pause, 1-1.5 s up",
   "frequency": "2 times a week",
   "progression": "Add load in small steps; slower lowering"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on a decline bench between two low pulleys, feet hooked under the roller, a handle in each hand beside the lower chest."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in and lower the handles to the sides of the lower chest, elbows about 45 degrees from the body."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Pause with the hands level with the chest."
   },
   {
    "id": "c4",
    "phase": "press",
    "text": "Breathe out and press up and in until the hands nearly meet over the lower chest."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Arms straight, not locked; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Elbows flared straight out",
    "fix": "Keep them about 45 degrees from the trunk."
   },
   {
    "id": "m2",
    "mistake": "Letting the cables pull the arms too low",
    "fix": "Stop with the hands level with the chest."
   },
   {
    "id": "m3",
    "mistake": "Bouncing at the bottom",
    "fix": "Pause, then press."
   },
   {
    "id": "m4",
    "mistake": "Feet slipping out of the roller",
    "fix": "Hook the feet before taking the handles."
   }
  ],
  "kinematics": [
   {
    "measure": "Elbow flexion",
