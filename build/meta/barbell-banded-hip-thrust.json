  "prescription": {
   "sets": "3-4",
   "reps": "8-12",
   "tempo": "1-1-2-0",
   "frequency": "2-3 times a week",
   "rest": "90-120 s",
   "progression": "Add load to the bar; stronger band"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Shoulder blades on the bench edge, band above the knees, bar across the hip crease, feet flat about hip width."
   },
   {
    "id": "c2",
    "phase": "up",
    "text": "Drive through the heels and push the knees out; hips up until the trunk is level."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Squeeze the glutes, chin tucked, ribs down."
   },
   {
    "id": "c4",
    "phase": "down",
    "text": "Lower the hips with control, knees still pressing out."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Touch the hips down lightly; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Knees caving in",
    "fix": "Keep pushing the knees out into the band."
   },
   {
    "id": "m2",
    "mistake": "Arching the low back at the top",
    "fix": "Stop at a level trunk; ribs down, chin tucked."
   },
   {
    "id": "m3",
    "mistake": "Feet too far out or too close",
    "fix": "Shins vertical at the top."
   },
   {
    "id": "m4",
    "mistake": "Bar rolling toward the stomach",
    "fix": "Hold it on the hip crease; use a pad."
   }
  ],
