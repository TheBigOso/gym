  "breathing": {
   "pattern": "Exhale as you lift into the bridge, breathe steadily while marching, inhale as you lower.",
   "cadence": "About 0.5 s to lift each knee, a short hold, 0.5 s to set it down"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "6-10 marches per leg",
   "tempo": "Slow, controlled marches",
   "frequency": "2-4 times a week",
   "progression": "Longer holds with the knee up, then single-leg glute bridge"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on your back, knees bent, feet flat and hip width, arms on the floor by your sides."
   },
   {
    "id": "c2",
    "phase": "lift",
    "text": "Breathe out, press through the heels and lift into a bridge: knees, hips and shoulders in one line."
   },
   {
    "id": "c3",
    "phase": "march right",
    "text": "Keep the hips high and level, lift the right knee until the thigh is vertical, then set the foot back down."
   },
   {
    "id": "c4",
    "phase": "march left",
    "text": "Same on the left: the pelvis must not drop or twist."
   },
   {
    "id": "c5",
    "phase": "lower",
    "text": "Breathe in and roll the hips back down to the mat."
   },
   {
    "id": "c6",
    "phase": "reset",
    "text": "Rest a moment and repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Hips dropping when a foot lifts",
    "fix": "Squeeze the glute of the standing leg harder, or lift the foot only a little."
   },
   {
    "id": "m2",
    "mistake": "Pelvis twisting toward the lifted leg",
    "fix": "Brace the abs and keep both hip bones level, like a tray of water."
   },
   {
    "id": "m3",
    "mistake": "Arching the low back to stay up",
    "fix": "Ribs down; tuck the pelvis slightly."
   },
   {
    "id": "m4",
    "mistake": "Rushing the marches",
    "fix": "Slow, deliberate steps with a short pause at the top."
   }
  ],
  "kinematics": [
   {
    "measure": "Hip flexion",
    "setup": "",
    "peak": "",
    "norm": "Hips extend to neutral at the top (straight knee-hip-shoulder line); no extra lumbar arch (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Knee flexion",
    "setup": "",
    "peak": "",
    "norm": "About 90 degrees at the top is the traditional bridge; more knee bend shifts work away from the hamstrings (Lehecka 2017)",
    "sources": [
     "lehecka2017"
    ]
   },
   {
    "measure": "Hip height",
    "setup": "",
    "peak": "",
    "norm": "Pelvis lifts until the line is straight (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Lifted leg",
    "setup": "",
    "peak": "",
    "norm": "Free knee rises until the thigh is about vertical while the pelvis stays level (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Tempo",
