   "sets": "3-5",
   "reps": "3-10 (or as many as you can with full range)",
   "tempo": "About 1 s up, brief hold, 2 s down",
   "load": "Body weight; add weight or use assistance to stay in the rep range",
   "frequency": "2-3 times a week",
   "progression": "More reps, then added weight (belt or vest)"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Hang from the bar, palms facing you, hands about shoulder width, arms straight."
   },
   {
    "id": "c2",
    "phase": "set",
    "text": "Pull the shoulder blades down before the elbows bend."
   },
   {
    "id": "c3",
    "phase": "pull",
    "text": "Drive the elbows down and in front of the ribs; pull the chest up toward the bar."
   },
   {
    "id": "c4",
    "phase": "top",
    "text": "Chin over the bar, neck long, legs quiet."
   },
   {
    "id": "c5",
    "phase": "lower",
    "text": "Lower under control all the way to straight arms."
   },
   {
    "id": "c6",
    "phase": "reset",
    "text": "Full hang, then the next rep."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Half reps",
    "fix": "Start each rep from straight arms and finish with the chin over the bar."
   },
   {
    "id": "m2",
    "mistake": "Kicking or swinging the legs",
    "fix": "Brace the trunk, keep the legs still with a slight knee bend."
   },
   {
    "id": "m3",
    "mistake": "Craning the chin over the bar",
    "fix": "Pull the chest up; keep the neck long."
   },
   {
    "id": "m4",
    "mistake": "Elbows flaring wide",
    "fix": "Keep the elbows in front, about in line with the hands."
   },
   {
    "id": "m5",
    "mistake": "Dropping into the hang",
    "fix": "Take about 2 s to lower; stop just short of a jolt at the bottom."
   }
  ],
