  },
  "prescription": {
   "sets": "2-4",
   "reps": "12-20 per side",
   "tempo": "1-0.5-2-0",
   "frequency": "2-3 times a week",
   "rest": "45-75 s",
   "progression": "Stronger band"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Band above the knees; hands under the shoulders, knees under the hips, back flat."
   },
   {
    "id": "c2",
    "phase": "kick",
    "text": "Breathe out and kick the right leg straight back to hip height against the band."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Leg long and level; hips square, no arch."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Breathe in, bend the knee and bring it back under the hip slowly."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Hover the knee above the mat; repeat, then switch legs."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Kicking above hip height",
    "fix": "Stop when the leg is level; higher only arches the low back."
   },
   {
    "id": "m2",
    "mistake": "Opening the hip to the side",
    "fix": "Toes point down, hips square."
   },
   {
    "id": "m3",
    "mistake": "Sagging through the shoulders",
    "fix": "Push the floor away."
   },
   {
    "id": "m4",
    "mistake": "Swinging",
    "fix": "Pause at the back, return slower."
   }
  ],
