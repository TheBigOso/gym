  "breathing": {
   "pattern": "Breathe in and brace before the dip, hold through the drive, breathe out as the bar passes the head or at lockout; breathe in again at the top or back on the shoulders.",
   "cadence": "Quick dip and drive, about 1.2 s down to the shoulders"
  },
  "prescription": {
   "sets": "3-5",
   "reps": "3-6",
   "tempo": "Controlled dip (about 0.5 s), explosive drive, controlled lowering to the shoulders",
   "load": "Moderate to heavy; more than a strict press thanks to the leg drive",
   "frequency": "1-2 times a week",
   "progression": "Add load in small steps; push jerk and split jerk as later steps"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Bar on the front of the shoulders, hands just outside the shoulders, elbows a little in front of the bar, feet hip width, trunk tall and braced."
   },
   {
    "id": "c2",
    "phase": "dip",
    "text": "Dip straight down a short way by bending the knees (a quarter of a squat or less); trunk stays upright, heels down."
   },
   {
    "id": "c3",
    "phase": "drive",
    "text": "Drive hard up through the legs onto the balls of the feet; the bar leaves the shoulders from the leg drive."
   },
   {
    "id": "c4",
    "phase": "press",
    "text": "Keep pressing: head back a little as the bar passes the face, then through under the bar."
   },
   {
    "id": "c5",
    "phase": "lockout",
    "text": "Arms straight overhead, bar over the middle of the feet, heels back down."
   },
   {
    "id": "c6",
    "phase": "lower",
    "text": "Lower the bar under control back to the shoulders, softening the knees to cushion it."
   },
   {
    "id": "c7",
    "phase": "reset",
    "text": "Reset the brace on the shoulders before the next rep."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Dipping forward at the hips",
    "fix": "Keep the trunk upright; the knees bend forward, the hips go straight down."
   },
   {
    "id": "m2",
    "mistake": "Dipping too deep or too slowly",
    "fix": "Short, controlled dip, then an immediate drive."
   },
   {
    "id": "m3",
    "mistake": "Pressing before the legs finish",
    "fix": "Let the leg drive launch the bar, then press."
   },
   {
    "id": "m4",
    "mistake": "Bar travelling forward around the face",
    "fix": "Move the head back and keep the bar close to the face."
   },
   {
    "id": "m5",
    "mistake": "Over-arching the lower back at lockout",
    "fix": "Squeeze the glutes and brace the ribs down."
   }
  ],
