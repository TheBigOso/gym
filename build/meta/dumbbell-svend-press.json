    "breathing": {
      "pattern": "Exhale as you press the dumbbell out, inhale as you draw it back to the chest; keep squeezing throughout.",
      "cadence": "About 1.4 s out, 0.8 s squeeze, 1.6 s back"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "10-15",
      "tempo": "1-1-2-0 (squeeze hard at full reach)",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen and light: the hard inward squeeze, not the weight, makes the exercise; pick a dumbbell you can hold out at arm's length for the whole set.",
      "progression": "Longer squeeze at full reach, more reps, then a slightly heavier dumbbell"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand tall, feet hip width, knees soft. Hold one dumbbell horizontally between flat palms, fingers forward, in front of the lower chest; squeeze the palms together hard."
      },
      {
        "id": "c2",
        "phase": "press",
        "text": "Breathe out and press the dumbbell straight forward at chest height, still squeezing."
      },
      {
        "id": "c3",
        "phase": "hold",
        "text": "Arms nearly straight, shoulders down; squeeze the chest hard for a second."
      },
      {
        "id": "c4",
        "phase": "return",
        "text": "Breathe in and draw the dumbbell back to the chest under control, without easing the squeeze."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, ribs down, and press again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Easing the squeeze",
        "fix": "Press the palms into the dumbbell the whole time; that squeeze is what loads the chest."
      },
      {
        "id": "m2",
        "mistake": "Pressing upward like a front raise",
        "fix": "Push straight out at chest height."
      },
      {
        "id": "m3",
        "mistake": "Shrugging the shoulders up",
        "fix": "Keep the shoulders down and away from the ears."
      },
      {
        "id": "m4",
        "mistake": "Leaning back to balance the weight",
        "fix": "Brace, ribs down, and use a lighter dumbbell."
      },
      {
        "id": "m5",
        "mistake": "Locking the elbows",
        "fix": "Stop with a soft bend at full reach."
      }
    ],
