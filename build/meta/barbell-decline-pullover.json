  "prescription": {
   "sets": "3",
   "reps": "8-12",
   "tempo": "2 s down, brief pause, 1-1.5 s up",
   "frequency": "2 times a week",
   "progression": "Add load in small steps; slower lowering"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on the decline bench, feet hooked under the roller, a barbell held over the chest with straight arms, hands about shoulder width."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in and lower the bar in an arc over and past the head, arms nearly straight."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Pause with the upper arms about level with the floor; feel the stretch in the lats and chest."
   },
   {
    "id": "c4",
    "phase": "press",
    "text": "Breathe out and pull the bar back over the chest in the same arc."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Bar over the chest; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Bending the elbows a lot (turns into a triceps extension)",
    "fix": "Keep a small fixed elbow bend."
   },
   {
    "id": "m2",
    "mistake": "Going too deep",
    "fix": "Stop with the upper arms about level with the floor."
   },
   {
    "id": "m3",
    "mistake": "Arching the back off the bench",
    "fix": "Keep the ribs down."
   },
   {
    "id": "m4",
    "mistake": "Too heavy a bar",
    "fix": "Start with an empty bar."
   }
  ],
