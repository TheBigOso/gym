   "frequency": "3-4 times a week",
   "progression": "Slower taps, feet wider then narrower, then shoulder taps from a full plank"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Kneel in a plank: hands under the shoulders, knees on the mat, body straight from knees to head."
   },
   {
    "id": "c2",
    "phase": "tap",
    "text": "Lift the right hand and tap the left shoulder."
   },
   {
    "id": "c3",
    "phase": "tap",
    "text": "Keep the hips level and still; do not rock side to side."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Put the hand back down under the shoulder."
   },
   {
    "id": "c5",
    "phase": "tap",
    "text": "Tap the right shoulder with the left hand."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Hips rocking side to side",
    "fix": "Slow down; widen the knees a little; squeeze the glutes."
   },
   {
    "id": "m2",
    "mistake": "Hips piking up or sagging",
    "fix": "Keep one line from knees to head."
   },
   {
    "id": "m3",
    "mistake": "Shoulders sinking toward the floor",
    "fix": "Push the floor away."
   },
   {
    "id": "m4",
    "mistake": "Rushing",
    "fix": "One controlled tap at a time."
   }
  ],
