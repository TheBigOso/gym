  "breathing": {
   "pattern": "Breathe in as you sit down to the box, breathe out as you stand up on one leg.",
   "cadence": "About 2 s down, light touch, about 1.3 s up"
  },
  "prescription": {
   "sets": "3",
   "reps": "4-8 per leg",
   "tempo": "2 s down, touch the box without relaxing, 1-2 s up",
   "frequency": "2-3 times a week",
   "progression": "Lower box, then a pause above the box, then the full pistol squat."
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand on one foot in front of a box, the other leg straight out in front, arms reaching forward."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in and sit the hips back and down on one leg; keep the free heel off the floor."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Touch the box lightly with the buttocks; stay braced, do not sit and relax."
   },
   {
    "id": "c4",
    "phase": "rise",
    "text": "Breathe out and drive through the whole foot to stand on the same leg."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stand tall, find your balance, go again."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Plopping onto the box",
    "fix": "Lower under control and only touch the box."
   },
   {
    "id": "m2",
    "mistake": "Rocking back to get up",
    "fix": "Lean the chest forward and stand without swinging the arms or free leg."
   },
   {
    "id": "m3",
    "mistake": "Knee caving inward",
    "fix": "Keep the knee over the 2nd-3rd toe."
   },
   {
    "id": "m4",
    "mistake": "Heel lifting",
    "fix": "Keep the whole foot planted; use a higher box if the heel comes up."
   }
  ],
  "kinematics": [
   {
    "measure": "Box height",
    "setup": "",
    "peak": "",
    "norm": "Set so the thigh is about parallel at the touch; lower boxes are harder (clinical opinion)",
    "sources": []
   },
   {
