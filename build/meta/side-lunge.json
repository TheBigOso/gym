  "muscleNotes": {
   "quads_r": "Stepping-leg knee extensors control the sit and drive the push back. Knee and ankle impulses were greater in lateral than forward lunges (Riemann 2013).",
   "quads_l": "Stepping-leg knee extensors control the sit and drive the push back. Knee and ankle impulses were greater in lateral than forward lunges (Riemann 2013).",
   "glute_max_r": "Front-leg hip extensor; works hardest out of the bottom. Longer steps raised gluteus maximus activity more than knee-extensor activity (Song 2023).",
   "glute_max_l": "Front-leg hip extensor; works hardest out of the bottom. Longer steps raised gluteus maximus activity more than knee-extensor activity (Song 2023).",
   "adductors_r": "Both sides work: the stepping leg controls the wide position, the straight leg is stretched along its inner thigh.",
   "adductors_l": "Both sides work: the stepping leg controls the wide position, the straight leg is stretched along its inner thigh.",
   "hamstrings_r": "Assist hip extension and co-contract around the front knee.",
   "hamstrings_l": "Assist hip extension and co-contract around the front knee.",
   "calves_r": "Lateral lunges asked more of the ankle than forward lunges (Riemann 2013).",
   "calves_l": "Lateral lunges asked more of the ankle than forward lunges (Riemann 2013).",
   "glute_med_r": "Steadies the stepping hip.",
   "glute_med_l": "Steadies the stepping hip.",
