  "breathing": {
   "pattern": "Inhale as you step out and sit back, exhale as you push back to the middle.",
   "cadence": "About 1.8 s out and down, short pause, about 1.4 s back"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "8-12 per side",
   "tempo": "Controlled",
   "frequency": "2-3 times a week",
   "progression": "Hold a dumbbell at the chest (goblet lateral lunge)"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand tall, feet hip width, arms forward."
   },
   {
    "id": "c2",
    "phase": "step",
    "text": "Take a wide step to the side, toes pointing forward or slightly out."
   },
   {
    "id": "c3",
    "phase": "lower",
    "text": "Breathe in and sit the hips back over the stepping foot; keep the other leg straight and both heels down."
   },
   {
    "id": "c4",
    "phase": "rise",
    "text": "Breathe out and push off the stepping foot back to the middle."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stand tall and reset; alternate sides."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Knee caving in past the toes",
    "fix": "Push the knee out in line with the stepping foot."
   },
   {
    "id": "m2",
    "mistake": "Heel of the stepping foot lifting",
    "fix": "Sit the hips back rather than down; reduce depth."
   },
   {
    "id": "m3",
    "mistake": "Rounding the back",
    "fix": "Hinge at the hips with the chest up."
   }
  ],
  "kinematics": [
