   "Pull-up bar"
  ],
  "difficulty": "Advanced",
  "mechanics": "Compound (hip and knee flexion with a strong posterior pelvic tilt and spinal flexion; shoulder extension in a hang)",
  "plane": "Sagittal",
  "laterality": "Bilateral, symmetric",
  "authoredSide": "bilateral",
  "muscles": {
   "target": [
