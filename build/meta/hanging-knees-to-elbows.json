  "safety": {
   "cautions": [
    "Stop if you feel sharp, radiating or nerve-type pain.",
    "Muscle glow colours and activation curves are illustrative, not measured EMG.",
    "Shoulder pain in the hang: build up with dead hangs and hanging knee raises.",
    "Hanging leg and knee raises load the low back through the hip flexors (Axler 1997); avoid with acute back pain.",
    "Use a bar you can reach without jumping, and step down rather than drop."
   ],
   "modify": [
    "Knees to chest height only.",
    "Slower lowering."
   ],
   "regressions": [
    "Hanging knee raise.",
    "Lying reverse crunch."
   ],
   "progressions": [
    "Toes to bar.",
    "Pause at the top."
   ]
  },
  "muscleNotes": {
   "core": "Rectus abdominis curls the pelvis up to bring the knees to the elbows; hanging knee and leg raises gave some of the highest rectus abdominis activity (Escamilla 2006).",
   "hip_flexors_r": "Pull the thighs up to the chest (Andersson 1997).",
   "hip_flexors_l": "Same on the left.",
   "obliques_r": "Assist the curl and stop the body twisting.",
   "obliques_l": "Same on the left.",
   "lats_r": "Press the straight arm toward the hips so the trunk tips back and the elbows meet the knees.",
   "lats_l": "Same on the left.",
   "forearm_flexors_r": "Grip the bar.",
   "forearm_flexors_l": "Grip the bar.",
   "rhomboids_midtrap_r": "Hold the shoulder blades set.",
