    "triceps_r",
    "triceps_l"
   ]
  },
  "breathing": {
   "pattern": "Exhale as the knees drive up, inhale on the way down.",
   "cadence": "About 1.4 s up, 0.4 s hold, 2.2 s down"
  },
  "prescription": {
   "sets": "3-4",
   "reps": "5-10",
   "tempo": "1.5-0.5-2-0",
   "frequency": "2-3 times a week",
   "progression": "Strict reps without swing, then a pause at the top, then toes to bar"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Hang from the bar with a wide overhand grip, arms straight."
   },
   {
    "id": "c2",
    "phase": "set",
    "text": "Pull the shoulder blades down and press the bar toward the thighs (lats on)."
   },
   {
    "id": "c3",
    "phase": "raise",
    "text": "Drive the knees up and curl the pelvis so the knees travel up to the elbows."
   },
   {
    "id": "c4",
    "phase": "top",
    "text": "Touch knees to elbows (or as close as you can) and pause."
   },
   {
    "id": "c5",
    "phase": "lower",
    "text": "Lower slowly to the hang without swinging."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Swinging to get the knees up",
    "fix": "Pause in the hang and set the shoulders before each rep."
   },
   {
    "id": "m2",
    "mistake": "Only lifting the knees to hip height",
    "fix": "Curl the pelvis up; the knees go to the elbows."
   },
   {
    "id": "m3",
    "mistake": "Turning it into a pull-up",
    "fix": "Some elbow bend at the top is normal; drive the knees up with the abs and press the bar toward the hips rather than pulling the chin up."
   },
   {
    "id": "m4",
    "mistake": "Dropping into the bottom",
    "fix": "Lower in about 2 s."
   }
  ],
