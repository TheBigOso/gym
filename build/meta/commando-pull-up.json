  },
  "prescription": {
   "sets": "3-4",
   "reps": "3-8 each side",
   "tempo": "About 1.3 s up, brief hold, 1.8 s down",
   "load": "Body weight",
   "frequency": "1-3 times a week",
   "progression": "More reps, then a slow lowering, then added weight"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand under the bar so it runs from front to back over your head. Grip it with the hands close together, one in front of the other, palms facing each other; hang with straight arms."
   },
   {
    "id": "c2",
    "phase": "set",
    "text": "Pull the shoulder blades down first."
   },
   {
    "id": "c3",
    "phase": "pullR",
    "text": "Pull up and bring the head past the right side of the bar, turning the chest a little toward it."
   },
   {
    "id": "c4",
    "phase": "topR",
    "text": "Chin above the bar on the right side; the bar sits by the left shoulder."
   },
   {
    "id": "c5",
    "phase": "lowerR",
    "text": "Lower under control back to the centre hang."
   },
   {
    "id": "c6",
    "phase": "hang",
    "text": "Straight arms, shoulders long, body still."
   },
   {
    "id": "c7",
    "phase": "pullL",
    "text": "Pull up again, this time with the head past the left side of the bar."
   },
   {
    "id": "c8",
    "phase": "topL",
    "text": "Chin above the bar on the left side."
   },
   {
    "id": "c9",
    "phase": "lowerL",
    "text": "Lower slowly to the centre."
   },
   {
    "id": "c10",
    "phase": "reset",
    "text": "Full hang, then repeat to the right."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Hitting the head on the bar",
    "fix": "Pick the side early and bring the head round the bar, not into it."
   },
   {
    "id": "m2",
    "mistake": "Swinging the legs to turn",
    "fix": "Turn from the upper back; keep the legs quiet."
   },
   {
    "id": "m3",
    "mistake": "Half reps",
    "fix": "Return to straight arms each rep."
   },
   {
    "id": "m4",
    "mistake": "Always going to the same side",
    "fix": "Alternate sides every rep."
   },
   {
    "id": "m5",
    "mistake": "Shrugging at the top",
    "fix": "Keep the shoulders down away from the ears."
   }
  ],
