    "muscleNotes": {
      "calves_r": "Quick, springy push-offs and landings on the ball of the foot (gastrocnemius and soleus).",
      "calves_l": "Quick, springy push-offs and landings on the ball of the foot (gastrocnemius and soleus).",
      "quads_r": "Hold the quarter-squat stance and absorb each landing.",
      "quads_l": "Hold the quarter-squat stance and absorb each landing.",
      "glute_med_r": "Pushes the body sideways and keeps the pelvis level on each single-leg contact; works hardest pushing off when travelling left and catching the lead step when travelling right.",
      "glute_med_l": "Pushes the body sideways and keeps the pelvis level on each single-leg contact.",
      "adductors_r": "Pull the trail foot in toward the lead foot.",
      "adductors_l": "Pull the trail foot in toward the lead foot.",
      "glute_max_r": "Supports the hip-hinged athletic stance.",
      "glute_max_l": "Supports the hip-hinged athletic stance.",
      "hip_flexors_r": "Lift the foot just enough to clear each stick (our inference from the movement; not named in the sources).",
      "hip_flexors_l": "Lift the foot just enough to clear each stick (our inference from the movement; not named in the sources).",
      "hamstrings_r": "Support the hip hinge with the gluteus maximus.",
      "hamstrings_l": "Support the hip hinge with the gluteus maximus.",
      "core": "Keeps the trunk square and still while the feet move.",
      "spinal_extensors_r": "Hold the chest up in the slight forward lean.",
      "spinal_extensors_l": "Hold the chest up in the slight forward lean.",
      "ant_deltoid_r": "Lightly holds the hands at the chest.",
      "ant_deltoid_l": "Lightly holds the hands at the chest."
    },
    "breathing": {
      "pattern": "Breathe rhythmically and do not hold the breath. Each pass lasts only a few seconds, so steady, relaxed breathing is enough; some coaches cue breathing out as you step.",
      "cadence": "Natural breathing; about 3-4 foot contacts per second in the animation"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "4-6 passes (alternate the lead direction)",
      "work": "2-5 s per pass down the row",
      "rest": "Full recovery between passes; about 30-60 s as an app default (design estimate)",
      "endRangeHold": "None: continuous footwork",
      "staticOption": "Walking or marching tempo through the row",
      "frequency": "2-3 sessions per week, often as about 10 minutes of the warm-up (ladder trials ran 6-10 weeks)",
      "tempo": "Start at a walking or marching pace; speed up only while contacts stay light and accurate"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand at one end of the row, side-on to it: feet hip-width, quarter squat, chest up, hands clasped at the chest."
      },
      {
        "id": "c2",
        "phase": "quickRight",
        "text": "Lead foot over the stick into the next gap, trail foot right behind it: 1-2, 1-2, on the balls of the feet. Never cross the feet."
      },
      {
        "id": "c3",
        "phase": "stopRight",
        "text": "Stop under control at the end: stay low, hips square to the front."
      },
      {
        "id": "c4",
        "phase": "quickLeft",
        "text": "Come back leading with the other foot. Hips stay at the same height and the head stays level."
      },
      {
        "id": "c5",
        "phase": "stopLeft",
        "text": "Stop, reset the stance, then go again. Light and quiet contacts; pick the feet up just enough to clear the sticks."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Crossing the feet or reaching with long steps",
        "fix": "Short, quick steps; the trail foot meets the lead foot, never passes it."
      },
      {
        "id": "m2",
        "mistake": "Standing up tall or bobbing the head",
        "fix": "Hold the quarter squat; the head moves sideways only, not up and down."
      },
      {
        "id": "m3",
        "mistake": "Heavy, flat-footed, loud landings",
        "fix": "Land softly on the balls of the feet; aim for quiet contacts."
      },
      {
        "id": "m4",
        "mistake": "Knee caving inward on contact",
        "fix": "Knee tracks over the toes; slow down until it does."
      },
      {
        "id": "m5",
        "mistake": "Leaning the shoulders toward the direction of travel",
        "fix": "Keep hips, shoulders and torso parallel to the row; move the feet, not the trunk."
      },
      {
        "id": "m6",
        "mistake": "Looking down at the sticks",
        "fix": "Glance at the row first, then eyes forward and use peripheral vision."
      },
      {
        "id": "m7",
        "mistake": "Going faster than control allows (kicking sticks, missed contacts)",
        "fix": "Master the pattern slowly first, then add speed."
      }
    ],
