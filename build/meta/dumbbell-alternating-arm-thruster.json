  "breathing": {
   "pattern": "Breathe in and brace at the top, squat down; breathe out as you drive up and press; breathe in again as the dumbbells come back to the shoulders.",
   "cadence": "About 1.4 s down, 1 s up and press, about 1 s back to the shoulders"
  },
  "prescription": {
   "sets": "3-5",
   "reps": "6-10 (3-5 each arm)",
   "tempo": "Controlled squat, fast drive and press",
   "frequency": "1-3 times a week",
   "progression": "Heavier dumbbells, more reps per set, then timed sets for conditioning. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Dumbbells on the front of the shoulders, palms in, elbows forward. Feet about shoulder width, toes slightly out."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in, brace and front squat until the hip crease is just below the knees; heels down."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Chest up, elbows up, knees out over the toes."
   },
   {
    "id": "c4",
    "phase": "drive",
    "text": "Drive the floor away; let the leg drive pop one dumbbell off its shoulder, then press it straight up past the face. The other stays racked."
   },
   {
    "id": "c5",
    "phase": "lockout",
    "text": "Pressing arm straight overhead, biceps by the ear, ribs down; breathe out."
   },
   {
    "id": "c6",
    "phase": "return",
    "text": "Bring the dumbbell back to the shoulder before the next squat; press the other arm on the next rep."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Leaning away from the pressing arm",
    "fix": "Brace the trunk and keep the ribs down; the racked dumbbell stays on its shoulder."
   },
   {
    "id": "m2",
    "mistake": "Pressing before the legs finish",
    "fix": "Let the leg drive start the dumbbell moving; press as the knees pass straight."
   },
   {
    "id": "m3",
    "mistake": "Racked elbow dropping",
    "fix": "Keep the non-pressing elbow forward so its dumbbell stays on the shoulder."
   },
   {
    "id": "m4",
    "mistake": "Heels lifting in the squat",
    "fix": "Sit between the heels; keep the whole foot down."
   }
  ],
