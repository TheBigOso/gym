  "breathing": {
   "pattern": "Big breath and brace with the bar on the pins, hold it through the pull, breathe out at lockout; breathe in again and brace before lowering.",
   "cadence": "About 1.6 s up, 0.6 s lockout, 1.8 s down to the pins"
  },
  "prescription": {
   "frequency": "Once a week",
   "rest": "2-4 minutes between sets",
   "sets": "3-5",
   "reps": "3-6",
   "tempo": "Controlled pull, 2 s down to the pins",
   "load": "Barbell load is user-chosen: often 100-110 percent of a floor deadlift for short ranges, as long as the back stays flat.",
   "progression": "Add 2.5-5 kg when every rep locks out with a flat back; lower the pins over a block of weeks."
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Pins just below the knees. Feet hip width under the bar, shins close, overhand grip just outside the thighs, hips back, flat back, shoulders over the bar."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Push the floor away and drive the hips forward; the bar slides up the thighs."
   },
   {
    "id": "c3",
    "phase": "lockout",
    "text": "Stand tall with the glutes squeezed; do not lean back or shrug."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Push the hips back and lower the bar down the thighs under control."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Set the bar quietly on the pins, keep the brace, and reset."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Leaning back at lockout",
    "fix": "Finish with the hips under the shoulders; stop when standing tall."
   },
   {
    "id": "m2",
    "mistake": "Rounding the back",
    "fix": "Brace and set the lats before the pull; lighten the bar."
   },
   {
    "id": "m3",
    "mistake": "Bar drifting away from the thighs",
    "fix": "Pull the bar back into the legs with the lats."
   },
   {
    "id": "m4",
    "mistake": "Bouncing off the pins",
    "fix": "Pause on the pins each rep."
   }
  ],
