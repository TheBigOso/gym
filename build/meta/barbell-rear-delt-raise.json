  "breathing": {
   "pattern": "Brace in the hinge, breathe out as the bar comes up, in as it lowers.",
   "cadence": "About 1.2 s up, 0.4 s squeeze, 2 s down"
  },
  "prescription": {
   "frequency": "1-2 times a week",
   "rest": "60-90 s between sets",
   "sets": "3",
   "reps": "10-15",
   "tempo": "1 s up, short squeeze, 2 s down",
   "load": "Barbell load is user-chosen and light: the rear delts are small; no heaving (about 2-3 reps in reserve).",
   "progression": "Add reps first, then 1-2.5 kg."
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Wide overhand grip (well outside the shoulders), knees soft, hinge until the trunk is close to level, back flat, bar hanging under the shoulders."
   },
   {
    "id": "c2",
    "phase": "raise",
    "text": "Lift the elbows out wide, away from the body, until the upper arms are level with the back; the bar comes up toward the upper chest."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Squeeze the back of the shoulders and the shoulder blades together for a moment."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Lower slowly to straight arms."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stay in the hinge; start the next rep without standing up."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Elbows tucked to the body",
    "fix": "Keep the upper arms out wide, about 70-90 degrees from the trunk, so the rear delts do the lifting."
   },
   {
    "id": "m2",
    "mistake": "Heaving with the trunk",
    "fix": "Lighter bar; the trunk stays still."
   },
   {
    "id": "m3",
    "mistake": "Shrugging to the ears",
    "fix": "Keep the shoulders down away from the ears."
   },
   {
    "id": "m4",
    "mistake": "Rounding the back",
    "fix": "Chest proud, brace; hinge only as far as a flat back allows."
   }
  ],
