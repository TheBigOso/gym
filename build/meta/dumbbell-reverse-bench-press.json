    "breathing": {
      "pattern": "Inhale as you lower the dumbbells, exhale as you press them up.",
      "cadence": "About 2.0 s down, 0.3 s pause, 1.2 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Start lighter than your usual dumbbell bench press: the underhand grip is harder to balance. Pick a weight you can lift for the target reps with 1-3 reps in reserve.",
      "progression": "Add reps up to the top of the range, then move to the next dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the flat bench, glutes on the seat, upper back and head on the pad, feet planted; dumbbells over the shoulders with an underhand grip, palms toward your face."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in and lower the dumbbells toward the lower chest, elbows tight to the sides."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Dumbbells beside the lower chest, elbows close to the ribs; brief pause."
      },
      {
        "id": "c4",
        "phase": "press",
        "text": "Breathe out and press up and slightly back over the shoulders, wrists straight."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms straight, palms still toward your face; pause, then lower again."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Wrists bending back under the load",
        "fix": "Squeeze the handles and keep the wrists stacked over the forearms."
      },
      {
        "id": "m2",
        "mistake": "Elbows flaring out",
        "fix": "Keep the elbows tight to the sides; the underhand grip works best tucked."
      },
      {
        "id": "m3",
        "mistake": "Too heavy too soon",
        "fix": "Start light; the grip is less stable."
      },
      {
        "id": "m4",
        "mistake": "Bouncing off the chest",
        "fix": "Lower under control and pause."
      }
    ],
    "kinematics": [
      {
        "measure": "Grip",
