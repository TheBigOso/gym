    "safety": {
      "cautions": [
        "Use light dumbbells; with the elbows nearly straight the lever is long and the shoulder takes the strain if the load is too heavy (clinical opinion).",
        "Shoulder pain at the open position: shorten the range so the hands stay in front of the shoulders.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Shoulder discomfort: lower the bench to 30 degrees and shorten the range."
      ],
      "regressions": [
        "Incline dumbbell fly (neutral grip).",
        "Band incline fly."
      ],
      "progressions": [
        "Longer squeeze at the top.",
        "Slower lowering (3 s)."
      ]
    },
    "muscleNotes": {
      "pec_r": "Brings the arm up and across; the upper (clavicular) fibres do more on an incline (Rodríguez-Ridao 2020). Flyes load the chest most in the open position (Solstad 2020).",
      "pec_l": "As the right side.",
      "ant_deltoid_r": "Raises the arm forward and in; busy at a 45-degree incline (Rodríguez-Ridao 2020).",
      "ant_deltoid_l": "As the right side.",
      "biceps_r": "Holds the soft elbow bend and the turned-up forearm.",
      "biceps_l": "As the right side.",
      "serratus_r": "Wraps the shoulder blade around as the arms come together.",
      "serratus_l": "As the right side.",
      "forearm_flexors_r": "Grip the handle.",
      "forearm_flexors_l": "Grip the handle.",
