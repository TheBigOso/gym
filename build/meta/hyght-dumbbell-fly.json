    "breathing": {
      "pattern": "Exhale as the dumbbells sweep up and in, hold the squeeze, inhale as they open back out.",
      "cadence": "About 1.4 s up, 0.8 s squeeze, 2.0 s down"
    },
    "prescription": {
      "sets": "3",
      "reps": "10-15",
      "tempo": "1-2-2-0 (1 s up, 2 s squeeze, 2 s down)",
      "frequency": "1-2 times a week",
      "load": "Light dumbbells: pick a weight you can sweep up for the target reps with 2-3 reps in reserve (RIR 2-3) without bending the elbows more.",
      "progression": "Add reps and a longer squeeze before adding load."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Back pad at 45 degrees, glutes in the crease, feet planted; arms out to the sides at shoulder level, elbows softly bent, palms turned up."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and sweep the dumbbells up and in, keeping the palms up, until they meet high over your face in a V."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Dumbbells together over the nose; squeeze the chest for a two-count."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and open the arms back out along the same arc, palms still up, to shoulder level."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arms wide, chest open; start the next rep without bouncing."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Turning the palms to face each other",
        "fix": "Keep the palms up all the way; the turned-up hands make the V shape."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbows more to press the weight",
        "fix": "Hold the same soft bend; it is a fly, not a press."
      },
      {
        "id": "m3",
        "mistake": "Going too heavy",
        "fix": "Use light dumbbells so the chest, not the shoulders, does the work."
      },
      {
        "id": "m4",
        "mistake": "Dropping the arms below the shoulders",
        "fix": "Stop with the hands about level with the shoulders."
      },
      {
        "id": "m5",
        "mistake": "Shrugging",
        "fix": "Keep the shoulder blades down and back on the pad."
      }
    ],
