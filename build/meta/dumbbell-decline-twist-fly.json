  "breathing": {
   "pattern": "Inhale as you lower, exhale as you press or lift.",
   "cadence": "About 2 s down, a short pause, about 1.3 s up"
  },
  "prescription": {
   "sets": "3",
   "reps": "8-12",
   "tempo": "2 s down, brief pause, 1-1.5 s up",
   "frequency": "2 times a week",
   "progression": "Add load in small steps; slower lowering"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on the decline bench, feet hooked under the roller, dumbbells over the lower chest with the palms toward the feet and the handles in line."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in and open the arms in a wide arc while turning the palms to face each other and then up."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Pause with a stretch across the chest."
   },
   {
    "id": "c4",
    "phase": "press",
    "text": "Breathe out and hug the dumbbells back up, turning the palms toward the feet again at the top."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Squeeze the chest at the top; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Pressing instead of flying",
    "fix": "Keep the elbow angle fixed."
   },
   {
    "id": "m2",
    "mistake": "Turning only the wrists",
    "fix": "Rotate the whole forearm smoothly through the arc."
   },
   {
    "id": "m3",
    "mistake": "Dropping the arms too low",
    "fix": "Stop with the upper arms about level with the body."
   },
   {
    "id": "m4",
    "mistake": "Too heavy a load",
    "fix": "Go light; the twist needs control."
   }
  ],
  "kinematics": [
   {
