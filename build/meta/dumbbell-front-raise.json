   "load": "User-chosen dumbbells; light",
   "progression": "Add reps, then weight; slower lowering"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand tall, feet hip width, dumbbells in front of the thighs, palms facing the thighs, elbows soft."
   },
   {
    "id": "c2",
    "phase": "raise",
    "text": "Breathe out and raise both dumbbells straight forward, palms down."
   },
   {
    "id": "c3",
    "phase": "top",
    "text": "Stop at shoulder height, arms about parallel to the floor; no leaning back."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Lower slowly in about 2 s to the thighs."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Brief pause at the thighs, then repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Leaning back and swinging the weights up",
    "fix": "Brace the trunk, soften the knees and lighten the load."
   },
   {
    "id": "m2",
    "mistake": "Raising well above shoulder height",
    "fix": "Stop at about 90 degrees (the range tested by Coratella 2020)."
   },
   {
    "id": "m3",
    "mistake": "Shrugging",
    "fix": "Keep the shoulders down and the neck long."
   }
  ],
