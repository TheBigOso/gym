  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Hang from the bar with a wide overhand grip, arms straight."
   },
   {
    "id": "c2",
    "phase": "set",
    "text": "Pull the shoulder blades down first."
   },
   {
    "id": "c3",
    "phase": "pullF",
    "text": "Pull up in front of the bar: chest toward it, elbows down and back."
   },
   {
    "id": "c4",
    "phase": "topF",
    "text": "Chin over the bar, neck long."
   },
   {
    "id": "c5",
    "phase": "lowerF",
    "text": "Lower under control to the full hang."
   },
   {
    "id": "c6",
    "phase": "hang",
    "text": "Straight arms, body still."
   },
   {
    "id": "c7",
    "phase": "pullB",
    "text": "Now pull up behind the bar: head forward a little, elbows straight down by the sides."
   },
   {
    "id": "c8",
    "phase": "topB",
    "text": "Bar level with the back of the neck; do not let it hit the head or neck."
   },
   {
    "id": "c9",
    "phase": "lowerB",
    "text": "Lower slowly to the hang."
   },
   {
    "id": "c10",
    "phase": "reset",
    "text": "Full hang, then the next pair."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Yanking the head forward for the behind-the-neck rep",
    "fix": "Tilt the head only slightly; the body moves forward under the bar."
   },
   {
    "id": "m2",
    "mistake": "Bar hitting the neck",
    "fix": "Stop with the bar at the base of the neck, a few cm away."
   },
   {
    "id": "m3",
    "mistake": "Kipping",
    "fix": "Keep the legs quiet; pull with the back."
   },
   {
    "id": "m4",
    "mistake": "Half reps",
    "fix": "Return to straight arms between reps."
   },
   {
    "id": "m5",
    "mistake": "Forcing the back rep with stiff shoulders",
    "fix": "Skip the behind-the-neck rep if you cannot get there without pain."
   }
  ],
