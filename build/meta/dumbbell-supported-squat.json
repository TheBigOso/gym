    "breathing": {
      "pattern": "Breathe in and brace at the top, lower; breathe out as you pass the hardest part of the rise.",
      "cadence": "About 2 s down, short pause, about 1.2 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "8-12",
      "tempo": "2-0-1-0",
      "frequency": "2-3 times a week",
      "progression": "Heavier dumbbell, a 2 s pause at the bottom, then a front squat. Dumbbell load is user-chosen: pick a weight that leaves about 2-3 reps in reserve (RPE 7-8) at the end of each set."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand beside a rack upright, feet about shoulder width, toes slightly out; hold the upright lightly with the left hand at about hip height and a dumbbell at your right side."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, sit the hips back and down, knees tracking over the toes; the support hand only steadies you."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Thighs about parallel, heels down, chest up, dumbbell hanging straight beside the leg."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and drive up through the whole foot without pulling on the support."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall, reset and repeat; swap hands and sides after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Pulling yourself up with the support hand",
        "fix": "Keep a light grip; the legs do the work."
      },
      {
        "id": "m2",
        "mistake": "Leaning toward the dumbbell side",
        "fix": "Brace the trunk and keep the shoulders level."
      },
      {
        "id": "m3",
        "mistake": "Heels lifting at the bottom",
        "fix": "Sit back, keep the weight through the whole foot, squat only as deep as you can with the heels down."
      },
      {
        "id": "m4",
        "mistake": "Knees caving in",
        "fix": "Push the knees out over the toes."
      }
    ],
