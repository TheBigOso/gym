  "breathing": {
   "pattern": "Breathe out as you pull the shoulders down, breathe in as you let them rise.",
   "cadence": "About 0.8 s down, 0.6 s hold, 1.2 s up"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "8-15",
   "tempo": "About 0.8 s down, 0.6 s hold, 1.2 s up",
   "load": "Body weight",
   "frequency": "2-4 times a week (warm-up or pull-up preparation)",
   "progression": "Longer holds, then pause scapula pull-ups, then full pull-ups"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Hang from the bar, overhand, hands a little wider than the shoulders, arms straight, shoulders up by the ears."
   },
   {
    "id": "c2",
    "phase": "depress",
    "text": "Keep the elbows straight; pull the shoulder blades down and slightly together so the body rises a few cm."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Hold: chest up, neck long, ears away from the shoulders."
   },
   {
    "id": "c4",
    "phase": "release",
    "text": "Let the shoulders rise slowly back to the hang without bending the arms."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Relax into the full hang, then repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Bending the elbows to lift the body",
    "fix": "The arms stay straight; only the shoulder blades move."
   },
   {
    "id": "m2",
    "mistake": "Shrugging up instead of down",
    "fix": "Think of putting the shoulder blades in your back pockets."
   },
   {
    "id": "m3",
    "mistake": "Swinging or kicking the legs",
    "fix": "Brace the trunk and keep the legs quiet."
   },
   {
    "id": "m4",
    "mistake": "Dropping into the hang",
    "fix": "Lower the shoulders under control."
   },
   {
    "id": "m5",
    "mistake": "Arching the lower back hard",
    "fix": "Keep the ribs down; the chest lifts a little, the low back stays quiet."
   }
  ],
