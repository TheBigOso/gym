  },
  "prescription": {
   "sets": "3",
   "reps": "8-12",
   "tempo": "2 s down, brief pause, 1-1.5 s up",
   "frequency": "2 times a week",
   "progression": "Add load in small steps; slower lowering"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on the decline bench, feet hooked under the roller, dumbbells straight up over the shoulders, palms facing each other."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in and bend only the elbows, lowering the dumbbells beside the head; upper arms stay still."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Pause with the dumbbells beside the ears."
   },
   {
    "id": "c4",
    "phase": "press",
    "text": "Breathe out and straighten the elbows back to the top."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Arms straight, not locked; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Elbows flaring out",
    "fix": "Keep the elbows pointing at the feet."
   },
   {
    "id": "m2",
    "mistake": "Upper arms swinging back and forth",
    "fix": "Only the forearms move."
   },
   {
    "id": "m3",
    "mistake": "Dropping the dumbbells to the head",
    "fix": "Lower in 2 s and stop beside the ears."
   },
   {
    "id": "m4",
    "mistake": "Locking out hard",
    "fix": "Stop just short of lockout."
   }
  ],
