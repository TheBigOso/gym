  "prescription": {
   "sets": "2-4",
   "reps": "10-20",
   "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
   "rest": "45-75 s",
   "frequency": "1-2 times a week",
   "tempo": "1.3-0.5-2-0.5 (curl-hold-lower-pause, seconds)",
   "load": "Load is user-chosen: curl the ribs toward the pelvis without pulling with the arms.",
   "progression": "Add reps, then load; longer hold at the top"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on the bench with the knees bent and the feet flat; the lever pad on the upper chest, hands on the handles beside it."
   },
   {
    "id": "c2",
    "phase": "work",
    "text": "Breathe out and curl the head, shoulders and upper back off the bench, ribs toward the pelvis."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Hold the crunch with the low back still on the bench."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Breathe in and uncurl slowly back to the bench."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Pause with light tension; keep the chin tucked."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Pulling with the arms",
    "fix": "Let the abdominals curl the trunk; the hands only hold the handles."
   },
   {
    "id": "m2",
    "mistake": "Low back lifting off",
    "fix": "Curl the upper back only; the pelvis stays down."
   },
   {
    "id": "m3",
    "mistake": "Neck cranked forward",
    "fix": "Keep a fist of space under the chin."
   },
   {
    "id": "m4",
    "mistake": "Dropping back down",
    "fix": "Take about 2 s to lower."
   }
  ],
