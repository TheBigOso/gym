  },
  "breathing": {
   "pattern": "Breathe steadily through each circle; exhale as the leg lifts.",
   "cadence": "One circle in about 2.4 s, then switch legs"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "5-8 circles each way per leg",
   "tempo": "Slow, smooth circles (about 2-3 s each)",
   "frequency": "2-3 times a week",
   "progression": "Bigger circles, then lower the circle closer to the floor, then add an ankle weight"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie flat, arms by your sides palms down, legs long."
   },
   {
    "id": "c2",
    "phase": "liftR",
    "text": "Brace and raise the straight right leg to about 45 degrees."
   },
   {
    "id": "c3",
    "phase": "circleR",
    "text": "Draw a smooth circle with the toes: across, down, out and up. The pelvis stays still."
   },
   {
    "id": "c4",
    "phase": "lowerR",
    "text": "Lower the leg to the mat under control."
   },
   {
    "id": "c5",
    "phase": "circleL",
    "text": "Repeat with the left leg: same size circle, same direction."
   },
   {
    "id": "c6",
    "phase": "reset",
    "text": "Rest briefly; reverse the direction on the next set."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Pelvis rocking side to side with the leg",
    "fix": "Make the circle smaller and press the arms into the mat."
   },
   {
    "id": "m2",
    "mistake": "Low back arching off the mat",
    "fix": "Raise the circle higher or bend the resting knee with the foot flat."
   },
   {
    "id": "m3",
    "mistake": "Knee bending to make the circle bigger",
    "fix": "Keep the knee long; the circle comes from the hip."
   },
   {
    "id": "m4",
    "mistake": "Rushing",
    "fix": "Slow, even circles about 2-3 seconds each."
   }
  ],
