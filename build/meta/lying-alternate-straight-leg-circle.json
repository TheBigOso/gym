  "safety": {
   "cautions": [
    "Stop if you feel sharp, radiating or nerve-type pain.",
    "Muscle glow colours and activation curves are illustrative, not measured EMG.",
    "Straight-leg and legs-off-the-floor work loads the low back through the hip flexors (McGill 1998). If the low back arches off the mat, bend the knees or shorten the range.",
    "Low-back pain or disc problems: prefer dead bugs or bent-knee alternatives."
   ],
   "modify": [
    "Smaller circles.",
    "Bend the resting knee with the foot flat on the mat.",
    "Hands under the hips."
   ],
   "regressions": [
    "Bent-knee leg circles.",
    "Single-leg raise without the circle."
   ],
   "progressions": [
    "Bigger circles.",
    "Lower the circle toward the floor.",
    "Ankle weight."
   ]
  },
  "muscleNotes": {
   "hip_flexors_r": "Iliopsoas and rectus femoris hold the straight leg up and steer the flexion part of the circle (Juker 1998 for psoas in leg raising).",
   "hip_flexors_l": "Same role on the left leg in the second half.",
   "core": "The abdominals hold the pelvis still against the one-sided pull of the leg; unilateral leg lifts need less abdominal effort than bilateral ones (Andersson 1997).",
   "adductors_r": "Pull the leg across the midline in the inner part of the circle (clinical opinion).",
   "adductors_l": "Same on the left.",
   "glute_med_r": "Takes the leg out to the side in the outer part of the circle (clinical opinion).",
   "glute_med_l": "Same on the left.",
   "quads_r": "Keep the knee straight.",
   "quads_l": "Keep the knee straight.",
   "obliques_r": "Resist the pelvis rolling with the leg.",
   "obliques_l": "Resist the pelvis rolling with the leg."
  }
