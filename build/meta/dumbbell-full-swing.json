  "breathing": {
   "pattern": "Breathe in on the way down, a sharp breath out as the hips snap; breathe in again as the dumbbell falls.",
   "cadence": "About 2 s per swing"
  },
  "prescription": {
   "sets": "3-5",
   "reps": "8-15",
   "tempo": "Continuous, about 2 s per swing",
   "load": "User-chosen; lighter than for a chest-height swing, because it has to be controlled overhead",
   "frequency": "1-3 times a week",
   "progression": "Master the chest-height (Russian) swing first; then go higher, then heavier"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Feet wider than the hips, toes slightly out; one dumbbell held vertically by the handle in both hands."
   },
   {
    "id": "c2",
    "phase": "hike",
    "text": "Hinge: hips back, flat back, dumbbell between the thighs."
   },
   {
    "id": "c3",
    "phase": "swing",
    "text": "Snap the hips and keep the arms long; let the dumbbell float all the way overhead, arms by the ears."
   },
   {
    "id": "c4",
    "phase": "back",
    "text": "Let it fall straight back down in front; hinge late and hike it through."
   },
   {
    "id": "c5",
    "phase": "swing2",
    "text": "Snap again: glutes tight, ribs down; do not arch to get it overhead."
   },
   {
    "id": "c6",
    "phase": "park",
    "text": "Let the dumbbell slow down and stop hanging in front."
   },
   {
    "id": "c7",
    "phase": "reset",
    "text": "Stand tall and breathe."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Arching the lower back to reach overhead",
    "fix": "Ribs down and glutes tight; stop at chest height if the shoulders cannot reach overhead with a neutral back."
   },
   {
    "id": "m2",
    "mistake": "Lifting the dumbbell with the arms",
    "fix": "The hip snap moves it; the arms only guide."
   },
   {
    "id": "m3",
    "mistake": "Squatting instead of hinging",
    "fix": "Hips back, shins nearly vertical."
   },
   {
    "id": "m4",
    "mistake": "Letting the dumbbell drift behind the head at the top",
    "fix": "Finish with the dumbbell straight over the shoulders and the arms by the ears."
   }
  ],
