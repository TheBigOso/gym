  "breathing": {
   "pattern": "Breathe out as you curl the body up to the rings, breathe in as you lower.",
   "cadence": "About 1.2 s up, short squeeze, about 2 s down"
  },
  "prescription": {
   "sets": "3",
   "reps": "8-15",
   "tempo": "1-1-2-0",
   "load": "Bodyweight; body angle sets the load (RIR 1-3, clinical opinion)",
   "frequency": "2 times a week",
   "progression": "Walk the feet toward the anchor"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Rings in front, underhand grip (palms up); lean back with long arms raised toward the anchor, heels down, body straight."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Breathe out and bend the elbows, bringing the rings toward the forehead; the upper arms stay pointing at the anchor."
   },
   {
    "id": "c3",
    "phase": "top",
    "text": "Squeeze the biceps with the hands beside the forehead."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Breathe in and straighten the elbows slowly."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Keep the body straight; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Turning it into a row (elbows dropping to the ribs)",
    "fix": "Keep the upper arms up toward the anchor; only the elbows bend."
   },
   {
    "id": "m2",
    "mistake": "Hips sagging",
    "fix": "Brace and squeeze the glutes."
   },
   {
    "id": "m3",
    "mistake": "Wrists curling",
    "fix": "Keep the wrists straight."
   },
   {
    "id": "m4",
    "mistake": "Dropping fast",
    "fix": "Lower over about 2 s."
   }
  ],
  "kinematics": [
   {
    "measure": "Body angle",
    "setup": "",
    "peak": "",
    "norm": "The more upright the body, the easier the curl (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Elbow flexion",
    "setup": "",
    "peak": "",
    "norm": "From nearly straight to about 110-130 degrees at the top (clinical opinion)",
