   "pattern": "Exhale as you row, inhale as you lower; let the chest stay on the pad.",
   "cadence": "About 1.1 s up, 0.4 s squeeze, 2 s down"
  },
  "prescription": {
   "sets": "3",
   "reps": "10-15",
   "tempo": "1-0-2 with a short squeeze",
   "load": "User-chosen dumbbells; stop about 1-3 reps short of failure (RIR 1-3)",
   "frequency": "2-3 times a week",
   "progression": "Add load or reps; pause at the top"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Bench at about 40 degrees. Straddle the seat, chest on the pad with the chin just over the top, feet planted behind, arms hanging straight."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Breathe out and drive the elbow up and back toward the hip, close to the body."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Squeeze the shoulder blade back; the dumbbell reaches the side of the lower ribs."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Breathe in and lower under control until the arm is straight."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Let the shoulder blade glide forward a little, keep the back flat, repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Lifting the chest off the pad to heave the weight",
    "fix": "Keep the chest on the pad; use lighter dumbbells."
   },
   {
    "id": "m2",
    "mistake": "Craning the neck up",
    "fix": "Keep the head in line with the trunk, eyes down and forward."
   },
   {
    "id": "m3",
    "mistake": "Shrugging instead of rowing",
    "fix": "Pull the elbows back toward the hips."
   }
  ],
