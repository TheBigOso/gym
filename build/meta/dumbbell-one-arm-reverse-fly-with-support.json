    "safety": {
      "cautions": [
        "Keep the back flat and the supporting arm straight but not locked.",
        "Shoulder pinching at the top: stop a little lower and keep the arm slightly forward of the shoulder line (clinical opinion).",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Lower back discomfort: rest the chest on an incline bench instead (chest-supported reverse fly)."
      ],
      "regressions": [
        "Band reverse fly.",
        "Prone Y-T raises without weight."
      ],
      "progressions": [
        "Slightly heavier dumbbell.",
        "Two-second squeeze at the top."
      ]
    },
    "muscleNotes": {
      "post_deltoid_r": "Main mover: pulls the arm out and back; transverse abduction with the trunk bent over gave the highest posterior deltoid activity (Campos 2020).",
      "rhomboids_midtrap_r": "Draw the shoulder blade in toward the spine at the top (Oyama 2010).",
      "infraspinatus_r": "Turns the upper arm out and helps the rear deltoid (Schoenfeld 2013).",
      "lat_deltoid_r": "Assists as the arm rises out to the side (Campos 2020).",
      "upper_traps_r": "Should stay quiet; shrugging shifts work to the upper trapezius.",
      "forearm_flexors_r": "Grip the handle.",
      "spinal_extensors": "Hold the back flat.",
      "core": "Keeps the trunk from twisting toward the moving arm.",
      "obliques_r": "Resist rotation as the arm rises.",
      "obliques_l": "Resist rotation as the arm rises."
    }
