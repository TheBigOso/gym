    "breathing": {
      "pattern": "Exhale as the dumbbell sweeps up, inhale as it lowers.",
      "cadence": "About 1.4 s up, 0.5 s squeeze, 2.0 s down"
    },
    "prescription": {
      "sets": "2-4",
      "reps": "12-15 per arm",
      "tempo": "1-1-2-0 (1 s up, 1 s squeeze, 2 s down)",
      "frequency": "2-3 times a week",
      "load": "Light dumbbell: pick a weight you can lift for the target reps with 2-3 reps in reserve (RIR 2-3) without swinging or twisting.",
      "progression": "Add reps and a longer squeeze, then a slightly heavier dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Left knee and left hand on a flat bench, right foot planted out to the side, back flat; the dumbbell hangs under the right shoulder, palm in."
      },
      {
        "id": "c2",
        "phase": "raise",
        "text": "Breathe out and sweep the arm out to the side with a soft elbow, leading with the back of the hand, until the arm is about level with your back."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Pause and draw the shoulder blade in without shrugging."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly along the same arc to the hang."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Arm hanging, trunk square; repeat, then switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Twisting the trunk to swing the weight up",
        "fix": "Keep the chest square to the floor; the supporting hand and knee hold the trunk still."
      },
      {
        "id": "m2",
        "mistake": "Bending the elbow more and rowing",
        "fix": "Hold the same soft bend; the arm sweeps, it does not pull back."
      },
      {
        "id": "m3",
        "mistake": "Shrugging toward the ear",
        "fix": "Keep the shoulder down, away from the ear."
      },
      {
        "id": "m4",
        "mistake": "Raising past the back line",
        "fix": "Stop about level with the back."
      },
      {
        "id": "m5",
        "mistake": "Dropping the weight",
        "fix": "Lower in about 2 s."
      }
    ],
    "kinematics": [
      {
        "measure": "Trunk angle",
        "setup": "",
        "peak": "",
        "norm": "Back flat, about 15-25 degrees above the floor (clinical opinion)",
        "sources": []
      },
      {
