  "breathing": {
   "pattern": "Breathe steadily; breathe out as the bell passes behind the head.",
   "cadence": "About 3 s per circle"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "5-8 circles each direction",
   "tempo": "Slow and controlled, about 3 s per circle",
   "load": "Light kettlebell (8-16 kg)",
   "frequency": "2-4 times a week, often as a warm-up",
   "progression": "Heavier bell, or half-kneeling to stop the trunk helping"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand tall, hold the kettlebell upside down by the handle in both hands in front of the chin."
   },
   {
    "id": "c2",
    "phase": "circle",
    "text": "Take it past the right ear, behind the head, past the left ear and back to the front, close to the head."
   },
   {
    "id": "c3",
    "phase": "switch",
    "text": "Pause in front, ribs down, then change direction."
   },
   {
    "id": "c4",
    "phase": "reverse",
    "text": "Circle the other way: past the left ear, behind the head, past the right ear."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Pause in front with the bell still before the next circle."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Leaning or arching the back to get the bell round",
    "fix": "Brace the trunk and squeeze the glutes; only the arms move."
   },
   {
    "id": "m2",
    "mistake": "Circle too wide",
    "fix": "Keep the bell close to the head; the elbows do the work."
   },
   {
    "id": "m3",
    "mistake": "Head ducking or poking forward",
    "fix": "Keep the head still and the chin level; move the bell around it."
   },
   {
    "id": "m4",
    "mistake": "Rushing",
    "fix": "Slow, smooth circles; pause between directions."
   }
  ],
