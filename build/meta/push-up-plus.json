  "breathing": {
   "pattern": "Breathe in on the way down, breathe out as you press up and push into the plus.",
   "cadence": "About 1.6 s down, 1 s up, 0.6 s plus"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "8-15",
   "tempo": "1.6 s down, 1 s up, 0.6 s plus, 0.4 s hold",
   "load": "Body weight",
   "frequency": "2-3 times a week",
   "progression": "Slower plus with a longer hold, then feet elevated"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "High plank: hands a little wider than the shoulders, body in one straight line, on the balls of the feet."
   },
   {
    "id": "c2",
    "phase": "down",
    "text": "Lower as one piece, elbows about 30-45 degrees from the body, chest to a few cm above the floor."
   },
   {
    "id": "c3",
    "phase": "pause",
    "text": "Brief pause just above the floor, body straight."
   },
   {
    "id": "c4",
    "phase": "up",
    "text": "Press back up to straight arms."
   },
   {
    "id": "c5",
    "phase": "plus",
    "text": "Keep the arms straight and push the floor away: the shoulder blades spread apart and the upper back rounds slightly up."
   },
   {
    "id": "c6",
    "phase": "hold",
    "text": "Hold the plus for a moment."
   },
   {
    "id": "c7",
    "phase": "release",
    "text": "Let the shoulder blades settle back to the plank position, then the next rep."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Skipping the plus",
    "fix": "Finish every rep by pushing the shoulder blades apart with straight arms."
   },
   {
    "id": "m2",
    "mistake": "Bending the elbows in the plus",
    "fix": "The plus comes from the shoulder blades, not the arms."
   },
   {
    "id": "m3",
    "mistake": "Hips sagging or piking",
    "fix": "Squeeze the glutes and brace: the body stays in one line."
   },
   {
    "id": "m4",
    "mistake": "Shrugging toward the ears",
    "fix": "Push the floor away and down, not up toward the ears."
   },
   {
    "id": "m5",
    "mistake": "Rushing",
    "fix": "Pause in the plus before you lower."
   }
  ],
  "kinematics": [
   {
    "measure": "Elbow flexion",
    "setup": "",
    "peak": "",
