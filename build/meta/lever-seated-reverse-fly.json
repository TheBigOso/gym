   "pattern": "Breathe out as the arms open, breathe in as they come back together.",
   "cadence": "About 1.3 s out, short squeeze, about 2 s back"
  },
  "prescription": {
   "sets": "2-4",
   "reps": "10-15",
   "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
   "rest": "45-75 s",
   "frequency": "1-2 times a week",
   "tempo": "1.3-0.5-2-0.5 (out-squeeze-in-pause, seconds)",
   "load": "Stack load is user-chosen: light loads; open without arching off the chest pad.",
   "progression": "Add reps, then one plate on the stack; slower opening"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Sit facing the machine with the chest on the pad and the feet flat; hold the handles in front at shoulder height, arms long with a soft elbow."
   },
   {
    "id": "c2",
    "phase": "close",
    "text": "Breathe out and sweep the arms out and back in a wide arc, leading with the back of the arms."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Squeeze the shoulder blades together with the arms in line with the trunk."
   },
   {
    "id": "c4",
    "phase": "open",
    "text": "Breathe in and bring the handles back together in front under control."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Let the shoulder blades spread slightly at the front without losing the chest pad."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Chest leaving the pad",
    "fix": "Keep the chest on the pad; lighten the stack."
   },
   {
    "id": "m2",
    "mistake": "Shrugging",
    "fix": "Keep the shoulders down from the ears."
   },
   {
    "id": "m3",
    "mistake": "Bending the elbows to cheat",
    "fix": "Keep the soft elbow bend fixed."
   },
   {
    "id": "m4",
    "mistake": "Swinging past the trunk line",
    "fix": "Stop with the arms in line with the shoulders."
   }
  ],
