  "breathing": {
   "pattern": "Breathe in and brace at the top, keep the brace through the pulses with short breaths if needed, breathe out as you stand.",
   "cadence": "About 1.6 s down, three small pulses of about 0.6 s, about 1.2 s up"
  },
  "prescription": {
   "sets": "2-4",
   "reps": "6-10 (each rep = squat down, 3 pulses, stand)",
   "tempo": "2 s down, 3 pulses, 1 s up",
   "frequency": "1-2 times a week",
   "load": "Barbell load is user-chosen and lighter than your normal squat: time under tension is long. Leave about 2-3 reps in reserve (RPE 7-8).",
   "rest": "90-120 s between sets",
   "progression": "More pulses per rep, then a heavier bar."
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Bar on the upper traps just below the bony bump at the base of the neck, hands just outside the shoulders, elbows down, shoulder blades squeezed together. Feet about shoulder width, toes out a little."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Brace and squat down to about thighs parallel, chest up, knees over the toes."
   },
   {
    "id": "c3",
    "phase": "pulse",
    "text": "Rise a hand-width and sink back to the bottom, three times, staying low and tight; do not stand between pulses."
   },
   {
    "id": "c4",
    "phase": "rise",
    "text": "After the last pulse drive all the way up, breathing out near the top."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stand tall and re-brace."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Pulses getting so big they become full reps",
    "fix": "Rise only a hand-width; keep the hips below the top of the knees."
   },
   {
    "id": "m2",
    "mistake": "Relaxing or bouncing at the bottom",
    "fix": "Stay braced and control each pulse down."
   },
   {
    "id": "m3",
    "mistake": "Heels lifting as the legs tire",
    "fix": "Keep the weight over mid-foot and the whole foot down."
   },
   {
    "id": "m4",
    "mistake": "Chest dropping during the pulses",
    "fix": "Keep the upper back tight against the bar and the eyes forward."
   }
  ],
