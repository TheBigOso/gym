  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Sit with the back on the pad and the feet flat; hold the vertical handles with the arms out to the sides at shoulder height, elbows softly bent."
   },
   {
    "id": "c2",
    "phase": "close",
    "text": "Breathe out and sweep the handles together in a wide hugging arc in front of the chest."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Squeeze the chest with the hands close together; keep the elbow bend fixed."
   },
   {
    "id": "c4",
    "phase": "open",
    "text": "Breathe in and open the arms slowly until the hands are about level with the trunk."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Feel the stretch across the chest with the shoulders down."
   }
  ],
  "mistakes": [
   {
