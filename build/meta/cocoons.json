  "safety": {
   "cautions": [
    "Stop if you feel sharp, radiating or nerve-type pain.",
    "Muscle glow colours and activation curves are illustrative, not measured EMG.",
    "Straight-leg and legs-off-the-floor work loads the low back through the hip flexors (McGill 1998). If the low back arches off the mat, bend the knees or shorten the range.",
    "Low-back pain or disc problems: prefer dead bugs or bent-knee alternatives.",
    "Pregnancy and postpartum (diastasis recti): get individual guidance before dynamic trunk-flexion or legs-off-the-floor work."
   ],
   "modify": [
    "Keep the head down and only tuck the legs.",
    "Arms by the sides."
   ],
   "regressions": [
    "Reverse crunch.",
    "Crunch."
   ],
   "progressions": [
    "V-up.",
    "Lower hollow."
   ]
  },
  "muscleNotes": {
   "core": "Rectus abdominis curls the trunk and holds the hollow; combined trunk and hip flexion exercises gave high abdominal activity (Escamilla 2006).",
   "hip_flexors_r": "Pull the knees to the chest and hold the legs up in the hollow (Andersson 1997).",
   "hip_flexors_l": "Same on the left.",
   "obliques_r": "Assist the curl.",
   "obliques_l": "Assist the curl.",
   "quads_r": "Straighten the legs on the way out.",
   "quads_l": "Straighten the legs on the way out.",
   "ant_deltoid_r": "Sweep the arms forward.",
   "ant_deltoid_l": "Sweep the arms forward.",
   "adductors_r": "Keep the legs together.",
   "adductors_l": "Keep the legs together."
  }
