{
 "exercise": {
  "id": "cocoons",
  "name": "Cocoons",
  "aliases": [
   "Cocoon crunch",
   "Tuck crunch from hollow",
   "Hollow-to-tuck crunch"
  ],
  "reference": {
   "source": "GymVisual",
