  "breathing": {
   "pattern": "Breathe in as the plate comes down to the chest, breathe out as you press it up.",
   "cadence": "About 2 s down, 1 s up"
  },
  "prescription": {
   "sets": "3",
   "reps": "10-15",
   "tempo": "2-0-1-1",
   "load": "A 10-20 kg plate you can grip securely (RIR 1-3, clinical opinion)",
   "frequency": "2 times a week",
   "progression": "Heavier plate, then a pause at the chest"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on a bench set to about 30-45 degrees, feet flat; hold a plate by its rim at 3 and 9 o'clock, palms facing in, thumbs toward the head, the plate flat over the upper chest with the arms long."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in and lower the plate to the upper chest, elbows about 45 degrees from the body."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Plate just above the chest; squeeze the rim."
   },
   {
    "id": "c4",
    "phase": "press",
    "text": "Breathe out and press the plate back up over the shoulders."
   },
   {
    "id": "c5",
    "phase": "top",
    "text": "Arms long; keep the shoulder blades on the bench."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Loose grip on the rim",
    "fix": "Squeeze the plate hard the whole set; use a plate with a lip."
   },
   {
    "id": "m2",
    "mistake": "Elbows flaring to 90 degrees",
    "fix": "Keep them about 45 degrees from the body."
   },
   {
    "id": "m3",
    "mistake": "Bouncing off the chest",
    "fix": "Stop just above the chest."
   },
   {
    "id": "m4",
    "mistake": "Arching off the bench",
    "fix": "Keep the upper back and hips on the bench."
   }
  ],
  "kinematics": [
   {
    "measure": "Bench angle",
    "setup": "",
    "peak": "",
    "norm": "About 30 degrees maximised upper-pectoralis activity in Rodriguez-Ridao 2020",
    "sources": [
     "rodriguez2020"
    ]
   },
   {
    "measure": "Elbow flexion",
    "setup": "",
    "peak": "",
    "norm": "From nearly straight to about 110-125 degrees with the plate just over the chest; the narrow rim grip bends the elbows more than a bar press (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Grip",
    "setup": "",
    "peak": "",
    "norm": "Rim held at 3 and 9 o'clock, palms in (about 37 cm apart for a 40 cm plate); the squeeze adds a pressing-in effort (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Tempo",
    "setup": "",
    "peak": "",
    "norm": "About 2 s down, 1 s up (clinical opinion)",
    "sources": []
