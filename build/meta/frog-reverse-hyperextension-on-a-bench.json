  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie face down on a flat bench with the hips at the end, legs hanging off it; knees bent and out, heels together; hold the sides of the bench."
   },
   {
    "id": "c2",
    "phase": "raise",
    "text": "Squeeze the glutes and lift the thighs to about level with the bench, heels together."
   },
   {
    "id": "c3",
    "phase": "top",
    "text": "Hold briefly without arching the low back."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Lower the legs slowly."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Legs hang; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Arching the low back to lift higher",
    "fix": "Stop with the thighs about level with the bench."
   },
   {
    "id": "m2",
    "mistake": "Swinging the legs",
    "fix": "Lift and lower under control."
   },
   {
    "id": "m3",
    "mistake": "Heels drifting apart",
    "fix": "Keep the heels pressed together."
   },
   {
    "id": "m4",
    "mistake": "Hips sliding off the bench",
    "fix": "Hold the bench firmly; hip crease at the edge."
   }
  ],
