   {
    "id": "c1",
    "phase": "setup",
    "text": "Sit tall on the end of a flat bench, feet flat. Dumbbells hanging beside the bench, palms in, elbows soft."
   },
   {
    "id": "c2",
    "phase": "raise",
    "text": "Breathe out and raise both arms straight forward, turning the palms down as the dumbbells clear the thighs."
   },
   {
    "id": "c3",
    "phase": "top",
    "text": "Stop at shoulder height, arms about shoulder width; chest up, no lean back."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Lower slowly in about 2 s back beside the bench."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Brief pause and repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Rocking back to swing the weights up",
    "fix": "Sit tall and still; lighter dumbbells."
   },
