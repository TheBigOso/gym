  "breathing": {
   "pattern": "Breathe out as you press the bar out past the head, breathe in as you bring it back.",
   "cadence": "About 1.2 s out, short pause, about 2 s back"
  },
  "prescription": {
   "sets": "3",
   "reps": "8-12",
   "tempo": "2-0-1-1",
   "load": "Light: the arms work against gravity far out in front (RIR 2-3, clinical opinion)",
   "frequency": "2 times a week",
   "progression": "Add small plates"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie face down on a bench set to about 45 degrees, chest on the pad, feet on the floor; hold the EZ bar overhand on the outer cambers at the level of the forehead, elbows bent and out."
   },
   {
    "id": "c2",
    "phase": "press",
    "text": "Breathe out and press the bar forward past the head in line with the body until the arms are long."
   },
   {
    "id": "c3",
    "phase": "top",
    "text": "Arms beside the ears; reach a little with the shoulder blades."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Breathe in and bring the bar back to the forehead under control."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Chest stays on the pad; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Lifting the chest off the pad",
    "fix": "Keep the chest down; let the shoulders do the work."
   },
   {
    "id": "m2",
    "mistake": "Pressing up instead of out",
    "fix": "Press in line with the bench, past the head."
   },
   {
    "id": "m3",
    "mistake": "Shrugging hard",
    "fix": "Let the shoulder blades rotate up, not hike to the ears."
   },
   {
    "id": "m4",
    "mistake": "Too heavy",
    "fix": "Use a light bar: the lever is long."
   }
  ],
