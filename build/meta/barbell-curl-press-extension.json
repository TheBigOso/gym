  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Stand tall, feet hip width, underhand grip about shoulder width, bar at the thighs, elbows at the sides."
   },
   {
    "id": "c2",
    "phase": "curl",
    "text": "Curl the bar to the shoulders without letting the elbows drift forward or the body swing."
   },
   {
    "id": "c3",
    "phase": "press",
    "text": "Press it overhead close to the face (chin back a little) to straight arms, palms still facing back."
   },
   {
    "id": "c4",
    "phase": "extDown",
    "text": "Keep the upper arms beside the head and bend only the elbows, lowering the bar behind the head."
   },
   {
    "id": "c5",
    "phase": "extUp",
    "text": "Straighten the elbows back to straight arms overhead."
   },
   {
    "id": "c6",
    "phase": "lower",
    "text": "Bring the bar back down to the shoulders."
   },
   {
    "id": "c7",
    "phase": "uncurl",
    "text": "Lower it under control to the thighs."
   },
   {
    "id": "c8",
    "phase": "reset",
    "text": "Stand tall, re-brace."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Swinging the curl",
    "fix": "Lighter bar; elbows pinned at the sides."
   },
   {
    "id": "m2",
    "mistake": "Elbows flaring wide in the extension",
    "fix": "Keep the upper arms close to the head and pointing up."
   },
   {
    "id": "m3",
    "mistake": "Arching the back overhead",
    "fix": "Brace and squeeze the glutes; ribs down."
   },
   {
    "id": "m4",
    "mistake": "Bar hitting the head",
    "fix": "Lower behind the head only as far as you control; keep the upper arms still."
   }
  ],
