    "breathing": {
      "pattern": "Inhale as you sit over the foot, exhale as you push back to the middle.",
      "cadence": "About 1.8 s down, 0.4 s pause, 1.4 s up"
    },
    "prescription": {
      "sets": "3",
      "reps": "6-10 per side",
      "tempo": "2-0-1-1",
      "frequency": "1-2 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can hold at the chest for every rep with 2-3 reps in reserve (RPE 7-8).",
      "progression": "Deeper sit (thigh toward parallel), then a heavier dumbbell"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Stand with the feet wide (about twice shoulder width), toes slightly out; hold one dumbbell upright at the chest with both hands under the top plate, elbows down."
      },
      {
        "id": "c2",
        "phase": "lower",
        "text": "Breathe in, push the hips back and shift over the right foot, bending the right knee while the left leg stays straight."
      },
      {
        "id": "c3",
        "phase": "bottom",
        "text": "Right knee over the toes, heel down, chest up; feel the stretch along the inner left thigh."
      },
      {
        "id": "c4",
        "phase": "rise",
        "text": "Breathe out and push through the right foot back to the middle."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Stand tall in the wide stance; repeat on the same side or alternate sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Heel of the squatting foot lifting",
        "fix": "Sit the hips back and keep the weight through the whole foot; go only as deep as you can with the heel down."
      },
      {
        "id": "m2",
        "mistake": "Knee caving inside the foot",
        "fix": "Point the knee in line with the toes."
      },
      {
        "id": "m3",
        "mistake": "Rounding the back as you sink",
        "fix": "Chest up, dumbbell close to the sternum; hinge from the hips."
      },
      {
        "id": "m4",
        "mistake": "Bending the straight leg",
        "fix": "Keep the trailing leg long; the stretch belongs on its inner thigh."
      }
    ],
    "kinematics": [
      {
        "measure": "Stance width (ankle centres)",
        "setup": "",
