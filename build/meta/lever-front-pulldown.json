  "breathing": {
   "pattern": "Breathe out as you pull the handles down, breathe in as they rise.",
   "cadence": "About 1.3 s down, short squeeze, about 2 s up"
  },
  "prescription": {
   "sets": "2-4",
   "reps": "8-15",
   "effort": "Stop 1-3 reps short of failure (RIR 1-3, clinical opinion)",
   "rest": "60-90 s",
   "frequency": "1-2 times a week",
   "tempo": "1.3-0.4-2-0.5 (pull-squeeze-return-pause, seconds)",
   "load": "Plate load is user-chosen: pick a weight you can pull to the upper chest without leaning back.",
   "progression": "Add reps, then load; slower return"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Sit with the thighs under the roller and the feet flat; reach up and take the handles, palms forward, arms long."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Breathe out and pull the handles down and slightly back toward the upper chest, elbows driving down."
   },
   {
    "id": "c3",
    "phase": "squeeze",
    "text": "Squeeze the shoulder blades down and together with the hands beside the upper chest."
   },
   {
    "id": "c4",
    "phase": "return",
    "text": "Breathe in and let the handles rise along their arc until the arms are long."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Let the lats stretch at the top without shrugging."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Leaning far back",
    "fix": "Stay nearly upright; lean back only a little."
   },
   {
    "id": "m2",
    "mistake": "Pulling with the arms only",
    "fix": "Start each rep by drawing the shoulder blades down."
   },
   {
    "id": "m3",
    "mistake": "Letting the handles yank the arms up",
    "fix": "Take about 2 s on the way up."
   },
   {
    "id": "m4",
    "mistake": "Shrugging at the bottom",
    "fix": "Keep the shoulders away from the ears."
   }
  ],
