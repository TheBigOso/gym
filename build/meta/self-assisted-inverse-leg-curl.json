  "breathing": {
   "pattern": "Inhale and brace before lowering, exhale as you come back up.",
   "cadence": "About 3 s down, then back up"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "3-6",
   "tempo": "3 s down, then up as smoothly as you can",
   "frequency": "1-2 times a week",
   "progression": "More range before the catch, then less help, then slower lowering"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Kneel on the pad with the ankles hooked under the roller, body upright."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Lean forward from the knees as one straight piece, as slowly as you can; bring the hands forward."
   },
   {
    "id": "c3",
    "phase": "catch",
    "text": "Catch yourself on the hands near the floor."
   },
   {
    "id": "c4",
    "phase": "push",
    "text": "Give a short push with the arms."
   },
   {
    "id": "c5",
    "phase": "curl",
    "text": "Pull with the hamstrings back to upright."
   },
   {
    "id": "c6",
    "phase": "reset",
    "text": "Kneel tall; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Bending at the hips to shorten the lever",
    "fix": "Keep knee, hip and shoulder in line."
   },
   {
    "id": "m2",
    "mistake": "Dropping fast once the hamstrings give out",
    "fix": "Lower slowly to the point you can control, then catch."
   },
   {
    "id": "m3",
    "mistake": "Arching the low back",
    "fix": "Squeeze the glutes and brace."
   },
   {
    "id": "m4",
    "mistake": "Too much volume too soon",
    "fix": "Start with a few slow reps; soreness can be marked."
   }
  ],
