    "muscleNotes": {
      "obliques_r": "Internal oblique on the turning side helps drive rotation toward it.",
      "obliques_l": "External oblique on the opposite side pairs with it to turn the rib cage.",
      "spinal_extensors_l": "Deep rotators (multifidus/rotatores) turn the spine toward the opposite side, so the left side works on a right turn.",
      "spinal_extensors_r": "Keeps the upper back long so the turn is rotation, not rounding.",
      "rhomboids_midtrap_r": "Draws the shoulder blade back as the arm opens.",
      "post_deltoid_r": "Carries the arm up and back toward the ceiling.",
      "infraspinatus_r": "Turns the upper arm outward so the palm can face forward at the top.",
      "serratus_l": "Pushes the floor away and holds the shoulder blade flat on the rib cage.",
      "triceps_l": "Keeps the support elbow long without locking it.",
      "core": "Light brace keeps the lower back and pelvis quiet.",
      "glute_med_r": "Holds the hips level over the knees.",
      "glute_med_l": "Holds the hips level over the knees.",
      "pec_r": "Lengthens across the front of the chest at end range.",
      "ant_deltoid_r": "Lengthens at the front of the shoulder at end range."
    },
    "breathing": {
      "pattern": "Inhale as the hand lifts and winds under the chest; exhale slowly as you rotate open toward the ceiling; keep breathing slowly in the hold, letting each exhale add a little range; inhale on the way back down.",
      "cadence": "About 2 s wind-up, 2 s rotate, 2\u20133 s hold, 2 s return"
    },
    "prescription": {
      "sets": "1\u20133",
      "reps": "8\u201312 per side",
      "endRangeHold": "2\u20133 s per rep",
      "staticOption": "20\u201330 s hold, 2\u20133 times per side",
      "frequency": "Daily or as a warm-up",
      "tempo": "2\u20132\u20132 (rotate\u2013hold\u2013return)"
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Hands under shoulders, knees under hips, tops of the feet on the mat. Spine long, gaze at the floor."
      },
      {
        "id": "c2",
        "phase": "windup",
        "text": "Push the floor away with the left hand. Lift the right hand and let it drift a little under your chest as you breathe in."
      },
      {
        "id": "c3",
        "phase": "rotate",
        "text": "Lead with the chest: sweep the right arm up and open the rib cage toward the ceiling. Eyes follow the hand."
      },
      {
        "id": "c4",
        "phase": "hold",
        "text": "Pause at end range. Hips stay square over the knees; exhale and let the upper back turn a touch further."
      },
      {
        "id": "c5",
        "phase": "return",
        "text": "Rotate back down under control, chest first, arm following."
      },
      {
        "id": "c6",
        "phase": "reset",
        "text": "Place the hand back under the shoulder, reset a neutral spine, then repeat or switch sides."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips sway or rotate with the chest",
        "fix": "Keep hips stacked over knees; imagine a glass of water on your low back. Turn only as far as the pelvis can stay still."
      },
      {
        "id": "m2",
        "mistake": "Sinking into the support shoulder",
        "fix": "Press the floor away so the shoulder blade stays flat and the support arm stays long."
      },
      {
        "id": "m3",
        "mistake": "Moving the arm without turning the spine",
        "fix": "Lead with the sternum; keep the arm in line with the chest, so the hand only goes as high as the rib cage turns."
      },
      {
        "id": "m4",
        "mistake": "Side-bending instead of rotating",
        "fix": "Keep the spine long from tailbone to head and turn around that line."
      },
      {
        "id": "m5",
        "mistake": "Holding the breath or rushing",
        "fix": "Move on a slow exhale and pause at end range; bouncing reduces the range you get."
      },
      {
        "id": "m6",
        "mistake": "Cranking the neck",
        "fix": "Let the head follow the rib cage; the eyes track the hand without forcing the neck."
      },
      {
        "id": "m7",
        "mistake": "Locking the support elbow",
        "fix": "Keep a soft bend (about 5\u201315\u00b0) and weight spread through the whole palm."
      }
    ],
