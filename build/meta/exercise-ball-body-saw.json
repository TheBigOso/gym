  "breathing": {
   "pattern": "Breathe out as you saw back, in as you come forward; keep the brace.",
   "cadence": "About 1.5 s back, 0.5 s hold, 1.5 s forward"
  },
  "prescription": {
   "sets": "2-4",
   "reps": "8-12",
   "tempo": "1.5-0.5-1.5-0",
   "frequency": "2-3 times a week",
   "rest": "45-75 s",
   "progression": "Saw further back, or slower"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Forearms on the mat under the shoulders, shins on the ball, body in one straight line."
   },
   {
    "id": "c2",
    "phase": "back",
    "text": "Breathe out and push the body back, shoulders sliding behind the elbows."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Hold the line; no sag at the hips."
   },
   {
    "id": "c4",
    "phase": "forward",
    "text": "Breathe in and pull the body forward until the shoulders are over the elbows."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stay braced; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Hips sagging as you go back",
    "fix": "Shorten the saw; brace the abs and squeeze the glutes."
   },
   {
    "id": "m2",
    "mistake": "Piking the hips up",
    "fix": "Keep shoulders, hips and ankles in one line."
   },
   {
    "id": "m3",
    "mistake": "Shrugging",
    "fix": "Push the floor away through the forearms."
   },
   {
    "id": "m4",
    "mistake": "Rushing",
    "fix": "Smooth, controlled saw; the ball should roll, not bounce."
   }
  ],
