  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on your back, knees bent, feet flat; hold the ball in both hands with the arms straight over the chest."
   },
   {
    "id": "c2",
    "phase": "up",
    "text": "Breathe out and curl the head and shoulders up, pressing the ball toward the ceiling."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Squeeze the abs; low back stays on the mat."
   },
   {
    "id": "c4",
    "phase": "down",
    "text": "Breathe in and lower the shoulder blades, then the head."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Rest briefly with the arms still up; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Swinging the ball forward to sit up",
    "fix": "Keep the arms vertical to the trunk; the abs lift you."
   },
   {
    "id": "m2",
    "mistake": "Lifting the low back",
    "fix": "Curl only until the shoulder blades clear the mat."
   },
   {
    "id": "m3",
    "mistake": "Tucking the chin hard",
    "fix": "Keep a fist of space between chin and chest."
   },
   {
    "id": "m4",
    "mistake": "Bending the elbows",
    "fix": "Arms long and locked."
   }
  ],
