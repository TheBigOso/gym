  "breathing": {
   "pattern": "Breathe out as each leg rises, in as it lowers; keep the head up and keep breathing.",
   "cadence": "About 1.1 s up, 1.1 s down per leg"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "6-10 per leg",
   "tempo": "About 1 s up, short pause, 1 s down",
   "load": "Body weight",
   "frequency": "2-3 times a week",
   "progression": "Lower hover, slower lowering, longer sets"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie flat, arms by your sides palms down, legs straight."
   },
   {
    "id": "c2",
    "phase": "lift",
    "text": "Curl the head and the tops of the shoulders up, chin tucked, and lift both heels off the mat."
   },
   {
    "id": "c3",
    "phase": "raiseR",
    "text": "Raise the right leg to vertical and back down to the hover; head stays up."
   },
   {
    "id": "c4",
    "phase": "raiseL",
    "text": "Now the left leg up and back down."
   },
   {
    "id": "c5",
    "phase": "lower",
    "text": "Lower the legs, then the head, to the mat."
   },
   {
    "id": "c6",
    "phase": "reset",
    "text": "Rest, then the next set."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Pulling the head forward with the neck",
    "fix": "Curl from the upper abdomen; keep a fist of space between chin and chest."
   },
   {
    "id": "m2",
    "mistake": "Low back arching",
    "fix": "Hover higher or put the hands under the hips."
   },
   {
    "id": "m3",
    "mistake": "Hover leg touching down",
    "fix": "Keep both heels just off the mat."
   },
   {
    "id": "m4",
    "mistake": "Holding the breath",
    "fix": "Breathe out on every lift."
   }
  ],
