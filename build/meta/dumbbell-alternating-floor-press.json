    "breathing": {
      "pattern": "Inhale as each dumbbell lowers, exhale as it presses up; breathe normally while the other arm holds.",
      "cadence": "Per arm about 1.6 s down, 0.3 s pause, 1.1 s up"
    },
    "prescription": {
      "sets": "3-4",
      "reps": "8-12 per arm",
      "tempo": "2-0-1-0 (2 s down, no pause, 1 s up)",
      "frequency": "1-3 times a week",
      "load": "Dumbbell load is user-chosen: pick a weight you can lift for the target reps with 1-3 reps in reserve (RIR 1-3, about RPE 7-9).",
      "progression": "Add reps, then the next dumbbells; hold the waiting arm perfectly still."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "Lie on the mat, knees bent and feet flat; both dumbbells straight up over the chest, palms toward the feet."
      },
      {
        "id": "c2",
        "phase": "lowerR",
        "text": "Breathe in and lower one dumbbell, elbow about 45 degrees from the side, while the other arm stays locked out over the chest."
      },
      {
        "id": "c3",
        "phase": "bottomR",
        "text": "Rest the back of the upper arm on the floor for a moment; keep the hips and ribs still."
      },
      {
        "id": "c4",
        "phase": "pressR",
        "text": "Breathe out and press back up to meet the other dumbbell."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Both arms straight; switch sides each rep."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "The waiting arm drifting down",
        "fix": "Keep the top arm straight over the shoulder while the other works."
      },
      {
        "id": "m2",
        "mistake": "Trunk rolling toward the working arm",
        "fix": "Brace and keep both shoulder blades on the floor."
      },
      {
        "id": "m3",
        "mistake": "Elbows slamming into the floor",
        "fix": "Lower under control and just touch."
      },
      {
        "id": "m4",
        "mistake": "Elbows flared to 90 degrees",
        "fix": "Keep them about 45 degrees from the body."
      }
    ],
