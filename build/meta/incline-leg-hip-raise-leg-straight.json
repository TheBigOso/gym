  "breathing": {
   "pattern": "Exhale as you curl the hips up, inhale as you lower.",
   "cadence": "About 1.5 s up, a short pause, about 2 s down"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "6-12",
   "tempo": "1.5 s up, brief pause, 2 s down",
   "frequency": "2 times a week",
   "progression": "Bent-knee version first, then straight legs, then a steeper bench"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie head-up on the incline bench, hands gripping the roller behind the head, legs straight and just off the board."
   },
   {
    "id": "c2",
    "phase": "raise",
    "text": "Breathe out, raise the straight legs to vertical, then lift the hips off the board pushing the feet toward the ceiling."
   },
   {
    "id": "c3",
    "phase": "top",
    "text": "Pause with the hips lifted and the legs straight."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Breathe in, lower the hips, then the legs, slowly."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Legs just off the board; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Swinging the legs up",
    "fix": "Lift slowly; pause at vertical before the hip lift."
   },
   {
    "id": "m2",
    "mistake": "Bending the knees",
    "fix": "Keep the legs straight."
   },
   {
    "id": "m3",
    "mistake": "Letting the low back arch as the legs lower",
    "fix": "Keep the low back pressed to the board."
   },
   {
    "id": "m4",
    "mistake": "Pulling with the arms",
    "fix": "The hands only anchor you."
   }
  ],
  "kinematics": [
   {
