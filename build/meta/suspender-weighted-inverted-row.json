  "breathing": {
   "pattern": "Breathe out as you pull the chest up to the hands, breathe in as the arms straighten.",
   "cadence": "About 1.2 s pull, short squeeze, about 2 s lower"
  },
  "prescription": {
   "sets": "3-4",
   "reps": "6-12",
   "tempo": "1-1-2-0",
   "load": "Bodyweight plus a weight vest; pick the vest and body angle so the last reps are hard with 1-3 reps in reserve (RIR 1-3, clinical opinion)",
   "frequency": "2-3 times a week",
   "progression": "Add vest load in small steps, then lower the body angle"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Vest snug on the chest; a handle in each hand, palms in; lean back with long arms, heels down, body straight from heels to head."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Breathe out and pull the chest up to the hands, elbows close to the body."
   },
   {
    "id": "c3",
    "phase": "top",
    "text": "Squeeze the shoulder blades together; hips stay up under the extra load."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Breathe in and lower slowly to long arms."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Re-brace the glutes and abs; repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Hips sagging under the vest",
    "fix": "Squeeze the glutes and brace; drop the vest load if the line breaks."
   },
   {
    "id": "m2",
    "mistake": "Shrugging the shoulders up",
    "fix": "Pull the shoulder blades back and down."
   },
   {
    "id": "m3",
    "mistake": "Loose vest shifting on the chest",
    "fix": "Tighten the straps so the load rides high and snug."
   },
   {
    "id": "m4",
    "mistake": "Dropping fast into the bottom",
    "fix": "Lower over about 2 s."
   }
  ],
  "kinematics": [
   {
    "measure": "Body angle",
    "setup": "",
    "peak": "",
    "norm": "The more upright the body, the easier the row; walking the feet toward the anchor makes it harder (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Elbow flexion",
    "setup": "",
    "peak": "",
    "norm": "From nearly straight to about 90-110 degrees at the top (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Load",
    "setup": "",
    "peak": "",
    "norm": "A vest adds load to the body without changing the line; inverted rows load the trunk extensors less than standing bent-over rows (Fenwick 2009)",
