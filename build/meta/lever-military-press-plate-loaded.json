  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Sit tall with the back on the pad and the feet flat; palms forward on the handles beside the shoulders, then press to the start overhead."
   },
   {
    "id": "c2",
    "phase": "lower",
    "text": "Breathe in and lower the handles along the arc until the hands are about level with the chin, elbows under the hands."
   },
   {
    "id": "c3",
    "phase": "bottom",
    "text": "Pause at the shoulders with the ribs down and the back on the pad."
   },
   {
    "id": "c4",
    "phase": "press",
    "text": "Breathe out and press up along the arc until the arms are long overhead."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Hold the arms long with the shoulders down from the ears."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Arching the low back off the pad",
    "fix": "Keep the ribs down and the back on the pad; lighten the plates."
   },
   {
    "id": "m2",
    "mistake": "Elbows drifting behind the hands",
    "fix": "Keep the forearms vertical under the handles."
   },
   {
    "id": "m3",
