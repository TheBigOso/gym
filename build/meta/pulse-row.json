  "breathing": {
   "pattern": "Breathe out as you pull back, keep breathing in short breaths through the pulses, breathe in as you lower.",
   "cadence": "About 1 s up, three small pulses, 1.6 s down"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "10-15 (each with 3 pulses)",
   "tempo": "1 s pull, three 0.6 s pulses, 1.6 s lower",
   "load": "Body weight (arms only); add light dumbbells or a band to progress",
   "frequency": "2-4 times a week (also as a warm-up)",
   "progression": "More pulses per rep, longer holds, then dumbbell rows"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Feet about hip width, knees slightly bent, hinge forward with a flat back; arms hang toward the floor."
   },
   {
    "id": "c2",
    "phase": "pull",
    "text": "Pull the elbows back toward the hips, close to the body, and squeeze the shoulder blades together."
   },
   {
    "id": "c3",
    "phase": "pulse",
    "text": "At the top, pulse: let the elbows forward a few cm and pull them back again, three times, squeezing each time."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Lower the arms under control back to the hang."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Stay in the hinge, breathe, and repeat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Rounding the back",
    "fix": "Keep the chest long and the back flat; hinge a little less if needed."
   },
   {
    "id": "m2",
    "mistake": "Shrugging toward the ears",
    "fix": "Keep the shoulders down while you squeeze."
   },
   {
    "id": "m3",
    "mistake": "Pulses too big or too fast",
    "fix": "Small, controlled pulses with a squeeze at the back each time."
   },
   {
    "id": "m4",
    "mistake": "Elbows flaring wide",
    "fix": "Keep the elbows close to the ribs."
   },
   {
    "id": "m5",
    "mistake": "Standing up during the set",
    "fix": "Hold the hinge angle the whole set."
   }
  ],
