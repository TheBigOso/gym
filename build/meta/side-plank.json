  "safety": {
   "cautions": [
    "Stop if sharp pain, numbness or tingling occurs.",
    "Muscle glow colours and activation curves are illustrative, not measured EMG.",
    "Shoulder pain on the supporting side (instability, rotator cuff): start with the knee side plank or skip."
   ],
   "modify": [
    "Bend the knees (knee side plank): about 40% less oblique activity (Escamilla 2016).",
    "Stagger the feet (top foot in front) for balance."
   ],
   "regressions": [
    "Knee side plank.",
    "Side-lying hip lift with a short hold."
   ],
   "progressions": [
    "Longer holds.",
    "Top leg lifted.",
    "Side plank with rotation (reach under)."
   ]
  },
  "muscleNotes": {
   "obliques_r": "Bottom-side obliques hold the trunk up against gravity; external oblique about 62% MVIC in the side bridge on the toes (Escamilla 2016) and 51% in Youdas 2008 (as summarised by St Mary's University). Recorded side not reported in these summaries.",
   "obliques_l": "Top-side obliques co-contract to keep the trunk straight (clinical opinion).",
   "glute_med_r": "Bottom-side hip abductors lift the pelvis off the mat; the side bridge was one of the exercises suggested for gluteus medius strengthening (above 45% MVIC, Ekstrom 2007).",
   "spinal_extensors_r": "Stands in for quadratus lumborum, which is highly active in side support (McGill 1998); lumbar paraspinals about 29% MVIC (Escamilla 2016).",
   "core": "Rectus abdominis about 21-26% MVIC (Escamilla 2016); keeps the pelvis from tipping forward or back.",
   "glute_med_l": "Top-side abductors keep the top leg stacked (clinical opinion).",
   "serratus_r": "Keeps the supporting shoulder blade on the rib cage; the trunk must not sink between the shoulder blades.",
   "ant_deltoid_r": "Steadies the supporting shoulder over the elbow.",
   "post_deltoid_r": "Steadies the supporting shoulder over the elbow.",
   "infraspinatus_r": "Rotator cuff centres the supporting shoulder (clinical opinion).",
   "lats_r": "Draws the supporting shoulder down, away from the ear (clinical opinion).",
   "adductors_l": "Top leg presses gently onto the bottom leg to keep the feet stacked (clinical opinion).",
   "quads_r": "Keep the knees straight.",
   "quads_l": "Keep the knees straight."
  }
 },
