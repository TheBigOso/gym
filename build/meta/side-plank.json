   "progression": "Longer holds, then lift the top leg or the top arm"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on your right side, right elbow under the shoulder, forearm pointing forward, feet stacked, legs straight."
   },
   {
    "id": "c2",
    "phase": "lift",
    "text": "Press the forearm into the mat and lift the hips until the body is one straight line."
   },
   {
    "id": "c3",
    "phase": "hold",
    "text": "Hips high and square, shoulder away from the ear, breathe steadily."
   },
   {
    "id": "c4",
    "phase": "lower",
    "text": "Lower the hips to the mat under control."
   },
   {
    "id": "c5",
    "phase": "reset",
    "text": "Rest, then repeat; switch sides."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Hips sagging toward the mat",
    "fix": "Lift the bottom hip; shorten the hold or bend the knees."
   },
   {
    "id": "m2",
    "mistake": "Hips rolling forward or back",
    "fix": "Keep the hips stacked, chest facing forward."
   },
   {
    "id": "m3",
    "mistake": "Elbow out of line with the shoulder",
    "fix": "Elbow directly under the shoulder."
   },
   {
    "id": "m4",
    "mistake": "Shoulder shrugged up to the ear",
    "fix": "Push the floor away and draw the shoulder down."
   }
  ],
