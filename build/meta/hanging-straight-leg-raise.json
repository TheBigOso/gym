   "pattern": "Breathe out as the legs rise, in on the way down.",
   "cadence": "About 1.6 s up, 2.2 s down"
  },
  "prescription": {
   "sets": "3-4",
   "reps": "6-10",
   "tempo": "About 1.5 s up, short hold at level, 2 s down",
   "load": "Body weight",
   "frequency": "2-3 times a week",
   "progression": "Longer hold at level (L-hang), then raise past level with a pelvic curl (hanging leg hip raise)"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Hang from the bar, hands a little wider than the shoulders, legs straight and together."
   },
   {
    "id": "c2",
    "phase": "set",
    "text": "Shoulders down, ribs down, brace."
   },
   {
    "id": "c3",
    "phase": "raise",
    "text": "Lift the straight legs in front until they are level with the hips; knees locked, toes pointed."
   },
   {
    "id": "c4",
    "phase": "top",
    "text": "Hold the L for a moment without swinging."
   },
   {
    "id": "c5",
    "phase": "lower",
    "text": "Lower slowly to the hang; stop the swing before the next rep."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Bending the knees as the legs rise",
    "fix": "Keep the knees straight; use the knee raise if needed."
   },
   {
    "id": "m2",
    "mistake": "Swinging into the lift",
    "fix": "Start still and lower slowly."
   },
   {
    "id": "m3",
    "mistake": "Arching the low back in the hang",
    "fix": "Brace before each rep."
   },
   {
    "id": "m4",
    "mistake": "Shrugging",
    "fix": "Keep the shoulder blades set down."
   }
  ],
