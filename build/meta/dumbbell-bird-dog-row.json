    "breathing": {
      "pattern": "Exhale as you row, inhale as you lower; keep the trunk braced throughout.",
      "cadence": "About 1.2 s up, 0.6 s squeeze, 2.0 s down"
    },
    "prescription": {
      "sets": "2-3",
      "reps": "8-12 per side",
      "tempo": "1-1-2-0 (1 s up, 1 s squeeze, 2 s down)",
      "frequency": "1-3 times a week",
      "load": "Light to moderate dumbbell: balance limits the load. Pick a weight you can row for the target reps with 2-3 reps in reserve (RIR 2-3) without the hips tipping.",
      "progression": "Add reps and a longer squeeze, then a heavier dumbbell."
    },
    "cues": [
      {
        "id": "c1",
        "phase": "setup",
        "text": "On a flat bench: right knee and left hand down, left leg straight back level with the hip, back flat; the dumbbell hangs under the right shoulder."
      },
      {
        "id": "c2",
        "phase": "row",
        "text": "Brace and breathe out as you row the dumbbell to the side of the ribs, elbow close to the body."
      },
      {
        "id": "c3",
        "phase": "squeeze",
        "text": "Squeeze the shoulder blade back; hips and shoulders stay level and square."
      },
      {
        "id": "c4",
        "phase": "lower",
        "text": "Breathe in and lower slowly to a straight arm without letting the trunk rotate."
      },
      {
        "id": "c5",
        "phase": "reset",
        "text": "Re-brace, keep the leg long, and row again. Switch sides after the set."
      }
    ],
    "mistakes": [
      {
        "id": "m1",
        "mistake": "Hips rotating open as the dumbbell rises",
        "fix": "Keep both hip bones pointing at the bench; use a lighter weight."
      },
      {
        "id": "m2",
        "mistake": "Extended leg drifting up or sagging",
        "fix": "Hold the leg level with the hip, reaching through the heel."
      },
      {
        "id": "m3",
        "mistake": "Lower back sagging",
        "fix": "Brace the abs and keep the back flat."
      },
      {
        "id": "m4",
        "mistake": "Shrugging the shoulder to the ear",
        "fix": "Pull the elbow back toward the hip."
      },
      {
        "id": "m5",
        "mistake": "Rushing the lowering",
        "fix": "Take about 2 s to lower."
      }
    ],
