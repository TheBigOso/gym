    "safety": {
      "cautions": [
        "Balance first: master the bird dog on the bench without a weight, then add a light dumbbell.",
        "Keep the supporting wrist under the shoulder; stop if the wrist hurts.",
        "Have the bench on a non-slip floor and stay near its centre.",
        "Stop if sharp pain, numbness or tingling occurs.",
        "Muscle glow colours and activation curves are illustrative, not measured EMG."
      ],
      "modify": [
        "Balance or wrist trouble: keep both knees and the supporting hand on the bench (one-arm dumbbell row)."
      ],
      "regressions": [
        "One-arm dumbbell row with the knee and hand on the bench.",
        "Bird dog on the floor without weight."
      ],
      "progressions": [
        "Heavier dumbbell.",
        "Pause 2 s at the top of each row."
      ]
    },
    "muscleNotes": {
      "lats_r": "Pull the upper arm back toward the hip.",
      "rhomboids_midtrap_r": "Squeeze the shoulder blade toward the spine at the top.",
      "post_deltoid_r": "Extends the shoulder as the elbow passes the trunk.",
      "biceps_r": "Bend the elbow.",
      "forearm_flexors_r": "Grip the handle.",
      "core": "Holds the trunk level on two points of support; rowing exercises with less support asked more of the trunk muscles (Fenwick 2009).",
      "obliques_r": "Resist the trunk rotating toward the rowing arm.",
      "obliques_l": "Resist the trunk rotating toward the rowing arm.",
      "spinal_extensors": "Keep the back flat; the bird dog trains the back extensors at low spine load (McGill and Karpowicz 2009).",
      "glute_max_l": "Holds the extended leg level with the hip.",
      "glute_med_r": "Steadies the pelvis over the supporting knee.",
      "serratus_l": "Holds the supporting shoulder blade on the rib cage.",
      "triceps_l": "Keeps the supporting arm straight."
    }
