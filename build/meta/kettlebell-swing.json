  "breathing": {
   "pattern": "Breathe in as the bell falls into the hinge, short sharp breath out as the hips snap.",
   "cadence": "About 1.5 s per swing"
  },
  "prescription": {
   "sets": "3-5",
   "reps": "10-20 or 20-30 s",
   "tempo": "Continuous, about 1.5 s per swing",
   "load": "User-chosen kettlebell; stop the set when the hips slow or the back starts to round",
   "frequency": "2-3 times a week",
   "progression": "Heavier kettlebell, longer sets, then one-arm swings"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Feet a little wider than the hips, toes slightly out, kettlebell handle in both hands, palms toward you."
   },
   {
    "id": "c2",
    "phase": "hike",
    "text": "Hinge: push the hips back and hike the bell high between the thighs, forearms close to them."
   },
   {
    "id": "c3",
    "phase": "swing",
    "text": "Snap the hips forward and stand tall; the bell floats to chest height on straight arms."
   },
   {
    "id": "c4",
    "phase": "back",
    "text": "Let it fall; hinge late and hike it back between the legs."
   },
   {
    "id": "c5",
    "phase": "swing2",
    "text": "Snap again: glutes tight, ribs down, no leaning back."
   },
   {
    "id": "c6",
    "phase": "park",
    "text": "Let the bell slow and stop hanging in front."
   },
   {
    "id": "c7",
    "phase": "reset",
    "text": "Stand tall, breathe."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Squatting the kettlebell up",
    "fix": "Hinge: hips go back, shins stay nearly vertical."
   },
   {
    "id": "m2",
    "mistake": "Lifting with the arms",
    "fix": "Let the hip snap float the bell; the arms are ropes."
   },
   {
    "id": "m3",
    "mistake": "Leaning back at the top",
    "fix": "Finish tall in a straight line with the glutes squeezed."
   },
   {
    "id": "m4",
    "mistake": "Letting the bell drop low toward the knees",
    "fix": "Hike it high between the thighs, close to the groin."
   },
   {
    "id": "m5",
    "mistake": "Rounding the back at the bottom",
    "fix": "Keep the chest proud and the back flat through the hinge."
   }
  ],
