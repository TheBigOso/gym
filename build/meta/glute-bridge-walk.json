  "breathing": {
   "pattern": "Exhale as you lift into the bridge, breathe steadily while the heels walk out and back, inhale as you lower.",
   "cadence": "About 0.6 s per heel step"
  },
  "prescription": {
   "sets": "2-3",
   "reps": "4-8 walk-outs",
   "tempo": "Small, controlled steps",
   "frequency": "2-3 times a week",
   "progression": "Further walk-out, then single-leg bridge, then Nordic or slider curls"
  },
  "cues": [
   {
    "id": "c1",
    "phase": "setup",
    "text": "Lie on your back, knees bent, feet flat and hip width, arms by your sides."
   },
   {
    "id": "c2",
    "phase": "lift",
    "text": "Breathe out and lift into a bridge: knees, hips and shoulders in one line."
   },
   {
    "id": "c3",
    "phase": "walk out",
    "text": "Keep the hips up and take small heel steps away from you, right then left."
   },
   {
    "id": "c4",
    "phase": "hold",
    "text": "Hips as high as you can keep them, feeling the hamstrings work."
   },
   {
    "id": "c5",
    "phase": "walk in",
    "text": "Step the heels back toward you one at a time."
   },
   {
    "id": "c6",
    "phase": "lower",
    "text": "Breathe in and roll the hips down to the mat."
   }
  ],
  "mistakes": [
   {
    "id": "m1",
    "mistake": "Hips sinking as the feet walk out",
    "fix": "Take smaller steps and only go as far as you can keep the hips high."
   },
   {
    "id": "m2",
    "mistake": "Pelvis twisting with each step",
    "fix": "Brace the abs; lift each foot only a few centimetres."
   },
   {
    "id": "m3",
    "mistake": "Hamstring cramp",
    "fix": "Shorten the walk-out and build up gradually."
   },
   {
    "id": "m4",
    "mistake": "Arching the low back",
    "fix": "Ribs down, slight posterior pelvic tilt."
   }
  ],
  "kinematics": [
   {
    "measure": "Hip flexion",
    "setup": "",
    "peak": "",
    "norm": "Hips extend to neutral at the top (straight knee-hip-shoulder line); no extra lumbar arch (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Knee flexion",
    "setup": "",
    "peak": "",
    "norm": "About 90 degrees at the top is the traditional bridge; more knee bend shifts work away from the hamstrings (Lehecka 2017)",
    "sources": [
     "lehecka2017"
    ]
   },
   {
    "measure": "Hip height",
    "setup": "",
    "peak": "",
    "norm": "Pelvis lifts until the line is straight (clinical opinion)",
    "sources": []
   },
   {
    "measure": "Walk-out",
    "setup": "",
    "peak": "",
    "norm": "Feet step away until the knees are only slightly bent; hamstring activity rises as the knees straighten (Lehecka 2017)",
    "sources": [
     "lehecka2017"
    ]
   },
   {
